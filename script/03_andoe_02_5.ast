    },
    block_00112 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「老爹的安危？」"
                }
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000723", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯，这丫头就是伯奇。百年来第一个诞生在中村家的。她是他们",
                    {"rt2"},
                    "一直以来的夙愿」"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这样的话，事情的脉络就越来越清晰了」"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你和夏目老太太用金钱的力量从中村家手中夺走了那座宅邸和住",
                    {"rt2"},
                    "在里面的人，这件事我知道」"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000724", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「光听这个的话简直就是人口买卖」"
                }
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，说白了就是人口买卖。但那是为了拯救而做的」"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你们成功救出了小音羽宅邸的大部分少女，但身为伯奇的葛却无",
                    {"rt2"},
                    "法赎出来」"
                }
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那可是百年一遇的伯奇。虽然不知道她的能力有多强，但正如你",
                    {"rt2"},
                    "所说，她是那个一族梦寐以求的存在」"
                }
            }
        },
        linkback = "block_00118",
        linknext = "block_00120"
    },
    block_00120 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000725", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯」"
                }
            }
        },
        linkback = "block_00119",
        linknext = "block_00121"
    },
    block_00121 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你被索要了远超之前那些少女的天价」"
                }
            }
        },
        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为她是伯奇」"
                }
            }
        },
        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「妈妈去世之后，你也一直在攒钱。一直不明白那意味着什么」"
                }
            }
        },
        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「如果只有葛的赎金是天文数字的话，就说得通了」"
                }
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000726", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「唉，不知道像谁……真敏锐啊。才托你照看了一天就看出这么多」"
                }
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「别小看我。那点事还看得出来」"
                }
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000727", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「我跟葛说过不要靠近夏目家。但没想到你会代替葛去夏目家」"
                }
            }
        },
        linkback = "block_00126",
        linknext = "block_00128"
    },
    block_00128 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你要是在藏什么人的话，十有八九跟那座宅邸有关」"
                }
            }
        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000728", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「唉，真是不容易啊」"
