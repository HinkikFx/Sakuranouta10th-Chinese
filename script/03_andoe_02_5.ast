astver = 2.0
astname = "ast"
ast = {
    block_00000 = {
        {"savetitle", text = "第Ⅲ章"},
        {"bg", file = "ev_com_f02_05", path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"bgm", file = "bgm029"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000654", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「诶——真的假的——中村那老头,居然带着保镖去了夏目家?」"
                }
            }
        },
        linknext = "block_00001"
    },
    block_00001 = {
        {"text"},
        text = {
            ja = {
                {"老爸脸上毫无紧张感,对今天发生的事发表着感想。"}
            }
        },
        linkback = "block_00000",
        linknext = "block_00002"
    },
    block_00002 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯,是啊。不过他嘴上说那不是保镖,是警卫就是了」"
                }
            }
        },
        linkback = "block_00001",
        linknext = "block_00003"
    },
    block_00003 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000655", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「还不是一回事。反正穿着一身唬人的黑西装吧?真是的,都什么年",
                    {"rt2"},
                    "代了,别干那种蠢事啊。不过嘛,像从前那样乱来,如今大概也做不到",
                    {"rt2"},
                    "了」"
                }
            }
        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000656", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「然后呢?你没事吧?」"
                }
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「被中村那老头揍了一拳,不过没什么大碍。要是被那黑衣人揍了,",
                    {"rt2"},
                    "那才叫麻烦」"
                }
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kzd_000179", ch = "kzd"}
            },
            ja = {
                {
                    name = {"雫", "葛"},
                    "「诶?直哉被打了?」"
                }
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,没,就一点,一点而已。我也回敬了对方一脚,算是扯平了」"
                }
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000657", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「喂喂,虽说不像从前那么危险了,还是别跟那帮黑衣人动手啊」"
                }
            }
        },
        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯,我明白。下次会注意,不让这种事再发生」"
                }
            }
        },
        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「比起这个,中村家和葛,还有你之间的关系,把来龙去脉全都给我讲",
                    {"rt2"},
                    "清楚」"
                }
            }
        },
        linkback = "block_00009",
        linknext = "block_00011"
    },
    block_00011 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000658", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「说得也是啊。唔——」"
                }
            }
        },
        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            ja = {
                {"老爸凝视着葛。"}
            }
        },
        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"text"},
        text = {
            ja = {
                {"葛的表情没有丝毫变化。"}
            }
        },
        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000659", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「你都知道到哪一步来着……」"
                }
            }
        },
        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我只知道,你和婆婆向自古以来掌控这一带的中村家挑了衅。仅此",
                    {"rt2"},
                    "而已」"
                }
            }
        },
        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000660", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「是啊。说来话长,我就挑要点简单说说。不过嘛,光是要点也够长",
                    {"rt2"},
                    "的了……」"
                }
            }
        },
        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000661", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「中村家,这个姓氏据说能追溯到一千年前的豪族。实际上,他们虽",
                    {"rt2"},
                    "然只是地方上的有力人士,却和国家的政界、财界都有很深的关系」"
                }
            }
        },
        linkback = "block_00016",
        linknext = "block_00018"
    },
    block_00018 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000662", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「毕竟那条血脉里,出过不少名留青史的人物。在国政上有些门路,",
                    {"rt2"},
                    "也不足为奇」"
                }
            }
        },
        linkback = "block_00017",
        linknext = "block_00019"
    },
    block_00019 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但我听说,那都是战前的老黄历了」"
                }
            }
        },
        linkback = "block_00018",
        linknext = "block_00020"
    },
    block_00020 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000663", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯,战争刚结束不久,出现了一个开始掌管这弓张港货运的人。毕",
                    {"rt2"},
                    "竟那是个外国物资如怒涛般涌入的新时代」"
                }
            }
        },
        linkback = "block_00019",
        linknext = "block_00021"
    },
    block_00021 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000664", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「又是战后不久,那种粗野的营生,正经人是不会去干的。要统管这",
                    {"rt2"},
                    "一切,必须是相当了得的豪杰才行」"
                }
            }
        },
        linkback = "block_00020",
        linknext = "block_00022"
    },
    block_00022 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000665", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「而那位豪杰,是个女人」"
                }
            }
        },
        linkback = "block_00021",
        linknext = "block_00023"
    },
    block_00023 = {
        {"bg", file = "ev_com_f02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000666", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「夏目琴子。也就是我的婆婆」"
                }
            }
        },
        linkback = "block_00022",
        linknext = "block_00024"
    },
    block_00024 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000667", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「夏目琴子靠弓张港的货运一代人就积攒下了家业,这里离东京也不",
                    {"rt2"},
                    "算远。大量的海外物资运抵此地,据说赚了相当可观的一笔,后来她",
                    {"rt2"},
                    "还染指了兴行生意」"
                }
            }
        },
        linkback = "block_00023",
        linknext = "block_00025"
    },
    block_00025 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「在当时,那种营生可不是正经人干的活。也就是说,是黑道」"
                }
            }
        },
        linkback = "block_00024",
        linknext = "block_00026"
    },
    block_00026 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000668", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「我还是小鬼头的时候,提起夏目一家,那可全都是些走路带风、横",
                    {"rt2"},
                    "着膀子的家伙」"
                }
            }
        },
        linkback = "block_00025",
        linknext = "block_00027"
    },
    block_00027 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000669", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「但是,看这一切不顺眼的人也不在少数。其中之一,就是中村章一」"
                }
            }
        },
        linkback = "block_00026",
        linknext = "block_00028"
    },
    block_00028 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000670", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「他绝不容许趁着战后的混乱侵占了弓张地盘的夏目一家」"
                }
            }
        },
        linkback = "block_00027",
        linknext = "block_00029"
    },
    block_00029 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000671", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「话虽如此,中村家是从镰仓时代延续下来的名门,并不是专门干黑",
                    {"rt2"},
                    "道营生的」"
                }
            }
        },
        linkback = "block_00028",
        linknext = "block_00030"
    },
    block_00030 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000672", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「所以,他们找了关东的大黑帮当靠山,想借此牵制弓张的地下社会」"
                }
            }
        },
        linkback = "block_00029",
        linknext = "block_00031"
    },
    block_00031 = {
        {"bg", file = "ev_com_f02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000673", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「可这是个天大的失算。夏目一家面对关东的黑帮寸步不让,最后事",
                    {"rt2"},
                    "情演变成了战争」"
                }
            }
        },
        linkback = "block_00030",
        linknext = "block_00032"
    },
    block_00032 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000674", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嘛,也就是所谓的黑道火并」"
                }
            }
        },
        linkback = "block_00031",
        linknext = "block_00033"
    },
    block_00033 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000675", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「结果是两败俱伤——不,准确地说,一般都认为,是没有向巨大组织屈",
                    {"rt2"},
                    "服的夏目一家赢了。总之双方暂且讲和了」"
                }
            }
        },
        linkback = "block_00032",
        linknext = "block_00034"
    },
    block_00034 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「可是在那之后,不知为何,这场一度讲和的战争,几年后又再度爆发",
                    {"rt2"},
                    "了」"
                }
            }
        },
        linkback = "block_00033",
        linknext = "block_00035"
    },
    block_00035 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「而那火种,是夏目琴子的孙子——草薙健一郎带来的。也就是说,让",
                    {"rt2"},
                    "战争重燃的人是你」"
                }
            }
        },
        linkback = "block_00034",
        linknext = "block_00036"
    },
    block_00036 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000676", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「你这么说我也无法反驳。不过,我可不是为了挑起夏目一家和中村",
                    {"rt2"},
                    "家的火并才那么干的」"
                }
            }
        },
        linkback = "block_00035",
        linknext = "block_00037"
    },
    block_00037 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这些我从妈妈那里听了不少。你为了保护小音羽宅邸的少女们,引",
                    {"rt2"},
                    "发了那场火并」"
                }
            }
        },
        linkback = "block_00036",
        linknext = "block_00038"
    },
    block_00038 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000677", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「不是,所以说啊。把事情闹到火并那一步的是夏目婆婆,我只是单",
                    {"rt2"},
                    "纯想救出住在小音羽宅邸里的水菜而已」"
                }
            }
        },
        linkback = "block_00037",
        linknext = "block_00039"
    },
    block_00039 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就当是这样吧」"
                }
            }
        },
        linkback = "block_00038",
        linknext = "block_00040"
    },
    block_00040 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000678", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「水菜是个不可思议的少女」"
                }
            }
        },
        linkback = "block_00039",
        linknext = "block_00041"
    },
    block_00041 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000679", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「我是兼职教师,她是弓张的学生。就这么一层关系,按理说,两人绝",
                    {"rt2"},
                    "不可能发展出更进一步的关系……」"
                }
            }
        },
        linkback = "block_00040",
        linknext = "block_00042"
    },
    block_00042 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000680", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「可是,从初次相遇那一刻起,我就在她身上感觉到一种不可思议的",
                    {"rt2"},
                    "气息」"
                }
            }
        },
        linkback = "block_00041",
        linknext = "block_00043"
    },
    block_00043 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000681", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「她凝视着什么的那双眼睛,总像是在望着某个遥远的地方……」"
                }
            }
        },
        linkback = "block_00042",
        linknext = "block_00044"
    },
    block_00044 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000682", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「有一次我问她,你在看什么呢?她回答说,在想晚饭吃什么」"
                }
            }
        },
        linkback = "block_00043",
        linknext = "block_00045"
    },
    block_00045 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「她就是在想吧?」"
                }
            }
        },
        linkback = "block_00044",
        linknext = "block_00046"
    },
    block_00046 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000683", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嘛,也许吧。只是,水菜一直是把种种心事藏在心底活过来的……。",
                    {"rt2"},
                    "我想她心里装着的东西,应该很多」"
                }
            }
        },
        linkback = "block_00045",
        linknext = "block_00047"
    },
    block_00047 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
