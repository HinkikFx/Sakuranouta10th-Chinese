        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「谁知道。我也不清楚。再说了我刚刚才明白事情有多严重，完全",
                    {"rt2"},
