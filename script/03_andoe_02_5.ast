                {
                    name = {"健一郎"},
                    "「我怎么知道」"
                }
            }
        },
        linkback = "block_00093",
        linknext = "block_00095"
    },
    block_00095 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊？不可能不知道吧。这个叫葛的姑娘，是吞梦者对吧？」"
                }
            }
