        text = {
            vo = {
                {"vo", file = "man_kid_000740", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「对。只要是能赚钱的事,那家伙就会成为你强大的盟友」"
                }
            }
