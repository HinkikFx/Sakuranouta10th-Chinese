astver = 2.0
astname = "ast"
ast = {
    block_00000 = {
        {"savetitle", text = "第Ⅲ章"},
        {"bg", file = "ev_com_f02_05", path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"bgm", file = "bgm029"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000654", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「诶——，真的假的——，中村那个大叔居然带着保镖去夏目家了」"
                }
            }
        },
        linknext = "block_00001"
    },
    block_00001 = {
        {"text"},
        text = {
            ja = {
                {"老爹一脸毫无紧张感的表情，说出了对今天发生的事的感想。"}
            }
        },
        linkback = "block_00000",
        linknext = "block_00002"
    },
    block_00002 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，没错。虽然他说不是保镖是保安」"
                }
            }
        },
        linkback = "block_00001",
        linknext = "block_00003"
    },
    block_00003 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000655", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「一回事吧。反正穿的是唬人的黑西装吧？真是的，都什么年代了",
                    {"rt2"},
                    "还干这种蠢事。不过，好歹不会像以前那样蛮干了」"
                }
            }
        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000656", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那么？你没事吧？」"
                }
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「被中村那个大叔打了一下，没什么大碍。要是被那个黑衣人打就",
                    {"rt2"},
                    "严重了」"
                }
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kzd_000179", ch = "kzd"}
            },
            ja = {
                {
                    name = {"雫", "葛"},
                    "「诶？直哉被打了？」"
                }
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊，不，是一点点。一点点。我也踢了对方一脚，所以扯平了」"
                }
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000657", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「喂喂，虽然说没以前那么危险了，但也别跟那帮黑衣人动手啊」"
                }
            }
        },
        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，我知道。下次会注意的」"
                }
            }
        },
        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「比起那个，中村家和葛，还有你之间的关系，把所有来龙去脉都",
                    {"rt2"},
                    "给我说清楚」"
                }
            }
        },
        linkback = "block_00009",
        linknext = "block_00011"
    },
    block_00011 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000658", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「是呢。嗯——」"
                }
            }
        },
        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            ja = {
                {"老爹看向了葛。"}
            }
        },
        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"text"},
        text = {
            ja = {
                {"葛的表情没有变化。"}
            }
        },
        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000659", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「你知道多少来着……」"
                }
            }
        },
        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就知道大概。你和老太太跟统治这一带很久的中村家叫了板。就",
                    {"rt2"},
                    "这点」"
                }
            }
        },
        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000660", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「是呢。说起来很长，我就挑重点讲一下。不过光是重点也够长的",
                    {"rt2"},
                    "了……」"
                }
            }
        },
        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000661", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「中村家，据说名字可以追溯到千年前的豪族。实际上，虽然只是",
                    {"rt2"},
                    "地方名流的地位，但与国政的政治家和财界的关系也很深」"
                }
            }
        },
        linkback = "block_00016",
        linknext = "block_00018"
    },
    block_00018 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000662", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯，从那个血脉中可是出过不少青史留名之人的。在国政中有影",
                    {"rt2"},
                    "响力也不奇怪」"
                }
            }
        },
        linkback = "block_00017",
        linknext = "block_00019"
    },
    block_00019 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但那些都是战后以前的事了」"
                }
            }
        },
        linkback = "block_00018",
        linknext = "block_00020"
    },
    block_00020 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000663", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯，战后不久，有人开始掌控弓张港的货物。那是外国物资如洪",
                    {"rt2"},
                    "水般涌入的新时代啊」"
                }
            }
        },
        linkback = "block_00019",
        linknext = "block_00021"
    },
    block_00021 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000664", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「毕竟是战后不久，正经人不会去干那种粗暴的差事。要管理那些",
                    {"rt2"},
                    "事得是相当厉害的豪杰才行」"
                }
            }
        },
        linkback = "block_00020",
        linknext = "block_00022"
    },
    block_00022 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000665", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那个豪杰，是个女人」"
                }
            }
        },
        linkback = "block_00021",
        linknext = "block_00023"
    },
    block_00023 = {
        {"bg", file = "ev_com_f02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000666", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「夏目琴子。也就是我的祖母」"
                }
            }
        },
        linkback = "block_00022",
        linknext = "block_00024"
    },
    block_00024 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000667", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「夏目琴子靠弓张港的货物白手起家。这里离东京不远，大量物资",
                    {"rt2"},
                    "从海外运来，赚了不少，后来也涉足了娱乐业」"
                }
            }
        },
        linkback = "block_00023",
        linknext = "block_00025"
    },
    block_00025 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「在当时，那种工作不是正经人干的。也就是说是极道」"
                }
            }
        },
        linkback = "block_00024",
        linknext = "block_00026"
    },
    block_00026 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000668", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「我小时候，提到夏目一家，那可真是一帮走路都带风的人」"
                }
            }
        },
        linkback = "block_00025",
        linknext = "block_00027"
    },
    block_00027 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000669", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「但是，对此不满的人也不少。其中之一就是中村章一」"
                }
            }
        },
        linkback = "block_00026",
        linknext = "block_00028"
    },
    block_00028 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000670", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「他无法容忍在战后的混乱中侵犯了弓张地盘的夏目一家」"
                }
            }
        },
        linkback = "block_00027",
        linknext = "block_00029"
    },
    block_00029 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000671", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「话说回来，中村家可是从镰仓时代延续下来的名门。并不是专门",
                    {"rt2"},
                    "搞黑道的」"
                }
            }
        },
        linkback = "block_00028",
        linknext = "block_00030"
    },
    block_00030 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000672", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「所以，他们找了关东的大型黑帮做靠山，想要压制弓张的地下势",
                    {"rt2"},
                    "力」"
                }
            }
        },
        linkback = "block_00029",
        linknext = "block_00031"
    },
    block_00031 = {
        {"bg", file = "ev_com_f02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000673", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「但那可是大失算。夏目一家面对关东的黑帮寸步不让，最后演变",
                    {"rt2"},
                    "成了战争」"
                }
            }
        },
        linkback = "block_00030",
        linknext = "block_00032"
    },
    block_00032 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000674", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯，也就是所谓的黑道火拼」"
                }
            }
        },
        linkback = "block_00031",
        linknext = "block_00033"
    },
    block_00033 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000675", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「结果是两败俱伤，不，准确地说，面对庞大组织也不屈服的夏目",
                    {"rt2"},
                    "一家赢了，这是普遍的看法。总之达成了和解」"
                }
            }
        },
        linkback = "block_00032",
        linknext = "block_00034"
    },
    block_00034 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但是，之后不知为何，一度达成和解的战争，在几年后再度爆发",
                    {"rt2"},
                    "了」"
                }
            }
        },
        linkback = "block_00033",
        linknext = "block_00035"
    },
    block_00035 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「点燃那个火药桶的人，是夏目琴子的孙子、草薙健一郎。也就是",
                    {"rt2"},
                    "说再次引发战争的是你」"
                }
            }
        },
        linkback = "block_00034",
        linknext = "block_00036"
    },
    block_00036 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000676", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「这么说也确实没法反驳。但我不是为了挑起夏目一家和中村家的",
                    {"rt2"},
                    "火拼才那样做的」"
                }
            }
        },
        linkback = "block_00035",
        linknext = "block_00037"
    },
    block_00037 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这些妈妈告诉过我很多次了。你是为了保护小音羽宅邸的少女们，",
                    {"rt2"},
                    "才引发了冲突」"
                }
            }
        },
        linkback = "block_00036",
        linknext = "block_00038"
    },
    block_00038 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000677", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「不，所以说，发展成大规模冲突的是夏目家老太太干的，我只是",
                    {"rt2"},
                    "想救住在小音羽宅邸的水菜」"
                }
            }
        },
        linkback = "block_00037",
        linknext = "block_00039"
    },
    block_00039 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就当是那样吧」"
                }
            }
        },
        linkback = "block_00038",
        linknext = "block_00040"
    },
    block_00040 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000678", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「水菜是一个不可思议的少女」"
                }
            }
        },
        linkback = "block_00039",
        linknext = "block_00041"
    },
    block_00041 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000679", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「我是兼职教师，她是弓张的学生。我们就是这样的关系，正常情",
                    {"rt2"},
                    "况下不可能发展出更深的关系……」"
                }
            }
        },
        linkback = "block_00040",
        linknext = "block_00042"
    },
    block_00042 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000680", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「但是，从第一次见面起，就感觉到她身上有种不可思议的气质」"
                }
            }
        },
        linkback = "block_00041",
        linknext = "block_00043"
    },
    block_00043 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000681", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「她注视着什么的眼神，总像是在望着很远的地方……」"
                }
            }
        },
        linkback = "block_00042",
        linknext = "block_00044"
    },
    block_00044 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000682", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「有一次我问她在看什么，她说在想晚饭吃什么」"
