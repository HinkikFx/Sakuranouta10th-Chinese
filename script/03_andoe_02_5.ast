    },
    block_00049 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这句话,是你常挂在嘴边的口头禅吧」"
                }
            }
        },
        linkback = "block_00048",
        linknext = "block_00050"
    },
    block_00050 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000686", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「口头禅?不,这本来是水菜问我的话。我只不过是,在反刍那句话罢",
                    {"rt2"},
                    "了」"
                }
            }
        },
        linkback = "block_00049",
        linknext = "block_00051"
    },
    block_00051 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000687", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「What is mind?　心为何物?No matter.　并非物质」"
                }
            }
        },
        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000688", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「What is matter?　 物质为何物?Never mind. 绝非心灵」"
                }
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「What is mind?　心算什么啊?」"
                }
            }
        },
        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「No matter.　怎样都无所谓啦」"
                }
            }
        },
        linkback = "block_00053",
        linknext = "block_00055"
    },
    block_00055 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「What is matter?　物算什么啊?」"
                }
            }
        },
        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「Never mind.　别放在心上啦」"
                }
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000689", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「她为什么会被这个英语的文字游戏迷住,如今我已明白其中的缘由」"
                }
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000690", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「明白是明白了,可即便明白了缘由的现在,这个文字游戏依然纠缠",
                    {"rt2"},
                    "着我不放」"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000691", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「所以,当我接受了水菜的死的那一刻,才终于画出了那幅画……」"
                }
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「横卧之樱吗……」"
                }
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000692", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「不,话题扯远了。现在要说的不是这个。总之,我遇见了水菜,种种",
                    {"rt2"},
                    "事让我放心不下,于是一连几天都缠着她」"
                }
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「彻头彻尾的跟踪狂啊」"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000693", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「你这家伙,一句一个吐槽烦不烦。因为还有纱希那件事,我才在意",
                    {"rt2"},
                    "的」"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「纱希的事?」"
                }
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000694", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「啊不,纱希的事是我这边的事。总之,我在那时得知了一个事实」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000695", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「水菜住的那座宅邸,对,就是如今被称作夏目宅邸的那座」"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000696", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那里,原本是用来安置中村家外室之子的宅邸」"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000697", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「中村家的人,管那里叫埋木舍。嘛,就是那么回事,是圈养外室之子",
                    {"rt2"},
                    "的宅邸的一种古风的隐语」"
                }
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「可如果那只是一座圈养外室之子的宅邸,你也不至于闹出发展成黑",
                    {"rt2"},
                    "道火并的事来」"
                }
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000698", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯,没错。如果只是把外室的孩子聚在一起,那没什么问题,不过是",
                    {"rt2"},
                    "各家有各家的家务事罢了」"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000699", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「但那里不一样。埋木舍——小音羽宅邸,并不是那种地方」"
                }
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000700", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「中村家这个家族,从很久很久以前起,就被某个传承附了身」"
                }
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000701", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「正是凭借那个传承,中村家才得以在长达千年的岁月里,作为名门",
                    {"rt2"},
                    "君临这片弓张之地。他们是这么深信的」"
                }
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「伯奇传承。或者说,吞梦巫女的传承」"
                }
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"bg", file = "ev_com_f02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000702", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「对,就是那个。在这一带广为流传的千年樱传承里就有。吞噬梦境",
                    {"rt2"},
                    "的少女——那就是伯奇」"
                }
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000703", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「镰仓时代,中村家接触到了一个名为方相氏的巫女一族。据说,两",
                    {"rt2"},
                    "家的血从此混在了一起」"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000704", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「所以直到今天,中村家的体内仍流淌着方相氏的血,而那条血脉,据",
                    {"rt2"},
                    "说时而会诞下伯奇」"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000705", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「伯奇一旦降生,一族便会繁荣昌盛。他们被这种妄想附身,足足千",
                    {"rt2"},
                    "年之久」"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000706", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「所以,中村家的人惧怕自己的血脉变淡」"
                }
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就算再怎么怕血脉变淡,法律上三亲等以内也是禁止结婚的」"
                }
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000707", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「为此才有的,埋木舍」"
                }
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
    block_00082 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「……让外室,生下外室之子」"
                }
            }
        },
        linkback = "block_00081",
        linknext = "block_00083"
    },
    block_00083 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000708", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯,一个疯狂的故事。为了不让自家的血脉变淡,让外室之子纳外",
                    {"rt2"},
                    "室,再让那外室生子。为了不让中村的血变淡,让他们无休无止地重",
                    {"rt2"},
                    "复着近亲交配」"
                }
            }
        },
        linkback = "block_00082",
        linknext = "block_00084"
    },
    block_00084 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000709", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「根本不是正常人干得出来的事……」"
                }
            }
        },
        linkback = "block_00083",
        linknext = "block_00085"
    },
    block_00085 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不惜做到这一步也不让血脉变淡的理由,就是伯奇吗?」"
                }
            }
        },
        linkback = "block_00084",
        linknext = "block_00086"
    },
    block_00086 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000710", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯,就是这么回事」"
                }
            }
        },
        linkback = "block_00085",
        linknext = "block_00087"
    },
    block_00087 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000711", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那帮家伙认为,只要方相氏的血不变淡,隔上几代,就必定会有伯奇",
                    {"rt2"},
                    "降生」"
                }
            }
        },
        linkback = "block_00086",
        linknext = "block_00088"
    },
    block_00088 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就算真有伯奇这种东西,就算把她弄到了手,一族就真能繁荣起来",
                    {"rt2"},
                    "吗。伯奇不就是个“吞噬人梦”的巫女吗?」"
                }
            }
        },
        linkback = "block_00087",
        linknext = "block_00089"
    },
    block_00089 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「光是吞噬人的梦,就能让一族繁荣,这可实在让人难以置信」"
                }
            }
        },
        linkback = "block_00088",
        linknext = "block_00090"
    },
    block_00090 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000712", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「所谓梦,就是无意识。能读取人的无意识,那可是相当了不得的能",
                    {"rt2"},
                    "力。嘛,至于吞下他人的梦就能预知未来什么的,就有些不靠谱了」"
                }
            }
        },
        linkback = "block_00089",
        linknext = "block_00091"
    },
    block_00091 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「还能预知?」"
                }
            }
        },
        linkback = "block_00090",
        linknext = "block_00092"
    },
    block_00092 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000713", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「从前中村章一慷慨激昂地宣讲过。对着夏目婆婆,嘛,婆婆根本没",
                    {"rt2"},
                    "搭理他就是了」"
                }
            }
        },
        linkback = "block_00091",
        linknext = "block_00093"
    },
    block_00093 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那实际上到底怎么样」"
                }
            }
        },
        linkback = "block_00092",
        linknext = "block_00094"
    },
    block_00094 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000714", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「我哪知道啊。那种事」"
                }
            }
        },
        linkback = "block_00093",
        linknext = "block_00095"
    },
    block_00095 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊?你怎么可能不知道。这个叫葛的姑娘,她不就是吞梦者吗?」"
                }
            }
        },
        linkback = "block_00094",
        linknext = "block_00096"
    },
    block_00096 = {
        {"bg", file = "ev_com_f02_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000715", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
