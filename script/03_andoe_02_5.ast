    },
    block_00112 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「老爸的身体?」"
                }
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000723", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯,这丫头是伯奇。时隔百年左右,降生在中村家。那帮家伙的夙",
                    {"rt2"},
                    "愿,就是葛」"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此,事情渐渐看清楚了」"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我知道你和夏目婆婆,用金钱的力量从中村家手里夺下了那座宅邸",
                    {"rt2"},
                    ",以及住在里面的人」"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000724", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「光听这一句,简直像人口买卖啊」"
                }
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯,说白了就是人口买卖。但那是为了拯救她们的行为」"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你们成功救出了小音羽宅邸里几乎所有的少女,却唯独没能买下身",
                    {"rt2"},
                    "为伯奇的葛」"
                }
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「毕竟是百年一遇的伯奇。那力量究竟如何我不清楚,但正如你所说",
                    {"rt2"},
                    ",对那个家族而言,她是夙愿般的存在吧」"
                }
            }
        },
        linkback = "block_00118",
        linknext = "block_00120"
    },
    block_00120 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000725", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯」"
                }
            }
        },
        linkback = "block_00119",
        linknext = "block_00121"
    },
    block_00121 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「他们向你索要的金额,和之前那些少女相比根本不可同日而语」"
                }
            }
        },
        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「只因为,她是伯奇」"
                }
            }
        },
        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「母亲死后,你也一直在攒钱。我以前一直不太明白那意味着什么」"
                }
            }
        },
        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但如果说,唯独赎回葛的金额是一笔巨款,那一切就都说得通了」"
                }
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000726", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「呼,这是像了谁呢……真敏锐啊。只托付给你一天,就能看透到这个",
                    {"rt2"},
                    "地步」"
                }
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「别小看人。这点事我还是看得出来的」"
                }
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000727", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「我叮嘱过葛,不许接近夏目家。可没想到,代替葛去夏目家的,会是",
                    {"rt2"},
                    "你」"
                }
            }
        },
        linkback = "block_00126",
        linknext = "block_00128"
    },
    block_00128 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「既然你在把她藏起来躲着什么,那十有八九,和那座宅邸脱不了干",
                    {"rt2"},
                    "系」"
                }
            }
        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000728", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「呼,还真是不好办啊」"
                }
            }
        },
        linkback = "block_00128",
        linknext = "block_00130"
    },
    block_00130 = {
        {"text"},
        text = {
            ja = {
                {"健一郎伸手按住眉心。"}
            }
        },
        linkback = "block_00129",
        linknext = "block_00131"
    },
    block_00131 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么不好办?」"
                }
            }
        },
        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000729", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「啊?我这好歹也算是个父亲啊」"
                }
            }
        },
        linkback = "block_00131",
        linknext = "block_00133"
    },
    block_00133 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以呢?」"
                }
            }
        },
        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000730", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「中村家是个可怕得超乎想象的家族。我自己就吃过大苦头」"
                }
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000731", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「一个不小心,连性命之危都可能招来,中村家就是这样的存在」"
                }
            }
        },
        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,如果你要说的是那种话,那就免了」"
                }
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000732", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「免了?免什么?」"
                }
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「反过来说,要是因为你力有不逮,葛落得凄惨下场,而你却不来找我",
                    {"rt2"},
                    "商量,那我才真要动手揍你」"
                }
            }
        },
        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000733", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「恐怕,你揍不成。等你知道的时候,我已经死了」"
                }
            }
        },
        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"bg", file = "ev_com_f02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那我就会恨你一辈子」"
                }
            }
        },
        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你把自己没能做到的事,推给了儿子。这才是草薙家正统的血脉」"
                }
            }
        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「要是你居然生出犹豫,那可不像你,是天大的误会」"
                }
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「后悔把我卷进来?哈?事到如今说什么呢。别以为临死了,草薙健一",
                    {"rt2"},
                    "郎就可以说出这种装好人的话来」"
                }
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"bg", file = "ev_com_f02_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000734", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「呵呵呵,有意思」"
                }
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你就是个死不掉的家伙。既然托付给了儿子,那就在一旁看着便是」"
                }
            }
        },
        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"bg", file = "ev_com_f02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000735", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「口气不小啊。这可是我花了十几年都没能解决的问题」"
                }
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你花十几年没能解决,不代表身为儿子的我也解决不了」"
                }
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000736", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「你还真打算解决啊」"
                }
            }
        },
        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「谁知道呢。不知道。说到底,我现在也只是刚刚理解了事情的严重",
                    {"rt2"},
                    "性,除了毫无计划,什么都谈不上」"
                }
