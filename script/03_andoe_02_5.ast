    block_00056 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「Never mind.　别在意」"
                }
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000689", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「她为什么会对这个英语双关语如此着迷，现在我能理解那个理由",
                    {"rt2"},
                    "了」"
                }
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000690", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「虽然理解了，但即便明白了理由，这句话仍然一直萦绕在我心头」"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000691", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「所以，直到我真正接受了水菜的死，我才终于画出了那幅画……」"
                }
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「横卧之樱啊……」"
                }
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000692", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「啊，话扯远了。现在不是说那个的时候。总之我遇到了水菜之后，",
                    {"rt2"},
                    "各种在意的事情多了起来，就跟踪了她好几天」"
                }
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「完全就是跟踪狂啊」"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000693", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「你真是什么都要插嘴。因为纱希的事也有在嘛所以在意」"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「纱希的事？」"
                }
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000694", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「不，纱希的事就不说了。 我由此得知了一个事实」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000695", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「水菜住的那栋宅邸，就是现在被称为夏目宅邸的那个」"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000696", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那是用来安置中村家庶出子女的宅邸」"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000697", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「中村家的人把那里叫做",
                    {"txruby", text = "うもれぎのや"},
                    "埋木舍",
                    {"txruby"},
                    "。嗯，就是把妾生的孩子集中起来",
                    {"rt2"},
                    "的宅邸的古雅说法」"
                }
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但如果只是把庶出的孩子集中在一起的话，你也不至于做出引发",
                    {"rt2"},
                    "黑道火拼那种事来」"
                }
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000698", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯，没错。如果只是把庶出的孩子聚在一起那倒没什么。只是各",
                    {"rt2"},
                    "家各户的家务事罢了」"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000699", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「但那并非如此。埋木舍、小音羽宅邸不是那样的地方」"
                }
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000700", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「中村家从很久很久以前就一直被某个传说所缠绕」"
                }
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000701", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「凭借那个传说，中村家相信自己千年来一直以名门的身份君临这",
                    {"rt2"},
                    "片弓张大地」"
                }
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「伯奇传说。或者说吞梦巫女传说」"
                }
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"bg", file = "ev_com_f02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000702", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯，就是那个。在这一带很有名的千年樱传说中出现的，吞噬梦",
                    {"rt2"},
                    "境的少女。那就是伯奇」"
                }
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000703", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「镰仓时代，中村家与一个叫方相氏的巫女一族接触了。然后，那",
                    {"rt2"},
                    "些血脉交融在了一起」"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000704", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「所以时至今日中村家仍流淌着方相氏的血，而且那个血脉，时不",
                    {"rt2"},
                    "时会诞生出伯奇」"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000705", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「如果伯奇诞生，一族就会繁荣。他们被这种妄想缠绕了整整一千",
                    {"rt2"},
                    "年」"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000706", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「所以，中村家的人害怕自己的血脉被稀释」"
                }
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「怕血脉稀释也没用啊，法律规定三等亲以内禁止结婚」"
                }
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000707", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「为此才有了",
                    {"txruby", text = "うもれぎのや"},
                    "埋木舍",
                    {"txruby"},
                    "」"
                }
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
    block_00082 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「……让妾生下妾的孩子」"
                }
            }
        },
        linkback = "block_00081",
        linknext = "block_00083"
    },
    block_00083 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000708", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯，疯狂的事。为了不让自己的血脉变薄，让庶出之子纳妾，再",
                    {"rt2"},
                    "让那些妾生子。为了中村的血不被稀释，不断地重复近亲交配」"
                }
            }
        },
        linkback = "block_00082",
        linknext = "block_00084"
    },
    block_00084 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000709", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「简直丧心病狂……」"
                }
            }
        },
        linkback = "block_00083",
        linknext = "block_00085"
    },
    block_00085 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不惜一切也不让血脉变薄的理由。就是伯奇吗？」"
                }
            }
        },
        linkback = "block_00084",
        linknext = "block_00086"
    },
    block_00086 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000710", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯，就是那么回事」"
                }
            }
        },
        linkback = "block_00085",
        linknext = "block_00087"
    },
    block_00087 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000711", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「他们认为，只要方相氏的血没有稀释，每过几代必定会有伯奇诞",
                    {"rt2"},
                    "生」"
                }
            }
        },
        linkback = "block_00086",
        linknext = "block_00088"
    },
    block_00088 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就算伯奇这种人真的存在，得到了又能怎样，一族就能繁荣了？",
                    {"rt2"},
                    "伯奇不就是'吞噬人的梦'的巫女吗？」"
                }
            }
        },
        linkback = "block_00087",
        linknext = "block_00089"
    },
    block_00089 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「光吞噬人的梦就能让一族繁荣，实在难以置信」"
                }
            }
        },
        linkback = "block_00088",
        linknext = "block_00090"
    },
    block_00090 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000712", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「梦就是无意识。能读取人的无意识那可是相当厉害的能力吧。嗯，",
                    {"rt2"},
                    "吞噬他人的梦来预知什么的就有点扯了」"
                }
            }
        },
        linkback = "block_00089",
        linknext = "block_00091"
    },
    block_00091 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「能预知吗？」"
                }
            }
        },
        linkback = "block_00090",
        linknext = "block_00092"
    },
    block_00092 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000713", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「以前中村章一跟夏目老太太慷慨激昂地讲过。不过老太太根本没",
                    {"rt2"},
                    "放在心上」"
                }
