        },
        linkback = "block_00232",
        linknext = "block_00234"
    },
    block_00234 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,是印象派,因乔治·修拉而闻名的技法」"
                }
            }
        },
        linkback = "block_00233",
        linknext = "block_00235"
    },
    block_00235 = {
        {"text"},
        text = {
            ja = {
                {"印象派粗放的笔触,本就是让鲜艳色彩的排列在视觉中混合的技法。"}
            }
        },
        linkback = "block_00234",
        linknext = "block_00236"
    },
    block_00236 = {
        {"text"},
        text = {
            ja = {
                {
                    "而法国画家乔治·修拉将其进一步钻研,借由点的色彩,让排列的视觉",
                    {"rt2"},
                    "混合更上一层。"
                }
            }
        },
        linkback = "block_00235",
        linknext = "block_00237"
    },
    block_00237 = {
        {"text"},
        text = {
            ja = {
                {"这种以点的集合构筑画面的技法,便称为点彩画。"}
            }
        },
        linkback = "block_00236",
        linknext = "block_00238"
    },
    block_00238 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「如今已经算不上多主流的技法了」"
                }
            }
        },
        linkback = "block_00237",
        linknext = "block_00239"
    },
    block_00239 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「一门完全没能成为主流的技法」"
                }
            }
        },
        linkback = "block_00238",
        linknext = "block_00240"
    },
    block_00240 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为,这门技法早已变得平凡了」"
                }
