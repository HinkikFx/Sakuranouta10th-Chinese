    },
    block_00223 = {
        {"text"},
        text = {
            ja = {
                {"停下来的吹注意到了这边。"}
            }
        },
        linkback = "block_00222",
        linknext = "block_00224"
    },
    block_00224 = {
        {"text"},
        text = {
            ja = {
                {"我像是在弥补失去的时间般，不断用颜料打点。"}
            }
        },
        linkback = "block_00223",
        linknext = "block_00225"
    },
    block_00225 = {
        {"text"},
        text = {
            ja = {
                {"在这片黑暗中视觉不可信赖。所以我只相信至今为止的经验来上色。"}
            }
        },
        linkback = "block_00224",
        linknext = "block_00226"
    },
    block_00226 = {
        {"text"},
        text = {
            ja = {
                {"这个技法诞生于一百三十多年前。"}
            }
        },
        linkback = "block_00225",
        linknext = "block_00227"
    },
    block_00227 = {
        {"text"},
        text = {
            ja = {
                {"现在的绘画领域中使用这种技法的专业画家已经不多了。"}
            }
        },
        linkback = "block_00226",
        linknext = "block_00228"
    },
    block_00228 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000626", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「这、这不是……」"
                }
            }
        },
        linkback = "block_00227",
        linknext = "block_00229"
    },
    block_00229 = {
        {"text"},
        text = {
            ja = {
                {"点的集合开始构成意义。"}
            }
        },
        linkback = "block_00228",
        linknext = "block_00230"
    },
    block_00230 = {
        {"text"},
        text = {
            ja = {
                {"月亮重新露出。"}
            }
        },
        linkback = "block_00229",
        linknext = "block_00231"
    },
    block_00231 = {
        {"bg", file = "ev_com_i05_03", time = 500, sync = 1, path = ":ev/ev_com_i05/", set = "ev_com_i05"},
        {"bg", file = "ev_com_i05_02", sync = 1, path = ":ev/ev_com_i05/", set = "ev_com_i05"},
        {"text"},
        text = {
            ja = {
                {
                    "那一瞬间，我画的东西显现出来，与之交界的吹的画的色彩也骤然",
                    {"rt2"},
                    "变了样。"
                }
            }
        },
        linkback = "block_00230",
        linknext = "block_00232"
    },
    block_00232 = {
        {"text"},
        text = {
            ja = {
                {"一切都跟月亮被遮住之前截然不同。焕发出全新的色彩光辉。"}
            }
        },
        linkback = "block_00231",
        linknext = "block_00233"
    },
    block_00233 = {
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"colortone", inter = 1, ssize = 2, ease = "in", sfade = 3000, style = "raster"},
        {"bg", file = "ev_uni_c59_01", path = ":ev/ev_uni_c59/", set = "ev_uni_c59", sync = 0},
        {"extrans", time = 500},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000627", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「这、这是……点彩画？」"
                }
            }
        },
        linkback = "block_00232",
        linknext = "block_00234"
    },
    block_00234 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「对，印象派中因乔治·修拉而闻名的技法」"
                }
            }
        },
        linkback = "block_00233",
        linknext = "block_00235"
    },
    block_00235 = {
        {"text"},
        text = {
            ja = {
                {
                    "印象派粗犷笔触本身就具有通过鲜明色彩排列的视觉混合来呈现的",
                    {"rt2"},
                    "技法。"
                }
            }
        },
        linkback = "block_00234",
        linknext = "block_00236"
    },
    block_00236 = {
        {"text"},
        text = {
            ja = {
                {
                    "但法国画家乔治·修拉将其进一步推进，使点状色彩排列的视觉混合",
                    {"rt2"},
                    "得以进化。"
                }
            }
        },
        linkback = "block_00235",
        linknext = "block_00237"
    },
    block_00237 = {
        {"text"},
        text = {
            ja = {
                {"由点的集合体构成的技法被称为点彩画。"}
            }
        },
        linkback = "block_00236",
        linknext = "block_00238"
    },
    block_00238 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「如今这已经不算主流技法了」"
                }
            }
        },
        linkback = "block_00237",
        linknext = "block_00239"
    },
    block_00239 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「完全没有成为主流的技法」"
                }
            }
        },
        linkback = "block_00238",
        linknext = "block_00240"
    },
    block_00240 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为这种技法已经被'平庸化'了」"
                }
            }
        },
        linkback = "block_00239",
        linknext = "block_00241"
    },
    block_00241 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000628", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「平庸化……」"
                }
            }
        },
        linkback = "block_00240",
        linknext = "block_00242"
    },
    block_00242 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「RGB，就是红、绿、蓝。三种发光元素组合在一起可以表现所有",
                    {"rt2"},
                    "色彩」"
                }
            }
        },
        linkback = "block_00241",
        linknext = "block_00243"
    },
    block_00243 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「光的三原色。所有显示器都在用的原理」"
                }
            }
        },
        linkback = "block_00242",
        linknext = "block_00244"
    },
    block_00244 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「如今，修拉所做的视觉混合，在艺术以外的领域反而更常见。电",
                    {"rt2"},
                    "视、手机，例子不胜枚举」"
                }
            }
        },
        linkback = "block_00243",
        linknext = "block_00245"
    },
    block_00245 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「点彩在将色彩推到极致时，有时能产生压倒性的表现力」"
                }
            }
        },
        linkback = "block_00244",
        linknext = "block_00246"
    },
    block_00246 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「正因如此才能在比试中派上用场。如果吹的画是色彩的漩涡，那",
                    {"rt2"},
                    "点彩画就是吞噬那漩涡的色彩风暴」"
                }
            }
        },
        linkback = "block_00245",
        linknext = "block_00247"
    },
    block_00247 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「对，就像暴风雨中飞舞的樱花雪！」"
