        linkback = "block_00242",
        linknext = "block_00244"
    },
    block_00244 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「如今,修拉搞出的视觉混合,反倒在艺术之外的领域更为人熟悉。",
