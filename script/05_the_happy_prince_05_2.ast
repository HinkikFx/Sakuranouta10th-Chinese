        },
        linkback = "block_00230",
        linknext = "block_00232"
    },
    block_00232 = {
        {"text"},
        text = {
            ja = {
                {"一切都与乌云蔽月之前截然不同。以崭新的颜色熠熠生辉。"}
            }
