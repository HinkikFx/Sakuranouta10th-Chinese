        linkback = "block_00308",
        linknext = "block_00310"
    },
    block_00310 = {
        {"fg", ch = "吹", size = "z1", mode = 3, path = ":fg/sui/z1/", file = "sui_z1a0200", face = "a0002", head = "sui_z1a", lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_sud_000779", ch = "sud"}
            },
            ja = {
                {
                    name = {"吹"},
                    "「我看得出来。因为草薙同学和圭同学,就是那样的艺术家」"
                }
            }
        },
        linkback = "block_00309",
        linknext = "block_00311"
    },
    block_00311 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_sud_000780", ch = "sud"}
            },
            ja = {
                {
                    name = {"吹"},
                    "「不过,为和圭同学的对决左思右想,纯属白费。因为草薙同学的画,",
                    {"rt2"},
                    "本就仿佛是凭借与其他画作的因果而发光的……」"
                }
            }
        },
        linkback = "block_00310",
        linknext = "block_00312"
    },
    block_00312 = {
        {"text"},
