        linkback = "block_00305",
        linknext = "block_00307"
    },
    block_00307 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_sud_000777", ch = "sud"}
            },
            ja = {
                {
                    name = {"吹"},
                    "「草薙同学,就是这样一位艺术家」"
