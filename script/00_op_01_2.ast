        linkback = "block_00252",
        linknext = "block_00254"
    },
    block_00254 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「话说，那个雫小姐怎么可能允许一个素不相识的人住进家里啊？",
