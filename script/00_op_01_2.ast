    block_00240 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「再说了一起住……是指和圭还有蓝一起在同一个屋檐下生活的意",
                    {"rt2"},
                    "思吧？」"
                }
            }
        },
        linkback = "block_00239",
        linknext = "block_00241"
    },
    block_00241 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_ked_000083", ch = "ked"}
            },
            ja = {
                {
                    name = {"圭"},
                    "「啊，对了，不只是我们。妹妹回来了」"
                }
            }
        },
        linkback = "block_00240",
        linknext = "block_00242"
    },
    block_00242 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「妹妹？」"
                }
            }
        },
        linkback = "block_00241",
        linknext = "block_00243"
    },
    block_00243 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000082", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「对，上个月妹妹回来了。现在夏目宅邸三个人一起住」"
                }
