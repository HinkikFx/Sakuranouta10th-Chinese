        linkback = "block_00251",
        linknext = "block_00253"
    },
    block_00253 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不，没有别的意思。只是想着原来叫这个名字啊。就那样」"
