        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「哈?　说什么胡话呢。既然醒了就从被窝里出来啊」"
