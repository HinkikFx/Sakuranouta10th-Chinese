        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「知道了知道了,快起来。喂,别让我费那么多工夫。再磨磨蹭蹭可",
