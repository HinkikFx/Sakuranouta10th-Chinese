        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"text"},
        text = {
            ja = {
                {"对我来说尤其熟悉。"}
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"bg", file = "ev_uni_c11_01", path = ":ev/ev_uni_c11/", set = "ev_uni_c11"},
        {"text"},
        text = {
            ja = {
                {"法国画家爱德华·马奈的代表作之一。那就是『奥林匹亚』。"}
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            ja = {
                {"据说发表当时引起了轩然大波的裸妇画。"}
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"text"},
        text = {
            ja = {
                {"据说报纸上给出了「母猩猩」「无赖小丫头」之类的一片恶评。"}
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            ja = {
                {"甚至有人在展览会上挥舞手杖大闹了一场。"}
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"text"},
        text = {
            ja = {
                {"话虽如此，那些恶评本身，正是马奈的意图所在……。"}
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            ja = {
                {
                    "在『奥林匹亚』之前。描绘裸女的行为，即等同于描绘",
                    {"txruby", text = "维纳斯"},
                    "女神",
                    {"txruby"},
                    "的行为。"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"text"},
        text = {
            ja = {
                {
                    "就算画家本人无意描绘",
                    {"txruby", text = "维纳斯"},
                    "女神",
                    {"txruby"},
                    "，把画修饰得像那么回事，也是当时的",
                    {"rt2"},
                    "常识。"
                }
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"text"},
        text = {
            ja = {
                {"也就是说，要画裸妇，必须有大义名分。"}
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"text"},
        text = {
            ja = {
                {"而马奈刻意无视了这一点。"}
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
    block_00082 = {
        {"text"},
        text = {
            ja = {
                {"穿旧了的凉鞋。"}
            }
        },
        linkback = "block_00081",
        linknext = "block_00083"
    },
    block_00083 = {
        {"text"},
        text = {
            ja = {
                {"金手镯。"}
            }
        },
        linkback = "block_00082",
        linknext = "block_00084"
    },
    block_00084 = {
        {"text"},
        text = {
            ja = {
                {"颈间黑色的丝带项圈。"}
            }
        },
        linkback = "block_00083",
        linknext = "block_00085"
    },
    block_00085 = {
        {"text"},
        text = {
            ja = {
                {
                    "横卧在白色床单上的姿态，连同构图在内，都与早于马奈300多年",
                    {"rt2"},
                    "的画家提香的作品『乌尔比诺的维纳斯』如出一辙，"
                }
            }
        },
        linkback = "block_00084",
        linknext = "block_00086"
    },
    block_00086 = {
        {"text"},
        text = {
            ja = {
                {
                    "但那生动逼真的细节，却将这幅画与300年前画家提香的“维纳斯”",
                    {"rt2"},
                    "及其意义，完全分割开来。"
                }
            }
        },
        linkback = "block_00085",
        linknext = "block_00087"
    },
    block_00087 = {
        {"text"},
        text = {
            ja = {
                {"在当时的法国，“奥林匹亚”正是“娼妇”的代称。"}
            }
        },
        linkback = "block_00086",
        linknext = "block_00088"
    },
    block_00088 = {
        {"text"},
        text = {
            ja = {
                {"站在娼妇身后的黑人女仆手中之物。"}
            }
        },
        linkback = "block_00087",
        linknext = "block_00089"
    },
    block_00089 = {
        {"text"},
        text = {
            ja = {
                {"立于娼妇脚边的黑猫。"}
            }
        },
        linkback = "block_00088",
        linknext = "block_00090"
    },
    block_00090 = {
        {"text"},
        text = {
            ja = {
                {"一切都经过精心计算。"}
            }
        },
        linkback = "block_00089",
        linknext = "block_00091"
    },
    block_00091 = {
        {"text"},
        text = {
            ja = {
                {
                    "知道了缘由，便能理解为何有人在展览会上看到这幅画后，会挥舞",
                    {"rt2"},
                    "手杖大闹一场了。"
                }
            }
        },
        linkback = "block_00090",
        linknext = "block_00092"
    },
    block_00092 = {
        {"text"},
        text = {
            ja = {
                {"据说那是因为，只要是买过娼妇的人，就都熟悉这种独特的氛围。"}
            }
        },
        linkback = "block_00091",
        linknext = "block_00093"
    },
    block_00093 = {
        {"text"},
        text = {
            ja = {
                {"身后女仆手中拿着的是“花束”。当然，是客人送的礼物。"}
            }
        },
        linkback = "block_00092",
        linknext = "block_00094"
    },
    block_00094 = {
        {"text"},
        text = {
            ja = {
                {
                    "画在脚边的猫瞪大双眼，前爪紧绷、弓起脊背，一副紧张的模样。",
                    {"rt2"},
                    "看上去简直像在威吓来访者。"
                }
            }
        },
        linkback = "block_00093",
        linknext = "block_00095"
    },
    block_00095 = {
        {"text"},
        text = {
            ja = {
                {"那位来访者又是谁呢。"}
            }
        },
        linkback = "block_00094",
        linknext = "block_00096"
    },
    block_00096 = {
        {"text"},
        text = {
            ja = {
                {"当然。是来买娼妇的客人。"}
            }
        },
        linkback = "block_00095",
        linknext = "block_00097"
    },
    block_00097 = {
        {"text"},
        text = {
            ja = {
                {"而那位来访者的视点，恰恰与观画者的视点重合。"}
            }
        },
        linkback = "block_00096",
        linknext = "block_00098"
    },
    block_00098 = {
        {"text"},
        text = {
            ja = {
                {"正因如此，这幅画会给心中有数的人一种独特的感受。"}
            }
        },
        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            ja = {
                {"让人感到一种独特的不快。"}
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"text"},
        text = {
            ja = {
                {
                    "看到这幅画而挥舞手杖的男子人，感受到的大概正是这种东西吧…",
                    {"rt2"},
                    "…。"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            ja = {
                {"『奥林匹亚』对我而言，是最熟悉的画之一。"}
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"text"},
        text = {
            ja = {
                {
                    "理由自不必说。因为夏目家的入口处，一直挂着一幅『奥林匹亚』",
                    {"rt2"},
                    "的临摹。"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"text"},
        text = {
            ja = {
                {
                    "那个手巧的男子人画出来的东西，与其说是临摹，不如说已是赝品",
                    {"rt2"},
                    "的水准。"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            ja = {
                {"作者是草薙健一郎。"}
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            ja = {
                {"前不久刚去世的。世界级的艺术家。"}
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            ja = {
                {"那是他成名之前画的作品。"}
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            ja = {
                {
                    "就算那幅画直接作为『奥林匹亚』的习作流入市场，大半的人也看",
                    {"rt2"},
                    "不出破绽吧。"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            ja = {
                {"搞不好连著名美术馆的策展人都识不破，径直把它挂上展览会。"}
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
