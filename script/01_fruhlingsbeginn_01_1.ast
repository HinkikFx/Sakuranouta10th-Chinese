        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"text"},
        text = {
            ja = {
                {
                    "那幅画自很久以前就挂在夏目家，大到与日式房屋格格不入。绘制",
                    {"rt2"},
                    "在宽约一百厘米的画布上。"
                }
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"bg", file = "ev_uni_c11_01", path = ":ev/ev_uni_c11/", set = "ev_uni_c11"},
        {"text"},
        text = {
            ja = {
                {"画的名字是《奥林匹亚》。法国画家爱德华·马奈的代表作。"}
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"text"},
        text = {
            ja = {
                {"当然不是真品。"}
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
    block_00082 = {
        {"text"},
        text = {
            ja = {
                {
                    "爱德华·马奈代表作的真迹不可能出现在这种地方。真正的《奥林匹",
                    {"rt2"},
                    "亚》收藏在巴黎的奥赛美术馆。"
                }
            }
        },
        linkback = "block_00081",
        linknext = "block_00083"
    },
    block_00083 = {
        {"text"},
        text = {
            ja = {
                {"尺寸也只有奥赛真迹的一半左右。"}
            }
        },
        linkback = "block_00082",
        linknext = "block_00084"
    },
    block_00084 = {
        {"text"},
        text = {
            ja = {
                {"话虽如此，这也不是照片或印刷品。而是如假包换的油画。"}
            }
        },
        linkback = "block_00083",
        linknext = "block_00085"
    },
    block_00085 = {
        {"text"},
        text = {
            ja = {
                {
                    "近看的话，甚至会让人产生难道是马奈本人所画的错觉。与其说是",
                    {"rt2"},
                    "临摹，不如说几乎可以称为赝品也不为过。"
                }
            }
        },
        linkback = "block_00084",
        linknext = "block_00086"
    },
    block_00086 = {
        {"text"},
        text = {
            ja = {
                {"不过似乎曾经破损过，局部可以看到修复的痕迹。"}
            }
        },
        linkback = "block_00085",
        linknext = "block_00087"
    },
    block_00087 = {
        {"text"},
        text = {
            ja = {
                {"这幅《奥林匹亚》的作者是草薙健一郎。"}
            }
        },
        linkback = "block_00086",
        linknext = "block_00088"
    },
    block_00088 = {
        {"text"},
        text = {
            ja = {
                {"就是那个草薙健一郎。"}
            }
        },
        linkback = "block_00087",
        linknext = "block_00089"
    },
    block_00089 = {
        {"text"},
        text = {
            ja = {
                {"据说那是他与母亲相遇时最初赠送的作品。"}
            }
        },
        linkback = "block_00088",
        linknext = "block_00090"
    },
    block_00090 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「第一次送给女人的礼物，偏偏是裸女画。而且还是《奥林匹亚》",
                    {"rt2"},
                    "……」"
                }
