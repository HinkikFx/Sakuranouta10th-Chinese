    },
    block_00077 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「要是缺钱的话，把它卖掉不就好了……」"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            ja = {
                {"出了房间来到走廊，就能看见玄关深处那幅巨大的裸妇像。"}
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"text"},
        text = {
            ja = {
                {
                    "它自很久以前就挂在夏目家，大得与日式宅邸格格不入。画在横幅",
                    {"rt2"},
                    "约一百厘米的画布上。"
                }
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"bg", file = "ev_uni_c11_01", path = ":ev/ev_uni_c11/", set = "ev_uni_c11"},
        {"text"},
        text = {
            ja = {
                {"画的名字是《奥林匹亚》。法国画家爱德华·马奈的代表作。"}
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"text"},
        text = {
            ja = {
                {"当然不是真迹。"}
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
    block_00082 = {
        {"text"},
        text = {
            ja = {
                {
                    "爱德华·马奈代表作的真迹，不可能出现在这种人家里。真迹《奥林",
                    {"rt2"},
                    "匹亚》收藏于巴黎的奥赛美术馆。"
                }
            }
        },
        linkback = "block_00081",
        linknext = "block_00083"
    },
    block_00083 = {
        {"text"},
        text = {
            ja = {
                {"尺寸也只有奥赛那幅真迹的一半左右。"}
            }
        },
        linkback = "block_00082",
        linknext = "block_00084"
    },
    block_00084 = {
        {"text"},
        text = {
            ja = {
                {"话虽如此，它也并非照片或印刷品。而是货真价实的油画。"}
            }
        },
        linkback = "block_00083",
        linknext = "block_00085"
    },
    block_00085 = {
        {"text"},
        text = {
            ja = {
                {
                    "凑近了看，画得好到让人恍惚以为——这莫非是马奈本人的手笔？与",
                    {"rt2"},
                    "其说是临摹，不如说称之为赝作也毫不为过。"
                }
            }
        },
        linkback = "block_00084",
        linknext = "block_00086"
    },
    block_00086 = {
        {"text"},
        text = {
            ja = {
                {"只是它似乎曾经破损过一次，零零星星能看出修复的痕迹。"}
            }
        },
        linkback = "block_00085",
        linknext = "block_00087"
    },
    block_00087 = {
        {"text"},
        text = {
            ja = {
                {"这幅《奥林匹亚》的作者，是草薙健一郎。"}
            }
        },
        linkback = "block_00086",
        linknext = "block_00088"
    },
    block_00088 = {
        {"text"},
        text = {
            ja = {
                {"正是那个草薙健一郎。"}
            }
        },
        linkback = "block_00087",
        linknext = "block_00089"
    },
    block_00089 = {
        {"text"},
        text = {
            ja = {
                {"据说这是那家伙与母亲相遇时，送出的第一件作品。"}
            }
        },
        linkback = "block_00088",
        linknext = "block_00090"
    },
    block_00090 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「第一次送给女人的礼物，偏偏是幅裸妇像。而且还是《奥林匹亚",
                    {"rt2"},
                    "》……」"
                }
            }
        },
        linkback = "block_00089",
        linknext = "block_00091"
    },
    block_00091 = {
        {"text"},
        text = {
            ja = {
                {"实在是太像那家伙的做派了。是只有那家伙才会做出的选择。"}
            }
        },
        linkback = "block_00090",
        linknext = "block_00092"
    },
    block_00092 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「真是的……人都死了，还得处处看见那家伙的影子，真是难办啊」"
                }
            }
        },
        linkback = "block_00091",
        linknext = "block_00093"
    },
    block_00093 = {
        {"text"},
        text = {
            ja = {
                {
                    "平时只是匆匆瞥上一眼，但趁着清晨独自一人，我细细品味了一番",
                    {"rt2"},
                    "草薙健一郎所作的这幅临摹《奥林匹亚》。"
                }
            }
        },
        linkback = "block_00092",
        linknext = "block_00094"
    },
    block_00094 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「真是个灵巧的男子人」"
                }
            }
        },
        linkback = "block_00093",
        linknext = "block_00095"
    },
    block_00095 = {
        {"text"},
        text = {
            ja = {
                {
                    "比起孩提时看到的，不，不如说正是现在，才更被那高超的技术所",
                    {"rt2"},
                    "震撼。"
                }
            }
        },
        linkback = "block_00094",
        linknext = "block_00096"
    },
    block_00096 = {
        {"text"},
        text = {
            ja = {
                {"历史上的许多著名画家，都留下过作为习作的临摹。"}
            }
        },
        linkback = "block_00095",
        linknext = "block_00097"
    },
    block_00097 = {
        {"text"},
        text = {
            ja = {
                {"即便如此，历史性画家的临摹，也未必与原作分毫不差。"}
            }
        },
        linkback = "block_00096",
        linknext = "block_00098"
    },
    block_00098 = {
        {"text"},
        text = {
            ja = {
                {"相反，越是世界级名画家的临摹，越常常被拉向自己的风格。"}
            }
        },
        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            ja = {
                {"但是，这幅《奥林匹亚》却被作为一幅精巧的临摹完成了。"}
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"text"},
        text = {
            ja = {
                {
                    "我并不了解草薙健一郎全部的临摹作品，但如此精巧的临摹，我从",
                    {"rt2"},
                    "未见过。"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            ja = {
                {"尽管只是部分之处，其中也有刻意与真迹画得不同的地方。"}
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"text"},
        text = {
            ja = {
                {"比如头发比真迹更接近黑色。"}
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"text"},
        text = {
            ja = {
                {"比如模特比真迹更为纤瘦。"}
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            ja = {
                {"话虽如此，那也不过是“找不同”级别的差异。"}
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            ja = {
                {"若不是熟知真迹的人，根本看不出区别。"}
