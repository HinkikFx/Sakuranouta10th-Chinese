        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_nnd_000097", ch = "nnd"}
            },
            ja = {
                {
                    name = {"乃乃未"},
                    "「班里的万人迷。会读书的秀才君。擅长运动的领队君。和大人的",
