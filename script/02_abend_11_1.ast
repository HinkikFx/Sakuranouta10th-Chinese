        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"fg", ch = "吹", mode = 3, path = ":fg/sui/z1/", file = "sui_z1a0100", face = "a0006", head = "sui_z1a", lv = 4, id = 9},
