        text = {
            vo = {
                {"vo", file = "fem_sud_000126", ch = "sud"}
            },
            ja = {
                {
                    name = {"吹"},
                    "「啊，啊啊……的确好像见过。你叫……田中同学！　田中角荣同学！",
                    {"rt2"},
                    "」"
