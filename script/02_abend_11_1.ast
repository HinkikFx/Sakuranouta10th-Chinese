        linkback = "block_00119",
        linknext = "block_00121"
    },
    block_00121 = {
        {"fg", ch = "吹", mode = 3, path = ":fg/sui/z1/", file = "sui_z1a0110", face = "a0009", head = "sui_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_sud_000127", ch = "sud"}
            },
            ja = {
                {
                    name = {"吹"},
                    "「是吗？　我记得应该是田中同学或者高桥同学或者铃木同学或者",
                    {"rt2"},
                    "佐藤同学来着……」"
                }
            }
        },
        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你只是在排列日本常见的姓氏吧」"
