        linkback = "block_00126",
        linknext = "block_00128"
    },
    block_00128 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那个不跟姓一起念的话很奇怪啊。名字叫乃剣是什么鬼」"
