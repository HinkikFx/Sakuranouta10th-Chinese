        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"fg", ch = "吹", mode = 3, path = ":fg/sui/z1/", file = "sui_z1a0100", face = "a0001", head = "sui_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_sud_000128", ch = "sud"}
            },
            ja = {
                {
                    name = {"吹"},
                    "「这样啊。那么您的名字该怎么办呢?」"
                }
            }
        },
        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么叫怎么办啊。用不着跟你商量,我有草薙直哉这个名字!」"
