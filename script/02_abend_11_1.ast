        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「从草薙联想到“草薙之剑”,你这印象得有多偏啊……你这家伙……」"
                }
