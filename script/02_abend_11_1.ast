        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么怎么办。不用你来操心我也有草薙直哉这个名字好吧！」"
