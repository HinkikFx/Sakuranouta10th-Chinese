        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"fg", ch = "吹", mode = 3, path = ":fg/sui/z1/", file = "sui_z1a0110", face = "a0001", head = "sui_z1a", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "吹", mode = 3, path = ":fg/sui/z1/", file = "sui_z1a0110", face = "a0006", head = "sui_z1a", lv = 4, id = 9}
