        },
        text = {
            vo = {
                {"vo", file = "fem_sud_000129", ch = "sud"}
            },
            ja = {
                {
                    name = {"吹"},
                    "「哦,草薙直哉……。只有名字倒是挺帅气的呢。简直像一把剑」"
