    },
    block_00217 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_000178", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「嗯，我就知道直哉会这么说」"
                }
            }
