        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_001836", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「就算是做说明,如果是自然而然说出口的,眉间才不会皱起来呢。",
                    {"rt2"},
                    "你的谎话根本一眼就穿」"
                }
