            ja = {
                {
                    name = {"真琴"},
                    "「是吧,白色碟子那边,是想衬托戚风蛋糕可爱的粉色,简约之余,营造",
                    {"rt2"},
                    "出轻飘飘的、像梦境又像绘本一样的氛围……」"
