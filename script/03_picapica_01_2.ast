        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_001837", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「你在裸体素描这件事上,讨厌模特和画家之间存在关系,绝对另有",
