        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"text"},
        text = {
            ja = {
                {
                    "像发社团招新传单那种事就饶了我吧,不过那之后鸟谷似乎也反省了",
                    {"rt2"},
                    "不少,那种异想天开的主意,应该不会再付诸实行了。"
                }
