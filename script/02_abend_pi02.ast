        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"se", id = 1, file = "se3434"},
        {"text"},
        text = {
            ja = {
                {
                    "一言不发就挂断也不太合适,于是我留了段简单说明情况的留言,然",
