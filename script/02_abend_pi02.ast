        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001008_n", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我现在正好出来采购。你运气不错呢。不然的话,手机在打工结束",
