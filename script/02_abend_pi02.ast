        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你既然在外面,那求你办事也方便。就像刚才留言里说的,本人现",
                    {"rt2"},
                    "在正迷路迷得轰轰烈烈。救救我」"
