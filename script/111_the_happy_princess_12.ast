        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            ja = {
                {"当广播里报出Starmine的名字,无数烟花便接连不断地染亮天空。"}
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"bg", file = "ev_unq_c06_03", sync = 0, face = 1, time = 1000, path = ":ev/ev_unq_c06/", set = "ev_unq_c06", zoom = 100},
        {"se", stop = 1, id = 2},
        {"se", file = "se9097", id = 5},
        {"text"},
        text = {
            ja = {
                {
                    "小时候我一直以为Starmine是烟花厂商的名字,昨晚用手机一查才知",
                    {"rt2"},
                    "道,那是速射连发的燃放技法的名称。"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            ja = {
                {"在这雏弓海岸的花火大会上,它是压轴的节目。"}
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            ja = {
                {"小小的花火大会上,四处响起欢呼声。"}
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            ja = {
                {"果然,距离近就是有魄力。"}
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            ja = {
                {"至于它到底小不小,说实话已经分不清了。"}
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            ja = {
                {"声音很近,烟花很大。"}
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"bg", file = "ev_unq_c06_01", sync = 0, face = 1, time = 3000, path = ":ev/ev_unq_c06/", set = "ev_unq_c06", zoom = 100},
        {"se", stop = 1, id = 5, time = 3000},
        {"bgm", stop = 1, time = 1000},
        {"text"},
        text = {
            ja = {
                {"Starmine结束后,广播宣告接下来将燃放尺玉。"}
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            ja = {
                {"得知尺玉即将升空的直君,比我想象的还要兴奋。"}
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"bg", file = "black", path = ":bg/"},
        {"se", stop = 1, id = 4, time = 3000},
        {"text"},
        text = {
            ja = {
                {"可我,却想起了一个毫不相干的,这样的故事。"}
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            ja = {
                {"『了不起的烟花』"}
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            ja = {
                {"她,作为一枚无比气派的烟花降生。"}
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            ja = {
                {"她血统高贵,家世显赫。"}
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            ja = {
                {
                    "母亲是当时最负盛名的回旋烟花,直径足有三英尺五英寸,曾一面挥",
                    {"rt2"},
                    "洒七颗星,一面在长空中回旋十九周,令众人惊叹。"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"bgm", file = "bgm105", time = 3000},
        {"text"},
        text = {
            ja = {
                {
                    "父亲,是和她同样的烟花。有着法兰西的血统,他飞得极高,高到观众",
                    {"rt2"},
                    "都焦急地以为他再也不会落下来,而后,洒下了一场美丽的黄金之雨。"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            ja = {
                {
                    "这样的她,将在王家的婚礼上被燃放。傲慢的她说,是王家的婚礼恰",
                    {"rt2"},
                    "好赶上了自己升空的日子,王家真是幸福,让周围的烟花们瞠目结舌。"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            ja = {
                {"这样的她,想象着自己升空的那一刻。"}
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            ja = {
                {"比任何人都,更了不起、更美丽地绽放光芒的,自己的身影。"}
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            ja = {
                {"全世界的人们都将惊叹,继而感动。"}
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            ja = {
                {
                    "想象着自己的身影将永远铭刻在众人的记忆里,烟花陶醉其中,流下",
                    {"rt2"},
                    "了眼泪。"
                }
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            ja = {
                {"泪水浸湿了她的火药。"}
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            ja = {
                {"受了潮的烟花,升不上天。"}
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            ja = {
                {"无数同伴飞向天空,化作火花消散,唯有她,被留在了地上。"}
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"msgoff"},
        {"bg", file = "ev_unq_c06_bg", zoom = 115, speed = 1700, id = 8, lv = 8, path = ":cg/", z2 = 70, x2 = -50, y2 = -200, x = -50, y = 702, ax = 1920, ay = 1080, bx = -960, by = -540, sync = 0},
        {"bg", file = "ev_unq_c06_track", zoom = 70, speed = 1700, rele = "216r", id = 9, lv = 9, path = ":cg/", z2 = 200, x2 = 35, y2 = 1040, x = 53, y = 200, ax = 1920, ay = 1080, bx = -960, by = -540, sync = 0},
        {"extrans", time = 500},
        {"bgm", file = "bgm105"},
