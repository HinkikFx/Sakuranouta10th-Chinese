    block_00172 = {
        {"text"},
        text = {
            ja = {
                {"这在雏弓海岸花火大会是压轴节目。"}
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            ja = {
                {"小型花火大会的各处响起欢呼声。"}
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            ja = {
                {"果然，距离近的话就很有魄力。"}
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            ja = {
                {"小不小的，老实说根本分不出来。"}
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            ja = {
                {"声音很近，花火很大。"}
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"bg", file = "ev_unq_c06_01", sync = 0, face = 1, time = 3000, path = ":ev/ev_unq_c06/", set = "ev_unq_c06", zoom = 100},
        {"se", stop = 1, id = 5, time = 3000},
        {"bgm", stop = 1, time = 1000},
        {"text"},
        text = {
            ja = {
                {"Star Mine结束后，广播宣布接下来将放尺玉。"}
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            ja = {
                {"得知要放尺玉的直哉，比想象中要兴奋。"}
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"bg", file = "black", path = ":bg/"},
        {"se", stop = 1, id = 4, time = 3000},
        {"text"},
        text = {
            ja = {
                {"可是，我却想起了一个完全无关的故事。"}
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            ja = {
                {"《了不起的烟花》"}
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            ja = {
                {"她，作为一枚极为出色的冲天烟花诞生了。"}
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            ja = {
                {"其血统高贵正统。"}
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            ja = {
                {
                    "母亲是当时最著名的旋转烟花，直径三英尺五英寸，抛洒着七颗星",
                    {"rt2"},
                    "辰在高空旋转了十九圈，令众人惊叹。"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"bgm", file = "bgm105", time = 3000},
        {"text"},
        text = {
            ja = {
                {
                    "父亲和她一样是冲天烟花，拥有法国血统。飞得太高太久，令观者",
                    {"rt2"},
                    "担心他不会再降下来了，最后降下了一场美丽的黄金雨。"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            ja = {
                {
                    "就是这样的她，将在王室婚礼上被点燃升空。傲慢的她声称自己升",
                    {"rt2"},
                    "空的日子恰好赶上婚礼，王室因此而幸运，把周围的烟花们都惊呆",
                    {"rt2"},
                    "了。"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            ja = {
                {"她想象着自己被点燃升空的那一刻。"}
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            ja = {
                {"比任何人都出色、都美丽地绽放的自己。"}
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            ja = {
                {"全世界的人们都将惊叹、感动。"}
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            ja = {
                {"想象着自己永远铭刻在所有人记忆中的身影，她陶醉得流下了眼泪。"}
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            ja = {
                {"那泪水让她的火药受了潮。"}
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            ja = {
                {"受潮的烟花升不了空。"}
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            ja = {
                {"许多同伴化作火花奔向天际、消逝而去，唯独她被留在了地面上。"}
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"msgoff"},
        {"bg", file = "ev_unq_c06_bg", zoom = 115, speed = 1700, id = 8, lv = 8, path = ":cg/", z2 = 70, x2 = -50, y2 = -200, x = -50, y = 702, ax = 1920, ay = 1080, bx = -960, by = -540, sync = 0},
        {"bg", file = "ev_unq_c06_track", zoom = 70, speed = 1700, rele = "216r", id = 9, lv = 9, path = ":cg/", z2 = 200, x2 = 35, y2 = 1040, x = 53, y = 200, ax = 1920, ay = 1080, bx = -960, by = -540, sync = 0},
        {"extrans", time = 500},
        {"bgm", file = "bgm105"},
        {"ex", time = 500, func = "wait"},
        {"cgdel", id = -1},
        {"se", file = "se9093", id = 1},
        {"bg", file = "ev_unq_c06_04", zoom = 100, time = 500, z2 = 110, path = ":ev/ev_unq_c06/", set = "ev_unq_c06"},
        {"text"},
        text = {
            ja = {
                {"一道前所未有的、格外耀眼的光柱升上了天空。"}
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            ja = {
                {"光和声之间有着很大的差距。"}
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            ja = {
                {"光和声有差距意味着距离很远。"}
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            ja = {
                {"大概是从和之前花火不同的地方发射的吧。"}
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            ja = {
                {"人们对着那一道升空的光芒发出由衷的赞叹。"}
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            ja = {
                {"直哉也兴奋地喊着什么。"}
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"bg", file = "ev_unq_c06_01", sync = 0, face = 1, time = 400, path = ":ev/ev_unq_c06/", set = "ev_unq_c06", zoom = 100},
        {"text"},
        text = {
            ja = {
                {"然而，尺玉的光芒消失了。只有声音——在回响。"}
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            ja = {
                {
                    "感觉像是过了非常漫长的时间。所有人都注视着那片只有黑暗的天",
                    {"rt2"},
                    "空。"
                }
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            ja = {
                {"因为花火迟迟没有绽开，直哉小声说了句\"黑玉？\"。"}
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            ja = {
                {"黑玉指的是哑弹。"}
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            ja = {
                {
                    "是的，就像那个故事里了不起的烟花一样，眼前的花火也许也无法",
                    {"rt2"},
                    "在夜空中绽放光芒。"
                }
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            ja = {
                {"就像那个故事一样，受了潮的烟花被丢进了泥水里。"}
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            ja = {
                {"被丢进泥水的了不起的烟花——"}
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"msgoff"},
        {"bg", file = "zev_unq_c06_05", id = 2, lv = 2, zoom = 51, alpha = 255, speed = 1000, path = ":ev/ev_unq_c06/", z2 = 50, set = "ev_unq_c06", ax = 1920, ay = 1080, bx = -960, by = -540, sync = 0},
        {"bg", file = "zev_unq_c06_05", id = 3, lv = 3, zoom = 53, alpha = 128, speed = 1000, path = ":ev/ev_unq_c06/", z2 = 50, set = "ev_unq_c06", ax = 1920, ay = 1080, bx = -960, by = -540, sync = 0},
        {"bg", file = "zev_unq_c06_05", id = 4, lv = 4, zoom = 55, alpha = 128, speed = 1000, path = ":ev/ev_unq_c06/", z2 = 50, set = "ev_unq_c06", ax = 1920, ay = 1080, bx = -960, by = -540, sync = 0},
        {"bg", file = "zev_unq_c06_05", id = 5, lv = 5, zoom = 60, alpha = 128, speed = 1500, path = ":ev/ev_unq_c06/", z2 = 50, set = "ev_unq_c06", ax = 1920, ay = 1080, bx = -960, by = -540, sync = 0},
        {"extrans", time = 500},
