        {"cgdel", id = -1},
        {"se", file = "se9093", id = 1},
        {"bg", file = "ev_unq_c06_04", zoom = 100, time = 500, z2 = 110, path = ":ev/ev_unq_c06/", set = "ev_unq_c06"},
        {"text"},
        text = {
            ja = {
                {"一道前所未有的、格外明亮的光柱升上天空。"}
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            ja = {
                {"光与声之间,有很大的时差。"}
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            ja = {
                {"光与声有时差,意味着距离很远。"}
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            ja = {
                {"大概,是从与之前不同的地方燃放的吧。"}
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            ja = {
                {"人们对着那道攀升的光发出感叹。"}
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            ja = {
                {"直君也兴奋地喊着什么。"}
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"bg", file = "ev_unq_c06_01", sync = 0, face = 1, time = 400, path = ":ev/ev_unq_c06/", set = "ev_unq_c06", zoom = 100},
        {"text"},
        text = {
            ja = {
                {"然而,尺玉的光的轨迹却消失了。只有声音――兀自回响。"}
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            ja = {
                {"感觉过了非常漫长的时间。所有人都凝视着,那片只余黑暗的天空。"}
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            ja = {
                {"烟花迟迟不开,直君低声嘟哝了一句「黑玉？」。"}
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            ja = {
                {"黑玉,指的是没能炸开的哑弹。"}
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            ja = {
                {
                    "是啊,或许就像那个故事里了不起的烟花一样,眼前的烟花,也无法在",
                    {"rt2"},
                    "夜空中绽放光芒。"
                }
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            ja = {
                {"就像那个故事里一样,受潮的烟花被丢进泥水。"}
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            ja = {
                {"被丢进泥水的、了不起的烟花――。"}
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"msgoff"},
        {"bg", file = "zev_unq_c06_05", id = 2, lv = 2, zoom = 51, alpha = 255, speed = 1000, path = ":ev/ev_unq_c06/", z2 = 50, set = "ev_unq_c06", ax = 1920, ay = 1080, bx = -960, by = -540, sync = 0},
        {"bg", file = "zev_unq_c06_05", id = 3, lv = 3, zoom = 53, alpha = 128, speed = 1000, path = ":ev/ev_unq_c06/", z2 = 50, set = "ev_unq_c06", ax = 1920, ay = 1080, bx = -960, by = -540, sync = 0},
        {"bg", file = "zev_unq_c06_05", id = 4, lv = 4, zoom = 55, alpha = 128, speed = 1000, path = ":ev/ev_unq_c06/", z2 = 50, set = "ev_unq_c06", ax = 1920, ay = 1080, bx = -960, by = -540, sync = 0},
        {"bg", file = "zev_unq_c06_05", id = 5, lv = 5, zoom = 60, alpha = 128, speed = 1500, path = ":ev/ev_unq_c06/", z2 = 50, set = "ev_unq_c06", ax = 1920, ay = 1080, bx = -960, by = -540, sync = 0},
        {"extrans", time = 500},
