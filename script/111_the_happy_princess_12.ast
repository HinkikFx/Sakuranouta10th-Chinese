        {"bg", time = 0, sync = 0, file = "ev_unq_c06_05", path = ":ev/ev_unq_c06/", set = "ev_unq_c06"},
        {"cgdel", id = -1},
        {"text"},
        text = {
            ja = {
                {"尺玉将黑暗染成金色。"}
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            ja = {
                {"整片夜空,被闪闪发亮的东西包裹。"}
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            ja = {
                {"尺玉的魄力,果然不同凡响。"}
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            ja = {
                {"与其他烟花的存在感,判然有别。"}
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"text"},
        text = {
            ja = {
                {"沙滩被前所未有的欢呼声包围。"}
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"text"},
        text = {
            ja = {
                {"直君也发出了感叹。"}
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            ja = {
                {"我用微小的声音――。"}
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"bg", file = "black", path = ":bg/"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100714", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「太好了呢……尺玉小姐。没有绽放在,无人观看的,白昼的天空里…",
                    {"rt2"},
                    "…」"
                }
            }
        },
        linkback = "block_00212",
        linknext = "block_00214"
    },
    block_00214 = {
        {"text"},
        text = {
            ja = {
                {
                    "我的话语,被众多欢呼声抹去……没有传进任何人耳中。不,也决不能",
                    {"rt2"},
                    "让人听见。"
                }
            }
        },
        linkback = "block_00213",
        linknext = "block_00215"
    },
    block_00215 = {
        {"se", file = "se9103", time = 3000, loop = 1, id = 1},
        {"bg", file = "zev_unq_c06_01", speed = 60000, zoom = 80, time = 1000, path = ":ev/ev_unq_c06/", set = "ev_unq_c06", x2 = 290, y2 = 120, x = 170, y = 210, ax = 1920, ay = 1080, bx = -960, by = -540},
        {"text"},
        text = {
            ja = {
                {"直君兴奋地对我说「太震撼了」。"}
            }
        },
        linkback = "block_00214",
        linknext = "block_00216"
    },
    block_00216 = {
        {"text"},
        text = {
            ja = {
                {"我稍稍挤出一点笑容――,"}
            }
        },
        linkback = "block_00215",
        linknext = "block_00217"
    },
    block_00217 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100715", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「嗯,太震撼了」如此答道。"
                }
            }
        },
        linkback = "block_00216",
        linknext = "block_00218"
    },
    block_00218 = {
        {"text"},
        text = {
            ja = {
                {"如此快乐的时光。如此美好的时光。"}
            }
        },
        linkback = "block_00217",
        linknext = "block_00219"
    },
    block_00219 = {
        {"text"},
        text = {
            ja = {
                {"为什么,我会做出烟花升不上天这种,无聊的妄想呢？"}
            }
        },
        linkback = "block_00218",
        linknext = "block_00220"
    },
    block_00220 = {
        {"text"},
        text = {
            ja = {
                {"大概,那是――,因为在夜里听见了鸟鸣吧。"}
            }
        },
        linkback = "block_00219",
        linknext = "block_00221"
    },
    block_00221 = {
        {"text"},
        text = {
            ja = {
                {"不知为何,和他在一起时,我总会想起某位作家的,某本作品集。"}
            }
        },
        linkback = "block_00220",
        linknext = "block_00222"
    },
    block_00222 = {
        {"text"},
        text = {
            ja = {
                {"从那一天,在这弓张学园重逢的黄昏起――一直如此。"}
            }
        },
        linkback = "block_00221",
        linknext = "block_00223"
    },
    block_00223 = {
        {"bg", file = "ev_com_a19_04", id = 8, lv = 5, path = ":ev/ev_com_a19/", set = "ev_com_a19", sync = 0},
        {"bg", file = "reco", id = 10, lv = 10, path = ":sys/", sync = 0},
        {"extrans", rule = 087, time = 500},
        {"text"},
        text = {
            ja = {
                {"奥斯卡·王尔德的作品集『幸福王子及其他童话』――。"}
            }
        },
        linkback = "block_00222",
        linknext = "block_00224"
    },
    block_00224 = {
        {"text"},
        text = {
            ja = {
                {"『幸福王子』"}
            }
        },
        linkback = "block_00223",
        linknext = "block_00225"
    },
    block_00225 = {
        {"text"},
        text = {
            ja = {
                {"『夜莺与蔷薇』"}
            }
        },
        linkback = "block_00224",
        linknext = "block_00226"
    },
    block_00226 = {
        {"text"},
        text = {
            ja = {
                {"『自私的巨人』"}
            }
        },
        linkback = "block_00225",
        linknext = "block_00227"
    },
    block_00227 = {
        {"text"},
        text = {
            ja = {
                {"『忠实的朋友』"}
            }
        },
        linkback = "block_00226",
        linknext = "block_00228"
    },
    block_00228 = {
        {"cgdel", id = -1, rule = 087, time = 500},
        {"text"},
        text = {
            ja = {
                {"而最后,以『了不起的烟花』作结。"}
            }
        },
        linkback = "block_00227",
        linknext = "block_00229"
    },
    block_00229 = {
        {"text"},
        text = {
            ja = {
                {
                    "这些被危险的献身灼烧己身的故事,不知为何,最后却以傲慢烟花的",
                    {"rt2"},
                    "故事落幕。"
                }
            }
        },
        linkback = "block_00228",
        linknext = "block_00230"
    },
    block_00230 = {
        {"text"},
        text = {
            ja = {
                {"可是――。"}
            }
        },
        linkback = "block_00229",
        linknext = "block_00231"
    },
    block_00231 = {
        {"text"},
        text = {
            ja = {
                {
                    "就算像了不起的烟花那样,在无人观看、无人知晓的地方,如蓝色的",
                    {"rt2"},
                    "星辰般闪耀,我想,那也自有那样的幸福――。"
                }
            }
        },
        linkback = "block_00230",
        linknext = "block_00232"
    },
    block_00232 = {
        {"text"},
        text = {
            ja = {
                {"我如此想着。"}
            }
        },
        linkback = "block_00231",
        linknext = "block_00233"
    },
    block_00233 = {
        {"text"},
        text = {
            ja = {
                {
                    "在奥斯卡·王尔德笔下的故事里,受潮的烟花泡在泥水中,被拾到它的",
                    {"rt2"},
                    "孩子们扔进了篝火。"
                }
            }
        },
        linkback = "block_00232",
        linknext = "block_00234"
    },
    block_00234 = {
        {"text"},
        text = {
            ja = {
                {"然而受潮太重的烟花迟迟没有燃起,孩子们也睡着了。"}
            }
        },
        linkback = "block_00233",
        linknext = "block_00235"
    },
    block_00235 = {
        {"text"},
        text = {
            ja = {
                {"被篝火渐渐烘热的烟花,终于让自己化作了一道光柱。"}
            }
        },
        linkback = "block_00234",
        linknext = "block_00236"
    },
    block_00236 = {
        {"text"},
        text = {
            ja = {
                {"无人观看的,白昼的天空。那是太阳统治的世界。"}
            }
        },
        linkback = "block_00235",
        linknext = "block_00237"
    },
    block_00237 = {
        {"text"},
        text = {
            ja = {
                {"烟花闪耀着夺目的光,攀上青空。"}
            }
        },
        linkback = "block_00236",
        linknext = "block_00238"
    },
    block_00238 = {
        {"text"},
        text = {
            ja = {
                {"了不起的烟花夸口说,就连那太阳自己也不会输,在青空中绽放光芒。"}
            }
        },
        linkback = "block_00237",
        linknext = "block_00239"
    },
    block_00239 = {
        {"text"},
        text = {
            ja = {
                {
                    "然而,太阳的光辉过于浩大,在它面前,没有任何人,愿意看那傲慢的烟",
                    {"rt2"},
                    "花一眼。"
                }
            }
        },
        linkback = "block_00238",
        linknext = "block_00240"
    },
    block_00240 = {
        {"text"},
        text = {
            ja = {
                {"即便如此,她仍坚信自己完成了一件了不起的工作,就此消逝。"}
            }
        },
        linkback = "block_00239",
        linknext = "block_00241"
    },
    block_00241 = {
        {"text"},
        text = {
            ja = {
                {
                    "镇座于天空的、名为太阳的向日葵,自始至终纹丝未动,但了不起的",
                    {"rt2"},
                    "烟花依然认为,自己完成了自己的工作。"
                }
            }
        },
        linkback = "block_00240",
        linknext = "block_00242"
    },
    block_00242 = {
        {"bg", file = "ev_unq_c06_06", path = ":ev/ev_unq_c06/", set = "ev_unq_c06"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「太震撼了啊。禀」"
                }
            }
        },
        linkback = "block_00241",
        linknext = "block_00243"
    },
    block_00243 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100716", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「啊,嗯……」"
                }
            }
        },
        linkback = "block_00242",
        linknext = "block_00244"
    },
    block_00244 = {
        {"text"},
        text = {
            ja = {
                {"直君的表情蒙上一层阴翳。"}
            }
        },
        linkback = "block_00243",
        linknext = "block_00245"
    },
    block_00245 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「怎么了？　从中途开始你就有点心不在焉……」"
                }
            }
        },
        linkback = "block_00244",
        linknext = "block_00246"
    },
    block_00246 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100717", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「啊,不,没什么哦」"
                }
            }
        },
        linkback = "block_00245",
        linknext = "block_00247"
    },
    block_00247 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100718", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「只是――」"
                }
            }
        },
        linkback = "block_00246",
        linknext = "block_00248"
    },
    block_00248 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「只是？」"
                }
            }
        },
        linkback = "block_00247",
        linknext = "block_00249"
    },
    block_00249 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100719", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「刚才,看着我们的那只鸟,果然不是知更鸟,而是夜莺吧――我在想这",
                    {"rt2"},
                    "个」"
                }
            }
        },
        linkback = "block_00248",
        linknext = "block_00250"
    },
    block_00250 = {
        {"text"},
        text = {
            ja = {
                {
                    "奥斯卡·王尔德的『夜莺与蔷薇』,是为了所爱之人,以自身之血,将白",
                    {"rt2"},
                    "蔷薇染成红蔷薇的故事。"
                }
            }
        },
        linkback = "block_00249",
        linknext = "block_00251"
    },
    block_00251 = {
        {"text"},
        text = {
            ja = {
                {
                    "凭借夜莺的献身,白蔷薇染上了爱人所期望的红色――,却是个什么也",
                    {"rt2"},
                    "没有、谁也没有因此得救的故事。"
                }
            }
        },
        linkback = "block_00250",
        linknext = "block_00252"
    },
    block_00252 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「诶？　放烟花的时候你都在想这些？」"
                }
            }
        },
        linkback = "block_00251",
        linknext = "block_00253"
    },
    block_00253 = {
        {"text"},
        text = {
            ja = {
                {"直君一脸无语地看着我。那是当然的。"}
            }
        },
        linkback = "block_00252",
        linknext = "block_00254"
    },
    block_00254 = {
        {"text"},
        text = {
            ja = {
                {"在这种时候,这想象也未免太不合时宜。"}
            }
        },
        linkback = "block_00253",
        linknext = "block_00255"
    },
    block_00255 = {
        {"text"},
        text = {
            ja = {
                {"所以――。"}
            }
        },
        linkback = "block_00254",
        linknext = "block_00256"
    },
    block_00256 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100720", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「啊哈哈哈,是呢。总觉得有点在意……」"
                }
            }
        },
        linkback = "block_00255",
        linknext = "block_00257"
    },
    block_00257 = {
        {"text"},
        text = {
            ja = {
                {"我装作若无其事地,笑了。"}
            }
        },
        linkback = "block_00256",
        linknext = "block_00258"
    },
    block_00258 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100721", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「我也好好地,享受了哦。这场花火大会」"
                }
            }
        },
        linkback = "block_00257",
        linknext = "block_00259"
    },
    block_00259 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯,我也比想象中尽兴。没想到在近处看尺玉,会觉得烟花绽放前",
                    {"rt2"},
                    "的时间那么漫长,再加上这份落差,看起来竟然大得离谱」"
                }
            }
        },
        linkback = "block_00258",
        linknext = "block_00260"
    },
    block_00260 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100722", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「是呢」"
                }
            }
        },
        linkback = "block_00259",
        linknext = "block_00261"
    },
    block_00261 = {
        {"bg", file = "ev_unq_c06_07", time = 1000, path = ":ev/ev_unq_c06/", set = "ev_unq_c06"},
        {"text"},
        text = {
            ja = {
                {"我握住他的手。"}
            }
        },
        linkback = "block_00260",
        linknext = "block_00262"
    },
    block_00262 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「禀？」"
                }
            }
        },
        linkback = "block_00261",
        linknext = "block_00263"
    },
    block_00263 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100723", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「嗯。对不起……」"
                }
            }
        },
        linkback = "block_00262",
        linknext = "block_00264"
    },
    block_00264 = {
        {"text"},
        text = {
            ja = {
                {"我什么也不解释,只是用力握紧他的手。"}
            }
        },
        linkback = "block_00263",
        linknext = "block_00265"
    },
    block_00265 = {
        {"text"},
        text = {
            ja = {
                {"于是,他用更大的力气,回握住我的手。"}
            }
        },
        linkback = "block_00264",
        linknext = "block_00266"
    },
    block_00266 = {
        {"text"},
        text = {
            ja = {
                {"手上感到温暖,和些许疼痛。"}
            }
        },
        linkback = "block_00265",
        linknext = "block_00267"
    },
    block_00267 = {
        {"text"},
        text = {
            ja = {
                {"他有力的紧握带来的手的疼痛,令人心安。"}
            }
        },
        linkback = "block_00266",
        linknext = "block_00268"
    },
    block_00268 = {
        {"text"},
        text = {
            ja = {
                {"是的,这,就是现实。"}
            }
        },
        linkback = "block_00267",
        linknext = "block_00269"
    },
    block_00269 = {
        {"text"},
        text = {
            ja = {
                {"这疼痛,让我真切地感受到这一点。"}
            }
        },
        linkback = "block_00268",
        linknext = "block_00270"
    },
    block_00270 = {
        {"text"},
        text = {
            ja = {
                {"此刻,我,与他同在。"}
            }
        },
        linkback = "block_00269",
        linknext = "block_00271"
    },
    block_00271 = {
        {"text"},
        text = {
            ja = {
                {"然后,待到归国之日,我就和他结婚。"}
            }
        },
        linkback = "block_00270",
        linknext = "block_00272"
    },
    block_00272 = {
        {"text"},
        text = {
            ja = {
                {"我,绝对,会这么做。"}
            }
        },
        linkback = "block_00271",
        linknext = "block_00273"
    },
    block_00273 = {
        {"bg", file = "ev_unq_c06_07", sync = 0, face = 1, time = 1000, path = ":ev/ev_unq_c06/", set = "ev_unq_c06"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「怎么了啊。把我的手,握得这么紧」"
                }
            }
        },
        linkback = "block_00272",
        linknext = "block_00274"
    },
    block_00274 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100724", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「直君,无论相隔多远,我们都在一起,对吧？」"
                }
            }
        },
        linkback = "block_00273",
        linknext = "block_00275"
    },
    block_00275 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「突然说什么呢,这不是理所当然的吗」"
                }
            }
        },
        linkback = "block_00274",
        linknext = "block_00276"
    },
    block_00276 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我会,一直,在禀的身边」"
                }
            }
        },
        linkback = "block_00275",
        linknext = "block_00277"
    },
    block_00277 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「直到,那最后的时刻――」"
                }
            }
        },
        linkback = "block_00276",
        linknext = "block_00278"
    },
    block_00278 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100725", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「嗯」"
                }
            }
        },
        linkback = "block_00277",
        linknext = "block_00279"
    },
    block_00279 = {
        {"bg", file = "ev_unq_c06_08", sync = 0, face = 1, time = 1000, path = ":ev/ev_unq_c06/", set = "ev_unq_c06"},
        {"text"},
        text = {
            ja = {
                {"我缓缓地抱住他。"}
            }
        },
        linkback = "block_00278",
        linknext = "block_00280"
    },
    block_00280 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「怎么了？　禀？」"
                }
            }
        },
        linkback = "block_00279",
        linknext = "block_00281"
    },
    block_00281 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100726", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「没什么。只是呢。一想到明天开始,又有好一阵子见不到直君――」"
                }
            }
        },
        linkback = "block_00280",
        linknext = "block_00282"
    },
    block_00282 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,是啊。一直都在一起,所以没有禀的生活又要来临什么的,还真",
                    {"rt2"},
                    "不太能想象」"
                }
            }
        },
        linkback = "block_00281",
        linknext = "block_00283"
    },
    block_00283 = {
        {"text"},
        text = {
            ja = {
                {"我,不在你身边的,世界。"}
            }
        },
        linkback = "block_00282",
        linknext = "block_00284"
    },
    block_00284 = {
        {"text"},
        text = {
            ja = {
                {"那种东西,我也无法想象。"}
            }
        },
        linkback = "block_00283",
        linknext = "block_00285"
    },
    block_00285 = {
        {"text"},
        text = {
            ja = {
                {"那样的世界,决不容存在。"}
            }
        },
        linkback = "block_00284",
        linknext = "block_00286"
    },
    block_00286 = {
        {"text"},
        text = {
            ja = {
                {"所以――我紧紧拥抱你。"}
            }
        },
        linkback = "block_00285",
        linknext = "block_00287"
    },
    block_00287 = {
        {"text"},
        text = {
            ja = {
                {"看完烟花归来的人们,斜眼瞟着这样的我们两人。"}
            }
        },
        linkback = "block_00286",
        linknext = "block_00288"
    },
    block_00288 = {
        {"text"},
        text = {
            ja = {
                {"其中,还传来「竟在这种地方打情骂俏」之类的话。"}
            }
        },
        linkback = "block_00287",
        linknext = "block_00289"
    },
    block_00289 = {
        {"text"},
        text = {
            ja = {
                {"这毫无梦幻可言的、日常的话语,令人心安。"}
            }
        },
        linkback = "block_00288",
        linknext = "block_00290"
    },
    block_00290 = {
        {"text"},
        text = {
            ja = {
                {"比起夜半啼鸣的美妙歌声,这样的嘈杂反而舒心得多。"}
            }
        },
        linkback = "block_00289",
        linknext = "block_00291"
    },
    block_00291 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100727", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「明天开始直君就要上班了吧」"
                }
            }
        },
        linkback = "block_00290",
        linknext = "block_00292"
    },
    block_00292 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯,不过明天我会送禀到车站的」"
                }
            }
        },
        linkback = "block_00291",
        linknext = "block_00293"
    },
    block_00293 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100728", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「嗯,谢谢……」"
                }
            }
        },
        linkback = "block_00292",
        linknext = "block_00294"
    },
    block_00294 = {
        {"text"},
        text = {
            ja = {
                {"这份理所当然,我绝对不会放手。"}
            }
        },
        linkback = "block_00293",
        linknext = "block_00295"
    },
    block_00295 = {
        {"text"},
        text = {
            ja = {
                {"这不属于其他任何人,这是我的日常。"}
            }
        },
        linkback = "block_00294",
        linknext = "block_00296"
    },
    block_00296 = {
        {"se", stop = 1, time = 3000, id = 1},
        {"text"},
        text = {
            ja = {
                {"正这么想着――,"}
            }
        },
        linkback = "block_00295",
        linknext = "block_00297"
    },
    block_00297 = {
        {"text"},
        text = {
            ja = {
                {"在远方,在非常遥远的地方――"}
            }
        },
        linkback = "block_00296",
        linknext = "block_00298"
    },
    block_00298 = {
        {"text"},
        text = {
            ja = {
                {"我仿佛看见,一颗蓝色的星辰如烟花般,散落。"}
            }
        },
        linkback = "block_00297",
        linknext = "block_00299"
    },
    block_00299 = {
        {"bg", time = 3000, file = "black", path = ":bg/"},
        {"ex", time = 1000, func = "wait"},
