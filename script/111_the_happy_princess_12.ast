        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100654", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「当然,最大的理由是可以和直君直接做啦。不过那个还能让生理期",
