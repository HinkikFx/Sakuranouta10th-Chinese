    block_00004 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100653", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「说的也是呢……一口气被内射这么多,要是没吃避孕药,果然会怀孕",
