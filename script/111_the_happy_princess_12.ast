            ja = {
                {"当我指过去的时候，那只鸟发出了非常美丽的叫声。"}
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那是知更鸟？……吧。总不会……」"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100695", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「大概是知更鸟吧……」"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，太远了也看起来像别的东西……」"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100696", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「身形几乎只看得到影子……不过那叫声总觉得不太像知更鸟……」"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「禀觉得那只鸟是什么？」"
                }
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"cgdel", id = 9, time = 1000, lv = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100697", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「我因为工作去过几次欧洲。在那里听到过相似的叫声」"
                }
            }
        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            ja = {
                {"鸟再次鸣叫。在傍晚的天空，仿佛向着夜晚歌唱一般——。"}
            }
        },
        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100698", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「直哉觉得，那只鸟如果不是知更鸟的话，会是什么呢？」"
                }
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那个可能性几乎没有……但是，那个身影和叫声……感觉像是夜莺」"
                }
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100699", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「夜莺……那是日文名呢」"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            ja = {
                {
                    "那种鸟是在欧洲和非洲之间迁徙的候鸟，在欧洲童话中常常能见到",
                    {"rt2"},
                    "它的名字。"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            ja = {
                {"然而，那种鸟在日本是看不到的。"}
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        text = {
            ja = {
                {"夜莺——Nightingale。"}
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100700", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「夜莺什么的，不可能出现在日本的」"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            ja = {
                {"夜莺的别名是Nightingale。Nightingale在古英语中意为\"在夜里歌唱\"。"}
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"text"},
        text = {
            ja = {
                {
                    "日文名\"小夜啼鸟\"的汉字写法也同样含有\"在夜里鸣叫/歌唱者\"的意",
                    {"rt2"},
                    "思。"
                }
            }
        },
        linkback = "block_00118",
        linknext = "block_00120"
    },
    block_00120 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是不是被养着的鸟逃出来了？」"
                }
            }
        },
        linkback = "block_00119",
        linknext = "block_00121"
    },
    block_00121 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100701", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「如果是的话，好可怜呢……」"
                }
            }
        },
        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「如果那真的是夜莺的话……」"
                }
            }
        },
        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"text"},
        text = {
            ja = {
                {
                    "夜莺是可以正常买卖的鸟，但即便如此，我从未听说过逃出来的夜",
                    {"rt2"},
                    "莺野生化的事例。"
                }
            }
        },
        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            ja = {
                {"从笼中逃出的夜莺，仅凭一只是无法在这片土地生存的。"}
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"text"},
        text = {
            ja = {
                {"丝柏上的夜莺仿佛一直在注视着我们——"}
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"text"},
        text = {
            ja = {
                {"只发出一声美丽的鸣叫——就那样消失在天空中了。"}
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"cgdel", id = -1},
        {"bg", file = "ev_app_h15_01", time = 1000, path = ":ev/ev_app_h15/", set = "ev_app_h15"},
        {"text"},
        text = {
