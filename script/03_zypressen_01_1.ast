    },
    block_00276 = {
        {"fg", ch = "直哉", size = "z1", mode = 3, path = ":fg/nao/z1/", file = "nao_z1a0100", face = "a0010", head = "nao_z1a", lv = 4, id = 6},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「南北朝时代，南朝梁国的画家“张僧繇”，因为一给自己画的龙点",
                    {"rt2"},
                    "上眼睛它就会飞走，所以一直不肯点睛的逸闻」"
                }
            }
