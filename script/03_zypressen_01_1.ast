        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"fg", ch = "優美", size = "z1", mode = 3, path = ":fg/yum/z1/", file = "yum_z1a0120", face = "a0001", head = "yum_z1a", lv = 4, id = 5},
