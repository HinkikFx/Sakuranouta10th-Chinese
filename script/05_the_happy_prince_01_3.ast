        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「确实，要成就荒唐的事，也许就非得变成傻瓜不可……」"
