                {
                    name = {"圭"},
                    "「不信。刚搬到这个家的时候让她做过炒饭，几乎全是焦黑的……」"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
