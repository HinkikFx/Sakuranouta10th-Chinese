        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「摩托和音乐，说白了不就是那个吗？　横滨银○蝇和暴走族那样",
                    {"rt2"},
                    "的关系。要不就是气○团和不良少年那种关系」"
                }
            }
