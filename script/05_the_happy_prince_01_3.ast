    block_00133 = {
        {"se", file = "se9010", id = 1},
        {"text"},
        text = {
            ja = {
                {"我下意识地藏起了右手。"}
            }
        },
        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「护着……为、为什么这么说」"
                }
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"bgm", file = "bgm029"},
        {"text"},
        text = {
