        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么叫对获奖没兴趣，那种东西根本不可能获奖。学生获摩尔展",
