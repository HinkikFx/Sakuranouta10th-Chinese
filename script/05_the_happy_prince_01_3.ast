    },
    block_00062 = {
        {"bg", file = "ev_com_i02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i02/", set = "ev_com_i02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_ked_001089", ch = "ked"}
            },
            ja = {
                {
                    name = {"圭"},
                    "「就是骑我那种维斯帕、兰美达之类超帅摩托的文化啦」"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是吗？　为什么摩托和音乐会扯上关系？」"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"bg", file = "ev_com_i02_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i02/", set = "ev_com_i02"},
        {"mwact", act = "うんうん"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_ked_001090", ch = "ked"}
            },
            ja = {
                {
                    name = {"圭"},
                    "「说起来可就长了……、哎呀，直哉要是那么想了解摩德文化，我",
                    {"rt2"},
                    "可就要讲了哦」"
                }
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不，不用了，没兴趣」"
