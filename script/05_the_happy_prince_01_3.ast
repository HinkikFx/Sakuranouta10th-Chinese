        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「燕子啊。燕子啊。寒冷的冬天就快要来了。所以你，必须飞往南",
