        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你知道得挺清楚啊。不,是在那个梦里见过吗……」"
                }
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「传说有好几个版本,其中最可信的一种说法是,中村家和方相氏惧",
                    {"rt2"},
                    "怕义贞与伯奇的怨念,在两人殒命之地建了这座神社」"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「和流传的版本不同,两人是在这里,在这座伯奇神社所建之地战死",
                    {"rt2"},
                    "的」"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002231", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「伯奇不是战死的……」"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"bg", file = "ev_com_d08_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d08/", set = "ev_com_d08"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002232", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「她得到了心,然后将至今吞下的心尽数吐出,死去了」"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是吗,详细的我不清楚。不过,无论哪种说法,这才是货真价实的千",
                    {"rt2"},
                    "年樱……」"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「它在这个时机开花,就是说……」"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是某个人的想念开花了吗……」"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002233", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「某个人的想念开花?」"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「千年樱,会与过去存在过的某人的思念共鸣,从而开花。渗进这株",
                    {"rt2"},
                    "樱树的过去的思念,正与某个人的思念产生着共鸣……。因为此刻在",
                    {"rt2"},
                    "场的某个人……」"
                }
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002234", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那就是说……」"
                }
            }
        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「据说人会像忆起前世的记忆一样,回想起过去。但那不过是樱花在",
                    {"rt2"},
                    "共鸣罢了」"
                }
            }
        },
        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「尤其是“被夺走的感情”,这些家伙对它反应格外强烈」"
                }
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「恋人被夺走的悲伤,失去孩子的悲伤,失去双亲的悲伤……。这株樱",
                    {"rt2"},
                    "花对这类感情反应尤为强烈」"
                }
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002235", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「这么说的话……」"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002236", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「恐怕……这是我的思念,和寄宿在这株樱花里的思念起了共鸣……」"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002237", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我做了梦。里奈也是,那大概就是草薙学长说的共鸣吧」"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是你的思念让千年樱开花了吗……」"
                }
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002238", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那里奈又是怎么回事呢……」"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002239", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我听说里奈也做了那个梦」"
                }
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002240", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那么里奈的思念,不也一样让这花开了吗?」"
                }
            }
        },
        linkback = "block_00118",
        linknext = "block_00120"
    },
    block_00120 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「也许吧,但恐怕不是」"
                }
            }
        },
        linkback = "block_00119",
        linknext = "block_00121"
    },
    block_00121 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「恐怕这家伙,是为了实现你的愿望才开的花」"
                }
            }
        },
        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002241", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「为什么这么想?」"
                }
            }
        },
        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「在你说出前世这个词的瞬间,它出现了」"
                }
            }
        },
        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「前世,那曾是自己的过去。如果你是这么想的,那一瞬间,就是与樱",
                    {"rt2"},
                    "花共鸣最强烈的时刻……」"
                }
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是你让它开花的」"
                }
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002242", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我让它开花……」"
                }
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是啊。这样的话,也许该高兴才对。这是一种奇迹。嘛,对其他人",
                    {"rt2"},
                    "来说,或许不是什么值得高兴的东西……」"
                }
            }
        },
        linkback = "block_00126",
        linknext = "block_00128"
    },
    block_00128 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002243", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「对其他人来说不是值得高兴的东西?」"
                }
            }
        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,千年樱的共鸣,正是因为过去有谁未能许愿的思念,才会发生。",
                    {"rt2"},
                    "而借着那共鸣,愿望便能实现」"
                }
            }
        },
        linkback = "block_00128",
        linknext = "block_00130"
    },
    block_00130 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002244", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「这我明白。可为什么,你能断言那对其他人来说不是值得高兴的事",
                    {"rt2"},
                    "?」"
                }
            }
        },
        linkback = "block_00129",
        linknext = "block_00131"
    },
    block_00131 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「很久以前,我见过一次千年樱开花……。结果不怎么好。以撕裂一",
                    {"rt2"},
                    "个家庭的羁绊而告终」"
                }
            }
        },
        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我深切体会到,人的愿望这东西,要是毫无来由地实现了,那可是不",
                    {"rt2"},
                    "得了的事」"
                }
            }
        },
        linkback = "block_00131",
        linknext = "block_00133"
    },
    block_00133 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「会把所有人的人生搅得一团糟……」"
                }
            }
        },
        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002245", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「奇迹会把所有人的人生搅得一团糟……」"
                }
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「话说回来,一辈子居然能见到两次奇迹……」"
                }
            }
        },
        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这世上是有道理这种东西的。把道理硬生生扭曲,靠奇迹去许愿,",
                    {"rt2"},
                    "就必然会在某处产生扭曲」"
                }
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「说得简单点,某个人的幸福,要由某个人的不幸来填补」"
                }
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「当然,实际没这么简单……嘛,但结果大抵如此」"
                }
            }
        },
        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「毕竟,奇迹般的愿望,本来就是靠扭曲道理才得以发生的……」"
                }
            }
        },
        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002246", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「原来如此……那么,借这株樱花的力量,说不定我就能和里奈在一起",
                    {"rt2"},
                    "了呢」"
                }
            }
        },
        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「虽然不知道会以什么形式,但让它成为可能的正是奇迹,是千年樱",
                    {"rt2"},
                    "的力量」"
                }
            }
        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002247", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「比如说,我变成男子人?」"
                }
            }
