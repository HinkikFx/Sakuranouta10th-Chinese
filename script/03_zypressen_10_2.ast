        linkback = "block_00212",
        linknext = "block_00214"
    },
    block_00214 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「用“奇迹”去善后“奇迹”,算不上什么高明的做法」"
