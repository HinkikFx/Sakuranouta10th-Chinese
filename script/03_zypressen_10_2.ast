        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「母亲临终时说，正是因为有了专一的爱，自己的人生才如此美好」"
                }
