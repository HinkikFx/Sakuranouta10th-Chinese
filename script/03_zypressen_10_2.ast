        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这一点是毫无疑问的……」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002264", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我们应该算是情敌吧……」"
