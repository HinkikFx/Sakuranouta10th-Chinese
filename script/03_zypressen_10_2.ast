        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「奇迹般的愿望嘛，本就是扭曲常理才得以实现的……」"
