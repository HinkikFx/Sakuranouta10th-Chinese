        linknext = "block_00119"
    },
    block_00119 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002240", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那里奈的心愿不也让这棵花绽放了吗？」"
                }
