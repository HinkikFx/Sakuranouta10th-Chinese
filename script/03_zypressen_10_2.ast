        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「前世——如果你认为那就是自己的过去，那一刻便是与樱花共鸣最",
                    {"rt2"},
                    "强烈的瞬间……」"
                }
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是你让它开花的」"
                }
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002242", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我让它开花了……」"
                }
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「没错。那也许该高兴才对。这是一种奇迹。嗯，虽然对其他人来",
                    {"rt2"},
                    "说可能不是什么值得高兴的事……」"
                }
            }
        },
        linkback = "block_00126",
        linknext = "block_00128"
    },
    block_00128 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002243", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「对其他人来说不值得高兴？」"
                }
            }
        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是的，千年樱的共鸣，需要过去有人未能许下的心愿才会发生。",
                    {"rt2"},
                    "通过共鸣，愿望就能实现」"
                }
            }
        },
        linkback = "block_00128",
        linknext = "block_00130"
    },
    block_00130 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002244", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我明白。但你为什么断言对其他人来说不是好事」"
                }
            }
        },
        linkback = "block_00129",
        linknext = "block_00131"
    },
    block_00131 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我以前曾见过千年樱开花……结果并不好。最终撕裂了一个家庭",
                    {"rt2"},
                    "的纽带」"
                }
            }
        },
        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「深刻体会到了。人的愿望如果毫无理由地实现了，那可是天大的",
                    {"rt2"},
                    "事」"
                }
            }
        },
        linkback = "block_00131",
        linknext = "block_00133"
    },
    block_00133 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「会把所有人的人生搅得天翻地覆……」"
                }
            }
