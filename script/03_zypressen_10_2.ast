    },
    block_00182 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002259", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「深藏的爱不过是没有勇气罢了」"
                }
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我明白你想说什么。但是啊，爱这个东西，很难的」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「想要据为己有的强烈渴望，和希望对方幸福的心情」"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「如果这两者能够一致的话，该有多幸福啊……但世上哪有那么顺",
                    {"rt2"},
                    "遂的事」"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「爱总是变得自私」"
                }
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「自以为是地认为自己的爱对对方有益」"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但其实不是这样的」"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不能理所当然地那样想」"
                }
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002260", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「为什么？」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为啊，因为——爱是两个人共同培育的东西吧？」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那么，光是自己一个人想是不行的」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"bg", file = "ev_com_d08_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d08/", set = "ev_com_d08"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002261", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「里奈是爱着草薙先生的」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002262", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「这一点，一直陪在她身边的我最清楚」"
                }
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，也许确实如此……」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但是，冰川大概也同样爱着你啊」"
                }
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            vo = {
