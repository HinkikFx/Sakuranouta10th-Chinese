        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不是别的什么时候。现在，我意识到自己喜欢里奈了。所以就告",
