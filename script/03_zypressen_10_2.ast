        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我甚至想说，你好歹也分一点爱给儿子啊。那家伙就是那样深爱",
