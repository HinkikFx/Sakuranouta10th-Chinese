        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「说到底，能阻止这个奇迹的，大概只有创造了千年樱这个诅咒的",
