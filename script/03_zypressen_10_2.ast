        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002245", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「奇迹会把所有人的人生搅得天翻地覆……」"
