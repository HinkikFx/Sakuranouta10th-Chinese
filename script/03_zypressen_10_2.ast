        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002256", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「为什么你会如此执着于只爱一个人？」"
