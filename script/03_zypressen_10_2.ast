        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「简单来说，某人的幸福，是由某人的不幸来填补的」"
                }
            }
