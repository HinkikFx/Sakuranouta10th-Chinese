        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「世上存在着道理这种东西。扭曲道理所实现的愿望，必然会在某",
                    {"rt2"},
                    "处产生扭曲」"
                }
