        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我很爱母亲……虽然只是简短的一句话，却深深烙在了我的心上」"
                }
