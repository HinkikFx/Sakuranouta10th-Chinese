        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「草薙健一郎这个人虽然做过各种各样的事，但他只爱母亲一个人，",
                    {"rt2"},
                    "这大概是事实」"
