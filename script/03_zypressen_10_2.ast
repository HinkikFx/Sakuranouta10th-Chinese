        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是啊，如果你真的这样许愿，要杀掉我也是做得到的。值得一试。",
                    {"rt2"},
                    "不用承担杀人罪就能消灭讨厌的人——这可是相当了不起的事」"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002269", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「你怎么能说得像是在说别人的事……」"
                }
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我知道这不是与己无关的事……不过算了，这种事我也很清楚它",
                    {"rt2"},
                    "无可奈何」"
                }
