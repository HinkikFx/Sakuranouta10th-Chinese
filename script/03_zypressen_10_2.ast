        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「有道理。不过,那与其说是奇迹……总觉得像变性手术一样,太生猛",
                    {"rt2"},
                    "了……」"
                }
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002248", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「或者里奈突然对百合开窍!」"
                }
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嘛,那倒也不是没可能……」"
                }
            }
        },
        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「对百合开窍的冰川爱上你,也完全可以想象」"
                }
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"bg", file = "ev_com_d08_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d08/", set = "ev_com_d08"},
