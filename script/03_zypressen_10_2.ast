    },
    block_00098 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002230", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「义贞和伯奇走到最后的那棵老樱树……」"
                }
            }
        },
        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你倒是很了解。不，是在那个梦里看到的吧……」"
                }
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「传说有好几个版本，其中最可信的一个是——义贞和伯奇殒命之地，",
                    {"rt2"},
                    "中村家和方相氏出于对怨念的恐惧，在此修建了神社」"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「与传说不同的是，两人就是在这里——在伯奇神社所在的地方战死",
                    {"rt2"},
                    "的」"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002231", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「伯奇不是战死的……」"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"bg", file = "ev_com_d08_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d08/", set = "ev_com_d08"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002232", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「她是获得了心灵之后，将过去吞下的所有心灵全部吐出——然后死",
                    {"rt2"},
                    "去的」"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是吗，详细情况我不清楚。但不管怎样，这才是如假包换的千年",
                    {"rt2"},
                    "樱……」"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「在这个时机它开花了，意味着……」"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「有某个人的心愿绽放了吗……」"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002233", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「某个人的心愿绽放？」"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「千年樱通过与过去某个人未能实现的心愿产生共鸣来开花。浸染",
                    {"rt2"},
                    "在这棵樱花中的过去的心愿，正和在场某个人的心愿产生共鸣……」"
                }
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002234", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那就是说……」"
                }
            }
        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「仿佛前世的记忆一般回想起过去。但那不过是樱花在产生共鸣而",
                    {"rt2"},
                    "已」"
                }
            }
        },
        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「特别是——'被夺走的感情'，这些家伙反应最为强烈」"
                }
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「失去恋人的悲伤、失去孩子的悲伤、失去父母的悲伤……这棵樱",
                    {"rt2"},
                    "花对这类感情反应尤为强烈」"
                }
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002235", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「如果是这样的话……」"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002236", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「大概……这是我的心愿和这棵樱花中蕴含的心愿产生共鸣了吧……」"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002237", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
