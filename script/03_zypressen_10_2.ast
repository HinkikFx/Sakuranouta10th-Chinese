        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,只要这么祈愿,连杀人都办得到哦。有一试的价值。不用背上",
                    {"rt2"},
                    "杀人罪就能抹掉讨厌的家伙,这可是相当了不得的事」"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002269", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「你怎么,说得跟别人的事一样……」"
                }
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我知道这不是别人的事……。嘛,但我也很清楚,唯独这件事无可奈",
                    {"rt2"},
                    "何」"
                }
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这株樱花开放之时,能阻止那奇迹的,不是人类」"
                }
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「说白了,能阻止那奇迹的,大概只有创造出千年樱这个诅咒的伯奇",
                    {"rt2"},
                    "了」"
                }
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「可就算那样,也只是在奇迹之上再覆盖一层奇迹……。势必会产生",
                    {"rt2"},
                    "更严重的扭曲……」"
                }
            }
