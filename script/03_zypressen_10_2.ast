        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002252", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「是这样吗?」"
                }
            }
