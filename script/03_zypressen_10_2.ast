        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊」"
                }
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"bg", file = "ev_com_d08_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d08/", set = "ev_com_d08"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002253", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「学长为什么要告白?」"
                }
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为我喜欢冰川啊」"
                }
            }
        },
        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002254", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「可是,为什么偏偏是现在!」"
                }
            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这种问题,就和问『为什么千年樱偏偏现在开花?』一样,毫无意义」"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不是别的任何时候。是现在,我明白了自己喜欢里奈。所以就告白",
                    {"rt2"},
                    "了」"
                }
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我以前说过吧。我是一生一穴主义」"
                }
            }
        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002255", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「拿穴这种字眼说里奈,太下流了」"
                }
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这话轮得到你说吗」"
                }
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「总之,我这辈子,只打算和一个女人交往」"
                }
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以,就算你问我为什么是现在,我也只能说,是花了这么久才走到",
                    {"rt2"},
                    "这一步」"
                }
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002256", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「为什么,你就那么执着于只爱一个女人?」"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我也不知道。只是,我家婆婆说过。草薙家的人,都是一根筋」"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「而对那样一根筋的老爸,过世的母亲一直深怀感激」"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「母亲临终时说,正因为有那份专一的爱,自己的人生才如此美好」"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「毕竟是我最爱的母亲……。虽然只是短短一句话,却深深刺进了我",
                    {"rt2"},
                    "的胸口」"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「草薙健一郎那家伙,嘛,干过各种各样的事,但即便如此,他只爱过母",
                    {"rt2"},
                    "亲一个人,恐怕是事实」"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「爱到让人想说,多少也分点爱给儿子啊。那家伙就是这么爱着母亲」"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以啊,母亲的人生虽然短暂,我想她一定非常满足」"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「正因为我看着那样的母亲长大。才决定无论如何,都只爱一个女人」"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002257", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「可是,你被甩了吧」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊」"
                }
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002258", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那,那份爱要怎么办?」"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「一直藏在心里呗」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为,我喜欢冰川,盼着冰川幸福。如果和我在一起并不是幸福」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这确实遗憾,也不甘心……但既然爱着冰川,这份爱就必须藏好」"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002259", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「藏在心里的爱,不过是没有勇气罢了」"
                }
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我明白川内野想说什么。可是啊,爱这东西,很难的」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「想把对方占为己有的强烈念头,和希望对方幸福的心愿」"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这两者若能一致,不知会有多幸福……,可这世道,没那么尽如人意」"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「爱,总会变得自私」"
                }
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「会擅自认定,自己的爱就是为了对方好」"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但,不是这样」"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不能这样自我开脱」"
                }
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002260", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「为什么?」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为啊,因为,爱是要两个人一起培育的东西吧?」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「既然如此,只靠一个人单相思,是不行的」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"bg", file = "ev_com_d08_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d08/", set = "ev_com_d08"},
