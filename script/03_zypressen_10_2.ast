        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但即便如此，那也不过是在奇迹上覆盖奇迹……必定会产生更大",
