    },
    block_00094 = {
        {"text"},
        text = {
            ja = {
                {"在花瓣中失去视野的我所看到的——"}
            }
        },
        linkback = "block_00093",
        linknext = "block_00095"
    },
    block_00095 = {
        {"text"},
        text = {
            ja = {
                {"是从伯奇神社中生长出的一棵巨大的樱花树。"}
            }
        },
        linkback = "block_00094",
        linknext = "block_00096"
    },
    block_00096 = {
