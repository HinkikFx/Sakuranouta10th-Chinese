                {"vo", file = "fem_rna_002249", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那,那我也是一样的啊……。倒不如说,从那个时候起,我就一直……",
                    {"rt2"},
                    "是草薙同学的俘虏……」"
                }
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那个时候是指?」"
                }
            }
        },
        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"fg", ch = "里奈", size = "z1", mode = 3, path = ":fg/rna/z1/", file = "rna_z1d0100", face = "d0016", head = "rna_z1d", lv = 4, id = 9},
