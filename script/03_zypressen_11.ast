    },
    block_00156 = {
        {"bg", file = "ev_com_d09_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d09/", set = "ev_com_d09"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002298", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是的,被高大的男子性抱着,非常舒服。还有,这双手呢。要这样……」"
                }
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            ja = {
                {"里奈把我的手臂拉到身前,像要让我抱住她一样。"}
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"bg", file = "ev_com_d09_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d09/", set = "ev_com_d09"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002299", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「哇——,哇——,被抱住了。好感动啊。这真是感动啊」"
                }
            }
