    },
    block_00211 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002327", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「刚才那句话,我要录下来。请再来一次」"
                }
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002328", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「录下来之后,我想用作闹铃、来电铃声、开机音、门铃、警报还有",
                    {"rt2"},
                    "扩音喇叭」"
