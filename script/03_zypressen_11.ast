        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,因为我就是这么做的」"
                }
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"bg", file = "ev_com_d09_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d09/", set = "ev_com_d09"},
        {"text"},
        text = {
