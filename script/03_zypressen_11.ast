    },
    block_00183 = {
        {"bg", file = "ev_com_d09_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d09/", set = "ev_com_d09"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002312", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我呢。草薙先生，我一直一直喜欢草薙先生哦」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯……」"
                }
