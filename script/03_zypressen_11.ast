            },
            ja = {
                {
                    name = {"里奈"},
                    "「就是你说出那句羞死人的中二台词的时候啊。要我再说一遍吗?」"
                }
            }
        },
        linkback = "block_00053",
        linknext = "block_00055"
    },
    block_00055 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,不,不用了……」"
