                    name = {"里奈"},
                    "「我,好幸福」"
                }
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是吗,没想到这种小事就能让你高兴……」"
                }
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"bg", file = "ev_com_d09_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d09/", set = "ev_com_d09"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002303", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「唔,什么叫『这种小事』,太让人意外了。被喜欢的人从背后抱住,",
                    {"rt2"},
                    "可是超——级如梦似幻的奖赏」"
                }
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
