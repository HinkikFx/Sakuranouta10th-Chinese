        linknext = "block_00217"
    },
    block_00217 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为只要你想听,我随时都会说给你听。我爱你哦。里奈。一生都",
                    {"rt2"},
                    "会珍惜你」"
