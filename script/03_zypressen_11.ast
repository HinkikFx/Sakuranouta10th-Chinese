    },
    block_00174 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「里奈的心跳啊」"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002309", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「心跳?　欸?　真,真的吗?」"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯,里奈的温暖和心跳都传过来了……」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「感受着你的体温和心跳,就会真切地体会到,这果然是现实啊」"
                }
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"bg", file = "ev_com_d09_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d09/", set = "ev_com_d09"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002310", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「啊哈哈哈,被,被你这么一说,好像隔着后背也能感觉到呢。总,总觉",
                    {"rt2"},
                    "得,这么一想就害羞起来了……」"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「害羞吗?」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002311", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「与其说害羞……不如说是开心过头才害羞……。实在是不好意思」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是吗」"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            ja = {
                {"我从背后抱住里奈。"}
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"bg", file = "ev_com_d09_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d09/", set = "ev_com_d09"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002312", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我啊。草薙同学,我一直,一直都喜欢着草薙同学哦」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊……」"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002313", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「但是,我从不觉得那是伸手能够到的东西……」"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002314", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「草薙同学总是在我身边,轻易就肯和我说话,和我要好……,正因如此",
                    {"rt2"},
                    ",反而觉得那是最遥远的存在……」"
                }
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002315", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「越是靠近,就越是觉得,这是不可以奢求的东西啊」"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002316", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「所以,果然像做梦一样」"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「像做梦吗……」"
                }
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002317", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是的,如梦似幻」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002318", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「船儿踏浪而行的波声太过舒心,舒心得让人以为这一夜会永远持续",
                    {"rt2"},
                    "下去,连睡梦都不由得醒了」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「长夜漫漫 沉沉远梦 尽皆醒转 乘浪之舟 橹声悦耳」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是那首回文歌啊」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002319", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是的,所以一想到这份如梦般的舒心,或许也会醒来,就有点害怕」"
                }
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那首歌啊,也可以理解成“在波声太过舒心的船上,忘了细数流逝的",
                    {"rt2"},
                    "时刻,甚至觉得清晨不会到来,夜是如此漫长”这个意思哦」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「对梦的态度,全看那个人的心境。如梦般延续的时光,是终将破碎,",
                    {"rt2"},
                    "还是会一直这样下去,这首回文歌能作两种解读,正象征着这一点」"
                }
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002320", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「原来如此。嘛,确实全看本人的心境呢」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「至少,我打算把这段如梦般的时光……变成一生之物哦?」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"bg", file = "ev_com_d09_08", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d09/", set = "ev_com_d09"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002321", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「……!」"
                }
            }
        },
        linkback = "block_00198",
