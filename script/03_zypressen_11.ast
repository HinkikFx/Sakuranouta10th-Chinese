    },
    block_00185 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002313", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「但是，觉得这份心意怎么也够不到……」"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002314", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「草薙先生一直在我身边，很容易就能说上话，也和我很要好……",
                    {"rt2"},
                    "正因为如此，才觉得像是最遥远的存在……」"
                }
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002315", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「越是亲近，就越觉得这是不可以追求的东西」"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002316", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「所以，果然像做梦一样」"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「像做梦吗……」"
                }
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002317", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是的，就像在做梦」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002318", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「心地好到要把波涛翻涌的浪花踢散一般的感觉，舒适得让人觉得",
                    {"rt2"},
                    "这个夜晚会永远持续下去，不禁从梦中醒来」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「长夜漫漫眠梦深，无人不醒觉，乘风破浪响潮音，快意亦难忘」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那首回文诗啊」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002319", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是的，所以一想到这份如梦般的舒适也许会醒来，就有些害怕」"
                }
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那首诗啊，也可以理解为'在波声舒适的船上，忘了数流逝的时光，",
                    {"rt2"},
                    "甚至觉得天好像永远不会亮了——就是感受到了这般漫长的夜'」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「对待梦的态度取决于个人的心态。如梦般持续的时光——是会破碎",
                    {"rt2"},
                    "呢，还是会一直这样持续下去呢——这首回文诗能有两种解读，正象",
                    {"rt2"},
                    "征着这一点」"
                }
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002320", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「原来如此。嗯，确实是看个人心态」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「至少，我打算把这段如梦般的时光……变为一生的」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
