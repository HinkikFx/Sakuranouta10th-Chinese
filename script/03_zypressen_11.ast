                    "「欸?　什,什么事?」"
                }
            }
        },
        linkback = "block_00047",
        linknext = "block_00049"
    },
    block_00049 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那个,该怎么说,真的选我就好了吗……之类的」"
                }
            }
        },
        linkback = "block_00048",
        linknext = "block_00050"
    },
    block_00050 = {
        {"fg", ch = "里奈", size = "z1", mode = 3, path = ":fg/rna/z1/", file = "rna_z1a0100", face = "a0008i", head = "rna_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002248", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「你在说什么傻话啊,这个问题才更该由我来问学长呢……」"
                }
            }
        },
        linkback = "block_00049",
        linknext = "block_00051"
    },
    block_00051 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么啊。我不是说了,正因为除了里奈谁都无法考虑,我才选了里",
                    {"rt2"},
                    "奈吗」"
                }
            }
        },
        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"fg", ch = "里奈", size = "z1", mode = 3, path = ":fg/rna/z1/", file = "rna_z1a0100", face = "a0002i", head = "rna_z1a", lv = 4, id = 9},
        {"fgact", ch = "里奈", act = "びっくり", lv = 4, id = 9},
        {"text"},
        text = {
