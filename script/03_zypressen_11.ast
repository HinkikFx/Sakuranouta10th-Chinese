        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"bg", file = "ev_com_d09_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d09/", set = "ev_com_d09"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002300", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我一直想着,好想像这样被学长从背后抱住啊。说不定我超喜欢被",
                    {"rt2"},
                    "人从背后抱住」"
                }
            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是吗,那么,来」"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
            ja = {
                {"我把怀中的里奈搂得更紧。"}
            }
        },
        linkback = "block_00160",
