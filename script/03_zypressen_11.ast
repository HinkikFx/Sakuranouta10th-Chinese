                {"vo", file = "fem_rna_002324", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「怎么可能不愿意啊。倒不如说?　刚,刚才那句被当成求婚也不奇",
                    {"rt2"},
                    "怪哦」"
                }
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就当是求婚也无妨,所以没问题」"
