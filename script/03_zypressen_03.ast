    },
    block_00032 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001661", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「'是呀，在远处能看到的那个磨坊的那一边，进村后的第一栋房子",
