    },
    block_00126 = {
        {"text"},
        text = {
            ja = {
                {"和大灰狼少女目光交汇的时候，毒蘑菇少女故意笑了。"}
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"text"},
        text = {
            ja = {
                {"温柔地、以一副极为美丽的笑容向她微笑。"}
            }
        },
        linkback = "block_00126",
        linknext = "block_00128"
    },
    block_00128 = {
        {"text"},
        text = {
            ja = {
                {"她感受到了那个笑容中的危机。"}
            }
        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"text"},
        text = {
            ja = {
                {"所以她一脚踢飞了课桌，走了出去。"}
