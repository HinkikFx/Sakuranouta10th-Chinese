    },
    block_00276 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001018", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「如果是给没有心灵的少女赋予了心灵的艺术家呢。那诞生的心灵",
