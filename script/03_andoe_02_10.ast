        linkback = "block_00026",
        linknext = "block_00028"
    },
    block_00028 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「怎么？那涂鸦像毕加索或康定斯基一样前卫而有冲击力？」"
