        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001010", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「哦，这样啊。不过，就算以后再遇到禀，也不用害怕。她大概就",
