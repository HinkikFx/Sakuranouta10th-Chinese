        linkback = "block_00086",
        linknext = "block_00088"
    },
    block_00088 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「怎么?　你以为我看了那家伙的画就会绝望吗?」"
                }
