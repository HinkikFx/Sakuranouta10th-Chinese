    },
    block_00101 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000905", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「事实上，我自己也不放心让水菜一个人。听说夏目老太太去世后，",
