        text = {
            vo = {
                {"vo", file = "man_kid_000858", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「不，小孩子的画本来就挺前卫的。但那通常都以无聊的结果收场」"
