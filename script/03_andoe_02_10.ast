    },
    block_00014 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000850", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「对，她是我唯一的弟子」"
