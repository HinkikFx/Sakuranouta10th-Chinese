    },
    block_00265 = {
        {"text"},
        text = {
            ja = {
                {"我隐约感觉到,所有的一切正在自己心中渐渐连成一线。"}
            }
        },
        linkback = "block_00264",
        linknext = "block_00266"
    },
    block_00266 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「总之我明白了」"
                }
            }
        },
        linkback = "block_00265",
        linknext = "block_00267"
    },
    block_00267 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「虽然我不觉得还会再见到禀」"
                }
            }
        },
        linkback = "block_00266",
        linknext = "block_00268"
    },
    block_00268 = {
        {"bg", file = "ev_com_f02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001013", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「别说那种话嘛。禀她看起来相当喜欢你哦」"
                }
            }
        },
        linkback = "block_00267",
        linknext = "block_00269"
    },
    block_00269 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是吗?　在超绝美术家禀的面前,我这种人不过是个凡人画匠罢了」"
                }
            }
        },
        linkback = "block_00268",
        linknext = "block_00270"
    },
    block_00270 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001014", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「就算是超绝美术家,少女也还是少女。也是会恋爱的」"
                }
            }
        },
        linkback = "block_00269",
        linknext = "block_00271"
    },
    block_00271 = {
        {"bg", file = "ev_com_f02_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001015", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「真是万人迷啊」"
                }
            }
        },
        linkback = "block_00270",
        linknext = "block_00272"
    },
    block_00272 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么万人迷……就算真像你想的那样,也只有禀一个吧」"
                }
            }
        },
        linkback = "block_00271",
        linknext = "block_00273"
    },
    block_00273 = {
        {"bg", file = "ev_com_f02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001016", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「笨蛋吗你。不是还有被禀赋予了心灵的少女吗」"
                }
            }
        },
        linkback = "block_00272",
        linknext = "block_00274"
    },
    block_00274 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那是什么意思?」"
                }
            }
        },
        linkback = "block_00273",
        linknext = "block_00275"
    },
    block_00275 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001017", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「毕竟禀总是一边说着你的事,一边画画嘛……」"
                }
            }
        },
        linkback = "block_00274",
        linknext = "block_00276"
    },
    block_00276 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001018", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「给不具心灵的少女以心灵的艺术家。如此说来,新生的那颗心,会",
                    {"rt2"},
                    "被怎样的思念所影响呢……」"
                }
            }
        },
        linkback = "block_00275",
        linknext = "block_00277"
    },
    block_00277 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001019", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嘛,我和那丫头也相处了很久,自认为很清楚这一点……」"
                }
            }
        },
        linkback = "block_00276",
        linknext = "block_00278"
    },
    block_00278 = {
        {"bg", file = "ev_com_f02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001020", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「明明是配你都嫌可惜的好姑娘啊……」"
                }
            }
        },
        linkback = "block_00277",
        linknext = "block_00279"
    },
    block_00279 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以说,你到底在讲什么啊」"
                }
            }
        },
        linkback = "block_00278",
        linknext = "block_00280"
    },
    block_00280 = {
        {"bgm", stop = 1, time = 1000},
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001021", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嘛,这事就算了」"
                }
            }
        },
        linkback = "block_00279",
        linknext = "block_00281"
    },
    block_00281 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么跟什么啊」"
                }
            }
        },
        linkback = "block_00280",
        linknext = "block_00282"
    },
    block_00282 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001022", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「禀给了葛一颗心。我认为,那份影响会在各种各样的地方显现出来」"
                }
            }
        },
        linkback = "block_00281",
        linknext = "block_00283"
    },
    block_00283 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以说,是什么样的影响啊。完全摸不着头脑」"
                }
            }
        },
        linkback = "block_00282",
        linknext = "block_00284"
    },
    block_00284 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"bgm", file = "bgm007"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001023", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「和葛做爱的时候,记得好好避孕啊」"
                }
            }
        },
        linkback = "block_00283",
        linknext = "block_00285"
    },
    block_00285 = {
        {"quake", mode = "mw"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    {"exfont", size = "f4"},
                    "「为、为什么是葛啊!　再说了谁会做啊!　你是笨蛋吗!」",
                    {"exfont"}
                }
            }
        },
        linkback = "block_00284",
        linknext = "block_00286"
    },
    block_00286 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001024", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「别在医院里嚷那么大声嘛。啊——耳朵疼」"
                }
            }
        },
        linkback = "block_00285",
        linknext = "block_00287"
    },
    block_00287 = {
        {"bg", file = "ev_com_f02_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001025", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「你像我,相当受欢迎。嘛,谁叫我长得这么帅呢」"
                }
            }
        },
        linkback = "block_00286",
        linknext = "block_00288"
    },
    block_00288 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我可从葛那儿听说了。你说过,我长得像你,让你讨厌得不得了」"
                }
            }
        },
        linkback = "block_00287",
        linknext = "block_00289"
    },
    block_00289 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001026", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嘛,帅哥有一个就够了嘛。我觉得大家只喜欢我一个就好」"
                }
            }
        },
        linkback = "block_00288",
        linknext = "block_00290"
    },
    block_00290 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那你妈死后,你倒是再婚一个看看啊」"
                }
            }
        },
        linkback = "block_00289",
        linknext = "block_00291"
    },
    block_00291 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001027", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「笨——蛋。草薙家的血是专情的。那可是,就像夏目家的老太太那",
                    {"rt2"},
                    "样,一辈子只能爱一个人的」"
                }
            }
        },
        linkback = "block_00290",
        linknext = "block_00292"
    },
    block_00292 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「谁知道呢,我一直觉得你在纽约女人换个没完」"
                }
            }
        },
        linkback = "block_00291",
        linknext = "block_00293"
    },
    block_00293 = {
        {"bg", file = "ev_com_f02_08", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001028", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「你是傻子吗。又不是你。你这种把童贞憋出毛病来的家伙,一旦尝",
                    {"rt2"},
                    "过女人的滋味,肯定会像个笨蛋一样和女人做个没完」"
                }
            }
        },
        linkback = "block_00292",
        linknext = "block_00294"
    },
    block_00294 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「怎、么、可、能。和你不一样,我才是货真价实的专情男子人」"
                }
            }
        },
        linkback = "block_00293",
        linknext = "block_00295"
    },
    block_00295 = {
        {"bg", file = "ev_com_f02_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001029", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「谁知道呢。你还是童贞所以不懂吧。我可是有把专情贯彻到底的",
                    {"rt2"},
                    "实绩的」"
                }
            }
        },
        linkback = "block_00294",
        linknext = "block_00296"
    },
    block_00296 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以我说,就是那个才让人没法相信啊」"
                }
            }
        },
        linkback = "block_00295",
        linknext = "block_00297"
    },
    block_00297 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001030", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「你有什么根据这么说。你这种笨蛋赶紧回去!」"
                }
            }
        },
        linkback = "block_00296",
        linknext = "block_00298"
    },
    block_00298 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不用你说我也要回了!　笨蛋」"
                }
            }
        },
        linkback = "block_00297",
        linknext = "block_00299"
    },
    block_00299 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001031", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「啰嗦。笨蛋」"
                }
            }
        },
        linkback = "block_00298",
        linknext = "block_00300"
    },
    block_00300 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「骂人笨蛋的人才是笨蛋」"
                }
            }
        },
        linkback = "block_00299",
        linknext = "block_00301"
    },
    block_00301 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001032", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「先骂的是你。笨蛋」"
