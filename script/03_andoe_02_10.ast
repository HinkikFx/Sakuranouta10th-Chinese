        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不是创作而是具现化。不是才能而是特殊能力。简直像超能力一",
