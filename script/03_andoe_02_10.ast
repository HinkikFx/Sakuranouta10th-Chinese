        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            ja = {
                {
                    "老爸的表情似乎有一瞬间僵住了。但下一个瞬间,又恢复成平日那副",
                    {"rt2"},
                    "玩世不恭的样子。"
