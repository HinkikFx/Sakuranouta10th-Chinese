    },
    block_00026 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000856", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「对，在路上用蜡笔石在画涂鸦」"
