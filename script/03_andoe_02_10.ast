    },
    block_00013 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「发现的?」"
                }
            }
        },
        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000850", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「对,她是我唯一的弟子」"
