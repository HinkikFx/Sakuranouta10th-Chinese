    },
    block_00228 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000989", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「一切都被重置了。重置？不，也许用重置这个词不太恰当」"
