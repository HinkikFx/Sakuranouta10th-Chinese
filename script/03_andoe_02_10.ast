        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「葛也这么说，不过是真的吗？我一直以为你不是那种会收弟子的",
                    {"rt2"},
