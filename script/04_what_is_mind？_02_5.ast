    block_00001 = {
        {"text"},
        text = {
            ja = {
                {"他将娼妓的裸女像展示在了最权威的沙龙上。"}
            }
        },
        linkback = "block_00000",
        linknext = "block_00002"
    },
    block_00002 = {
        {"text"},
        text = {
            ja = {
                {"面对这件轰动性的作品，据说展览会上甚至有人挥舞手杖大闹。"}
            }
        },
        linkback = "block_00001",
        linknext = "block_00003"
    },
    block_00003 = {
        {"text"},
        text = {
            ja = {
                {"原因是那种逼真的气息感。"}
            }
        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"text"},
        text = {
            ja = {
                {
                    "仿佛把来买春的人一瞬间拉回了那个场景，这幅作品就有着那种生",
                    {"rt2"},
                    "动的真实感。"
                }
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000381", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「就原原本本地照搬过来……」"
                }
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            ja = {
                {"临摹。"}
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            ja = {
                {"但单纯的临摹可不行。"}
