        linkback = "block_00016",
        linknext = "block_00018"
    },
    block_00018 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000384", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「画画的人只要还剩一只右手，就没有死。要杀一个画家，不把他",
                    {"rt2"},
                    "两条胳膊都卸下来，他是死不了的」"
                }
            }
        },
        linkback = "block_00017",
        linknext = "block_00019"
    },
    block_00019 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000216", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「老师……」"
                }
            }
        },
        linkback = "block_00018",
        linknext = "block_00020"
    },
    block_00020 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000385", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那帮家伙明天就会明白。一个还留着右手的画家，能干出什么事",
                    {"rt2"},
                    "来……」"
                }
            }
        },
        linkback = "block_00019",
        linknext = "block_00021"
    },
    block_00021 = {
        {"text"},
        text = {
            ja = {
                {"水菜始终一脸担忧地望着我，而每当这时，我都会——"}
            }
        },
        linkback = "block_00020",
        linknext = "block_00022"
    },
    block_00022 = {
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000386", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「不行！　那种表情不行！」"
