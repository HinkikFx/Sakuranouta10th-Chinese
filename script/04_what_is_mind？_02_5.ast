ast = {
    block_00000 = {
        {"savetitle", text = "第Ⅳ章"},
        {"bg", file = "ev_aix_h04_01", path = ":ev/ev_aix_h04/", set = "ev_aix_h04"},
        {"bgm", file = "bgm028"},
        {"text"},
        text = {
            ja = {
                {"『奥林匹亚』是当时对娼妇的通称。"}
            }
        },
        linknext = "block_00001"
    },
    block_00001 = {
        {"text"},
        text = {
            ja = {
                {"他把娼妇的裸体像，展示在了最具权威的沙龙上。"}
            }
        },
        linkback = "block_00000",
        linknext = "block_00002"
    },
    block_00002 = {
        {"text"},
        text = {
            ja = {
                {
                    "据说面对这幅惊世骇俗的作品，甚至有人在展览会上挥舞手杖大闹",
                    {"rt2"},
                    "了一场。"
                }
            }
        },
        linkback = "block_00001",
        linknext = "block_00003"
    },
    block_00003 = {
        {"text"},
        text = {
            ja = {
                {"原因，在于那真实的空气感。"}
            }
        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"text"},
        text = {
            ja = {
                {
                    "仿佛让前来买春的人，在那一瞬间被拉回现实——这幅作品里，就有",
                    {"rt2"},
                    "这样一种生猛的真实。"
                }
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000381", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「就把它原封不动地拿来……」"
                }
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            ja = {
                {"临摹。"}
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            ja = {
                {"但是，单纯的临摹是不行的。"}
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"text"},
        text = {
            ja = {
                {"我要偷的，既不是素描，也不是笔法。"}
            }
        },
        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"text"},
        text = {
            ja = {
                {"我要偷的，是「空气」。"}
            }
        },
        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"text"},
        text = {
            ja = {
                {"前来买春的人所感受到的、那种独特的空气。"}
            }
        },
        linkback = "block_00009",
        linknext = "block_00011"
    },
    block_00011 = {
        {"text"},
        text = {
            ja = {
                {"在展览会上挥舞手杖的那个男子人，为什么会愤怒到那种地步？"}
            }
        },
        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            ja = {
                {"人在什么时候会感到愤怒？"}
            }
        },
        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"text"},
        text = {
            ja = {
                {"把那愤怒的原动力，涂进画布之中。"}
            }
        },
        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"mwact", act = "びっくり", size = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000382", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「呃……」"
                }
            }
