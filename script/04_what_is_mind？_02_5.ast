        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000383", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「啊，啊啊，没事。那帮蠢货，会有他们好受的……」"
