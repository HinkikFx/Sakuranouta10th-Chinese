        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000215", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「好受的？」"
                }
            }
