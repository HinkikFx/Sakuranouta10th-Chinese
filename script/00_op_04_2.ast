        },
        linkback = "block_00022",
        linknext = "block_00024"
    },
    block_00024 = {
        {"text"},
        text = {
            ja = {
                {
                    "男子生们一旦骚动起来便收不住了，「请打我吧」——这样的学生蜂",
                    {"rt2"},
                    "拥而至。"
                }
            }
        },
        linkback = "block_00023",
        linknext = "block_00025"
    },
    block_00025 = {
        {"text"},
        text = {
            ja = {
                {
                    "当时还是新任教师的蓝慌了神，照着学生们说的，就真的给男子生",
                    {"rt2"},
                    "来了一记当身击。"
                }
            }
        },
        linkback = "block_00024",
        linknext = "block_00026"
    },
    block_00026 = {
        {"text"},
        text = {
            ja = {
                {
                    "换做现在的蓝肯定不会那般慌张，但毕竟当时还是新人。而且据说",
