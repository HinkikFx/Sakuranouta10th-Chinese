        linkback = "block_00020",
        linknext = "block_00022"
    },
    block_00022 = {
        {"text"},
        text = {
            ja = {
                {
                    "起因据说是某个学生冒出的一句话——「老师的当身到底有多大威力",
                    {"rt2"},
                    "?」。"
                }
            }
        },
        linkback = "block_00021",
        linknext = "block_00023"
    },
    block_00023 = {
        {"text"},
        text = {
            ja = {
                {"小小个子的蓝。听说在练武。想见识一下那份威力。"}
            }
        },
        linkback = "block_00022",
        linknext = "block_00024"
    },
    block_00024 = {
        {"text"},
        text = {
            ja = {
                {"男子生们一旦闹起来就停不下来,纷纷涌上前喊着「请打我一下」。"}
            }
        },
        linkback = "block_00023",
        linknext = "block_00025"
    },
    block_00025 = {
        {"text"},
        text = {
            ja = {
                {
                    "当时还是新任教师的蓝一慌,就照他们说的,给了一名男子生一记当",
                    {"rt2"},
                    "身。"
                }
            }
        },
        linkback = "block_00024",
        linknext = "block_00026"
    },
    block_00026 = {
        {"text"},
        text = {
            ja = {
                {
                    "换成现在的蓝,想必不至于慌成那样,可毕竟当时刚刚上任。而且,据",
                    {"rt2"},
                    "说她此前与男子生完全无缘。"
                }
            }
        },
        linkback = "block_00025",
        linknext = "block_00027"
    },
    block_00027 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000240", ch = "aid"}
            },
            ja = {
                {"「那一瞬间,我已经做好了被开除公职的觉悟」"}
            }
        },
        linkback = "block_00026",
        linknext = "block_00028"
    },
    block_00028 = {
        {"text"},
        text = {
            ja = {
                {"——这是蓝的原话。"}
            }
        },
        linkback = "block_00027",
        linknext = "block_00029"
    },
    block_00029 = {
        {"text"},
        text = {
            ja = {
                {"然而,事实却完全相反。"}
            }
        },
        linkback = "block_00028",
        linknext = "block_00030"
    },
    block_00030 = {
        {"text"},
        text = {
            ja = {
                {"挨了那一下的学生,留下了如下感言。"}
            }
        },
        linkback = "block_00029",
        linknext = "block_00031"
    },
    block_00031 = {
        {"text"},
        text = {
            ja = {
                {"「感觉就像从地狱升上了天堂」"}
            }
        },
        linkback = "block_00030",
        linknext = "block_00032"
    },
    block_00032 = {
        {"text"},
        text = {
            ja = {
                {
                    "留下这句感言便昏死过去的学生,脸上的表情实在太过幸福,于是「",
                    {"rt2"},
                    "我也想挨蓝老师一记当身」的学生蜂拥而至。"
                }
            }
        },
        linkback = "block_00031",
        linknext = "block_00033"
    },
    block_00033 = {
        {"text"},
        text = {
            ja = {
                {"那天多亏了班主任老师,才总算平安收场。"}
