                {"vo", file = "fem_rnd_002298", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「和直君一样……不。比直君湿得更厉害……」"
                }
            }
        },
        linkback = "block_00452",
        linknext = "block_00454"
    },
    block_00454 = {
        {"text"},
        text = {
