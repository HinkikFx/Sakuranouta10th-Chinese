        linkback = "block_00447",
        linknext = "block_00449"
    },
    block_00449 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002295", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「好粗……而且又长,又硬……啊啊啊,这么烫的……进到这里的话,会变",
                    {"rt2"},
                    "成什么样呢……」"
                }
