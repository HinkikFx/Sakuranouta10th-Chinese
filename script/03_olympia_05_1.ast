    },
    block_00507 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002325", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「因、因为,人家又不是一个人在做……,看着直君的那个,当然会兴奋",
