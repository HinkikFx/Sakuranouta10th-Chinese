            vo = {
                {"vo", file = "fem_rnd_002171", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「那、那个……你问我什么厉害,我也很难解释。不过,原来真的会变",
                    {"rt2"},
                    "成这样呢。和色情漫画里一模一样,吓了我一跳」"
                }
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你的标准是色情漫画吗」"
                }
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002172", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「因为,人家的知识只有那一个来源嘛。啊,不过,从漫画里也能学到",
                    {"rt2"},
                    "很多东西哦。绷得这么紧的话,是没那么容易消下去的吧」"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯,是啊。但你也没必要因此勉强自己……」"
                }
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"bg", file = "ev_rin_h04_02", sync = 0, face = 1, time = 400, path = ":ev/ev_rin_h04/", set = "ev_rin_h04"},
        {"text"},
        text = {
