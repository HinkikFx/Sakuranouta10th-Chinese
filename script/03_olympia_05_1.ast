    block_00502 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002322", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「嗯、嗯,看着直君咻——地射出来的样子,实在太下流了……人家没忍",
                    {"rt2"},
                    "住嘛」"
