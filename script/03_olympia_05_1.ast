        linknext = "block_00447"
    },
    block_00447 = {
        {"text"},
        text = {
            ja = {
                {"我默默点头,禀的眼神愈发陶醉地眯了起来。"}
            }
        },
        linkback = "block_00446",
        linknext = "block_00448"
    },
    block_00448 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002294", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「如果真做的话,这个就会……进到里面去……」"
                }
            }
