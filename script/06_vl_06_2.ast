            vo = {
                {"vo", file = "fem_rnd_004218", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「玻璃纸……」"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004226", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「就是这么回事，远看是彩绘玻璃，但实际上要在一天内做出那种",
                    {"rt2"},
                    "东西是不可能的」"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004227", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「如果是玻璃纸，就能轻而易举地，甚至只花几个小时就重现出彩",
                    {"rt2"},
                    "绘玻璃」"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004219", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「原来如此……」"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004228", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「不愧是草薙健一郎。居然还藏着这样的底牌……」"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004220", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「草薙健一郎？」"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004229", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「对，据说这是草薙健一郎创作『众樱的足迹』时想出的废案」"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004221", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「不，我想那大概是谎言」"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004230", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「谎言？」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004222", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「健一郎先生如果想到过这个，生前一定早就把它完成了」"
                }
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004223", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「他就是那样的人」"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004231", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「可是，这确实是从草薙健一郎的设计图里找出来的」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004224", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「唔——是这样吗……。对了，鸟谷同学你知道吗？」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004225", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「小直啊，字迹和健一郎先生一模一样」"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004232", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「诶？」"
                }
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004226", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「那两个人连字迹都很相似……」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004227", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「这个，不是健一郎先生的主意哦。『横卧之樱』之后，他不可能",
                    {"rt2"},
                    "再画樱花」"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004228", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「就连那件『众樱的足迹』，也是因为水菜女士还在世，他才会去",
                    {"rt2"},
                    "设计……」"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004229", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「因为对那个人来说，樱花大概是最重要的主题……」"
                }
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004233", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「那么，这个是……」"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004230", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「大概，是小直站在这里的瞬间想到的吧」"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004234", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「站在这里的瞬间？」"
                }
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004231", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「最初站在这里的时候……在完成『众樱的足迹』之前」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004235", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「在完成那件作品之前……」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004236", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「可是，这不是光凭灵光一闪就能做出来的东西。周日运动什么的，",
                    {"rt2"},
                    "应该有很多难点才对」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004232", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「是啊。所以，我想他大概一直在思考」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004233", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「站在这个地方，梦想着草薙健一郎的作品，想着换作自己能做出",
                    {"rt2"},
                    "什么？　能不能做出超越它的东西？　就像这样」"
                }
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004234", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「除此之外的方法……我想他也考虑过很多」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004237", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「除此之外的方法？」"
                }
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004235", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「就算把周日运动计算得再精确、时间对得再准，只要季节大幅偏",
                    {"rt2"},
                    "离，太阳就不会穿过这面彩绘玻璃」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004236", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「小直看起来像是什么事都要插一脚、什么点子都能信手拈来，但",
                    {"rt2"},
                    "其实不是那样的」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004237", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「那些啊。全都是经过漫长的时间，经过简直可称无限的连续思考，",
                    {"rt2"},
                    "才孕育出来的东西……」"
                }
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004238", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「夏目圭君。草薙健一郎先生。还有我。大概，每当这些人发表作",
                    {"rt2"},
                    "品，他都会去研究，去探寻换作自己能做出什么……」"
                }
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004239", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「那个人心中有着数不清的构想，也有着能将其具现化的技术」"
                }
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004238", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「可是，他什么都没有发表」"
                }
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004240", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「那之后过了多少年了呢……」"
                }
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004241", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「小直心中的火焰，依然在燃烧……」"
                }
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004242", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「所以，我必须前往……」"
                }
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004243", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「凭我一人无法抵达的场所……被约定的地点……」"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004244", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「小真」"
                }
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004239", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「什么？」"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004245", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「最后一次，我和小直见面的时候，他说了这样的话……」"
                }
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"bg", file = "ev_com_j08_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_j08/", set = "ev_com_j08"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004246", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「I dwell in Possibility―我居住在可能性之中」"
                }
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004247", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「A fairer House than Prose―一座比散文更美的房子」"
                }
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004248", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「More numerous of Windows―窗户远为繁多」"
                }
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004249", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「Superior―for Doors―门扉也更加出色」"
                }
            }
        },
        linkback = "block_00212",
        linknext = "block_00214"
    },
    block_00214 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004250", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「Of Chambers as the Cedars―每一间房间里」"
                }
            }
        },
        linkback = "block_00213",
        linknext = "block_00215"
    },
    block_00215 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004251", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「Impregnable of Eye―都是目光无法侵入的西洋杉」"
                }
            }
        },
        linkback = "block_00214",
        linknext = "block_00216"
    },
    block_00216 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004252", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「And for an Everlasting RoofThe Gambrels of the Sky―」"
                }
            }
        },
        linkback = "block_00215",
        linknext = "block_00217"
    },
    block_00217 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004253", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「永恒的屋顶是天空的山形屋顶――」"
                }
            }
        },
        linkback = "block_00216",
        linknext = "block_00218"
    },
    block_00218 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004254", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「Of Visitors―the fairest―来访者只有最美的人们」"
                }
            }
        },
        linkback = "block_00217",
        linknext = "block_00219"
    },
    block_00219 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004255", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「For Occupation―This―而我的工作是」"
                }
            }
        },
        linkback = "block_00218",
        linknext = "block_00220"
    },
    block_00220 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004256", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「The spreading wide my narrow HandsTo gather Paradise―」"
                }
            }
        },
        linkback = "block_00219",
        linknext = "block_00221"
    },
    block_00221 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004257", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「将这双小小的手大大张开去采撷天堂」"
                }
            }
        },
        linkback = "block_00220",
        linknext = "block_00222"
    },
    block_00222 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004258", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「当时，我以为那些话是说给我听的……」"
                }
            }
        },
        linkback = "block_00221",
        linknext = "block_00223"
    },
    block_00223 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004259", ch = "rnd"}
