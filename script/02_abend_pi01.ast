        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"text"},
        text = {
            ja = {
                {
                    "拿起来端详,翻过来倒过去,又拢在掌心里,细细品味着这只刚买到手",
                    {"rt2"},
                    "的咖啡杯。"
                }
            }
        },
        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0002", head = "aix_z1e", lv = 4, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「唔……这种妥帖地贴合掌心的感觉,比想象中还要好……」"
                }
            }
        },
        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000483", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「能让你说到这个份上,想必是相当了不得的东西吧」"
                }
            }
        },
        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯。之前在百货商场的展销会上见到过,那时候犹豫了一下,没有",
                    {"rt2"},
                    "买」"
                }
            }
        },
        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「结果还是想要,就在网上邮购了。反正也免运费,器皿本身的价格",
                    {"rt2"},
                    "也很良心」"
                }
            }
        },
        linkback = "block_00016",
        linknext = "block_00018"
    },
    block_00018 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「毕竟只是一张CD的价钱。就算是初中生,想买也买得起」"
                }
            }
        },
        linkback = "block_00017",
        linknext = "block_00019"
    },
    block_00019 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「每一只都是手工制作的。可是,作为作家的主张却几乎看不到……」"
                }
            }
        },
        linkback = "block_00018",
        linknext = "block_00020"
    },
    block_00020 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,只是没有一目了然的个性罢了,这器皿的理念,却传达得清清楚",
                    {"rt2"},
                    "楚」"
                }
            }
        },
        linkback = "block_00019",
        linknext = "block_00021"
    },
    block_00021 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「没有显眼的个性,就意味着能融入生活。主角始终是生活……咖啡",
                    {"rt2"},
                    "杯只是陪伴在买它的人的生活左右」"
                }
            }
        },
        linkback = "block_00020",
        linknext = "block_00022"
    },
    block_00022 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这可不是想做就能做到的。实际上,作者的网站上,也写着类似的",
                    {"rt2"},
                    "话」"
                }
            }
        },
        linkback = "block_00021",
        linknext = "block_00023"
    },
    block_00023 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0001", head = "aix_z1e", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000484", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「上面写着,什么样的话?」"
                }
            }
        },
        linkback = "block_00022",
        linknext = "block_00024"
    },
    block_00024 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这器皿的品牌,叫做『月之兔』。那个品牌的网站上,有这样一段",
                    {"rt2"},
                    "前言」"
                }
            }
        },
        linkback = "block_00023",
        linknext = "block_00025"
    },
    block_00025 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「『月之兔』,意为“寻常可见”」"
                }
            }
        },
        linkback = "block_00024",
        linknext = "block_00026"
    },
    block_00026 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「器皿,是与手指、掌心、嘴唇相触之物。兔的柔软,月的静谧」"
                }
            }
        },
        linkback = "block_00025",
        linknext = "block_00027"
    },
    block_00027 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我们想送到您手中的,是柔软而安静、寻常而可爱的器皿」"
                }
            }
        },
        linkback = "block_00026",
        linknext = "block_00028"
    },
    block_00028 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「……我觉得,这是做得出真正能用的东西的作家,才说得出的话」"
