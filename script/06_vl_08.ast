    block_00166 = {
        {"text"},
        text = {
            ja = {
                {"弓张的街景一览无余。"}
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"text"},
        text = {
            ja = {
                {
                    "太阳还高。但过不了几刻，日头也会西沉。到那时，这座城市便会",
                    {"rt2"},
                    "亮起灯火。"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            ja = {
                {"弓张的夜景，宛如散落的樱花般美丽。"}
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            ja = {
                {
                    "大概是因为，那一片片花瓣、一盏盏灯火里，都有着各自的人的生",
                    {"rt2"},
                    "活吧。"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            ja = {
                {
                    "花瓣即便只有一枚也很美。可是，果然还是置身于无数花瓣的簇拥",
                    {"rt2"},
                    "之中更美。"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            ja = {
                {"人们的因果交流之灯。"}
