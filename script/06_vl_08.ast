    },
    block_00101 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001685", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「既然被塞了这么个烫手山芋，我就事先和鸟谷校长约好了。只要",
