        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"text"},
        text = {
            ja = {
                {
                    "天色尚早。但再过几个时辰，太阳就会落下。届时，这座城市将亮",
                    {"rt2"},
                    "起灯火。"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            ja = {
                {"弓张的夜景，如同飘落的樱花一般美丽。"}
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            ja = {
                {
                    "大概，是因为那一片片花瓣、一盏盏灯火之中，都承载着各自的生",
                    {"rt2"},
                    "活吧。"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            ja = {
                {"花瓣即使只有一片也很美。但被无数花瓣簇拥时，会更加美丽。"}
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            ja = {
                {"人们的因果之交流灯。"}
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            ja = {
                {"数不清的人们的因果点亮了灯火。"}
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            ja = {
                {"我们的家，也是那样的灯火之一。"}
