    },
    block_00101 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001685", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「因为被塞了这种苦差事，我就跟鸟谷校长立下了约定。如果我能",
