        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「圭？　圭见过健一郎吗？」"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001694", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「没有。不过那家伙的爱车，和我的马赫Ⅲ一样，都是健一郎先生",
                    {"rt2"},
                    "骑过的」"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「诶？　是这样吗？」"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001695", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「马赫Ⅲ是他在国内、威斯巴是他在纽约骑的摩托」"
                }
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001696", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「健一郎先生回国的时候，由我保管了下来……可圭非要自己骑，",
                    {"rt2"},
                    "怎么劝都不听」"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001697", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「马赫Ⅲ已经够难伺候了，那辆也是相当难缠的摩托。太危险了，",
                    {"rt2"},
                    "我本来是反对他骑的……」"
                }
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001698", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「不过，对圭来说，健一郎先生也是他憧憬的人吧。虽然表面上从",
                    {"rt2"},
                    "没表现出那种样子……」"
                }
            }
        },
        linkback = "block_00118",
        linknext = "block_00120"
    },
    block_00120 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「马赫Ⅲ的事我是知道的，没想到连威斯巴也是健一郎的……」"
                }
            }
        },
        linkback = "block_00119",
        linknext = "block_00121"
    },
    block_00121 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001699", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「现在，好像是你在骑吧」"
                }
            }
