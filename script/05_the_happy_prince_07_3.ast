        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「模模糊糊地想着,总有一天,能像从前那样画画的时刻会到来」"
