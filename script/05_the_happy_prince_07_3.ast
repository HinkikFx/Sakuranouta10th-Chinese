        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么怎样啊……。所以说,对不起。毫无意义地喝酒发疯,真的给你",
                    {"rt2"},
                    "们添麻烦了。我会打扫,弄坏的东西也会赔」"
                }
            }
        },
        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
