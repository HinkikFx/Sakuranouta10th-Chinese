        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊哈哈哈……,不,怎么说呢。这事蠢到……我连说的心情都提不起",
