        text = {
            vo = {
                {"vo", file = "fem_aid_001318", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「所以说,你不是一直在背地里坚持画着吗……」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「说是画,也只是练习而已」"
                }
            }
