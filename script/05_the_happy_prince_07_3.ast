    },
    block_00170 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001302", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「我羡慕那样的你……同时,又觉得你比谁都惹人怜爱……」"
