        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「只要和那家伙在一起,我就擅自觉得,自己仿佛能变回从前的自己…",
                    {"rt2"},
                    "…」"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那家伙像个笨蛋一样,说什么我和他都是天才――」"
