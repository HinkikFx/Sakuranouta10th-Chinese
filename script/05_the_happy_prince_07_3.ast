        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「怎么了啊。抱这么紧,还怎么打扫啊。你看,还有碎玻璃什么的,雫",
                    {"rt2"},
                    "会受伤的哦」"
                }
            }
