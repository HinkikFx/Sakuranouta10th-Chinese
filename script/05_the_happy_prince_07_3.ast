        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「只要时间过去,就还能画出像从前那样的画……我一直抱着那样天",
