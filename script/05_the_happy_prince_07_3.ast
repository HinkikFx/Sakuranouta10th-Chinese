        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不过，练习终究只是练习。跟呕心沥血创造出来的作品是不同的」"
