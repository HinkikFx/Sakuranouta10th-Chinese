        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0210", face = "a0005", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_000136", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「要说场地费,你闯了我的地盘,交钱不是天经地义吗?美术室归谁所",
                    {"rt2"},
                    "有根本无关紧要」"
