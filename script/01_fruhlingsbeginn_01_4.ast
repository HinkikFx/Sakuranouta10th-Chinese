        linkback = "block_00081",
        linknext = "block_00083"
    },
    block_00083 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「话是没错,但多出来的部分要用来增加大家的分成,这是不成文的",
