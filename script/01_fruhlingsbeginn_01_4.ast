        text = {
            vo = {
                {"vo", file = "fem_mkd_000129", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「嘿嘿。这个嘛。作为让你用美术室的交换,分我一合的量!就这个",
