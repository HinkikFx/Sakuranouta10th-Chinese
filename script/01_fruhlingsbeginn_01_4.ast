    },
    block_00076 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0210", face = "a0025", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_000127", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「你惊讶什么?我说了批准你啊」"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那真是求之不得。不过你是在打什么算盘吧?你不可能白白说出",
                    {"rt2"},
                    "这种话」"
