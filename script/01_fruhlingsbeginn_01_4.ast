        text = {
            vo = {
                {"vo", file = "fem_mkd_000124", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「光听字面,好像说得挺有道理……。可考虑到你平时的所作所为,说",
