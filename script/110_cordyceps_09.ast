        linkback = "block_00217",
        linknext = "block_00219"
    },
    block_00219 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003645", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「希望你把一直扼杀至今的思念舍弃在这里，向着前方走下去」"
