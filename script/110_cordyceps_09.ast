    },
    block_00160 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003614", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「消失了……」"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
            ja = {
                {"心脏高高飞上天空，消失在黑暗之中。"}
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"text"},
        text = {
            ja = {
                {"留下的，只有满天的星辰――。"}
            }
        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            ja = {
                {"星辰一如往常――。"}
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"text"},
        text = {
            ja = {
                {"不，不对――。"}
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"cgdel", id = -1},
        {"bg", file = "ev_unq_c07_01", zoom = 100, time = 400, z2 = 105, path = ":ev/ev_unq_c07/", set = "ev_unq_c07"},
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900480", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「啊！　那个！　里奈！　快看那个！」"
                }
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            ja = {
                {"我指向天空。"}
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"text"},
        text = {
            ja = {
                {
                    "它骤然亮起。在满天星辰之中，诞生了一道格外湛蓝、仿佛火焰般",
                    {"rt2"},
                    "熊熊燃烧的光。"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            ja = {
                {"那道光，比任何星辰都要巨大。"}
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003615", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那是……星星，吗？」"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003616", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那样发光的星星……我从来不知道……」"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900481", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「大概，那就是刚才那团蓝色的火焰哦」"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003617", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「蓝色的火焰？」"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900482", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「如果说，是那颗心脏的主人生出了蓝色火焰的话。那么大概，不，",
                    {"rt2"},
                    "是毫无疑问，那颗闪耀之星的名字，就是第谷」"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003618", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「第谷？」"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900483", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「SN 1572，大致就在那一带才对」"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003619", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是那样的星星吗？」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900484", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「嗯，出现在仙后座、比天狼星还要明亮10倍的星星……」"
                }
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900485", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「就是宫泽贤治的作品『夜鹰之星』的原型之星哦」"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003620", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「啊，『夜鹰之星』吗……确实，如果那个故事里的星星真实存在",
                    {"rt2"},
                    "的话，也许就是这种感觉……」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900486", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「不过严格来说，第谷之星并不是星星的光芒呢」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900487", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那是超新星爆发。是星星在最后燃烧起来的火焰的亮度」"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900488", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「所以，我们已经无法再看到它了……」"
                }
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003621", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「第谷之星……那是现实世界里存在过的星星吗？」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900489", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「嗯，它曾明亮地照耀过中世纪欧洲的夜空」"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900490", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「只有短短的两年时间……」"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900491", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「即便如此，仅仅那两年间，它比夜空中任何天体都要明亮……」"
                }
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900492", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「简直像燃烧一般，闪耀着」"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003622", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是这样啊」"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900493", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「像这样看着第谷之星，我好像能明白宫泽贤治为什么会把夜鹰之",
                    {"rt2"},
                    "星的形象与它重叠了」"
                }
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900494", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「焚身幻想吗……。原来如此呢」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900495", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「宫泽贤治的焚身幻想，是奉献精神的最北端……」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900496", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「闪耀的、罪孽深重的、奉献之星吗……」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900497", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「当年……。里奈跟我讲夜鹰的故事的时候，要是我也能说出这种",
                    {"rt2"},
                    "程度的话就好了……」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003623", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不会哦，就算是现在听，也非常新鲜。这些我完全都不知道呢」"
                }
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003624", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那颗心脏，是变成第谷之星了吗？」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900498", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「这我就不知道了。不过，这样想的话，不是很说得通吗？」"
                }
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003625", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯……我懂。大概，就像优美说的那样吧」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003626", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我的画笔所触碰到的灵魂，以无比强大的心，压抑着自己」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003627", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「把自己的愿望压抑到那种程度还继续活下去，一定是相当痛苦的」"
                }
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003628", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「要熔化捆缚着那种心情的锁链，就需要相当猛烈的火焰」"
                }
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003629", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不，大概，就算是如夜鹰一般的蓝色火焰，也没能斩断那条锁链」"
                }
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003630", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「所以，那个人，舍弃了自己的心脏」"
                }
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003631", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「铅之心脏，是不可动摇之心的象征」"
                }
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003632", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那个人连那份不可动摇的决心，都剥离舍弃，向着天空启程远去",
                    {"rt2"},
                    "了……」"
                }
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003633", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「如果是那样的话……那个人就是――」"
                }
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003634", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「果然……」"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            ja = {
                {"里奈低下头。看上去仿佛紧紧闭住了嘴。"}
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            ja = {
                {"下一瞬间，她再次仰望天空，喊道。"}
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"bg", file = "zev_unq_c07_01", zoom = 80, speed = 100000, path = ":ev/ev_unq_c07/", set = "ev_unq_c07", x2 = 0, y2 = 180, x = 0, y = 324, ax = 1920, ay = 1080, bx = -960, by = -540},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003635", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我！　并不怎么喜欢你！　因为，你太过正确，太过强大，也太",
                    {"rt2"},
                    "过傲慢了……」"
                }
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003636", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「你以为只凭自己的力量，就能实现一切。无论那是何等艰难的道",
                    {"rt2"},
                    "路……」"
                }
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003637", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「你都会压抑着自己，坚持走到底……」"
                }
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003638", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「所以……我讨厌你……」"
