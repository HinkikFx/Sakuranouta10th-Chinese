    },
    block_00161 = {
        {"text"},
        text = {
            ja = {
                {"心脏高高地飞升到空中，消失在了黑暗之中。"}
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"text"},
        text = {
            ja = {
                {"留下的只有满天的星斗——"}
            }
        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            ja = {
                {"星星一如往常——"}
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"text"},
        text = {
            ja = {
                {"不，不对——"}
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"cgdel", id = -1},
        {"bg", file = "ev_unq_c07_01", zoom = 100, time = 400, z2 = 105, path = ":ev/ev_unq_c07/", set = "ev_unq_c07"},
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900480", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「啊！　那个！　里奈！　你看那个！」"
                }
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            ja = {
                {"我指向天空。"}
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"text"},
        text = {
            ja = {
                {
                    "那突然亮了起来。在满天星斗中诞生了一颗格外蓝、仿佛火焰般燃",
                    {"rt2"},
                    "烧的光芒。"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            ja = {
                {"那光芒比任何星星都要巨大。"}
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003615", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那是……星星吗？」"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003616", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「会那样发光的星星……我不知道……」"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900481", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「大概，那就是刚才的蓝色火焰」"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003617", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「蓝色火焰？」"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900482", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「如果那颗心脏的主人创造了蓝色火焰的话。大概，不，一定，那",
                    {"rt2"},
                    "颗闪耀的星星的名字是第谷」"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003618", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「第谷？」"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900483", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「SN 1572，大致就在那个方位」"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003619", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是那种星星吗？」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900484", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「嗯，出现在仙后座、比天狼星还亮十倍的星星……」"
                }
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900485", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「宫泽贤治的《鹰之星》，那颗星的原型哦」"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003620", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「啊，是《鹰之星》啊……确实，如果那个故事中的星实际存在的",
                    {"rt2"},
                    "话，大概就是这种感觉……」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900486", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「准确来说第谷之星并不是星光」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900487", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那是超新星爆发。星星在最后燃烧殆尽时的火焰之亮」"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900488", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「所以，我们已经无法看到了……」"
                }
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003621", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「第谷之星……那是现实世界中存在过的星星吗？」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900489", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「嗯，曾照亮过中世纪欧洲的夜空」"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900490", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「只有短短两年的时间……」"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900491", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「即便如此，在那两年里，它比夜空中任何天体都要亮……」"
                }
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900492", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「简直就像燃烧一般，闪耀着」"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003622", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是么」"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900493", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「像这样看着第谷之星的话，也能理解宫泽贤治为什么会将《鹰之",
                    {"rt2"},
                    "星》的意象重叠在上面了」"
                }
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900494", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「焚身幻想吗……原来如此」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900495", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「宫泽贤治的焚身幻想，是奉献精神的极致……」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900496", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「闪耀着的、罪孽深重的奉献之星……」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900497", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「当初……。在里奈给我讲鹰的故事的时候，如果我也能说出这种",
                    {"rt2"},
                    "程度的话就好了……」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003623", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不，即使是现在也很新鲜呢。完全不知道的事情」"
                }
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003624", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那颗心脏变成了第谷之星吗？」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900498", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「这个嘛，那就不得而知了。但是，那样想的话不是很合理吗？」"
                }
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003625", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯……我明白的。大概优美说的没错」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003626", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我的笔所触及的那个灵魂，用极为强大的心在压抑着自己」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003627", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那般扼杀自己的愿望继续活下去，一定承受着相当的痛苦」"
                }
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003628", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「要熔化那种束缚情感的锁链需要相当的火焰」"
                }
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003629", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不，大概，即使是鹰一般的蓝色火焰也无法斩断那条锁链」"
                }
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003630", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「所以，那个人抛弃了自己的心脏」"
                }
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003631", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「铅的心脏是不可动摇之心的象征」"
                }
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003632", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「连那样坚定不移的决心都剥离了，那个人飞向了天空……」"
                }
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003633", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那样的话……那个人是——」"
                }
