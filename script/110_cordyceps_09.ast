        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003634", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「果然……」"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            ja = {
                {"里奈低下了头。看起来她在紧紧地闭着嘴。"}
            }
