        {"bg", file = "ev_unq_c07_01_bg", zoom = 50, speed = 200000, id = 9, lv = 9, path = ":cg/", z2 = 80, x2 = -100, y2 = 100, x = 0, y = 0, ax = 1920, ay = 1080, bx = -960, by = -540},
        {"text"},
        text = {
