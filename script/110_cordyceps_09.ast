        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003639", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「因为你太过美丽……让我真切地感受到自己的丑陋」"
                }
            }
        },
        linkback = "block_00212",
        linknext = "block_00214"
    },
    block_00214 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003640", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「真切地感受到自己的软弱……」"
