    block_00218 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003644", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「你忍耐了那么久活到现在……所以希望在那前方，能有幸福等着",
                    {"rt2"},
                    "你」"
                }
