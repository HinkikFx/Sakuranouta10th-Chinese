        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            ja = {
                {"下一瞬间，她再次仰望天空，放声呼喊。"}
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"bg", file = "zev_unq_c07_01", zoom = 80, speed = 100000, path = ":ev/ev_unq_c07/", set = "ev_unq_c07", x2 = 0, y2 = 180, x = 0, y = 324, ax = 1920, ay = 1080, bx = -960, by = -540},
        {"text"},
        text = {
