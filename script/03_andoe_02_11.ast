    block_00114 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「流通中的美术品里,赝作比一般人想象的要多得多。比如让-",
                    {"rt2"},
                    "巴蒂斯特-",
