        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我们都该明白,我们能谈论的,只有那些会被识破的拙劣赝作。因",
