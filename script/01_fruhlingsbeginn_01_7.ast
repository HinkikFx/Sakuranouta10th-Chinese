        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_ked_000518", ch = "ked"}
            },
            ja = {
                {
                    name = {"圭"},
                    "「我也吐槽过这一点,结果她说什么“我平时工作就一直在干这个,稀",
                    {"rt2"},
                    "有度太低,没有商品价值”。这不是很奇怪吗?又不是全校都是奇美拉",
                    {"rt2"},
                    "的常客」"
                }
            }
        },
        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嘛,确实是套莫名其妙的说辞」"
