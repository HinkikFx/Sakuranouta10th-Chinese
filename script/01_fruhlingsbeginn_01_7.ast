        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「《樱日狂想》……啊,那幅樱花的画?为什么那东西会挂在那种地方",
                    {"rt2"},
                    "……」"
                }
            }
