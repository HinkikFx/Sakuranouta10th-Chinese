        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"fg", ch = "圭", size = "z1", mode = 3, path = ":fg/kei/z1/", file = "kei_z1c0000", face = "c0015", head = "kei_z1c", x = 345, lv = 4, id = 6},
