        },
        linkback = "block_00001",
        linknext = "block_00003"
    },
    block_00003 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「事到如今说什么呢。对你这种家伙,我才不会施舍哪怕一丁点温柔",
