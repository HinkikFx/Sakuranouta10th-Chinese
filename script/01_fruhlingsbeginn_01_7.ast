        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            ja = {
                {
                    "考虑到如此严峻的战况,此刻才加入这场招新混战,着实需要几分勇",
                    {"rt2"},
                    "气……。"
                }
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            ja = {
                {
                    "不过,总不能把手里的传单往垃圾箱里一塞,然后脚底抹油溜之大吉",
