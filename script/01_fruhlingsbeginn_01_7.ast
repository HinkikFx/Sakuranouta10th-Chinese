        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0210", face = "a0017", head = "mak_z1a", x2 = 0, x = -345, lv = 4, id = 9},
        {"fg", ch = "圭", size = "z1", mode = 3, path = ":fg/kei/z1/", file = "kei_z1c0000", face = "c0002", head = "kei_z1c", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_ked_000543", ch = "ked"}
            },
            ja = {
                {
                    name = {"圭"},
                    "「那时候不是有个想要那幅画的大叔吗?说什么愿意出钱,求你卖给",
                    {"rt2"},
                    "他」"
                }
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「有这回事?」"
                }
