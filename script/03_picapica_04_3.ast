        linkback = "block_00044",
        linknext = "block_00046"
    },
    block_00046 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「黑山羊和白山羊几十次、几百次地重复着同样的事，某一天，邮",
                    {"rt2"},
                    "递员也许就会察觉到」"
                }
            }
        },
        linkback = "block_00045",
        linknext = "block_00047"
    },
    block_00047 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「然后，也许就会成为白山羊和黑山羊之间的牵线人」"
                }
