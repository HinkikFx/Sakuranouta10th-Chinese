    },
    block_00043 = {
        {"text"},
        text = {
            ja = {
                {"鸟谷想了一会儿，然后给出了答案。"}
            }
        },
        linkback = "block_00042",
        linknext = "block_00044"
    },
    block_00044 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0012", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002383", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「邮差？」"
                }
            }
        },
        linkback = "block_00043",
        linknext = "block_00045"
    },
    block_00045 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「正是。黑山羊和白山羊之间，邮递员的存在是不可缺的」"
                }
            }
        },
        linkback = "block_00044",
        linknext = "block_00046"
    },
    block_00046 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「黑山羊和白山羊不断重复着同样的事情几十次、几百次之后，某",
                    {"rt2"},
                    "一天，邮递员或许会察觉到」"
                }
            }
        },
        linkback = "block_00045",
        linknext = "block_00047"
    },
    block_00047 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「然后成为白山羊和黑山羊之间的桥梁」"
                }
            }
        },
        linkback = "block_00046",
        linknext = "block_00048"
    },
    block_00048 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「邮递员是站在黑山羊和白山羊之间，能够为白山羊和黑山羊的永",
                    {"rt2"},
                    "恒循环画上句号的唯一存在」"
                }
            }
        },
        linkback = "block_00047",
        linknext = "block_00049"
    },
    block_00049 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「先意识到这一点的是黑山羊那边，所以校长才想跟我谈的吧……",
                    {"rt2"},
                    "作为跟你之间的桥梁」"
                }
            }
        },
        linkback = "block_00048",
        linknext = "block_00050"
    },
    block_00050 = {
        {"text"},
        text = {
            ja = {
                {
                    "校长想跟我说话，还有其他的原因，但那是关于校长过去的感伤。",
                    {"rt2"},
                    "不是该告诉鸟谷的事情。"
                }
            }
