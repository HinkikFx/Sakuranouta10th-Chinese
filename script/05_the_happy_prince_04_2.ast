        {"bg", file = "ev_com_i04_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i04/", set = "ev_com_i04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001082", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「这里阳光也好,耳朵里面看得一清二楚,真不错」"
                }
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这样好吗。在学校里,学生和老师搞这种事,不会被人误会吗？」"
                }
            }
        },
        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001083", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「说的也是。不过,在当老师和学生之前,我们先是夏目家的一份子",
                    {"rt2"},
                    "嘛。没事没事,别太在意」"
                }
            }
        },
        linkback = "block_00053",
        linknext = "block_00055"
    },
    block_00055 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「亏你还嘴上说什么在学校要叫老师」"
                }
            }
        },
        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001084", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「说了直哉也不肯叫啊」"
                }
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「也是……」"
                }
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001085", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「为什么呢？　总觉得你有点固执啊」"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「怎么说呢……。从小到大,蓝就一直是蓝……」"
                }
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001086", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「那至少叫我蓝老师」"
                }
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「唔……那样的话或许还叫得出口……」"
                }
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「总觉得夏目这个姓,是那老太婆的姓,而且圭也姓夏目,实在叫不顺",
                    {"rt2"},
                    "口啊」"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001087", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「原来如此,倒也有道理。不过,在学校里要记得加上老师」"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「明白了。以后我会注意的」"
                }
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"bg", file = "ev_com_i04_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i04/", set = "ev_com_i04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001088", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「呵呵……」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            ja = {
                {"蓝一边笑一边帮我掏耳朵。"}
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            ja = {
                {
                    "掏耳朵这种事,一直以来都是自己一个人弄的,总有种不可思议的感",
                    {"rt2"},
                    "觉。"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"bg", file = "ev_com_i04_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i04/", set = "ev_com_i04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001089", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「健一郎先生和你相似的地方很多,但不一样的地方也不少」"
                }
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「说什么呢？」"
                }
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001090", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「健一郎先生,可不太会像你这样烦恼哦」"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那家伙是先行动,然后再后悔的类型。和我不一样」"
                }
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001091", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「嗯,所以啊。看到你现在这副表情,我想起了水菜小姐。想起了我",
                    {"rt2"},
                    "的姐姐——水菜姐姐大人」"
                }
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「妈妈吗……」"
                }
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001092", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「和健一郎正相反,姐姐大人经常烦恼哦。她无论何时都会认真思考",
                    {"rt2"},
                    ",烦恼再三,才好不容易得出答案」"
                }
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001093", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「你是水菜姐姐大人的孩子,不光长相,连举止都很像」"
                }
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001094", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「是烦恼过后再给出答案,还是先行动再承受结果,哪种才是正确的,",
                    {"rt2"},
                    "我也不太清楚」"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001095", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「不过,我并不讨厌想事情时的姐姐大人。那种时候我总爱向她撒娇」"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001096", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「毕竟人家正在想事情,照理说小孩子来腻歪,应该会嫌烦才对,可水",
                    {"rt2"},
                    "菜姐姐大人从来没有那样」"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"bg", file = "ev_com_i04_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i04/", set = "ev_com_i04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001097", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「不仅如此,她还会用小孩子也听得懂的方式,把烦心事讲给我听……。",
                    {"rt2"},
                    "她肯找我商量事情,让我觉得自己被当成了独当一面的大人,别提多",
                    {"rt2"},
                    "高兴了」"
                }
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「妈妈会那样……我可没有那种回忆」"
                }
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001098", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「那大概是因为,作为一起住在那座宅子里的人,她把我当成独当一",
                    {"rt2"},
                    "面的大人来对待了吧……」"
                }
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
    block_00082 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「妈妈都找你商量过什么？」"
                }
            }
