    },
    block_00085 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001100", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「嗯，那个人经常硬闯到夏目家来。该怎么办才好，姐姐大概有点",
                    {"rt2"},
                    "烦恼吧」"
                }
