    },
    block_00100 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001108", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「对那位老师的憧憬肯定是有的。那位老师,真的让我见识了各种各",
                    {"rt2"},
                    "样的东西」"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001109", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「健一郎先生让我看到的世界,把我灰暗的童年,变成了截然不同的",
                    {"rt2"},
                    "风景」"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001110", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「绘画居然能做到这种事。当时我可吃惊了」"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001111", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「所以,一开始我什么都没想,就立志要当美术老师」"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「蓝要当？」"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001112", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「啊,不过马上就放弃了。啊哈哈,这也是当然的,毕竟画画的才能啊",
                    {"rt2"},
                    "……我是毁灭性地没有」"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001113", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「并不是绘画本身无所不能。我明白了,正因为是草薙健一郎这个人",
                    {"rt2"},
                    ",才能通过绘画,让人看到形形色色的世界」"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001114", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「所以啊,我想用别的方法,像他那样,让谁看到崭新的世界」"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001115", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「就像健一郎为我做的那样……」"
                }
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001116", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「嘛,拿自己和那种世界级的艺术家相提并论,是有些不自量力……」"
                }
            }
        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"bg", file = "ev_com_i04_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i04/", set = "ev_com_i04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001117", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「但我就是那么想的……」"
                }
            }
        },
        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"bg", file = "ev_com_i04_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i04/", set = "ev_com_i04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001118", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「到了懂事的年纪,我就开始报考对当教员有利的大学了」"
                }
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「为什么蓝当的是国语老师？」"
                }
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001119", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「国语单纯是因为擅长而已。我是彻头彻尾的文科生。不过,健一郎",
                    {"rt2"},
                    "离开之后,我还能坚持以教师为目标,我想多亏了校长」"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「校长？」"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001120", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「啊,为了让我进这所学校,校长尽了很大的力。我真的很感激她」"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001121", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「而且,还把我聘为了这所学校的老师」"
                }
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那个校长？　尽力？」"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001122", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「是啊。嘛,她大概也有她自己的想法吧。但我还是很感谢她」"
                }
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"bg", file = "ev_com_i04_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i04/", set = "ev_com_i04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001123", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「我认为无论什么事,人与人的机缘都至关重要」"
                }
            }
        },
        linkback = "block_00118",
        linknext = "block_00120"
    },
    block_00120 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001124", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「毕竟一个人靠自己的力量能做到的事是有限的」"
                }
            }
        },
        linkback = "block_00119",
        linknext = "block_00121"
    },
    block_00121 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001125", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「他人的指引……我把它看作类似天命的东西,而这样的东西会大大",
                    {"rt2"},
                    "左右人的一生」"
                }
            }
        },
        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此……人与人的缘分吗……」"
                }
            }
        },
        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"bg", file = "ev_com_i04_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i04/", set = "ev_com_i04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001126", ch = "aid"}
