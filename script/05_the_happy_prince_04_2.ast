        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「为什么蓝想成为语文老师？」"
                }
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001119", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「语文纯粹是因为擅长。天生的文科脑。不过，健一郎离开之后还",
                    {"rt2"},
                    "能坚持想当老师，应该是校长的功劳」"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「校长？」"
                }
