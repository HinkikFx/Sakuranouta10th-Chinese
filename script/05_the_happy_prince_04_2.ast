        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊啊，是那家伙……」"
                }
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001108", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「我对那位老师很是憧憬。那位老师真的给我展示了很多东西」"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001109", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「健一郎给我展示的世界，把我灰暗的童年变成了完全不同的风景」"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001110", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「原来画能做到这样的事啊——我当时特别惊讶」"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001111", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「所以，最初毫不犹豫地想成为美术老师」"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「蓝要当？」"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001112", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「嗯，但很快就放弃了。哈哈哈，理所当然的，画画的才能嘛……",
                    {"rt2"},
                    "完全没有」"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001113", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「并不是画本身能做到各种事情。是因为草薙健一郎这个人，才能",
                    {"rt2"},
                    "通过画展示各种各样的世界」"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001114", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「所以，我想用其他方式，像他那样，给某个人展示新的世界」"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001115", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「就像健一郎为我做的那样……」"
                }
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001116", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「嘛，跟那种世界级的艺术家相提并论有些不自量力……」"
