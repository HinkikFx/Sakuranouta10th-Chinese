        text = {
            vo = {
                {"vo", file = "fem_aid_001139", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「睡眠不足就别骑什么摩托车！　这话我说了多少遍,他就是完全不",
                    {"rt2"},
                    "听」"
                }
            }
        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            ja = {
                {"不愧是蓝,那件事她果然早就提醒过圭了。"}
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001140", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「可他不知从哪儿又弄来零件,立刻装回去照骑不误。真是危险得没",
                    {"rt2"},
                    "边了」"
                }
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001141", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
