        },
        linkback = "block_00083",
        linknext = "block_00085"
    },
    block_00085 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001100", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「啊,那个人当年老是往夏目家跑嘛。该怎么办才好,姐姐大人多少",
                    {"rt2"},
                    "有些苦恼吧」"
                }
            }
        },
        linkback = "block_00084",
        linknext = "block_00086"
    },
    block_00086 = {
