        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001120", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「嗯，校长为了让我进这所学校，费了很大力气。我真的很感激」"
                }
            }
