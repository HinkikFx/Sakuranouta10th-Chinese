        linkback = "block_00096",
        linknext = "block_00098"
    },
    block_00098 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001107", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「在小音羽的宅子里啊,有个自称是老师的人经常来呢」"
                }
            }
