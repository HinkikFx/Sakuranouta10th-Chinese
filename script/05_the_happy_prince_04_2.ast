        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「确实如此。要是老爸和母亲没有相遇,我连存在都不会存在」"
