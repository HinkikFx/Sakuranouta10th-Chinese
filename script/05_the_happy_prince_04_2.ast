        text = {
            vo = {
                {"vo", file = "fem_aid_001142", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「圭就是这样的家伙……,而能让他做到这个地步的直哉,也绝非等闲",
