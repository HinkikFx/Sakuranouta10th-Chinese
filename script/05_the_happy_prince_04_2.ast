                    name = {"蓝"},
                    "「这里阳光也很充足，耳朵里面看得很清楚呢」"
                }
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这样好吗。在学校里，学生和老师做这种事，不会被误会吗？」"
                }
            }
        },
        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001083", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「是啊。不过，在是师生之前，我们不是夏目家的一员吗。没关系",
                    {"rt2"},
                    "的，别太在意」"
                }
            }
        },
        linkback = "block_00053",
        linknext = "block_00055"
    },
    block_00055 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「明明嘴上说在学校要叫老师」"
                }
            }
        },
        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001084", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「说了直哉也不叫啊」"
