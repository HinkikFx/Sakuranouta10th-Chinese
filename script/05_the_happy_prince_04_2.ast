        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"bg", file = "ev_com_i04_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i04/", set = "ev_com_i04"},
        {"text"},
        text = {
