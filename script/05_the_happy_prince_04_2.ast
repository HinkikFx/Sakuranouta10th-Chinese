        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001127", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「是啊」"
                }
            }
