    },
    block_00096 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「蓝是从什么时候开始想当老师的？」"
                }
            }
        },
        linkback = "block_00095",
        linknext = "block_00097"
    },
    block_00097 = {
        {"bg", file = "ev_com_i04_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i04/", set = "ev_com_i04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001106", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「我吗，我很小的时候就想当老师了」"
                }
            }
