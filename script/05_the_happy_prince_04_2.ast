        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「机缘吗……。降生到这个世上这件事本身,就是人与人的相遇,确实",
                    {"rt2"},
                    "是这个理」"
                }
