        text = {
            vo = {
                {"vo", file = "fem_aid_001138", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「那家伙实在睡眠不足得厉害,所以两个月前,我把摩托车引擎的火",
                    {"rt2"},
                    "花塞给拔了」"
                }
            }
        },
        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
