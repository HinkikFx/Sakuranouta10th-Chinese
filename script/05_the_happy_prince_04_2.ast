        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"bg", file = "ev_com_i04_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i04/", set = "ev_com_i04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001089", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「健一郎和你有很多相似的地方，但也有很多不同」"
                }
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「说什么呢？」"
                }
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001090", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「健一郎不太会像你这样烦恼」"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那家伙是先行动再后悔的类型。跟我不一样」"
                }
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001091", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「嗯，所以啊。看到你现在的表情，我想起了水菜。我的姐姐，水",
                    {"rt2"},
                    "菜姐」"
                }
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「妈妈吗……」"
                }
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001092", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「跟健一郎截然不同，姐姐总是在烦恼。她总是认真思考、烦恼，",
                    {"rt2"},
                    "然后好不容易才得出答案」"
                }
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001093", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「你是水菜姐的孩子，不仅长相，连举止都很像」"
                }
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001094", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「是苦恼之后得出答案，还是先行动再承受结果，我也不知道哪种",
                    {"rt2"},
                    "才是对的」"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001095", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「不过，思考着事情的姐姐，我并不讨厌。那种时候我经常赖着她",
                    {"rt2"},
                    "撒娇」"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001096", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「明明在想事情，按理说小孩子缠上来会很烦，水菜姐却从来不会",
                    {"rt2"},
                    "那样」"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"bg", file = "ev_com_i04_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i04/", set = "ev_com_i04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001097", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「不仅如此，她还会用孩子能听懂的话，把烦恼的事讲给我听……",
                    {"rt2"},
                    "被人倾诉烦恼，就好像被当作大人对待了一样，很开心」"
                }
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「妈妈吗……我倒是没有那种回忆」"
                }
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001098", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「那也许是因为她把我当作同住在那间宅邸里的人、当作一个独立",
                    {"rt2"},
                    "的大人来对待吧……」"
                }
