        linknext = "block_00016"
    },
    block_00016 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100153", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「不，真的太不行了。那种程度根本忍不住。一开始还装得很淡定",
