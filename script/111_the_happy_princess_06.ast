                {"vo", file = "fem_rnd_100172", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「啊啊啊，光靠阴蒂根本不够……衣服好碍事，胸部、乳头也……躁",
                    {"rt2"},
                    "得不行……糟糕透了……啊啊，快点，想摸，好想摸――」"
                }
            }
        },
        linkback = "block_00037",
        linknext = "block_00039"
    },
    block_00039 = {
        {"se", file = "se9010", vol = 30, id = 1},
        {"bg", file = "ev_app_h09_06", sync = 0, face = 1, time = 400, path = ":ev/ev_app_h09/", set = "ev_app_h09"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100173", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「哈啊哈啊哈啊哈啊……啊啊，幸好胸罩是前扣的……。话说回来，",
                    {"rt2"},
                    "今天就是为了能马上开始，才特意选了前扣的胸罩……嗯啊！？」"
                }
            }
        },
        linkback = "block_00038",
        linknext = "block_00040"
    },
    block_00040 = {
        {"bg", file = "ev_app_h09_07", sync = 0, face = 1, time = 400, path = ":ev/ev_app_h09/", set = "ev_app_h09"},
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100174", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「啊啊啊，好舒服，乳头，怎么，比平时还要有感觉――、啊，明明",
                    {"rt2"},
                    "平时自慰，从来不用乳头的……今天，哪里都敏感得不行……」"
                }
            }
        },
        linkback = "block_00039",
        linknext = "block_00041"
    },
    block_00041 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100175", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「哈啊哈啊哈啊，好厉害，好厉害……乳头，好厉害，有感觉，居",
                    {"rt2"},
                    "然这么有感觉……这就是，那个叫，乳头自慰的，玩意儿？　好厉",
                    {"rt2"},
                    "害，简直，不像是，自己的乳头……啊啊啊啊啊――嗯呀啊啊？！」"
                }
            }
        },
        linkback = "block_00040",
        linknext = "block_00042"
    },
    block_00042 = {
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100176", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「啊啊……啊啊……嗯嗯！　好想舔小直的小鸡鸡啊………、好想喝小",
                    {"rt2"},
                    "直的精液啊……不要那种手撸……想用嘴，好好地，含住小鸡鸡啊」"
                }
            }
        },
        linkback = "block_00041",
        linknext = "block_00043"
    },
    block_00043 = {
        {"bg", file = "ev_app_h09_08", sync = 0, face = 1, time = 400, path = ":ev/ev_app_h09/", set = "ev_app_h09"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100177", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「嗯啾、啾噗、恰噗、啾噜噜…………啊、啊啊……好想舔着小直的小",
                    {"rt2"},
                    "鸡鸡自慰……好想喝下小直的精液去一次……像这样，一个人什么的",
                    {"rt2"},
                    "……唔嗯，好寂寞……嗯呀」"
                }
            }
        },
        linkback = "block_00042",
        linknext = "block_00044"
    },
    block_00044 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100178", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「啾噜噜、嗯啾、啾噜噜……、啊、啊、啊，不管怎么，舔着，空",
                    {"rt2"},
                    "气，都没有味道……小直，已经不在了……气味，也很淡……好想舔小",
                    {"rt2"},
                    "直的啊……啾噜噜……」"
                }
            }
        },
        linkback = "block_00043",
        linknext = "block_00045"
    },
    block_00045 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100179", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「哈啊哈啊，嗯呀……呀啊嗯！？　小直、小直，啊――――、啊呼―",
                    {"rt2"},
                    "―――，从今往后，那种射精辅助………要一直………做下去啊……能摸",
                    {"rt2"},
                    "到小鸡鸡，虽然很开心……可也好难受啊……」"
                }
            }
        },
        linkback = "block_00044",
        linknext = "block_00046"
    },
    block_00046 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100180", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「能照顾小直的小鸡鸡……虽然很开心……可是，得一直像昨天那样，",
                    {"rt2"},
                    "表情不能崩……还不能被小直发现，我阴蒂勃起，压在椅子上偷偷",
                    {"rt2"},
                    "自慰……」"
                }
            }
        },
        linkback = "block_00045",
        linknext = "block_00047"
    },
    block_00047 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100181", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「只能像这样，趁小直，不在的时候……呀咿嗯！！　喵啊啊嗯！！",
                    {"rt2"},
                    "　自己，摸，自己安慰……然后一直，忍耐下去……不要啊，其实，",
                    {"rt2"},
                    "好想舔小直的啊」"
                }
            }
        },
        linkback = "block_00046",
        linknext = "block_00048"
    },
    block_00048 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100182", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「好想把从小直的，小鸡鸡里，流出来的，色色的液体……全部，",
                    {"rt2"},
                    "舔干净，唔嗯，把小鸡鸡的气味，好好用嘴，用鼻子，细细品味…",
                    {"rt2"},
                    "…唔嗯，好想帮小直射精啊……唔嗯」"
                }
            }
        },
        linkback = "block_00047",
        linknext = "block_00049"
    },
    block_00049 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100183", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「可是，那样不行啊……我必须好好地，装作若无其事，来辅助小",
                    {"rt2"},
                    "直射精……不然的话，毫无疑问，我会忍不住……弄痛小直的……」"
                }
            }
        },
        linkback = "block_00048",
        linknext = "block_00050"
    },
    block_00050 = {
        {"text"},
