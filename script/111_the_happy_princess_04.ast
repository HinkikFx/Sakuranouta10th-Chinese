        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「禀、禀，不行嘞，好厉害，好、厉害，好厉害，好舒服，太厉害",
