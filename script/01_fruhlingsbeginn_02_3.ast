    block_00001 = {
        {"text"},
        text = {
            ja = {
                {
                    "午饭后的课总觉得比较短。大概是因为一想到再撑一会儿就完了，",
                    {"rt2"},
                    "心情便轻松起来吧。"
                }
            }
