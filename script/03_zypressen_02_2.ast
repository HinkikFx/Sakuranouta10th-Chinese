        },
        linknext = "block_00001"
    },
    block_00001 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001002", ch = "yum"}
            },
            ja = {
                {
                    "狮子出生时，　　　　　　　　　　　　　　　　它为什么要杀死",
                    {"rt2"},
                    "瞪羚来吃呢。"
                }
            }
        },
        linkback = "block_00000",
        linknext = "block_00002"
    },
    block_00002 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001003", ch = "yum"}
            },
            ja = {
                {
                    "在热带草原强烈的阳光下，一片绿意盎然。　　　　　　难道没有",
                    {"rt2"},
                    "吃那些草木来维持生命的选择吗？"
                }
            }
        },
        linkback = "block_00001",
        linknext = "block_00003"
    },
    block_00003 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001004", ch = "yum"}
            },
            ja = {
                {
                    "即便如此，狮子还是杀死了瞪羚，　　　　　　　　　　　　　　",
                    {"rt2"},
                    "　　　　　还有黑斑羚，　　　　　　有时甚至连最美丽的同科猎",
                    {"rt2"},
                    "豹也会被咬杀。"
                }
            }
        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001005", ch = "yum"}
            },
            ja = {
                {
                    "瞪羚那双惹人怜爱的眼眸，那身美丽的皮毛，　　　　　　　　　",
                    {"rt2"},
                    "　　对狮子来说都无关紧要。　　　　　　外表对它而言不过是装",
                    {"rt2"},
                    "满了肉和血的袋子罢了。"
                }
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001006", ch = "yum"}
            },
            ja = {
                {
                    "所以，　　它，　　　　撕裂了那身美丽的毛皮，劈开头骨，将里",
                    {"rt2"},
                    "面的一切吞食殆尽。"
                }
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001007", ch = "yum"}
            },
            ja = {
                {
                    "对它而言，吃草木这种选择从一开始就不存在，　　　　　　　　",
                    {"rt2"},
                    "　　　　　　从美丽的瞪羚群中，　　　　挑选最弱小、最可爱的",
                    {"rt2"},
                    "幼崽吞食，乃是不言自明之理。"
                }
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001008", ch = "yum"}
            },
            ja = {
                {"对此没人觉得奇怪。"}
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001009", ch = "yum"}
            },
            ja = {
                {
                    "因为那是必然，是理所当然的结果，　　　　　　　　　　　　　",
                    {"rt2"},
                    "是自然法则。"
                }
            }
        },
        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001010", ch = "yum"}
            },
            ja = {
                {"我为什么爱上了同性。"}
            }
        },
        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001011", ch = "yum"}
            },
            ja = {
                {"这种事根本不需要理由。"}
            }
