    block_00101 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001097", ch = "yum"}
            },
            ja = {
                {
                    "'男子生果然都很下流啊'——我当时这么想。",
                    {"rt2"},
                    "　　　　　　　　　　　　　　　　　　　　　　　不，是想硬说",
                    {"rt2"},
                    "服自己这么想。"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001098", ch = "yum"}
            },
            ja = {
                {
                    "因为那个时候——　　　　　　　如果我有",
                    {"txruby", text = "ペニス"},
                    "小鸡鸡",
                    {"txruby"},
                    "的话，　　　　　",
                    {"rt2"},
                    "　　　　　我的小鸡鸡一定在裙子底下硬得不行。"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001099", ch = "yum"}
            },
            ja = {
                {"大概比谁都要坚硬、比谁都要滚烫地勃起着吧。"}
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001100", ch = "yum"}
            },
            ja = {
                {
                    "看着被殴打后失去了斗志，浑身颤抖的全裸学姐——　　　　　　　",
                    {"rt2"},
                    "　　　　　　　　　　　　　　　我说不定已经射了。"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001101", ch = "yum"}
            },
            ja = {
                {
                    "如果有人说那就是事实——　　　　　　　　　　考虑到事后内裤的",
                    {"rt2"},
                    "状况，倒也足够有说服力。"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001102", ch = "yum"}
            },
            ja = {
                {
                    "潜藏在我体内的，　　　　　　　男子性化的、暴力的、掠夺性的",
                    {"rt2"},
                    "性冲动。　　　　　　　　　　或许正是那种东西驱使我做出了那",
                    {"rt2"},
                    "样的行为。"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001103", ch = "yum"}
            },
            ja = {
                {"然后，我们品尝到了那种快感的滋味。"}
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001104", ch = "yum"}
            },
            ja = {
                {"知道了那种只能不断积聚的快感。"}
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001105", ch = "yum"}
            },
            ja = {
                {
                    "或许如果再过些年，到了所谓的青春期——那个不得不直面性冲动的",
                    {"rt2"},
                    "阶段，说不定能意外轻松地将其升华。"
                }
            }
        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001106", ch = "yum"}
            },
            ja = {
                {
                    "据说小鸡鸡只要搓几分钟就能射精，　　　　　　　　　　　　　",
                    {"rt2"},
                    "　　　　　轻而易举地消灭性冲动。"
                }
            }
        },
        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001107", ch = "yum"}
            },
            ja = {
                {
                    "可是我们太年幼了，连青春期都还没到，　　　　　在青春期特有",
                    {"rt2"},
