        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001054", ch = "yum"}
            },
            ja = {
                {"人是肮脏的生物,　　　喜好美丽之物,厌恶丑陋之物。"}
