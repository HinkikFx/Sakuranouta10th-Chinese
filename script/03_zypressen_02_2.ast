        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001056", ch = "yum"}
            },
            ja = {
                {
                    "只是,后来我才听说,　　　　　　　冰川同学头脑也很聪明。　　",
                    {"rt2"},
                    "　　善于倾听,待人温柔,　　　　举止也十分柔和。"
                }
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001057", ch = "yum"}
            },
            ja = {
                {"人品也很好。"}
