        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001055", ch = "yum"}
            },
            ja = {
                {
                    "所以,　　女生们喜欢冰川同学,　　　　　　　　　　　　　　　",
                    {"rt2"},
