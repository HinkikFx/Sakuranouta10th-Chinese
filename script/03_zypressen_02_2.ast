    block_00027 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001027", ch = "yum"}
            },
            ja = {
                {
                    "你们不过是碰巧喜欢异性而已，　　　　　　仅仅因为那是大多数",
