        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001069", ch = "yum"}
            },
            ja = {
                {
                    "我坐在教室里离她最远的地方。　　　　　　　　　　　　　　而",
                    {"rt2"},
                    "她对着那样的我,嫣然一笑。"
                }
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001070", ch = "yum"}
            },
            ja = {
                {
                    "一瞬间我没明白发生了什么,　　　　　　　　　　　　　　　回过",
                    {"rt2"},
                    "神时,嘴角已经松弛了下来。"
                }
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001071", ch = "yum"}
            },
            ja = {
                {"我露出了一个恶心的笑容。"}
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001072", ch = "yum"}
            },
            ja = {
                {
                    "那一瞬间,羞耻涌上心头,　　　　　我再也坐立难安,　　　　　　",
                    {"rt2"},
                    "　　　　　　　　　　　　　　狠狠一脚踹飞了课桌。"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"se", file = "se_attack07", id = 1},
        {"quake", mode = "mw"},
        {"ex", time = 1000, func = "wait"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001073", ch = "yum"}
            },
            ja = {
                {"课桌连同前面的椅子,一起撞上了无人的桌子。"}
