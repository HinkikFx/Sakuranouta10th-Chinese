    block_00028 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001028", ch = "yum"}
            },
            ja = {
                {
                    "他们的脑袋既没有独创性也没有想象力，　　　　仅仅是因为自己",
