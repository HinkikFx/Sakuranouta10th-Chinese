ast = {
    block_00000 = {
        {"savetitle", text = "第Ⅲ章"},
        {"bg", file = "ev_txt_c10_01", time = 1500, path = ":ev/ev_txt_c10/", set = "ev_txt_c10"},
        {"ex", time = 1000, func = "wait"},
        {"bg", file = "ev_txt_c14_01", time = 1500, path = ":ev/ev_txt_c14/", set = "ev_txt_c14"},
        {"bgm", file = "bgm002"},
        {"text"},
        text = {
            ja = {
                {"――就这样,我爱上了少女――"}
            }
        },
        linknext = "block_00001"
    },
    block_00001 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001002", ch = "yum"}
            },
            ja = {
                {
                    "狮子降生之时,　　　　　　　　　　　　　　　　他为何要杀死瞪",
                    {"rt2"},
                    "羚,将其吞食呢。"
                }
            }
        },
        linkback = "block_00000",
        linknext = "block_00002"
    },
    block_00002 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001003", ch = "yum"}
            },
            ja = {
                {
                    "承受着草原的强光,大地被染成一片翠绿。　　　　　　难道就没有",
                    {"rt2"},
                    "以那些草木为食,存活下去的选择吗？"
                }
            }
        },
        linkback = "block_00001",
        linknext = "block_00003"
    },
    block_00003 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001004", ch = "yum"}
            },
            ja = {
                {
                    "即便如此,狮子还是会咬死瞪羚,　　　　　　　　　　　　　　　",
                    {"rt2"},
                    "　　　　还有黑斑羚,　　　　　　有时甚至连同为猫科,最为美丽",
                    {"rt2"},
                    "的猎豹也不放过。"
                }
            }
        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001005", ch = "yum"}
            },
            ja = {
                {
                    "瞪羚那惹人怜爱的双眸,那美丽的毛皮,　　　　　　　　　　　对",
                    {"rt2"},
                    "狮子而言都无关紧要。　　　　　　外表什么的,于他不过是一只塞",
                    {"rt2"},
                    "满血肉的皮囊。"
                }
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001006", ch = "yum"}
            },
            ja = {
                {
                    "所以,　　他,　　　　才会撕开那美丽的毛皮,咬碎头盖骨,将其中之",
                    {"rt2"},
                    "物吃个精光吧。"
                }
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001007", ch = "yum"}
            },
            ja = {
                {
                    "对他而言,吃草这种选项从一开始就不存在,　　　　　　　　　　",
                    {"rt2"},
                    "　　　　从美丽的瞪羚群中,　　　　挑出纤弱的,最弱小,最可爱的",
                    {"rt2"},
                    "孩子吃掉,乃是自明之理。"
                }
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001008", ch = "yum"}
            },
            ja = {
                {"没有人对此感到不可思议。"}
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001009", ch = "yum"}
            },
            ja = {
                {
                    "因为那是必然,是理所当然的归结,　　　　　　　　　　　　　也",
                    {"rt2"},
                    "是自然。"
                }
            }
        },
        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001010", ch = "yum"}
            },
            ja = {
                {"我为何会爱上同性。"}
            }
        },
        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001011", ch = "yum"}
            },
            ja = {
                {"这种事情,根本无所谓理由。"}
            }
        },
        linkback = "block_00009",
        linknext = "block_00011"
    },
    block_00011 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001012", ch = "yum"}
            },
            ja = {
                {
                    "正如肉食兽必然般地吞食弱小动物的血肉,　　　　　　　　　　　",
                    {"rt2"},
                    "　　　　　　　　　　　　　我也一样,爱上了同性。"
                }
            }
        },
        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001013", ch = "yum"}
            },
            ja = {
                {
                    "对",
                    {"txruby", text = "我"},
                    "他",
                    {"txruby"},
                    "而言,",
                    {"txruby", text = "爱上男子人"},
                    "吃草",
                    {"txruby"},
                    "这种选项从一开始就不存在,　　　　　　　　　　",
                    {"rt2"},
                    "　　　　从美丽的",
                    {"txruby", text = "女孩子"},
                    "瞪羚",
                    {"txruby"},
                    "群中,　　　　挑出纤弱的,最弱小,最可爱的",
                    {"rt2"},
                    "孩子",
                    {"txruby", text = "去爱"},
                    "吃掉",
                    {"txruby"},
                    ",乃是自明之理。"
                }
            }
        },
        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001014", ch = "yum"}
            },
            ja = {
                {
                    "正因为我是这样的人,　　　　　　　　　　　　没有任何理由,　",
                    {"rt2"},
                    "　　　　　　　　　　　　　　　　　　　　　　从一开始,我就喜",
                    {"rt2"},
                    "欢女孩子。"
                }
            }
        },
        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001015", ch = "yum"}
            },
            ja = {
                {"开始察觉到这一点,是什么时候的事呢。"}
            }
        },
        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001016", ch = "yum"}
            },
            ja = {
                {"就连所谓自觉的那一刻,我都想不起来。"}
            }
        },
        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001017", ch = "yum"}
            },
            ja = {
                {
                    "我只是,理所当然般,　　　　　　　　　　　　恋上了幼儿园的女",
                    {"rt2"},
                    "老师,　　　　　而在显像管的另一侧,让我魂牵梦萦的,也必定是女",
                    {"rt2"},
                    "性偶像。"
                }
            }
        },
        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001018", ch = "yum"}
            },
            ja = {
                {"我喜欢女孩子。"}
            }
        },
        linkback = "block_00016",
        linknext = "block_00018"
    },
    block_00018 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001019", ch = "yum"}
            },
            ja = {
                {"仅此而已。"}
            }
        },
        linkback = "block_00017",
        linknext = "block_00019"
    },
    block_00019 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001020", ch = "yum"}
            },
            ja = {
                {"即便如此,世间似乎也不肯容许这一点。"}
            }
        },
        linkback = "block_00018",
        linknext = "block_00020"
    },
    block_00020 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001021", ch = "yum"}
            },
            ja = {
                {"不,不容许也无所谓。"}
            }
        },
        linkback = "block_00019",
        linknext = "block_00021"
    },
    block_00021 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001022", ch = "yum"}
            },
            ja = {
                {"只要无视我就好。"}
            }
        },
        linkback = "block_00020",
        linknext = "block_00022"
    },
    block_00022 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001023", ch = "yum"}
            },
            ja = {
                {"但是,世间似乎并没有宽容到肯装作视而不见。"}
            }
        },
        linkback = "block_00021",
        linknext = "block_00023"
    },
    block_00023 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001024", ch = "yum"}
            },
            ja = {
                {"光是被人追问理由,就足以令我不快。"}
            }
        },
        linkback = "block_00022",
        linknext = "block_00024"
    },
    block_00024 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001025", ch = "yum"}
            },
            ja = {
                {"我喜欢女孩子,这种事没有任何理由。"}
            }
        },
        linkback = "block_00023",
        linknext = "block_00025"
    },
    block_00025 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001026", ch = "yum"}
            },
            ja = {
                {"即便如此,还是会被问起。"}
            }
        },
        linkback = "block_00024",
        linknext = "block_00026"
    },
    block_00026 = {
        {"text"},
        text = {
            ja = {
                {"――为什么？"}
            }
        },
        linkback = "block_00025",
        linknext = "block_00027"
    },
    block_00027 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001027", ch = "yum"}
            },
            ja = {
                {
                    "你们这些家伙,明明只是纯属偶然地喜欢上异性,　　　　　　却因",
                    {"rt2"},
                    "为那是大多数,就认定那才是自然,　忍不住觉得所有人都必须如此―",
                    {"rt2"},
                    "―真是一群蠢货。"
                }
            }
        },
        linkback = "block_00026",
        linknext = "block_00028"
    },
    block_00028 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001028", ch = "yum"}
            },
            ja = {
                {
                    "他们的脑袋,既无独创性也无想象力,　　　　仅仅因为自己是那样,",
                    {"rt2"},
                    "就把那当成正确答案。"
                }
            }
        },
        linkback = "block_00027",
        linknext = "block_00029"
    },
    block_00029 = {
        {"text"},
        text = {
            ja = {
                {"――令人作呕。"}
            }
        },
        linkback = "block_00028",
        linknext = "block_00030"
    },
    block_00030 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001029", ch = "yum"}
            },
            ja = {
                {"尤其当那疑问出自男子人之口时,更是令我毛骨悚然。"}
            }
        },
        linkback = "block_00029",
        linknext = "block_00031"
    },
    block_00031 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001030", ch = "yum"}
            },
            ja = {
                {"换作是他们,只要稍微想象一下就能轻易理解。"}
            }
        },
        linkback = "block_00030",
        linknext = "block_00032"
    },
    block_00032 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001031_1", ch = "yum"}
            },
            ja = {
                {"那令人毛骨悚然的臭味。"}
            }
        },
        linkback = "block_00031",
        linknext = "block_00033"
    },
    block_00033 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001031_2", ch = "yum"}
            },
            ja = {
                {"那双仿佛用烂泥捏出来的,粗笨的手。"}
            }
        },
        linkback = "block_00032",
        linknext = "block_00034"
    },
    block_00034 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001032", ch = "yum"}
            },
            ja = {
                {"那具被阴毛般的鬈毛包裹着的丑陋身体。"}
            }
        },
        linkback = "block_00033",
        linknext = "block_00035"
    },
    block_00035 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001033", ch = "yum"}
            },
            ja = {
                {"你们只要想象一下,被那种身体侵犯是什么滋味就好。"}
            }
        },
        linkback = "block_00034",
        linknext = "block_00036"
    },
    block_00036 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001034", ch = "yum"}
            },
            ja = {
                {"至少,我无法忍受那种东西。"}
            }
        },
        linkback = "block_00035",
        linknext = "block_00037"
    },
    block_00037 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001035", ch = "yum"}
            },
            ja = {
                {"被男子人拥抱,对我来说就是那么一回事。"}
            }
        },
        linkback = "block_00036",
        linknext = "block_00038"
    },
