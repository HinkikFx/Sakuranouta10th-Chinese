        linknext = "block_00051"
    },
    block_00051 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001048", ch = "yum"}
            },
            ja = {
                {
                    "冬日寒冷的天空下，　　　　　　　　　　　　　　　　　　　　",
                    {"rt2"},
                    "　纯白的大衣，纯白的毛球围巾，仰望着飘落雪花的天空的冰川同",
                    {"rt2"},
                    "学。"
                }
            }
        },
        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001049", ch = "yum"}
            },
            ja = {
                {
                    "冰川同学身上的白色衣服，漫反射着阳光，是不是在假装自己在发",
                    {"rt2"},
                    "光呢？　　　　　　　　　　　　　　　　　——我曾无意识地被这",
                    {"rt2"},
                    "种疑念所困扰。"
                }
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001050", ch = "yum"}
            },
            ja = {
                {
                    "正因那是无意识的，　　　我便不明所以地始终烦躁着，　　　　",
                    {"rt2"},
                    "　　　　　　　　　　　　　　　越发心安理得地厌恶着她。"
                }
            }
        },
        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"msgoff"},
        {"bg", file = "ev_uni_c52_06_shine", id = 6, lv = 6, time = 10000, path = ":cg/cg_ev_uni_c52/", set = "cg_ev_uni_c52"},
        {"bg", file = "ev_uni_c52_07_animal", id = 7, lv = 7, x = 0, speed = 5000, path = ":cg/cg_ev_uni_c52/", set = "cg_ev_uni_c52", x2 = -2000},
        {"bg", file = "ev_uni_c52_09_yuri", id = 9, lv = 9, y = 0, speed = 5000, path = ":cg/cg_ev_uni_c52/", set = "cg_ev_uni_c52", y2 = 800},
        {"ex", time = 5000, func = "wait"},
        {"cgact", file = ":cg/cg_ev_uni_c52/ev_uni_c52_07_animal", id = 7, lv = 7, act = "いいえ", loop = -1, time = 1500, size = 3, x = 0},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001051", ch = "yum"}
            },
            ja = {
                {"冰川同学总是置身于人群之中。"}
            }
        },
        linkback = "block_00053",
        linknext = "block_00055"
    },
    block_00055 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001052", ch = "yum"}
            },
            ja = {
                {
                    "尤其受女生们喜爱，　　仿佛混入成群草食动物之中的一只美丽飞",
                    {"rt2"},
                    "鸟。"
                }
            }
        },
        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001053", ch = "yum"}
            },
            ja = {
                {
                    "在草食动物的鸣叫声中，　　　　　　　　　　　　　　　　　　",
                    {"rt2"},
                    "　　美丽飞鸟的歌声一次又一次传入耳中。"
                }
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001054", ch = "yum"}
            },
            ja = {
                {"人是肮脏的生物，　　　喜爱美丽的事物，厌弃丑陋的东西。"}
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001055", ch = "yum"}
            },
            ja = {
                {
                    "所以，　　女生们喜爱冰川同学，　　　　　　　　　　　　　　",
                    {"rt2"},
                    "　　　　　大概也不过是那样单纯的理由吧。"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001056", ch = "yum"}
            },
            ja = {
                {
                    "不过后来我才听说，　　　　　　　冰川同学头脑也很好。　　　",
                    {"rt2"},
                    "　善于倾听别人的话，温柔体贴，　　　　待人接物也很温和。"
                }
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001057", ch = "yum"}
            },
            ja = {
                {"人品也很好。"}
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001058", ch = "yum"}
            },
            ja = {
                {
                    "可是，当时的我，　　　　　　　　　　　　　　　　　　　　　",
                    {"rt2"},
                    "　　　　　　冰川同学的人品之类的根本无所谓。"
                }
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001059", ch = "yum"}
            },
            ja = {
                {
                    "倒不如说，冰川同学就该是个精美的人偶，里面塞满了齿轮和发条",
                    {"rt2"},
                    "就好了。"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001060", ch = "yum"}
            },
            ja = {
                {
                    "她的心中，只有所谓空无一物的虚空，　　　　从外界接收到的信",
                    {"rt2"},
                    "息，由齿轮和发条机械地处理着就好了——我这样想着。"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001061", ch = "yum"}
            },
            ja = {
                {"冰川同学不需要心。"}
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001062", ch = "yum"}
            },
            ja = {
                {"她只要有美丽的外表和空洞的内在就够了。"}
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001063", ch = "yum"}
            },
            ja = {
                {
                    "人是肮脏的生物，　　　　　　　喜爱美丽的事物，　　　　　　",
