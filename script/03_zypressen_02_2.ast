        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001058", ch = "yum"}
            },
            ja = {
                {
                    "但对当时的我来说,　　　　　　　　　　　　　　　　　　　　　",
                    {"rt2"},
                    "　　　　　　冰川同学的人品什么的根本无关紧要。"
