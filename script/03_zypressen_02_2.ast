        linkback = "block_00009",
        linknext = "block_00011"
    },
    block_00011 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001012", ch = "yum"}
            },
            ja = {
                {
                    "就像肉食动物必然地吞噬弱小动物的肉一样，　　　　　　　　　",
                    {"rt2"},
                    "　　　　　　　　　　　　　　　我也爱上了同性。"
                }
            }
        },
        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001013", ch = "yum"}
            },
            ja = {
                {
                    {"txruby", text = "私"},
                    "她",
                    {"txruby"},
                    "的世界里，",
                    {"txruby", text = "男子を爱する"},
                    "吃草木",
                    {"txruby"},
                    "这种选择从一开始就不存在，　　　　　　　",
                    {"rt2"},
                    "　　　　　　　从美丽的",
                    {"txruby", text = "女の子"},
                    "瞪羚",
                    {"txruby"},
                    "群中，　　　　挑选最弱小、最可爱",
                    {"rt2"},
                    "的幼崽来",
                    {"txruby", text = "爱する"},
                    "吞食",
                    {"txruby"},
                    "，乃是不言自明之理。"
                }
            }
        },
        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001014", ch = "yum"}
            },
            ja = {
                {
                    "这就是我，　　　　　　　　　　　　无需理由，　　　　　　　",
                    {"rt2"},
                    "　　　　　　　　　　　　　　　　从一开始就喜欢女孩子。"
