        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001108", ch = "yum"}
            },
            ja = {
                {"所以，才会想要重现相同的情境，再次获得那种快感吧。"}
