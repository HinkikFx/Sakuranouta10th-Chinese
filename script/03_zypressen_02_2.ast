        linkback = "block_00053",
        linknext = "block_00055"
    },
    block_00055 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001052", ch = "yum"}
            },
            ja = {
                {
                    "她尤其受女生喜爱,　　看上去,就像一只混入成群草食动物之中的",
                    {"rt2"},
                    "美丽的鸟。"
                }
            }
        },
        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001053", ch = "yum"}
            },
            ja = {
                {
                    "混杂在草食动物的鸣叫声里,　　　　　　　　　　　　　　　　　",
                    {"rt2"},
                    "　　　我无数次听见那美丽的鸟鸣。"
                }
            }
