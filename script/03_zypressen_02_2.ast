    },
    block_00050 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001047", ch = "yum"}
            },
            ja = {
                {
                    "夏日湛蓝的天空下,　　　　　　　撑着白色的阳伞,　　　　　　",
                    {"rt2"},
                    "　　　　　　　　　　　　身穿白色连衣裙伫立着的冰川同学。"
                }
            }
        },
        linkback = "block_00049",
        linknext = "block_00051"
    },
    block_00051 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001048", ch = "yum"}
            },
            ja = {
                {
                    "冬日的寒空下,　　　　　　　　　　　　　　　　　　　　　穿着",
                    {"rt2"},
                    "纯白的大衣,围着缀有纯白绒球的围巾,仰望着飘雪天空的冰川同学。"
                }
            }
        },
        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001049", ch = "yum"}
            },
            ja = {
                {
                    "冰川同学的白衣,将阳光漫反射开来,是不是就为了让自己看上去仿",
                    {"rt2"},
                    "佛在熠熠生辉？　　　　　　　　　　　　　　　　　当时的我,大",
                    {"rt2"},
                    "概正被这种无意识的疑念攫住了吧。"
                }
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001050", ch = "yum"}
            },
            ja = {
                {
                    "正因为那是无意识的,　　　我才会莫名其妙地,始终烦躁不安,　　",
                    {"rt2"},
                    "　　　　　　　　　　　　　　　　　得以越来越讨厌她。"
                }
            }
        },
        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"msgoff"},
