                {"vo", file = "fem_nur_000001", ch = "nur"}
            },
            ja = {
                {
                    name = {"护士"},
                    "「啊，那个，等一下，同学？」"
                }
            }
        },
        linkback = "block_00253",
        linknext = "block_00255"
    },
    block_00255 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯？」"
                }
            }
        },
        linkback = "block_00254",
        linknext = "block_00256"
    },
    block_00256 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_nur_000002", ch = "nur"}
            },
            ja = {
                {
                    name = {"护士"},
                    "「普通门诊已经结束了哦……急诊的话，入口在那边……」"
                }
            }
        },
        linkback = "block_00255",
        linknext = "block_00257"
    },
    block_00257 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊，不，我不是来看病，是来探望病人的……」"
                }
            }
        },
        linkback = "block_00256",
        linknext = "block_00258"
    },
    block_00258 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_nur_000003", ch = "nur"}
            },
            ja = {
                {
                    name = {"护士"},
                    "「是家属吗？」"
                }
            }
        },
        linkback = "block_00257",
        linknext = "block_00259"
    },
    block_00259 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不……不是家属……」"
                }
            }
        },
        linkback = "block_00258",
        linknext = "block_00260"
    },
    block_00260 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_nur_000004", ch = "nur"}
            },
            ja = {
                {
                    name = {"护士"},
                    "「不好意思哦。原则上，家属以外的探视时间已经结束了。你得再",
                    {"rt2"},
                    "来早一点才行……」"
                }
            }
        },
        linkback = "block_00259",
        linknext = "block_00261"
    },
    block_00261 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这么说来，这种地方，探视时间会因为是不是家属而有限制来着",
                    {"rt2"},
                    "……」"
                }
            }
        },
        linkback = "block_00260",
        linknext = "block_00262"
    },
    block_00262 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_nur_000005", ch = "nur"}
            },
            ja = {
                {
                    name = {"护士"},
                    "「嗯，不好意思哦。还有，可以的话最好事先预约。突然来的话，",
                    {"rt2"},
                    "经常会见不到人的」"
                }
            }
        },
        linkback = "block_00261",
        linknext = "block_00263"
    },
    block_00263 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「好的，我明白。是因为病人有时会去做检查之类而不在，对吧？」"
                }
            }
        },
        linkback = "block_00262",
        linknext = "block_00264"
    },
    block_00264 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_nur_000006", ch = "nur"}
            },
            ja = {
                {
                    name = {"护士"},
                    "「是啊。你很懂嘛。那么，你今天是来探望哪一位的呢？」"
                }
            }
        },
        linkback = "block_00263",
        linknext = "block_00265"
    },
    block_00265 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「旧病房楼402号房，一位叫正田明的人……」"
                }
            }
        },
        linkback = "block_00264",
        linknext = "block_00266"
    },
    block_00266 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_nur_000007", ch = "nur"}
            },
            ja = {
                {
                    name = {"护士"},
                    "「啊，正田先生啊。那你得在明天之内把探视办妥才行……原来如",
                    {"rt2"},
                    "此，所以你才急着赶来的呀」"
                }
            }
        },
        linkback = "block_00265",
        linknext = "block_00267"
    },
    block_00267 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这是什么意思？」"
                }
            }
        },
        linkback = "block_00266",
        linknext = "block_00268"
    },
    block_00268 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_nur_000008", ch = "nur"}
            },
            ja = {
                {
                    name = {"护士"},
                    "「哎呀？你不知道吗？402号房的正田先生，后天有一场大手术哦。",
                    {"rt2"},
                    "你不是因为这个才急着今天赶来的吗？」"
                }
            }
        },
        linkback = "block_00267",
        linknext = "block_00269"
    },
    block_00269 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「后天？」"
                }
            }
        },
        linkback = "block_00268",
        linknext = "block_00270"
    },
    block_00270 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_nur_000009", ch = "nur"}
            },
            ja = {
                {
                    name = {"护士"},
                    "「是啊。后天有手术。要探望的话，最好赶在那之前。绝对」"
                }
            }
        },
        linkback = "block_00269",
        linknext = "block_00271"
    },
    block_00271 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「正田神父的病情怎么样？」"
                }
            }
        },
        linkback = "block_00270",
        linknext = "block_00272"
    },
    block_00272 = {
        {"text"},
        text = {
