                {"vo", file = "fem_nur_000010", ch = "nur"}
            },
            ja = {
                {
                    name = {"护士"},
                    "「怎么样……你问我，我也不好回答……。总之，我能说的，也就只",
                    {"rt2"},
                    "有后天要进行一场大手术这一点了……」"
