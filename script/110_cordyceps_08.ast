    },
    block_00142 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003505", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「因为小鸡○也超舒服的嘛。不过呀，让优美舔那个部位，是我早",
