    },
    block_00211 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900437", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「最后，想让你让我舒服个够，就算我会死在下一次射精里也没关",
                    {"rt2"},
                    "系。不如说要是会死，就绝对不要停下来……我要，射在里奈的嘴",
                    {"rt2"},
                    "里……在里奈的身体里，留下我的种子……」"
                }
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"mwact", act = "うなづく", size = 5, time = 200},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003543", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嘻嘻，优美不会死的哦。只会变得舒服而已……啾噜、啾、啾噜",
                    {"rt2"},
                    "噜、啾噜――、来，去吧。我可爱的优美」"
                }
