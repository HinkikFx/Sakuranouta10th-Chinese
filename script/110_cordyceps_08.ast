        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900410", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「安心？　不是舒服吗？」"
