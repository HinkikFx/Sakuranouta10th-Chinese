        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900435", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「啊、总觉得，你这么一说……嗯啊、我、下一次、射精，好像就",
                    {"rt2"},
                    "会死掉……嗯咕」"
                }
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"mwact", act = "うんうん", size = 5, time = 150},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003541", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嘻嘻，说不定真的会死哦？　这可是我种下的诅咒，最后也许会",
                    {"rt2"},
                    "置宿主于死地」"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
