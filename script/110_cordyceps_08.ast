        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003539", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那就，射进我的嘴里，我想记住，优美精液的味道」"
                }
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003540", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「川内野优美这个女孩子最后一次射出的精液的味道，我不会忘记",
                    {"rt2"},
                    "――啾噜――啾、啾噜、啾噜――」"
                }
            }
