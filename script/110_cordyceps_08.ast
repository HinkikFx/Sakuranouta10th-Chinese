        text = {
            vo = {
                {"vo", file = "fem_rna_003525", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「原来如此啊。这样吗……、不过连优美也有这种想象，真意外」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900427", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「什么样的想象？」"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003526", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「就是说冬虫夏草像寄生的小鸡鸡那回事」"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003527", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我呀。第一次在图鉴上看到冬虫夏草的时候，就觉得那看起来像",
                    {"rt2"},
                    "被巨大的小鸡鸡寄生的蛹哦」"
                }
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900428", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「诶？　在图鉴上？　大概是什么时候的事？」"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003528", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「差不多是和优美相遇的那阵子吧」"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900429", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「该说是早熟的小鬼呢……还是色色的幼女呢……」"
                }
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003529", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我从小就是那种女人哦」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003530", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我当时用小孩子的脑袋想过。要是这种东西寄生到人身上，会变",
                    {"rt2"},
                    "成什么样呢？」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003531", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「既然那是小鸡鸡，我便想象，那是吸食人内心欲望而巨大化的冬",
                    {"rt2"},
                    "虫夏草」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003532", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「为了吐出内心的欲望而寄生的器官」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003533", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「就像浴缸上装了个水龙头一样。一拧开，积在里面的东西就会源",
                    {"rt2"},
                    "源不断地流出来的感觉」"
                }
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900430", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「寄生的小鸡鸡吗……总觉得它只会寄生在女孩子身上」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003534", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「没错哦。只寄生在女孩子身上的，才是我想象中的冬虫夏草」"
                }
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003535", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「正因为只寄生于女孩子，冬虫夏草才有价值」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900431", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「里奈设想的冬虫夏草，为什么不寄生在男子人身上？」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003536", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「因为呀，男子人不会因为射精而死吧？那样可不行。这根危险的",
                    {"rt2"},
                    "小鸡鸡，会让宿主一直射精，直到死掉为止」"
                }
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900432", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「真是毁灭性十足的小鸡○」"
                }
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"bg", file = "ev_app_h06_03", path = ":ev/ev_app_h06/", set = "ev_app_h06"},
        {"mwact", act = "うなづく", size = 5, time = 300},
        {"text"},
        text = {
