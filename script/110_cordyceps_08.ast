                {"vo", file = "fem_rna_003525", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「原来如此。是吗……但是优美居然也有那种意象，还挺出乎意料",
                    {"rt2"},
                    "的」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900427", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「什么样的意象？」"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003526", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「冬虫夏草像寄生小鸡鸡一样的想法」"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003527", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我啊。第一次在图鉴上看到冬虫夏草的时候，觉得那是被大大的",
                    {"rt2"},
                    "小鸡鸡寄生了的蛹」"
                }
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900428", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「欸？　在图鉴上？　大概是什么时候的事？」"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003528", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「大概是跟优美认识的时候吧」"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900429", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「早熟的小鬼头……或者说好涩的萝莉……」"
                }
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003529", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我从小就是那样的女人呢」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003530", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「用小孩子的脑袋想过。如果这种东西寄生在人身上会怎样呢？」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003531", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那是小鸡鸡，所以我想象的是一种吸取人类内在欲望而巨大化的",
                    {"rt2"},
                    "冬虫夏草」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003532", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「为了将内在欲望倾泻出来而寄生的器官」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003533", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「就像水龙头被装在浴缸上一样。一拧的话里面积蓄的东西就会源",
                    {"rt2"},
                    "源不断地流出来」"
                }
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900430", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「寄生的小鸡鸡吗……总觉得只会寄生在女孩子身上」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003534", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「没错。只有寄生在女孩子身上的才是我想象的冬虫夏草」"
                }
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
