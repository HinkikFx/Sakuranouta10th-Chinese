    },
    block_00140 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003504", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「啊、好厉害……优美嘴唇的触感，好热，好软，黏糊糊的……嗯啊",
