        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"text"},
        text = {
            ja = {
                {
                    "厚挂的白釉呈现出皎洁的月面；从薄挂的半透明釉层之下浮现出纹",
                    {"rt2"},
                    "样的灰色部分，与被称作梅花皮的、因釉面收缩而裸露出来的黑色",
                    {"rt2"},
                    "部分，构成绝妙的浓淡，织出月亮的阴影。"
                }
            }
        },
        linkback = "block_00148",
        linknext = "block_00150"
    },
    block_00150 = {
        {"text"},
        text = {
            ja = {
                {"天上月亮的阴影，化作玉兔浮现。"}
