    block_00159 = {
        {"se", file = "se9012", vol = 30, id = 1},
        {"text"},
        text = {
            ja = {
                {"鸟谷像是害怕着什么似的，缓缓向前走去。"}
            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"se", stop = 1, time = 500, id = 1},
        {"text"},
        text = {
            ja = {
                {
                    "以鸟谷诞下的月亮为中心，散落着无数画布。那数不清的画布上描",
                    {"rt2"},
                    "绘着的画。"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
            ja = {
                {"那是圭画的画。鸟谷把那些画布，一幅一幅地确认过去。"}
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"text"},
        text = {
            ja = {
                {"越过无数画布之海、终于抵达的鸟谷，瘫坐在了那里。"}
            }
        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            ja = {
                {"在月亮雕塑的深处，圭蜷缩着身子睡着了。"}
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"text"},
        text = {
            ja = {
                {"呼吸平稳的圭的手中，还握着画笔。身旁散落着调色盘和颜料。"}
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"text"},
        text = {
            ja = {
                {"鸟谷拿起了滚落在圭身边最近处的一块画布。"}
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            ja = {
                {
                    "那是一幅从蛋中诞生、正欲振翅高飞的鸟的画。那鸟看上去也像喜",
                    {"rt2"},
                    "鹊。"
                }
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"text"},
        text = {
            ja = {
                {"画到中途，笔便停下了。"}
