                    "求，他反倒是欣然应允。"
                }
            }
        },
        linkback = "block_00049",
        linknext = "block_00051"
    },
    block_00051 = {
        {"text"},
        text = {
            ja = {
                {
                    "鸟谷几乎不眠不休地推进制陶，才走到了这一步。力气活则尽量由",
                    {"rt2"},
                    "我承担。"
                }
            }
        },
        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"text"},
        text = {
            ja = {
                {
                    "在预先处理成可施釉状态的陶土雕塑上，用鬼板大面积施以相当复",
                    {"rt2"},
                    "杂的铁绘，再一边保留素坯、一边浇挂上浓度各异的白釉——这些工",
                    {"rt2"},
                    "序全部由鸟谷亲手完成。"
                }
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"text"},
        text = {
            ja = {
                {
                    "画铁绘纹样的过程我看到过，但那本是要经过挂上白釉后的烧成、",
                    {"rt2"},
                    "才第一次得以完成的彩绘，再加上她还做了蜡防处理，很难想象出",
                    {"rt2"},
                    "完成后的模样。"
                }
            }
        },
        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"text"},
        text = {
            ja = {
                {
                    "用采来的砂子调配的白釉，是做成鬼萩那样的稻草灰釉，还是志野",
                    {"rt2"},
                    "那样单一成分的釉药，她似乎苦恼了许久，最终定为接近后者的配",
                    {"rt2"},
                    "方。"
                }
            }
        },
        linkback = "block_00053",
        linknext = "block_00055"
    },
    block_00055 = {
        {"text"},
        text = {
            ja = {
                {
                    "那是上次制作『四颗星』的时候，在试片上尝试过的种种釉药配比",
                    {"rt2"},
                    "――凭着那份经验，她选定了对这次的雕塑陶而言最为合适的白釉。"
                }
            }
        },
        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"text"},
        text = {
            ja = {
                {"如今在登窑中烧制的雕塑陶最终会是什么模样，我也无从知晓。"}
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"text"},
        text = {
            ja = {
                {
                    "但可以肯定的是，无论从哪个意义上说，它都将是鸟谷至今为止的",
                    {"rt2"},
                    "集大成之作。"
                }
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"bg", file = "ev_com_b01_03", path = ":ev/ev_com_b01/", set = "ev_com_b01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003768", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「剩下的就是徐冷之后出窑了……不过说实话，在打开窑口之前，",
                    {"rt2"},
                    "一切都还说不准呢」"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「没有自信吗？」"
                }
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"bg", file = "ev_com_b01_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_b01/", set = "ev_com_b01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003769", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「怎么可能。不过，你也知道吧，登窑有多难」"
                }
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「算是吧」"
                }
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            ja = {
                {"想用登窑烧出称心如意的结果，偶然因素实在太多。"}
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"text"},
        text = {
            ja = {
                {
                    "不只是火候，还有当时的天气和风力、柴薪的状态、湿度与温度、",
                    {"rt2"},
                    "飘落的灰、火焰的流向——窑内的一切条件都会左右结果。"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            ja = {
                {"但也正因如此，有时会诞生出令人惊叹的杰作。"}
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"text"},
        text = {
            ja = {
                {"陶瓷，是穿过登窑这个小宇宙而诞生的艺术品。"}
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            ja = {
                {
                    "正因如此才难，也正因如此才有趣。为之着迷的人如此之多，也就",
                    {"rt2"},
                    "不难理解了。"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
