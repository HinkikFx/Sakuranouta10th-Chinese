        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001832", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「神社和学校同时建造?」"
                }
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「详细的我也不清楚,据说很久很久以前,这座山丘本身就是一座神",
                    {"rt2"},
                    "社。不过早在这所学校建成之前很久,它就已经荒废朽坏了」"
                }
            }
        },
        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0008", head = "rin_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001833", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「那么这算是重建了……」"
                }
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            ja = {
                {"禀一脸不可思议地凝视着这座摄社。"}
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「……」"
                }
            }
