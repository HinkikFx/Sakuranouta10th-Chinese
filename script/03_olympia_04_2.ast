            }
        },
        text = {
            vo = {
                {"vo", file = "fem_rnd_001852", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「哦，原来是这样。你刚才说很久以前，大概是多久以前这里就有",
