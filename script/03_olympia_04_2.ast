        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，一般人都会这么想。说到宝船就会想到七福神嘛。不过你仔",
                    {"rt2"},
                    "细看看。那艘船上有七福神吗？」"
