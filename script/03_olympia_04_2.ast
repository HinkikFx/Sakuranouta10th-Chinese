        linkback = "block_00148",
        linknext = "block_00150"
    },
    block_00150 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001839", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「这么说来船上只有宝物，一个人都没有。还有，这幅画卷上好像",
                    {"rt2"},
                    "写着什么……」"
                }
            }
        },
        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「なかきよの とおのねふりの みなめさめ なみのりふねの",
                    {"rt2"},
                    "おとのよきかな」"
                }
            }
        },
        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001840", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「啊，那个我听说过。好像是……有名的回文对吧」"
