        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我说,禀」"
                }
            }
        },
        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0012", head = "rin_z1a", lv = 4, id = 9},
        {"fgact", ch = "稟", act = "びっくり", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001834", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「嗯?怎么了吗?」"
                }
            }
        },
        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,没什么,说个无聊的话题,你知道这座神社供奉的是什么吗?」"
                }
            }
        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0009", head = "rin_z1a", lv = 4, id = 9},
        {"fgact", ch = "稟", act = "いいえ", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0008", head = "rin_z1a", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_rnd_001835", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「不,不知道。或者说,我今天才第一次知道这里有座神社」"
                }
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是吗。也是啊……」"
                }
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0012", head = "rin_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001836", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「这里供奉的是什么呢?」"
                }
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「看看神社里面吧」"
                }
            }
        },
        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", y = -250, file = "zbg063b", path = ":bg/", ax = 1920, ay = 1080, bx = -960, by = -540, sync = 0},
        {"bg", lv = 1, id = 5, rule = "cinema", file = "cinema01", alpha = 255, time = 400, path = ":sys/", vague = 40, sync = 0},
        {"extrans", time = 500},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001837", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「那个……哇,里面供奉着一幅很大的画卷。上面画着一艘船呢……」"
                }
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那是宝船哦」"
                }
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001838", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「宝船的话,供奉的是七福神中的哪一位吗?」"
                }
            }
        },
        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是啊。一般都会这么想。毕竟说到宝船,和七福神几乎就是一套的",
                    {"rt2"},
                    "嘛。不过你仔细看看,那艘船上有七福神吗?」"
                }
            }
        },
        linkback = "block_00148",
        linknext = "block_00150"
    },
    block_00150 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001839", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「这么一说,船上只载着宝物,谁都没有乘坐呢。还有,这幅画卷上好",
                    {"rt2"},
                    "像写着什么……」"
                }
            }
        },
        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「长夜漫漫眠意远,众人皆自梦中醒,乘波宝船涛声悦」"
                }
            }
        },
        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001840", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「啊,这个我听说过。好像是……很有名的回文歌吧」"
                }
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是啊。正着读和倒着读都一样的回文」"
                }
            }
        },
        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001841", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「为什么它会在这里?」"
                }
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"cgdel", lv = 1, id = 5, rule = "cinema", time = 400},
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", file = "bg063b", path = ":bg/", sync = 0},
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0012", head = "rin_z1a", lv = 4, id = 9, sync = 0},
        {"extrans", time = 500},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「换个话题,你看到宝船的帆上写着字了吗?」"
                }
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0009", head = "rin_z1a", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0008", head = "rin_z1a", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_rnd_001842", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「帆吗?帆上确实用很大的字写着『貘』」"
                }
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「没错,写着『貘』」"
                }
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「回到刚才的问题,那首回文歌咏唱的是『梦』」"
                }
            }
        },
        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「相传在正月初二,把这幅貘之宝船的画和回文歌放在枕头下面睡觉",
                    {"rt2"},
                    ",就能做一个吉利的初梦」"
                }
            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「写着貘字的宝船。咏唱梦的回文。所以说,这里是供奉梦之神明的",
                    {"rt2"},
                    "神社」"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0012", head = "rin_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001843", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「啊,这么说来,弓张学园正门前的那条坡道,好像就叫",
                    {"txruby", text = "梦浮坂"},
                    "梦浮坂",
                    {"txruby"},
                    "来着」"
                }
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「据说最初,通往这座山丘的所有道路都被称作梦浮坂」"
                }
            }
        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0013", head = "rin_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001844", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「是这样吗?」"
                }
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「再进一步说,弓张学园之名的『弓张』,原本据说是『梦张』。梦",
                    {"rt2"},
                    "张的读音讹变成了弓张,这是最普遍的说法」"
                }
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0002", head = "rin_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001845", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「那么这座学园,这座山丘本身,全都是和梦有关的东西呢」"
                }
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「可以这么说」"
                }
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「至于刚才那个问题的答案,这座神社供奉的神,据说叫做",
                    {"txruby", text = "bó qí"},
                    "伯奇",
                    {"txruby"},
                    "」"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0012", head = "rin_z1a", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0009", head = "rin_z1a", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_rnd_001846", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「伯奇吗?从没听说过的神明呢」"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯,据说伯奇是中国的神明,在日本这个名字并不为人所知」"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「话虽如此,也并非完全没有传入日本。只要知道伯奇是司掌什么的",
                    {"rt2"},
                    "神,就能明白它是以何种形式流传过来的」"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0012", head = "rin_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001847", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「难道说,伯奇这位神明是吃梦的?」"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,正是如此,据说是吞噬梦的神明」"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0003", head = "rin_z1a", lv = 4, id = 9},
        {"fgact", ch = "稟", act = "うなづく", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0002", head = "rin_z1a", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_rnd_001848", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「原来如此,在日本的话那就是貘了。也就是说,中国的伯奇传到日",
                    {"rt2"},
                    "本后变成了貘,是这样吧」"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「确实,有一种说法是,伯奇在传承中出了差错,日本才有了貘食梦的",
                    {"rt2"},
                    "说法」"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0012", head = "rin_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001849", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「只是一种说法吗?」"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯,还有别的说法。原本在中国被称作貘的幻兽并不食梦,据说主",
                    {"rt2"},
                    "要以铜、铁、蛇为食」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0008", head = "rin_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001850", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「吃的东西完全不一样呢」"
                }
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不过,中国有一种传说,用貘皮做的坐垫和被褥睡觉,可以避除湿病",
                    {"rt2"},
                    "恶气。也有一说认为,这个传到日本时变成了『食梦』」"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0012", head = "rin_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001851", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「供奉中国的神明伯奇,这不是很罕见的事吗?」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,大概吧。不过,这座原本供奉伯奇的神社,在漫长的历史中,伯奇",
                    {"rt2"},
                    "神也逐渐与貘被视为一体。也就是说,如今它已经成了供奉貘的神社」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            ja = {
                {
