    block_00013 = {
        {"bg", file = "ev_com_j09_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_j09/", set = "ev_com_j09"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「呼……。果然，你早就知道那不是健一郎的作品啊」"
