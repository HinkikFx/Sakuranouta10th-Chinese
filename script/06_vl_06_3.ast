    },
    block_00015 = {
        {"bg", file = "ev_com_j09_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_j09/", set = "ev_com_j09"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此，那我更得感谢你了，毕竟又让你陪我演了一出拙劣的",
