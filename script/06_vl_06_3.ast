        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_frd_000389", ch = "frd"}
            },
            ja = {
                {
                    name = {"弗里曼"},
                    "「当然。我可是健一郎的财产管理员。就连那份设计图，我手头也",
