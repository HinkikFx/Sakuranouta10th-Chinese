            vo = {
                {"vo", file = "fem_yum_001693", ch = "yum"}
            },
            ja = {
                {"可结果就是你们看到的这副样子。"}
            }
        },
        linkback = "block_00230",
        linknext = "block_00232"
    },
    block_00232 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001694", ch = "yum"}
            },
            ja = {
                {"遭殃的是我，而他为了保护我，闹出了伤人事件。"}
            }
        },
        linkback = "block_00231",
        linknext = "block_00233"
    },
    block_00233 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001695", ch = "yum"}
            },
            ja = {
                {"竟然有人会喜欢上我这种家伙。"}
            }
        },
        linkback = "block_00232",
        linknext = "block_00234"
    },
    block_00234 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001696", ch = "yum"}
            },
            ja = {
                {"这实在是很对不住他，但唯独这件事无可奈何。"}
            }
        },
        linkback = "block_00233",
        linknext = "block_00235"
    },
    block_00235 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001697", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「会有更好的人的。把我这种家伙忘了吧」"
                }
            }
        },
        linkback = "block_00234",
        linknext = "block_00236"
    },
    block_00236 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_okz_000010", ch = "okz"}
            },
            ja = {
                {
                    name = {"丘泽"},
                    "「才不是。哪有比你更好的家伙啊」"
                }
            }
        },
        linkback = "block_00235",
        linknext = "block_00237"
    },
    block_00237 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001698", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我不知道。不过，我们永远是朋友」"
                }
            }
        },
        linkback = "block_00236",
        linknext = "block_00238"
    },
    block_00238 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001699", ch = "yum"}
            },
            ja = {
                {"少年垂下肩膀，只是小声地念叨着「可恶」「可恶」。"}
            }
        },
        linkback = "block_00237",
        linknext = "block_00239"
    },
    block_00239 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001700", ch = "yum"}
            },
            ja = {
                {"结局怎样，恐怕他从一开始就知道吧。"}
            }
        },
        linkback = "block_00238",
        linknext = "block_00240"
    },
    block_00240 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001701", ch = "yum"}
            },
            ja = {
                {"就算知道结局，人还是会爱上人。"}
            }
        },
        linkback = "block_00239",
        linknext = "block_00241"
    },
    block_00241 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001702", ch = "yum"}
            },
            ja = {
                {"哪怕是无法成就的恋情，喜欢上一个人的心情也无法阻止。"}
            }
        },
        linkback = "block_00240",
        linknext = "block_00242"
    },
    block_00242 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001703", ch = "yum"}
            },
            ja = {
                {"这一点我再清楚不过。"}
            }
        },
        linkback = "block_00241",
        linknext = "block_00243"
    },
    block_00243 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001704", ch = "yum"}
            },
            ja = {
                {"我的身后传来声音。"}
            }
        },
        linkback = "block_00242",
        linknext = "block_00244"
    },
    block_00244 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001705", ch = "yum"}
            },
            ja = {
                {"一个少女像是要逃离层层人群似的奔跑而来。"}
            }
        },
        linkback = "block_00243",
        linknext = "block_00245"
    },
    block_00245 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001510", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「优美！　回家啦！　回去路上买点东西边走边吃吧」"
                }
            }
        },
        linkback = "block_00244",
        linknext = "block_00246"
    },
    block_00246 = {
