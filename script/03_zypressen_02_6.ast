    },
    block_00080 = {
        {"fg", ch = "直哉", size = "z1", mode = 3, path = ":fg/nao/z1/", file = "nao_z1i0000", face = "i0003", head = "nao_z1i", x = 345, lv = 4, id = 9},
        {"fgact", ch = "直哉", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是吗，不管怎么说都是幅好画。说实话，我甚至觉得自己差点被",
                    {"rt2"},
                    "你的画吞没」"
                }
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"fg", ch = "里奈", size = "z1", mode = 3, path = ":fg/rna/z1/", file = "rna_z1i0000", face = "i0012", head = "rna_z1i", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001494", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是吗？　我完全没有那种感觉……。只觉得你笔直地朝着应当表",
                    {"rt2"},
                    "现的东西，毫不动摇地前进」"
                }
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
    block_00082 = {
        {"fg", ch = "直哉", size = "z1", mode = 3, path = ":fg/nao/z1/", file = "nao_z1i0000", face = "i0002", head = "nao_z1i", x = 345, lv = 4, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那是因为啊。所谓作家，就是要摆出那副样子给人看的。就算迷",
                    {"rt2"},
                    "茫，也要装作不迷茫」"
                }
            }
        },
        linkback = "block_00081",
        linknext = "block_00083"
    },
    block_00083 = {
        {"fg", ch = "直哉", size = "z1", mode = 3, path = ":fg/nao/z1/", file = "nao_z1i0000", face = "i0001", head = "nao_z1i", x = 345, lv = 4, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「哪怕其实是画不出来的水平……也丝毫不露怯地把画画完」"
                }
            }
        },
        linkback = "block_00082",
        linknext = "block_00084"
    },
    block_00084 = {
        {"fg", ch = "直哉", size = "z1", mode = 3, path = ":fg/nao/z1/", file = "nao_z1i0000", face = "i0003", head = "nao_z1i", x = 345, lv = 4, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「一路狂奔。强而有力，总之相信自己的表现一路狂奔。这就是所",
