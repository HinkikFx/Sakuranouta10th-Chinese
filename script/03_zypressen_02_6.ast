        linkback = "block_00242",
        linknext = "block_00244"
    },
    block_00244 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001705", ch = "yum"}
            },
            ja = {
                {"一个从人群中逃脱般奔跑而来的少女的身影。"}
