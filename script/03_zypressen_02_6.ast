        },
        linkback = "block_00232",
        linknext = "block_00234"
    },
    block_00234 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001696", ch = "yum"}
            },
            ja = {
                {"这件事真的让我很抱歉，但这实在是没办法。"}
            }
        },
        linkback = "block_00233",
        linknext = "block_00235"
    },
    block_00235 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001697", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「会遇到更好的人的。忘了我吧」"
                }
            }
        },
        linkback = "block_00234",
        linknext = "block_00236"
    },
    block_00236 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_okz_000010", ch = "okz"}
            },
            ja = {
                {
                    name = {"丘泽"},
                    "「才不是。还有谁比你更好的啊」"
                }
            }
        },
        linkback = "block_00235",
        linknext = "block_00237"
    },
    block_00237 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001698", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我不知道。但是，你永远是我的朋友」"
                }
            }
        },
        linkback = "block_00236",
        linknext = "block_00238"
    },
    block_00238 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001699", ch = "yum"}
            },
            ja = {
                {"少年垂下了肩膀，只是在小声重复着「可恶」「可恶」。"}
            }
        },
        linkback = "block_00237",
        linknext = "block_00239"
    },
    block_00239 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001700", ch = "yum"}
            },
            ja = {
                {"结局从一开始就知道了吧。"}
            }
        },
        linkback = "block_00238",
        linknext = "block_00240"
    },
    block_00240 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001701", ch = "yum"}
            },
            ja = {
                {"即使知道结局，人还是会爱上人。"}
            }
        },
        linkback = "block_00239",
        linknext = "block_00241"
    },
    block_00241 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001702", ch = "yum"}
            },
            ja = {
                {"即使是注定无法实现的恋情，喜欢的心情也是无法阻止的。"}
            }
        },
        linkback = "block_00240",
        linknext = "block_00242"
    },
    block_00242 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001703", ch = "yum"}
            },
            ja = {
                {"这一点我也深有体会。"}
