                {"vo", file = "fem_yum_001707", ch = "yum"}
            },
            ja = {
                {"我总觉得里奈周围的女生们在说，独占里奈太狡猾了。"}
            }
        },
        linkback = "block_00246",
        linknext = "block_00248"
    },
    block_00248 = {
