        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002742", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我这么拼命，不是为了草薙，而是为了我自己……是我自己想看」"
