    block_00152 = {
        {"bg", sync = 0, face = 1, file = "ev_app_h03_08", time = 400, path = ":ev/ev_app_h03/", set = "ev_app_h03"},
        {"text"},
        text = {
            ja = {
                {
                    "对我的呼唤，里奈毫无反应。只是不停地抚摸着那块立在那里的画",
