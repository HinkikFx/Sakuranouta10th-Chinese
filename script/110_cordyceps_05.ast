    block_00154 = {
        {"text"},
        text = {
            ja = {
                {"里奈抬头看了看画布靠着的建筑上方。"}
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            ja = {
                {"门上的塑料雨篷上写着『Olympia』。"}
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003255", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「这家杂货店……应该现在挂着『人偶之馆",
                    {"rt2"},
                    "奥林匹亚』的招牌才对……」"
                }
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            ja = {
                {"里奈看着画布所在的店嘟囔着。怎么想现在都不是关心这个的时候。"}
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"mwact", act = "びっくり", size = 5, time = 200},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900257", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「里奈。快逃吧。真的会被警察抓走的」"
                }
            }
        },
        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003256", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我小时候记得这家店确实是用塑料雨篷写着『Olympia』的。但因",
                    {"rt2"},
                    "为老化严重，经过几次台风塑料篷破了，几年前换成了现在的木头",
                    {"rt2"},
                    "招牌才对……」"
                }
            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003257", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「也就是说，这个景色是过去的……那究竟是什么时候的樱之原商",
                    {"rt2"},
                    "店街？」"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
            ja = {
                {"里奈环顾着樱之原商店街。"}
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003258", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不管怎样，已经不是由伯奇之梦支配的世界了。伯奇之梦大概只",
                    {"rt2"},
                    "是充当了连接某个世界的通道」"
                }
            }
        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003259", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「虽然这里确实是梦境……但也是优美的意识和我的意识交汇的世",
                    {"rt2"},
                    "界……也就是说这个世界本应由我们两人的心象风景所构成才对……」"
                }
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003260", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「然而，这个世界却明显被我不认识的、不同的心象风景所塑造」"
                }
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"mwact", act = "びっくり", size = 5, time = 200},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900258", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「什么意思？　这不是伯奇传说中的力量与我们的思念共鸣而产生",
                    {"rt2"},
                    "的吗？」"
                }
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003261", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「也许，只是直觉而已。伯奇她们的思念，千年樱的梦，已经被其",
                    {"rt2"},
                    "他什么人的强烈思念所覆盖了吧」"
                }
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003262", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「更强大的力量，覆盖了一切」"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900259", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「跨越千年的传承中伯奇的思念，被什么人覆盖了？」"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
