    },
    block_00154 = {
        {"text"},
        text = {
            ja = {
                {"里奈抬头看向画布倚靠着的建筑物上方。"}
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            ja = {
                {"门上方的塑料雨棚上写着『Olympia』。"}
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003255", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「这家杂货店……我记得现在挂的应该是『人偶之馆奥兰比亚』的",
                    {"rt2"},
                    "招牌才对……」"
                }
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            ja = {
                {
                    "里奈望着画布倚靠着的那家店，嘟嘟囔囔地自言自语。怎么想，这",
                    {"rt2"},
                    "都不是现在该在意的事。"
                }
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"mwact", act = "びっくり", size = 5, time = 200},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900257", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「里奈。快逃吧。真的会被警察抓走的哦」"
                }
            }
        },
        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003256", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我记得小时候，这家店确实是塑料雨棚，上面写着『Olympia』。",
                    {"rt2"},
                    "可是因为老化得厉害，几次台风把棚子刮破了，几年前就换成了现",
                    {"rt2"},
                    "在那块木招牌才对……」"
                }
            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003257", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「也就是说，这片风景是过去的……那么这到底是什么时候的樱之",
                    {"rt2"},
                    "原商店街？」"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
            ja = {
                {"里奈环视着樱之原商店街。"}
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003258", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不管怎样，这里已经不是伯奇的梦所支配的世界了。伯奇的梦，",
                    {"rt2"},
                    "大概只不过成了连接某个世界的通道」"
                }
            }
        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003259", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「这里确实是梦……但同时也是优美的意识与我的意识交汇而成的",
                    {"rt2"},
                    "世界……也就是说，这个世界本应由我们两人的心象风景构筑而成…",
                    {"rt2"},
                    "…」"
                }
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003260", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「尽管如此，这个世界却明摆着是由我所不了解的、另一种心象风",
                    {"rt2"},
                    "景塑造出来的」"
                }
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"mwact", act = "びっくり", size = 5, time = 200},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900258", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「什么意思？　这不是伯奇传承里所讲的力量，与我们的思念产生",
                    {"rt2"},
                    "共鸣的结果吗？」"
                }
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003261", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「这大概只是直觉。伯奇们的思念、千年樱的梦，恐怕早已被其他",
                    {"rt2"},
                    "某人强烈的思念覆写了」"
                }
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003262", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「一股更强大的力量，把一切都覆写了」"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900259", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「你是说，有人把千年前的传承里出现的伯奇的思念，给覆写掉了？",
                    {"rt2"},
                    "」"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003263", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「现在我能明白的，只有这是一个由无比惊人的想象力所创造出的",
                    {"rt2"},
                    "具现化世界这件事……」"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003264", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「而在这样的世界里，我找到的，只有这块纯白的画布……」"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900260", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「能覆写伯奇诅咒的强烈思念……伯奇不是被供奉在神社里、像神",
                    {"rt2"},
                    "明一样的存在吗？　能做到那种事，岂不是比神明还了不起的存在？",
                    {"rt2"},
                    "」"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003265", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那我不知道。我知道的是，误入这个世界的我们，只不过是形同",
                    {"rt2"},
                    "异邦人的存在……」"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003266", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「即便如此……仿佛要在这个世界钉下楔子一般，这块白色画布，",
                    {"rt2"},
                    "为了我，伫立在这里……」"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003267", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「意思是，对这个世界而言，我的思念只有这块一百号画布的尺寸",
                    {"rt2"},
                    "那么大。这么一想，还真是让人火大啊」"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            ja = {
                {"里奈看上去在生气。"}
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003268", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「可是，在那般压倒性的力量面前，这块画布，预感着自己将被描",
                    {"rt2"},
                    "绘，伫立在这里」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003269", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「当然，仅凭我的想象力，是无法超越这个梦与幻影的世界的极限",
                    {"rt2"},
                    "的，这种预感我也感觉得到……」"
                }
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003270", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我的能力和想象力都还不够，即便如此――不」"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003271", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「所以，大概，这里才不只有我，还有优美在」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003272", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「对。至少，是我的思念让事情变成了这样」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003273", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我的绘画，需要傲慢到近乎绝对的爱」"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"excall", file = "110_cordyceps_06"},
        {"text"},
        linkback = "block_00181"
    },
    label = {
        top = {block = "block_00000", label = 1}
    }
}
