            },
            ja = {
                {
                    name = {"里奈"},
                    "「现在我能理解的是，这是一个由极其强大的想象力所创造出的具",
                    {"rt2"},
                    "现化的世界……」"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003264", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「在这样的世界中，我找到的只有这块纯白的画布……」"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900260", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「能覆盖伯奇诅咒的强大思念……伯奇可是在神社里被供奉的类似",
                    {"rt2"},
                    "于神明的存在吧？　能做到那种事的，不就是比神明还厉害的存在",
                    {"rt2"},
                    "吗？」"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003265", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那个我不清楚。我能明白的是，迷失到这个世界里的我们，只不",
                    {"rt2"},
                    "过是类似于异乡人般的存在……」"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003266", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「即便如此……就像在这个世界钉上了楔子一样，为了我，这块白",
                    {"rt2"},
                    "色的画布伫立在这里……」"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003267", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「在这个世界面前，我的思念只有这里这块百号画布那么大的份量。",
                    {"rt2"},
                    "这么一想，还真让人挺恼火的呢」"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            ja = {
                {"里奈看起来在生气。"}
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003268", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「但是，在如此压倒性的力量面前，这块画布预感到了自己将被描",
                    {"rt2"},
                    "绘，伫立在这里」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003269", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「当然，我也预感到单凭我的想象力，无法突破这个梦之幻影世界",
                    {"rt2"},
                    "的极限……」"
                }
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003270", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我的能力也好想象力也好都力有不足，但是——不」"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003271", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「所以，也许正因如此，这里不仅有我，还有优美」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003272", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是的。至少，是我的思念促成了这一切」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003273", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我的绘画，需要傲慢到极致的绝对之爱」"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
