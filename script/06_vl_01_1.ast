        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            ja = {
                {
                    "她多次发现了我为了避开其他教师而在屋顶抽烟的事，不过也只是",
                    {"rt2"},
                    "提醒一下就放过了我。"
                }
