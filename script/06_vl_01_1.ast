            },
            ja = {
                {
                    name = {"樱子"},
                    "「所以我才不知道啊。不过音乐科倒是有呢。那边也出了很多名人。",
                    {"rt2"},
                    "所以我一直以为弓张是以音乐出名的学校呢」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「音乐科历史悠久嘛，弓张学园又没有美术科，现在的年轻人不知",
                    {"rt2"},
                    "道也是没办法的事……」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"msgoff"},
        {"fg", mode = -2},
        {"bg", file = "zbluesky_spring", speed = 240000, sync = 1, id = 1, lv = 5, path = ":cg/", x2 = 0, y2 = -540, x = 0, y = 540, ax = 1920, ay = 1080, bx = -960, by = -540},
        {"text"},
        text = {
            ja = {
                {"如今，那个弓张美术部已经不在了。"}
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            ja = {
                {
                    "和圭一起度过的日子里，有鸟谷、冰川、川内野，有明石和托马斯。",
                    {"rt2"},
                    "以及如今作为世界级艺术家活跃着的御桜禀。大家共同度过的那个",
                    {"rt2"},
                    "美术部，已经不在了。"
                }
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            ja = {
                {
                    "我们毕业后，冰川和川内野接手管理了美术部。特别是她们那个时",
                    {"rt2"},
                    "代，因为御桜禀的壮举，据说入部申请人数达到了三位数，场面十",
                    {"rt2"},
                    "分火爆。"
                }
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            ja = {
                {
                    "然而那份荣光也已是过眼云烟，在我来这所学校任教的那一年，最",
                    {"rt2"},
                    "后的美术部员毕业了，美术部也就事实上废部了。"
                }
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            ja = {
                {"我赴任那年，若田像是跟我换班似的离开了这所学校。"}
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            ja = {
                {"听说是靠个人关系在外地的学校找到了教职。"}
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            ja = {
                {"因为是前后脚的事，所以跟若田连正式的告别都没来得及说。"}
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            ja = {
                {
                    "毕业之后我也没回过弓张学园，所以毕业典礼那天就成了最后的道",
                    {"rt2"},
                    "别。"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            ja = {
                {
                    "总觉得随时都能见面来着，没想到那就成了最后一面。这种感觉真",
                    {"rt2"},
                    "是令人无奈。"
                }
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            ja = {
                {
                    "到了这个年纪，才第一次知道离别这种东西，是没有明确节点就会",
                    {"rt2"},
                    "降临的。"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            ja = {
