    block_00110 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，有全职讲师。如果兼职相当于打工的话，全职就是合同工。",
                    {"rt2"},
                    "虽然比不上正式员工，但各种福利待遇都有」"
