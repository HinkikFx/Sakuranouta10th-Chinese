    block_00066 = {
        {"text"},
        text = {
            ja = {
                {
                    "咲崎同学的名字叫樱子，名字和姓氏连在一起就变成了一个非常风",
                    {"rt2"},
                    "雅的名字。明年升三年级。是风纪委员中非常优秀的乖学生。"
                }
