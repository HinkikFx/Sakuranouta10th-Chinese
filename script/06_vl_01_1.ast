    block_00066 = {
        {"text"},
        text = {
            ja = {
                {
                    "咲崎同学名叫樱子。姓和名连起来,便是个雅致非常的名字。下一学",
                    {"rt2"},
                    "年就要升三年级,是位非常出色的风纪委员。"
