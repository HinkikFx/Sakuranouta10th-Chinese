        linkback = "block_00024",
        linknext = "block_00026"
    },
    block_00026 = {
        {"text"},
        text = {
            ja = {
                {
                    "感觉自己就站在这样一个悬在半空的位置上,年复一年,像看别人的",
                    {"rt2"},
                    "事一样望着相同的风景。"
                }
