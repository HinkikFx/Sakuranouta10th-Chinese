        text = {
            ja = {
                {"要说没有不安,那是骗人的。"}
            }
        },
        linkback = "block_00303",
        linknext = "block_00305"
    },
    block_00305 = {
        {"text"},
        text = {
            ja = {
                {"但要问日子过得是否轻松,倒也确实轻松。"}
            }
        },
        linkback = "block_00304",
        linknext = "block_00306"
    },
    block_00306 = {
        {"text"},
        text = {
            ja = {
                {"当然,婚是没结的。"}
            }
        },
        linkback = "block_00305",
        linknext = "block_00307"
    },
    block_00307 = {
        {"text"},
        text = {
            ja = {
                {"岂止如此,至今连和女性交往过的经历都没有。"}
            }
        },
        linkback = "block_00306",
        linknext = "block_00308"
    },
    block_00308 = {
        {"text"},
        text = {
            ja = {
                {"逍　遥　自　在　的　单　身　汉　！"}
            }
        },
        linkback = "block_00307",
        linknext = "block_00309"
    },
    block_00309 = {
        {"text"},
        text = {
            ja = {
                {"积蓄倒还算过得去。"}
            }
        },
        linkback = "block_00308",
        linknext = "block_00310"
    },
    block_00310 = {
        {"text"},
        text = {
            ja = {
                {
                    "要说原因,是因为受不了那栋公寓每年的固定资产税,把那套公寓给",
                    {"rt2"},
                    "卖掉了。"
                }
            }
        },
        linkback = "block_00309",
        linknext = "block_00311"
    },
    block_00311 = {
        {"text"},
        text = {
            ja = {
                {
                    "虽说是住惯了的家,但那份固定资产税,实在不是非常勤讲师付得起",
                    {"rt2"},
                    "的数目。"
                }
            }
        },
        linkback = "block_00310",
        linknext = "block_00312"
    },
    block_00312 = {
        {"text"},
        text = {
            ja = {
                {"卖房的钱原封不动地存了起来,所以比起同龄人,我的积蓄还算多的。"}
            }
        },
        linkback = "block_00311",
        linknext = "block_00313"
    },
    block_00313 = {
        {"text"},
        text = {
            ja = {
                {"只不过,卖掉公寓第二年的税金,着实让我惊掉了下巴。"}
            }
        },
        linkback = "block_00312",
        linknext = "block_00314"
    },
    block_00314 = {
        {"text"},
        text = {
            ja = {
                {"就算卖掉的是仅有的那点资产,那笔钱似乎也会被算作收入。"}
            }
        },
        linkback = "block_00313",
        linknext = "block_00315"
    },
    block_00315 = {
        {"text"},
        text = {
            ja = {
                {"这个国家的税金,只能用疯了来形容。"}
            }
        },
        linkback = "block_00314",
        linknext = "block_00316"
    },
    block_00316 = {
        {"text"},
        text = {
            ja = {
                {
                    "据说要是拜托税理士处理,本不至于缴那么一大笔税……可我压根就",
                    {"rt2"},
                    "没那个头脑……。"
                }
            }
        },
        linkback = "block_00315",
        linknext = "block_00317"
    },
    block_00317 = {
        {"text"},
        text = {
            ja = {
                {"话虽如此,过着这种生活还能有积蓄,已经算是很幸运了吧。"}
            }
        },
        linkback = "block_00316",
        linknext = "block_00318"
    },
