        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「在美术杂志上两个人经常被拿来比较，不过电视上不太会比较他",
                    {"rt2"},
                    "们两个，所以可能给人一种草薙健一郎被遗忘的感觉吧……」"
                }
