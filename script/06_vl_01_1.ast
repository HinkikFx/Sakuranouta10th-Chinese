        },
        text = {
            vo = {
                {"vo", file = "fem_skr_000071", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「我是知道草薙健一郎的作品的。那幅『横卧之樱』超厉害的。我",
                    {"rt2"},
                    "小时候他去世了，电视上总在播，不过说到最近的艺术家果然还是",
                    {"rt2"},
                    "御桜禀更有名的感觉呢」"
                }
            }
