        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,还有一种叫常勤讲师。如果说非常勤是零工,常勤就是合同工",
                    {"rt2"},
                    "了。虽然比不上正式员工,但附带各种各样的优待」"
