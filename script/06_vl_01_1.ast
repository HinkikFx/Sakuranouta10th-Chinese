                {"vo", file = "fem_skr_000068", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「其实，我前不久才知道有个叫草薙健一郎的艺术家，然后又知道",
                    {"rt2"},
                    "了御桜禀是这所学校的校友」"
