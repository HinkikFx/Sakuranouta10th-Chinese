        linkback = "block_00094",
        linknext = "block_00096"
    },
    block_00096 = {
        {"fg", ch = "桜子", size = "z2", mode = 3, path = ":fg/sku/z2/", file = "sku_z2a0200", face = "a0005", head = "sku_z2a", lv = 5, id = 9},
