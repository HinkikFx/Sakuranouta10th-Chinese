        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,非常勤。说白了就是打零工。按时薪算的。也允许干其他副业",
