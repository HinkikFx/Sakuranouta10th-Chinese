                {"vo", file = "fem_mmd_000031", ch = "mmd"}
            },
            ja = {
                {
                    name = {"御樱母亲"},
                    "「你交到了一个好孩子做朋友呢。禀……」"
                }
            }
        },
        linkback = "block_00214",
        linknext = "block_00216"
    },
    block_00216 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_003193", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「嗯、嗯。小直是很好的朋友哦」"
                }
