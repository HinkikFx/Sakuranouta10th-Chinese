        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            ja = {
                {"身体被压住的妈妈,不清楚外面的状况。"}
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            ja = {
                {
                    "我从窗口往下看,虽然有几个大人,但大家都只是一脸不安地,望着这",
                    {"rt2"},
                    "座宅邸。"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            ja = {
                {"母亲或许是察觉到了那样的神情,立刻朝小直呼喊。"}
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mmd_000028", ch = "mmd"}
            },
            ja = {
                {
                    name = {"御樱母亲"},
                    "「草薙君!　我有事相求!」"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么事!」"
                }
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mmd_000029", ch = "mmd"}
            },
            ja = {
                {
                    name = {"御樱母亲"},
                    "「你曾经向我炫耀过,说自己臂力惊人,对吧!」"
                }
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是的!　我是被老爸戴着什么『绘画养成矫正器』之类的鬼玩意儿",
                    {"rt2"},
                    "养大的,对臂力很有自信!」"
                }
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以,要是让我徒手爬上这座宅子,我想我也爬得上去」"
                }
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mmd_000030", ch = "mmd"}
            },
            ja = {
                {
                    name = {"御樱母亲"},
                    "「呵……」"
                }
            }
        },
        linkback = "block_00212",
        linknext = "block_00214"
    },
    block_00214 = {
        {"text"},
        text = {
            ja = {
                {"听了小直的回答,妈妈笑了。"}
            }
        },
        linkback = "block_00213",
        linknext = "block_00215"
    },
    block_00215 = {
        {"text"},
        text = {
