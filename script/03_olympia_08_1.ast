    },
    block_00099 = {
        {"fg", ch = "香奈", size = "z2", mode = 3, path = ":fg/kan/z2/", file = "kan_z2a0100", face = "a0016", head = "kan_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000145", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「嘛，从以前开始就觉得你家很有气质，我也猜到是有钱人，但看",
                    {"rt2"},
                    "了这篇报道才惊讶呢，竟然住在那么大的豪宅里。四百坪啊，太厉",
                    {"rt2"},
                    "害了」"
                }
