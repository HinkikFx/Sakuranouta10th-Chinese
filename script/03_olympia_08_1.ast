        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"fg", ch = "香奈", size = "z2", mode = 3, path = ":fg/kan/z2/", file = "kan_z2a0100", face = "a0003", head = "kan_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000146", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「禀酱的爸爸虽然是小有名气的画家，但感觉光靠画画不会赚那么",
                    {"rt2"},
