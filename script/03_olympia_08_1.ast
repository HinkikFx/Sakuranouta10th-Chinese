        linkback = "block_00232",
        linknext = "block_00234"
    },
    block_00234 = {
        {"text"},
        text = {
            ja = {
                {
                    "那颗骇人的眼珠,只是一味地冰冷,一味地令人冻结,夜空被眼珠黏稠",
                    {"rt2"},
                    "的浆液所浸染。"
                }
