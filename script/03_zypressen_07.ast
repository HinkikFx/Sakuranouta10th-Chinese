    },
    block_00241 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2a0100", face = "a0010", head = "rna_z2a", lv = 5, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001994", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「从被认为是最后作品的那幅『樱日狂想』开始，到和我的合作中",
                    {"rt2"},
                    "途为止，画风变了很多」"
                }
            }
        },
        linkback = "block_00240",
        linknext = "block_00242"
    },
    block_00242 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2a0100", face = "a0011", head = "rna_z2a", lv = 5, id = 5},
        {"text"},
        text = {
