            ja = {
                {
                    name = {"禀"},
                    "「如果我好好记得那场事故的话，小直根本就不需要放弃画画。是",
                    {"rt2"},
                    "因为我太软弱，无法承受那场火灾的事实，所以小直才为了保护我",
                    {"rt2"},
                    "而放弃了绘画」"
                }
            }
        },
        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不对。你说的不对！」"
                }
            }
        },
        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不是你的软弱导致了记忆的丧失！」"
                }
            }
        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_003217", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「怎么不是！事实上我不就是因为无法接受真相，才把人偶当成了",
                    {"rt2"},
                    "自己的妈妈吗！」"
                }
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_003218", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「是软弱的心欺骗了自己，让周围的人都痛苦不堪！」"
                }
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"quake", mode = "mw"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不对！」"
                }
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            ja = {
                {"事实并非如此。"}
            }
        },
        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"text"},
        text = {
            ja = {
                {"禀根本没有杀死母亲。"}
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"text"},
        text = {
            ja = {
                {"那不过是一场不幸的意外罢了。"}
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"text"},
        text = {
            ja = {
                {"但现在的我就算仔细地跟她解释也毫无意义。"}
            }
        },
        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"text"},
        text = {
            ja = {
                {"我也只能说\"不对\"了。"}
            }
        },
        linkback = "block_00148",
        linknext = "block_00150"
    },
    block_00150 = {
        {"text"},
        text = {
            ja = {
                {"觉得用语言来说服是徒劳的。"}
            }
        },
        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"text"},
        text = {
            ja = {
                {"大概无论什么话，都会被当作谎言吧。"}
            }
        },
        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            ja = {
                {"毕竟，我和禀的父亲确实一直在编造善意的谎言。"}
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            ja = {
                {"到了现在，她还会相信这种人说的话吗？"}
            }
        },
        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            ja = {
                {"禀家着火并不是谁的错，只是一连串不幸的巧合。"}
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            ja = {
                {
                    "禀虽然确实把人偶误认为自己的母亲，但那并不是禀内心软弱所导",
                    {"rt2"},
                    "致的。"
                }
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            ja = {
                {"所有的不幸和所有的善意，共同造成了当下最糟糕的局面。"}
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            ja = {
                {"不，正是因为知道那是善意，禀才更不会相信吧。"}
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"text"},
        text = {
