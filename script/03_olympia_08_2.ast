        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_003216", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「如果我好好记住了那场事故,小直根本没必要放弃画画。因为我软",
                    {"rt2"},
                    "弱,因为我承受不住那场火灾,小直为了我,舍弃了绘画」"
                }
            }
        },
        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不对。不是那样的!」"
                }
            }
        },
        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不是你的软弱让你失去了记忆」"
                }
            }
        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_003217", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「才不是!无法接受事实的我,把人偶当成了自己的妈妈!」"
                }
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_003218", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「是软弱的心,对自己撒谎,让身边所有的人都痛苦不堪!」"
                }
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"quake", mode = "mw"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不对!」"
                }
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            ja = {
                {"事实并非如此。"}
            }
        },
        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"text"},
        text = {
            ja = {
                {"禀根本没有杀害母亲。"}
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"text"},
        text = {
            ja = {
                {"那不过是一场不幸的事故。"}
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"text"},
        text = {
            ja = {
                {"可是,由现在的我来细细解释这些,毫无意义。"}
            }
        },
        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"text"},
        text = {
            ja = {
                {"我只能,对这一切也只说得出一句「不对」。"}
            }
        },
        linkback = "block_00148",
        linknext = "block_00150"
    },
    block_00150 = {
        {"text"},
        text = {
            ja = {
                {"言语的说服,似乎是徒劳的。"}
            }
        },
        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"text"},
        text = {
            ja = {
                {"大概,无论什么话,听起来都会像谎言吧。"}
            }
        },
        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            ja = {
                {"实际上,我和禀的父亲,一直以来都在说着温柔的谎言。"}
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            ja = {
                {"事到如今,她还会相信这种人的话吗?"}
            }
        },
        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            ja = {
                {"禀的家被烧毁,不是任何人的错,只是不幸的偶然层层叠加。"}
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            ja = {
                {"禀确实把人偶误认成了自己的母亲,但那并非源于禀内心的软弱。"}
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            ja = {
                {"是所有的不幸,与所有的善意,共同造就了如今这最糟糕的局面。"}
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            ja = {
                {"不,正因为知道那是善意,禀才不会相信吧。"}
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_003219", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「夺走了小直的右手。又夺走了他的画,还让爸爸痛苦不堪」"
                }
            }
        },
        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_003220", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「全都是我的软弱招来的」"
                }
            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_003221", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「我一直在迁怒于爸爸」"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_003222", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「捏造出是他夺走了妈妈的虚假记忆……,只因为我无法接受,是自己",
                    {"rt2"},
                    "杀死了妈妈的事实!」"
                }
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"se", file = "se0744s", id = 1},
