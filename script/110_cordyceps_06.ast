                {"vo", file = "fem_rna_003318", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯啾，对不起对不起对不起，好舒服……嗯啊嗯啊嗯啊嗯啊嗯嘎",
