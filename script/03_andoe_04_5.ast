            },
            ja = {
                {
                    name = {"雫"},
                    "「啊,啊嗯,好舒服,舒服的地方,一次又一次。每次上下动的时候都刮",
                    {"rt2"},
                    "着那里……!!　啊,啊,啊,啊啊,嗯嗯呜……啊,咕呜!!?」"
                }
