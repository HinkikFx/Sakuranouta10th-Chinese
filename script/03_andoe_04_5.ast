    block_00464 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_001302", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「不行不行,那里不能舔……不行……直哉,禁止对雫的小穴咕啪。咕",
                    {"rt2"},
                    "啪太舒服了不可以……啊,啊,不行……不能掰开!」"
                }
            }
        },
        linkback = "block_00463",
        linknext = "block_00465"
    },
    block_00465 = {
