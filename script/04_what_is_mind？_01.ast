        linkback = "block_00019",
        linknext = "block_00021"
    },
    block_00021 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000058", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「这话要是当着蓝老师的面说可是要出人命的。她可是很在意身高",
