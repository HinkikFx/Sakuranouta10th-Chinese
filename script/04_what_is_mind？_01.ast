        linkback = "block_00028",
        linknext = "block_00030"
    },
    block_00030 = {
        {"bg", file = "ev_com_g01_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000016", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「『为什么病恶化到这个地步才回来』，就为这个。被她好一顿怒",
                    {"rt2"},
                    "吼啊」"
                }
            }
        },
        linkback = "block_00029",
        linknext = "block_00031"
    },
    block_00031 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000063", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「那是当然……。说实话，我也是这么想的」"
                }
            }
        },
        linkback = "block_00030",
        linknext = "block_00032"
    },
    block_00032 = {
        {"bg", file = "ev_com_g01_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
