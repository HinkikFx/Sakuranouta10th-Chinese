        text = {
            vo = {
                {"vo", file = "man_kid_000026", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「谁知道呢。这我可不清楚。再说，那家伙最终会怎么处置遗产，",
                    {"rt2"},
                    "我也无从知晓啊」"
