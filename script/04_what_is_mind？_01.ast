    block_00003 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000049", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「啊，直哉吗……他好像有不少烦恼呢」"
