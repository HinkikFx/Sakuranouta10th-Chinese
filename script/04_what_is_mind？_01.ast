        linkback = "block_00016",
        linknext = "block_00018"
    },
    block_00018 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000057", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「之后我也多少了解了一些内情。夏目家的蓝到弓张赴任了嘛」"
                }
            }
        },
        linkback = "block_00017",
        linknext = "block_00019"
    },
    block_00019 = {
        {"bg", file = "ev_com_g01_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000010", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「是啊，说起来，蓝竟然在当老师了……在弓张……」"
