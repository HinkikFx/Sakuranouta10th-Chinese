        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000051", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
