        linkback = "block_00036",
        linknext = "block_00038"
    },
    block_00038 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000066", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「结果呢？　这寿命真如计算的那样，是您自己定下的吗？」"
