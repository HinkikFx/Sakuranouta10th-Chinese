        linkback = "block_00018",
        linknext = "block_00020"
    },
    block_00020 = {
        {"bg", file = "ev_com_g01_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000011", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「这么一来，我也真是老了啊……那么小的丫头，现在居然当起老",
