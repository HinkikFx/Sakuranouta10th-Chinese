        linkback = "block_00027",
        linknext = "block_00029"
    },
    block_00029 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000062", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「因为什么都没干？」"
