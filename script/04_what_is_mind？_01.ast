        linknext = "block_00004"
    },
    block_00004 = {
        {"bg", file = "ev_com_g01_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000003", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「想必是啊……」"
                }
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000050", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「遗产，您为什么全都交给那家伙了？」"
                }
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"bg", file = "ev_com_g01_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000004", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嘛，有很多缘由啦。方方面面的」"
                }
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000051", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「很多缘由吗……」"
                }
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000052", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「话说回来，草薙先生带来的那个少女，是谁啊？」"
                }
            }
        },
        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"bg", file = "ev_com_g01_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000005", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯——这个嘛——」"
                }
            }
        },
        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000053", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「嘛，这也轮不到我来说三道四。可即便如此，让直哉在这个年纪",
                    {"rt2"},
                    "就卷进夏目家的问题里，是不是有些残酷了？」"
                }
            }
        },
        linkback = "block_00009",
        linknext = "block_00011"
    },
    block_00011 = {
        {"bg", file = "ev_com_g01_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000006", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那也是没办法的事。直哉是草薙家的人。所谓草薙家的人，就是",
                    {"rt2"},
                    "背负着被卷入大事的宿命啊」"
                }
            }
        },
        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000054", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「这算是什么家族啊……」"
                }
            }
        },
        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"bg", file = "ev_com_g01_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000007", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「什么家族不家族的，你自己不也清楚吗？」"
                }
            }
        },
        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000055", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「我知道的也就一星半点。草薙先生您啊，和我们弓张学园男子生",
                    {"rt2"},
                    "人人憧憬的女神。和水菜小姐私奔了」"
                }
            }
        },
        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000008", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「私奔吗……。嘛，在旁人看来，或许确实像是那么回事吧……」"
                }
            }
        },
        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000056", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「不用旁人来看，那也是私奔吧？」"
                }
            }
        },
        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"bg", file = "ev_com_g01_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000009", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「算是吗……」"
                }
            }
        },
        linkback = "block_00016",
        linknext = "block_00018"
    },
    block_00018 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000057", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「后来我也多少知道了些内情。毕竟夏目家的小蓝到弓张赴任来了",
                    {"rt2"},
                    "嘛」"
                }
            }
        },
        linkback = "block_00017",
        linknext = "block_00019"
    },
    block_00019 = {
        {"bg", file = "ev_com_g01_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000010", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「是啊，说起来，蓝在当老师了呢……在弓张……」"
                }
            }
        },
        linkback = "block_00018",
        linknext = "block_00020"
    },
    block_00020 = {
        {"bg", file = "ev_com_g01_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000011", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「这么一想，我也确实上年纪了啊……。当年那么小不点的丫头，",
                    {"rt2"},
                    "如今都当上老师了……。虽说个子还是那么小」"
                }
            }
        },
        linkback = "block_00019",
        linknext = "block_00021"
    },
    block_00021 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000058", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「这话要是让蓝老师听见，您会被杀掉的。她可一直在意自己的身",
                    {"rt2"},
                    "高呢」"
                }
            }
        },
        linkback = "block_00020",
        linknext = "block_00022"
    },
    block_00022 = {
        {"bg", file = "ev_com_g01_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000012", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「明明没什么好在意的啊。蓝那丫头，生得那么标致。个子小这一",
                    {"rt2"},
                    "点，对好这一口的家伙来说反倒是奖赏呢」"
                }
            }
        },
        linkback = "block_00021",
        linknext = "block_00023"
    },
    block_00023 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000059", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「这话在蓝老师面前，可是超级禁句」"
                }
            }
        },
        linkback = "block_00022",
        linknext = "block_00024"
    },
    block_00024 = {
        {"bg", file = "ev_com_g01_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000013", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「是吗。嘛，反正我一直净惹蓝生气来着……」"
                }
            }
        },
        linkback = "block_00023",
        linknext = "block_00025"
    },
    block_00025 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000060", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「是吗？　不过最近，总不至于了吧？」"
                }
            }
        },
        linkback = "block_00024",
        linknext = "block_00026"
    },
    block_00026 = {
        {"bg", file = "ev_com_g01_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000014", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「不不，就在最近，还狠狠挨了一顿骂呢」"
                }
            }
        },
        linkback = "block_00025",
        linknext = "block_00027"
    },
    block_00027 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000061", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「这样啊。您干什么了？」"
                }
            }
        },
        linkback = "block_00026",
        linknext = "block_00028"
    },
    block_00028 = {
        {"bg", file = "ev_com_g01_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000015", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「不，正相反。因为什么都没干才挨的骂」"
