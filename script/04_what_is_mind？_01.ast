        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000053", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「虽说这不是我该多嘴的事。但即便如此，让直哉那个年纪的孩子",
                    {"rt2"},
                    "牵扯进夏目家的事，未免也太残酷了点吧」"
                }
            }
        },
        linkback = "block_00009",
        linknext = "block_00011"
    },
    block_00011 = {
        {"bg", file = "ev_com_g01_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000006", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那也没办法。直哉是草薙家的人。身为草薙家的人，就注定要被",
                    {"rt2"},
                    "卷入",
                    {"txruby", text = "おおごと"},
                    "大事",
                    {"txruby"},
                    "之中」"
                }
            }
        },
        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000054", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「什么样的家族啊……」"
                }
            }
        },
        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"bg", file = "ev_com_g01_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000007", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「什么什么样的，你不也知道吗？」"
                }
            }
        },
        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000055", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「我知道的也不过是一点皮毛而已。草薙先生可是我们弓张学园所",
                    {"rt2"},
                    "有男子生都仰慕的女神啊。然后跟水菜小姐私奔了」"
                }
            }
        },
        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000008", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「私奔吗……嗯，在旁人看来，或许确实像那么回事吧……」"
                }
            }
        },
        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000056", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「不用旁人看，那就是私奔吧？」"
                }
            }
        },
        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"bg", file = "ev_com_g01_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000009", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「算是吧……」"
