        linkback = "block_00032",
        linknext = "block_00034"
    },
    block_00034 = {
        {"bg", file = "ev_com_g01_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000018", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯，都是像样的大人了怎么还干这种事！　——她就是这么骂我的",
                    {"rt2"},
                    "啊……」"
                }
            }
        },
        linkback = "block_00033",
        linknext = "block_00035"
    },
    block_00035 = {
        {"bg", file = "ev_com_g01_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000019", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「她从小就是个好胜心强的丫头。看她哭得那么稀里哗啦，我心里",
                    {"rt2"},
                    "也有点疼啊」"
                }
            }
        },
        linkback = "block_00034",
        linknext = "block_00036"
    },
    block_00036 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000065", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「那您当初去医院不就好了吗。身体不舒服，是很久之前就开始了",
                    {"rt2"},
                    "吧？」"
                }
            }
        },
        linkback = "block_00035",
        linknext = "block_00037"
    },
    block_00037 = {
        {"bg", file = "ev_com_g01_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g01/", set = "ev_com_g01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000020", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「就算如此，自己的寿命，我还是想自己来决定啊」"
