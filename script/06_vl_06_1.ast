    },
    block_00221 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_iue_000014", ch = "iue"}
            },
            ja = {
                {
                    name = {"井上理事"},
                    "「没错！实际上，我们医院的屋顶有一大面玻璃幕墙呢。生前，草",
                    {"rt2"},
                    "薙健一郎先生就曾想利用这个来创作壁画！」"
                }
            }
        },
        linkback = "block_00220",
        linknext = "block_00222"
    },
    block_00222 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000832", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「生前！？什么意思？」"
                }
            }
        },
        linkback = "block_00221",
        linknext = "block_00223"
    },
    block_00223 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「草薙健一郎活着的时候，这幅『樱达的足迹』还没有完成。他在",
                    {"rt2"},
                    "住院期间，暗暗怀有想要完成这件作品的心愿」"
                }
            }
        },
        linkback = "block_00222",
        linknext = "block_00224"
    },
    block_00224 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但以他的身体状况，是不被允许走出医院的」"
                }
            }
        },
        linkback = "block_00223",
        linknext = "block_00225"
    },
    block_00225 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以，他不去弓张学园，而是从自己住院的弓张综合医院出发，",
                    {"rt2"},
                    "制定了完成壁画的计划」"
                }
            }
        },
        linkback = "block_00224",
        linknext = "block_00226"
    },
    block_00226 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_hdj_000041", ch = "hdj"}
            },
            ja = {
                {
                    name = {"记者团"},
                    "「不移动？从医院？」"
                }
            }
        },
        linkback = "block_00225",
        linknext = "block_00227"
    },
    block_00227 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「对，他从自己住院的医院，直接往这座教堂上描绘色彩」"
                }
            }
        },
        linkback = "block_00226",
        linknext = "block_00228"
    },
    block_00228 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不去教堂，就把色彩倾泻过去。他想出了这个方法」"
                }
            }
        },
        linkback = "block_00227",
        linknext = "block_00229"
    },
    block_00229 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就是这个——草薙健一郎用生前未能完成的壁画的最初设计方案，",
                    {"rt2"},
                    "通过彩绘玻璃所创造的色彩来呈现！」"
                }
            }
        },
        linkback = "block_00228",
        linknext = "block_00230"
    },
    block_00230 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这才是他最终想要创作的，真正的『樱达的足迹』！」"
                }
            }
        },
        linkback = "block_00229",
        linknext = "block_00231"
    },
