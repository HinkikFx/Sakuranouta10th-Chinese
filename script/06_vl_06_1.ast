        linkback = "block_00248",
        linknext = "block_00250"
    },
    block_00250 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「谁知道呢。一个晚上,是怎么做出彩绘玻璃来的呢？　你自己好好",
                    {"rt2"},
                    "想想吧」"
