        linkback = "block_00249",
        linknext = "block_00251"
    },
    block_00251 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这种突发性的艺术,不正是你们的拿手领域吗？」"
