        },
        linkback = "block_00242",
        linknext = "block_00244"
    },
    block_00244 = {
        {"text"},
        text = {
            ja = {
                {
                    "草薙健一郎生前计划之物。正因如此,穆尔财团才认定其为健一郎的",
                    {"rt2"},
                    "新作。"
                }
            }
        },
        linkback = "block_00243",
        linknext = "block_00245"
    },
    block_00245 = {
        {"text"},
        text = {
            ja = {
                {"作为说服力,已经绰绰有余。"}
            }
        },
        linkback = "block_00244",
        linknext = "block_00246"
    },
    block_00246 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就是这么回事。长山」"
