                    "「现在因为有我们医院的大楼挡着，这件作品无法展现本来的面貌。",
                    {"rt2"},
                    "不过再过一会儿，朝阳就会越过那栋建筑了」"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_hdj_000034", ch = "hdj"}
            },
            ja = {
                {
                    name = {"记者团"},
                    "「太阳光直接照不照进来，作品的好坏也看得出来」"
                }
