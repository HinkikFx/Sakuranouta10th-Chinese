        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            ja = {
                {
                    "他们就好像在把「结果和自己期待的新闻不一样」的怒气,发泄到这",
                    {"rt2"},
                    "些话上。"
                }
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000395", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「实际上,艺术家团体布尔巴吉的信念是重视“事件性”,因此事先并未",
                    {"rt2"},
                    "与我们商量。校内本来也在协议要如何发表,结果昨天就先见了报…",
                    {"rt2"},
                    "…」"
                }
            }
        },
        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_hdj_000031", ch = "hdj"}
            },
            ja = {
                {
                    name = {"记者团"},
                    "「毕竟托如今活跃于美国的御樱禀的福,正是空前的美术热潮嘛。放",
                    {"rt2"},
                    "在从前,根本无法想象啊」"
                }
            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_hdj_000032", ch = "hdj"}
            },
            ja = {
                {
                    name = {"记者团"},
                    "「不,就算是现在也无法想象！这根本就是涂鸦！当地居民能接受吗！",
                    {"rt2"},
                    "」"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
