                {"vo", file = "man_frd_000370", ch = "frd"}
            },
            ja = {
                {
                    name = {"弗里曼"},
                    "「请安静。现在公开作品。接下来,有请布尔巴吉的代表长山香奈女",
                    {"rt2"},
                    "士发言」"
