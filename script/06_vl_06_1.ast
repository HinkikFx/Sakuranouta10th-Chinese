    },
    block_00144 = {
        {"text"},
        text = {
            ja = {
                {"但那双眼睛已与刚才不同,分明燃烧着斗志。"}
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            ja = {
                {"是弗里德曼的话点燃了长山吧。"}
