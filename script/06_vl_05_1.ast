        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊，不，那当然会吃惊吧，好久不见了……。你什么时候回弓张",
                    {"rt2"},
                    "的？」"
