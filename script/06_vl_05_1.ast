    block_00265 = {
        {"text"},
        text = {
            ja = {
                {"咲崎同学转过身，带着心领神会的表情注视着我的脸。"}
            }
        },
        linkback = "block_00264",
        linknext = "block_00266"
    },
    block_00266 = {
        {"text"},
        text = {
            ja = {
                {
                    "嘛，她可是从那件作品里感受到「快乐」的人。刚才鸟谷的话，对",
                    {"rt2"},
                    "她来说正可谓心领神会吧。"
                }
            }
        },
        linkback = "block_00265",
        linknext = "block_00267"
    },
    block_00267 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不管怎么说，那都是明石的作品」"
                }
            }
        },
        linkback = "block_00266",
        linknext = "block_00268"
    },
    block_00268 = {
