    },
    block_00003 = {
        {"text"},
        text = {
            ja = {
                {"曲名叫『向日葵』。"}
            }
        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"text"},
        text = {
            ja = {
                {"很久以前，英国出现了一位伟大的摇滚歌手。"}
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            ja = {
                {"他的摇滚乐队堪称时代的代表，但令人惋惜的是数年后解散了。"}
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            ja = {
                {"此后，仿佛在寻找自己是什么一般，他涉足了所有的音乐流派。"}
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            ja = {
                {"天才吸收了各种流派，陷入了迷走。"}
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"text"},
        text = {
            ja = {
                {"前进所带来的迷走。并非只有懈怠才意味着倒退。"}
            }
        },
        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"text"},
        text = {
            ja = {
                {"有时候，不，更确切地说，正是前进的力量让人大幅倒退。"}
            }
        },
        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"text"},
        text = {
            ja = {
                {
                    "他的名字，渐渐从主流中消失了，那位伟大的摇滚歌手，再也无人",
                    {"rt2"},
                    "问津。"
                }
            }
        },
        linkback = "block_00009",
        linknext = "block_00011"
    },
    block_00011 = {
        {"text"},
        text = {
            ja = {
                {"他无数次想要放弃音乐。"}
            }
        },
        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            ja = {
                {"但是，无论何时，音乐都陪伴在他身边。"}
            }
        },
        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"text"},
        text = {
            ja = {
                {"所以，他选择了与音乐同在。"}
            }
        },
        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"text"},
        text = {
            ja = {
                {"他开始在以前不可想象的小型音乐厅和俱乐部反复进行现场演出。"}
