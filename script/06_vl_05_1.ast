            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_004088", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「只要和艺术沾边、能赚钱的事，那地方什么都要插一脚。何况草",
