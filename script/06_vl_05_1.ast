        },
        linkback = "block_00263",
        linknext = "block_00265"
    },
    block_00265 = {
        {"text"},
        text = {
            ja = {
                {"咲崎同学转过身来，一脸豁然开朗的表情注视着我。"}
            }
        },
        linkback = "block_00264",
        linknext = "block_00266"
    },
    block_00266 = {
        {"text"},
        text = {
            ja = {
                {
                    "嗯，她是从那件作品中感受到了「快乐」的人。鸟谷刚才那番话对",
                    {"rt2"},
                    "她来说，正是醍醐灌顶吧。"
                }
            }
        },
        linkback = "block_00265",
        linknext = "block_00267"
    },
    block_00267 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不管怎么说，那是明石的作品」"
                }
            }
        },
        linkback = "block_00266",
