        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这是？名片？」"
                }
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1f0000", face = "f0015", head = "mak_z1f", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004079", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「以你的性格肯定不知道我在干什么吧？」"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"text"},
        text = {
            ja = {
                {
                    "鸟谷的名片上写着\"编辑\"。杂志名我听说过……不如说在书店翻阅过",
                    {"rt2"},
                    "很多次。"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「听说你成了美术杂志的编辑……居然是《月刊 ART",
                    {"rt2"},
                    "SCHOOL》的编辑啊」"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1f0000", face = "f0002", head = "mak_z1f", lv = 4, id = 9},
        {"fgact", ch = "真琴", act = "おじぎ", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004080", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「就是那样。我今天是来弓张出差的」"
                }
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「出差？美术杂志编辑为什么要来弓张出差？」"
                }
            }
