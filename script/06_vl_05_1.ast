            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_004088", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「只要是艺术圈能赚钱的事，那帮人什么都会插一脚。而且摩尔财",
