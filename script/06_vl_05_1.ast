    },
    block_00165 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000328", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「我是弓张学园二年级的咲崎樱子。鸟谷学姐的英勇事迹，我听说",
                    {"rt2"},
                    "过很多」"
                }
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004124", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「诶？　听谁说的？」"
                }
