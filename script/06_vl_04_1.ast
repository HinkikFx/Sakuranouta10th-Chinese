            },
            ja = {
                {
                    name = {"教师"},
                    "「这、这件作品?　这涂鸦吗?」"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mym_000003", ch = "mym"}
            },
            ja = {
                {
                    name = {"村山理事"},
                    "「不是涂鸦!　这是作品!」"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mym_000004", ch = "mym"}
            },
            ja = {
                {
                    name = {"村山理事"},
                    "「他们是艺术家团体布尔巴基。在各种场所开展突发性的艺术活动。",
                    {"rt2"},
                    "嘛,似乎也因为玩得太过,招来不少误解……」"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0000", face = "a0003", head = "kan_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000804", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「这次的作品,也是由我们来完成的。将草薙氏描绘的震灾前的日常",
                    {"rt2"},
                    "世界,与如今包围着我们的日常加以差异化,便是本作」"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0000", face = "a0002", head = "kan_z1a", lv = 4, id = 9},
        {"fgact", ch = "香奈", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000805", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「名为『樱花们的灰色足迹』。我认为是与当下相称的作品」"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000036", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「可是,单凭村山理事一人的意思,不跟校长、其他理事还有理事长",
                    {"rt2"},
                    "确认的话……」"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mym_000005", ch = "mym"}
            },
            ja = {
                {
                    name = {"村山理事"},
                    "「嘛,那些我会打点好,尤其是弓张综合医院的井上理事,应该会对这",
                    {"rt2"},
                    "件事感兴趣」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            ja = {
                {"弓张综合医院的?"}
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mym_000006", ch = "mym"}
            },
            ja = {
                {
                    name = {"村山理事"},
                    "「这幅壁画刚落成那会儿,又耸动又有话题性,倒是不错。可按最近",
                    {"rt2"},
                    "美术的主流来看,已故草薙氏似乎已经算是上一个时代的艺术家了啊」"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0000", face = "a0003", head = "kan_z1a", lv = 4, id = 9},
        {"fgact", ch = "香奈", act = "うなづく", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0000", face = "a0002", head = "kan_z1a", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_knd_000806", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「是啊。已故草薙氏当然伟大,但我们这样的年轻一辈也成长起来了",
                    {"rt2"},
                    ",更何况如今的时代,正由以这弓张为母校的御樱禀所引领」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000807", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「艺术,任何时候都应当是崭新而先锐的」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mym_000007", ch = "mym"}
            },
            ja = {
                {
                    name = {"村山理事"},
                    "「就是这么回事喽。嘛,当然其他理事们会有反对意见,但这座教会",
                    {"rt2"},
                    "已经有先例了嘛。那个叫『樱花们的足迹』的……」"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此……因为那是先例,所以这次也没问题,是这个意思吗……」"
                }
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mym_000008", ch = "mym"}
            },
            ja = {
                {
                    name = {"村山理事"},
                    "「你是?」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0000", face = "a0004", head = "kan_z1a", lv = 4, id = 9},
        {"fgact", ch = "香奈", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000808", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「草薙健一郎的公子哦。草薙直哉先生。在这里当讲师」"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mym_000009", ch = "mym"}
            },
            ja = {
                {
                    name = {"村山理事"},
                    "「哎呀,这真是失敬。我竟不知本校有草薙氏的公子在」"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,反正我已经放弃了健一郎的遗产,对这幅『樱花们的足迹』,也",
                    {"rt2"},
                    "不持有任何权利」"
                }
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mym_000010", ch = "mym"}
            },
            ja = {
                {
                    name = {"村山理事"},
                    "「话虽如此,父亲的作品被人动了手脚,总归不痛快吧」"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嘛,说实话……」"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000037", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「草、草薙老师!」"
                }
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            ja = {
                {
