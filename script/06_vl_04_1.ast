        linknext = "block_00067"
    },
    block_00067 = {
        {"fg", ch = "桜子", size = "z1", mode = 3, path = ":fg/sku/z1/", file = "sku_z1a0210", face = "a0005", head = "sku_z1a", lv = 4, id = 9},
        {"fgact", ch = "桜子", act = "うなづく", lv = 4, id = 9},
        {"text"},
