    },
    block_00097 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000029", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「不管怎样,这件事得先问过校长和其他众多高层的意见再说」"
