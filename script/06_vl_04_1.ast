    block_00152 = {
        {"text"},
        text = {
            ja = {
                {"现代艺术也只能是那样的东西。"}
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            ja = {
