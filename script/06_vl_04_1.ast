    },
    block_00169 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mym_000002", ch = "mym"}
            },
            ja = {
                {
                    name = {"村山理事"},
                    "「我打算朝认可这件作品的方向进行协调」"
                }
            }
        },
        linkback = "block_00168",
