            ja = {
                {
                    name = {"教师"},
                    "「这、这件作品？这涂鸦也算作品？」"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mym_000003", ch = "mym"}
            },
            ja = {
                {
                    name = {"村山理事"},
                    "「这不是涂鸦！这是作品！」"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mym_000004", ch = "mym"}
            },
            ja = {
                {
                    name = {"村山理事"},
                    "「他们是艺术家团体布尔巴基。在各种地方进行突发性的艺术活动。",
                    {"rt2"},
                    "嗯，虽然因为做得太过火而常被人误解……」"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0000", face = "a0003", head = "kan_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000804", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「这次的作品也是由我们来完成的。将草薙氏所描绘的震灾前的日",
                    {"rt2"},
                    "常世界，差异化为如今围绕我们的日常，这就是本作品」"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0000", face = "a0002", head = "kan_z1a", lv = 4, id = 9},
        {"fgact", ch = "香奈", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000805", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「作品名为『樱达的灰色足迹』。我认为这是契合当下的作品」"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000036", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「可是，仅凭村山理事的一己之见，还需要向校长、其他理事和理",
                    {"rt2"},
                    "事长确认才行……」"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mym_000005", ch = "mym"}
            },
            ja = {
                {
                    name = {"村山理事"},
                    "「嗯，那方面我会妥善安排的。特别是弓张综合医院的井上理事，",
                    {"rt2"},
                    "应该会对此事表示兴趣」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            ja = {
                {"弓张综合医院的？"}
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mym_000006", ch = "mym"}
            },
            ja = {
                {
                    name = {"村山理事"},
                    "「这壁画刚完成那会儿确实很轰动，也很有话题性。但从最近美术",
                    {"rt2"},
                    "界的主流来看，已故草薙氏好像已经算是上一代的艺术家了」"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0000", face = "a0003", head = "kan_z1a", lv = 4, id = 9},
        {"fgact", ch = "香奈", act = "うなづく", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0000", face = "a0002", head = "kan_z1a", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_knd_000806", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「的确。已故草薙氏固然伟大，但像我们这样的年轻一代也在成长，",
                    {"rt2"},
                    "而且不论怎么说，时代的引领者是以这所弓张为母校的御桜禀」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000807", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「艺术永远应当是崭新的，并且是尖锐的」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mym_000007", ch = "mym"}
            },
            ja = {
                {
                    name = {"村山理事"},
                    "「就是这么回事。嗯，当然其他理事可能会有反对意见，但这座教",
                    {"rt2"},
                    "堂已经有先例了。就是那个『樱达的足迹』……」"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此……因为有那个先例，所以这次也可以通融，是这个意",
                    {"rt2"},
                    "思吗……」"
                }
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mym_000008", ch = "mym"}
            },
            ja = {
                {
                    name = {"村山理事"},
                    "「你是？」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0000", face = "a0004", head = "kan_z1a", lv = 4, id = 9},
        {"fgact", ch = "香奈", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
