    },
    block_00073 = {
        {"text"},
        text = {
            ja = {
                {"我默默点头。"}
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000024", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「校长嘛,说来说去,大概也是没有看美术的眼光吧」"
                }
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000025", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「如果当初不是草薙老师,而是由御樱禀主导完成这件作品,如今的",
                    {"rt2"},
                    "结果肯定截然不同……」"
                }
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000026", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「说实话,什么世界级艺术家的儿子我是不懂,但你这种非常勤讲师",
                    {"rt2"},
                    "完成的作品,对学校来说,什么卖点都算不上啊」"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"fg", ch = "桜子", size = "z1", mode = 3, path = ":fg/sku/z1/", file = "sku_z1a0200", face = "a0005", head = "sku_z1a", lv = 4, id = 9},
