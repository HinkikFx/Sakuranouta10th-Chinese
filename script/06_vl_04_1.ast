    },
    block_00060 = {
        {"fg", ch = "桜子", size = "z1", mode = 3, path = ":fg/sku/z1/", file = "sku_z1a0200", face = "a0006", head = "sku_z1a", lv = 4, id = 9},
        {"fgact", ch = "桜子", act = "びっくり", lv = 4, id = 9},
        {"text"},
        delay = {
