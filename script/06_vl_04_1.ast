    },
    block_00195 = {
        {"fg", mode = -2},
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0000", face = "a0005", head = "kan_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那么?　长山,你说的超越草薙,就是指这个……」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"fgact", ch = "香奈", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000809", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「没错。正是这个」"
                }
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这算哪门子超越草薙。你好歹也算半个艺术家,自己和草薙健一郎",
                    {"rt2"},
                    "之间的差距,总该掂量得出来吧?」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0000", face = "a0006", head = "kan_z1a", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0000", face = "a0002", head = "kan_z1a", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_knd_000810", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「差距我承认。但不是那么回事,给亡灵补上最后一刀。在这个意义",
                    {"rt2"},
                    "上,我们超越了草薙健一郎」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「给亡灵最后一刀?」"
                }
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0000", face = "a0011", head = "kan_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000811", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「草薙健一郎确实在这个国家掀起过美术热潮。但他已经不在了。",
                    {"rt2"},
                    "尽管如此,他的影响至今仍有浓重的残留」"
                }
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0000", face = "a0018", head = "kan_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000812", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「我认为,日本的美术界,不该再被那种过去的亡灵摆布」"
                }
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0000", face = "a0005", head = "kan_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000813", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「这不是为了超越草薙健一郎的才能的作品。而是给草薙健一郎这",
                    {"rt2"},
                    "个亡灵补上最后一刀。在这个意义上的超越草薙健一郎」"
                }
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
