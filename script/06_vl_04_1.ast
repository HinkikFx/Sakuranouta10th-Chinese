        {"bg", file = "ev_com_i09_01", path = ":ev/ev_com_i09/", set = "ev_com_i09", sync = 0},
        {"bg", file = "reco", id = 9, lv = 9, path = ":sys/", sync = 0},
        {"extrans", time = 500},
        {"text"},
