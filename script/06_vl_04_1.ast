        text = {
            ja = {
                {"在后方，虽然隐约可见，但画着震灾后人们熟悉的建筑物。"}
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「艺术就是挑衅吗……」"
                }
            }
        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            ja = {
                {
                    "孩子们的脚印化作樱花花瓣飘散的作品，被变成了从樱花中散播有",
                    {"rt2"},
                    "害物质的模样。"
                }
            }
        },
        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            ja = {
                {"平庸的挑衅。"}
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            ja = {
                {"只能说是幼稚至极的表现手法。"}
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            ja = {
                {
                    "但正是这种幼稚的、攻击性的表现手法，在某个领域中才是「正确」",
                    {"rt2"},
                    "的。"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"msgoff"},
        {"bg", file = "zbluesky_summer", speed = 300000, sync = 1, id = 1, lv = 5, path = ":cg/", x2 = 0, y2 = -540, x = 0, y = 540, ax = 1920, ay = 1080, bx = -960, by = -540},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「当代艺术……」"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            ja = {
                {
                    "艺术史并非只属于艺术家。在那里，以艺术家为中心，各色人等蠢",
                    {"rt2"},
                    "蠢欲动。"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        text = {
            ja = {
                {"买手、策展人、评论家。"}
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"text"},
        text = {
            ja = {
                {
                    "即便假设在当代，艺术早已是死去之物，也不能公然将其当作死物",
                    {"rt2"},
                    "来对待。"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            ja = {
                {"美术业界的权威。"}
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"text"},
        text = {
            ja = {
                {
                    "现代的艺术，即便它已灭绝，也是一个必须在表现的尸骸之上聚集",
                    {"rt2"},
                    "才能维系的行业。"
                }
            }
        },
        linkback = "block_00118",
        linknext = "block_00120"
    },
    block_00120 = {
        {"text"},
        text = {
            ja = {
                {"不，这不仅限于艺术吧。文学如此，作曲也是如此。"}
            }
        },
        linkback = "block_00119",
        linknext = "block_00121"
    },
    block_00121 = {
        {"text"},
        text = {
            ja = {
                {
                    "西方绘画史上，尤其是印象派之后，对",
                    {"txruby", text = "サロン"},
                    "权威",
                    {"txruby"},
                    "进行挑衅的作品数不胜",
                    {"rt2"},
                    "数。"
                }
            }
        },
        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"text"},
        text = {
            ja = {
                {
                    "实际上，在法国本土，印象派迟迟未被权威认可，大量画作流向了",
                    {"rt2"},
                    "美国。"
                }
            }
        },
        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"text"},
        text = {
            ja = {
                {
                    "美国的大都会艺术博物馆、芝加哥美术馆等拥有完全不逊色于法国",
                    {"rt2"},
                    "本土的印象派藏品，就是这个原因。"
                }
            }
        },
        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            ja = {
                {
                    "艺术在印象派之后，一直保持着对权威的挑衅性，并且持续制造轰",
                    {"rt2"},
                    "动。"
                }
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"text"},
        text = {
            ja = {
                {"但是，那种前卫的表现手法越来越走向枯竭。"}
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"text"},
        text = {
            ja = {
                {"在天才们已经穷尽表现的大地上，已无剩余的果实。"}
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"text"},
        text = {
            ja = {
                {"这是人尽皆知的事。"}
            }
        },
        linkback = "block_00126",
        linknext = "block_00128"
    },
    block_00128 = {
        {"text"},
        text = {
            ja = {
                {"革命性的新艺术，是不存在的。"}
            }
        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"text"},
        text = {
            ja = {
                {"如果换成古典音乐的世界来看，就更容易理解了。"}
            }
        },
        linkback = "block_00128",
        linknext = "block_00130"
    },
    block_00130 = {
        {"text"},
        text = {
            ja = {
                {
                    "据传，二十世纪作曲家勋伯格被友人问到「为什么要创作全是不协",
                    {"rt2"},
                    "和音的难听音乐」时，如此回答。"
                }
            }
        },
        linkback = "block_00129",
        linknext = "block_00131"
    },
    block_00131 = {
        {"text"},
        text = {
            ja = {
                {
                    "「我要是能做到的话也想用调性来写音乐。但是，历史已经禁止我",
                    {"rt2"},
                    "书写三和弦了」"
                }
            }
        },
        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"text"},
        text = {
            ja = {
                {
                    "在西方音乐史的极限之处，这位天才试图用十二音技法这种改变音",
                    {"rt2"},
                    "乐理论本身的方法来",
                    {"txruby", text = "あらが"},
                    "抗",
                    {"txruby"},
                    "争。"
                }
            }
        },
        linkback = "block_00131",
        linknext = "block_00133"
    },
    block_00133 = {
        {"text"},
        text = {
            ja = {
                {
                    "他在确立这一理论时如此说道。「由此，德国音乐的",
                    {"txruby", text = "ヘゲモニー"},
                    "霸权",
                    {"txruby"},
                    "已被保证",
                    {"rt2"},
                    "了一百年」。"
                }
            }
        },
        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"text"},
        text = {
            ja = {
                {"当然，这一技法在此后的历史中并未成为普遍的作曲技法。"}
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"text"},
        text = {
            ja = {
                {
                    "自然，德国音乐的霸权完全没有得到保证，不仅如此，此后源自黑",
                    {"rt2"},
                    "人音乐的爵士乐、以盎格鲁-撒克逊人为中心的摇滚乐席卷了世界。"
                }
            }
        },
        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"text"},
        text = {
            ja = {
                {
                    "对于我们表现者而言，与「新奇之物」已毫无缘分。大多不过是满",
                    {"rt2"},
                    "身陈迹的表现残骸。"
                }
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            ja = {
                {"但是，在这样的状况下业界是活不下去的。"}
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"text"},
        text = {
            ja = {
                {"如果是无关紧要的低俗行业倒也罢了，偏偏美术是高尚的文化产业。"}
            }
        },
        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            ja = {
                {"即便它已空虚，也必须完成文化使命而存续下去。"}
            }
        },
        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"text"},
        text = {
            ja = {
                {"摩尔展也大体上是基于这样的思想，由众多资本家运营的。"}
            }
        },
        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
        {"text"},
        text = {
            ja = {
                {"尖锐的、前卫的、并且挑衅性的。"}
            }
        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            ja = {
                {"看起来新颖的、具有新风格的——美术界追求的正是这类东西。"}
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"text"},
        text = {
            ja = {
                {"在这过程中，美术不知不觉间已站在了一个颠倒的世界里。"}
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            ja = {
                {"只要做别人不做的事，姑且就算是「艺术」了。"}
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            ja = {
                {"不是新颖的，而是没人做过的、挑衅性的作品。"}
            }
        },
        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"text"},
        text = {
            ja = {
                {"在这个螺旋中，幼稚性反而成了加分项。"}
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"text"},
        text = {
            ja = {
                {"好听点说，「孩子」是破坏的象征，也是新想象力的象征。"}
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"text"},
        text = {
            ja = {
                {
                    "但大多数「孩子」不过是未受过教育的成年人罢了。仅仅是不得体",
                    {"rt2"},
                    "且不合常理的行为就成了艺术。"
                }
            }
        },
        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"text"},
        text = {
            ja = {
                {"艺术的最前沿。所谓当代艺术，往往就是那样的东西被肯定。"}
            }
        },
        linkback = "block_00148",
        linknext = "block_00150"
    },
    block_00150 = {
        {"text"},
        text = {
            ja = {
                {
                    "只要有轰动性。灵机一动、时事话题。推销它们的买手，以及以投",
                    {"rt2"},
                    "机为目的、毫无信念的市场。"
                }
            }
        },
        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"cgdel", id = -1},
