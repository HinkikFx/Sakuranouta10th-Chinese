    },
    block_00068 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000021", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「那种东西不过是沿用以前印刷版本罢了。实际上当初确实不错。",
