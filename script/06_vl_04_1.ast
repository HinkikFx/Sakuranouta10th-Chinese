        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"text"},
        text = {
            ja = {
                {"泼洒开的颜料,看上去就像有什么不祥之物,正从樱花中弥漫开来。"}
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            ja = {
                {"还有被改造得如同赛博格的樱树主干。"}
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            ja = {
                {
                    "经此改动,喷吐着不祥之物的樱树主干,已不再是什么树干,被换成了",
                    {"rt2"},
                    "人工造物。"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            ja = {
                {"本来由孩子们的足迹所表现的樱花花瓣,如今喷洒着不祥的物质。"}
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            ja = {
                {"被改成赛博格的樱树。以及吐出毒素的樱花树。"}
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            ja = {
                {"深处还隐隐画着,震灾以后人们再熟悉不过的那种建筑。"}
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「艺术即挑衅吗……」"
                }
            }
        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            ja = {
                {
                    "孩子们的足迹化作樱花花瓣飘散的作品,被改成了樱花喷洒着有害之",
                    {"rt2"},
                    "物的东西。"
                }
            }
        },
        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            ja = {
                {"平庸的挑衅。"}
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            ja = {
                {"只能用幼儿性来形容的表现手法。"}
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            ja = {
                {
                    "但正是这种幼儿性的、攻击性的表现手法,在某个门类中,却成了「",
                    {"rt2"},
                    "正确」。"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"msgoff"},
        {"bg", file = "zbluesky_summer", speed = 300000, sync = 1, id = 1, lv = 5, path = ":cg/", x2 = 0, y2 = -540, x = 0, y = 540, ax = 1920, ay = 1080, bx = -960, by = -540},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「现代艺术……」"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            ja = {
                {
                    "艺术史,并不只属于艺术家。在那里,以艺术家为中心,形形色色的人",
                    {"rt2"},
                    "蠢蠢欲动。"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        text = {
            ja = {
                {"买手、策展人、批评家。"}
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"text"},
        text = {
            ja = {
                {"就算在现代,艺术这东西早已死去,也不能公然把它当作死物对待。"}
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            ja = {
                {"美术业界的权威。"}
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"text"},
        text = {
            ja = {
                {
                    "现代的艺术,即便它早已死绝,也是一个必须群聚在其表现的尸骸之",
                    {"rt2"},
                    "上才能成立的业界。"
                }
            }
        },
        linkback = "block_00118",
        linknext = "block_00120"
    },
    block_00120 = {
        {"text"},
        text = {
            ja = {
                {"不,这大概不限于艺术。文学如此,作曲亦然。"}
            }
        },
        linkback = "block_00119",
        linknext = "block_00121"
    },
    block_00121 = {
        {"text"},
        text = {
            ja = {
                {
                    "西洋绘画史,尤其是印象派以后,充斥着对",
                    {"txruby", text = "沙龙"},
                    "权威",
                    {"txruby"},
                    "挑衅的作品。"
                }
            }
        },
        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"text"},
        text = {
            ja = {
                {
                    "实际上,在本国法国,印象派迟迟得不到权威的认可,其中大量画作都",
                    {"rt2"},
                    "流向了美国。"
                }
            }
        },
        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"text"},
        text = {
            ja = {
                {
                    "美国的大都会艺术博物馆、芝加哥美术馆等,拥有丝毫不逊于法国本",
                    {"rt2"},
                    "土的印象派藏画,正是这个原因。"
                }
            }
        },
        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            ja = {
                {"印象派以后,艺术始终对权威保持挑衅,并且持续追求耸动。"}
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"text"},
        text = {
            ja = {
                {"但那前卫的表现手法,却日渐枯竭。"}
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"text"},
        text = {
            ja = {
                {"在天才们表现殆尽的大地上,没有留下任何果实。"}
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"text"},
        text = {
            ja = {
                {"谁都心知肚明。"}
            }
        },
        linkback = "block_00126",
        linknext = "block_00128"
    },
    block_00128 = {
        {"text"},
        text = {
            ja = {
                {"革命性的崭新艺术,并不存在。"}
            }
        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"text"},
        text = {
            ja = {
                {"若是放在古典音乐的世界里,这一点就显而易见。"}
            }
        },
        linkback = "block_00128",
        linknext = "block_00130"
    },
    block_00130 = {
        {"text"},
        text = {
            ja = {
                {
                    "据说２０世纪的作曲家勋伯格被朋友问到「为什么净写些满是不协",
                    {"rt2"},
                    "和音、难以入耳的音乐?」时,是这么回答的。"
                }
            }
        },
        linkback = "block_00129",
        linknext = "block_00131"
    },
    block_00131 = {
        {"text"},
        text = {
            ja = {
                {
                    "「如果可以,我自己也想用调性来写音乐。但写下三和弦这件事,已",
                    {"rt2"},
                    "被历史所禁止」"
                }
            }
        },
        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"text"},
        text = {
            ja = {
                {
                    "在西洋音乐史的极限地带,这位天才试图以十二音技法这种变更音乐",
                    {"rt2"},
                    "理论本身的方式来抗争。"
                }
            }
        },
        linkback = "block_00131",
        linknext = "block_00133"
    },
    block_00133 = {
        {"text"},
        text = {
            ja = {
                {
                    "确立这套理论时,他这样说道。「德国音乐的",
                    {"txruby", text = "hegemony"},
                    "霸权",
                    {"txruby"},
                    ",因此又得到了１",
                    {"rt2"},
                    "００年的保证」。"
                }
            }
        },
        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"text"},
        text = {
            ja = {
                {"当然,这套技法在其后的历史中,并未成为普遍的作曲技法。"}
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"text"},
        text = {
            ja = {
                {
                    "德国音乐的霸权自然也全无保证,岂止如此,其后,以黑人音乐为源流",
                    {"rt2"},
                    "的爵士乐、以盎格鲁-撒克逊人为中心的摇滚乐席卷了世界。"
                }
            }
        },
        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"text"},
        text = {
            ja = {
                {
                    "对我们表现者而言,「新奇之物」无缘无分。几乎一切,都只是沾满",
                    {"rt2"},
                    "手垢的表现的尸骸。"
                }
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            ja = {
                {"但业界无法在那样的状况下活下去。"}
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"text"},
        text = {
            ja = {
                {
                    "若是无关紧要的低俗行业倒也无妨,可这偏偏是美术这一高尚的文化",
                    {"rt2"},
                    "行业。"
                }
            }
        },
        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            ja = {
                {"即便空洞无物,也必须完成其文化使命,存续下去。"}
            }
        },
        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"text"},
        text = {
            ja = {
                {"摩尔展,大体上也是基于这种思想,由众多资本家运营的。"}
            }
        },
        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
        {"text"},
        text = {
            ja = {
                {"先锐、前卫、以及挑衅。"}
            }
        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            ja = {
                {"看起来崭新的东西,摆出新style的东西,美术界追逐着这些。"}
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"text"},
        text = {
            ja = {
                {"在此之中,美术不知不觉,站到了一个倒立的世界。"}
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            ja = {
                {"只要做没人做过的事,姑且就算“艺术”。"}
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            ja = {
                {"不是崭新,而是没人做过的、挑衅性的作品。"}
            }
        },
        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"text"},
        text = {
            ja = {
                {"在这螺旋之中,幼儿性、幼稚性,反倒成了加分项。"}
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"text"},
        text = {
            ja = {
                {"说得好听点,“孩子”是破坏的象征,也是崭新想象的象征。"}
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"text"},
        text = {
            ja = {
                {
                    "但大多数“孩子”,只是没受过教育的大人。单纯不谨慎又没常识的行",
                    {"rt2"},
                    "为,就成了艺术。"
                }
            }
        },
        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"text"},
        text = {
            ja = {
                {"艺术的最前沿。现代艺术这东西,往往就肯定着这样的东西。"}
            }
        },
        linkback = "block_00148",
        linknext = "block_00150"
    },
    block_00150 = {
        {"text"},
        text = {
            ja = {
                {
                    "只求耸动。灵光一现,时事热点。还有兜售这些的买手,以及为了投",
                    {"rt2"},
                    "机、毫无信念可言的市场。"
                }
            }
        },
        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"cgdel", id = -1},
        {"msgoff"},
        {"bg", file = "ev_com_i09_01", path = ":ev/ev_com_i09/", set = "ev_com_i09", sync = 0},
        {"bg", file = "reco", id = 9, lv = 9, path = ":sys/", sync = 0},
        {"extrans", time = 500},
        {"text"},
        text = {
            ja = {
                {
                    "说出「要是这由御樱禀主导来做,本该更有价值呢」的这位教师,是",
                    {"rt2"},
                    "正确的。"
                }
            }
        },
        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            ja = {
                {"现代艺术,只可能是那样的东西。"}
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            ja = {
                {"已故草薙健一郎的设计,由世界级艺术家御樱禀完成。"}
            }
        },
        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            ja = {
                {"单凭这个事实,这件作品的价值就会翻上数倍。"}
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            ja = {
                {"即便作品本身相同,只要作品诞生的背景不同,价格就截然不同。"}
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            ja = {
                {"艺术,就是这样的东西。"}
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
