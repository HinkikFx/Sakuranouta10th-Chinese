                    "不得了。简直闹到要以毁坏器物报警的地步……」"
                }
            }
        },
        linkback = "block_00053",
        linknext = "block_00055"
    },
    block_00055 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000259", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「可我听说,这是草薙健一郎的遗产」"
                }
            }
        },
        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000015", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「那是结果论。只不过结果上恰好如此罢了。在我们教师看来,不过",
                    {"rt2"},
                    "是被人大张旗鼓地涂鸦了一场,当时可是大问题啊」"
                }
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"fg", ch = "桜子", size = "z1", mode = 3, path = ":fg/sku/z1/", file = "sku_z1a0200", face = "a0005", head = "sku_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000260", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「什么叫结果?　我听说那是校方公认的作品」"
                }
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,这件事上,是老师说得对」"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000016", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「再说,草薙健一郎啊……。最近完全听不到这名字了。说是他的遗",
                    {"rt2"},
                    "产嘛……」"
                }
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"fg", ch = "桜子", size = "z1", mode = 3, path = ":fg/sku/z1/", file = "sku_z1a0200", face = "a0006", head = "sku_z1a", lv = 4, id = 9},
        {"fgact", ch = "桜子", act = "びっくり", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "桜子", size = "z1", mode = 3, path = ":fg/sku/z1/", file = "sku_z1a0200", face = "a0005", head = "sku_z1a", lv = 4, id = 9},
                {"fgact", ch = "桜子", act = "うなづく", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_skr_000261", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「你、你说什么!　才、才没有那种事。草薙健一郎至今仍是著名的",
                    {"rt2"},
                    "画家!」"
                }
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000017", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「是吗。我是不太懂,不过,这幅壁画也确实完全没人气了啊」"
                }
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000018", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「最近还时不时有人提议,想把它恢复成原来的普通墙壁呢」"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"fgact", ch = "桜子", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000262", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「这种话,是从谁嘴里说出来的!?」"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000019", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「谁知道呢,我也不清楚,只是有所耳闻。大概是因为这教会节假日",
                    {"rt2"},
                    "会当婚礼会场用,是那些客人的要求吧?」"
                }
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"fgact", ch = "桜子", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000263", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「这种事我从没听说过!」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000020", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「那种话,也轮不到你一个学生听吧?」"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"fg", ch = "桜子", size = "z1", mode = 3, path = ":fg/sku/z1/", file = "sku_z1a0210", face = "a0005", head = "sku_z1a", lv = 4, id = 9},
        {"fgact", ch = "桜子", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000264", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「不对。本地的宣传手册上,它可是作为观光景点登载的。应该是得",
                    {"rt2"},
                    "到公认的」"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000021", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「那种东西,不过是把从前印的直接拿来接着用罢了。实际上,当年",
                    {"rt2"},
                    "确实不错。草薙老师也顶着著名画家草薙健一郎公子的名头,受过不",
                    {"rt2"},
                    "少关注嘛」"
                }
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000022", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「但事到如今,草薙健一郎的儿子完成的作品什么的,已经成不了任",
                    {"rt2"},
                    "何卖点了」"
                }
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"fg", ch = "桜子", size = "z1", mode = 3, path = ":fg/sku/z1/", file = "sku_z1a0210", face = "a0007", head = "sku_z1a", lv = 4, id = 9},
        {"fgact", ch = "桜子", act = "びっくり", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000265", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「你、你说什么!」"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"fg", mode = -2},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kys_000023", ch = "kys"}
            },
            ja = {
                {
                    name = {"教师"},
                    "「我啊,可还记得,当年你们美术部里,可是有那位御樱禀在的」"
                }
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「……」"
