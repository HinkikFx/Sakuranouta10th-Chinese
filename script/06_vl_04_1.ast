                {"vo", file = "fem_knd_000808", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「这是草薙健一郎的公子。草薙直哉先生。在这里担任讲师」"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mym_000009", ch = "mym"}
            },
            ja = {
                {
                    name = {"村山理事"},
                    "「哦，这可真是失礼了。不知道我们学校竟然有草薙氏的公子在」"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不，不管怎样，我已经放弃了健一郎的遗产继承权，对这件『樱",
