        {"fg", ch = "香奈", size = "z2", speed = 15000, mode = 3, resize = 1, path = ":fg/kan/z2/", file = "kan_z2a0000", face = "a0002", head = "kan_z2a", y2 = -304, y = -260, lv = 5, id = 9, sync = 0},
