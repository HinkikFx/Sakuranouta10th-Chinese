        linkback = "block_00035",
        linknext = "block_00037"
    },
    block_00037 = {
        {"text"},
        text = {
            ja = {
                {
                    "希腊神话中的奇美拉是有着山羊的躯干、狮子的头颅和蛇的尾巴，",
