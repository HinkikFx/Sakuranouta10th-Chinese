    block_00034 = {
        {"text"},
        text = {
            ja = {
                {"说起喀迈拉,脑海里最先浮现的,是居斯塔夫·莫罗的作品……"}
            }
        },
        linkback = "block_00033",
        linknext = "block_00035"
    },
    block_00035 = {
        {"text"},
        text = {
            ja = {
                {"莫罗是继承浪漫主义脉流的象征主义先驱画家。"}
            }
        },
        linkback = "block_00034",
        linknext = "block_00036"
    },
    block_00036 = {
        {"text"},
        text = {
            ja = {
                {
                    "象征主义是十九世纪后半叶席卷全欧洲的艺术思潮,相对于试图客观",
                    {"rt2"},
                    "描绘现实的写实主义,它试图借助装饰性的形式,象征性地表现精神",
                    {"rt2"},
                    "性、神秘性与梦想。"
                }
            }
        },
        linkback = "block_00035",
        linknext = "block_00037"
    },
    block_00037 = {
        {"text"},
        text = {
            ja = {
                {
                    "希腊神话中的喀迈拉,据说是山羊的躯体上长着狮子的头与蛇的尾巴",
                    {"rt2"},
                    "、口吐烈焰的怪物。"
                }
            }
        },
        linkback = "block_00036",
        linknext = "block_00038"
    },
    block_00038 = {
        {"text"},
        text = {
            ja = {
                {
                    "然而莫罗笔下的喀迈拉,却是马的身体配上人类的上半身,还生着双",
                    {"rt2"},
                    "翼,与其说是喀迈拉,倒更接近肯陶洛斯或者珀伽索斯。"
                }
            }
        },
        linkback = "block_00037",
        linknext = "block_00039"
    },
    block_00039 = {
        {"text"},
        text = {
            ja = {
                {"又或者店名指的不是莫罗的喀迈拉,说不定出自哪部小说。"}
