    block_00136 = {
        {"bg", speed = 150000, zoom = 80, time = 2000, file = "zev_app_h01_01", path = ":ev/ev_app_h01/", set = "ev_app_h01", x2 = -190, y2 = 0, x = -480, y = 200, ax = 1920, ay = 1080, bx = -960, by = -540},
        {"bgm", file = "bgm103", time = 1000},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003046", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「——优美，舒服吗？」"
                }
            }
        },
        labelcount = 1,
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900057", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「诶？　里、里奈？　为什么里奈会？　还有？　我？？　已经不",
                    {"rt2"},
                    "是义贞了？？」"
                }
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003047", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「怎么了？　优美？　啾——、啾，比刚才涨得还红呢……果然比起",
                    {"rt2"},
                    "义贞大人，优美的小鸡鸡更敏感吗？」"
                }
            }
        },
        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900058", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「诶？　为、为什么？　为什么只有我身上还留着小鸡鸡？？」"
                }
            }
        },
        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003048", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「因为优美扮的是义贞大人呀，小鸡鸡当然是必要的吧？　所以，",
                    {"rt2"},
                    "就像小伯奇做过的那样，我会好好安慰你的哦，优美」"
                }
            }
        },
        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
        {"text"},
        delay = {
            vl01 = {
                {"quake", mode = "mw"}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_yum_900059", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「诶？　嗯啊、啊、啊、好、好厉害……什么？　这是？　好厉害…",
                    {"rt2"},
                    "…这种感觉——」"
                }
            }
        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003049", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「啾噜、啾噜、啾噜噜——、啾啪，舒服吗？　优美？　喜欢我这样",
                    {"rt2"},
                    "用嘴巴舔你的小鸡鸡吗？」"
                }
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"text"},
        delay = {
            vl01 = {
                {"quake", mode = "mw"}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_yum_900060", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「舒、舒不舒服根本不是这个问题……呜嗯——这、这种、岂、岂止",
                    {"rt2"},
                    "是舒服啊啊啊……因为，里奈在、里奈在、里奈在用嘴给我的……」"
                }
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003050", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「啾噜——我的嘴巴怎么了？　在做什么呢？」"
                }
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900061", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「诶？　啊——、啊嗯，里奈在、里奈在，给我舔小鸡鸡」"
                }
            }
        },
        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003051", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「可爱、真可爱呢优美。这身姿好怀念。大概是和义贞同岁时候的",
                    {"rt2"},
                    "样子吧。刚系上我送的缎带那会儿的优美」"
                }
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900062", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那时候的？　我？　嗯啊？　咦？　这副样子……、嗯啾、嗯呀",
                    {"rt2"},
                    "、啊嗯……」"
                }
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"bg", file = "white", path = ":bg/"},
        {"bg", file = "ev_app_h01_02", path = ":ev/ev_app_h01/", set = "ev_app_h01"},
        {"text"},
        text = {
            ja = {
                {
                    "并不是和里奈同岁的年纪。这是我头发刚开始留长时的样子。所以，",
