        {"msgon", time = 2000},
        {"text"},
        text = {
            ja = {
                {
                    "那句话响过三遍，那个梦便会开始。「换过来吧」据说，它的意思",
                    {"rt2"},
                    "是「想要取而代之」。"
                }
