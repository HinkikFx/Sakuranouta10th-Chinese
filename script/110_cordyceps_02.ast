        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900064", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「是、是这样吗？　所、所以我才穿着这身制服，里奈才是那时候",
                    {"rt2"},
                    "的、嗯？？　嗯呀！？　什、什么呀、这是……、啊、啊————啊啊",
                    {"rt2"},
                    "、不行、好厉害、这是什么呀……」"
                }
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            ja = {
                {"舌头比方才更紧地缠上小鸡鸡，我当场腰都要软了。"}
            }
        },
        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            ja = {
                {"连站都站不稳。"}
