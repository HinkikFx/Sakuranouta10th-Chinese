        },
        text = {
            vo = {
                {"vo", file = "fem_yum_900059", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「欸？　嗯啊，啊、好……好厉害……什么？　这是什么？　好厉害",
                    {"rt2"},
                    "……这种……」"
                }
            }
