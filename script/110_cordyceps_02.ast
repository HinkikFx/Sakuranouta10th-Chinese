        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"text"},
        text = {
            ja = {
                {"逃离那场灾厄、最初抵达这樱花之森下时，两人只是彼此凝望。"}
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"text"},
        text = {
            ja = {
                {
                    "然后，两人再没能做出更多的事，只是对视着任时间流逝，不知不",
