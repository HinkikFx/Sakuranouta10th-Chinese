    },
    block_00056 = {
        {"text"},
        text = {
            ja = {
                {"我将身子委予那包裹着我男子性器官的温暖触感。"}
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"text"},
        text = {
            ja = {
                {"男子性器官仿佛在炫耀自己一般，怒胀着。"}
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            ja = {
                {
                    "可这名为男子性器官的东西，却让我变得与它的模样全然不符地娇",
                    {"rt2"},
                    "弱。"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"text"},
        text = {
            ja = {
                {"这个器官，把我变成了没出息的模样。"}
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003029", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈", "伯奇"},
                    "「什么都不回答吗？　您要是这种态度，我可就不做了哦？」"
                }
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900050", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美", "义贞"},
                    "「啊、啊啊……不要停，请不要停下」"
                }
            }
