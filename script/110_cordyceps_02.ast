    block_00151 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003053", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「详细的我也不清楚，不过小伯奇应该比义贞大人年幼哦？　咧噜",
                    {"rt2"},
                    "、咧噜、啾噜……啾……大概，是那两人意念的残滓还包裹着我们吧",
