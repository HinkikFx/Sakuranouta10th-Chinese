        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            ja = {
                {"现在的我是义贞。"}
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"text"},
        text = {
            ja = {
                {"而跪在我身前、玩弄着我小鸡鸡的，是名为伯奇的少女。"}
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            ja = {
                {"然而，明明应当如此。"}
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003030", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈", "伯奇"},
                    "「你这表情，真的一脸舒服呢……」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            ja = {
                {
                    "那双眸子分明就是今早见到的。那美丽而妖艳的笑容，毫无疑问。",
                    {"rt2"},
                    "正是她。"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            ja = {
                {"事实上，正如里奈所说，这个梦不只她，我也做过许多次。"}
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"text"},
        text = {
            ja = {
                {"越过几度死亡，总会抵达这片樱花之森下。"}
