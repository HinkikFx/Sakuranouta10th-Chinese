                {"vo", file = "fem_yum_900066", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「你、你看不就知道了……嗯啊呜……小鸡鸡能被舔的地方、这么多，",
                    {"rt2"},
                    "这么舒服的部分要是这么多，肯定会不行的嘛……啊、啊、啊、好",
                    {"rt2"},
                    "厉害……」"
                }
