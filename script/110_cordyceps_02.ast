        linknext = "block_00055"
    },
    block_00055 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900049", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美", "义贞"},
                    "「啊……啊啊……」"
                }
            }
        },
        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"text"},
        text = {
            ja = {
                {"我将身体交托给包裹着我小鸡鸡的温暖触感。"}
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"text"},
        text = {
            ja = {
                {"小鸡鸡仿佛在炫耀自身一般怒张着。"}
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            ja = {
                {
                    "但这个小鸡鸡所带来的感受，远超其外表所能想象——它让我变得如",
                    {"rt2"},
                    "此软弱。"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"text"},
        text = {
            ja = {
                {"这个器官，将我变成了窝囊的模样。"}
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003029", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈", "伯奇"},
                    "「什么都不回答吗？　那种态度的话，我可要停下来了哦？」"
                }
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900050", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美", "义贞"},
                    "「啊，啊啊……不要停，请不要停」"
                }
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            ja = {
                {"现在的我是义贞。"}
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"text"},
        text = {
            ja = {
                {"而跪在我面前，玩弄着我小鸡鸡的是被唤作伯奇的少女。"}
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            ja = {
                {"应该是这样——本应如此——"}
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003030", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈", "伯奇"},
                    "「你真的是一脸舒服的表情呢……」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            ja = {
                {"那双眸子无疑是今晨见到的。美丽又妖艳的笑容，确确实实。是她。"}
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            ja = {
                {"事实上，正如里奈所说，这个梦不仅她在做，我也做了很多次。"}
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"text"},
        text = {
            ja = {
                {"经历了几次死亡，总是会来到这片樱花林下。"}
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"text"},
        text = {
            ja = {
                {"而且，在这片樱花林下发生的事情也在一点一点地变化着。"}
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"text"},
        text = {
            ja = {
                {
                    "逃脱了那场灾厄，最初来到这片樱花林下时，两个人只是互相注视",
                    {"rt2"},
                    "着。"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"text"},
        text = {
            ja = {
                {
                    "然后，两个人都无法再做更多的事情，只是对视着让时间流逝，然",
                    {"rt2"},
                    "后不知不觉间意识远去，醒了过来。"
                }
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"text"},
        text = {
            ja = {
                {
                    "大概是因为义贞和伯奇都还年幼，不知道该如何支配好不容易得到",
                    {"rt2"},
                    "的两人独处的时光。"
                }
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"text"},
        text = {
            ja = {
                {"持续了数日的沉默，逐渐开始转变。"}
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            ja = {
                {"这片纯白樱花的天空，很容易就被染上了颜色。"}
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"text"},
        text = {
            ja = {
                {"最初是羞涩的亲吻。"}
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            ja = {
                {"然后渐渐变成了浓烈的吻。"}
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"text"},
        text = {
            ja = {
                {
                    "那条舌头所游走的位置，也逐渐变成了更敏感、更能感受彼此的地",
                    {"rt2"},
                    "方。"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            ja = {
                {"那种变化仿佛要将伯奇这个纯白的存在改质一般。"}
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"mwact", act = "うなづく", size = 3, time = 500},
