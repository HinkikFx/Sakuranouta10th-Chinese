        linkback = "block_00020",
        linknext = "block_00022"
    },
    block_00022 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这可不像你啊」"
                }
            }
        },
        linkback = "block_00021",
        linknext = "block_00023"
    },
    block_00023 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1d0100", face = "d0005", head = "mak_z1d", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1d0100", face = "d0018", head = "mak_z1d", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_002122", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「刚才那是反问句哦。做不了吗？后面接的是——怎么可能做不了」"
                }
            }
        },
        linkback = "block_00022",
        linknext = "block_00024"
    },
    block_00024 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1d0100", face = "d0011", head = "mak_z1d", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002123", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「只不过呢，早上我也说过，这世上也存在着绝对无法逆转的才能",
                    {"rt2"},
                    "差距」"
                }
            }
        },
        linkback = "block_00023",
        linknext = "block_00025"
    },
    block_00025 = {
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", speed = 500000, file = "zbg060a", path = ":bg/", x2 = 960, y2 = -300, x = -600, y = -300, ax = 1920, ay = 1080, bx = -960, by = -540, sync = 0},
        {"extrans", time = 500},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002124", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「你知道那部作品吗？　毛姆的『月亮与六便士』」"
                }
            }
        },
        linkback = "block_00024",
        linknext = "block_00026"
    },
    block_00026 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002125", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「里面有一个像是以保罗・高更为原型的、荒唐透顶的艺术家」"
                }
            }
        },
        linkback = "block_00025",
        linknext = "block_00027"
    },
    block_00027 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002126", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「他利用被自己才能所倾倒的三流艺术家的好意，夺走了人家的妻",
                    {"rt2"},
                    "子，甚至把那位妻子逼到了自杀的地步」"
                }
            }
        },
        linkback = "block_00026",
        linknext = "block_00028"
    },
    block_00028 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002127", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「可是，那个艺术家丝毫没有露出悔意，而迷恋他才能的那个男子",
                    {"rt2"},
                    "人，也原谅了那位天才艺术家」"
                }
            }
        },
        linkback = "block_00027",
        linknext = "block_00029"
    },
    block_00029 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嘛，毛姆作品里的天才艺术家和高更本人之间应该还是有不少差",
                    {"rt2"},
                    "别的……」"
                }
            }
        },
        linkback = "block_00028",
        linknext = "block_00030"
    },
    block_00030 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002128", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「不过，我觉得那是一部了不起的作品」"
                }
            }
        },
        linkback = "block_00029",
        linknext = "block_00031"
    },
    block_00031 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002129", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「身为文学天才的毛姆与高更相对峙的姿态，也写得非常好」"
                }
            }
        },
        linkback = "block_00030",
        linknext = "block_00032"
    },
    block_00032 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002130", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「毛姆作为大众作家活了一生。而且他以此为荣。可是，那个以高",
                    {"rt2"},
                    "更为原型的天才艺术家，却是能够无视大众的、最后一位孤高的艺",
                    {"rt2"},
                    "术家」"
                }
            }
        },
        linkback = "block_00031",
        linknext = "block_00033"
    },
    block_00033 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002131", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「在这个时代，像高更那样孤高的艺术家已经不可能存在了。所谓",
                    {"rt2"},
                    "艺术家，只可能是小丑而已」"
                }
            }
        },
        linkback = "block_00032",
        linknext = "block_00034"
    },
    block_00034 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002132", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「所谓艺术，不过是在布景剧场里装模作样地表演罢了」"
                }
            }
        },
        linkback = "block_00033",
        linknext = "block_00035"
    },
    block_00035 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002133", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「可是，毛姆当真也是那样吗？」"
                }
            }
        },
        linkback = "block_00034",
        linknext = "block_00036"
    },
    block_00036 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002134", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「最后的孤高艺术家，与大众艺术家那近乎爽快的刻薄劲儿，我觉",
                    {"rt2"},
                    "得实在痛快极了」"
                }
            }
        },
        linkback = "block_00035",
        linknext = "block_00037"
    },
    block_00037 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002135", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「毛姆虽然与高更之间存在落差，却依然能够站得住。可那个不过",
                    {"rt2"},
                    "是三流艺术家的男子人，就只能任人摆布了」"
                }
            }
        },
        linkback = "block_00036",
        linknext = "block_00038"
    },
    block_00038 = {
        {"msgoff"},
        {"bg", file = "bg060a", path = ":bg/", sync = 0},
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0001", head = "mak_z1a", lv = 4, id = 9, sync = 0},
        {"extrans", time = 500},
