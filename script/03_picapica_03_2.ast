        linkback = "block_00020",
        linknext = "block_00022"
    },
    block_00022 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不像你啊」"
                }
            }
        },
        linkback = "block_00021",
        linknext = "block_00023"
    },
    block_00023 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1d0100", face = "d0005", head = "mak_z1d", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1d0100", face = "d0018", head = "mak_z1d", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_002122", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「刚才那是反问。'我什么也做不了吗？'后面接的是'怎么可能'」"
                }
            }
        },
        linkback = "block_00022",
        linknext = "block_00024"
    },
    block_00024 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1d0100", face = "d0011", head = "mak_z1d", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002123", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「不过呢，早上也说了，这世上确实存在着绝对无法逾越的才能差",
                    {"rt2"},
                    "距」"
                }
            }
        },
        linkback = "block_00023",
        linknext = "block_00025"
    },
    block_00025 = {
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", speed = 500000, file = "zbg060a", path = ":bg/", x2 = 960, y2 = -300, x = -600, y = -300, ax = 1920, ay = 1080, bx = -960, by = -540, sync = 0},
        {"extrans", time = 500},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002124", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「你知道那个吗？　毛姆的《月亮与六便士》」"
                }
            }
        },
        linkback = "block_00024",
        linknext = "block_00026"
    },
    block_00026 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002125", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「里面出了一个以保罗·高更为原型的、荒唐至极的艺术家」"
                }
            }
        },
        linkback = "block_00025",
        linknext = "block_00027"
    },
    block_00027 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002126", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「他利用了一个被他的才华所倾倒的三流艺术家的好意，夺走了那",
                    {"rt2"},
                    "人的妻子，甚至把那个妻子逼到了自杀」"
                }
            }
        },
        linkback = "block_00026",
        linknext = "block_00028"
    },
    block_00028 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002127", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「但那个艺术家丝毫没有反省的意思，而被他的才华所折服的那个",
                    {"rt2"},
                    "男子人，也原谅了那个天才艺术家」"
                }
            }
        },
        linkback = "block_00027",
        linknext = "block_00029"
    },
    block_00029 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，毛姆笔下的天才艺术家和真实的高更之间确实有不少不同…",
                    {"rt2"},
                    "…」"
                }
            }
        },
        linkback = "block_00028",
        linknext = "block_00030"
    },
    block_00030 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002128", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「但我觉得那是一部了不起的作品」"
                }
            }
        },
        linkback = "block_00029",
        linknext = "block_00031"
    },
    block_00031 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002129", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「身为文学天才的毛姆与高更对峙的姿态，也描绘得非常精彩」"
                }
            }
        },
        linkback = "block_00030",
        linknext = "block_00032"
    },
    block_00032 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002130", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「毛姆以大众作家的身份活着。并且对此感到自豪。但是以高更为",
                    {"rt2"},
                    "原型的天才艺术家，却是一个能够无视大众的、最后的孤高艺术家」"
                }
            }
        },
        linkback = "block_00031",
        linknext = "block_00033"
    },
    block_00033 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002131", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「在这个时代，不可能存在像高更那样孤高的艺术家了。艺术家不",
                    {"rt2"},
                    "过是小丑罢了」"
                }
            }
        },
        linkback = "block_00032",
        linknext = "block_00034"
    },
    block_00034 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002132", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「所谓艺术，无非是在布景舞台上装模作样而已」"
                }
            }
        },
        linkback = "block_00033",
        linknext = "block_00035"
    },
    block_00035 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002133", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「但是，毛姆真的是那样吗？」"
                }
            }
        },
        linkback = "block_00034",
        linknext = "block_00036"
    },
    block_00036 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002134", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「最后的孤高艺术家和大众艺术家那种痛快淋漓的刻薄，我觉得真",
                    {"rt2"},
                    "的很爽快」"
                }
            }
        },
        linkback = "block_00035",
        linknext = "block_00037"
    },
    block_00037 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002135", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「毛姆与高更之间存在着巨大的差距，但他依然站住了脚。然而那",
                    {"rt2"},
                    "个普通的三流艺术家，却只能被命运玩弄」"
