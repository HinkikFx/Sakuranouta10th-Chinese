    },
    block_00016 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0027", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002118", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我也看到了那条新闻……中村制药得到了草薙健一郎七部作中的",
                    {"rt2"},
                    "六件作品什么的……」"
