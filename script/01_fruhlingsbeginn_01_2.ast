    block_00161 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嘛，算了。我也确实有不注意的地方。说实话，我自己也觉得有",
                    {"rt2"},
                    "点不妥……」"
                }
            }
        },
