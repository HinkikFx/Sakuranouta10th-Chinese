    },
    block_00163 = {
        {"text"},
        text = {
            ja = {
                {"蓝沮丧地垂下了头。"}
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"fg", mode = -2},
        {"text"},
        text = {
            ja = {
                {"蓝平时总是叫我“草薙”。"}
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"text"},
        text = {
            ja = {
                {"这并非从前就如此。"}
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            ja = {
                {"草薙健一郎还在世的时候，她是叫我直哉的。"}
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"text"},
        text = {
            ja = {
                {"当然，姓草薙的有两个人，用名字来称呼也是常事。"}
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            ja = {
                {
                    "即便如此，自从蓝当上教师以后，她似乎就尽量提醒自己要叫我“草",
                    {"rt2"},
                    "薙”。"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            ja = {
                {
                    "这大概也是为了避免在学校里一时嘴快，单单对一个学生直呼其名",
                    {"rt2"},
                    "吧。"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            ja = {
                {"所以，老爸死后，蓝一直叫我“草薙”。"}
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            ja = {
                {
                    "然而，就像现在这样，每当情绪外露的时候，从蓝口中说出的名字，",
                    {"rt2"},
                    "就会从“草薙”变回“直哉”。"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            ja = {
                {"大概是脱口而出的吧。"}
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            ja = {
                {"（再逼问蓝下去也没什么意义……）"}
