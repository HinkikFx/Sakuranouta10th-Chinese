        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不是维持现状,而是在这之后……、如果可以的话,我希望您能和禀",
                    {"rt2"},
                    "和解」"
