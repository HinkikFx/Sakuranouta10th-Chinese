        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但现在不同了。梦,只有在正确醒来之时才是梦。不会醒的梦已不",
