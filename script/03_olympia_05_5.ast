        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「看见了、没看见,或许都无关紧要。说得更极端些,连它是什么、",
                    {"rt2"},
                    "是怎样一种现象,也……」"
                }
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「重要的只是,在那一刻,自己感受到了什么、想到了什么,以及,相信",
                    {"rt2"},
                    "了什么……我是这么认为的」"
                }
