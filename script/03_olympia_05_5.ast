        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「看见了、没看见，也许都无所谓。更进一步说，它是什么、是怎",
                    {"rt2"},
                    "样的现象，恐怕也……」"
                }
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「重要的只是，在那个时刻，自己感受到了什么、想到了什么、又",
                    {"rt2"},
                    "相信了什么……我认为是这样的」"
                }
            }
