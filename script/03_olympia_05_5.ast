    block_00051 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以想保护禀，不是什么温柔。我之所以说您没有罪，是因为我",
                    {"rt2"},
                    "想让禀幸福」"
                }
            }
