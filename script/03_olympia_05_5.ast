        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「珍惜属于自己的东西，既不是温柔也不是什么了不起的事。只是",
                    {"rt2"},
                    "自私罢了」"
                }
            }
