        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「禀需要父亲。母亲不在了,本来,您才应该是支撑着她的那个人」"
