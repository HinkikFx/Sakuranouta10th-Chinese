    block_00150 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「您刚才那一拳,是为了给女儿被抢走这件事做个了断吧?是因为下",
                    {"rt2"},
                    "定决心把一切都托付给我,才揍的我吧?」"
                }
            }
        },
        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"fg", ch = "稟父親", size = "z1", ex03 = "a0097", mode = 3, path = ":fg/mtt/z1/", file = "mtt_z1a0000", face = "a0004", head = "mtt_z1a", lv = 4, id = 9},
        {"fgact", ch = "稟父親", act = "おじぎ", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mtt_000057", ch = "mtt"}
            },
            ja = {
                {
                    name = {"御樱父亲"},
                    "「啊,没错……。可是,如今的我,难道连被你回敬一拳的价值都没有了",
                    {"rt2"},
                    "吗……」"
                }
            }
        },
        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那还用说。这种软绵绵拳头的人,我可揍不下手。先好好吃饭,把",
                    {"rt2"},
                    "身子练壮实,能打出一拳撂倒我的力道再说……」"
                }
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"fg", ch = "稟父親", size = "z1", ex03 = "a0097", mode = 3, path = ":fg/mtt/z1/", file = "mtt_z1a0000", face = "a0001", head = "mtt_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mtt_000058", ch = "mtt"}
            },
            ja = {
                {
                    name = {"御樱父亲"},
                    "「直哉君……」"
                }
            }
        },
        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「现在,我收下了您的女儿。拿刚才那记轻飘飘的拳头当聘礼,未免",
                    {"rt2"},
                    "也太便宜了,不过嘛,我就收下了」"
                }
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以,禀从现在起就是我的人了。已经不再是您的了」"
                }
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"fg", ch = "稟父親", size = "z1", ex03 = "a0097", mode = 3, path = ":fg/mtt/z1/", file = "mtt_z1a0000", face = "a0004", head = "mtt_z1a", lv = 4, id = 9},
        {"text"},
