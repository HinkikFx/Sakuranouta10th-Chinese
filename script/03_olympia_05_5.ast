                    "「反过来，平凡的日常，也许也是不可思议现象的一部分……」"
                }
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"fg", ch = "稟父親", size = "z1", ex03 = "a0097", mode = 3, path = ":fg/mtt/z1/", file = "mtt_z1a0000", face = "a0002", head = "mtt_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mtt_000039", ch = "mtt"}
            },
            ja = {
                {
                    name = {"御樱父亲"},
                    "「不愧是艺术家的儿子啊。说的话很深奥……很哲学」"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不，既不哲学也不艺术。如果无法传达的话，那只是我表达不够",
                    {"rt2"},
                    "清楚而已」"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「只是，面对不可理解之物时，我觉得重要的是人在面对那种不可",
                    {"rt2"},
                    "理解时感受到了什么」"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「它是什么、它曾经是什么，那样的解释多少都能做。不管是用神",
                    {"rt2"},
                    "秘主义的方式，还是用合理主义的方式，大概都可以做到」"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但是，每个人应该都明白。当人站在不可理解之物面前时，最重",
                    {"rt2"},
                    "要的既不是解释也不是诠释……」"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「在那个瞬间，感受到了什么……我觉得那才是最重要的」"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"fg", ch = "稟父親", size = "z1", ex03 = "a0097", mode = 3, path = ":fg/mtt/z1/", file = "mtt_z1a0000", face = "a0004", head = "mtt_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mtt_000040", ch = "mtt"}
            },
            ja = {
                {
                    name = {"御樱父亲"},
                    "「……」"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为，即使在一切都被解释清楚之后，人们依然会在那份不可理",
                    {"rt2"},
                    "解面前，一次又一次地驻足……」"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你因为看见了我才信吗？那没有看见就信的人有福了」"
                }
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"fg", ch = "稟父親", size = "z1", ex03 = "a0097", mode = 3, path = ":fg/mtt/z1/", file = "mtt_z1a0000", face = "a0003", head = "mtt_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mtt_000041", ch = "mtt"}
            },
            ja = {
                {
                    name = {"御樱父亲"},
                    "「是圣经吗？」"
                }
            }
        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「好像是。这是朋友告诉我的」"
                }
            }
