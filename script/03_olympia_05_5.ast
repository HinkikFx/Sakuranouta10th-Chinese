                {
                    name = {"直哉"},
                    "「谁知道呢……。不过,亲眼所见的也未必就是事实。那些被认为不",
                    {"rt2"},
                    "可思议的东西,或许其实也只是毫不费解的日常」"
                }
            }
        },
        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「反过来,再平凡不过的日常,说不定也是不可思议现象的一部分……」"
                }
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"fg", ch = "稟父親", size = "z1", ex03 = "a0097", mode = 3, path = ":fg/mtt/z1/", file = "mtt_z1a0000", face = "a0002", head = "mtt_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mtt_000039", ch = "mtt"}
            },
            ja = {
                {
                    name = {"御樱父亲"},
                    "「不愧是艺术家的儿子。说的话真深奥……很有哲学味」"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,既不哲学也不艺术,什么都算不上。如果没能传达给您,那只是",
                    {"rt2"},
                    "我解释得不够罢了」"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「只是,当不可解之物出现在眼前时,那一刻,人从那份不可解中感受",
                    {"rt2"},
                    "到了什么,我认为这才是重要的」"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「它是什么、它曾是什么,这样的解释要多少有多少。用神秘主义的",
                    {"rt2"},
                    "方式,乃至用理性主义的方式,大概都能解释得通」"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「可是,任何人应该都明白。当人站在不可解之物面前时,最重要的",
                    {"rt2"},
                    "既不是说明,也不是解释……」"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「在那一刻,自己感受到了什么……我认为这才是重要的」"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"fg", ch = "稟父親", size = "z1", ex03 = "a0097", mode = 3, path = ":fg/mtt/z1/", file = "mtt_z1a0000", face = "a0004", head = "mtt_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mtt_000040", ch = "mtt"}
            },
            ja = {
                {
                    name = {"御樱父亲"},
                    "「……」"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为,即便一切都被解释穷尽之后,人依然会在那份不可解面前,一",
                    {"rt2"},
                    "次又一次地伫立失语……」"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你因看见了我才信;那没有看见就信的,有福了」"
                }
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"fg", ch = "稟父親", size = "z1", ex03 = "a0097", mode = 3, path = ":fg/mtt/z1/", file = "mtt_z1a0000", face = "a0003", head = "mtt_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mtt_000041", ch = "mtt"}
            },
            ja = {
                {
                    name = {"御樱父亲"},
                    "「圣经吗?」"
                }
            }
