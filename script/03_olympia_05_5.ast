        linkback = "block_00049",
        linknext = "block_00051"
    },
    block_00051 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以,我想保护禀,并不是出于什么温柔。我说您没有罪,是因为我",
                    {"rt2"},
                    "想让禀幸福」"
                }
            }
