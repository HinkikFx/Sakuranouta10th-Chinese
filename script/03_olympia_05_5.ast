        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但现在不同了。梦只有在正确醒来的时候才是梦。不醒来的梦已",
