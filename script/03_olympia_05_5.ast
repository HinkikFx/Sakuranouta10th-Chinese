        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「想要珍惜属于自己的东西,这既不是温柔也不是什么美德。只是单",
                    {"rt2"},
                    "纯的自私罢了」"
                }
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以,我不会恨您……不,不止如此,我更不希望禀恨着您」"
