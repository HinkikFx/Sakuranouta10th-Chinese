        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但是,等您恢复到能一拳把我打飞的力气时,我就把禀还给您」"
