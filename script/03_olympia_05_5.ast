        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「只要有那样的臂力,只要有那样的气力,您就一定能再次以父亲的",
                    {"rt2"},
                    "身份守护她……」"
                }
            }
