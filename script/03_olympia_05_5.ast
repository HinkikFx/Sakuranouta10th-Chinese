        linkback = "block_00085",
        linknext = "block_00087"
    },
    block_00087 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以,从那一天、从樱花盛开的那天延续至今的现实,或许会因为",
                    {"rt2"},
