        linknext = "block_00165"
    },
    block_00165 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「哪里,禀的父亲您突然来一句“让我揍你一拳”,才够我行我素吧。一",
