    },
    block_00074 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002896", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「嗯……太不可思议了……那简直就像――」"
