        linknext = "block_00073"
    },
    block_00073 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001165", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不可思议?」"
