        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            ja = {
                {
                    "那沉睡了千年的梦,是否就那样保持着花蕾的模样,未及绽放便腐朽",
                    {"rt2"},
                    "了呢?"
                }
            }
        },
        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            ja = {
                {"若是那样,千年之梦也未免太过短促无常……。"}
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002907", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「千年的沉眠,是不是太漫长了呢……」"
                }
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            ja = {
                {
                    "梦中的伯奇固然让我挂心,但那终究是遥远的过去,或者只是梦中的",
                    {"rt2"},
                    "故事,"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            ja = {
                {"还不至于让我投入更多的关心。"}
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
