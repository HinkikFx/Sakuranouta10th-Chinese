                    "「怎么了?　总觉得里奈……好像不太高兴……」"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001158", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不高兴吗……也许是吧……」"
                }
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
