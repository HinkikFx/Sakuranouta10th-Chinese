        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002890", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「诶?　真、真的是因为我?」"
