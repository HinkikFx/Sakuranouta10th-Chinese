        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001160", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「没错,优美……只有优美,才能扰乱我的心……」"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002891", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「为、为什么?」"
                }
            }
