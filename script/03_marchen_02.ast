        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001166", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「就像?」"
                }
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002897", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「秋夜,在遥远的彼方,有一片尽是小石的河滩」"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002898", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「阳光在那里,沙沙地沙沙地照射着」"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002899", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「说是阳光,却宛如硅石一般,宛如无比坚实的固体的粉末」"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002900", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「正因如此,它才沙沙地发出细微的声响」"
                }
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002901", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「而此刻,一只蝴蝶正停在小石上,投下淡淡的、却又轮廓分明的影",
                    {"rt2"},
                    "子」"
                }
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002902", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「不久,当那蝴蝶消失了踪影,不知何时,在至今不曾有水流过的河床",
                    {"rt2"},
                    "上,水正沙沙地、沙沙地流淌着……」"
                }
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
