    block_00136 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002916", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「テムポ正しき散歩をなして",
                    {"txruby", text = "ばくかんさなだ"},
