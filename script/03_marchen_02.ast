        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001159", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「答对了!　答对了!」"
