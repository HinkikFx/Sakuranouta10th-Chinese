        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"bg", file = "ev_com_e02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_e02/", set = "ev_com_e02"},
        {"text"},
        text = {
            ja = {
                {"我伸手抓住两人的身影。"}
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"text"},
        text = {
            ja = {
                {"手中没有两人的触感,"}
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"text"},
        text = {
            ja = {
                {"只有自己指甲掐入掌心的痛楚。"}
            }
        },
        linkback = "block_00126",
        linknext = "block_00128"
    },
    block_00128 = {
        {"text"},
        text = {
            ja = {
                {"我想起了里奈的话。"}
            }
        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002912", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「觉得这首诗,很衬某个人……」"
                }
            }
        },
        linkback = "block_00128",
        linknext = "block_00130"
    },
    block_00130 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002913", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「也许吧……」"
                }
            }
        },
        linkback = "block_00129",
        linknext = "block_00131"
    },
    block_00131 = {
        {"bg", file = "ev_com_e02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_e02/", set = "ev_com_e02"},
        {"text"},
        text = {
            ja = {
                {"摊开手,两人的身影已经不在。"}
            }
        },
        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"text"},
        text = {
            ja = {
                {"从我的手中消失了。"}
            }
        },
        linkback = "block_00131",
        linknext = "block_00133"
    },
    block_00133 = {
        {"text"},
        text = {
            ja = {
                {"我在那里叹了口气。"}
            }
        },
        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"bg", file = "ev_com_e02_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_e02/", set = "ev_com_e02"},
        {"se", file = "se9010", vol = 30, id = 1},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002914", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「虽然生出了奉献的心情,却也做不成什么特别的事」"
                }
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002915", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「于是比从前,读书更加精熟。于是比从前,待人更加恭谨」"
                }
            }
        },
        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002916", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「迈着节奏端正的步子散步,虔诚地编着麦秆的细辫――」"
                }
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002917", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「这样一来,简直是玩具兵,这样一来,简直天天是星期天」"
                }
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002918", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「在神社的向阳处,缓缓踱步,遇见熟人,便微微一笑」"
                }
            }
        },
        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002919", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「和卖糖的老爷爷,交上朋友,又朝鸽子,哗啦啦撒些豆子」"
                }
            }
        },
        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002920", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「日头晃眼了,就躲进树荫,在那里重新打量地面与草木」"
                }
            }
        },
        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002921", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「青苔实在是,沁凉宜人,无以言表的,今日丽日」"
                }
            }
        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002922", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「参拜的人们络绎而行,我,什么都不会动气」"
                }
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002923", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「人生诚然,一瞬之梦,　恰似橡皮气球,那般美丽」"
                }
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002924", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「升上天空,闪闪发光,而后消失――呀,今天,您可安好」"
                }
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002925", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「好久不见,近来如何。就在附近哪里,喝杯茶吧」"
                }
            }
        },
        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002926", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「兴冲冲走进茶馆,可要说话题,却总是没有」"
                }
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002927", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「闷闷地抽着烟卷,下着难以名状的决心,――」"
                }
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002928", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「门外实在是热闹非凡!――那么改日再会,替我问候尊夫人」"
                }
            }
        },
        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002929", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「去了",
                    {"txruby", text = "那边"},
                    "外国",
                    {"txruby"},
                    ",请来个信。酒啊,还是别喝太多的好」"
                }
            }
        },
        linkback = "block_00148",
        linknext = "block_00150"
    },
    block_00150 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002930", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「马车驶过,电车也驶过。人生诚然,恰似新嫁娘」"
                }
            }
        },
        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002931", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「耀眼,美丽,又低垂着头,可要让她开口说话,就腻烦了么?」"
                }
            }
        },
        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002932", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「即便如此,仍令人心头恍惚,人生,诚然,恰似新嫁娘」"
                }
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002933", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「……」"
                }
            }
        },
        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002934", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那么各位,莫要过喜,莫要过悲,以端正的节奏,来握手吧」"
                }
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002935", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「也就是说,我等所欠缺的,就当它是,诚实正直之类」"
                }
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002936", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「好,那么各位,好,一起来――以端正的节奏,来握手吧」"
                }
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002937", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「……」"
                }
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002938", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「……再见吧。木偶人……」"
                }
            }
        },
        linkback = "block_00157",
        linknext = "block_00159"
    },
