        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001161", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「怎么说呢……大概是因为,优美最近变得太可爱了……吧」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002892", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「诶?　是、是这样吗?」"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001162", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯,最近优美太可爱了,成了大家的红人呢」"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002893", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「哪、哪有。才不是什么红人呢。只是,太过冷淡的话也会给里奈添",
                    {"rt2"},
                    "麻烦,所以我才按自己的方式待人和气一点……」"
                }
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001163", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「该怎么办才好呢。优美和大家处得好,我是很高兴……可总觉得心",
                    {"rt2"},
                    "里有些不是滋味呢」"
                }
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002894", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「怎么会,说什么不是滋味……里奈,我是属于里奈的。我只是想被里",
                    {"rt2"},
                    "奈喜欢而已」"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
