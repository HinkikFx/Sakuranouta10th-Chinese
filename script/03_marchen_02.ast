    },
    block_00137 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002917", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「まるでこれでは、",
                    {"txruby", text = "おもちや"},
                    "玩具",
                    {"txruby"},
                    "の兵队、まるでこれでは、毎日、日曜」"
