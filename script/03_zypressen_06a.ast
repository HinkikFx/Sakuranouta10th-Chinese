        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么啊。是在挖苦我之前忘了你的妹妹设定是怎么来的吗？」"
                }
