        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但是啊，被人擅自划出一条界线，也挺让人为难的」"
                }
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「说什么我是妹妹设定，绝不会越过这条线之类的」"
                }
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"bg", file = "ev_com_d06_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d06/", set = "ev_com_d06"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001903", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不，可是，不那样做的话，我就没办法待在学长身边了」"
                }
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那我倒反过来问你？」"
                }
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「要是对方跨过了那条线，你怎么办？」"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"bg", file = "ev_com_d06_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d06/", set = "ev_com_d06"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001904", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「诶？」"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那样也还要坚持妹妹设定吗？　我总觉得那种东西挺奇怪的」"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那种设定，还是只存在于游戏啊漫画啊那些虚构世界里就好」"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「现实的人际关系里，就算划了一条线，人也会轻易地跨过去，那",
                    {"rt2"},
                    "种线很快就会变得模糊不清……」"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"bg", file = "ev_com_d06_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d06/", set = "ev_com_d06"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001905", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「……禀学姐」"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「禀怎么了？」"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001906", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「禀学姐是个美人」"
                }
