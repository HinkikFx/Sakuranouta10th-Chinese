        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「比如对幼儿园的老师，不，有时甚至可能对母亲也会产生。但是，",
                    {"rt2"},
                    "那不一样」"
                }
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「淡淡的恋心，和爱一个人，是不同的东西」"
