    },
    block_00176 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001907", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「而且，我想她大概对学长抱有好感」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「也许吧。我小时候，好像也隐约对她抱有过类似淡淡恋心的东西」"
                }
            }
