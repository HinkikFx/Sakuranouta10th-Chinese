        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，抱歉啊。是忘掉了。倒不如说，我根本没想到你会把那种事",
                    {"rt2"},
