        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            ja = {
                {
                    "其他老师慌张、大吼、大闹的时候，蓝只是看着草薙健一郎留下的",
                    {"rt2"},
                    "樱花画。"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"text"},
        text = {
            ja = {
                {
                    "一直一直，在喧嚣之中，就像身处美术馆的观众一样镇定地注视着",
