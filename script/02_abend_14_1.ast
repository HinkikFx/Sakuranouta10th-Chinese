                {"vo", file = "fem_mkd_001484", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「从你嘴里没心没肺地说出来就让人火大」"
                }
            }
        },
        linkback = "block_00041",
        linknext = "block_00043"
    },
    block_00043 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「为什么啊」"
                }
            }
        },
        linkback = "block_00042",
        linknext = "block_00044"
    },
    block_00044 = {
        {"text"},
        text = {
            ja = {
                {"自从完成教会壁画的那天起,发生了许许多多的事。"}
            }
        },
        linkback = "block_00043",
        linknext = "block_00045"
    },
    block_00045 = {
        {"text"},
        text = {
            ja = {
                {"多到寻常暑假根本无法想象的地步。"}
            }
        },
        linkback = "block_00044",
        linknext = "block_00046"
    },
    block_00046 = {
        {"text"},
        text = {
            ja = {
                {"只说结果的话,那幅画被保留了下来,我和美术部也都获准存续。"}
            }
        },
        linkback = "block_00045",
        linknext = "block_00047"
    },
    block_00047 = {
        {"text"},
        text = {
            ja = {
                {"不过,也有例外……。"}
            }
        },
        linkback = "block_00046",
        linknext = "block_00048"
    },
    block_00048 = {
        {"bgm", stop = 1, time = 1000},
        {"bg", file = "white", path = ":bg/"},
        {"bg", zoom = 70, speed = 200000, time = 1500, file = "zev_uni_c25_01", path = ":ev/ev_uni_c25/", set = "ev_uni_c25", x2 = 384, y2 = -50, x = -384, y = -50, ax = 1920, ay = 1080, bx = -960, by = -540},
        {"bgm", file = "bgm110"},
        {"text"},
        text = {
            ja = {
                {"七月的最后一天。"}
            }
        },
        linkback = "block_00047",
        linknext = "block_00049"
    },
    block_00049 = {
        {"text"},
        text = {
            ja = {
                {"不如说,是八月第一天的清晨。"}
            }
        },
        linkback = "block_00048",
        linknext = "block_00050"
    },
    block_00050 = {
        {"text"},
        text = {
            ja = {
                {"那件作品完成了。"}
            }
        },
        linkback = "block_00049",
        linknext = "block_00051"
    },
    block_00051 = {
        {"text"},
        text = {
            ja = {
                {
                    "宛如盛夏骤然狂放盛开的樱花,它突然在教会的墙壁上现出了身姿。",
                    {"rt2"},
                    "草薙健一郎作《樱花们的足迹》。"
                }
            }
        },
        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"text"},
        text = {
            ja = {
                {
                    "以令人联想到孩童的小小足迹代替颜料,表现出满开的樱花,再让那",
                    {"rt2"},
                    "些花瓣飘落于模拟水面的彩绘玻璃之上——便是这样的造型。"
                }
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"text"},
        text = {
            ja = {
                {
                    "从教会内部看去,彩绘玻璃自然美丽。它从外部采入大量光线,以蓝",
                    {"rt2"},
                    "色为基调,将打磨得雪白的大理石染上一层美丽的色彩。"
                }
            }
        },
        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"text"},
        text = {
            ja = {
                {
                    "但并不止于此。从外面看到的彩绘玻璃,不再是内部所见那种闪耀的",
                    {"rt2"},
                    "蓝,而是化作一片幽暗、美丽而又透明的水面。"
                }
            }
        },
        linkback = "block_00053",
        linknext = "block_00055"
    },
    block_00055 = {
        {"text"},
        text = {
            ja = {
                {
                    "而这,唯有在墙上画出「樱」才得以成立。以壁画作漫天飞舞的樱花",
                    {"rt2"},
                    ",以彩绘玻璃作水面,借由两种素材的组合,那份幽暗才愈发凸显。"
                }
            }
        },
        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"text"},
        text = {
            ja = {
                {
                    "作为草薙健一郎完成品的樱花作品,若除去习作之类,《横卧之樱》",
                    {"rt2"},
                    "是唯一的一件。"
                }
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"text"},
        text = {
            ja = {
                {
                    "——这曾是美术界的常识。正因如此,那家伙生前以图稿形式完成的",
                    {"rt2"},
                    "《樱花们的足迹》,想必不仅会在美术界,还会在各方各面的人群中",
                    {"rt2"},
                    "引起反响吧。"
                }
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            ja = {
                {"就像我自己初见这份图稿时所受的冲击一样……不,恐怕更甚于此。"}
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"text"},
        text = {
            ja = {
                {"我看到的只是图稿。"}
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
            ja = {
                {"而众人看到的,是在盛夏之夜突然现身的“成品”。"}
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            ja = {
                {
                    "凡是与草薙健一郎有过交集的人,谁都认为「樱」这一母题对他而言",
                    {"rt2"},
                    "有着特别的意义;而仿佛是为了印证这一点,在此之前,除《横卧之樱",
                    {"rt2"},
                    "》以外,草薙健一郎不曾发表过任何「樱」的作品。"
                }
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            ja = {
                {
                    "正因如此,我才认为这个计划可行。完成这件作品,绝不是一场必败",
                    {"rt2"},
                    "之战。"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"text"},
        text = {
            ja = {
                {"从这层意义上说,这个结果某种程度上也可以说早在预料之中。"}
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            ja = {
                {"不,这么说未免太夸张了吧……。"}
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"text"},
        text = {
            ja = {
                {
                    "能那样自然最好。真能那样就算是白赚了——当初只是这种程度的想",
                    {"rt2"},
                    "法。或许吧。"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            ja = {
                {"无论如何,依成品的好坏,我们的命运或许会变得截然不同。"}
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            ja = {
                {
                    "若是做出的东西别说糟蹋了草薙健一郎的作品,连建筑本身都给毁了",
                    {"rt2"},
                    ",那可就不是退学能了事的了。"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"text"},
        text = {
            ja = {
                {
                    "这确实是一座危桥。但只要将这件作品完成得完美无缺,便有十足的",
                    {"rt2"},
                    "胜算。本应受罚的罪行,一转而为理应受赞的荣誉的可能性。"
                }
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"bg", file = "ev_uni_c25_01", path = ":ev/ev_uni_c25/", set = "ev_uni_c25"},
        {"text"},
        text = {
            ja = {
                {"那一天。"}
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"text"},
        text = {
            ja = {
                {
                    "几乎在完成的同时,我们就被门卫发现了。大概是因为完成时我们欢",
                    {"rt2"},
                    "闹得太厉害了吧。"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"text"},
        text = {
            ja = {
                {"若是完成之后偷偷摸摸地溜走,说不定就不会被抓。"}
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"text"},
        text = {
            ja = {
                {
                    "可是,完成了那样的作品,怎么可能想得到偷偷溜走。我们伴随着完",
                    {"rt2"},
                    "成大肆欢腾。"
                }
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"text"},
        text = {
            ja = {
                {"门卫当然会闻声赶来。"}
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            ja = {
                {"深夜擅自闯入,还在教会的墙上涂了一幅巨大的涂鸦。"}
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"text"},
        text = {
            ja = {
                {"那可是一场大骚动。最初甚至是一副要叫警察来的架势。"}
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            ja = {
                {
                    "尽管是清晨,接到联络的教师们仍纷纷赶来。那阵仗,俨然是建校以",
                    {"rt2"},
                    "来头一遭的丑闻。"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"text"},
        text = {
            ja = {
                {"当然,其中也有蓝。"}
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            ja = {
                {
                    "在其他教师或惊慌失措、或怒吼喧嚷之中,蓝只是看着草薙健一郎留",
                    {"rt2"},
                    "下的樱花之画。"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"text"},
        text = {
            ja = {
                {
                    "一直,一直,在喧嚣之中,像置身美术馆的观众一般,神色平静地凝视着",
                    {"rt2"},
                    "那幅画。"
                }
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"text"},
        text = {
            ja = {
                {"细细鉴赏过后,蓝朝我这边看来,笑了……然后,"}
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"se", id = 1, file = "se1512"},
        {"text"},
        text = {
            ja = {
                {"……我挨了揍。"}
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
    block_00082 = {
        {"text"},
        text = {
            ja = {
                {"稍晚一步,明石姐妹也赶到了。"}
            }
        },
        linkback = "block_00081",
        linknext = "block_00083"
    },
    block_00083 = {
        {"text"},
        text = {
            ja = {
                {"她们哭着。"}
            }
        },
        linkback = "block_00082",
        linknext = "block_00084"
    },
    block_00084 = {
        {"text"},
        text = {
            ja = {
                {"似乎是从医院看到这幅光景,急急忙忙赶了过来。那也难怪。"}
            }
        },
        linkback = "block_00083",
        linknext = "block_00085"
    },
    block_00085 = {
        {"text"},
        text = {
            ja = {
                {"毕竟那家医院可是头等特座。想必吓了一大跳吧。"}
            }
        },
        linkback = "block_00084",
        linknext = "block_00086"
    },
    block_00086 = {
        {"text"},
        text = {
            ja = {
                {"直到昨天还不存在的樱花之画,突然出现了。"}
            }
        },
        linkback = "block_00085",
        linknext = "block_00087"
    },
