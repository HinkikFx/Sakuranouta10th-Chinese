                    "「你一副没心没肺的样子说这话真让人火大」"
                }
            }
        },
        linkback = "block_00041",
        linknext = "block_00043"
    },
    block_00043 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「为什么啊」"
                }
            }
        },
        linkback = "block_00042",
        linknext = "block_00044"
    },
    block_00044 = {
        {"text"},
        text = {
            ja = {
                {"从完成教堂壁画的那天起，发生了很多事。"}
            }
        },
        linkback = "block_00043",
        linknext = "block_00045"
    },
    block_00045 = {
        {"text"},
        text = {
            ja = {
                {"多到普通暑假根本无法想象。"}
            }
        },
        linkback = "block_00044",
        linknext = "block_00046"
    },
    block_00046 = {
        {"text"},
        text = {
            ja = {
                {
                    "单说结果的话，那幅画被保留了下来，我和美术部也被允许继续存",
                    {"rt2"},
                    "在。"
                }
            }
        },
        linkback = "block_00045",
        linknext = "block_00047"
    },
    block_00047 = {
        {"text"},
        text = {
            ja = {
                {"只是除了例外……"}
            }
        },
        linkback = "block_00046",
        linknext = "block_00048"
    },
    block_00048 = {
        {"bgm", stop = 1, time = 1000},
        {"bg", file = "white", path = ":bg/"},
        {"bg", zoom = 70, speed = 200000, time = 1500, file = "zev_uni_c25_01", path = ":ev/ev_uni_c25/", set = "ev_uni_c25", x2 = 384, y2 = -50, x = -384, y = -50, ax = 1920, ay = 1080, bx = -960, by = -540},
        {"bgm", file = "bgm110"},
        {"text"},
        text = {
            ja = {
                {"七月的最后一天。"}
            }
        },
        linkback = "block_00047",
        linknext = "block_00049"
    },
    block_00049 = {
        {"text"},
        text = {
            ja = {
                {"不如说是八月第一天的早晨。"}
            }
        },
        linkback = "block_00048",
        linknext = "block_00050"
    },
    block_00050 = {
        {"text"},
        text = {
            ja = {
                {"那件作品完成了。"}
            }
        },
        linkback = "block_00049",
        linknext = "block_00051"
    },
    block_00051 = {
        {"text"},
        text = {
            ja = {
                {
                    "如同盛夏突然绽放的樱花一般，教堂的墙壁上突然出现了它的身影。",
                    {"rt2"},
                    "草薙健一郎作《樱花们的足迹》。"
                }
            }
        },
        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"text"},
        text = {
            ja = {
                {
                    "以令人联想到孩子的小小足迹代替颜料，表现出盛开的樱花，而且",
                    {"rt2"},
                    "花瓣飘落在模仿水面的彩绘玻璃上，形成了这样的造型。"
                }
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"text"},
        text = {
            ja = {
                {
                    "从教堂内部看到的彩绘玻璃当然很美。从外部引入大量光线的、以",
                    {"rt2"},
                    "蓝色为基调的玻璃，将磨得雪白的大理石染上了美丽的色彩。"
                }
            }
        },
        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"text"},
        text = {
            ja = {
                {
                    "但不止于此。从外面看到的彩绘玻璃，并非内部所见的闪耀的蓝色，",
                    {"rt2"},
                    "而是呈现出幽暗而美丽且透明的水面。"
                }
            }
        },
        linkback = "block_00053",
        linknext = "block_00055"
    },
    block_00055 = {
        {"text"},
        text = {
            ja = {
                {
                    "这是通过在墙壁上描绘「樱花」才得以成立的。将空中飞舞的樱花",
                    {"rt2"},
                    "作为壁画，将水面作为彩绘玻璃，通过两种素材的组合，使那份幽",
                    {"rt2"},
                    "暗得以彰显。"
                }
            }
        },
        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"text"},
        text = {
            ja = {
                {
                    "草薙健一郎以完成品形式呈现的樱花作品，排除习作等之后，只有",
                    {"rt2"},
                    "《横卧之樱》是唯一的一件。"
                }
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"text"},
        text = {
            ja = {
                {
                    "这是美术界的常识。正因如此，那家伙生前以图案形式完成的《樱",
                    {"rt2"},
                    "花们的足迹》，不仅在美术界，在各个领域的人中都会引起反响吧。"
                }
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            ja = {
                {
                    "就像我自己第一次看到这个图案时所受到的冲击一样……不，应该",
                    {"rt2"},
                    "比那更甚。"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"text"},
        text = {
            ja = {
                {"我看到的是图案。"}
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
            ja = {
                {"但大家看到的，是在盛夏之夜突然出现的\"完成品\"。"}
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            ja = {
                {
                    "与草薙健一郎有关的人，无不认为「樱花」这一主题对他来说是特",
                    {"rt2"},
                    "别的，而且就像是为了证明这一点一样，在那之前除了《横卧之樱",
                    {"rt2"},
                    "》之外，草薙健一郎没有发表过任何「樱花」题材的作品。"
                }
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            ja = {
                {
                    "正因如此，我认为这个计划是可行的。完成这件作品，绝非一场必",
                    {"rt2"},
                    "败之仗。"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"text"},
        text = {
            ja = {
                {
                    "从那个意义上来说，这个结果在某种程度上也可以说是在意料之中",
                    {"rt2"},
                    "的。"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            ja = {
                {"不，这样说确实过头了……"}
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"text"},
        text = {
            ja = {
                {"能那样就好了。大概是抱着能那样就赚到了的心态。或许吧。"}
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            ja = {
                {"无论如何，根据完成的效果，我们的命运可能会完全不同。"}
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            ja = {
                {
                    "如果不仅毁了草薙健一郎的作品，甚至毁了建筑本身的话，恐怕不",
                    {"rt2"},
                    "是退学就能了事的。"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"text"},
        text = {
            ja = {
                {
                    "确实是走了一条危险的路。但是，只要将这件作品完美地完成，就",
                    {"rt2"},
                    "有充分的胜算。本应受罚的罪行，一转可能变成应受称赞的荣誉。"
                }
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"bg", file = "ev_uni_c25_01", path = ":ev/ev_uni_c25/", set = "ev_uni_c25"},
        {"text"},
        text = {
            ja = {
                {"那一天。"}
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"text"},
        text = {
            ja = {
                {
                    "几乎在完成的同时被保安发现了。大概是因为完成的时候我们太兴",
                    {"rt2"},
                    "奋了吧。"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"text"},
        text = {
            ja = {
                {"如果完成后悄悄溜走的话，或许就不会被抓到了。"}
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"text"},
        text = {
            ja = {
                {
                    "但是，完成了那样的作品后还偷偷摸摸地逃跑，那是不可想象的。",
                    {"rt2"},
                    "我们在完成的同时大肆庆祝了起来。"
                }
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"text"},
        text = {
            ja = {
                {"理所当然，保安赶来了。"}
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            ja = {
                {"深夜未经许可擅自闯入，而且还在教堂的墙壁上涂了大幅涂鸦。"}
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"text"},
        text = {
            ja = {
                {"那可是闹翻了天。简直就像要报警一样的阵势。"}
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            ja = {
                {
                    "虽然是清晨，但接到通知的老师们纷纷赶来。简直就是建校以来最",
                    {"rt2"},
                    "大的丑闻一般的骚动。"
