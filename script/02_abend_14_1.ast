    },
    block_00091 = {
        {"text"},
        text = {
            ja = {
                {"原以为扇了明石耳光的小沙智,自己却吃了一惊。"}
            }
        },
        linkback = "block_00090",
        linknext = "block_00092"
    },
    block_00092 = {
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", file = "bg057g", path = ":bg/", sync = 0},
        {"fg", ch = "小牧", size = "z2", mode = 3, resize = 1, path = ":fg/kom/z2/", file = "kom_z2a0100", face = "a0021", head = "kom_z2a", lv = 5, id = 6, sync = 0},
        {"extrans", time = 1000, sync = 1},
