        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            ja = {
                {
                    "这幅樱花之画之所以动人,在于明石的心意。对小牧的、对小沙智的",
                    {"rt2"},
                    "、还有对神父的心意。"
                }
