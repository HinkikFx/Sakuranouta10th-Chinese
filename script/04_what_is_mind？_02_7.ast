        linknext = "block_00068"
    },
    block_00068 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000525", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「真是讽刺啊。明明是为了赎回水菜的自由才拼命赚钱的，在她活",
                    {"rt2"},
                    "着的时候却始终没能赚到大钱」"
                }
            }
