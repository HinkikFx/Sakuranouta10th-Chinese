    },
    block_00004 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000478", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯，她大概真以为要打起来了」"
