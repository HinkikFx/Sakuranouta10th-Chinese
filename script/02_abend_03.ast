    },
    block_00152 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000469", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「他本来就是健一郎先生的学生，但上了大学之后也经常被健一郎",
                    {"rt2"},
                    "先生叫来。碰巧是同一所大学，就以校友的身份过来。那个人任性",
                    {"rt2"},
                    "得要命，若田老师也很辛苦吧」"
                }
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「……是啊，任性得要命，还是个最了不起又最糟糕的男子人……」"
