        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「说起来那个男子人以前是弓张的老师来着……但他不也是兼职的？",
