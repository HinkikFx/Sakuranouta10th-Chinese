        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001376", ch = "yum"}
            },
            ja = {
                {"冰川同学一直在看着星星。"}
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001377", ch = "yum"}
            },
            ja = {
                {"而我一直在看着冰川同学。"}
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001419", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「今天星星好漂亮呢……」"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001378", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「诶？嗯……」"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001379", ch = "yum"}
            },
            ja = {
                {"因为月亮缺损得很厉害，所以星星们比平时更加闪耀。仅此而已。"}
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001380", ch = "yum"}
            },
            ja = {
                {"等月亮重新恢复光辉，星星们又会回到微弱的光芒。"}
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"bg", file = "ev_com_d01_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d01/", set = "ev_com_d01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001420", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「啊，好红的火焰！」"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001381", ch = "yum"}
            },
            ja = {
                {"冰川同学指向夏日南方的天空。"}
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001382", ch = "yum"}
            },
            ja = {
                {"那里没有火焰。有的只是星星。"}
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001383", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「你说的是心宿二？」"
                }
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"bg", file = "ev_com_d01_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d01/", set = "ev_com_d01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001421", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯，是组成天蝎座的星星呢」"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001384", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「为什么把那个叫做红色的火焰呢？」"
                }
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001422", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「焚身愿望……大概就是那种感觉吧？」"
                }
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001385", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「焚身愿望？？」"
                }
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"bg", file = "ev_com_d01_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d01/", set = "ev_com_d01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001423", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「很久很久以前的故事。在巴尔多拉的原野上有一只蝎子，靠着杀",
                    {"rt2"},
                    "死小虫子之类的为生。然后有一天被黄鼠狼发现了，差点被吃掉」"
                }
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001424", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「蝎子拼命地逃啊逃啊，但终于快要被黄鼠狼按住了。就在那时它",
                    {"rt2"},
                    "面前突然出现了一口井，它掉了进去，怎么也爬不上来，于是蝎子",
                    {"rt2"},
                    "开始溺水了」"
                }
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001425", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那时蝎子这样祈祷道」"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001426", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「啊，我到底夺走了多少条生命啊。而当轮到我要被黄鼠狼吃掉的",
                    {"rt2"},
                    "时候，却像那样拼命地逃跑，可到头来还是变成了这样。啊，什么",
                    {"rt2"},
                    "都靠不住」"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001427", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「为什么我不能乖乖地把身体献给黄鼠狼呢。那样的话黄鼠狼也能",
                    {"rt2"},
                    "多活一天啊。神明大人啊，请看看我的心吧」"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001428", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「请不要让我这样白白丢掉性命，下次请用我的身体去造福真正的",
                    {"rt2"},
                    "众生吧」"
                }
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001429", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「于是有一天蝎子发现自己的身体变成了鲜红而美丽的火焰，正燃",
                    {"rt2"},
                    "烧着照亮夜晚的黑暗」"
                }
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001430", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「至今仍在燃烧着的那道光，就是那只蝎子」"
                }
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
    block_00082 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001386", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「啊？什么故事？」"
                }
            }
        },
        linkback = "block_00081",
        linknext = "block_00083"
    },
    block_00083 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001387", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美", "　"},
                    "我一脸茫然的时候，冰川同学慌忙解释起来。"
                }
            }
        },
        linkback = "block_00082",
        linknext = "block_00084"
    },
    block_00084 = {
        {"bg", file = "ev_com_d01_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d01/", set = "ev_com_d01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001431", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「抱歉，抱歉。刚才说的是《银河铁道之夜》里面出现的蝎子的火",
                    {"rt2"},
                    "焰的故事。我特别喜欢这一段……」"
                }
            }
        },
        linkback = "block_00083",
        linknext = "block_00085"
    },
    block_00085 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001388", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「《银河铁道之夜》是宫崎骏写的来着？」"
                }
            }
        },
        linkback = "block_00084",
        linknext = "block_00086"
    },
    block_00086 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001432", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不是啦，只有一个'宫'字是对的。是宫泽贤治啦」"
                }
            }
        },
        linkback = "block_00085",
        linknext = "block_00087"
    },
    block_00087 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001389", ch = "yum"}
            },
            ja = {
                {"不都差不多嘛？虽然我也搞不太清楚就是了。"}
            }
        },
        linkback = "block_00086",
        linknext = "block_00088"
    },
    block_00088 = {
        {"bg", file = "ev_com_d01_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d01/", set = "ev_com_d01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001433", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「宫泽贤治还有一个叫《夜鹰之星》的类似故事呢。夜鹰化作了如",
                    {"rt2"},
                    "同",
                    {"txruby", text = "lín"},
                    "磷",
                    {"txruby"},
                    "火一般的蓝色美丽光芒，静静地燃烧着，变成了夜鹰之星的故",
                    {"rt2"},
                    "事」"
                }
            }
        },
        linkback = "block_00087",
        linknext = "block_00089"
    },
    block_00089 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001390", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「这样啊……」"
                }
            }
        },
        linkback = "block_00088",
        linknext = "block_00090"
    },
    block_00090 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001434", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我觉得宫泽贤治心中是在意识着梵高的」"
                }
            }
        },
        linkback = "block_00089",
        linknext = "block_00091"
    },
    block_00091 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001435", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「他有一部叫《春与修罗》的诗集，在诗中多次出现了“",
                    {"txruby", text = "齐普雷森"},
                    "ZYPRESSE",
                    {"rt2"},
                    "N",
                    {"txruby"},
                    "”这个词。德语里是'丝柏'的意思」"
                }
            }
        },
        linkback = "block_00090",
        linknext = "block_00092"
    },
    block_00092 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001436", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「ZYPRESSEN 春之列队」"
                }
            }
        },
        linkback = "block_00091",
        linknext = "block_00093"
    },
    block_00093 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001437", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「ZYPRESSEN 静静地摇曳」"
                }
            }
        },
        linkback = "block_00092",
        linknext = "block_00094"
    },
    block_00094 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001438", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「ZYPRESSEN 愈发漆黑云端的火花倾泻而下」"
                }
            }
        },
        linkback = "block_00093",
        linknext = "block_00095"
    },
    block_00095 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001439", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那首诗中描绘的丝柏，大概就是梵高的丝柏……」"
                }
            }
        },
        linkback = "block_00094",
        linknext = "block_00096"
    },
    block_00096 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001391", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「说起来昨天你也提到梵高什么的了呢」"
                }
            }
        },
        linkback = "block_00095",
        linknext = "block_00097"
    },
    block_00097 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001440", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「梵高有一幅在死前——自杀前夕画的画」"
                }
            }
        },
        linkback = "block_00096",
        linknext = "block_00098"
    },
    block_00098 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001441", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那幅作品的名字叫《丝柏与星空下的道路》」"
                }
            }
        },
        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001442", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「宛如漆黑的火焰般直冲天际的丝柏，以及从旁边通过的一条道路」"
                }
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001443", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「朦胧地仿佛要溶入天空的虚幻星辰挂在左边的夜空中，与之相对",
                    {"rt2"},
                    "的是如同切割天空般纤细锐利的月亮。将它们一分为二般矗立在中",
                    {"rt2"},
                    "央的，是漆黑的丝柏」"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001444", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「象征性地暗示着死亡的母题……」"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001445", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「对宫泽贤治来说，大概——那棵丝柏，",
                    {"txruby", text = "齐普雷森"},
                    "ZYPRESSEN",
                    {"txruby"},
                    "，看起来就像",
                    {"rt2"},
                    "直达天际的黑色火焰吧……」"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001446", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「在夜空中化为火焰，持续闪耀的故事群……那大概就是直达天际",
                    {"rt2"},
                    "的黑色火焰」"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001447", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「无论是蝎子的赤红火焰，还是夜鹰的湛蓝火焰……黑色火焰、丝",
                    {"rt2"},
                    "柏就是这样的存在」"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001392", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「呃……那就是冰川同学晚上在这种地方画丝柏的理由？」"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001448", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「啊，呃，那个嘛，也算是原因之一……啊，对了。该吃药了」"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001393", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「吃药的时间？」"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001449", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「啊，抱歉」"
                }
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001394", ch = "yum"}
            },
            ja = {
                {"冰川同学躲躲闪闪地从铝塑包装里取出了药。"}
            }
        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001395", ch = "yum"}
            },
            ja = {
                {"但是，因为我不想错过她的一举一动，所以偷偷看着她。"}
            }
        },
        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001396", ch = "yum"}
            },
            ja = {
                {"我记住了药板上写着的“ＵＦＴ　サンフラルＳ”。"}
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001450", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「明天还能再见面吗？」"
                }
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001397", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「当、当然……」"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001398", ch = "yum"}
            },
            ja = {
                {"我脑海中挥之不去她吃的那种药的名字。"}
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001399", ch = "yum"}
            },
            ja = {
                {"不知为何，仿佛我早就知道那是什么药似的。"}
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"bg", file = "black", path = ":bg/"},
        {"ex", time = 1000, func = "wait"},
        {"bg", file = "ev_txt_c06_01", time = 2000, path = ":ev/ev_txt_c06/", set = "ev_txt_c06"},
        {"text"},
        text = {
            ja = {
                {"――象征与死亡――"}
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001400", ch = "yum"}
            },
            ja = {
                {"那天晚上，我查了那种药。"}
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001401", ch = "yum"}
            },
            ja = {
                {"然后，我知道了她所有的秘密。"}
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001402", ch = "yum"}
            },
            ja = {
                {"她为什么要避开日光。"}
            }
        },
        linkback = "block_00118",
        linknext = "block_00120"
    },
    block_00120 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001403", ch = "yum"}
            },
            ja = {
                {"为什么总是暗示着死亡。不——为什么偏爱那些接受死亡的作品。"}
            }
        },
        linkback = "block_00119",
        linknext = "block_00121"
    },
    block_00121 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001404", ch = "yum"}
            },
            ja = {
                {"梵高　丝柏"}
            }
        },
        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001405", ch = "yum"}
            },
            ja = {
                {"宫泽贤治　蝎子　夜鹰之星"}
            }
        },
        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001406", ch = "yum"}
            },
            ja = {
                {"每一个都是死亡的象征，却又仿佛欣然接受死亡的作品群。"}
            }
        },
        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001407", ch = "yum"}
            },
            ja = {
                {
                    "她选择了这些作品，借助那些幻想世界的力量，试图逃离现实中可",
                    {"rt2"},
                    "怕的东西。"
                }
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001408", ch = "yum"}
            },
            ja = {
                {
                    "她避开太阳，喜欢待在月光下，独自一人在夜晚的丝柏和游乐设施",
                    {"rt2"},
                    "中嬉戏。"
                }
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001409", ch = "yum"}
            },
            ja = {
                {"那意味着——她的美丽，与死亡仅一步之遥。"}
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001410", ch = "yum"}
            },
            ja = {
                {
                    "她宛如月亮般，犹如青白色的火焰一般，是因为她的生命只能靠反",
                    {"rt2"},
                    "射外来的光芒才能产生光辉，而她的全身都沉浸在名为死亡的黑暗",
                    {"rt2"},
                    "之中。"
                }
            }
        },
        linkback = "block_00126",
        linknext = "block_00128"
    },
    block_00128 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001411", ch = "yum"}
            },
            ja = {
                {"这一切不过是这些隐喻的串联。"}
            }
        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001412", ch = "yum"}
            },
            ja = {
                {
                    "用来抑制夺走她生命之物的药品　　　　　　　　　　　　　“ＵＦ",
                    {"rt2"},
                    "Ｔ　サンフラルＳ”　　　　　　　　　　　其副作用——日光过敏",
                    {"rt2"},
                    "症。"
                }
            }
        },
        linkback = "block_00128",
        linknext = "block_00130"
    },
    block_00130 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001413", ch = "yum"}
            },
            ja = {
                {
                    "她的遮阳伞、她的白色衣裙、只在夜晚的公园里玩耍、她那柔弱的",
                    {"rt2"},
                    "美丽和举止——一切都不是偶然，而是完全的必然。"
                }
            }
        },
        linkback = "block_00129",
        linknext = "block_00131"
    },
    block_00131 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001414", ch = "yum"}
            },
            ja = {
                {"盘踞在她体内的病魔。"}
            }
        },
        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001415", ch = "yum"}
            },
            ja = {
                {"与此同时，她的精神为了逃避那份恐惧，需要甘于接受死亡的艺术。"}
            }
        },
        linkback = "block_00131",
        linknext = "block_00133"
    },
    block_00133 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001416", ch = "yum"}
            },
            ja = {
                {"第二天白天她依然在笑。"}
            }
        },
        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001417", ch = "yum"}
            },
            ja = {
                {"在许多人的圈子里温柔地微笑着。"}
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001418", ch = "yum"}
            },
            ja = {
                {
                    "如今在我看来，她那礼貌的谈吐、举止和整洁，并非什么优雅的气",
                    {"rt2"},
                    "质，而是因为病魔才本能地产生的神经质特性。"
                }
            }
        },
        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001419", ch = "yum"}
            },
            ja = {
                {"她所拥有的美丽，就建立在这样的危险之上。"}
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001420", ch = "yum"}
            },
            ja = {
                {"又和她对上了视线。"}
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001421", ch = "yum"}
            },
            ja = {
                {
                    "但是这次，冰川同学看到我却没有微笑。稍微露出了一点悲伤的表",
                    {"rt2"},
                    "情之后，就转过了头去。"
                }
            }
        },
        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001422", ch = "yum"}
            },
            ja = {
                {"旁边有人说了句「那家伙怎么回事，明明对上眼了」。"}
            }
        },
        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001423", ch = "yum"}
            },
            ja = {
                {"我连反驳的心情都没有，就离开了那里。"}
            }
        },
        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001424", ch = "yum"}
            },
            ja = {
                {"我爱上了她。"}
            }
        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001425", ch = "yum"}
            },
            ja = {
                {"知道了她美丽的原因后，我变得更加喜欢她了。"}
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001426", ch = "yum"}
            },
            ja = {
                {"与死亡相伴的少女。"}
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001427", ch = "yum"}
            },
            ja = {
                {"正因如此，她才如此美丽。"}
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001428", ch = "yum"}
            },
            ja = {
                {"我是苍蝇。大概是被她身上的死亡气息引诱而来的一只苍蝇。"}
            }
        },
        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001429", ch = "yum"}
            },
            ja = {
                {"说自己是狮子未免太狂妄了。"}
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001430", ch = "yum"}
            },
            ja = {
                {"我不是掠夺者，只是旁观被掠夺者的旁观者。"}
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001431", ch = "yum"}
            },
            ja = {
                {"所以我想在她美丽的身体上产卵。"}
            }
        },
        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001432", ch = "yum"}
            },
            ja = {
                {"在她那想必极其美丽的尸体上涌出我的分身的妄想。"}
            }
        },
        linkback = "block_00148",
        linknext = "block_00150"
    },
    block_00150 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001433", ch = "yum"}
            },
            ja = {
                {"我的精神简直就像蛆虫一样。"}
            }
        },
        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001434", ch = "yum"}
            },
            ja = {
                {"面对试图接受死亡的她，我没有给予鼓励，只是爱上了她。"}
            }
        },
        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001435", ch = "yum"}
            },
            ja = {
                {"真是蛆虫般的精神。"}
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"bg", file = "ev_txt_c03_01", time = 2000, path = ":ev/ev_txt_c03/", set = "ev_txt_c03"},
        {"text"},
        text = {
            ja = {
                {"――樱之艺术家――"}
            }
        },
        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001436", ch = "yum"}
            },
            ja = {
                {"在这里，我不得不提起那个可恶的樱之艺术家。"}
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001437", ch = "yum"}
            },
            ja = {
                {"那位年轻的樱之艺术家的作品同样令人联想到死亡。"}
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001438", ch = "yum"}
            },
            ja = {
                {"最初那只是一种预感，但后来变成了确信。"}
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001439", ch = "yum"}
            },
            ja = {
                {"因为后来我在公民馆看到了那幅樱花的画。"}
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001440", ch = "yum"}
            },
            ja = {
                {"那里面铭刻着「悼念所爱之人逝去」的心意。"}
            }
        },
        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001441", ch = "yum"}
            },
            ja = {
                {"那幅画的标题叫《樱日狂想》，这本身就意味深长。"}
            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
