            },
            ja = {
                {
                    name = {"健一郎"},
                    "「是吗？　开心吗？　刚才的绘本？」"
                }
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"fg", ch = "水菜", size = "z1", mode = 3, path = ":fg/miz/z1/", file = "miz_z1a0400", face = "a0002", head = "miz_z1a", lv = 4, id = 6},
        {"fgact", ch = "水菜", act = "うなづく", lv = 4, id = 6},
        {"text"},
