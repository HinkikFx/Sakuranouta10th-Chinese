        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            ja = {
                {"请她复印的，并不只有今年的。"}
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            ja = {
                {
                    "今年的、草薙健一郎入职弓张学园前后的，还有校长夺取学园那一",
                    {"rt2"},
                    "年的，我都拜托她弄来了。"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            ja = {
                {
                    "明明是曾与中村家结下姻亲的家族，听到鸟谷这个姓氏却毫无印象，",
                    {"rt2"},
                    "这样一来也说得通了。"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            ja = {
                {"是一家从明治时代延续至今的贸易公司。"}
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            ja = {
                {
                    "虽不如综合商社那般涉猎广泛、光鲜亮丽，但想必一直经营得稳健",
                    {"rt2"},
                    "扎实，偶尔也大胆出手。不然，公司也不可能存续这么久。"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
