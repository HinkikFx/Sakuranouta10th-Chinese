        linkback = "block_00518",
        linknext = "block_00520"
    },
    block_00520 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「先是看了禀扒开小穴,又接着看你就那样自慰……然后还被那么火",
