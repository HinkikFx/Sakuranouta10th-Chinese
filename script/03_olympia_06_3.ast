        linkback = "block_00510",
        linknext = "block_00512"
    },
    block_00512 = {
        {"text"},
        text = {
            ja = {
                {
                    "在汗水和体液的浸蚀下,女仆装已经破得七零八落,重要的地方完全",
                    {"rt2"},
                    "一览无余……。"
                }
            }
        },
        linkback = "block_00511",
        linknext = "block_00513"
    },
    block_00513 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_003045", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「总、总觉得,穿着这件溶得几乎遮不住的女仆装骑在上面,好像有",
                    {"rt2"},
                    "点羞耻……」"
                }
            }
        },
        linkback = "block_00512",
        linknext = "block_00514"
    },
    block_00514 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「说什么呢,明明是你自己骑上来的……」"
                }
            }
        },
        linkback = "block_00513",
        linknext = "block_00515"
    },
    block_00515 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_003046", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「嗯,我,喜欢直君的小鸡鸡。用欧派夹着的时候,小鸡鸡的触感也让",
                    {"rt2"},
                    "我酥麻不已……但果然,还是小穴最能尽情品味那份触感呢」"
                }
            }
        },
        linkback = "block_00514",
        linknext = "block_00516"
    },
    block_00516 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_003047", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「我的小穴……感觉过了头……连里面都……变得酥酥融融、烫得快要",
                    {"rt2"},
                    "灼伤人,成了非常色情的小穴哦……」"
                }
            }
        },
        linkback = "block_00515",
        linknext = "block_00517"
    },
    block_00517 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_003048", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「想用这样的小穴,好好感受直君滚烫滚烫的小鸡鸡……呢」"
                }
            }
        },
        linkback = "block_00516",
        linknext = "block_00518"
    },
    block_00518 = {
        {"text"},
        text = {
            ja = {
                {"禀微笑着,说着下流的话。"}
