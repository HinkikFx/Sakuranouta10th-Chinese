                    {"rt2"},
                    "星』和『北极星』了」"
                }
            }
        },
        linkback = "block_00049",
        linknext = "block_00051"
    },
    block_00051 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0001", head = "mak_z1a", lv = 4, id = 9},
        {"fgact", ch = "真琴", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003174", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「是的……还有」"
                }
            }
        },
        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"text"},
        text = {
            ja = {
                {
                    "鸟谷将手放在了旁边架子上的红漆葛笼上。墙上挂着一面和镜和一",
                    {"rt2"},
                    "幅日本画。"
                }
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"text"},
        text = {
            ja = {
                {
                    "那幅日本画就是之前律师在奇美拉出示过的鹊之画。镜背的纹样上",
                    {"rt2"},
                    "雕刻着一群鹊。"
                }
            }
        },
        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0110", face = "a0001", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0110", face = "a0002", head = "mak_z1a", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_003175", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「鹊是那个人喜欢收集的主题……没想到居然自己也画过，完全出",
                    {"rt2"},
                    "乎意料」"
                }
            }
        },
        linkback = "block_00053",
        linknext = "block_00055"
    },
    block_00055 = {
        {"text"},
        text = {
            ja = {
                {"鸟谷仰头望着鹊之镜。"}
            }
        },
        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0110", face = "a0027", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003176", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「很久以前……那个人说过，这面鹊之镜就是月亮。那时候的我还",
                    {"rt2"},
                    "小，完全不懂什么意思」"
                }
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003177", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「不过其实没什么深奥的，那是连辞典里都有记载的事」"
                }
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「鹊之镜吗……是什么意思？」"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0110", face = "a0026", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003178", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「鹊之镜，是月亮的别称」"
                }
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0110", face = "a0028", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003179", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「那时候我突然就释然了。啊，原来如此」"
                }
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0110", face = "a0002", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003180", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「如果是这样的话，就像月亮正面有捣年糕的兔子的影子一样，月",
                    {"rt2"},
                    "亮的背面应该有鹊的影子吧」"
                }
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0002", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0028", head = "mak_z1a", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_003181", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「也不知道为什么会这样想……大概是从镜面背后鹊的纹样自然联",
                    {"rt2"},
                    "想到的吧」"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0002", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fgact", ch = "真琴", act = "うなづく", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_003182", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「扯了些多余的旧事呢……好了，进入正题吧」"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「多余的旧事吗……其实我倒更想听那些呢，不过现在确实顾不上",
                    {"rt2"},
                    "这些了」"
                }
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1b0100", face = "b0009", head = "mak_z1b", lv = 4, id = 9},
        {"fgact", ch = "真琴", act = "びっくり", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1b0100", face = "b0008", head = "mak_z1b", lv = 4, id = 9}
            },
            vl02 = {
                {"fgact", ch = "真琴", act = "うなづく", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_003183", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「……！你、你说这种话……虽然确实是我先跑的题，但总不能一直",
                    {"rt2"},
                    "闲聊下去吧，来，快看这个！」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"fg", mode = -2},
        {"se", file = "se9010", id = 1},
        {"text"},
        text = {
            ja = {
                {"我凑近鸟谷打开葛笼盖子后的手边。"}
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            ja = {
                {
                    "葛笼里放着一本古老的和本、一本账簿，以及看似杂志文章剪报的",
                    {"rt2"},
                    "纸张，收在一起。"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"text"},
        text = {
            ja = {
                {
                    "美术报道的剪报虽然因年代久远而褪了色，但似乎是附有照片的展",
                    {"rt2"},
                    "览会介绍。"
                }
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"text"},
        text = {
            ja = {
                {
                    "和本与账簿看起来相当古老。就算被说成是江户时代或明治时代的",
                    {"rt2"},
                    "东西，想必也会觉得可信。"
                }
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"text"},
        text = {
            ja = {
                {"然而……"}
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"text"},
        text = {
            ja = {
                {
                    "面对紧盯着和本的我，鸟谷什么也没说，把杂志剪报递了过来。她",
                    {"rt2"},
                    "大概已经读过了。"
                }
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"text"},
        text = {
            ja = {
                {"我开始阅读那篇文章。"}
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"se", file = "se2497", vol = 50, id = 1},
        {"msgoff"},
        {"bg", y = 0, speed = 300000, file = "zbg071a", path = ":bg/", x2 = 960, y2 = 0, x = -960, ax = 1920, ay = 1080, bx = -960, by = -540, sync = 0},
        {"extrans", time = 1000},
        {"text"},
        text = {
            ja = {
                {"日本主义的狂热～点缀巴黎生活的日本之美～"}
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            ja = {
                {
                    "正在弓张市立博物馆举办的本次展览，以1878年巴黎万国博览会为",
                    {"rt2"},
                    "象征，展现巴黎掀起的日本主义热潮……"
                }
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"text"},
        text = {
            ja = {
                {
                    "通过当时在法国大量进口的美术工艺品、印象派绘画，以及以浮世",
                    {"rt2"},
                    "绘和印象派为题材在法国制作的陶瓷器，从多角度加以介绍。"
                }
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            ja = {
                {
                    "本展览由四章构成：『第一章　客厅～家族的肖像～』『第二章　",
                    {"rt2"},
                    "日式沙龙～女性们的收藏～』『第三章　书房～男子性们的收藏～』",
                    {"rt2"},
                    "『第四章　餐厅～迷倒巴黎的陶瓷器们～』。"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"text"},
        text = {
            ja = {
                {
                    "本展览的看点之一，是以印象派及同时代的绘画为蓝本，用当时的",
                    {"rt2"},
                    "美术工艺品还原的\"房间\"。"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            ja = {
                {
                    "『第一章　客厅～家族的肖像～』中，以雷诺阿的代表作——肖像画",
                    {"rt2"},
                    "《夏尔庞蒂埃夫人和她的孩子们》所在的房间为蓝本，"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"text"},
        text = {
            ja = {
                {
                    "『第二章　日式沙龙～女性们的收藏～』中，虽然不属于印象派，",
                    {"rt2"},
                    "但以同时代最早将日本主义元素融入作品的詹姆斯·蒂索的《欣赏日",
                    {"rt2"},
                    "本工艺品的少女们》所在的房间为蓝本，"
                }
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"text"},
        text = {
            ja = {
                {
                    "『第三章　书房～男子性们的收藏～』中，以爱德华·马奈的《埃米",
                    {"rt2"},
                    "尔·左拉的肖像》所在的房间为蓝本，分别做了复原。"
                }
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"text"},
        text = {
            ja = {
                {
                    "欣赏完装饰在房间里的各件工艺品后，不妨将放在便于对比位置的",
                    {"rt2"},
                    "原画与复原的房间对照观赏。"
                }
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
    block_00082 = {
        {"text"},
        text = {
            ja = {
                {
                    "『第四章　餐厅～迷倒巴黎的陶瓷器们～』与其他房间不同，是以",
                    {"rt2"},
                    "19世纪真实存在的餐厅为蓝本。"
                }
            }
        },
        linkback = "block_00081",
        linknext = "block_00083"
    },
    block_00083 = {
        {"text"},
        text = {
            ja = {
                {
                    "桌上摆放的餐具，以画家兼蚀刻版画家费利克斯·布拉克蒙设计的≪",
                    {"rt2"},
                    "卢梭≫系列为中心进行布置。"
                }
            }
        },
        linkback = "block_00082",
        linknext = "block_00084"
    },
    block_00084 = {
        {"text"},
        text = {
            ja = {
                {
                    "≪卢梭≫系列的图案大多取材自《北斋漫画》，餐具旁还一并展示",
                    {"rt2"},
                    "了已确认的原画出处。"
                }
            }
        },
        linkback = "block_00083",
        linknext = "block_00085"
    },
    block_00085 = {
        {"text"},
        text = {
            ja = {
                {
                    "费利克斯·布拉克蒙有一段轶事——作为法国艺术家，他被认为是最",
                    {"rt2"},
                    "早『发现』浮世绘的人，并从创立之初便参与了研究日本美术的艺",
                    {"rt2"},
                    "术家和评论家团体。"
                }
            }
        },
        linkback = "block_00084",
        linknext = "block_00086"
    },
    block_00086 = {
        {"text"},
        text = {
            ja = {
                {
                    "他与马奈、波德莱尔也是朋友，参加了第一届印象派画展，和印象",
                    {"rt2"},
                    "派画家以及赏识他们的评论家都有深厚交情。"
                }
            }
        },
        linkback = "block_00085",
        linknext = "block_00087"
    },
    block_00087 = {
        {"text"},
        text = {
            ja = {
                {
                    "布拉克蒙同时也是日本美术品的狂热收藏家，与经营陶瓷公司的夏",
                    {"rt2"},
                    "尔·阿维兰德相遇后，就任了阿维兰德公司负责彩绘和设计核心的奥",
                    {"rt2"},
                    "特伊工坊的艺术总监。"
                }
            }
        },
        linkback = "block_00086",
        linknext = "block_00088"
    },
    block_00088 = {
        {"text"},
        text = {
            ja = {
                {
                    "布拉克蒙于1881年退职，但在1886年的印象派画展上与高更相遇。",
                    {"rt2"},
                    "他为生活困窘的高更介绍了陶艺工作，高更因此度过了一整个冬天",
                    {"rt2"},
                    "从事陶艺创作。"
                }
            }
        },
        linkback = "block_00087",
        linknext = "block_00089"
    },
    block_00089 = {
        {"text"},
        text = {
            ja = {
                {
                    "阿维兰德公司的工坊就这样雇用了大量画家和艺术家，画家们以大",
                    {"rt2"},
                    "盘和花瓶的素坯为画布，绘制独一无二的画作。"
                }
            }
        },
        linkback = "block_00088",
        linknext = "block_00090"
    },
    block_00090 = {
        {"text"},
        text = {
            ja = {
                {
                    "在印象派画家中，热心收集浮世绘的以梵高和莫奈最为著名。梵高",
                    {"rt2"},
                    "频繁光顾巴黎两家日本美术品商店之一——萨缪尔·宾的店铺，大量",
                    {"rt2"},
                    "购买浮世绘。"
                }
            }
        },
        linkback = "block_00089",
        linknext = "block_00091"
    },
    block_00091 = {
        {"text"},
        text = {
            ja = {
                {
                    "莫奈也通过各种途径收集浮世绘，并从中汲取构图灵感，以之为参",
                    {"rt2"},
                    "照，创作了大量受到影响的画作。"
                }
            }
        },
        linkback = "block_00090",
        linknext = "block_00092"
    },
    block_00092 = {
        {"text"},
        text = {
            ja = {
                {
                    "1876年在第二届印象派画展上展出并广受好评的《日本女人》，是",
                    {"rt2"},
                    "一幅大量融入日本主义元素的作品，据说是作为十年前在沙龙展出",
                    {"rt2"},
                    "的《绿衣女子》的对作而创作的。"
                }
            }
        },
        linkback = "block_00091",
        linknext = "block_00093"
    },
    block_00093 = {
        {"text"},
        text = {
            ja = {
                {
                    "1876年，莫奈通过萨缪尔·宾，从一位日本人手中获得了一幅浮世绘，",
                    {"rt2"},
                    "并受其启发创作了一幅油画。"
                }
            }
        },
        linkback = "block_00092",
        linknext = "block_00094"
    },
    block_00094 = {
        {"text"},
        text = {
            ja = {
                {
                    "那就是本次展品中的压轴之作——莫奈的第二幅《鹊》，以及以该画",
                    {"rt2"},
                    "为图案制作的印象派风格花瓶。"
                }
            }
        },
        linkback = "block_00093",
        linknext = "block_00095"
    },
    block_00095 = {
        {"text"},
        text = {
            ja = {
                {
                    "那幅浮世绘对第二幅《鹊》的影响，与梵高的《夜晚的咖啡馆露台",
                    {"rt2"},
                    "》中广重的《猿若町夜景》的影响程度相当。"
                }
            }
        },
        linkback = "block_00094",
        linknext = "block_00096"
    },
    block_00096 = {
        {"text"},
        text = {
            ja = {
                {
                    "1868年冬天在埃特尔塔创作的第一幅《鹊》，与1874年在阿让特",
                    {"rt2"},
                    "伊创作的第二幅《鹊》，并非作为明确的系列作品来绘制的。"
                }
            }
        },
        linkback = "block_00095",
        linknext = "block_00097"
    },
    block_00097 = {
        {"text"},
        text = {
            ja = {
                {
                    "然而从整体给人的相似印象来看，这幅描绘着晴朗雪景和小鹊的浮",
                    {"rt2"},
                    "世绘，莫奈也许之前曾在某处见过……"
                }
            }
        },
        linkback = "block_00096",
        linknext = "block_00098"
    },
    block_00098 = {
        {"text"},
        text = {
            ja = {
                {
                    "在将其铭记于心后绘制了埃特尔塔的第一幅《鹊》，之后才去寻购",
                    {"rt2"},
                    "那幅浮世绘——这种可能性也不能否定。"
                }
            }
        },
        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            ja = {
                {
                    "此外，忠实再现了印象派笔触的鹊之花瓶，据记载制作于1876年至",
                    {"rt2"},
                    "1878年间，但作者身份不详。"
                }
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"text"},
        text = {
            ja = {
                {
                    "正如高更从事陶艺工作一样，也许是莫奈亲自执笔绘制的。虽然有",
                    {"rt2"},
                    "待今后的详细研究，但这是一件令人不禁产生\"说不定……\"之期待的",
                    {"rt2"},
                    "花瓶。"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            ja = {
                {
                    "餐厅主架上陈列的鹊之花瓶与莫奈的第二幅《鹊》，连同作为灵感",
                    {"rt2"},
                    "源泉的浮世绘一起展出。这是亲眼见证三种美相互辉映的绝佳机会。"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", file = "bg071a", path = ":bg/", sync = 0},
        {"extrans", time = 500},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这篇文章，也是校长弄出来的吗……」"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0027", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003184", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「看来是的。还特意找认识的印刷厂把整本杂志印了出来，再裁下",
                    {"rt2"},
                    "相关部分，也太讲究了」"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            ja = {
                {"鸟谷一边翻阅着夹有书签的古老和本部分，一边回答道。"}
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那真是厉害」"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            ja = {
                {"不过，如果那位校长是真心要骗人的话，做到这种程度也不奇怪。"}
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0110", face = "a0001", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003185", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「这边也确认完了」"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么内容？」"
                }
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003186", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「鸟谷家从明治时代起就作为美术商与海外进行贸易，而且从江户",
                    {"rt2"},
                    "时代起就跟",
                    {"txruby", text = "えぞうしや"},
                    "绘草纸屋",
                    {"txruby"},
                    "关系密切」"
                }
            }
        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「绘草纸屋？」"
                }
            }
        },
        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003187", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「就是制作和贩卖浮世绘及配有插图的草纸的店铺」"
                }
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此……」"
                }
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0001", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003188", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「大致明白了吧？」"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯。这篇杂志文章里提到的、为莫奈安排浮世绘的那个日本人，",
                    {"rt2"},
                    "就被设定成你的祖先了吧？」"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0002", head = "mak_z1a", lv = 4, id = 9},
        {"fgact", ch = "真琴", act = "うなづく", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0027", head = "mak_z1a", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_003189", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「正确。而浮世绘的作者在这本和本上记载为",
                    {"txruby", text = "かりやませいろ"},
                    "狩山青鹭",
                    {"txruby"},
                    "」"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0002", head = "mak_z1a", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_003190", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「画风与同时代活跃的渡边省亭相似，擅长花鸟画。主要以肉笔日",
                    {"rt2"},
                    "本画为主，偶尔也为锦绘画过少量底稿……就是这样的人物设定」"
                }
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「哈哈」"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            ja = {
                {"我仰头望向挂在墙上的浮世绘。"}
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0027", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003191", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「这本和本的内容，是以一位名叫鸟谷",
                    {"txruby", text = "ただまさ"},
                    "正昌",
                    {"txruby"},
                    "的美术商的日记为体裁",
                    {"rt2"},
                    "来记述的」"
                }
            }
        },
        linkback = "block_00118",
        linknext = "block_00120"
    },
    block_00120 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003192", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「正昌与美术商萨缪尔·宾有来往，为了亲身感受巴黎对日本美术的",
                    {"rt2"},
                    "需求，他自费前往了法国」"
                }
            }
        },
        linkback = "block_00119",
        linknext = "block_00121"
    },
    block_00121 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003193", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「在那里与莫奈相遇，被委托寻找莫奈曾经见到过的一幅浮世绘」"
                }
            }
        },
        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003194", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「莫奈幼年时期在港口城市勒阿弗尔度过。在那里他见到了水手带",
                    {"rt2"},
                    "来的日本工艺品和浮世绘」"
                }
            }
        },
        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003195", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「莫奈请求这位来自日本的美术商找到自己幼时见过的、描绘鹊与",
                    {"rt2"},
                    "雪景的浮世绘。想到了线索的正昌，从日本寄来了狩山青鹭的浮世",
                    {"rt2"},
                    "绘」"
                }
            }
        },
        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003196", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「然而那时的莫奈仍深陷经济困窘之中。对印象派表示理解的正昌，",
                    {"rt2"},
                    "以一幅与浮世绘同构图的莫奈油画为交换条件，将狩山青鹭的浮世",
                    {"rt2"},
                    "绘让给了莫奈——和本里是这么写的」"
                }
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以，以记忆中的浮世绘为参照绘制的第一幅《鹊》，和从正昌",
                    {"rt2"},
                    "手中得到浮世绘后所绘的第二幅《鹊》很相似，对吧」"
                }
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0001", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0027", head = "mak_z1a", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_003197", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「就是这么回事。正昌对夏尔·阿维兰德制作的印象派陶瓷也很感兴",
                    {"rt2"},
                    "趣，因此以从莫奈那里得到的第二幅《鹊》为图案，定制了印象派",
                    {"rt2"},
                    "风格的花瓶」"
                }
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0001", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0027", head = "mak_z1a", lv = 4, id = 9}
            },
            vl02 = {
                {"fgact", ch = "真琴", act = "おじぎ", lv = 4, id = 9}
            },
            vl03 = {
                {"fgact", ch = "真琴", act = "うなづく", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_003198", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「这些经过都记载在这本和本里……就是这样。另一本是当时的账",
                    {"rt2"},
                    "簿。这是花瓶的记录，狩山青鹭浮世绘的记录在……这边」"
                }
            }
        },
        linkback = "block_00126",
        linknext = "block_00128"
    },
    block_00128 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0110", face = "a0027", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003199", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「正昌因工作原因未能等到花瓶完成便回国了。之后发生了一些小",
                    {"rt2"},
                    "波折，完成的鹊之花瓶和油画被保管在了阿维兰德公司那边」"
                }
            }
        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此，然后到了校长还是学生的时候被发现了……是这个发",
                    {"rt2"},
                    "展吧」"
                }
            }
        },
        linkback = "block_00128",
        linknext = "block_00130"
    },
    block_00130 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003200", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「就是这样。正昌后来又入手了一幅与赠予莫奈的浮世绘相同的作",
                    {"rt2"},
                    "品。那幅画连同这本日记和账簿，一直沉睡在鸟谷家的仓库中……」"
                }
            }
        },
        linkback = "block_00129",
        linknext = "block_00131"
    },
    block_00131 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那就是这幅浮世绘——的设定？」"
                }
            }
        },
        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0110", face = "a0001", head = "mak_z1a", lv = 4, id = 9},
        {"fgact", ch = "真琴", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003201", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「是的」"
                }
            }
        },
        linkback = "block_00131",
        linknext = "block_00133"
    },
    block_00133 = {
        {"fgact", ch = "真琴", act = "おじぎ", lv = 4, id = 9},
        {"se", file = "se9010", vol = 50, id = 1},
        {"text"},
        text = {
            ja = {
                {"鸟谷将剪报和两本和本放回葛笼，盖上了盖子。"}
            }
        },
        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「说起来，鹊之花瓶不在这里啊」"
                }
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0001", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003202", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「鹊之花瓶已经搬到校长室的保险柜里了。说是等我们和丽华谈判",
                    {"rt2"},
                    "那天，会派保安送过来」"
                }
            }
        },
        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这样啊……」"
                }
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0002", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003203", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「聊得太久了呢。把四颗星的花瓶搬走吧」"
                }
            }
