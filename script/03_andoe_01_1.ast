        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"text"},
        text = {
            ja = {
                {
                    "不仅是弓张学园，不知为何弓张市政厅里挂的画也引来了大批普通",
                    {"rt2"},
                    "人和媒体蜂拥而至。"
                }
            }
        },
        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"text"},
        text = {
            ja = {
                {
                    "唯一值得庆幸的是，由于新学期已经开始了，以妨碍教学为由，除",
                    {"rt2"},
                    "周日外限制了媒体和普通人的进入。"
                }
            }
        },
        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"text"},
        text = {
            ja = {
                {
                    "只要待在学校里，我就不会被媒体追着跑。光是这一点就算帮了大",
