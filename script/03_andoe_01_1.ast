        },
        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"text"},
        text = {
            ja = {
                {
                    "唯一值得庆幸的,大概就是因为新学期已经开始,校方以妨碍上课为",
