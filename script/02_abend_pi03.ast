        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此,因为是用那种猎奇咖啡做的咖啡冻,所以不叫俄罗斯轮",
                    {"rt2"},
