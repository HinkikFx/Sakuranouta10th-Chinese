        text = {
            vo = {
                {"vo", file = "fem_mkd_001100", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「对。我不是说过店长会从各地寄咖啡回来吗?那人不光爱好吃的,",
                    {"rt2"},
                    "还喜欢新奇罕见的玩意儿,所以偶尔会混进一些味道惊人……根本不",
                    {"rt2"},
