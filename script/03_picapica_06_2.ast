    },
    block_00173 = {
        {"text"},
        text = {
            ja = {
                {"年少之时,曾以麒麟儿之名令人畏惧的我的双瞳,将揭露一切!"}
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            ja = {
                {"母乳!　母乳不是流出那么多了吗!　流出那么多,要是流出来的话――"}
