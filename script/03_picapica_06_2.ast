        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            ja = {
                {
                    "在制服之下呼吸着的圆润的白,捧在手里会是沉甸甸的重。质感光滑",
