        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"bg", file = "ev_mak_h01_06", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h01/", set = "ev_mak_h01"},
        {"text"},
        text = {
            ja = {
                {"鸟谷羞耻难当,紧紧闭上了眼睛。"}
            }
