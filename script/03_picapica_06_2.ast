        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            ja = {
                {"借着那副表情,我的心眼愈发锐利。"}
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            ja = {
                {
                    "摘下内衣的话,乳房的重心会稍稍下沉吗……?毕竟,万物皆无法抗拒",
                    {"rt2"},
                    "重量……。"
                }
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            ja = {
                {"不?　是吗?"}
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            ja = {
                {"不对!　鸟谷的欧派怎么可能输给区区重量!!"}
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            ja = {
                {
                    "她的欧派,毫无疑问,是鸟谷的欧派!想必和鸟谷本人一样强韧有力,富",
                    {"rt2"},
                    "有弹性,也富有韧劲!"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            ja = {
                {"因为,那可是鸟谷的欧派啊!说不定连重量都能与之抗衡!?"}
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"bg", file = "ev_mak_h01_05", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h01/", set = "ev_mak_h01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002928", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「……我,我说……听,听人……说话……」"
                }
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            ja = {
                {"正在说着什么的鸟谷同学。"}
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            ja = {
                {"但是,内容什么的无所谓。"}
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            ja = {
                {"重要的是那声音,和颤抖的嘴唇。"}
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"bg", file = "ev_mak_h01_07", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h01/", set = "ev_mak_h01"},
        {"text"},
        text = {
            ja = {
                {"呵呵呵……越来越敏锐了啊……。"}
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"bg", file = "ev_mak_h01_08", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h01/", set = "ev_mak_h01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002929", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「你听得见吗……?　真,真是的……」"
                }
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            ja = {
                {"听不见。"}
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            ja = {
                {"因为,我正把我心灵之眼磨砺到极致。"}
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            ja = {
                {"迄今为止获得的一切知识正在集结。"}
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            ja = {
                {"人体素描学、色彩学,还有解剖学。"}
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            ja = {
                {"以知识为后盾的绝对感觉,塑造出鸟谷的乳房。"}
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            ja = {
                {"从腋下连向乳房的线条……是这样。好,很好。"}
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            ja = {
                {"「欧派!」"}
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            ja = {
                {"我在心中呐喊。"}
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"bg", file = "ev_mak_h01_09", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h01/", set = "ev_mak_h01"},
        {"text"},
        text = {
            ja = {
                {"看得见。"}
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            ja = {
                {"我看得见。"}
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"text"},
        text = {
            ja = {
                {"然后,那一瞬间到来了。"}
