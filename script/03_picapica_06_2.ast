        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"bg", file = "ev_mak_h01_05", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h01/", set = "ev_mak_h01"},
        {"text"},
        text = {
            ja = {
                {"那里的皮肤比别处更薄。因为肉的重量,皮肤被微微拉扯着。"}
