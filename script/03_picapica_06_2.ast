            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            ja = {
                {
                    "上乳的起始,在这一带骤然生出隆起。乳沟刻出清晰的阴影,下乳的",
                    {"rt2"},
                    "线条圆润柔和……"
                }
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"bg", file = "ev_mak_h01_11", path = ":ev/ev_mak_h01/", set = "ev_mak_h01"},
        {"text"},
        text = {
            ja = {
                {
                    "然后,然后,最重要的……乳头和乳晕的大小如何?硬度呢?　要画成在",
                    {"rt2"},
                    "内衣里被压住的状态吗?"
                }
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"bg", file = "ev_mak_h01_10", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h01/", set = "ev_mak_h01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002934", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「喂,都说了等一下……」"
                }
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"text"},
        text = {
            ja = {
                {
                    "哈……难道说,还有内陷乳头的可能性?不,鸟谷恐怕没有那种性质――",
                    {"rt2"},
                    "我感觉。"
                }
            }
        },
        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"bg", file = "ev_mak_h01_12", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h01/", set = "ev_mak_h01"},
        {"text"},
        text = {
            ja = {
                {
                    "内陷乳头自有它了不得的魅力点,但我感觉她拥有的是颜色更漂亮、",
                    {"rt2"},
                    "近乎完美的平衡。"
                }
            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
        text = {
            ja = {
                {
                    "乳房、乳头与乳晕的色彩对比,面积的比例,还有立体感。那一定构",
                    {"rt2"},
                    "成了堪称欧派理想的黄金比例。"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
            ja = {
                {"那么,怎么办?"}
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"text"},
        text = {
            ja = {
                {
                    "对了。唯有这里,完全无法从外侧推测。乳头,乳晕,这里正是妄想的",
                    {"rt2"},
                    "重头戏――"
                }
            }
        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            ja = {
                {"无法从外侧观测。也就是说,这是观测问题。什么都尚未确定。"}
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"text"},
        text = {
            ja = {
                {"黑暗中电流奔驰。"}
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"quake", mode = "mw"},
        {"text"},
        text = {
            ja = {
                {"唰!"}
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"bg", file = "ev_mak_h01_23", path = ":ev/ev_mak_h01/", set = "ev_mak_h01"},
        {"text"},
        text = {
            ja = {
                {"我看得见。"}
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"text"},
        text = {
            ja = {
                {"滴落的白色甘蜜之味。没错,其名为母乳。"}
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            ja = {
                {"这是无法观测之物。认为鸟谷不会出母乳,不过是无聊的先入之见。"}
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            ja = {
                {
                    "孕妇会分泌母乳。即便如此,这也不能成为鸟谷不出母乳的理由,不,",
                    {"rt2"},
                    "一定会出。因为,我作为艺术家的直觉正在这样低语。"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            ja = {
                {"看得见。看得见啊。鸟谷!!"}
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            ja = {
                {"那满溢而出的母乳!!"}
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"bg", file = "ev_mak_h01_24", path = ":ev/ev_mak_h01/", set = "ev_mak_h01"},
