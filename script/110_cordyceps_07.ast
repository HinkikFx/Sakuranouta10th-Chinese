                {"vo", file = "fem_yum_900348", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「不行不行,要被里奈的小穴,弄去了,要去嘞。明明还不想去的,我,小",
                    {"rt2"},
                    "鸡鸡要去了,要在里奈的小穴里面射出精液了……」"
                }
