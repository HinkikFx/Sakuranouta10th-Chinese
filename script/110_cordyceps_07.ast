    },
    block_00115 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003394", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不是那个问题啦――――嗯啊！　不行,等、等一下停下来」"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        text = {
            vo = {
