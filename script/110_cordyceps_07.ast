    },
    block_00114 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900344", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「啊,对哦。插进去的时候会痛,那就这样。把里奈的那个……啊,对了。",
                    {"rt2"},
                    "刚才射过了,所以你的小鸡鸡没勃起呀」"
