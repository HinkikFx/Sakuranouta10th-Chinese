                {"vo", file = "fem_rna_003418", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我的,小鸡鸡,太没,忍耐力了啊……晃晃荡荡的蛋蛋里积了太多精子",
                    {"rt2"},
                    ",一下子就射出来了」"
