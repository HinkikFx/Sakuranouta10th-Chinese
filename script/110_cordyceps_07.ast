    },
    block_00128 = {
        {"bg", sync = 0, face = 1, file = "ev_app_h05_08", time = 400, path = ":ev/ev_app_h05/", set = "ev_app_h05"},
        {"mwact", act = "びっくり", size = 9, time = 250},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900352", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「啊,里奈,你的小鸡鸡是不是变大了一点？　明明刚才还软趴趴的,",
                    {"rt2"},
                    "是有感觉了吗？」"
                }
            }
        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003398", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「才没有感觉。只是,这……嗯呀,啊呀！？　不行啊,什么,为什么明",
                    {"rt2"},
                    "明很痛,小鸡鸡却开始变大了？」"
                }
            }
        },
        linkback = "block_00128",
        linknext = "block_00130"
    },
    block_00130 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900353", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「小鸡鸡就是这种东西哦。长着这个,就没法用脑子去感觉了。就像",
                    {"rt2"},
                    "整个脑子都装进了小鸡鸡里一样……嗯啊,所以,里奈也让小鸡鸡舒服",
                    {"rt2"},
                    "起来嘛？」"
                }
            }
        },
        linkback = "block_00129",
        linknext = "block_00131"
    },
    block_00131 = {
        {"bg", sync = 0, face = 1, file = "ev_app_h05_09", time = 400, path = ":ev/ev_app_h05/", set = "ev_app_h05"},
        {"mwact", act = "びっくり", size = 5, time = 200},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003399", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「怎、怎么会,好像变得更大了,等等,为什么,你握住它了？　优美？？",
                    {"rt2"},
                    "　干什么？　难道说,你想一边插着一边帮我撸？」"
                }
            }
        },
        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900354", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「没错哦。里奈不是也对我做过同样的事吗？　所以我也要撸里奈",
                    {"rt2"},
                    "的小鸡鸡,让你舒服舒服。和我一起射个够吧？　好不好,里奈？」"
                }
            }
        },
        linkback = "block_00131",
        linknext = "block_00133"
    },
    block_00133 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003400", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不要,我才不想用小鸡鸡思考,要好好地相爱――――嗯呀啊！　什么？",
                    {"rt2"},
                    "　这是？　小鸡鸡的感觉？　是不是不太对劲？　这是什么？」"
                }
            }
        },
        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900355", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「就是这样哦。小穴被小鸡鸡狠狠抽插的同时小鸡鸡还被撸动的话,",
                    {"rt2"},
                    "痛楚和快感就会搅成一团,让人分不清东南西北,射精根本停不下来",
                    {"rt2"},
                    "哦？　里奈,我会撸个不停,让你射出好多好多精液的」"
                }
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"bg", sync = 0, face = 1, file = "ev_app_h05_10", time = 400, path = ":ev/ev_app_h05/", set = "ev_app_h05"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003401", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不要,不要,为什么？　为什么？　我的小鸡鸡硬得不行了？　为",
                    {"rt2"},
                    "什么会这样？　啊,总觉得,小穴也变得怪怪的,被小鸡鸡拖着走,总觉",
                    {"rt2"},
                    "得,嗯啊啊――嗯啊！」"
                }
            }
        },
        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900356", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「好厉害,里奈的小鸡鸡变得好烫。前端还流出好多下流的液体,撸",
                    {"rt2"},
                    "起来顺手极了。好厉害,小穴也在配合着撸动的节奏包裹我的小鸡鸡",
                    {"rt2"},
                    "哦」"
                }
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003402", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「为什么？　小穴明明应该很痛的,小鸡鸡却自顾自地舒服起来？　",
                    {"rt2"},
                    "为什么？　小鸡鸡也太自作主张了吧？　完全不管我的意愿就自己",
                    {"rt2"},
                    "有感觉？　这算什么？　好可怕！」"
                }
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900357", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「不可怕哦。小鸡鸡一点都不可怕,是因为你用脑子去想才不行的。",
                    {"rt2"},
                    "干脆把一切都交给小鸡鸡吧。长着小鸡鸡的人类啊,只能说是被这东",
                    {"rt2"},
                    "西支配着的嘛」"
                }
            }
        },
        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003403", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「诶？　被小鸡鸡支配？　男子人都是这样,小鸡鸡不分场合地说舒",
                    {"rt2"},
                    "服就舒服的？　不需要心情和气氛的吗？」"
                }
            }
        },
        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900358", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「没有没有,小鸡鸡才没有什么心情。小鸡鸡只有勃起和射精。来嘛",
                    {"rt2"},
                    ",里奈也让小鸡鸡舒服起来。那样的话,小穴也会跟着舒服起来的」"
                }
