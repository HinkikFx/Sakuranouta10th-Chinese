    },
    block_00126 = {
        {"bg", sync = 0, face = 1, file = "ev_app_h05_07", time = 400, path = ":ev/ev_app_h05/", set = "ev_app_h05"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900351", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「不行嘞不行嘞不行嘞,不够,完全不够。好不容易才插进里奈的里",
                    {"rt2"},
                    "面,只射一次怎么够,不够啊。腰停不下来,小鸡鸡舒服得停不下来」"
                }
