    },
    block_00167 = {
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003414", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「呀咿啊,为什么还在撸啊？　优美？？　别再撸小鸡鸡了,我真的",
                    {"rt2"},
                    "会变得只能用小鸡鸡思考了。再这么射下去,我就没法用脑子思考了」"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003415", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「优美,快让小鸡鸡停止射精吧,求你住手吧……不行嘞,不行嘞,已经,",
                    {"rt2"},
                    "已经,停不下来了……不行嘞……又要出来了,要出来了,又要……挤出精",
                    {"rt2"},
                    "液了――――」"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003416", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「又,用小鸡鸡去了啊。一直都在用小鸡鸡去啊。蛋蛋里明明一直在",
                    {"rt2"},
                    "好好地喷出精子……却停不下来啊,嗯呀啊！　啊,小鸡鸡好舒服啊」"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003417", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯啊！？　不行嘞,又,精液出来嘞,精液出来嘞嘞嘞……精液停不下",
                    {"rt2"},
                    "来……要变成射精中毒了啊――――――！！！？？　嗯呀啊嗯！！」"
                }
            }
