            },
            ja = {
                {
                    name = {"优美"},
                    "「停不下来哦。怎么可能停得下来……啊,啊啊,不行嘞,不行嘞不行嘞",
                    {"rt2"},
                    "不行嘞,里奈的里面太舒服了……小鸡鸡厉害得停不下来」"
                }
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"mwact", act = "うんうん", size = 8, time = 400},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900346", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「啊啊,为什么,忍不住……不行嘞不行嘞,明明还不想让小鸡鸡射出精",
                    {"rt2"},
                    "液的！　可里奈的里面太舒服了……啊啊,不行不行嘞,要出来了。要",
                    {"rt2"},
                    "出来了。要出来了啊」"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_003395", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「这、这就要？　再怎么说也太快了吧？　是、是帮了我大忙,可是",
                    {"rt2"},
                    ",不是才刚插进来吗？　嗯呀啊！　不、不行,动得那么快的话！！",
                    {"rt2"},
                    "　腰摆得太快了」"
                }
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_900347", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「啊,明明还不想去的,不行,不行,不行啊,我的小鸡鸡忍不住了。里奈",
                    {"rt2"},
                    "好舒服,里奈的小穴太舒服了――――啊啊！」"
                }
            }
        },
        linkback = "block_00118",
        linknext = "block_00120"
    },
    block_00120 = {
