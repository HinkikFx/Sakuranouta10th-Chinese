        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那与其浪费时间调查一个大男子人，不如把这时间用来多睡一会",
                    {"rt2"},
                    "儿啊」"
                }
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"fg", ch = "香奈", size = "z2", mode = 3, path = ":fg/kan/z2/", file = "kan_z2a0200", face = "a0004", head = "kan_z2a", x = -400, y = 0, lv = 5, id = 9},
        {"fgact", ch = "香奈", act = "うんうん", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000370", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「啊哈哈哈，要是能做到就不用犯愁了」"
                }
            }
        },
        linkback = "block_00212",
        linknext = "block_00214"
    },
    block_00214 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「愁什么啊。你做的事才叫杞人忧天」"
                }
            }
