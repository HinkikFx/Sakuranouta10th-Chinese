        linkback = "block_00224",
        linknext = "block_00226"
    },
    block_00226 = {
        {"fg", ch = "香奈", size = "z2", mode = 3, path = ":fg/kan/z2/", file = "kan_z2a0200", face = "a0003", head = "kan_z2a", x = -400, y = 0, lv = 5, id = 9},
        {"text"},
