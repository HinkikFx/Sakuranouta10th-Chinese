        linknext = "block_00217"
    },
    block_00217 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「追着别人跑,到头来连确凿的证据都没有,就断言樱七相图是我的",
                    {"rt2"},
