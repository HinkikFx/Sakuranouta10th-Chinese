    },
    block_00223 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000374", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「因为我是个笨蛋……」"
                }
            }
        },
        linkback = "block_00222",
        linknext = "block_00224"
    },
    block_00224 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「至少还有自知之明……」"
                }
            }
        },
        linkback = "block_00223",
        linknext = "block_00225"
    },
    block_00225 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000375", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「当然……明明知道自己毫无才华，却仍然没有放弃画画这件事……」"
                }
