                {"vo", file = "fem_knd_000371", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「所以说嘛，你不会懂的」"
                }
            }
        },
        linkback = "block_00214",
        linknext = "block_00216"
    },
    block_00216 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是啊。你这种人我完全搞不懂」"
                }
            }
        },
        linkback = "block_00215",
        linknext = "block_00217"
    },
    block_00217 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「追着别人跑，而且没有确凿证据就断定樱七相图是我的作品」"
                }
            }
        },
        linkback = "block_00216",
        linknext = "block_00218"
    },
    block_00218 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你是笨蛋吗……」"
