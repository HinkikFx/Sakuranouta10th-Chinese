        text = {
            vo = {
                {"vo", file = "fem_knd_000373", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「不经大脑？",
                    {"exfont", size = "f2"},
                    "不是那种问题……",
