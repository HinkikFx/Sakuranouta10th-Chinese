        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
            ja = {
                {"但是,与夏目圭有关的一切,我都提不起对咲崎君讲述的心情。"}
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"text"},
        text = {
            ja = {
                {"那家伙是我唯一的对手,那家伙曾和我一起做着愚蠢的梦。"}
            }
        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            ja = {
                {"大概,禀正走在那个梦的延长线上。"}
