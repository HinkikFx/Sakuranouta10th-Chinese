        linkback = "block_00245",
        linknext = "block_00247"
    },
    block_00247 = {
        {"text"},
        text = {
            ja = {
                {
                    "原来如此,确实,要是有了值得庆祝的事,谁也不会一个人躲在家里悄",
                    {"rt2"},
                    "悄开秘藏的酒。会很正常地出门去喝。"
                }
            }
        },
        linkback = "block_00246",
        linknext = "block_00248"
    },
    block_00248 = {
        {"text"},
        text = {
