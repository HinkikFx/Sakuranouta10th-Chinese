    },
    block_00257 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000164", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「虽然事后回头看,会发觉那一天,那一刻,那个瞬间,自己是幸福的…",
