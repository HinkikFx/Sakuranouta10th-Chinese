                {"vo", file = "man_wkd_000165", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「我吗？　我基本随时都挺幸福的哟。现在是正式教师,而且还交到",
                    {"rt2"},
                    "女朋友了」"
                }
            }
