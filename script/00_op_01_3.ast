    },
    block_00065 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「What is mind？　No matter.What is matter？　Never mind.」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000122", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「What is mind？……心为何物？　No matter. 非物质也。What is",
                    {"rt2"},
                    "matter？　物质为何？　Never mind.",
                    {"rt2"},
                    "绝非心也。大概是这个意思？」"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不，不对。正确的理解是——」"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「What is mind？　心是什么玩意儿？」"
                }
            }
