        {"bg", file = "bg063f", path = ":bg/", sync = 0},
        {"extrans", time = 1000},
        {"text"},
        text = {
            ja = {
                {"在这条坡道的路旁，有一座类似神社境内常见的小祠堂。"}
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            ja = {
                {
                    "即所谓的",
