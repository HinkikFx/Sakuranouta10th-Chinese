        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「没什么……那个男子人留下的话语的含义，不是我需要去思考的…",
                    {"rt2"},
                    "…」"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「只是，听到这首诗，就会想起那家伙的口头禅」"
