        {"bg", file = "ev_uni_c09_01", path = ":ev/ev_uni_c09/", set = "ev_uni_c09"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那首诗的结尾，引用了宫泽贤治《春与修罗·序》的一个片段」"
                }
