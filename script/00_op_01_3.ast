        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「没什么……那个男子人留下的话是什么意思，我没有理由去思考…",
                    {"rt2"},
                    "…」"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「只是，一听到那首诗，我就会想起那家伙的口头禅」"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000121", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「口头禅？」"
                }
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「What is mind ?　No matter.What is matter ?　Never mind.」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000122", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「What is mind ?　……心为何物？　No matter. 并非物质。What is",
                    {"rt2"},
                    "matter ?　物质为何物？　Never mind.",
                    {"rt2"},
                    "绝非心灵。大概是这个意思吧？」"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不，不对。正确的是――」"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「What is mind ?　心是什么玩意儿？」"
                }
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「No matter. 怎样都无所谓啦」"
                }
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「What is matter ?　物质是什么玩意儿？」"
                }
            }
