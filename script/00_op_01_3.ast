        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「通称『樱之诗』，人们说它让那家伙的作品变得愈加难解」"
                }
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000120", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「在直哉听来，这首诗是什么样的？」"
                }
            }
