    },
    block_00134 = {
        {"fg", ch = "雫", size = "z1", mode = 3, path = ":fg/shz/z1/", file = "shz_z1b1000", face = "b0001", head = "shz_z1b", lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_000666", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「直哉之前调查过吧。关于奥林匹亚……」"
                }
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,嘛,与其说是调查,不如说是一直有点在意……」"
