        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"fg", ch = "雫", size = "z1", mode = 3, path = ":fg/shz/z1/", file = "shz_z1a1000", face = "a0001", head = "shz_z1a", lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_000667", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「奥林匹亚,是歌剧《霍夫曼的故事》第二幕里登场的机械人偶」"
                }
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「诶?　是、是吗?　可是,雫不是说过根本没有叫奥兰匹亚的歌剧…",
                    {"rt2"},
                    "…」"
                }
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"fg", ch = "雫", size = "z1", mode = 3, path = ":fg/shz/z1/", file = "shz_z1a1000", face = "a0005", head = "shz_z1a", lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_000668", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「所以说,叫奥兰匹亚的歌剧确实不存在。歌剧的名字始终是《霍夫",
                    {"rt2"},
                    "曼的故事》」"
                }
            }
        },
        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「也就是说……她是机械人偶?」"
