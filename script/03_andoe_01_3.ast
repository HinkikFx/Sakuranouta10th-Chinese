        linknext = "block_00130"
    },
    block_00130 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,不对。再怎么说,我也没听说过那种像人偶一样的球体关节义",
                    {"rt2"},
                    "手义足,而且从结构上来说也太不稳定了,根本没法使用」"
                }
            }
        },
        linkback = "block_00129",
        linknext = "block_00131"
    },
    block_00131 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「机器人什么的更不可能吧……又不是科幻小说」"
                }
            }
        },
        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"fg", ch = "雫", size = "z1", mode = 3, path = ":fg/shz/z1/", file = "shz_z1b1000", face = "b0012", head = "shz_z1b", lv = 4, id = 5},
