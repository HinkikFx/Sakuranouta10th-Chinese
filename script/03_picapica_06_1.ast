        },
        linkback = "block_00030",
        linknext = "block_00032"
    },
    block_00032 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0001", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002767", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「把液态的陶土――泥浆,掺入烧成时会显色的金属氧化物,当作颜料",
                    {"rt2"},
                    "来使用,在赤陶或彩釉陶器上施以彩绘……这种技法也叫作泥浆装饰」"
                }
            }
        },
        linkback = "block_00031",
        linknext = "block_00033"
    },
    block_00033 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002768", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「这是当年在工坊里做工的匠人们,为了吸收印象派绘画的新构图和",
                    {"rt2"},
                    "颜料用法而琢磨出来的。在当时,人们形容它『就像画家在画布上作",
                    {"rt2"},
                    "画一般』」"
                }
            }
        },
        linkback = "block_00032",
        linknext = "block_00034"
    },
    block_00034 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「把印象派的画原样搬上去吗……这种事做得到?」"
                }
            }
        },
        linkback = "block_00033",
        linknext = "block_00035"
    },
    block_00035 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0026", head = "mak_z1a", lv = 4, id = 9},
        {"fgact", ch = "真琴", act = "うなづく", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0001", head = "mak_z1a", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_002769", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「嗯,做得到。虽然很费事,还得熟知烧成的调控和色剂的特性,但这",
                    {"rt2"},
                    "也不是什么完全失传的技法。类似的事,我自己也做过」"
                }
            }
        },
        linkback = "block_00034",
        linknext = "block_00036"
    },
    block_00036 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「诶,你也做过那种东西?」"
                }
            }
        },
        linkback = "block_00035",
        linknext = "block_00037"
    },
    block_00037 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0110", face = "a0002", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002770", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「只是同属当年流行的技法,并不是陶器。我做的是玻璃那边的。就",
                    {"rt2"},
                    "是所谓的帕特·德·维尔」"
                }
            }
        },
        linkback = "block_00036",
        linknext = "block_00038"
    },
    block_00038 = {
        {"fg", mode = -2},
        {"text"},
        text = {
            ja = {
                {"帕特·德·维尔吗……。"}
            }
        },
        linkback = "block_00037",
        linknext = "block_00039"
    },
    block_00039 = {
        {"text"},
        text = {
            ja = {
                {
                    "帕特·德·维尔,在法语里意为『玻璃的揉粉』。换成英语的 paste of",
                    {"rt2"},
                    "glass technique,就浅显易懂了。"
                }
            }
        },
        linkback = "block_00038",
        linknext = "block_00040"
    },
    block_00040 = {
        {"text"},
        text = {
            ja = {
                {
                    "先用黏土等做出原型,再以耐火石膏等翻模制成铸模,往里面填入玻",
                    {"rt2"},
                    "璃粉,借窑炉的热量熔化成形――就是这样一种技法。"
                }
            }
        },
        linkback = "block_00039",
        linknext = "block_00041"
    },
    block_00041 = {
        {"text"},
        text = {
            ja = {
                {
                    "不拆掉作为铸模的石膏就取不出玻璃,之后还得没完没了地研磨,所",
                    {"rt2"},
                    "以不适合量产,非常费工夫。"
                }
            }
        },
        linkback = "block_00040",
        linknext = "block_00042"
    },
    block_00042 = {
        {"text"},
        text = {
            ja = {
                {
                    "据说这技法发明于美索不达米亚,而它在１９世纪复兴之时,会成为",
                    {"rt2"},
                    "专属艺术家的玻璃技法,也就不难理解了。"
                }
            }
        },
        linkback = "block_00041",
        linknext = "block_00043"
    },
    block_00043 = {
        {"text"},
        text = {
            ja = {
                {
                    "不过,入窑之前的工序都能在常温下完成,又比吹制玻璃安全,所以各",
                    {"rt2"},
                    "地倒也时常举办相关的工作坊。"
                }
            }
        },
        linkback = "block_00042",
        linknext = "block_00044"
    },
    block_00044 = {
        {"text"},
        text = {
            ja = {
                {"用黏土制作原型这类活儿,对玩陶艺的鸟谷来说想必是轻车熟路。"}
            }
        },
        linkback = "block_00043",
        linknext = "block_00045"
    },
    block_00045 = {
