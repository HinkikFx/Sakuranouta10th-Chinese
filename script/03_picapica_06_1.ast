        text = {
            vo = {
                {"vo", file = "fem_mkd_002800", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「因为那风笛,它成了有来历的邪物,不知不觉间流言越传越邪乎,什",
                    {"rt2"},
                    "么附着啜泣女人的怨灵啦,什么持有者会招致毁灭啦……彻底被当成",
