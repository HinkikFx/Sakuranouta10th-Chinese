    },
    block_00154 = {
        {"bg", file = "zev_com_b05_01", sync = 0, face = 1, time = 400, zoom = 70, path = ":ev/ev_com_b05/", set = "ev_com_b05", ax = 1920, ay = 1080, bx = -960, by = -540, x = 350, y = 130},
