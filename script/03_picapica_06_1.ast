    },
    block_00031 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002766", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「用当地的材料,以当年的技法……」"
                }
