    },
    block_00068 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002786", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「刚才也提到了莱俪,我对新艺术运动一直很感兴趣,还有加莱的陶",
                    {"rt2"},
                    "器什么的,仿了好几件……」"
