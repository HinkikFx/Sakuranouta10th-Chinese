        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_002757", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「之前一起去鸟谷家的时候,我不是说过一件奇怪的事吗。说我进过",
                    {"rt2"},
                    "那个人……进过校长的房间,就那么一次」"
