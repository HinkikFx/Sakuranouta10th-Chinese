        text = {
            vo = {
                {"vo", file = "fem_mkd_002788", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「和老板做的陶器一比,终归只是徒有其“风格”罢了,不过嘛,好歹也",
                    {"rt2"},
                    "算像模像样。可谓把样样通样样松的本领发挥得淋漓尽致呢」"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0027", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002789", ch = "mkd"}
            },
            ja = {
