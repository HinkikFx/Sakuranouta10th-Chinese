    },
    block_00140 = {
        {"bg", file = "ev_com_j04_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_j04/", set = "ev_com_j04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000782", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「但艺术的历史，不是只属于天才的」"
                }
            }
        },
        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000783", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「我说过很多遍了，不是只有天才才能创造历史」"
                }
            }
        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"bg", file = "ev_com_j04_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_j04/", set = "ev_com_j04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000784", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「近期我们会超越草薙健一郎」"
                }
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「超越草薙健一郎？」"
                }
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000785", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「没错。媒体肯定会大肆报道的」"
                }
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那是什么意思……」"
                }
            }
        },
        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000786", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「谁知道呢。不过，跟草薙同学说这些本身就是无聊之举」"
                }
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「无聊之举？」"
                }
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000787", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「大概，我只是想自己确认一下而已」"
                }
            }
        },
        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"bg", file = "ev_com_j04_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_j04/", set = "ev_com_j04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000788", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「真傻。亡灵？对，大概就像亡灵一样的东西」"
                }
            }
        },
        linkback = "block_00148",
        linknext = "block_00150"
    },
    block_00150 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000789", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「但是，既然眼前的人已经是这样一副行尸走肉的模样，那就很清",
                    {"rt2"},
                    "楚了」"
                }
            }
        },
        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"bg", file = "ev_com_j04_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_j04/", set = "ev_com_j04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000790", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「用不着对你这样的人逞口舌之快」"
                }
            }
        },
        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000791", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「你对我来说是过去的亡灵。已经不过是幻影般的存在了」"
                }
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「幻影吗……人明明就在眼前却被说得那么夸张」"
                }
            }
        },
        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000792", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「在眼前又怎样？走在街上的话，到处都能遇到人群」"
                }
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000793", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「可是，跟那些不过是擦肩而过的人和幻影之间，又有什么区别呢？",
                    {"rt2"},
                    "」"
                }
            }
