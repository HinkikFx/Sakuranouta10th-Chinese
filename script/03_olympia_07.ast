            },
            ja = {
                {
                    name = {"女店主"},
                    "「不过,从招牌也看得出来,这里本来是家经营古董人偶的店。小禀",
                    {"rt2"},
                    "以前也带着可爱的人偶,来过这家店呢」"
                }
            }
