        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            ja = {
                {"当时的同学们虽然嘴上不说,心里应该也是这么觉得的。"}
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            ja = {
                {"说不定,和没有朋友的我不同,当时的同学早就知道真相了。"}
