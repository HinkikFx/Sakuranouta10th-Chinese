        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_003209", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我回答说，没有的事。倒不如说，我还心存感激。因为这次的事",
