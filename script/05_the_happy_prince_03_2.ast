                {"vo", file = "man_frd_000211", ch = "frd"}
            },
            ja = {
                {
                    name = {"弗里曼"},
                    "「The spreading wide of narrow HandsTo gather Paradise―」"
                }
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
