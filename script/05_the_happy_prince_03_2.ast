        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_frd_000205", ch = "frd"}
            },
            ja = {
                {
                    name = {"弗里曼"},
                    "「Of Chambers as the Cedars―每个房间中」"
