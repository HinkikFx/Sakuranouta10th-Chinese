        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_frd_000219", ch = "frd"}
            },
            ja = {
                {
                    name = {"弗里曼"},
                    "「当年有人想出版她的诗时，那个试图让她改变自己的风格、迫使",
                    {"rt2"},
                    "她遵从浪漫主义风格的文学评论家——她一定觉得那人有多愚蠢……」"
                }
