    },
    block_00103 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_frd_000202", ch = "frd"}
            },
            ja = {
                {
                    name = {"弗里曼"},
                    "「A fairer House than Prose―比散文更华美的居所」"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
