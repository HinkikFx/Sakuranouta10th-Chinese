        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你待在远东,不就是因为你负责摩尔公募展的日本会场吗？」"
