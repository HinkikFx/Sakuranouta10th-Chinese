    block_00100 = {
        {"text"},
        text = {
            ja = {
                {"弗里德曼一边慢步，一边打量着画室里散落的画布。"}
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            ja = {
                {"看了这些，他脸色丝毫未变。"}
