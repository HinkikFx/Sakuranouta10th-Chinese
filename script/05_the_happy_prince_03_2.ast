    block_00100 = {
        {"text"},
        text = {
            ja = {
                {"弗里德曼缓步走着,打量散置在画室里的画布。"}
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            ja = {
                {"即便看着那些画,他也面不改色。"}
