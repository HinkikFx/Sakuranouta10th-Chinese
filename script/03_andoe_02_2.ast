            ja = {
                {
                    name = {"雫", "葛"},
                    "「整理过的物品我都做好了笔记。打扫完东西不见了就麻烦了，所",
                    {"rt2"},
                    "以按类别归好了。如果有找不到的东西，跟葛说一声的话，马上就",
                    {"rt2"},
                    "能拿出来」"
                }
