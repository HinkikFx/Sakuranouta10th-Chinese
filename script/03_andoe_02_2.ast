        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那倒是很感谢……但这么大规模的扫除，你到底什么时候睡的？」"
