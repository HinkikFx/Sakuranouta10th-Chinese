        text = {
            vo = {
                {"vo", file = "fem_mkd_002572", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「据说她是刻意模仿莫奈的。你看，说到莫奈的话最有名的是睡莲",
                    {"rt2"},
                    "吧……那可是画了相当多幅的」"
