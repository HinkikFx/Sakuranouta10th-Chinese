        linkback = "block_00244",
        linknext = "block_00246"
    },
    block_00246 = {
        {"text"},
        text = {
            ja = {
                {
                    "跟挂在奇美拉的那幅令人联想到莫奈《喜鹊》的油画，构图几乎一",
                    {"rt2"},
                    "模一样。"
                }
            }
        },
        linkback = "block_00245",
        linknext = "block_00247"
    },
    block_00247 = {
        {"text"},
        text = {
            ja = {
                {
                    "是看了这幅浮世绘后画出了那幅油画，还是看了那幅油画后画出了",
                    {"rt2"},
                    "这幅浮世绘。"
