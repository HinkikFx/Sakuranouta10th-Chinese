        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不过店长嘛,嘛……或许还真说得通。听你讲的那些事,感觉是个相",
                    {"rt2"},
