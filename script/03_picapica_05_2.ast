        text = {
            vo = {
                {"vo", file = "fem_mkd_002583", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「是啊……也是因为现在美术部这帮人不正常得厉害,我才比较自然",
