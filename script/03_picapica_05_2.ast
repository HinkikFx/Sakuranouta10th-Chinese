        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002584", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我呢，是那种想了一大堆结果白搞一通的人，可是老板也好那个",
                    {"rt2"},
