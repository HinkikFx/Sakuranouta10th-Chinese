        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这就是她在读大学时留下的唯一一幅油画吗……相当有才华」"
