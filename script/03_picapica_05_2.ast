        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            ja = {
                {
                    "大学时代的草薙健一郎周围,大概就像如今的弓张学园美术部一样,",
                    {"rt2"},
                    "挤满了可怕的才能吧。"
