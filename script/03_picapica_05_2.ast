        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002570", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「是吧……追根溯源的话，她们肯照顾我大概也是因为那个人和老",
                    {"rt2"},
                    "板交情深」"
                }
