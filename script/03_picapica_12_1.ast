        linkback = "block_00031",
        linknext = "block_00033"
    },
    block_00033 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「鸟谷校长用来骗人的那幅画的题材就是喜鹊。而且她的雅号里也",
