        text = {
            vo = {
                {"vo", file = "fem_mkd_003717", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「是以它为题材的和歌。很有名，你应该也知道吧？『鹊之渡桥凝",
