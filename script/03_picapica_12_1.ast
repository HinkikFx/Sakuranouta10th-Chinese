        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_003722", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「刚才那首和歌啊，据说有好几种解释。母亲采用的，是把银河的",
