        text = {
            vo = {
                {"vo", file = "fem_mkd_003716", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「是啊。不过据说那个人把喜鹊的画落到浮世绘里的时候，反而有",
