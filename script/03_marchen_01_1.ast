    },
    block_00163 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002543", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「也是呢。居然央求人家跟自己接吻,作为朋友已经不合格了呢。」"
