        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「确实,草薙健一郎女性关系混乱这种事,周刊杂志三天两头就要报",
                    {"rt2"},
                    "道一番。看着那些报道,就算冒出个同父异母的妹妹也不奇怪」"
                }
