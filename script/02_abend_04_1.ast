        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，那可是最有名的公募展了。如今国内所有历史悠久的公募展",
                    {"rt2"},
                    "在它面前都黯然失色。媒体的报道力度也相当夸张」"
                }
            }
        },
        linkback = "block_00041",
        linknext = "block_00043"
    },
    block_00043 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0008", head = "aix_z1e", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0002", head = "aix_z1e", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_aid_000508", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「是吗？　不过这么说来摩尔公募展似乎并没有太长的历史……但",
                    {"rt2"},
                    "获了奖就会上新闻呢。为什么呢？」"
                }
            }
        },
        linkback = "block_00042",
        linknext = "block_00044"
    },
    block_00044 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「单纯因为对他们来说也有利可图。实际上摩尔公募展在日本和大",
                    {"rt2"},
                    "型广告代理商合作。那电视台以及各种媒体当然也会做专题了」"
                }
            }
        },
        linkback = "block_00043",
        linknext = "block_00045"
    },
    block_00045 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0012", head = "aix_z1e", lv = 4, id = 9},
        {"fgact", ch = "藍", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000509", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「是吗，怪不得搞那么大阵仗」"
                }
            }
        },
        linkback = "block_00044",
        linknext = "block_00046"
    },
    block_00046 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「话虽如此，在这个国家是从草薙健一郎获奖之后才出名的。在那",
                    {"rt2"},
                    "之前摩尔公募展几乎没有日本人正式获过奖」"
                }
            }
        },
        linkback = "block_00045",
        linknext = "block_00047"
    },
    block_00047 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「尤其是最高奖铂金·艾波拉尔，前无古人后无来者只有草薙健一郎",
                    {"rt2"},
                    "一人。当时被作为壮举大肆报道」"
                }
            }
        },
        linkback = "block_00046",
        linknext = "block_00048"
    },
    block_00048 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0001", head = "aix_z1e", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000510", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「那个奖是健一郎先生获奖之后才有名的吗……」"
                }
            }
        },
        linkback = "block_00047",
        linknext = "block_00049"
    },
    block_00049 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「仅限于国内变得有名。在海外很早就是知名公募展了。获过那个",
                    {"rt2"},
                    "奖的艺术家，作品必定超过一亿日元。所以绝不可能凭半吊子的作",
                    {"rt2"},
                    "品获奖」"
                }
            }
        },
        linkback = "block_00048",
        linknext = "block_00050"
    },
    block_00050 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0008", head = "aix_z1e", lv = 4, id = 9},
        {"fgact", ch = "藍", act = "おじぎ", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000511", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「那么难吗？　圭也说获奖难得不得了……」"
                }
            }
        },
        linkback = "block_00049",
        linknext = "block_00051"
    },
    block_00051 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「每年别说铂金·艾波拉尔了，连入选都没有。甚至有很多年连一个",
                    {"rt2"},
                    "获奖者都没有」"
                }
            }
        },
        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0012", head = "aix_z1e", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0009", head = "aix_z1e", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_aid_000512", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「厉害啊，不过作为公募展这没问题吗？　一个获奖者都没有的公",
                    {"rt2"},
                    "募展……」"
                }
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「又不是只在日本举办的，好几个国家同时进行。获奖名额不是按",
                    {"rt2"},
                    "国家分配的，所以实质上就是各国间的奖项争夺战」"
                }
            }
        },
        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以日本无人获奖的情况也时有发生……再说一遍，铂金·艾波拉",
                    {"rt2"},
                    "尔前无古人后无来者只有草薙健一郎」"
                }
            }
        },
        linkback = "block_00053",
        linknext = "block_00055"
    },
    block_00055 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0011", head = "aix_z1e", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000513", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「原来那么难……鸟谷在瞄准那种东西？」"
                }
            }
        },
        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「铂金·艾波拉尔绝对不可能，但在摩尔公募展上哪怕拿个鼓励奖还",
                    {"rt2"},
                    "是努力奖，只要沾上奖字就已是壮举」"
                }
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0002", head = "aix_z1e", lv = 4, id = 9},
        {"fgact", ch = "藍", act = "うなづく", lv = 4, id = 9},
        {"text"},
        delay = {
