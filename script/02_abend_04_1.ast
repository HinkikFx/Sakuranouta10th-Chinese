        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嘛,确实头疼吧。那种玩意儿。话说回来,没用过的室内鞋不是可",
                    {"rt2"},
                    "以拿去卖掉吗?」"
                }
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0008", head = "mak_z1a", lv = 4, id = 9},
        {"fgact", ch = "真琴", act = "いいえ", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_000993", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「没戏。那批货,是相当过分的次品。那种东西,一双一百日元都嫌",
                    {"rt2"},
                    "贵」"
                }
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「次品?怎么?室内鞋破了吗?」"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0025", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_000994", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「破倒是没破,是橡胶底。黏糊糊的,黏得吓人。老化严重到在这夏",
                    {"rt2"},
                    "天的高温里表面都开始融化了。想穿上脚是完全不可能的程度」"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此,那确实一百日元都嫌贵。简直就像买回来一批废品……」"
                }
