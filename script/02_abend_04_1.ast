    },
    block_00041 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0003", head = "aix_z1e", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000507", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「你知道得挺清楚嘛」"
                }
            }
        },
        linkback = "block_00040",
        linknext = "block_00042"
    },
    block_00042 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「毕竟,再没有比它更有名的公募展了吧。如今国内一切历史悠久的",
                    {"rt2"},
                    "公募展在它面前都黯然失色。媒体的报道热度也非同小可」"
                }
            }
        },
        linkback = "block_00041",
        linknext = "block_00043"
    },
    block_00043 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0008", head = "aix_z1e", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0002", head = "aix_z1e", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_aid_000508", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「是吗?不过这么一说,摩尔公募展给人的感觉确实历史不算长……。",
                    {"rt2"},
                    "可一旦获奖,连新闻里都会报道呢。这是为什么?」"
                }
            }
        },
        linkback = "block_00042",
        linknext = "block_00044"
    },
    block_00044 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「很简单,因为对他们来说这也能赚钱。实际上摩尔公募展在日本是",
                    {"rt2"},
                    "和大型广告代理公司合作的。那电视台以及各路大众媒体自然都会",
                    {"rt2"},
                    "做特辑了」"
                }
            }
        },
        linkback = "block_00043",
        linknext = "block_00045"
    },
    block_00045 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0012", head = "aix_z1e", lv = 4, id = 9},
        {"fgact", ch = "藍", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000509", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「原来如此,难怪搞得那么大阵仗」"
                }
            }
        },
        linkback = "block_00044",
        linknext = "block_00046"
    },
    block_00046 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「话虽如此,在这个国家,它是从草薙健一郎获奖之后才变得广为人",
                    {"rt2"},
                    "知的。在那之前,日本人从没在摩尔公募展上正经拿过奖」"
                }
            }
        },
        linkback = "block_00045",
        linknext = "block_00047"
    },
    block_00047 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「尤其是最高奖『白金鹰羽奖』,前无古人后无来者,只有草薙健一",
                    {"rt2"},
                    "郎一个。当年可是被当作壮举大肆报道的」"
                }
            }
        },
        linkback = "block_00046",
        linknext = "block_00048"
    },
    block_00048 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0001", head = "aix_z1e", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000510", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「那个奖是健一郎先生获奖之后才出名的啊……」"
                }
            }
        },
        linkback = "block_00047",
        linknext = "block_00049"
    },
    block_00049 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「说到底只是在国内出了名而已。在海外,那早就是相当有名的公募",
                    {"rt2"},
                    "展了。获得那个奖的艺术家,作品必然会突破亿元大关。正因如此,",
                    {"rt2"},
                    "凭半吊子的作品获奖是绝无可能的」"
                }
            }
        },
        linkback = "block_00048",
        linknext = "block_00050"
    },
    block_00050 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0008", head = "aix_z1e", lv = 4, id = 9},
        {"fgact", ch = "藍", act = "おじぎ", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000511", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「有那么难吗?圭也说过,想获奖难如登天……」"
                }
            }
        },
        linkback = "block_00049",
        linknext = "block_00051"
    },
    block_00051 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「每年别说『白金鹰羽奖』了,连入选都常常空缺。连一个获奖者都",
                    {"rt2"},
                    "没有的年份也屡见不鲜」"
                }
            }
        },
        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0012", head = "aix_z1e", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0009", head = "aix_z1e", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_aid_000512", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「真厉害啊,可这作为公募展没问题吗?一个获奖者都没有的公募展",
                    {"rt2"},
                    "……」"
                }
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为它不是只在日本国内举办的,好像是好几个国家同时进行。各",
                    {"rt2"},
                    "国的获奖名额并没有预先分配,所以实质上就是各国之间抢奖的局面」"
                }
            }
        },
        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以,才会出现日本无人获奖的情况……。我说过很多次了,『白金",
                    {"rt2"},
                    "鹰羽奖』这种东西,前无古人后无来者,也就只有草薙健一郎拿到过」"
                }
            }
        },
        linkback = "block_00053",
        linknext = "block_00055"
    },
    block_00055 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0011", head = "aix_z1e", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000513", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「有那么难吗……鸟谷是在冲着那种东西努力?」"
                }
            }
        },
        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「『白金鹰羽奖』根本想都别想,但在摩尔公募展上,不管是鼓励奖",
                    {"rt2"},
                    "还是安慰奖,只要是带『奖』字的,拿到哪个都算壮举」"
                }
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0002", head = "aix_z1e", lv = 4, id = 9},
        {"fgact", ch = "藍", act = "うなづく", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0008", head = "aix_z1e", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_aid_000514", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「原来如此,所以鸟谷那家伙才那么斗志昂扬啊……。话虽如此,她也",
                    {"rt2"},
                    "快高考了,真希望她适可而止地努力就好」"
                }
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嘛,今年还有圭在,说不定她心里正想着『万一呢』……。不过说实",
                    {"rt2"},
                    "话,摩尔公募恐怕还是很难吧……」"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0002", head = "aix_z1e", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000515", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「可是大家都在努力吧」"
                }
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不是努不努力的问题。那个奖,艺术性自不必说,更需要能吸引全",
                    {"rt2"},
                    "世界投资家目光的话题性和说服力」"
                }
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「正因为牵扯到钱,某种意义上,可以说那是要经受全世界最严苛的",
                    {"rt2"},
                    "审视目光的奖项」"
                }
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「获得那个奖,就等于得到了活跃于世界舞台的保证。先别提我们的",
                    {"rt2"},
                    "年龄,现在的弓张美术部部员里,有没有人能在一辈子之内获奖都很",
                    {"rt2"},
                    "难说」"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0009", head = "aix_z1e", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000516", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「有那种分量吗……」"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「弓张学园好像有个传统,历代三年级学生都要向摩尔公募展投稿之",
                    {"rt2"},
                    "后才从美术部引退,不过那说到底就像是纪念性的应考」"
                }
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「每年截稿期在十月末左右,之后就进入备考。话虽如此,弓张美术",
                    {"rt2"},
                    "部的学生大多要考美大或艺大,配合摩尔的日程画画,倒也不是没有",
                    {"rt2"},
                    "道理」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「某种意义上,正因为可以借此集中练习基础素描,这传统才延续下",
                    {"rt2"},
                    "来吧」"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不过话说回来,禀应该不会去考艺大之类的吧,她一直画画真的没",
                    {"rt2"},
                    "问题吗?」"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0004", head = "aix_z1e", lv = 4, id = 9},
