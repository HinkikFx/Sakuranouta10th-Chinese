                {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0008", head = "aix_z1e", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_aid_000514", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「原来如此，难怪鸟谷那么亢奋……不过升学考试也在即，希望她",
                    {"rt2"},
                    "适可而止」"
                }
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，今年有圭在，也许觉得有机会什么的……不过说实话，摩尔",
                    {"rt2"},
                    "公募展估计很难啊……」"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0002", head = "aix_z1e", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000515", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「可是大家都在努力吧」"
                }
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不是努力就能解决的事。那个虽然对艺术性有要求，但更需要足",
                    {"rt2"},
                    "以吸引全世界投资者目光的话题性与说服力」"
                }
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「正因为涉及金钱，某种意义上可以说是在全世界最严苛的审美眼",
                    {"rt2"},
                    "光下受审的奖项」"
                }
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「获得那个奖就等于拿到了活跃于世界舞台的通行证。且不说年龄，",
                    {"rt2"},
                    "就是弓张美术部现有的成员里，这辈子能否有人获奖都很难说」"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0009", head = "aix_z1e", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000516", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「竟然是那种程度的东西……」"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「弓张学园有个传统，三年级学生历来都是向摩尔公募展投稿之后",
                    {"rt2"},
                    "再从社团引退，但那基本上就是纪念性质的投稿」"
                }
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「每年十月底左右截止，之后就进入备考阶段。不过弓张美术部的",
                    {"rt2"},
                    "学生大多报考美术大学和艺术大学，所以配合摩尔的时间来画画也",
                    {"rt2"},
                    "不算不合理」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「某种意义上，正因为可以集中练习基础素描才有了这个传统吧」"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
