                    "回旧姓之前，她姓中村」"
                }
            }
        },
        linkback = "block_00034",
        linknext = "block_00036"
    },
    block_00036 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「还有你在『奥林匹亚』前对我说过的话。你和夏目家没有直接的",
                    {"rt2"},
                    "关系。但你说过，并非毫无干系」"
                }
            }
        },
        linkback = "block_00035",
        linknext = "block_00037"
    },
    block_00037 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002010", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「那么，你应该已经明白了吧」"
