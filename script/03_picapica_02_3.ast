        linkback = "block_00046",
        linknext = "block_00048"
    },
    block_00048 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我可没憎恨过什么中村家的血。再说了，真要这么讲，我母亲身",
