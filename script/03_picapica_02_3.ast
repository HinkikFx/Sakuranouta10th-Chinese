        },
        linkback = "block_00034",
        linknext = "block_00036"
    },
    block_00036 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你在『奥林匹亚』前对我说过的话。你和夏目家没有直接关系。",
                    {"rt2"},
                    "但你说，确实有所关联」"
