        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002053", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「看着草薙，我时常会想……温柔与狡猾之间的那种东西，究竟是",
                    {"rt2"},
                    "什么呢」"
                }
