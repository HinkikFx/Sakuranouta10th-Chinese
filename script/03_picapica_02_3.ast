    block_00002 = {
        {"fg", ch = "真琴", mode = -1, lv = 4, id = 9},
        {"text"},
        text = {
            ja = {
                {"鸟谷和我，谁也不打算说什么，谁也说不出什么。"}
            }
        },
        linkback = "block_00001",
        linknext = "block_00003"
    },
    block_00003 = {
        {"text"},
        text = {
            ja = {
                {
                    "脑海中不断浮现那时鸟谷的表情。近在咫尺凝视着我的鸟谷的双眸，",
                    {"rt2"},
                    "和微微颤抖的嘴唇。"
                }
            }
        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"text"},
        text = {
            ja = {
                {
                    "鸟谷身上散发出的那股强烈的紧张感，如今已经从她身上感受不到",
                    {"rt2"},
                    "了。"
                }
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            ja = {
                {"这是为什么呢。"}
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            ja = {
                {
                    "明明已经从鸟谷身上消失的紧张感，却在我的心中以一种奇妙的回",
                    {"rt2"},
                    "响，仿佛会一直残留下去。"
                }
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"bg", file = "black", path = ":bg/"},
        {"text"},
        text = {
            ja = {
                {"即便被送到了保健室，圭还是一直沉睡不醒。"}
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"text"},
        text = {
            ja = {
                {
                    "保健室也说，比起从楼梯上摔下来导致的昏厥，更像是因为睡眠不",
                    {"rt2"},
                    "足而昏倒的。"
                }
            }
        },
        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"text"},
        text = {
            ja = {
                {
                    "总不能让他湿漉漉的就躺在床上，于是让他换上了保健室老师准备",
                    {"rt2"},
                    "的干衣服。"
                }
            }
        },
        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"text"},
        text = {
            ja = {
                {"现在，圭以没有其他合适衣服为由，穿着女生校服在睡觉。"}
            }
        },
        linkback = "block_00009",
        linknext = "block_00011"
    },
    block_00011 = {
        {"text"},
        text = {
            ja = {
                {"圭的运动服刚好被带回家了。我的也一样。"}
