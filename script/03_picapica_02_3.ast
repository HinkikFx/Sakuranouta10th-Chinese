    },
    block_00110 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002050", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我说，草薙。你知不知道，这种做法有点狡猾？」"
                }
            }
        },
        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是啊……真正必要的时候，我也是会踏进去的。哪怕对方会因此",
                    {"rt2"},
                    "哭泣……」"
                }
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所谓本人想说的话就让他说，也可以说是交给对方来决定。不过",
                    {"rt2"},
                    "对圭和我而言，这样就好」"
                }
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            ja = {
                {
                    "我和鸟谷隔着圭沉睡的床彼此对望。然后，两人几乎同时把视线移",
                    {"rt2"},
                    "回到圭的身上。"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
