        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"text"},
        text = {
            ja = {
                {"平时两人的状态和表情差太远了，我连想都没有往那方面想过。"}
            }
        },
        linkback = "block_00016",
        linknext = "block_00018"
    },
    block_00018 = {
        {"text"},
        text = {
            ja = {
                {
                    "但是，这样一看……总觉得有些像……会这么想，是因为已经知道了",
