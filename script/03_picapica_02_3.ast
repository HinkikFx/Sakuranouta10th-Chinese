        linkback = "block_00040",
        linknext = "block_00042"
    },
    block_00042 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「差不多是我和他相识的时候。在那之前，夏目家里并没有圭」"
