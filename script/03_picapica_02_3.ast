        linkback = "block_00046",
        linknext = "block_00048"
    },
    block_00048 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我才没有憎恨中村家的血脉。说到底，要这么说的话，我母亲也",
