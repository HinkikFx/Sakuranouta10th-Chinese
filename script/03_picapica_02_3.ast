    },
    block_00103 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002046", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我知道一直说没事反而会起反效果，但还是让我说一句吧。我没",
                    {"rt2"},
                    "事的，自己能搞定的」"
                }
