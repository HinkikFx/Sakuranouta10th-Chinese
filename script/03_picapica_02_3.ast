    },
    block_00034 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002009", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「你从那个人那里听到了多少」"
                }
            }
