        linkback = "block_00041",
        linknext = "block_00043"
    },
    block_00043 = {
        {"text"},
        text = {
            ja = {
                {
                    "夏目宅邸原本的用途。还有身为现任当主的那个男子人的前妻——校",
                    {"rt2"},
                    "长，以及她的女儿。"
