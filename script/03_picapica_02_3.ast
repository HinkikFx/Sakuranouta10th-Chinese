        text = {
            vo = {
                {"vo", file = "fem_mkd_002015", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「你所憎恨的中村家的血，就流淌在我的身体里。倘若母亲没有和",
