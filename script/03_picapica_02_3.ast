        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"text"},
        text = {
            ja = {
                {"鸟谷想要结束这个话题的意向已经很明显了。"}
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「别管什么血统啊资格啊这些东西，如果你自己想和圭一起生活，",
                    {"rt2"},
                    "那就这么做好了」"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002025", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「明明你们自己才是分开生活最久的一家人，却对我说这种话？」"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"bg", file = "ev_com_b02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_b02/", set = "ev_com_b02"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「圭差点从楼梯上摔下去的时候，你想要接住他，我真没想到你会",
                    {"rt2"},
                    "比我先反应过来」"
                }
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那单纯是反应速度的问题。我平时也有锻炼身体。所以，如果你",
                    {"rt2"},
                    "能比我反应更快，那说明你的反应相当厉害」"
                }
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不只是鸟谷运动神经好这么简单，而是更强烈的……就好像是一",
                    {"rt2"},
                    "种强烈的羁绊在驱使着你行动，不是吗？」"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「而且，你抱住救下的圭，露出安心表情的那一刻，我感受到了一",
                    {"rt2"},
                    "种与恋爱不同的、深沉而强烈的爱。就像家人之间的爱一样」"
                }
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「都说紧急时刻才会暴露真心。那个时候你展露的表情，不正是你",
                    {"rt2"},
                    "最真实的心声吗？」"
                }
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「把圭当作弟弟珍惜着的心情……如果那是你的真心的话……」"
                }
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"se", file = "se9010", vol = 20, id = 1},
