                {"vo", file = "fem_mkd_002054", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「因为你非常温柔，又有那么一点点狡猾。所以我总是会忍不住去",
                    {"rt2"},
                    "想」"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「想我的狡猾之处吗？」"
                }
            }
