        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002021", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我即便断绝了关系，也继承着中村的『正统』血脉。按理来说，",
                    {"rt2"},
                    "我连踏入那座宅邸都不被允许」"
                }
            }
