    },
    block_00091 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「为什么」"
                }
            }
        },
        linkback = "block_00090",
        linknext = "block_00092"
    },
    block_00092 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002037", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「因为会让人产生误会啊」"
