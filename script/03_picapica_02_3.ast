        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002015", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「你所憎恨的中村家的血液流淌在我的身体里。如果母亲没有和中",
