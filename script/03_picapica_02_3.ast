    block_00041 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002012", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「你的话，应该知道圭是从什么时候开始姓夏目的吧？」"
