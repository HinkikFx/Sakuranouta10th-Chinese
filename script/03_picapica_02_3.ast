        linkback = "block_00033",
        linknext = "block_00035"
    },
    block_00035 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「校长离了婚，改回鸟谷这个姓，还夺取了这所学园。以及，在改",
