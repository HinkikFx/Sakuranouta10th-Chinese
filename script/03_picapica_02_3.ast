    },
    block_00101 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002044", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「关于圭的事，我对那个人怀着无法消除的执念。确实还有没有理",
                    {"rt2"},
