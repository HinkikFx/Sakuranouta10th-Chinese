    },
    block_00086 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002033", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「来夏目宅邸和圭一起住啊什么的，你对我这么上心……嗯，这件",
                    {"rt2"},
                    "事本身我很开心。谢谢你，但是呢」"
