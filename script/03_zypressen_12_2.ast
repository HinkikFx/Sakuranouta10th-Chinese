    },
    block_00544 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002720", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯,嗯……我想大概是因为兴奋了……。也许其实还是痛的……但兴",
                    {"rt2"},
                    "奋压过了疼痛……根本感觉不到痛……」"
                }
            }
        },
        linkback = "block_00543",
        linknext = "block_00545"
    },
    block_00545 = {
