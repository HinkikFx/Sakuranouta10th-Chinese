    },
    block_00155 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002808", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「哈呜……不,不是不行。可是,嗯嗯,这么舒服的话,不行的……哈呜,马",
                    {"rt2"},
                    "上就会结束的……」"
                }
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「里奈的欧派真的好敏感啊……啊姆」"
                }
            }
