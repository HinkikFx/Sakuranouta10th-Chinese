                {"vo", file = "fem_rna_002889", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「哈啊,哈啊……哈啊啊…………是我自己……放进来的哦。所以,怎么可",
                    {"rt2"},
