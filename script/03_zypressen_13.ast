    block_00347 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002886", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯――,嗯呼――…………啊,进,进来了。啊,直哉同学的……！！」"
                }
