        text = {
            vo = {
                {"vo", file = "fem_rna_002866", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯哈啊……跳得好厉害……小鸡鸡一边喷洒着汁液,一边一跳一跳的",
                    {"rt2"},
                    "哦。好可爱……嗯,呼……这样的直哉同学……」"
                }
            }
        },
        linkback = "block_00288",
        linknext = "block_00290"
    },
    block_00290 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊啊,已经,不行了。撑不住了。这样根本撑不住……。嗯哈啊……",
                    {"rt2"},
                    "哈啊……里,里奈……我,好像不行了。完全撑不住了……呜呜嗯」"
                }
            }
        },
        linkback = "block_00289",
        linknext = "block_00291"
    },
    block_00291 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002867", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「和刚才正好相反呢。不用忍耐的哦。可以尽情地,大量地射出来哦。",
                    {"rt2"},
                    "我会全部接住的……」"
                }
            }
        },
        linkback = "block_00290",
        linknext = "block_00292"
    },
    block_00292 = {
        {"text"},
