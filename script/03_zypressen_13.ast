            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯哈,可,可是,我想忍住嘛。接,接下来,还要做更色的事情呢,啊嗯,",
                    {"rt2"},
                    "嗯嗯嗯,可是,好舒服,要被直哉同学的舌头融化了」"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"quake", size = 5, mode = "mw"},
