        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002809", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「直,直哉同学才是,太喜欢欧派了哦。嗯嗯……不,不要嘛,像小宝宝",
                    {"rt2"},
                    "一样,嗯,啾啾地吸着欧派的话……」"
                }
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为,里奈的乳头含在嘴里刚刚好,那感触让人受不了……」"
                }
            }
        },
        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002810", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「啊啊嗯,嗯嗯嗯,不许含着乳头说话啦。那,那样,震动,太舒服了啦,",
                    {"rt2"},
                    "昨天不是说过了嘛。啊,呜嗯,啊呜嗯」"
                }
            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「又要靠欧派去了吗？」"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002811", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「才,才不要,我会忍住的。光靠欧派就去掉什么的……。啊啊嗯,可,",
                    {"rt2"},
                    "可是太舒服了,哈啊哈啊,嗯嗯,我快要,变得奇怪了」"
                }
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"text"},
        text = {
