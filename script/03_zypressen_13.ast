        linkback = "block_00347",
        linknext = "block_00349"
    },
    block_00349 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002887", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯,嗯,可是,对不起……。这样很过分吧。突然就自己放进来……这",
                    {"rt2"},
                    "样,简直像是反过来强暴你一样……！」"
                }
