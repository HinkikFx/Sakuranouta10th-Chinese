        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002803", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「啊嗯,嗯嗯,直,直哉同学,你舔的方式好色哦」"
                }
            }
        },
        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊啊,就是很色的舔法……啧普,啾,啾啾……」"
