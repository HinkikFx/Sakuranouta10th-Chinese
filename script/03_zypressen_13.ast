        linknext = "block_00351"
    },
    block_00351 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002888", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「怎么可能会痛。因为是自己想要,自己放进来的嘛……我,想要变得",
                    {"rt2"},
                    "舒服……想要直哉同学的小鸡鸡……呜嗯」"
                }
