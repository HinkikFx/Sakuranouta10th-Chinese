        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「和本、账簿、杂志剪报、浮世绘和油画——用来骗人的材料我都看",
                    {"rt2"},
                    "过了，具体是怎么做的呢？」"
