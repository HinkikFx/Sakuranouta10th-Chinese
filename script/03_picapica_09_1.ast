        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「从鸟谷那里听说了很多事」"
                }
            }
        },
        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"fg", ch = "紗希", size = "z1", mode = 3, path = ":fg/sak/z1/", file = "sak_z1a0000", face = "a0002", head = "sak_z1a", lv = 4, id = 8},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000288", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「嗯……因为在这次与丽华的交涉中判断有必要告诉她。那已经是",
                    {"rt2"},
                    "很久以前的事了」"
                }
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那篇文章是专门去印的吗」"
                }
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"fgact", ch = "紗希", act = "うなづく", lv = 4, id = 8},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "紗希", size = "z1", mode = 3, path = ":fg/sak/z1/", file = "sak_z1a0000", face = "a0003", head = "sak_z1a", lv = 4, id = 8}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_htd_000289", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「是的。其实那是让认识的印刷厂把整本杂志都印了出来的。还是",
                    {"rt2"},
                    "没有DTP的年代，全是手工作业，所以花了不少钱」"
                }
            }
