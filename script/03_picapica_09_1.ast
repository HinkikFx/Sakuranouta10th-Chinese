        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"fg", ch = "紗希", size = "z1", mode = 3, path = ":fg/sak/z1/", file = "sak_z1a0000", face = "a0008", head = "sak_z1a", lv = 4, id = 8},
        {"text"},
        delay = {
