        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0810", face = "a0009", head = "rin_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001339", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「可是这样我很为难,请把头抬起来」"
                }
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不行,我趁着你对我的信任,用下流的心思死盯着你的裆部看」"
                }
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0810", face = "a0014", head = "rin_z1a", lv = 4, id = 9},
        {"fgact", ch = "稟", act = "いいえ", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0810", face = "a0010", head = "rin_z1a", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_rnd_001340", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「别、别别别说这种话啦！　人、人家会不好意思的啦！」"
                }
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,但这是事实。明明是你出于信任才配合的,我却压抑不住自己",
                    {"rt2"},
                    "的邪念看得入了迷！　我还尽可能、尽可能地让你把腿张开,盯着布",
                    {"rt2"},
                    "料勒进裆部的样子看个不停！」"
                }
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0810", face = "a0008", head = "rin_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_001341", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「尽、尽可能？」"
                }
            }
        },
        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,尽可能！　尽可能让布料勒进裆部！　那可是,让你张到布料",
                    {"rt2"},
                    "紧绷绷地勒进去、隐约都能看出那道沟的程度！　然后死死凝视！」"
