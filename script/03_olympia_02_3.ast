        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊啊，尽可能地！　尽可能地让布料嵌入胯间！　就差能隐约看",
                    {"rt2"},
                    "到那条线的程度紧紧地嵌进去那样让你张开！　然后凝视！」"
