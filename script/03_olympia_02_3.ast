            }
        },
        text = {
            vo = {
                {"vo", file = "fem_rnd_001340", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「你、你你你不要说那种话！　会、会害我很不好意思的！」"
                }
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不，但那是事实。你是出于信任才做的那些事，我却无法控制自",
                    {"rt2"},
                    "己的情欲看入了迷！　尽可能地、尽可能地让你张开腿，看那布料",
