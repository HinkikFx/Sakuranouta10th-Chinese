    },
    block_00157 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_000562", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「凭千年樱的花瓣获得形体，又借着模仿千年樱的、草薙健一郎的",
                    {"rt2"},
                    "作品，被许多人所认识」"
                }
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_sud_000469", ch = "sud"}
            },
            ja = {
                {
                    name = {"吹", "？？？"},
                    "「可是，健一郎的那幅画，也渐渐变得寻常了」"
