        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_sud_000470", ch = "sud"}
            },
            ja = {
                {
                    name = {"吹", "？？？"},
                    "「但是，曾有人怀着近似祈祷的心情画下了它，也有人看见了它。",
                    {"rt2"},
                    "所以我才得以存在」"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
