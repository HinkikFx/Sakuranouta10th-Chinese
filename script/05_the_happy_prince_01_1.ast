        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000011", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「怎么说呢,我在学校里也跟着脸上有光呢。“啊,这是我朋友。我们",
                    {"rt2"},
                    "一直是同学哦”什么的」"
                }
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"text"},
        text = {
            ja = {
                {"是不是同学我不知道,反正我不太记得你这个人。"}
