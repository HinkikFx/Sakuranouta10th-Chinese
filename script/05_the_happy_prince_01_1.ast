        },
        linkback = "block_00023",
        linknext = "block_00025"
    },
    block_00025 = {
        {"text"},
        text = {
            ja = {
                {
                    "尽管被人说贪财如命,被骂作商业艺术家、江湖骗子,他的作品至今",
