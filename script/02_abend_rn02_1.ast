            vo = {
                {"vo", file = "fem_rnd_000597", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「是、是吗？」"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「至少全班同学都是这么想的。嘛,美术部那帮家伙似乎也这么想」"
                }
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_000598", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「这样啊,是这样啊。那真让人高兴」"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不过小时候的你可不是这种类型」"
                }
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_000599", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「那、那是以前嘛。现在正如大家所想,我还算是挺淑女的哦」"
                }
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那么？这样的淑女大人都做些什么样的妄想呢？」"
                }
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_000600", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「淑女大人是不做妄想的」"
                }
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你不是说做了吗」"
