            },
            ja = {
                {
                    name = {"禀"},
                    "「因为刚才直君亲自传授了应对不利问题的无视技巧嘛」"
                }
            }
        },
        linkback = "block_00215",
        linknext = "block_00217"
    },
    block_00217 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
