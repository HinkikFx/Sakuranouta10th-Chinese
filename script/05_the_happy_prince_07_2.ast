        linkback = "block_00034",
        linknext = "block_00036"
    },
    block_00036 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_msk_000005", ch = "msk"}
            },
            ja = {
                {
                    name = {"男司仪"},
                    "「那、那个……这画的应该是那个吧。是蝶群正在渡海对吧。哎呀，",
                    {"rt2"},
                    "好惊人的蝶群……气势骇人」"
                }
            }
        },
        linkback = "block_00035",
        linknext = "block_00037"
    },
    block_00037 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_msk_000006", ch = "msk"}
            },
            ja = {
                {
                    name = {"男司仪"},
                    "「但比这更令我们瞠目的，是近前的那片漩涡吧。这仿佛要将人吸",
                    {"rt2"},
                    "进去的漩涡，与飞舞空中的蝶群形成了极为深刻的对比……」"
                }
            }
        },
        linkback = "block_00036",
        linknext = "block_00038"
    },
    block_00038 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_msk_000007", ch = "msk"}
            },
            ja = {
                {
                    name = {"男司仪"},
                    "「大海反而透着一种澄澈的通透感……这又给漩涡平添了近乎恐怖",
                    {"rt2"},
                    "的感觉……」"
                }
            }
        },
        linkback = "block_00037",
        linknext = "block_00039"
    },
    block_00039 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_msk_000008", ch = "msk"}
            },
            ja = {
                {
                    name = {"男司仪"},
                    "「请问，这些蝴蝶有原型吗？」"
                }
            }
        },
        linkback = "block_00038",
        linknext = "block_00040"
    },
    block_00040 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「有的，是一种名叫大绢斑蝶、具有渡海习性的蝴蝶」"
                }
            }
        },
        linkback = "block_00039",
        linknext = "block_00041"
    },
    block_00041 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「大绢斑蝶也被称为“旅行的蝴蝶”，入夏北上，入秋南下」"
                }
            }
        },
        linkback = "block_00040",
        linknext = "block_00042"
    },
    block_00042 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「据说是唯一会跨越国境的蝴蝶」"
                }
            }
        },
        linkback = "block_00041",
        linknext = "block_00043"
    },
    block_00043 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_msk_000009", ch = "msk"}
            },
            ja = {
                {
                    name = {"男司仪"},
                    "「不过，真是了不起啊。哎呀，我从刚才起就只会说了不起，完全",
                    {"rt2"},
                    "是不称职的主持人……」"
                }
            }
        },
        linkback = "block_00042",
        linknext = "block_00044"
    },
    block_00044 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_msk_000010", ch = "msk"}
            },
            ja = {
                {
                    name = {"男司仪"},
                    "「该怎么说呢……梦幻般的蝶群，还有近前的漩涡……这让我这样的",
                    {"rt2"},
                    "人联想到死亡」"
                }
            }
        },
        linkback = "block_00043",
        linknext = "block_00045"
    },
    block_00045 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_msk_000011", ch = "msk"}
            },
            ja = {
                {
                    name = {"男司仪"},
                    "「明明没有一只蝴蝶被漩涡吞没……可怎么说呢……明明没有被吞没，",
                    {"rt2"},
                    "却仿佛就要被吞没……」"
                }
            }
        },
        linkback = "block_00044",
        linknext = "block_00046"
    },
    block_00046 = {
        {"text"},
        text = {
            ja = {
                {"这正是经过计算才画成的。"}
            }
        },
        linkback = "block_00045",
        linknext = "block_00047"
    },
    block_00047 = {
        {"text"},
        text = {
            ja = {
                {"铺满天空的优雅蝶群，与翻涌的透明大海，以及被着意强调的漩涡。"}
            }
        },
        linkback = "block_00046",
        linknext = "block_00048"
    },
    block_00048 = {
        {"text"},
        text = {
            ja = {
                {
                    "明明像是各自发生在不同世界的景象，却被呈现于同一个世界之中，",
                    {"rt2"},
                    "由此带给观者强烈的违和感。"
                }
            }
        },
        linkback = "block_00047",
        linknext = "block_00049"
    },
    block_00049 = {
        {"text"},
        text = {
            ja = {
                {"那违和感唤起不安，而那份不安又被画面深处美丽的蝶群所抵消。"}
            }
        },
        linkback = "block_00048",
        linknext = "block_00050"
    },
    block_00050 = {
        {"text"},
        text = {
            ja = {
                {
                    "意识感到美，无意识感到恐惧。一切都经过计算，好将这样的混乱",
                    {"rt2"},
                    "施加给观者。"
                }
            }
        },
        linkback = "block_00049",
        linknext = "block_00051"
    },
    block_00051 = {
        {"text"},
        text = {
            ja = {
                {"『樱七相图』通过刻意描绘尸骸来表现死亡。"}
            }
        },
        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"text"},
        text = {
            ja = {
                {"而『梦蝶』则通过全然不画死亡，来表现死亡。"}
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"text"},
        text = {
            ja = {
                {"当然，这是否完全成功，我并不知道。"}
            }
        },
        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"text"},
        text = {
            ja = {
                {"但是，这种触感。毫无疑问，我的意图成功了。"}
            }
        },
        linkback = "block_00053",
        linknext = "block_00055"
    },
    block_00055 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_msk_000012", ch = "msk"}
            },
            ja = {
                {
                    name = {"男司仪"},
                    "「这种感觉……真是难以言喻。这是日本画吗？」"
                }
            }
        },
        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是的，我特意画成了这样的作品」"
                }
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"text"},
        text = {
            ja = {
                {"日本画家速水御舟有一幅著名的画作。『炎舞』"}
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            ja = {
                {"那是一幅描绘飞蛾几乎要被篝火焚身的作品。"}
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"text"},
        text = {
            ja = {
                {"据说速水御舟每晚燃起篝火，实地写生聚集而来的飞蛾。"}
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
            ja = {
                {"火焰是佛画中所用的那种独特的红莲之炎。"}
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            ja = {
                {"其上空飞舞的蛾影。"}
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            ja = {
                {"十分神秘。"}
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"text"},
        text = {
            ja = {
                {"而我特意将这种美完全反其道而行。"}
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            ja = {
                {
                    "不是佛教式的变形火焰，而是彻底写实、却又不失日本画风韵的大",
                    {"rt2"},
                    "海与漩涡的表现（要说像奥村土牛，那还真是像）。"
                }
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"text"},
        text = {
            ja = {
                {"而且不是飞蛾，而是美丽的蝶群。"}
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            ja = {
