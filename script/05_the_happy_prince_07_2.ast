        },
        linkback = "block_00039",
        linknext = "block_00041"
    },
    block_00041 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「青斑蝶也被称为'旅行的蝴蝶'，夏季向北飞行，秋季南下」"
                }
            }
        },
        linkback = "block_00040",
        linknext = "block_00042"
    },
    block_00042 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「据说是唯一一种会跨越国境的蝴蝶」"
                }
            }
        },
        linkback = "block_00041",
        linknext = "block_00043"
    },
    block_00043 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_msk_000009", ch = "msk"}
            },
            ja = {
                {
                    name = {"男司仪"},
                    "「不过真的太厉害了。不，从刚才开始我就只会说'太厉害了'，完全",
