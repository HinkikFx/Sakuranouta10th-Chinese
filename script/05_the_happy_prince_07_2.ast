    block_00036 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_msk_000005", ch = "msk"}
            },
            ja = {
                {
                    name = {"男司仪"},
                    "「呃、这个……这是蝴蝶群正在飞越大海对吧。哇，好多蝴蝶啊……",
                    {"rt2"},
                    "气势太惊人了」"
