    },
    block_00037 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_msk_000006", ch = "msk"}
            },
            ja = {
                {
                    name = {"男司仪"},
                    "「但是，比起那些蝴蝶，更令我们震撼的应该是画面前方的漩涡吧。",
                    {"rt2"},
                    "这仿佛要把人吸进去的旋涡，与空中飞舞的蝴蝶群形成了非常令人",
                    {"rt2"},
                    "印象深刻的对比……」"
                }
            }
        },
        linkback = "block_00036",
        linknext = "block_00038"
    },
    block_00038 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_msk_000007", ch = "msk"}
            },
            ja = {
                {
                    name = {"男司仪"},
                    "「海水反而有一种澄澈的透明感……这一点又为漩涡增添了一种恐",
                    {"rt2"},
                    "惧感……」"
                }
            }
        },
        linkback = "block_00037",
        linknext = "block_00039"
    },
    block_00039 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_msk_000008", ch = "msk"}
            },
            ja = {
                {
                    name = {"男司仪"},
                    "「这画中的蝴蝶有原型吗？」"
