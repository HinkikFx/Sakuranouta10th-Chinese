        linkback = "block_00042",
        linknext = "block_00044"
    },
    block_00044 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_msk_000010", ch = "msk"}
            },
            ja = {
                {
                    name = {"男司仪"},
                    "「该怎么说呢……梦幻般的蝴蝶群，还有前方的漩涡……在我这种人",
                    {"rt2"},
                    "看来会联想到死亡」"
