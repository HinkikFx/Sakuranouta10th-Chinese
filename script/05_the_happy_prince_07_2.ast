        text = {
            vo = {
                {"vo", file = "man_skm_000044", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「什么意思」"
                }
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000050", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「你看看会场」"
                }
            }
        },
        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000045", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「会场？」"
                }
            }
        },
        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"text"},
        text = {
            ja = {
                {"会场一片寂静。"}
            }
        },
        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
        {"text"},
        text = {
            ja = {
                {"谁都在凝望着圭的画。"}
            }
        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000051", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「如果难懂，观众应该会动摇。应该能听到骚动声」"
                }
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000052", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「但是，这份寂静……是被夺去了心神啊。被那幅画」"
                }
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000046", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「是这样吗？」"
                }
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000053", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「印象派问世时，所有的权威都否定了它」"
                }
            }
        },
        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000054", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「沙龙与印象派对立的那种格局，痕迹至今可见」"
                }
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000047", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「你是说印象派的作品大多流向了美国？」"
                }
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000055", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「不，我是说，为什么法国会同时有卢浮宫美术馆和奥赛美术馆」"
                }
            }
        },
        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000056", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「与沙龙对立的印象派绘画，陈列在奥赛而不是卢浮宫」"
                }
            }
        },
        linkback = "block_00148",
        linknext = "block_00150"
    },
    block_00150 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000048", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「最早是在国立网球场美术馆就是了。嘛，你想说的我明白」"
                }
            }
        },
        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000057", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「支持印象派的，正是巴黎市民」"
                }
            }
        },
        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000049", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「如今看来难解的印象派，对当时的巴黎人来说，却远比之前的艺",
                    {"rt2"},
                    "术更易懂、更亲切」"
                }
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000058", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「嘛，这大概也和印象派受日本主义……浮世绘等的影响很深有关",
                    {"rt2"},
                    "吧」"
                }
            }
        },
        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000050", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「毕竟浮世绘是大众艺术……」"
                }
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000059", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「就是这么回事」"
                }
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000051", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「村田你对那个叫夏目的家伙的作品评价可真高啊」"
                }
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000060", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「凭直觉。凡事直觉最重要」"
                }
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000052", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「我倒觉得，单论画本身，是草薙家的小子更胜一筹」"
                }
            }
        },
        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000061", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「嘛，画家都会这么说吧。可摩尔会怎么判断呢，那幅画」"
                }
            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000053", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「喂喂，输给那个，我可不太服气啊」"
