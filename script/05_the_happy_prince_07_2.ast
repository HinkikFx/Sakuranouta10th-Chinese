        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            ja = {
                {
                    "但据说还有一个奖将在此颁发，而关于那个奖，在座的任何人都未",
                    {"rt2"},
                    "被告知。"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            ja = {
                {"气氛不由自主地变得紧张起来。"}
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            ja = {
                {"但是，对我来说那个答案已经无所谓了。"}
