    block_00225 = {
        {"text"},
        text = {
            ja = {
                {"弗里德曼不知为何注视着我。"}
            }
        },
        linkback = "block_00224",
        linknext = "block_00226"
    },
    block_00226 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「……」"
                }
            }
        },
        linkback = "block_00225",
