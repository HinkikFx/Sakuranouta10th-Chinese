        linkback = "block_00038",
        linknext = "block_00040"
    },
    block_00040 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是的，是一种叫做青斑蝶的、具有飞越大海习性的蝴蝶」"
