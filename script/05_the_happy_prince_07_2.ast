        linkback = "block_00045",
        linknext = "block_00047"
    },
    block_00047 = {
        {"text"},
        text = {
            ja = {
                {"铺满天空的优雅蝴蝶，以及翻涌的透明大海与被刻意强调的漩涡。"}
            }
        },
        linkback = "block_00046",
        linknext = "block_00048"
    },
    block_00048 = {
        {"text"},
        text = {
            ja = {
                {
                    "它们仿佛各自发生在不同的世界，却被表现在同一个世界里，由此",
                    {"rt2"},
                    "给观众带来强烈的违和感。"
                }
            }
        },
        linkback = "block_00047",
        linknext = "block_00049"
    },
    block_00049 = {
        {"text"},
        text = {
            ja = {
                {
                    "那种违和感会唤起不安，但那份不安又被远处描绘的美丽蝴蝶群所",
                    {"rt2"},
                    "中和。"
                }
            }
        },
        linkback = "block_00048",
        linknext = "block_00050"
    },
    block_00050 = {
        {"text"},
        text = {
            ja = {
                {
                    "意识感受到美丽，潜意识感受到恐惧。这就是经过计算、旨在给观",
                    {"rt2"},
                    "众带来这种混乱的设计。"
                }
            }
        },
        linkback = "block_00049",
        linknext = "block_00051"
    },
    block_00051 = {
        {"text"},
        text = {
            ja = {
                {"『樱七相图』是通过刻意描绘死骸来表现死亡。"}
            }
        },
        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"text"},
        text = {
            ja = {
                {"而『蝶を梦む』则是通过完全不描绘死亡来表现死亡。"}
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"text"},
        text = {
            ja = {
                {"当然，这种手法是否完全成功了，我自己也不确定。"}
