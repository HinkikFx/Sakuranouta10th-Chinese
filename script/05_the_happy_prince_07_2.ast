    },
    block_00201 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_msk_000020", ch = "msk"}
            },
            ja = {
                {
                    name = {"男司仪"},
                    "「这个奖，是全世界仅有一人能够获得的极其珍贵的奖项。据说比",
