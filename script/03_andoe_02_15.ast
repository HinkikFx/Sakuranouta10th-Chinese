        linknext = "block_00147"
    },
    block_00147 = {
        {"text"},
        text = {
            ja = {
                {"因为我并没有那么爱那家伙……本想这么说来着……可那是弥天大谎。"}
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"text"},
        text = {
            ja = {
                {"实际上,是那家伙把我的作品称作『墓志铭』的那一天。"}
            }
        },
        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"text"},
        text = {
            ja = {
                {"是那家伙在我的六部作上盖下落款的那一天。"}
            }
        },
        linkback = "block_00148",
        linknext = "block_00150"
    },
    block_00150 = {
        {"text"},
        text = {
            ja = {
                {"我早已哭得一塌糊涂。"}
            }
        },
        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"text"},
        text = {
            ja = {
                {"六部作是墓志铭吗……。真是那家伙式的表达。"}
            }
        },
        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            ja = {
                {"但我想,我的作品因此得到了救赎。"}
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            ja = {
                {"被创造出来的东西,但愿,能够得到救赎。"}
            }
        },
        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            ja = {
                {"几乎所有的创作者都会这么想吧。"}
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            ja = {
                {"从这个意义上说,我想我是个幸运的画画的人。"}
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            ja = {
                {"所以,在那片樱花之森下,我才能平平静静地送走老爸吧……。"}
            }
