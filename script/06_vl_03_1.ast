    },
    block_00205 = {
        {"fg", ch = "ノノ未", size = "z2", ex03 = "a0097", mode = 3, resize = 1, path = ":fg/non/z2/", file = "non_z2a0200", face = "a0005", head = "non_z2a", lv = 5, id = 9},
