        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「片贝明知道你是那样的，还说想跟你交往？　那家伙是萝莉控吗」"
