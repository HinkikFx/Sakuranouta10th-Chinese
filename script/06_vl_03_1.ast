                {"vo", file = "fem_nnd_000062", ch = "nnd"}
            },
            ja = {
                {
                    name = {"乃乃未"},
                    "「那话对乃乃未很失礼哦。现在的我哪一点像萝莉了？　看着这对",
                    {"rt2"},
                    "胸您还说得出口吗？」"
