        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「要做掉我,总得有做掉我的准备吧,你以为这么走一步看一步还能",
                    {"rt2"},
                    "成功吗？」"
                }
