        linkback = "block_00326",
        linknext = "block_00328"
    },
    block_00328 = {
        {"fg", ch = "明石", size = "z1", mode = 3, path = ":fg/aka/z1/", file = "aka_z1e0000", face = "e0001", head = "aka_z1e", x = -345, lv = 4, id = 5},
        {"fg", ch = "章一", size = "z1", ex03 = "a0097", mode = 3, path = ":fg/syo/z1/", file = "syo_z1a0000", face = "a0001", head = "syo_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_frd_000015", ch = "frd"}
            },
            ja = {
                {
                    name = {"弗里曼"},
                    "「不必在意我,我只是以草薙健一郎财产管理员的身份,来见草薙直",
                    {"rt2"},
                    "哉的」"
                }
            }
        },
        linkback = "block_00327",
        linknext = "block_00329"
    },
    block_00329 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_frd_000016", ch = "frd"}
            },
            ja = {
                {
                    name = {"弗里曼"},
                    "「不过,这种规模的大买卖,事先签份誓约书,我倒不觉得有什么奇怪",
                    {"rt2"},
                    "的？」"
                }
            }
        },
        linkback = "block_00328",
        linknext = "block_00330"
    },
    block_00330 = {
        {"fg", ch = "明石", size = "z1", mode = 3, path = ":fg/aka/z1/", file = "aka_z1e0000", face = "e0002", head = "aka_z1e", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000655", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「就是就是,只是份保密义务的誓约书罢了,您要是实在读不懂英语,",
                    {"rt2"},
                    "要不要老夫念给您听？」"
                }
            }
        },
        linkback = "block_00329",
        linknext = "block_00331"
    },
    block_00331 = {
        {"fg", ch = "章一", size = "z1", ex03 = "a0097", mode = 3, path = ":fg/syo/z1/", file = "syo_z1a0000", face = "a0005", head = "syo_z1a", x = 345, lv = 4, id = 6},
        {"fgact", ch = "章一", act = "びっくり", lv = 4, id = 6},
