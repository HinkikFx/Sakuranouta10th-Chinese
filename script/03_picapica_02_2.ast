                {"vo", file = "fem_mkd_001974", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「啊,是吗……」"
                }
            }
        },
        linkback = "block_00248",
        linknext = "block_00250"
    },
    block_00250 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯,你的建议我也听进去了。我觉得鸟谷说得对。要参加摩尔展的",
                    {"rt2"},
                    "话,也差不多该让她画自己的画了」"
