        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"fg", ch = "紗希", size = "z2", mode = 3, path = ":fg/sak/z2/", file = "sak_z2b0000", face = "b0002", head = "sak_z2b", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
