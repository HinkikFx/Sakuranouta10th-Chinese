    },
    block_00077 = {
        {"fg", ch = "紗希", size = "z2", mode = 3, path = ":fg/sak/z2/", file = "sak_z2a0000", face = "a0001", head = "sak_z2a", lv = 5, id = 9},
        {"text"},
        text = {
