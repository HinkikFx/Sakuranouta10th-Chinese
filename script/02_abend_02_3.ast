        text = {
            vo = {
                {"vo", file = "fem_mkd_000906", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「说起土豆炖肉，不都说每个家庭有各自固定用的食材嘛。我家是",
