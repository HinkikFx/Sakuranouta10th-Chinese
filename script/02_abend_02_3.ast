        linknext = "block_00095"
    },
    block_00095 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「毕竟蒜香面包边配肝脏肉酱简直是绝配。买不起米的时候最靠得",
                    {"rt2"},
                    "住的就是鸡肝肉酱了」"
                }
            }
