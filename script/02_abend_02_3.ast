    },
    block_00115 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0110", face = "a0003", head = "mak_z1a", x = 0, lv = 4, id = 5},
        {"text"},
        delay = {
