        text = {
            vo = {
                {"vo", file = "fem_mkd_000914", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「就是放调味料的顺序啦。“sa”是砂糖,“shi”是盐(shio),“su”是醋(su)",
                    {"rt2"},
                    ",“se”是酱油(seuyu),“so”是……什么来着?　辣酱油(sōsu)?」"
                }
