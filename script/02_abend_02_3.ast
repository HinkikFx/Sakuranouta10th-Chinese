    block_00113 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我可没做什么特别的事。就是“sa·shi·su·se·so”的基础,再就是除非",
                    {"rt2"},
                    "做蜜煮,鱼不能久炖。汤滚之后开大火,尽量快速炖熟。嘛,这也是基",
