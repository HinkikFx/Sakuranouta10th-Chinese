        linkback = "block_00090",
        linknext = "block_00092"
    },
    block_00092 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那是把做饭当爱好的人吧。我可不是什么爱好。只不过自己做饭",
