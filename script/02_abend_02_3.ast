                    "「总觉得这想法跟『肉酱』这个词的优雅腔调完全背道而驰呢」"
                }
            }
        },
        linkback = "block_00095",
        linknext = "block_00097"
    },
    block_00097 = {
        {"fg", ch = "圭", size = "z1", mode = 3, path = ":fg/kei/z1/", file = "kei_z1a0100", face = "a0017", head = "kei_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "圭", size = "z1", mode = 3, path = ":fg/kei/z1/", file = "kei_z1a0100", face = "a0002", head = "kei_z1a", x = 345, lv = 4, id = 6}
            }
        },
        text = {
            vo = {
                {"vo", file = "man_ked_000878", ch = "ked"}
            },
            ja = {
                {
                    name = {"圭"},
                    "「这么说来,你来我们家以后就没做过肉酱了。倒是和食风的菜多了",
                    {"rt2"},
                    "起来」"
                }
            }
        },
        linkback = "block_00096",
        linknext = "block_00098"
    },
    block_00098 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为有米嘛。不用考虑跟面包边搭不搭,自然而然就偏向和食了」"
                }
            }
        },
        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0001", head = "mak_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_000911", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「是这么回事吗?」"
                }
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯,单纯是因为以前我吃不上而已」"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"fg", ch = "圭", mode = 3, path = ":fg/kei/z1/", file = "kei_z1a0100", face = "a0002", head = "kei_z1a", x2 = 345, x = 570, lv = 4, id = 6},
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0001", head = "mak_z1a", x2 = -345, x = 0, lv = 4, id = 5},
        {"fg", ch = "稟", size = "z1", mx = -40, mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0001", head = "rin_z1a", x = -570, lv = 4, id = 3},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_000464", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「不过,和食其实挺难的吧。比如炖菜之类的?」"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「常听人说炖菜难,我却没什么切身体会。要我说,油炸的东西可比",
                    {"rt2"},
                    "它难多了」"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0016", head = "mak_z1a", x = 0, lv = 4, id = 5},
        {"fgact", ch = "真琴", act = "おじぎ", lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_000912", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「啊,我懂。穷的话,炸东西时舍不得豪爽地用油,结果就失败了嘛」"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「而且一个人住的话,油炸食品绝对是下馆子性价比更高。所以经验",
                    {"rt2"},
                    "值绝对不够」"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0002", head = "mak_z1a", x = 0, lv = 4, id = 5},
        {"fg", ch = "圭", size = "z1", mode = 3, path = ":fg/kei/z1/", file = "kei_z1a0100", face = "a0017", head = "kei_z1a", x = 570, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_ked_000879", ch = "ked"}
            },
            ja = {
                {
                    name = {"圭"},
                    "「可你不是也经常给我们做炸物嘛」"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那也是因为我自己想吃。一个人住时嫌费油,不太做得起。现在人",
                    {"rt2"},
                    "多了,炸物也可以随便做了」"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"fg", ch = "圭", size = "z1", mode = 3, path = ":fg/kei/z1/", file = "kei_z1a0100", face = "a0002", head = "kei_z1a", x = 570, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_ked_000880", ch = "ked"}
            },
            ja = {
                {
                    name = {"圭"},
                    "「原来如此。可我完全没看出来你不擅长,明明挺好吃的」"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「最近好用的炸粉多了嘛。像炸鸡块用的那种,炸出来嘎嘣脆。还有",
                    {"rt2"},
                    ",天妇罗的面衣用碳酸水代替清水,能蒙混过去不少,这也是我最近才",
                    {"rt2"},
                    "知道的」"
                }
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"fg", ch = "稟", size = "z1", mode = 3, path = ":fg/rin/z1/", file = "rin_z1a0100", face = "a0012", head = "rin_z1a", x = -570, lv = 4, id = 3},
