        linknext = "block_00094"
    },
    block_00094 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为肝脏便宜嘛。一直做蒜苗炒肝也会腻吧？　那就磨碎做成肉",
