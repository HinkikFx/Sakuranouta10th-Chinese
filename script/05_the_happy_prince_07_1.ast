        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_frd_000278", ch = "frd"}
            },
            ja = {
                {
                    name = {"弗里曼"},
                    "「只是开个玩笑。那可是正儿八经的提名邀请函」"
