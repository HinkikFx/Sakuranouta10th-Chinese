            },
            ja = {
                {
                    name = {"蓝"},
                    "「比起这个,圭那家伙,也太慢了吧。我打了电话,可他完全没有要接",
                    {"rt2"},
                    "的意思」"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「要是正骑着摩托,引擎声那么吵,注意不到吧」"
                }
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0009", head = "aix_z1e", lv = 4, id = 9},
        {"fgact", ch = "藍", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001279", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「嗯,可就算这样,从今天早上他出门起我就一直在打了」"
                }
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是吗……,到底怎么了呢」"
                }
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", file = "bg077e", path = ":bg/", ax = 960, ay = 563, bx = 0, by = -23, sync = 0},
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0001", head = "aix_z1e", lv = 4, id = 9, sync = 0},
        {"extrans", time = 1000},
        {"text"},
        text = {
            ja = {
                {"会场暗了下来。"}
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「快开始了。我们该入座了」"
                }
            }
        },
        linkback = "block_00212",
        linknext = "block_00214"
    },
    block_00214 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0002", head = "aix_z1e", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001280", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「是啊」"
                }
            }
        },
        linkback = "block_00213",
        linknext = "block_00215"
    },
    block_00215 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我坐前排。你们去宾客席坐吧」"
                }
            }
        },
        linkback = "block_00214",
        linknext = "block_00216"
    },
    block_00216 = {
        {"fg", ch = "藍", size = "z1", mode = 3, path = ":fg/aix/z1/", file = "aix_z1e0000", face = "e0003", head = "aix_z1e", lv = 4, id = 9},
        {"fgact", ch = "藍", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001281", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「啊,知道了」"
                }
            }
        },
        linkback = "block_00215",
        linknext = "block_00217"
    },
    block_00217 = {
        {"fg", mode = -2},
        {"text"},
        text = {
            ja = {
                {"我在最前排坐下。"}
            }
        },
        linkback = "block_00216",
        linknext = "block_00218"
    },
    block_00218 = {
        {"text"},
        text = {
            ja = {
                {"是一个能马上进入后台的位置。"}
            }
        },
        linkback = "block_00217",
        linknext = "block_00219"
    },
    block_00219 = {
        {"text"},
        text = {
            ja = {
                {"我们刚落座,广播就响了起来。"}
            }
        },
        linkback = "block_00218",
        linknext = "block_00220"
    },
    block_00220 = {
        {"text"},
        text = {
            ja = {
                {"宣布颁奖典礼即将开始。"}
            }
        },
        linkback = "block_00219",
        linknext = "block_00221"
    },
    block_00221 = {
        {"text"},
        text = {
            ja = {
                {"接着,又宣布今年有日本人获奖。"}
            }
        },
        linkback = "block_00220",
        linknext = "block_00222"
    },
    block_00222 = {
        {"text"},
        text = {
            ja = {
                {"全场顿时热闹起来。"}
            }
        },
        linkback = "block_00221",
        linknext = "block_00223"
    },
    block_00223 = {
        {"text"},
        text = {
            ja = {
                {"当广播进一步宣布有两位获奖者时,场内响起了一片骚动。"}
            }
        },
        linkback = "block_00222",
        linknext = "block_00224"
    },
    block_00224 = {
        {"text"},
        text = {
            ja = {
                {"但是,最前排的那些人却纹丝不动,只是注视着舞台。"}
            }
        },
        linkback = "block_00223",
        linknext = "block_00225"
    },
    block_00225 = {
        {"text"},
        text = {
            ja = {
                {"嘛,这也是理所当然的吧……。"}
            }
        },
        linkback = "block_00224",
        linknext = "block_00226"
    },
    block_00226 = {
        {"text"},
        text = {
            ja = {
                {"获得提名的人一字排开,那一排尽是些赫赫有名的面孔。"}
            }
        },
        linkback = "block_00225",
        linknext = "block_00227"
    },
    block_00227 = {
        {"text"},
        text = {
            ja = {
                {"坐在最里面的,是现代波普艺术的旗手,村田清彦……。"}
            }
        },
        linkback = "block_00226",
        linknext = "block_00228"
    },
    block_00228 = {
        {"text"},
        text = {
            ja = {
                {
                    "他的作品被纽约现代艺术博物馆和洛杉矶当代艺术博物馆收藏展出,",
                    {"rt2"},
                    "去年获得艺术选奖文部科学大臣奖还上了新闻。"
                }
            }
        },
        linkback = "block_00227",
        linknext = "block_00229"
    },
    block_00229 = {
        {"text"},
        text = {
            ja = {
                {"无论履历还是实力,都是我根本无法相提并论的真材实料。"}
            }
        },
        linkback = "block_00228",
        linknext = "block_00230"
    },
    block_00230 = {
        {"text"},
        text = {
            ja = {
                {
                    "坐在他旁边的,是坂本彰三。他也以海外活动为主,曾被法国艺术杂",
                    {"rt2"},
                    "志《埃克利》评选为世界最具影响力100人-2001年度版。"
                }
            }
        },
        linkback = "block_00229",
        linknext = "block_00231"
    },
    block_00231 = {
        {"text"},
        text = {
            ja = {
                {"在国内没有那么知名,但在海外艺术圈是响当当的名字。"}
            }
        },
        linkback = "block_00230",
        linknext = "block_00232"
    },
    block_00232 = {
        {"text"},
        text = {
            ja = {
                {"这两位的实力,已经到了至今没在穆亚获过奖反倒显得奇怪的地步。"}
            }
        },
        linkback = "block_00231",
        linknext = "block_00233"
    },
    block_00233 = {
        {"text"},
        text = {
            ja = {
                {
                    "此外还有日本画的坂道无道。他擅长的不是现代艺术之类,而是被称",
                    {"rt2"},
                    "为正统的日本画,最近也在海外举办个展。"
                }
            }
        },
        linkback = "block_00232",
        linknext = "block_00234"
    },
    block_00234 = {
        {"text"},
        text = {
            ja = {
                {
                    "最后,还能看到波普艺术家日高次郎的身影,他的绘画被称为是以独",
                    {"rt2"},
                    "特视角讲述艺术的作品。"
                }
            }
        },
        linkback = "block_00233",
        linknext = "block_00235"
    },
    block_00235 = {
        {"text"},
        text = {
            ja = {
                {
                    "他的波普艺术极具理论性和思想性。现在应该正在加州大学洛杉矶",
                    {"rt2"},
                    "分校担任客座教授。"
                }
            }
        },
        linkback = "block_00234",
        linknext = "block_00236"
    },
    block_00236 = {
        {"text"},
        text = {
            ja = {
                {"而他旁边就是我,草薙直哉。"}
            }
        },
        linkback = "block_00235",
        linknext = "block_00237"
    },
    block_00237 = {
        {"text"},
        text = {
            ja = {
                {"被这些成就等身的人围在中间,多少有些局促。"}
            }
        },
        linkback = "block_00236",
        linknext = "block_00238"
    },
    block_00238 = {
        {"text"},
        text = {
            ja = {
                {
                    "而且从年龄上看,连最年轻的坂本彰三都已经三十出头……其他人都",
                    {"rt2"},
                    "在四十到将近五十岁。十几岁的我坐在这里面,说实话很是尴尬……。"
                }
            }
        },
        linkback = "block_00237",
        linknext = "block_00239"
    },
    block_00239 = {
        {"text"},
        text = {
            ja = {
                {"坐到这里,才再一次觉得难以置信,自己居然一路走到了这一步。"}
            }
        },
        linkback = "block_00238",
        linknext = "block_00240"
    },
    block_00240 = {
        {"text"},
        text = {
            ja = {
                {"然后,最边上,只剩最后一个空位。"}
            }
        },
        linkback = "block_00239",
        linknext = "block_00241"
    },
    block_00241 = {
        {"text"},
        text = {
            ja = {
                {"那里还空着。"}
            }
        },
        linkback = "block_00240",
        linknext = "block_00242"
    },
    block_00242 = {
        {"text"},
        text = {
            ja = {
                {"是夏目圭应该坐的位置。"}
            }
        },
        linkback = "block_00241",
        linknext = "block_00243"
    },
    block_00243 = {
        {"text"},
        text = {
            ja = {
                {"话说回来……"}
            }
        },
        linkback = "block_00242",
        linknext = "block_00244"
    },
    block_00244 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那家伙……到底在干什么啊」"
                }
            }
        },
        linkback = "block_00243",
        linknext = "block_00245"
    },
    block_00245 = {
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", file = "bg077a", path = ":bg/", ax = 960, ay = 563, bx = 0, by = -23, sync = 0},
        {"extrans", time = 1000},
        {"text"},
        text = {
            ja = {
                {"会场亮了起来。"}
            }
        },
        linkback = "block_00244",
        linknext = "block_00246"
    },
    block_00246 = {
        {"text"},
        text = {
            ja = {
                {"一位在电视上见过的女性正在台上宣布,典礼由她主持。"}
            }
        },
        linkback = "block_00245",
        linknext = "block_00247"
    },
    block_00247 = {
        {"text"},
        text = {
            ja = {
                {"看到这一幕后,现代波普艺术的旗手村田清彦从座位上站了起来。"}
            }
        },
        linkback = "block_00246",
        linknext = "block_00248"
    },
    block_00248 = {
        {"text"},
        text = {
            ja = {
                {"随后,坂本彰三也跟着起身走了出去。"}
            }
        },
        linkback = "block_00247",
        linknext = "block_00249"
    },
    block_00249 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「获奖者是那两位吗?」"
                }
            }
        },
        linkback = "block_00248",
        linknext = "block_00250"
    },
    block_00250 = {
        {"text"},
        text = {
            ja = {
                {"是去后台了吗?"}
            }
        },
        linkback = "block_00249",
        linknext = "block_00251"
    },
    block_00251 = {
        {"text"},
        text = {
            ja = {
                {"我看了看表。"}
            }
        },
        linkback = "block_00250",
        linknext = "block_00252"
    },
    block_00252 = {
        {"text"},
        text = {
            ja = {
                {"离公布获奖者还有时间,于是我跟了上去。"}
            }
        },
        linkback = "block_00251",
        linknext = "block_00253"
    },
    block_00253 = {
        {"bg", file = "ev_com_i06_01", path = ":ev/ev_com_i06/", set = "ev_com_i06"},
        {"text"},
        text = {
            ja = {
                {"那里,只不过是间吸烟室。"}
            }
        },
        linkback = "block_00252",
        linknext = "block_00254"
    },
    block_00254 = {
        {"text"},
        text = {
            ja = {
                {"村田清彦和坂本彰三似乎本就相识,正一脸享受地吞吐着烟雾。"}
            }
        },
        linkback = "block_00253",
        linknext = "block_00255"
    },
    block_00255 = {
        {"bg", file = "ev_com_i06_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i06/", set = "ev_com_i06"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000001", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「哦?　怎么了?　小子」"
                }
            }
        },
        linkback = "block_00254",
        linknext = "block_00256"
    },
    block_00256 = {
        {"text"},
        text = {
            ja = {
                {"看来,跟过来这件事被发现了。"}
            }
        },
        linkback = "block_00255",
        linknext = "block_00257"
    },
    block_00257 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,不……也没什么理由……」"
                }
            }
        },
        linkback = "block_00256",
        linknext = "block_00258"
    },
    block_00258 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000001", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「看我们先离席,就以为我们去后台了?以为是我们俩同时获奖!　之",
                    {"rt2"},
                    "类的」"
                }
            }
        },
        linkback = "block_00257",
        linknext = "block_00259"
    },
    block_00259 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「两位知道自己有没有获奖吗?」"
                }
            }
        },
        linkback = "block_00258",
        linknext = "block_00260"
    },
    block_00260 = {
        {"bg", file = "ev_com_i06_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i06/", set = "ev_com_i06"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000002", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「多少知道一点」"
                }
            }
        },
        linkback = "block_00259",
        linknext = "block_00261"
    },
    block_00261 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000003", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「这次,好像是村田获奖」"
                }
            }
        },
        linkback = "block_00260",
        linknext = "block_00262"
    },
    block_00262 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000002", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「还没正式公布,别乱说」"
                }
            }
        },
        linkback = "block_00261",
        linknext = "block_00263"
    },
    block_00263 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是这样吗?　请问您获得的是哪个奖?」"
                }
            }
        },
        linkback = "block_00262",
        linknext = "block_00264"
    },
    block_00264 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000003", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「据说埃朗·福克的呼声最高。那个奖还没有日本人拿过,要是获奖了",
                    {"rt2"},
                    ",应该会相当引人注目吧」"
                }
            }
        },
        linkback = "block_00263",
        linknext = "block_00265"
    },
    block_00265 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是啊。如果是村田清彦先生,拿埃朗·福克也不足为奇」"
                }
            }
        },
        linkback = "block_00264",
        linknext = "block_00266"
    },
    block_00266 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000004", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「是吗?　被你这么一说,心情还挺微妙的」"
                }
            }
        },
        linkback = "block_00265",
        linknext = "block_00267"
    },
    block_00267 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「为什么?」"
                }
            }
        },
        linkback = "block_00266",
        linknext = "block_00268"
    },
    block_00268 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000005", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「其实我考虑过辞退埃朗·福克」"
                }
            }
        },
        linkback = "block_00267",
        linknext = "block_00269"
    },
    block_00269 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「辞退?」"
                }
            }
        },
        linkback = "block_00268",
        linknext = "block_00270"
    },
    block_00270 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000006", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「毕竟,谁都想要比它更高的奖项吧」"
                }
            }
        },
        linkback = "block_00269",
        linknext = "block_00271"
    },
    block_00271 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000004", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「伦敦系的阿尔让·多凡,还有纽约系的铂金艾波拉尔。这两个奖国内",
                    {"rt2"},
                    "都各出过一位获奖者」"
                }
            }
        },
        linkback = "block_00270",
        linknext = "block_00272"
    },
    block_00272 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000005", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「但是,被称为巴黎系的奥尔·巴雷努,国内还没有人拿过。所以想第",
                    {"rt2"},
                    "一个摘下那个奖,是再正常不过的憧憬吧」"
                }
            }
        },
        linkback = "block_00271",
        linknext = "block_00273"
    },
    block_00273 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000007", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「巴黎系的奥尔·巴雷努政治色彩最弱,也被称为最纯粹的奖项啊」"
                }
            }
        },
        linkback = "block_00272",
        linknext = "block_00274"
    },
    block_00274 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「政治色彩?」"
                }
            }
        },
        linkback = "block_00273",
        linknext = "block_00275"
    },
    block_00275 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000006", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「就是说组织的意图掺杂得比较少。铂金艾波拉尔和阿尔让·多凡背",
                    {"rt2"},
                    "后流动着巨额资金,自然也涌动着巨大的利益盘算。这就是它们被称",
                    {"rt2"},
                    "为政治性奖项的缘由」"
                }
            }
        },
        linkback = "block_00274",
        linknext = "block_00276"
    },
    block_00276 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000008", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「从这个意义上讲,铂金艾波拉尔给了草薙健一郎、阿尔让·多凡给了",
                    {"rt2"},
                    "宫崎破戒,也有让人信服的部分……」"
                }
            }
        },
        linkback = "block_00275",
        linknext = "block_00277"
    },
    block_00277 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000009", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「草薙原本就与穆亚财团关系密切。宫崎虽然生在日本,实际上从幼",
                    {"rt2"},
                    "年起就生活在英国,一直活跃于伦敦画坛」"
                }
            }
        },
        linkback = "block_00276",
        linknext = "block_00278"
    },
    block_00278 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000007", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「也可以看作,他们分别是各自城市的御用艺术家」"
                }
            }
        },
        linkback = "block_00277",
        linknext = "block_00279"
    },
    block_00279 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000010", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「话虽如此,那两位是超乎常规的天才,这一点毋庸置疑」"
                }
            }
        },
        linkback = "block_00278",
        linknext = "block_00280"
    },
    block_00280 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000008", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「村田你在海外设工作室也有十几年了吧?」"
                }
            }
        },
        linkback = "block_00279",
        linknext = "block_00281"
    },
    block_00281 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000011", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「啊,我原以为自己在海外也算积累了不少资历,结果却止步于埃朗·",
                    {"rt2"},
                    "福克啊」"
                }
            }
        },
        linkback = "block_00280",
        linknext = "block_00282"
    },
    block_00282 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000009", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「说什么胡话呢。能在穆亚公募展拿奖就已经是壮举了。60年的历",
                    {"rt2"},
                    "史里总共也只有六位获奖者」"
                }
            }
        },
        linkback = "block_00281",
        linknext = "block_00283"
    },
    block_00283 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000012", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「创立后的54年间,日本人获奖数为零。最近总算出了获奖者,但说",
                    {"rt2"},
                    "白了,这只能证明日本艺术界一直以来有多么闭塞」"
                }
            }
        },
        linkback = "block_00282",
        linknext = "block_00284"
    },
    block_00284 = {
        {"text"},
        text = {
            ja = {
                {"嘛,确实是这么回事……。"}
            }
        },
        linkback = "block_00283",
        linknext = "block_00285"
    },
    block_00285 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000013", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「对了,你是草薙直哉君吧」"
                }
            }
        },
        linkback = "block_00284",
        linknext = "block_00286"
    },
    block_00286 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,是的……」"
                }
            }
        },
        linkback = "block_00285",
        linknext = "block_00287"
    },
    block_00287 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000010", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「啊,我还纳闷怎么有个小鬼在这,原来是草薙健一郎二世啊,你小子,",
                    {"rt2"},
                    "也算是小有名气了」"
                }
            }
        },
        linkback = "block_00286",
        linknext = "block_00288"
    },
    block_00288 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000011", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「你年少时画的『樱日狂想』我也看过。是幅好画。当时就觉得那",
                    {"rt2"},
                    "不像是小鬼能画出来的东西」"
                }
            }
        },
        linkback = "block_00287",
        linknext = "block_00289"
    },
    block_00289 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「谢谢夸奖」"
                }
            }
        },
        linkback = "block_00288",
        linknext = "block_00290"
    },
    block_00290 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000012", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「话虽如此,倒也没觉得是能入围穆亚提名的作品……」"
                }
            }
        },
        linkback = "block_00289",
        linknext = "block_00291"
    },
    block_00291 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000014", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「那都是多少年前的事了,说明他现在能画出更好的画了吧。既然和",
                    {"rt2"},
                    "我们众人获得提名,画的水准必然与之相称」"
                }
            }
        },
        linkback = "block_00290",
        linknext = "block_00292"
    },
    block_00292 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000013", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「啊,对哦,对我们来说不过是不久前的事,可对这个年纪来说,两三年",
                    {"rt2"},
                    "很漫长啊」"
                }
            }
        },
        linkback = "block_00291",
        linknext = "block_00293"
    },
    block_00293 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000015", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「不,那大概是六年前了哦」"
                }
            }
        },
        linkback = "block_00292",
        linknext = "block_00294"
    },
    block_00294 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000014", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「诶?　真的假的?　有那么久了吗?」"
                }
            }
        },
        linkback = "block_00293",
        linknext = "block_00295"
    },
    block_00295 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000015", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「这样啊。那画风肯定已经完全不同了」"
                }
            }
        },
        linkback = "block_00294",
        linknext = "block_00296"
    },
    block_00296 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000016", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「不愧对穆亚提名……你的画,已经到那个境界了吗?」"
                }
            }
        },
        linkback = "block_00295",
        linknext = "block_00297"
    },
    block_00297 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我是以此为目标画的……」"
                }
            }
        },
        linkback = "block_00296",
        linknext = "block_00298"
    },
    block_00298 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000016", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「呜哇,这么年轻就说这种话……。心情真是微妙。我这边好歹也积",
                    {"rt2"},
                    "累了十几年的资历啊」"
                }
            }
        },
        linkback = "block_00297",
        linknext = "block_00299"
    },
    block_00299 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000017", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「想必他的画,拥有与那份资历同等的价值吧」"
                }
            }
        },
        linkback = "block_00298",
        linknext = "block_00300"
    },
    block_00300 = {
        {"bg", file = "ev_com_i06_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i06/", set = "ev_com_i06"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000017", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「唉……那可太吓人了。嘛,听说你从小就接受了相当高强度的精英",
                    {"rt2"},
                    "教育」"
                }
            }
        },
        linkback = "block_00299",
        linknext = "block_00301"
    },
    block_00301 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000018", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「在国内是『樱日狂想』有名,不过在纽约和草薙健一郎办的父子联",
                    {"rt2"},
                    "展,在那边可是上了新闻。据说还有位主妇花80万日元买下了你的",
                    {"rt2"},
                    "画……」"
                }
            }
        },
        linkback = "block_00300",
        linknext = "block_00302"
    },
    block_00302 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000018", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「听说是那个年龄段的最高成交价啊。真正的神童啊」"
                }
            }
        },
        linkback = "block_00301",
        linknext = "block_00303"
    },
    block_00303 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,那是老爸的个展,只是我的画碰巧跟着水涨船高罢了……」"
                }
            }
        },
        linkback = "block_00302",
        linknext = "block_00304"
    },
    block_00304 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000019", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「但愿如此啊」"
                }
            }
        },
        linkback = "block_00303",
        linknext = "block_00305"
    },
    block_00305 = {
        {"bg", file = "ev_com_i06_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i06/", set = "ev_com_i06"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000019", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「要是被小鬼抢了奖,我可要哭了」"
                }
            }
        },
        linkback = "block_00304",
        linknext = "block_00306"
    },
    block_00306 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000020", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「你随便哭去。嘛,同行可没人会安慰你」"
                }
            }
        },
        linkback = "block_00305",
        linknext = "block_00307"
    },
    block_00307 = {
        {"bg", file = "ev_com_i06_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i06/", set = "ev_com_i06"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000020", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「真冷酷啊。可恶,不就是内定了奖项吗」"
                }
            }
        },
        linkback = "block_00306",
        linknext = "block_00308"
    },
    block_00308 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000021", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「说起来,这次听说国内有两人获奖,另一位获奖者拿的据说是埃朗·",
                    {"rt2"},
                    "奥塔利」"
                }
            }
        },
        linkback = "block_00307",
        linknext = "block_00309"
    },
    block_00309 = {
        {"bg", file = "ev_com_i06_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i06/", set = "ev_com_i06"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000021", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「那可是号称铜奖级别里最高的奖啊。是谁获奖了?」"
                }
            }
        },
        linkback = "block_00308",
        linknext = "block_00310"
    },
    block_00310 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000022", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「关于这一点,消息一点都没有泄露出来」"
                }
            }
        },
        linkback = "block_00309",
        linknext = "block_00311"
    },
    block_00311 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000022", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「啊,为什么呢。照理说到了这个节骨眼,消息总会透给业内的相关",
                    {"rt2"},
                    "人士……」"
                }
            }
        },
        linkback = "block_00310",
        linknext = "block_00312"
    },
    block_00312 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000023", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「又或者,是到现在还没定下来吧」"
                }
            }
        },
        linkback = "block_00311",
        linknext = "block_00313"
    },
    block_00313 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000023", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「都这个时候了,不至于吧。啊——,不管怎样,要是我就好喽」"
                }
            }
        },
        linkback = "block_00312",
        linknext = "block_00314"
    },
    block_00314 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「如果是坂本彰三,可能性应该很高吧」"
                }
            }
        },
        linkback = "block_00313",
        linknext = "block_00315"
    },
    block_00315 = {
        {"bg", file = "ev_com_i06_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i06/", set = "ev_com_i06"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000024", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「可我这边,压根没接到联络啊……」"
                }
            }
        },
        linkback = "block_00314",
        linknext = "block_00316"
    },
    block_00316 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000024", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「比起这个,差不多该回去了。到了我们的作品登台展示的时间了」"
                }
            }
        },
        linkback = "block_00315",
        linknext = "block_00317"
    },
    block_00317 = {
        {"bg", file = "ev_com_i06_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i06/", set = "ev_com_i06"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000025", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「啊,是啊。说不定都快结束了」"
                }
            }
        },
        linkback = "block_00316",
        linknext = "block_00318"
    },
    block_00318 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「快结束了?」"
                }
            }
        },
        linkback = "block_00317",
        linknext = "block_00319"
    },
    block_00319 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000026", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「啊,我们这边的话题。比起这个,作品展览什么的根本没必要,直接",
                    {"rt2"},
                    "办颁奖式就好了嘛」"
                }
            }
        },
        linkback = "block_00318",
        linknext = "block_00320"
    },
    block_00320 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000025", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「嘛,别这么说。毕竟是时隔三年的获奖庆典,总得享受一下」"
                }
            }
        },
        linkback = "block_00319",
        linknext = "block_00321"
    },
    block_00321 = {
        {"bg", file = "ev_com_i06_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i06/", set = "ev_com_i06"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000027", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「你是获奖板上钉钉了嘛——。当然享受得起来喽——。像我,说实话",
                    {"rt2"},
                    "都开始觉得不来才好」"
                }
            }
        },
        linkback = "block_00320",
        linknext = "block_00322"
    },
    block_00322 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000026", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「为什么?」"
                }
            }
        },
        linkback = "block_00321",
        linknext = "block_00323"
    },
    block_00323 = {
        {"bg", file = "ev_com_i06_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i06/", set = "ev_com_i06"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000028", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「没拿到奖的话,打击会很大吧」"
                }
            }
        },
        linkback = "block_00322",
        linknext = "block_00324"
    },
    block_00324 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000029", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「尤其是啊。这不有草薙二世参赛嘛。要是被这种毛头小子抢了奖,",
                    {"rt2"},
                    "我可怎么办才好」"
                }
            }
        },
        linkback = "block_00323",
        linknext = "block_00325"
    },
    block_00325 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000027", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「那也是实力」"
                }
            }
        },
        linkback = "block_00324",
        linknext = "block_00326"
    },
    block_00326 = {
        {"bg", file = "ev_com_i06_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i06/", set = "ev_com_i06"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000030", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「郁闷啊」"
                }
            }
        },
        linkback = "block_00325",
        linknext = "block_00327"
    },
    block_00327 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000031", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「啊,还有啊。结束后的庆功宴。酒店的立食派对根本不好吃」"
                }
            }
        },
        linkback = "block_00326",
        linknext = "block_00328"
    },
    block_00328 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000028", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「已经进入庆功宴状态了吗……。嘛,立食派对不管什么时候吃,在我",
                    {"rt2"},
                    "看来都跟施粥赈灾似的,实在让人无所适从」"
                }
            }
        },
        linkback = "block_00327",
        linknext = "block_00329"
    },
    block_00329 = {
        {"bg", file = "ev_com_i06_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i06/", set = "ev_com_i06"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000032", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「可不是嘛。嘛,搞艺术的在那种场合本来就不怎么吃东西,是不是",
                    {"rt2"},
                    "被人小瞧了?　我们的舌头什么的」"
                }
            }
        },
        linkback = "block_00328",
        linknext = "block_00330"
    },
    block_00330 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000029", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「你想太多了吧……」"
                }
            }
        },
        linkback = "block_00329",
        linknext = "block_00331"
    },
    block_00331 = {
        {"bg", file = "ev_com_i06_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i06/", set = "ev_com_i06"},
        {"text"},
        text = {
            ja = {
                {"他们把香烟摁灭在烟灰缸里。"}
            }
        },
        linkback = "block_00330",
        linknext = "block_00332"
    },
    block_00332 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000030", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「好了,去确认一下,埃朗·奥塔利花落谁家吧」"
                }
            }
        },
        linkback = "block_00331",
        linknext = "block_00333"
    },
    block_00333 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000033", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「是啊。作品的展示应该也已经开始了」"
                }
            }
        },
        linkback = "block_00332",
        linknext = "block_00334"
    },
    block_00334 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000031", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「那么,走吧……」"
                }
            }
        },
        linkback = "block_00333",
        linknext = "block_00335"
    },
    block_00335 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000032", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「啊,对了。有句话要对草薙直哉君说」"
                }
            }
        },
        linkback = "block_00334",
        linknext = "block_00336"
    },
    block_00336 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么话?」"
                }
            }
        },
        linkback = "block_00335",
        linknext = "block_00337"
    },
    block_00337 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000033", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「在纽约时,健一郎先生关照过我。他是位了不起的艺术家」"
                }
            }
        },
        linkback = "block_00336",
        linknext = "block_00338"
    },
    block_00338 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000034", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「他的死,对日本画坛而言是巨大的损失吧」"
                }
            }
        },
        linkback = "block_00337",
        linknext = "block_00339"
    },
    block_00339 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000034", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「除非有新的明星出现,那就另当别论了」"
                }
            }
        },
        linkback = "block_00338",
        linknext = "block_00340"
    },
    block_00340 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000035", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「如今活跃的艺术家里,没有能超越草薙健一郎和宫崎破戒的人吧。",
                    {"rt2"},
                    "那两位带来的冲击太不同凡响了」"
                }
            }
        },
        linkback = "block_00339",
        linknext = "block_00341"
    },
    block_00341 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000035", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「嘛,被这么一说,我们也无从反驳」"
                }
            }
        },
        linkback = "block_00340",
        linknext = "block_00342"
    },
    block_00342 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000036", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「从这个意义上讲,今后,或许就要由你这样的新艺术家,来引领日本",
                    {"rt2"},
                    "画坛了」"
                }
            }
        },
        linkback = "block_00341",
        linknext = "block_00343"
    },
    block_00343 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,我不行的」"
                }
            }
        },
        linkback = "block_00342",
        linknext = "block_00344"
    },
    block_00344 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000037", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「那可未必……」"
                }
            }
        },
        linkback = "block_00343",
        linknext = "block_00345"
    },
    block_00345 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000038", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「穆亚公募展是极具投机性和政治性的。不能否定他们寻求新世代",
                    {"rt2"},
                    "的可能性」"
                }
            }
        },
        linkback = "block_00344",
        linknext = "block_00346"
    },
    block_00346 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不会吧,就算如此,我的资历也太浅了」"
                }
            }
        },
        linkback = "block_00345",
        linknext = "block_00347"
    },
    block_00347 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000039", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「但愿如此啊。为了不让我们这一代被你们赶尽杀绝,我会努力的」"
                }
            }
        },
        linkback = "block_00346",
        linknext = "block_00348"
    },
    block_00348 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「太夸张了……」"
                }
            }
        },
        linkback = "block_00347",
        linknext = "block_00349"
    },
    block_00349 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000040", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「是吗。但愿是我夸张了……」"
                }
            }
        },
        linkback = "block_00348",
        linknext = "block_00350"
    },
    block_00350 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_skm_000036", ch = "skm"}
            },
            ja = {
                {
                    name = {"坂本"},
                    "「差不多该回去了」"
                }
            }
        },
        linkback = "block_00349",
        linknext = "block_00351"
    },
    block_00351 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mrt_000041", ch = "mrt"}
            },
            ja = {
                {
                    name = {"村田"},
                    "「是啊」"
                }
            }
        },
        linkback = "block_00350",
        linknext = "block_00352"
    },
    block_00352 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我们走吧……」"
                }
            }
        },
        linkback = "block_00351",
        linknext = "block_00353"
    },
    block_00353 = {
        {"bgm", stop = 1, time = 1000},
