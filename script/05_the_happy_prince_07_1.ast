        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「为什么会有两封?」"
                }
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_frd_000277", ch = "frd"}
            },
            ja = {
                {
                    name = {"弗里曼"},
                    "「谁知道呢。也许是弄错了……要不然,就是评审们还迟迟拿不定主",
                    {"rt2"},
                    "意吧……」"
                }
            }
