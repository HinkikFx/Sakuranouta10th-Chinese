        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「电视我更讨厌。首先我就不喜欢露脸,而且被乱剪辑一通,整个人",
