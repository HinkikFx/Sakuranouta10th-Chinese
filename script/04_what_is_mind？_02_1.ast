    block_00189 = {
        {"text"},
        text = {
            ja = {
                {"宫泽贤治的诗集。"}
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            ja = {
                {
                    "那一系列被称作心象素描的诗，为一切解释留下了余地，依读法不",
                    {"rt2"},
                    "同，也会显得极为艰深。"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000097", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「宫泽贤治的『春与修罗』吗……、他自称为心象素描的文体，宛",
                    {"rt2"},
                    "如绘画的画笔一般，用文字描摹下心象风景」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"bg", file = "ev_com_g02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g02/", set = "ev_com_g02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000022", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「绘画的画笔吗……」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000098", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「毕竟都叫素描了嘛，不过，要说是",
                    {"txruby", text = "sketch"},
                    "素描",
                    {"txruby"},
                    "，完成度又未免太高。宫",
                    {"rt2"},
                    "泽贤治称之为心象素描的东西，我认为更接近印象派的那种……」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000023", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「印象派吗……」"
                }
