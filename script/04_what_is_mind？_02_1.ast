    block_00211 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000031", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「名为『我』的这一现象，是被假定的有机交流电灯的一盏青色照",
                    {"rt2"},
                    "明（一切透明幽灵的复合体）」"
                }
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000032", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「与风景和众人众人，匆匆忙忙地明灭着，又的的确确持续点亮的，",
                    {"rt2"},
                    "因果交流电灯的一盏青色照明（光明常在　那电灯却已失去）」"
                }
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000106", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「序诗吗……」"
                }
            }
        },
        linkback = "block_00212",
        linknext = "block_00214"
    },
    block_00214 = {
        {"bg", file = "ev_com_g02_08", path = ":ev/ev_com_g02/", set = "ev_com_g02"},
        {"text"},
        text = {
            ja = {
                {"水菜微微点头，就那样朗读起诗来。"}
            }
        },
        linkback = "block_00213",
        linknext = "block_00215"
    },
    block_00215 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000033", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「这些是从感知为二十二个月的　过去的方向　连缀起纸与矿质墨",
                    {"rt2"},
                    "水（一切与我众人明灭　众人同时感知之物）」"
                }
            }
        },
        linkback = "block_00214",
        linknext = "block_00216"
    },
    block_00216 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000034", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「是保存至今的　影与光的一串又一串　如其所是的心象素描」"
                }
            }
        },
        linkback = "block_00215",
        linknext = "block_00217"
    },
    block_00217 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000035", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「关于这些，人与银河与修罗与海胆　吞食着宇宙尘　或呼吸着空",
                    {"rt2"},
                    "气与盐水　各自思索新鲜的本体论也未可知　而那些也毕竟是心中",
                    {"rt2"},
                    "的一种风物」"
                }
            }
        },
        linkback = "block_00216",
        linknext = "block_00218"
    },
    block_00218 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000036", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「只是确凿记录下的这些景色　正是如记录那般的这幅景色」"
                }
            }
        },
        linkback = "block_00217",
        linknext = "block_00219"
    },
    block_00219 = {
        {"text"},
        text = {
            ja = {
                {"不知为何，读到那一段，水菜便不再往下读了。"}
            }
        },
        linkback = "block_00218",
        linknext = "block_00220"
    },
