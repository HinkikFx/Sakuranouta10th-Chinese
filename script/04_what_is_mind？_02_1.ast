        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000029", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「如果读过研究类书籍的话，在提到梵高的影响时，一般都会附带",
                    {"rt2"},
                    "提到",
                    {"txruby", text = "ツィプレッセン"},
                    "ZYPRESSEN",
                    {"txruby"},
                    "的读法……」"
                }
            }
