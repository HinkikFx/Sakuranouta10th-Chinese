        text = {
            vo = {
                {"vo", file = "fem_mzd_000032", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「与风景和大家众人，忙碌忙碌地明灭着，确确实实持续亮着的，",
                    {"rt2"},
                    "因果交流电灯的一点青色照明（光被保存　而那电灯已然失去）」"
                }
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
