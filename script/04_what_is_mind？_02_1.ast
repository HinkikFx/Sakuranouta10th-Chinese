        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"cgdel", id = -1},
        {"msgoff"},
        {"bg", file = "black", path = ":bg/", sync = 0},
        {"fg", ch = "紗希", size = "z1", mode = 3, path = ":fg/sak/z1/", file = "sak_z1a0000", face = "a0005", head = "sak_z1a", lv = 4, id = 9, sync = 0},
