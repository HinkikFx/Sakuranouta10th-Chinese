    },
    block_00209 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000030", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「是吗，懂的人，凭感觉，就能懂得这些啊……。好厉害」"
