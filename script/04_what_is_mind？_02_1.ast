    },
    block_00215 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000033", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「这些是从二十二个月中　被感知为过去的方向　以纸与矿质墨水",
                    {"rt2"},
                    "连缀而成（一切与我同时明灭　是大家同时感受到的东西）」"
                }
