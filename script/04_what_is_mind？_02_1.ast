        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            ja = {
                {
                    "读战前的书时，如今看来奇异的片假名外语确实屡见不鲜，这也是",
                    {"rt2"},
                    "那一类的东西吗？"
                }
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"bg", file = "ev_com_g02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g02/", set = "ev_com_g02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000028", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「这么说来，老师并非凭借书本上的知识，而是凭感觉，从『春与",
                    {"rt2"},
                    "修罗』中看出了梵高的影响呢」"
                }
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000104", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「凭刚才那些话，怎么就能知道这个」"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000029", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「因为只要读过研究类的书，凡是写到梵高影响的地方，大都会一",
                    {"rt2"},
                    "并提到",
                    {"txruby", text = "齐普雷森"},
                    "ZYPRESSEN",
                    {"txruby"},
                    "的读法……」"
                }
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000105", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「是这样吗……」"
                }
