        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"text"},
        text = {
            ja = {
                {
                    "走过维吉尔通道，在那尽头，纱希在神前说出誓言时，究竟是什么",
                    {"rt2"},
                    "样的心情？"
