        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000102", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「",
                    {"txruby", text = "ツィプレッセン"},
                    "ZYPRESSEN",
                    {"txruby"},
                    "？按德语发音的话，读作Züpressen或Tsupressen不是",
                    {"rt2"},
                    "更准确吗？」"
                }
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000027", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「确实是。不过据说宫泽贤治在《春与修罗》的草稿里，先用片假",
                    {"rt2"},
                    "名写了ツィプレッセン，然后又改写成了ZYPRESSEN」"
                }
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
