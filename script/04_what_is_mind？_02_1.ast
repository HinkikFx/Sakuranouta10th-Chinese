        text = {
            vo = {
                {"vo", file = "fem_mzd_000035", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「关于这些，人也好银河也好修罗也好",
                    {"txruby", text = "うに"},
                    "海胆",
                    {"txruby"},
                    "也好　一边食着宇宙尘",
                    {"rt2"},
                    "　或者呼吸着空气和盐水　各自思考着新鲜的本体论　但那些也",
                    {"txruby", text = "ひっきょう"},
                    "毕",
                    {"rt2"},
                    "竟",
                    {"txruby"},
                    "不过是心中的一幅风物」"
                }
            }
        },
        linkback = "block_00216",
        linknext = "block_00218"
    },
