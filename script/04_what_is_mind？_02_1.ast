            },
            ja = {
                {
                    name = {"水菜"},
                    "「只是确确实实被记录下来的这些景象　正是被记录的那样的这幅",
                    {"rt2"},
                    "景象」"
                }
            }
        },
        linkback = "block_00217",
        linknext = "block_00219"
    },
