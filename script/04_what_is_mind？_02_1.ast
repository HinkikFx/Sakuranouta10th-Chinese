        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            ja = {
                {
                    "那群被冠以「心象素描」之名的诗篇，拥有极其宽广的解读空间，",
                    {"rt2"},
                    "依读法不同可以变得非常晦涩难懂。"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000097", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「宫泽贤治的《春与修罗》吗……自称心象素描的笔法，宛如绘画",
                    {"rt2"},
                    "的笔触一般，用文字将心象风景描绘了出来」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"bg", file = "ev_com_g02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_g02/", set = "ev_com_g02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000022", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「绘画的笔触吗……」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000098", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「毕竟连名字都叫素描嘛，但作为",
                    {"txruby", text = "スケッチ"},
                    "素描",
                    {"txruby"},
                    "来说，完成度又高得过头了。",
                    {"rt2"},
                    "我觉得宫泽贤治所说的心象素描，跟印象派的理念十分相近……」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
