    block_00112 = {
        {"text"},
        text = {
            ja = {
                {"纱希好像当上了弓张学园的校长。"}
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            ja = {
                {"之所以说好像，是因为那时候，我又不在这个国家。"}
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            ja = {
                {"详细情形我不太清楚，据说她当上校长后，排除了中村家的资本。"}
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            ja = {
                {
                    "她几乎凭一己之力，将支配着弓张的中村家从弓张学园排除了出去。",
                    {"rt2"},
                    "那份手腕，绝非「能干」二字所能概括。"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        text = {
            ja = {
                {
                    "原属中村家所有的弓张学园，在纱希的奔走推动下，变成了多人持",
                    {"rt2"},
                    "股的体制。"
                }
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"text"},
        text = {
            ja = {
                {
                    "医院啦土木建筑商啦不动产啦，具体我也搞不懂，总之弓张的有钱",
                    {"rt2"},
                    "人们好像出了不少资。"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            ja = {
                {"她因那份铁腕，树敌众多，也招来了不少怨恨。"}
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"text"},
        text = {
            ja = {
                {"听说，她连和亲生孩子的关系都不和睦。"}
            }
        },
        linkback = "block_00118",
        linknext = "block_00120"
    },
    block_00120 = {
        {"text"},
        text = {
            ja = {
                {"只是，那种程度的大事，若不招来众多怨恨是办不成的。"}
            }
        },
        linkback = "block_00119",
        linknext = "block_00121"
    },
    block_00121 = {
        {"text"},
        text = {
            ja = {
                {"她为何做出那样的决断，为何非做不可。那份心情，我无从揣度。"}
            }
        },
        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"text"},
        text = {
            ja = {
                {"只是，与中村家为敌意味着什么，我可是痛彻骨髓地知道。"}
            }
        },
        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"text"},
        text = {
            ja = {
                {"而她孤身一人做到了。"}
            }
        },
        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            ja = {
                {"我说过很多次，当时详细的逸闻我几乎不知道。"}
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"text"},
        text = {
            ja = {
                {"只是，我也有心里有数的地方。"}
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"text"},
        text = {
            ja = {
                {"纱希大概到最后，也不会对我说起，"}
