        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            ja = {
                {
                    "具体细节我不太清楚，据说当上校长后，她把中村家的资本给排除",
                    {"rt2"},
                    "了。"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            ja = {
                {
                    "几乎凭一己之力，将一直支配弓张的中村家从弓张学园驱逐出去。",
                    {"rt2"},
                    "那手段之凌厉，绝非仅用「能干」二字就能概括的。"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        text = {
            ja = {
                {
                    "原本由中村家持有的弓张学园，在纱希的推动下变成了多人出资的",
                    {"rt2"},
                    "形式。"
