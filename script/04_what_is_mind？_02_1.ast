    },
    block_00201 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000102", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「",
                    {"txruby", text = "齐普雷森"},
                    "ZYPRESSEN",
                    {"txruby"},
                    "？　按德语发音，读作茨普雷松或者丘普雷森，不是",
                    {"rt2"},
                    "更准确吗？」"
                }
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mzd_000027", ch = "mzd"}
            },
            ja = {
                {
                    name = {"水菜"},
                    "「是呢。不过据说在宫泽贤治『春与修罗』的草稿里，是先用片假",
                    {"rt2"},
                    "名写下了齐普雷森，之后又改写成了ZYPRESSEN」"
                }
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000103", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「是这样吗……」"
                }
