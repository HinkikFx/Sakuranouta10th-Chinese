    },
    block_00015 = {
        {"fg", ch = "琴子", size = "z2", ex03 = "a0097", mode = 3, path = ":fg/ktk/z2/", file = "ktk_z2a0000", face = "a0002", head = "ktk_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ktk_000091", ch = "ktk"}
            },
            ja = {
                {
                    name = {"琴子"},
                    "「怎么啦？想妈妈了吗？」"
                }
            }
        },
        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_001037", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「不是。妈妈的事我完全不知道，所以谈不上想不想……」"
