        },
        linkback = "block_00000",
        linknext = "block_00002"
    },
    block_00002 = {
        {"text"},
        text = {
            ja = {
                {
                    "不，甚至不知道是否真的被遗弃了。也许母亲觉得让我待在夏目家",
