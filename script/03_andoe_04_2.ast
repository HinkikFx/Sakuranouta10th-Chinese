        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ktk_000092", ch = "ktk"}
            },
            ja = {
                {
                    name = {"琴子"},
                    "「那你为什么一个人在这里哭？」"
