                    "排的。"
                }
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"text"},
        text = {
            ja = {
                {"在这栋宅邸里和琴子奶奶一起度过了三年，但我记忆犹新。"}
            }
        },
        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"text"},
        text = {
            ja = {
                {"大概那时候的我还正常地拥有着心灵，是个普通的孩子。"}
