            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那是因为它已经不是词语,而是变成了语言。就像咲崎同学说的,",
                    {"rt2"},
                    "那不过是尸体罢了」"
                }
            }
        },
        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「去图书馆就好了,大量死去的词语被夹在书页之间。有时间的话去",
                    {"rt2"},
                    "美术馆也不错。那里同样悬挂着大量死去的绘画」"
                }
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000160", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「那意思是,过去的文学和艺术作品都是死物吗?」"
                }
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,没错。如果你觉得那是“厚重之物”,那它就已经是死掉的东西了」"
                }
            }
        },
        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那和语言是一样的」"
                }
            }
        },
        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"fgact", ch = "桜子", act = "おじぎ", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000161", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「这样啊……」"
                }
            }
        },
        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
        {"fg", mode = -2},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但是,所谓艺术,可以无数次地复活」"
                }
            }
        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「面对一只不过是标本的美丽蝴蝶时,你若是产生它仍然活着的错觉",
                    {"rt2"},
                    ",梦想到它振翅高飞的姿态,那么,它便不再是尸体」"
                }
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「标本被赋予了在人心中再次“飞翔”的权利。所以它才能魅惑人心。",
                    {"rt2"},
                    "艺术也是一样」"
                }
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「封存了瞬间的永远。嘛,虽说作品有寿命,称不上真正的永远……」"
                }
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「即便如此,只要那件作品存在,那个瞬间就被封存在永远之中」"
                }
            }
        },
        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「有时只有一个,有时则是更多的、应当传达的心意……。嘛,那要看",
                    {"rt2"},
                    "作品而定」"
                }
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不是越多越好,也不是唯其只有一个才显得出色」"
