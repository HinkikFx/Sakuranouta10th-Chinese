                {"fg", ch = "桜子", size = "z1", mode = 3, path = ":fg/sku/z1/", file = "sku_z1b0200", face = "b0010", head = "sku_z1b", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_skr_000154", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「对，",
                    {"txruby", text = "うた"},
                    "歌",
                    {"txruby"},
                    "。音乐里的歌词。不仅仅是追逐文字本身的含义。因为乘",
                    {"rt2"},
                    "上了旋律，所以变成了不同的意义」"
                }
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"fg", ch = "桜子", size = "z1", mode = 3, path = ":fg/sku/z1/", file = "sku_z1b0200", face = "b0002", head = "sku_z1b", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000155", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「通过旋律，",
                    {"txruby", text = "し"},
                    "诗",
                    {"txruby"},
                    "变成了",
                    {"txruby", text = "うた"},
                    "诗",
                    {"txruby"},
                    "」"
