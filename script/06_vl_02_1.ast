    block_00099 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000142", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「也许是刻意设计成那样的，但看起来创作者本人创作的时候非常",
