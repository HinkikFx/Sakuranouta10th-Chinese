        linkback = "block_00001",
        linknext = "block_00003"
    },
    block_00003 = {
        {"fgact", ch = "桜子", act = "おじぎ", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000097", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「早上好。倒也没什么事。只是想着,好想在屋顶呼吸一下早晨的空",
                    {"rt2"},
                    "气呀。仅此而已」"
                }
            }
        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「哦——。感觉你这人还挺清爽的嘛」"
                }
            }
