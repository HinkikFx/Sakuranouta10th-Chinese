    block_00100 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「创作者看起来很快乐……吗」"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"fg", ch = "桜子", size = "z2", mode = 3, path = ":fg/sku/z2/", file = "sku_z2a0210", face = "a0001", head = "sku_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000143", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「那种东西真的能从作品中传达出来吗？还是说本来就是按那种设",
                    {"rt2"},
                    "计做出来的呢？」"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，你说了一个很有趣的观点」"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「艺术为什么不使用语言呢……」"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000144", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「艺术不使用语言吗？」"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不是，当然，诗、文学之类的也会使用文字。只不过把那些称为'",
                    {"rt2"},
                    "语言'的话，总觉得少了点什么吧」"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"fg", ch = "桜子", size = "z2", mode = 3, path = ":fg/sku/z2/", file = "sku_z2a0210", face = "a0008", head = "sku_z2a", lv = 5, id = 9},
        {"fgact", ch = "桜子", act = "うなづく", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000145", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「嗯，我不太理解，不过被您这么一说，把诗和文学叫做语言确实",
                    {"rt2"},
                    "感觉哪里不对，用'言语'来形容更贴切」"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"fg", ch = "桜子", size = "z2", mode = 3, path = ":fg/sku/z2/", file = "sku_z2a0210", face = "a0010", head = "sku_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000146", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「为什么呢，被您这么一说，'语言'给人一种死去的言语的感觉……」"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就是这么回事」"
                }
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"fg", ch = "桜子", size = "z1", mode = 3, resize = 1, path = ":fg/sku/z1/", file = "sku_z1a0210", face = "a0007", head = "sku_z1a", lv = 4, id = 9},
        {"fgact", ch = "桜子", act = "びっくり", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000147", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「诶？怎么回事？刚才那是在解释吗？」"
                }
            }
        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，是解释。不是解说含义，而是指出含义所在」"
                }
            }
        },
        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"fg", ch = "桜子", size = "z1", mode = 3, path = ":fg/sku/z1/", file = "sku_z1a0210", face = "a0008", head = "sku_z1a", lv = 4, id = 9},
        {"fgact", ch = "桜子", act = "いいえ", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000148", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「完全不懂。什么意思？」"
                }
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「想象一下」"
                }
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你能听到创作者们快乐的声音。那些快乐的话语本身有意义吗？",
                    {"rt2"},
                    "不是的吧？」"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「比起言语的含义，那种快乐的声音的——音色——才更有价值不是",
                    {"rt2"},
                    "吗」"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你是不是被那幅作品中传来的声音，不是话语的含义，而是那种",
                    {"rt2"},
                    "欢快交谈的言语的音色——所吸引了呢？」"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
