        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那是因为已经不是言语、而是变成了语言。就像咲崎同学你说的，",
                    {"rt2"},
                    "那只不过是具尸体」"
