        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但是,想传达的,仅此一个,封存了瞬间的永远。这样的作品,也是有",
