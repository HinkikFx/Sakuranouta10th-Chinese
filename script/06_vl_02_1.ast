            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此，",
                    {"txruby", text = "し"},
                    "诗",
                    {"txruby"},
                    "变成",
                    {"txruby", text = "うた"},
                    "诗",
                    {"txruby"},
                    "吗……这本身就是一句很诗意的说法」"
