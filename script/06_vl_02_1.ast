        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「面包里最便宜的是法棍。麦茶也一样。就是这么个搭配」"
