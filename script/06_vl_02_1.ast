        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            ja = {
                {
                    "学生A是个非常活泼的学生。大概就是所谓的辣妹系？相比之下学",
                    {"rt2"},
                    "生C则是个安静的女生。"
