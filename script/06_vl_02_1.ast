        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            ja = {
                {"简单来说，就是显眼的学生和不显眼的学生。"}
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            ja = {
                {
                    "进一步细分的话，还有什么A等B等C等之类的，我真想问你们是牛",
