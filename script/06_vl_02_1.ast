        text = {
            vo = {
                {"vo", file = "fem_jta_000002", ch = "jta"}
            },
            ja = {
                {
                    name = {"学生A"},
                    "「叫人家学生Ａ也太过分了吧。您不记得我的名字吗?」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「吵死了,别让人替你画」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_jta_000003", ch = "jta"}
            },
            ja = {
                {
                    name = {"学生A"},
                    "「才没有让她替我画呢。只是让她教教我而已啦。啊,对哦,教人画",
                    {"rt2"},
                    "画,这个,是老师的工作吧?　所以我才挨骂了」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            ja = {
                {"一部分学生爆笑起来。"}
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,没有教师资格证的家伙来教学生,搞不好会在教育委员会闹出",
                    {"rt2"},
                    "问题呢」"
                }
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            ja = {
                {"学生们笑得更厉害了。"}
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            ja = {
                {"明明一点都不好笑。"}
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_jta_000004", ch = "jta"}
            },
            ja = {
                {
                    name = {"学生A"},
                    "「不行了,草薙老师的回嘴绝了。超好笑」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,因为我有教师资格证」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"text"},
        text = {
            ja = {
                {"爆笑。"}
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊?　我又不是为了逗你们开心才说的,不许爆笑,很不愉快」"
                }
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            ja = {
                {"即便如此,学生们还是在笑。"}
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            ja = {
                {
                    "为什么这些家伙,这么热衷于发笑呢。从中,总感觉有种违和感,又或",
                    {"rt2"},
                    "者说是一种遥远的感觉。"
                }
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「还有,你,不许总是替别人画课题!」"
                }
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"fg", ch = "奈津子", size = "z1", mode = 3, path = ":fg/nat/z1/", file = "nat_z1a0200", face = "a0009", head = "nat_z1a", lv = 4, id = 9},
        {"fgact", ch = "奈津子", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ntd_000002", ch = "ntd"}
            },
            ja = {
                {
                    name = {"奈津子", "学生C"},
                    "「对不起」"
                }
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「……」"
                }
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"fg", mode = -2},
        {"text"},
        text = {
            ja = {
                {"当了教师之后才看见的,教室这个世界,真是不可思议。"}
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            ja = {
                {
                    "也许是因为学生时代的我对他人太不感兴趣了……,但即便如此,或许",
                    {"rt2"},
                    "也有时代变迁的原因吧……。"
                }
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            ja = {
                {"骂学生Ａ会引起爆笑,骂学生Ｃ,却只会得到一句「对不起」。"}
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            ja = {
                {"基本上,在教室里被称作下层的学生们,不会辩解,总之先道歉再说。"}
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"text"},
        text = {
            ja = {
                {
                    "我倒觉得老老实实道歉才是对的,但在如今这世道,似乎连挨骂这种",
                    {"rt2"},
                    "仪式都得把气氛炒热才行……。"
                }
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"text"},
        text = {
            ja = {
                {
                    "教师们似乎也默许了这一点,实际上,就连对此心存不快的我,都落得",
                    {"rt2"},
                    "跟他们这样一唱一和。"
                }
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            ja = {
                {"嘛,确实,那些家伙很擅长营造现场的气氛。"}
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
    },
