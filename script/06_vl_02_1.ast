        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            ja = {
                {
                    "学生Ａ是个非常活泼的学生。就是所谓的辣妹系吧?相对地,学生Ｃ",
                    {"rt2"},
                    "则是个文静的少女。"
