        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「当你面对一只不过是标本的美丽蝴蝶时，如果你恍惚间觉得它还",
                    {"rt2"},
                    "活着，幻想它振翅飞翔的姿态——那它就不再是一具尸体了」"
                }
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「标本被赋予了在人心中再次'飞翔'的权利。所以它才会令人着迷。",
                    {"rt2"},
                    "艺术也是一样」"
                }
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
