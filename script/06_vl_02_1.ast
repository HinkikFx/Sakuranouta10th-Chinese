        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「去图书馆看看吧，大量死去的言语被夹在书本里。有时间的话去",
                    {"rt2"},
                    "美术馆也不错。那里也同样挂满了死去的画作」"
                }
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_skr_000160", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「这是说，以前的文学和艺术作品都是死去的东西吗？」"
                }
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，没错。如果你觉得那是'厚重的东西'，那它就已经死了」"
                }
            }
        },
        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「跟语言是一样的道理」"
                }
            }
        },
        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"fgact", ch = "桜子", act = "おじぎ", lv = 4, id = 9},
