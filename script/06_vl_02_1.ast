        },
        text = {
            vo = {
                {"vo", file = "fem_skr_000156", ch = "skr"}
            },
            ja = {
                {
                    name = {"樱子"},
                    "「我觉得快乐是因为感受到了旋律性的东西，所以是这么回事吧」"
