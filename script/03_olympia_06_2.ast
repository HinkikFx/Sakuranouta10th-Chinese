    },
    block_00183 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002827", ch = "rnd"}
            },
            ja = {
                {
                    "我总是推着轮椅,带着已经变得那么瘦小的母亲,巡游樱花盛开的地",
                    {"rt2"},
                    "方。"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002828", ch = "rnd"}
            },
            ja = {
                {
                    "因病而彻底消瘦下去的母亲,即便是年幼的我,也足以带她到外面去…",
                    {"rt2"},
                    "…。"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002829", ch = "rnd"}
            },
            ja = {
                {"妈妈已经不太能说话了,言语虽少,但我记得,她看上去非常开心。"}
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002830", ch = "rnd"}
            },
            ja = {
                {"因为,她喜欢樱花……。"}
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002831", ch = "rnd"}
            },
            ja = {
                {"除了四处赏樱之外,我们两个人也会一起去买东西。"}
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002832", ch = "rnd"}
            },
            ja = {
                {
                    "因为坐着轮椅,大多数店家都没什么好脸色,但其中也有对我们很和",
                    {"rt2"},
                    "善的店。"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002833", ch = "rnd"}
            },
            ja = {
                {"我推着无法动弹的母亲的轮椅,陪她一起走过那所剩无几的时光。"}
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002834", ch = "rnd"}
            },
            ja = {
                {"我想一直陪在她身边,直到最后一刻。"}
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002835", ch = "rnd"}
            },
            ja = {
                {"然而……。"}
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"bg", file = "black", path = ":bg/"},
        {"bg", file = "ev_uni_c41_01", path = ":ev/ev_uni_c41/", set = "ev_uni_c41"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mtt_000099", ch = "mtt"}
            },
            ja = {
                {
                    name = {"御樱父亲"},
                    "「不能再让你们在一起了」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002836", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「为什么!?　妈妈明明已经动不了了!」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mtt_000100", ch = "mtt"}
            },
            ja = {
                {
                    name = {"御樱父亲"},
                    "「不,不是那个问题。不能一直在一起。你会一点一点地垮掉的」"
                }
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002837", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「垮掉是什么意思?　那是我的妈妈啊?　不能和生病的妈妈在一起,",
                    {"rt2"},
                    "到底是什么意思?」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mtt_000101", ch = "mtt"}
            },
            ja = {
                {
                    name = {"御樱父亲"},
                    "「不,早就该下决心了……。这样继续下去,也是无济于事的……」"
                }
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002838", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「无济于事是什么意思?　为什么?　不要,不要把妈妈带走!」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_mtt_000102", ch = "mtt"}
            },
            ja = {
                {
                    name = {"御樱父亲"},
                    "「对不起。禀……」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"bg", file = "black", path = ":bg/"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002839", ch = "rnd"}
            },
            ja = {
                {"某一天,我和妈妈突然被拆散了。"}
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002840", ch = "rnd"}
            },
            ja = {
                {
                    "理由我不知道。因为,谁都没有告诉我……。只凭一句“不能在一起”",
                    {"rt2"},
                    "的独断之词,爸爸就从我身边夺走了母亲。"
                }
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002841", ch = "rnd"}
            },
            ja = {
                {"夺走了因病无法动弹的母亲……。从我的身边……。"}
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002842", ch = "rnd"}
            },
            ja = {
                {"在那之后,没过多久。我便被告知了母亲的死讯。"}
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002843", ch = "rnd"}
            },
            ja = {
                {"我知道母亲患着病。"}
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002844", ch = "rnd"}
            },
            ja = {
                {"也知道那是治不好的病……。"}
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002845", ch = "rnd"}
            },
            ja = {
                {"可是,我没有想到,和妈妈分开短短几天,她就去世了。"}
