                {"vo", file = "fem_yum_002150", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「所以，我们已经无法看到了……」"
                }
            }
        },
        linkback = "block_00262",
        linknext = "block_00264"
    },
    block_00264 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「第谷之星……还有这样的星吗？是多久以前的事？」"
                }
            }
        },
        linkback = "block_00263",
        linknext = "block_00265"
    },
    block_00265 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002151", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「在中世纪欧洲被发现的，所以已经是很久以前的事了」"
                }
            }
        },
        linkback = "block_00264",
        linknext = "block_00266"
    },
    block_00266 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002152", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「而且，只闪耀了短短两年」"
                }
            }
        },
        linkback = "block_00265",
        linknext = "block_00267"
    },
    block_00267 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002153", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「然而，仅仅在那两年里，它在天空中绽放出了连金星都望尘莫及",
                    {"rt2"},
                    "的光芒……」"
                }
            }
        },
        linkback = "block_00266",
        linknext = "block_00268"
    },
    block_00268 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002154", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「如同燃烧一般，闪耀着」"
                }
            }
        },
        linkback = "block_00267",
        linknext = "block_00269"
    },
    block_00269 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002198", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是这样啊」"
                }
            }
        },
        linkback = "block_00268",
        linknext = "block_00270"
    },
    block_00270 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002155", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我能理解宫泽贤治为什么会把夜鹰之星的意象与之重叠」"
                }
            }
        },
        linkback = "block_00269",
        linknext = "block_00271"
    },
    block_00271 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002156", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「焚身幻想啊……原来如此」"
                }
            }
        },
        linkback = "block_00270",
        linknext = "block_00272"
    },
    block_00272 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002157", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「宫泽贤治的焚身幻想，是奉献精神的极北……」"
                }
            }
        },
        linkback = "block_00271",
        linknext = "block_00273"
    },
    block_00273 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002158", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「闪耀的、罪孽深重的、奉献之星啊……」"
                }
            }
        },
        linkback = "block_00272",
        linknext = "block_00274"
    },
    block_00274 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002159", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「在那个时候……里奈你给我讲夜鹰的故事时，要是我也能说出这",
                    {"rt2"},
                    "样的话就好了……」"
                }
            }
        },
        linkback = "block_00273",
        linknext = "block_00275"
    },
    block_00275 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002199", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不不，现在听也觉得很新鲜哦。我完全不知道这些」"
                }
            }
        },
        linkback = "block_00274",
        linknext = "block_00276"
    },
    block_00276 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002160", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「是吗，这样看来加入天文部学习还是有意义的……」"
                }
            }
        },
        linkback = "block_00275",
        linknext = "block_00277"
    },
    block_00277 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002161", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我不像里奈那么聪明，不会聊文学的话题，想着至少能聊聊星星",
                    {"rt2"},
                    "就好了……」"
                }
            }
        },
        linkback = "block_00276",
        linknext = "block_00278"
    },
    block_00278 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来你是为此才加入天文部的啊……」"
                }
            }
        },
        linkback = "block_00277",
        linknext = "block_00279"
    },
    block_00279 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002162", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「不过我确实也喜欢星星」"
                }
            }
        },
        linkback = "block_00278",
        linknext = "block_00280"
    },
    block_00280 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002163", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「因为在这个公园和里奈一起仰望过的天空太美了……」"
                }
            }
        },
        linkback = "block_00279",
        linknext = "block_00281"
    },
    block_00281 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002164", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「星星很好。地面上如此喧嚣纷乱，而星空却井然有序、美丽地运",
                    {"rt2"},
                    "转着」"
                }
            }
