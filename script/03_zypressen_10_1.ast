    },
    block_00157 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此,这个照烧是照川内野喜欢的口味做的啊」"
                }
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"bg", file = "ev_com_d07_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d07/", set = "ev_com_d07"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002130", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「没错。所以说,要是有意见,我的玉子烧您不吃也罢」"
                }
            }
        },
        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「哪有什么意见。我母亲也是做玉子烧不放砂糖的人」"
                }
            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"bg", file = "ev_com_d07_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_d07/", set = "ev_com_d07"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002131", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「是这样吗?　果然也是关西人?」"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,不知道。我家的情况有点特殊,连母亲的出身地我都不清楚」"
                }
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002132", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「这样啊……」"
                }
            }
