        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「做菜这种事,只要自己动手做,就不太会对别人的菜挑刺了」"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么事都一样吧。不动手的人,反而像评论家一样摆架子说大话。",
                    {"rt2"},
                    "自己动手的人不会轻易出口,也懂得如何享受别人做出来的东西」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
