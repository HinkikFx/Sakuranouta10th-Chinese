        linknext = "block_00261"
    },
    block_00261 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002148", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「严格说来,第谷之星并不是星星自身的光芒」"
                }
            }
        },
        linkback = "block_00260",
        linknext = "block_00262"
    },
    block_00262 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002149", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那是超新星爆发。是星星在最后燃烧起来的火焰的亮度」"
                }
            }
        },
        linkback = "block_00261",
        linknext = "block_00263"
    },
    block_00263 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002150", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「所以,我们已经无法看到它了……」"
                }
            }
        },
        linkback = "block_00262",
        linknext = "block_00264"
    },
    block_00264 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「第谷之星……还有过那样的星星吗?　多久以前的事?」"
                }
            }
        },
        linkback = "block_00263",
        linknext = "block_00265"
    },
    block_00265 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002151", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「它是在中世纪的欧洲被发现的,所以是相当久远的事了」"
                }
            }
        },
        linkback = "block_00264",
        linknext = "block_00266"
    },
    block_00266 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002152", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「而且,它只闪耀了短短两年」"
                }
            }
        },
        linkback = "block_00265",
        linknext = "block_00267"
    },
    block_00267 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002153", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「即便如此,仅仅那两年间,它在天空中绽放着连金星都不输的光芒…",
                    {"rt2"},
                    "…」"
                }
            }
        },
        linkback = "block_00266",
        linknext = "block_00268"
    },
    block_00268 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002154", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「简直像燃烧一般,闪耀着」"
                }
            }
        },
        linkback = "block_00267",
        linknext = "block_00269"
    },
    block_00269 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002198", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是这样啊」"
                }
            }
        },
        linkback = "block_00268",
        linknext = "block_00270"
    },
    block_00270 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002155", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「宫泽贤治会把夜鹰之星的意象与它重叠,我似乎能够理解」"
                }
            }
        },
        linkback = "block_00269",
        linknext = "block_00271"
    },
    block_00271 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002156", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「焚身幻想吗……。原来如此啊」"
                }
            }
        },
        linkback = "block_00270",
        linknext = "block_00272"
    },
    block_00272 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002157", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「宫泽贤治的焚身幻想,是奉献精神的最北端……」"
                }
            }
        },
        linkback = "block_00271",
        linknext = "block_00273"
    },
    block_00273 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002158", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「闪耀的、罪孽深重的、奉献之星吗……」"
                }
            }
        },
        linkback = "block_00272",
        linknext = "block_00274"
    },
    block_00274 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002159", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那个时候……。里奈给我讲夜鹰的故事时,要是我也能说上这种程",
                    {"rt2"},
                    "度的话就好了……」"
                }
            }
        },
        linkback = "block_00273",
        linknext = "block_00275"
    },
    block_00275 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002199", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不。就算是现在,也非常新鲜哦。这些我全都不知道」"
                }
            }
        },
        linkback = "block_00274",
        linknext = "block_00276"
    },
    block_00276 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002160", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「这样啊,你这么说,我在天文部的学习就没有白费……」"
                }
            }
        },
        linkback = "block_00275",
        linknext = "block_00277"
    },
    block_00277 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002161", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我不像里奈,我是笨蛋,聊不来文学的话题,所以想着至少能聊聊星",
                    {"rt2"},
                    "星……」"
                }
            }
        },
        linkback = "block_00276",
        linknext = "block_00278"
    },
    block_00278 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以你才加入了天文部啊……」"
                }
            }
        },
        linkback = "block_00277",
        linknext = "block_00279"
    },
    block_00279 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002162", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「不过,我喜欢星星也是真的」"
                }
            }
        },
        linkback = "block_00278",
        linknext = "block_00280"
    },
    block_00280 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002163", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「因为在这座公园里,和里奈一起仰望的天空那么美……」"
                }
            }
        },
        linkback = "block_00279",
        linknext = "block_00281"
    },
    block_00281 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002164", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「星星真好。地上明明如此忙乱无序,它们却秩序井然,美丽地运转",
                    {"rt2"},
                    "着」"
                }
            }
        },
        linkback = "block_00280",
        linknext = "block_00282"
    },
    block_00282 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002165", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那时候还不太懂……现在,多少能明白一点夜鹰和蝎子的心情了」"
                }
            }
        },
        linkback = "block_00281",
        linknext = "block_00283"
    },
    block_00283 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「川内野……」"
                }
            }
        },
        linkback = "block_00282",
        linknext = "block_00284"
    },
    block_00284 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002166", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「夜鹰之星啊……,它太过美丽,与我无缘。但正因为无缘,如今的我才",
                    {"rt2"},
                    "会被那个故事吸引……」"
                }
            }
        },
        linkback = "block_00283",
        linknext = "block_00285"
    },
    block_00285 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002167", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「丑陋、羞耻心、罪恶感,是这些让夜鹰化作了在夜空中美丽燃烧的",
                    {"rt2"},
                    "星星…」"
                }
            }
        },
        linkback = "block_00284",
        linknext = "block_00286"
    },
    block_00286 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002168", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「对我来说,是过于美丽的故事」"
                }
            }
        },
        linkback = "block_00285",
        linknext = "block_00287"
    },
    block_00287 = {
