        text = {
            vo = {
                {"vo", file = "fem_yum_002169", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「就这样,里奈。我已经能讲这么多天上的故事了」"
                }
            }
        },
        linkback = "block_00286",
        linknext = "block_00288"
    },
    block_00288 = {
