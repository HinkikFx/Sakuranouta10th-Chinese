                    name = {"优美"},
                    "「会做日式料理吗?」"
                }
            }
        },
        linkback = "block_00095",
        linknext = "block_00097"
    },
    block_00097 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「日式料理指哪种?」"
                }
            }
        },
        linkback = "block_00096",
        linknext = "block_00098"
    },
    block_00098 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002112", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「人们不是常说,料理里炖菜最难吗」"
                }
            }
        },
        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「要是认认真真做,或许确实如此。可我是那种用业务超市卖的高汤",
                    {"rt2"},
                    "粉的人啊」"
                }
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002150", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是吗?　感觉您像是会正经用鲣鱼什么的熬高汤的人」"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,用鲣鱼熬高汤,成本高得吓人。也就特别的料理才会熬一下」"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002113", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「比如说?」"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「基本上就是日式清汤了。不过,偶尔我也会自己做面味露,用鲣鱼",
                    {"rt2"},
                    "熬出来的确实好吃,比外面卖的强太多了」"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002151", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「哦,连面味露都自己做啊,好厉害」"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不不,工夫倒不费,就是价格贵得离谱。你想,一把抓起满手木鱼花,",
                    {"rt2"},
                    "哗啦一下扔进锅里,还是挺需要勇气的」"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002114", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「木鱼花很贵吗?」"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「业务超市里500g要980日元啊。超高级品。高汤粉的话1kg也就4",
                    {"rt2"},
                    "80日元左右」"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002152", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「连价格都记得清清楚楚呢」"
                }
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嘛,做菜不只是烹饪,买菜也是料理的一环。价格很重要,不同超市",
                    {"rt2"},
                    "打对折的时间点都不一样,必须好好记住才行」"
                }
            }
        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
