    },
    block_00173 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「怕什么?」"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_002166", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「毕竟您是做菜特别厉害的人,我就想,万一您对味道挑三拣四可怎",
                    {"rt2"},
                    "么办」"
                }
