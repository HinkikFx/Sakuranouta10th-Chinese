                    "「不……不管怎样，事情演变成这样，都是我的责任……」"
                }
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"fg", ch = "健一郎", size = "z1", mode = 3, path = ":fg/ken/z1/", file = "ken_z1b0000", face = "b0004", head = "ken_z1b", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001206", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「如果我再靠谱一些的话……」"
                }
            }
        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            ja = {
                {"我摇了摇头。"}
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"text"},
        text = {
            ja = {
                {"这不是健一郎先生的错。"}
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"text"},
        text = {
            ja = {
                {"而且，我觉得能遇到禀真的太好了。"}
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            ja = {
                {"但这一切，我都无法用语言表达出来。"}
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"bg", file = "black", path = ":bg/"},
        {"text"},
        text = {
            ja = {
                {"禀失去了试图让母亲复活的一切记忆，以及那份能力。"}
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            ja = {
                {"直哉以为是千年樱夺走了禀的记忆，但那是错的。"}
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            ja = {
                {"千年樱与她的愿望产生了共鸣，并试图借助她的力量将其具现化。"}
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            ja = {
                {"夺走禀记忆的人是我。"}
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            ja = {
                {
                    "不，准确地说，是想要让母亲复活的那个梦。我将它的一切从她身",
                    {"rt2"},
                    "上夺走了。"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            ja = {
                {"我使用了力量。成为了伯奇。"}
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            ja = {
                {"方相氏的神具中，有一样叫做伯奇神乐铃的东西。"}
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            ja = {
                {"方相氏在执行滩仪式时，会敲响这面神乐铃，吟唱歌谣。"}
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            ja = {
                {"但这面神乐铃还有其他力量。"}
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            ja = {
                {"那是连接方相氏与伯奇的器物。"}
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            ja = {
                {"正因为有它，中村家才不需要将我们置于眼前。"}
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            ja = {
                {"因为当伯奇觉醒时，那面铃会发出独特的声响。"}
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"text"},
        text = {
            ja = {
                {"那是对伯奇之力的反应。"}
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            ja = {
                {
                    "所以，在我成为伯奇的那个夜晚，中村家紧急召集了人手，包围了",
                    {"rt2"},
                    "夏目的宅邸。"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            ja = {
                {
                    "以前有夏目琴子在，他们不敢轻举妄动，但在夏目家解散之后，稍",
                    {"rt2"},
                    "微强硬一些的手段也变得可行了。"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            ja = {
                {"而且，这次不是普通的中村家血脉的女人。而是觉醒为伯奇的女人。"}
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            ja = {
                {"他们拼了命地搜寻我。"}
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            ja = {
                {
                    "当然，健一郎先生没有让我回到夏目家，而是直接潜伏在都内的酒",
                    {"rt2"},
                    "店里。"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            ja = {
                {"几周后，多亏了健一郎先生和他的伙伴们，我得以逃往纽约。"}
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            ja = {
                {"此后，我一直在纽约和健一郎先生一起生活。"}
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
