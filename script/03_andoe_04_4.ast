                    name = {"健一郎"},
                    "「不……是我造成了这样的结果,这一点不会改变……」"
                }
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"fg", ch = "健一郎", size = "z1", mode = 3, path = ":fg/ken/z1/", file = "ken_z1b0000", face = "b0004", head = "ken_z1b", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001206", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「如果我再可靠一点……」"
                }
            }
        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            ja = {
                {"我摇了摇头。"}
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"text"},
        text = {
            ja = {
                {"并不是健一郎先生的错。"}
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"text"},
        text = {
            ja = {
                {"而且,能与禀相遇,我觉得很好。"}
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            ja = {
                {"可是,这一切我都无法用言语说出来。"}
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"bg", file = "black", path = ":bg/"},
        {"text"},
        text = {
            ja = {
                {"禀失去了试图让母亲复生的全部记忆,以及那份能力。"}
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            ja = {
                {"直哉大概以为,是千年樱夺走了禀的记忆,但那是误会。"}
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            ja = {
                {"千年樱与她的心愿共鸣,试图借她的力量将其具现化。"}
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            ja = {
                {"夺走禀的记忆的,是我。"}
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            ja = {
                {
                    "不,准确地说,是想让母亲复生的那个梦。我从她那里,夺走了那个梦",
                    {"rt2"},
                    "的一切。"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            ja = {
                {"我使用了力量。成为了伯奇。"}
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            ja = {
                {"方相氏的神具之中,有一样名为伯奇神乐铃的东西。"}
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            ja = {
                {"方相氏行「滩」之仪时,会敲响这神乐铃,咏唱歌谣。"}
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            ja = {
                {"但是,这神乐铃还有着别的力量。"}
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            ja = {
                {"那是联结方相氏与伯奇之物。"}
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            ja = {
                {"正因为有那个东西在,中村家才不必把我们置于眼皮底下。"}
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            ja = {
                {"因为,一旦伯奇觉醒,那铃便会奏出独特的音色。"}
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"text"},
        text = {
            ja = {
                {"那是对伯奇之力有所感应的东西。"}
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            ja = {
                {"所以,在我成为伯奇的当晚,中村家便紧急召集人手,包围了夏目宅邸。"}
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            ja = {
                {
                    "若是从前,有夏目琴子在,他们做不出这么轻率的事,但在夏目一家解",
                    {"rt2"},
                    "散之后,稍微强硬一些的手段也使得出来了。"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            ja = {
                {
                    "何况,这次的目标不是普通的中村家血脉的女人。而是作为伯奇觉醒",
                    {"rt2"},
                    "了的女人。"
                }
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            ja = {
                {"他们杀红了眼,四处搜寻我。"}
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            ja = {
                {
                    "当然,健一郎先生没有把我送回夏目家,而是直接潜伏在了东京都内",
                    {"rt2"},
                    "的酒店。"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            ja = {
                {"数周之后,多亏健一郎先生和他的伙伴们,我得以逃往纽约。"}
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            ja = {
                {"那之后,我便一直在纽约,与健一郎先生一起生活。"}
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
