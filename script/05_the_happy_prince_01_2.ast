                {"vo", file = "fem_aid_000944", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「那孩子既不在乎钱，也与所谓的认同欲求无缘。进演艺圈，我想",
                    {"rt2"},
                    "必然是有什么理由的……」"
                }
