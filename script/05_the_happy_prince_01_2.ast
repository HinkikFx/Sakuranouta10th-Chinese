                {"vo", file = "fem_aid_000943", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「谁知道呢。不过我能说的是，如果只为自己，她是不会做那种工",
                    {"rt2"},
                    "作的」"
                }
            }
        },
        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
