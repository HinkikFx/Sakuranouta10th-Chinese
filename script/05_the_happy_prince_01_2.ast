        {"bg", file = "ev_com_i01_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i01/", set = "ev_com_i01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000972", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「炒饭之类的？」"
                }
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「炒饭！？　那、那不对吧？」"
                }
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"bg", file = "ev_com_i01_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i01/", set = "ev_com_i01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000973", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「唔，说的也是……不过健一郎先生一旦闭关工作，吃的基本都是",
                    {"rt2"},
                    "炒饭。用他的话说，蔬菜和肉都能摄取，是万能的餐食」"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「净说些不着调的……那男子人明明会做的菜少得可怜……」"
                }
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"bg", file = "ev_com_i01_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i01/", set = "ev_com_i01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000974", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「是吗？　健一郎先生不会做菜？」"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊，他是典型的昭和男子人。家务活一概不会」"
                }
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"bg", file = "ev_com_i01_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i01/", set = "ev_com_i01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000975", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「这样啊……。健一郎先生说得相当自信满满，我还多少信以为真",
                    {"rt2"},
                    "了……」"
                }
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那个笨蛋就是这样。到底怎么回事呢。那毫无根据的自信……」"
                }
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「工作的时候吃炒饭确实省事，可油太多了吧。还有盐分也重。营",
                    {"rt2"},
                    "养价值绝对说不上高」"
                }
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"bg", file = "ev_com_i01_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i01/", set = "ev_com_i01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000976", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「嗯，是啊。健一郎跟我说过，做炒饭不是用油炒，而是要抱着用",
                    {"rt2"},
                    "油炸的心态去做」"
                }
            }
        },
        linkback = "block_00212",
        linknext = "block_00214"
    },
    block_00214 = {
        {"text"},
        text = {
            ja = {
                {"跟她说过……吗。"}
            }
        },
        linkback = "block_00213",
        linknext = "block_00215"
    },
    block_00215 = {
        {"text"},
        text = {
            ja = {
                {
                    "原来如此，蓝好像别的菜都不会做，唯独炒饭出奇地好吃，理由我",
                    {"rt2"},
                    "大概明白了……。"
                }
            }
        },
        linkback = "block_00214",
        linknext = "block_00216"
    },
    block_00216 = {
        {"text"},
        text = {
            ja = {
                {"炒饭是一种特殊的料理。"}
            }
        },
        linkback = "block_00215",
        linknext = "block_00217"
    },
    block_00217 = {
        {"text"},
        text = {
            ja = {
                {"其他料理里难以想象的高温与油量。"}
            }
        },
        linkback = "block_00216",
        linknext = "block_00218"
    },
    block_00218 = {
        {"text"},
        text = {
            ja = {
                {"连我至今都做不好。"}
            }
        },
        linkback = "block_00217",
        linknext = "block_00219"
    },
    block_00219 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不过说真的，圭也在赶工，炒饭之类的说不定正合他意」"
                }
            }
        },
        linkback = "block_00218",
        linknext = "block_00220"
    },
    block_00220 = {
