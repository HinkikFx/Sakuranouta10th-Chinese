            },
            ja = {
                {
                    name = {"蓝"},
                    "「不过啊，直哉，互相吻合的事情实在太多了……。夏目家的每个",
                    {"rt2"},
                    "人，都在纠结该如何面对那个事实」"
                }
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
