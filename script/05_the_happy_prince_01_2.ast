        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"bg", file = "ev_com_i01_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i01/", set = "ev_com_i01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000975", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「这样啊……健一郎先生说的时候倒是信心满满的，我还信以为真",
                    {"rt2"},
                    "了……」"
                }
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那笨蛋就那样。这种毫无根据的自信到底是哪来的……」"
                }
            }
