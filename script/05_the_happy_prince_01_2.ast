        linkback = "block_00213",
        linknext = "block_00215"
    },
    block_00215 = {
        {"text"},
        text = {
            ja = {
                {
                    "原来如此，蓝不会做其他菜，却唯独把炒饭做得出奇地好，原因我",
                    {"rt2"},
                    "好像明白了……"
                }
            }
        },
        linkback = "block_00214",
        linknext = "block_00216"
    },
    block_00216 = {
        {"text"},
        text = {
            ja = {
                {"炒饭是一道特殊的料理。"}
