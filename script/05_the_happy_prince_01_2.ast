        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「确实工作的时候吃炒饭是挺方便的，但是油多啊。而且盐分也高。",
                    {"rt2"},
                    "算不上营养价值有多高」"
                }
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"bg", file = "ev_com_i01_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i01/", set = "ev_com_i01"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_000976", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「嗯，是啊。炒饭不是用油炒，要用油炸的架势来做——健一郎是这",
                    {"rt2"},
                    "么教我的」"
                }
            }
        },
        linkback = "block_00212",
        linknext = "block_00214"
    },
    block_00214 = {
        {"text"},
        text = {
            ja = {
                {"教的……吗。"}
