        text = {
            vo = {
                {"vo", file = "fem_aid_000942", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「雫她一边上学一边当艺人，想必也是出于同样的缘由……」"
                }
            }
