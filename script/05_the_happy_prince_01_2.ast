        text = {
            vo = {
                {"vo", file = "fem_aid_000974", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「是吗？健一郎先生不是料理好手吗？」"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，他是典型的昭和时代大老爷们。家务一概不会」"
