            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊，不不，不是什么伤感的话啦。他就是那种人，笨手笨脚的。",
                    {"rt2"},
                    "所以树敌也特别多」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「他不得不在纽约那种地方战斗也全是因为他的性格。那家伙总是",
                    {"rt2"},
                    "在树敌。净制造一些不需要的敌人」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002076", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「是个温柔的父亲呢……」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「才不是，他是个混蛋。他还给我的手绑了什么绘画养成器之类的",
                    {"rt2"},
                    "东西」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002077", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「那是什么？」"
                }
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不是有部漫画叫巨人之星吗。里面有个大联盟养成器，差不多就",
                    {"rt2"},
                    "是那种东西」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002078", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「好有趣的爸爸呢」"
                }
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，草薙健一郎这个男子人啊，笨得不可救药，自由得不可救药",
                    {"rt2"},
                    "……同时也是最不自由的家伙……」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002079", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「好深厚的家族羁绊呢……」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是吗？明明大家都各散东西。一个个都早早去世，一起相处的时",
                    {"rt2"},
                    "间少得可怜的一家人」"
                }
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002080", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「嗯，但我能感受到很深的羁绊」"
                }
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002081", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「因为每次提到草薙健一郎先生的时候直哉都会变得冷淡，但真正",
                    {"rt2"},
                    "聊起爸爸的事情来，明明在说着坏话，却带着害羞的、炫耀般的表",
                    {"rt2"},
                    "情，仿佛在以此为傲似的……」"
                }
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002082", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「我明白了，平时不想提起正是因为爸爸对你很重要」"
                }
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不不，真的恨归恨。被那个笨蛋耍得够呛……结果还那么早就死",
                    {"rt2"},
                    "了……」"
                }
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「最后遗言居然是'告诉所有人我的人生是不幸的，所以不用担心。",
                    {"rt2"},
                    "祝福我的死吧！笑着送我走！'」"
                }
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「换了谁都想揍他一顿吧？」"
                }
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
