                {"vo", file = "fem_rnd_002084", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「我和父亲,关系不怎么好……」"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
