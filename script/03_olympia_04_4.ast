        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002075", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「……直君」"
                }
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,不不,这不是什么伤感的话题。他就是那种家伙,笨拙得很。所",
                    {"rt2"},
                    "以树敌也格外多」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「他之所以不得不在纽约那种地方战斗,全都是那性格害的。那家伙",
                    {"rt2"},
                    "走到哪都树敌。净树些没必要的敌」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002076", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「是位温柔的父亲呢……」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,他烂透了。那家伙还给我的手戴过绘画养成矫具什么的」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002077", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「那是什么呀?」"
                }
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不是有部叫巨○之星的漫画吗。里面出现过大联盟养成矫具,大概",
                    {"rt2"},
                    "就是那种东西吧?」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002078", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「是位有趣的父亲呢」"
                }
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,草薙健一郎这个男子人,真是无可救药地愚蠢,无可救药地自由",
                    {"rt2"},
                    "……同时也是最不自由的家伙……」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002079", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「好了不起的家人的羁绊啊……」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是吗?大家可都是各奔东西的哦?一个个说死就死,是生涯里共处时",
                    {"rt2"},
                    "间少得离谱的一家人哦」"
                }
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002080", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「嗯,但我能感受到了不起的羁绊」"
                }
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002081", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「因为呀,平时一提起草薙健一郎先生就板起脸的直君,真要说起父",
                    {"rt2"},
                    "亲的事来,嘴上骂着,却又难为情似的、得意洋洋的,就像在夸耀自己",
                    {"rt2"},
                    "一样……」"
                }
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002082", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「平时不愿提起,正说明父亲有多重要,我明白了」"
                }
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不不,恨是真的恨啊。我可被那个笨蛋折腾得不轻……结果他倒早",
                    {"rt2"},
                    "早地死了……」"
                }
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「到最后,遗言居然是“告诉大家我的人生是不幸的,所以不必担心。",
                    {"rt2"},
                    "为我的死献上祝福!笑着为我送行!”这种话」"
                }
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「换你也想揍他吧?」"
                }
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_002083", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「不。是位好父亲哦」"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「……」"
                }
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
