        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不过啊,人们不是常说,几乎没有不为孩子着想的父母吗。你父亲",
                    {"rt2"},
                    "也有他自己的考量吧……」"
