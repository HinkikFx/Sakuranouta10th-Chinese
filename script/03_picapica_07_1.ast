    },
    block_00027 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002972", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「那个时代的作品呢，比较容易模仿。虽然其实也没那么简单，但",
