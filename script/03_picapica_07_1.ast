        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002980", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「然后呢，那个半透明的透雕花纹，就用了穆夏四颗星的图案」"
