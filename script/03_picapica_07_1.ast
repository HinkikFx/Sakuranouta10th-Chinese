        linkback = "block_00225",
        linknext = "block_00227"
    },
    block_00227 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「光看脸还没什么感觉，但怎么说呢，肩膀的线条……耳朵的形状，",
                    {"rt2"},
                    "还有手指什么的……都微妙地重合……嘛，圭长得像母亲，真是太好",
