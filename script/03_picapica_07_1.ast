    },
    block_00026 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0900", face = "a0011", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002971", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「感兴趣是真的，不过要说喜好，我更喜欢那种块量感十足、沉甸",
