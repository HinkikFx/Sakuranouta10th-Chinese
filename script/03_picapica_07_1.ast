    },
    block_00034 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002977", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「变成半透明的透雕部分，在光线照射下浮现出来，被比喻为萤火",
