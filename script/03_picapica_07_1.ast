        linkback = "block_00025",
        linknext = "block_00027"
    },
    block_00027 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002972", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「那个时代的作品，相对来说容易模仿。其实也没那么简单，只是",
                    {"rt2"},
                    "会让人觉得，说不定我也能模仿出来？　大概是这种感觉……」"
                }
            }
        },
        linkback = "block_00026",
        linknext = "block_00028"
    },
    block_00028 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0900", face = "a0001", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002973", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我在花瓶的上半部分，用类似萤手的技法加入了淡淡的女性像和",
                    {"rt2"},
                    "花朵的透光纹样。这也是为了掩饰下半部分做成了双层结构」"
                }
            }
        },
        linkback = "block_00027",
        linknext = "block_00029"
    },
    block_00029 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002974", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「不过说到底也只是『类似』，离正宗还差得远……顺带一提，真",
