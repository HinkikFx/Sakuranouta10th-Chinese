        },
        linkback = "block_00034",
        linknext = "block_00036"
    },
    block_00036 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002979", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「顺带一提，明治时代的日本也做出过相当精巧的作品，据说还在",
