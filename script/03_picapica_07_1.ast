        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002980", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「然后，那半透明的透光纹样，我用的就是穆夏的四星」"
