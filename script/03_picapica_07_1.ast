        linkback = "block_00032",
        linknext = "block_00034"
    },
    block_00034 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002977", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「据说是因为变成半透明的透雕部分，会透着光浮现出来，被比作",
                    {"rt2"},
                    "萤火虫的光，所以才叫萤手，大概是这么回事」"
