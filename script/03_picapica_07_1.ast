        linkback = "block_00224",
        linknext = "block_00226"
    },
    block_00226 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「圭和雾乃女士的表情实在差太多，一开始我也没看出来，不过嘛，",
                    {"rt2"},
                    "看着看着……与其说像宁，不如说，更像圭……」"
                }
            }
