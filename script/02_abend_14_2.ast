        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"fg", ch = "紗希", size = "z1", mode = 3, path = ":fg/sak/z1/", file = "sak_z1a0000", face = "a0010", head = "sak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000015", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「那么,继续刚才的话吧。草薙君」"
                }
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"fg", ch = "紗希", size = "z1", mode = 3, path = ":fg/sak/z1/", file = "sak_z1a0000", face = "a0001", head = "sak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000016", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「关于我解雇了草薙健一郎氏这件事,你有什么疑问吗?」"
                }
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,这件事本身并不是问题。关键在于,正因为那件作品是未完成",
                    {"rt2"},
                    "的,所以才无法公开。我只是想确认这一点」"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"fg", ch = "紗希", size = "z1", mode = 3, path = ":fg/sak/z1/", file = "sak_z1a0000", face = "a0010", head = "sak_z1a", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "紗希", size = "z1", mode = 3, path = ":fg/sak/z1/", file = "sak_z1a0000", face = "a0005", head = "sak_z1a", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_htd_000017", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「正如草薙君所说。正因为我们解雇了他、让作品成了未完成之作,",
                    {"rt2"},
                    "才无法将它公之于众」"
                }
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"fg", ch = "紗希", size = "z1", mode = 3, path = ":fg/sak/z1/", file = "sak_z1a0000", face = "a0011", head = "sak_z1a", lv = 4, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "紗希", size = "z1", mode = 3, path = ":fg/sak/z1/", file = "sak_z1a0000", face = "a0001", head = "sak_z1a", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_htd_000018", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「如你所言,如果这所学校只是一所普通的学校,或许就没有问题了,",
                    {"rt2"},
                    "不过嘛,大概是弓张的传统不允许这么做吧」"
                }
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「正因如此,草薙健一郎的作品才以未完成之姿,被葬入了黑暗之中」"
