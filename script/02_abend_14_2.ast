        linkback = "block_00023",
        linknext = "block_00025"
    },
    block_00025 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此,那时候也没有得到许可吗。所以学校方面解雇了那位教",
                    {"rt2"},
                    "师。让他承担了责任」"
                }
            }
        },
        linkback = "block_00024",
        linknext = "block_00026"
    },
    block_00026 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kya_000021", ch = "kya"}
            },
            ja = {
                {
                    name = {"教师A", "教师A"},
                    "「喂、喂,草薙!不知道你在说些什么!别口出狂言!这可是在校长先生",
                    {"rt2"},
                    "面前!你这家伙!」"
                }
            }
        },
        linkback = "block_00025",
        linknext = "block_00027"
    },
    block_00027 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「狂言?不,这只是单纯的事实。无论在谁面前,事实都不会改变」"
                }
            }
        },
        linkback = "block_00026",
        linknext = "block_00028"
    },
    block_00028 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kya_000022", ch = "kya"}
            },
            ja = {
                {
                    name = {"教师A", "教师A"},
                    "「是、是不是事实我不知道。再说那么久远的事,你凭什么断言那就",
                    {"rt2"},
                    "是事实!」"
                }
