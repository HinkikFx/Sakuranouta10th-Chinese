    },
    block_00145 = {
        {"fg", ch = "明石", size = "z1", mode = 3, path = ":fg/aka/z1/", file = "aka_z1a0000", face = "a0001", head = "aka_z1a", lv = 4, id = 10},
        {"fgact", ch = "明石", act = "おじぎ", lv = 4, id = 10},
