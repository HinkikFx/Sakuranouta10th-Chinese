        linknext = "block_00036"
    },
    block_00036 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「总之，草薙健一郎是被校方解雇的。正因如此，教堂的改装出自",
                    {"rt2"},
                    "草薙健一郎之手这一事实被隐瞒了。因为对校方不利」"
