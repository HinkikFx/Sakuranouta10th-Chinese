    },
    block_00044 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「校方惩罚了草薙健一郎。并且使一位世界级画家的作品成为了未",
                    {"rt2"},
                    "完成品」"
                }
