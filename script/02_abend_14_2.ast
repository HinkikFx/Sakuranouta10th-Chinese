        linkback = "block_00043",
        linknext = "block_00045"
    },
    block_00045 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「如果是普通学校也就罢了，对于这所培养了众多艺术家的学校来",
