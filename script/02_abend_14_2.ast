                    "股小小的美术热潮的知名度」"
                }
            }
        },
        linkback = "block_00038",
        linknext = "block_00040"
    },
    block_00040 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这是理所当然的。战后在世界范围内取得成功的艺术家屈指可数。",
                    {"rt2"},
                    "更何况在这个时代，无论什么领域能在世界取得成功的人都是超级",
                    {"rt2"},
                    "巨星」"
                }
            }
