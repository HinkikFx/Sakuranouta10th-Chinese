        linkback = "block_00039",
        linknext = "block_00041"
    },
    block_00041 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「尽管如此，那座教堂出自草薙健一郎之手的事实却被隐瞒了」"
