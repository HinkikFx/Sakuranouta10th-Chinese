    },
    block_00006 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000544", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「全部责任都在老夫。所以老夫认为,受罚的只需老夫一人便足够了",
