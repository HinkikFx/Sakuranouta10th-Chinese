        linkback = "block_00035",
        linknext = "block_00037"
    },
    block_00037 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「话虽如此，在当时也是没办法的事。那个年代，草薙健一郎不过",
                    {"rt2"},
                    "是一个无名的普通教员而已」"
                }
            }
        },
        linkback = "block_00036",
        linknext = "block_00038"
    },
    block_00038 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但是，放到过去也就罢了，现在不同了。'草薙健一郎之作'这一事",
                    {"rt2"},
                    "实除了荣誉之外什么都不是」"
                }
            }
        },
        linkback = "block_00037",
        linknext = "block_00039"
    },
    block_00039 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「死后犹然，不，正因为是死后的现在，才有了在这个国家掀起一",
