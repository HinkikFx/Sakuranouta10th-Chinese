        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「恨不得把取景框固定住,连观察时的脸都固定住才好。可就算做了",
                    {"rt2"},
                    "那么麻烦的事,该偏还是会偏,所以嘛,渐渐地也就不怎么用了」"
                }
