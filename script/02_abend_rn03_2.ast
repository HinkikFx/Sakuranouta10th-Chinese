        linkback = "block_00083",
        linknext = "block_00085"
    },
    block_00085 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯,理所当然,男子人和女人的骨头数量、肌肉数量都是一样的。",
                    {"rt2"},
                    "绝不存在女性因为腰细所以肋骨就少几根这种事」"
                }
            }
        },
        linkback = "block_00084",
        linknext = "block_00086"
    },
    block_00086 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不过,骨骼的形状和大小是有差异的。尤其是骨盆带,由于生育的",
                    {"rt2"},
                    "关系,形状本身就有所不同」"
                }
            }
        },
        linkback = "block_00085",
        linknext = "block_00087"
    },
    block_00087 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但说到底也就是那种程度的差异。在人体素描之前,先理解肌肉结",
                    {"rt2"},
                    "构,再亲手触摸自己的身体,去理解它们是什么形状、如何连结、脂",
                    {"rt2"},
                    "肪又是怎样附着的」"
                }
            }
        },
        linkback = "block_00086",
        linknext = "block_00088"
    },
