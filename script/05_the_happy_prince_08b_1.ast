        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001427", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「不是，如果直哉爱我的话，我可以无限地爱你」"
                }
            }
        },
        linkback = "block_00131",
        linknext = "block_00133"
    },
    block_00133 = {
