    block_00152 = {
        {"text"},
        text = {
            ja = {
                {"伯奇轻轻触碰了我的脸颊。"}
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"fg", ch = "伯奇", size = "z2", mode = 3, path = ":fg/hak/z2/", file = "hak_z2a0000", face = "a0004", head = "hak_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_had_000078", ch = "had"}
            },
            ja = {
                {
                    name = {"伯奇"},
                    "「真是奇怪呢。明明不懂什么是开心和快乐，悲伤的表情却一眼就",
                    {"rt2"},
                    "能看出来。大概是因为一直接触的都是人们阴暗的心灵吧……」"
                }
            }
        },
        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
