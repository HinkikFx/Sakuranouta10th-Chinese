        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"fg", ch = "伯奇", size = "z2", mode = 3, path = ":fg/hak/z2/", file = "hak_z2a0000", face = "a0005", head = "hak_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_had_000079", ch = "had"}
            },
            ja = {
                {
                    name = {"伯奇"},
                    "「没关系的。因为在最后,我触碰到了您的,义贞大人温暖的心」"
                }
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_yod_000119", ch = "yod"}
            },
            ja = {
                {
                    name = {"义贞"},
                    "「那种东西！　今后想触碰多少次都行！　多少次都行！」"
                }
