        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000818", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「他也是钢琴家，据说因为过度使用附有重物的手指悬挂训练装置",
