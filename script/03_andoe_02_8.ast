        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊」"
                }
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000830", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「呵呵呵呵,嘴上说着不可能凭空捏造,却开始做起准备来了。真是",
                    {"rt2"},
                    "的,我有个好儿子啊」"
                }
            }
        },
        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这一点,像你」"
                }
            }
        },
        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000831", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嘛,也罢。颜料表确实存在。去问弗里德曼,他会拿给你的。《横",
                    {"rt2"},
                    "卧之樱》正是因为有穆尔财团的弗里德曼作后盾,才能拿下白金蝶奖」"
                }
            }
        },
        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000832", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「所以,从那幅作品开始构思的时期起,弗里德曼就一直在整理我的",
                    {"rt2"},
                    "资料之类的东西」"
                }
            }
        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「资料。这我头一回听说。知道这个,情况就大不一样了」"
                }
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"bg", file = "ev_com_f02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000833", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「哦。干劲十足嘛。世界级艺术家的最高杰作,要以七部作之名做出",
                    {"rt2"},
                    "赝作来」"
                }
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我说过很多次了,这近乎不可能」"
