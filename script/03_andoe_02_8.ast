                    "「那这次的事呢?」"
                }
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000788", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「我总觉得,弗里德曼恐怕从一开始就掺和进来了」"
                }
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那明石呢?」"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000789", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「我不认识叫明石的人。不过,从他带着英文誓约书、还揣着我的名",
                    {"rt2"},
                    "片这几点来看,断定他和弗里德曼有过接触,应该不会错」"
                }
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000790", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「而且,伪造国籍啦、变装什么的,也让人在意」"
                }
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,那家伙偶尔就会穿些奇装异服。毕竟平时就是制服外面套大衣",
                    {"rt2"},
                    "那种不合常理的打扮。那与其说是变装,不如说是她心目中的英雄形",
                    {"rt2"},
                    "象吧」"
                }
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000791", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「哦——是吗,那也许确实如此,不过我还是能从中嗅到弗里德曼的鬼",
                    {"rt2"},
                    "点子」"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就算是这样,区区一介学生的明石,和穆尔财团的策展人弗里德曼,",
                    {"rt2"},
                    "是怎么搭上线的?」"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000792", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那我可不知道。自己去问当事人啊」"
                }
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000793", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「话说回来,中村章一那股蠢劲儿真是一点没变。一般人会信吗」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「怎么说呢,那个大叔给人一种在权威面前就软骨头的感觉」"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000794", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「确实,我认识中村章一,那家伙本就是俗物中的俗物,不过比起当年,",
                    {"rt2"},
                    "倒更显老糊涂了。唉,大概也是被逼到那份儿上了吧」"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「听说中村制药业绩很差啊」"
                }
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000795", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「详情不清楚,不过让那种货色当会长,生意能好才怪」"
                }
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000796", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「话虽如此,笑归笑……,那个叫明石的家伙撒下的谎,你打算怎么办?」"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,毕竟那种七部作根本不存在」"
                }
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000797", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「不存在是当然的吧。那种东西怎么可能画得出七幅」"
                }
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「可中村家已经开始相信明石的谎话了。恐怕他们打心底里相信那",
                    {"rt2"},
                    "家伙是个买手」"
                }
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「于是,这就说到我的第一个请求了」"
                }
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000798", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「拒绝」"
                }
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我还什么都没说呢」"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000799", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「反正就是让我随便编造个七部作出来吧?那种东西怎么可能做得",
                    {"rt2"},
                    "到。我的寿命只剩半年了啊」"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「管你呢。漫画之神可是那样的哦。直到死前一刻都还在画漫画」"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「失去意识后,再度睁开眼的那一瞬间,说出口的话是——原稿和笔,拿",
                    {"rt2"},
                    "来」"
                }
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000800", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那是那,这是这」"
                }
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000801", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「再说漫画之神可是货真价实的天才。我基本上就是个江湖骗子之",
                    {"rt2"},
                    "流。既不是天才,也什么都不是」"
                }
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
    block_00082 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就算这样,你不也一直靠那身行骗的本事蒙骗着全世界吗?」"
                }
            }
        },
        linkback = "block_00081",
        linknext = "block_00083"
    },
    block_00083 = {
        {"bg", file = "ev_com_f02_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000802", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那是啊。因为我是天才嘛」"
                }
            }
        },
        linkback = "block_00082",
        linknext = "block_00084"
    },
    block_00084 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「到底是哪边啊,真是的」"
                }
            }
        },
        linkback = "block_00083",
        linknext = "block_00085"
    },
    block_00085 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000803", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「既然是骗子的儿子……那就用骗子儿子的方式去解决,如何?」"
                }
            }
        },
        linkback = "block_00084",
        linknext = "block_00086"
    },
    block_00086 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「切,真是敷衍」"
                }
            }
        },
        linkback = "block_00085",
        linknext = "block_00087"
    },
    block_00087 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000804", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「直哉,你知道世界上最古老的职业据说是什么吗?」"
                }
            }
        },
        linkback = "block_00086",
        linknext = "block_00088"
    },
    block_00088 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「卖春」"
                }
            }
        },
        linkback = "block_00087",
        linknext = "block_00089"
    },
    block_00089 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000805", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那第二古老的呢?」"
                }
            }
        },
        linkback = "block_00088",
        linknext = "block_00090"
    },
    block_00090 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「赝作吧」"
                }
            }
        },
        linkback = "block_00089",
        linknext = "block_00091"
    },
    block_00091 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000806", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「书读得不错嘛」"
                }
            }
        },
        linkback = "block_00090",
        linknext = "block_00092"
    },
    block_00092 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,著名电影导演奥逊·威尔斯留下过一句话,说它『与伊甸园的那",
                    {"rt2"},
                    "棵树一样古老』。实际上,众多腓尼基和苏美尔的赝作者,也确实伪",
                    {"rt2"},
                    "造过大量古希腊的作品」"
                }
            }
        },
        linkback = "block_00091",
        linknext = "block_00093"
    },
    block_00093 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000807", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「不止如此。一流大师同样染指过赝作。就是那个,你所信奉的米开",
                    {"rt2"},
                    "朗琪罗,不就有个有名的故事吗?」"
                }
            }
        },
        linkback = "block_00092",
        linknext = "block_00094"
    },
    block_00094 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,没听说过」"
                }
            }
        },
        linkback = "block_00093",
        linknext = "block_00095"
    },
    block_00095 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000808", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「文艺复兴时期,年轻的米开朗琪罗为了引起赞助人洛伦佐·德·美第",
                    {"rt2"},
                    "奇的注意,伪造了罗马时代的雕刻,埋进美第奇家的庭园里」"
                }
            }
        },
        linkback = "block_00094",
        linknext = "block_00096"
    },
    block_00096 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000809", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「不仅如此,他还临摹过许多昔日巨匠亲笔的素描。据说为了让它们",
                    {"rt2"},
                    "与原作几乎无法区分,他用烟熏、染色、做旧,是相当费工夫的赝作」"
                }
            }
        },
        linkback = "block_00095",
        linknext = "block_00097"
    },
    block_00097 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「以米开朗琪罗那样的本事,拿原创作品也足以引人注目了吧?为什",
                    {"rt2"},
                    "么要去做赝作?」"
                }
            }
        },
        linkback = "block_00096",
        linknext = "block_00098"
    },
    block_00098 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000810", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「米开朗琪罗可是赝作的天才。比如流传着这样的逸闻:他把为临摹",
                    {"rt2"},
                    "而借来的真迹,用赝品还了回去。为的就是把原作留在自己手边」"
                }
            }
        },
        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「在东洋,书法界也流传着类似的故事。不管怎么说,你是想讲,在艺",
                    {"rt2"},
                    "术之中,赝作与真作有着相当密切的关系,对吧?」"
                }
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000811", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「就是这么回事」"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那么?老爸,能把《横卧之樱》的颜料配方告诉我吗?」"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000812", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「哦?怎么?怎么?你这么轻易地,就起了捏造樱七部作的念头?」"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那是不可能的。如今的我,已经没有你一手培养出来的那只右手了」"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"bg", file = "ev_com_f02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000813", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「哈哈哈,我一手培养出来的右手吗,说得还真是妙啊」"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,我到现在还记恨着呢。记恨那个绘画养成石膏架」"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000814", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「可是啊。要练成必杀技,秘密特训是不可或缺的吧?」"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就算这样!这世上哪有给刚出生没多久的孩子的手臂套上养成石膏",
                    {"rt2"},
                    "架的父亲啊!」"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000815", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「据说那种东西是越早越好。运动神经啦、肌力什么的,最近的研究",
                    {"rt2"},
                    "表明,比起遗传,孩童时期的环境影响更大」"
                }
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那类研究,过不了几年就会翻出个完全相反的学说来吧」"
                }
            }
        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「话说那是什么?巨○之星的恶搞吗?」"
                }
            }
        },
        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"bg", file = "ev_com_f02_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000816", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嘛,也有那个成分」"
                }
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「还真有啊!」"
                }
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000817", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「你知道舒曼吧?」"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,你喜欢的作曲家嘛」"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000818", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「他同时也是位钢琴家。据说他用挂着重物吊起手指的训练装置勉",
                    {"rt2"},
                    "强练习,把手给练坏了」"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「喂喂,那不正是训练装置把手弄坏的吗」"
                }
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000819", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「啊,不过,这个通行的说法据说是错的哦」"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那不就跟舒曼没关系了嘛」"
                }
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000820", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「不不,那个时代存在那种养成石膏架式的玩意儿,这可是事实,实物",
                    {"rt2"},
                    "也保存了下来,舒曼用过的可能性很高」"
                }
            }
        },
        linkback = "block_00118",
        linknext = "block_00120"
    },
    block_00120 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000821", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「历史上的艺术家戴着那种养成石膏架似的东西,多有梦想啊。所以",
                    {"rt2"},
                    "你也要成为那样有梦想的艺术家」"
                }
            }
        },
        linkback = "block_00119",
        linknext = "block_00121"
    },
    block_00121 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那种东西才不叫梦想」"
                }
            }
        },
        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000822", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「可是,靠着那个石膏架,你不是能画出我的画了吗?」"
                }
            }
        },
        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,这倒是。不过,不知是什么因果,我和你最爱的舒曼一样,惯用的",
                    {"rt2"},
                    "那只手也废掉了」"
                }
            }
        },
        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"bg", file = "ev_com_f02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000823", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那件事嘛,反过来想,说不定正因为有我的养成石膏架,才只落得那",
                    {"rt2"},
                    "种程度呢」"
                }
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我不否认。那时候,单论右手掰腕子,我可是能轻松赢过大人的」"
                }
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000824", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那是当然」"
                }
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那要是当年给左手也套上,现在说不定已经能用左手画画了」"
                }
            }
        },
        linkback = "block_00126",
        linknext = "block_00128"
    },
    block_00128 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000825", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「不,那玩意儿只有小鬼头戴才有意义。既然已经长大成人、身体定",
                    {"rt2"},
                    "了型,就老老实实做做肌肉训练吧」"
                }
            }
        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「肌肉训练我一直在做。那套菜单与其说是给画家的,不如说是给运",
                    {"rt2"},
                    "动员的」"
                }
            }
        },
        linkback = "block_00128",
        linknext = "block_00130"
    },
    block_00130 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000826", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「啊,我留下的那套菜单,你有好好完成吗」"
                }
            }
        },
        linkback = "block_00129",
        linknext = "block_00131"
    },
    block_00131 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嘛,你交代的菜单,都照做了」"
                }
            }
        },
        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"bg", file = "ev_com_f02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000827", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那么?用那只练过肌肉的左手,画得出来吗?」"
                }
            }
        },
        linkback = "block_00131",
        linknext = "block_00133"
    },
    block_00133 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嘛,大概是勉强能考上艺大的水平吧……」"
                }
            }
        },
        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000828", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「区区考上艺大,也配和我的画相提并论?我可是世界级的画家!」"
                }
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以说,我画不出来。别说你的画了,连圭的画我都望尘莫及」"
