        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000788", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯，弗里德曼从一开始就参与了，我有这种感觉」"
                }
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那明石呢？」"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000789", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「我不认识叫明石的人。不过，既然他带着英文保证书，还有我的",
                    {"rt2"},
                    "名片，基本可以断定是跟弗里德曼接触过的」"
                }
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000790", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「还有，假装国籍啊，变装什么的也让人在意」"
                }
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不，那家伙偶尔会穿奇怪的衣服。平时也总是穿着校服配大衣这",
                    {"rt2"},
                    "种不合常理的打扮。那个与其说是变装，不如说是他心目中的英雄",
                    {"rt2"},
                    "形象」"
                }
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000791", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯——，是吗，那也许是那样，但我还是感觉有弗里德曼的坏主意",
                    {"rt2"},
                    "在里面」"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就算是这样，一个普通学生明石和摩尔基金会策展人弗里德曼是",
                    {"rt2"},
                    "怎么搭上的？」"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000792", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「这我就不知道了。你问他们本人去」"
                }
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000793", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「不过，中村章一的蠢还是没变啊。正常人谁会信那种话」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「怎么说呢，那大叔看起来确实很吃权威那一套」"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000794", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「确实，我了解中村章一，那家伙以前就是个十足的庸俗之人，不",
                    {"rt2"},
                    "过感觉比以前更糊涂了。嘛，大概是因为确实走投无路了吧」"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「听说中村制药的业绩很差」"
                }
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000795", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「详细情况我不知道，但有那种人当会长的话，生意也不可能好」"
                }
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000796", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「话说回来，虽然我笑得很开心……那个叫明石的家伙说的谎，你",
                    {"rt2"},
                    "们打算怎么收场？」"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，什么七部作根本不存在啊」"
                }
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000797", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「不存在是肯定的。那种东西怎么可能做出七幅来」"
                }
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但是中村家已经开始相信明石的谎话了。大概他们打心底相信那",
                    {"rt2"},
                    "家伙是买手」"
                }
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以，先说第一个请求」"
                }
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000798", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「拒绝」"
                }
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我还没说呢」"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000799", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「反正是让我随便画个七部作出来吧？怎么可能做得到。我只有半",
                    {"rt2"},
                    "年好活了」"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「管你呢。漫画之神可是直到临终那一刻都在画漫画」"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那位在失去意识后，恢复意识的一瞬间说的话是：把稿子和笔给",
                    {"rt2"},
                    "我」"
                }
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000800", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那是那个，这是这个」"
                }
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000801", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「再说漫画之神是真正的天才。我基本上就是个",
                    {"txruby", text = "ペテン"},
                    "骗子",
                    {"txruby"},
                    "一样的东西。",
                    {"rt2"},
                    "既不是天才也不是什么」"
                }
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
    block_00082 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就算如此，你不是用那种骗术能力一直欺骗着全世界吗？」"
                }
            }
        },
        linkback = "block_00081",
        linknext = "block_00083"
    },
    block_00083 = {
        {"bg", file = "ev_com_f02_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000802", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「嗯是啊。因为我是天才嘛」"
                }
            }
        },
        linkback = "block_00082",
        linknext = "block_00084"
    },
    block_00084 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「到底是哪边啊，真是的」"
                }
            }
        },
        linkback = "block_00083",
        linknext = "block_00085"
    },
    block_00085 = {
        {"bg", file = "ev_com_f02_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000803", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「",
                    {"txruby", text = "ペテン"},
                    "骗子",
                    {"txruby"},
                    "的儿子……那不如像",
                    {"txruby", text = "ペテン"},
                    "骗子",
                    {"txruby"},
                    "的儿子一样想办法解决？」"
                }
            }
        },
        linkback = "block_00084",
        linknext = "block_00086"
    },
    block_00086 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「切，真不负责任」"
                }
            }
        },
        linkback = "block_00085",
        linknext = "block_00087"
    },
    block_00087 = {
        {"bg", file = "ev_com_f02_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000804", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「直哉，你知道世界上最古老的职业是什么吗？」"
                }
            }
        },
        linkback = "block_00086",
        linknext = "block_00088"
    },
    block_00088 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「卖淫」"
                }
            }
        },
        linkback = "block_00087",
        linknext = "block_00089"
    },
    block_00089 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000805", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那第二古老的呢？」"
                }
            }
        },
        linkback = "block_00088",
        linknext = "block_00090"
    },
    block_00090 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「赝作」"
                }
            }
        },
        linkback = "block_00089",
        linknext = "block_00091"
    },
    block_00091 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000806", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「学得不错嘛」"
                }
            }
        },
        linkback = "block_00090",
        linknext = "block_00092"
    },
    block_00092 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，著名电影导演奥森·威尔斯曾说过'如同伊甸园之树一般古老'，",
                    {"rt2"},
                    "事实上，从古希腊时代起，就有大量腓尼基人和苏美尔人的赝作者",
                    {"rt2"},
                    "在仿制作品」"
                }
            }
        },
        linkback = "block_00091",
        linknext = "block_00093"
    },
    block_00093 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000807", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「不只如此。一流大师也同样染指赝作。对了，你崇拜的米开朗基",
                    {"rt2"},
                    "罗不就有个著名的故事吗？」"
                }
            }
        },
        linkback = "block_00092",
        linknext = "block_00094"
    },
    block_00094 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不，我不知道」"
                }
            }
        },
        linkback = "block_00093",
        linknext = "block_00095"
    },
    block_00095 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000808", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「文艺复兴时期，年轻的米开朗基罗为了引起赞助人洛伦佐·德·美第",
                    {"rt2"},
                    "奇的注意，伪造了罗马时代的雕塑，埋在了美第奇家的园林里」"
                }
            }
        },
        linkback = "block_00094",
        linknext = "block_00096"
    },
    block_00096 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000809", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「而且他还临摹了许多过去大师们的素描。据说他用烟熏染、弄脏",
                    {"rt2"},
                    "等手法让仿品几乎无法与真品区分，做得相当精巧」"
                }
            }
        },
        linkback = "block_00095",
        linknext = "block_00097"
    },
    block_00097 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「以米开朗基罗的实力，靠原创也能引起注意吧？为什么要做赝作？",
                    {"rt2"},
                    "」"
                }
            }
        },
        linkback = "block_00096",
        linknext = "block_00098"
    },
    block_00098 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000810", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「米开朗基罗是赝作的天才。据传说，他曾经把借来用来临摹的真",
                    {"rt2"},
                    "品，用赝品还了回去。目的是把原作留在自己手边」"
                }
            }
        },
        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「在东方，书法领域也有类似的传说。不管怎么说，你想表达的是，",
                    {"rt2"},
                    "在艺术中赝作与真作有着极为密切的关系吧？」"
                }
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"bg", file = "ev_com_f02_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000811", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「正是如此」"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那么？老爹，能把『横卧之樱』的颜料配方告诉我吗？」"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"bg", file = "ev_com_f02_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000812", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「哦？怎么？你这么快就打算伪造樱七部作了？」"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那是不可能的。现在的我已经没有你培养出来的右手了」"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"bg", file = "ev_com_f02_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_f02/", set = "ev_com_f02"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000813", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「哈哈哈，我培养出来的右手吗，说得还真形象」"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，我到现在还耿耿于怀呢。那个绘画训练矫正器」"
                }
