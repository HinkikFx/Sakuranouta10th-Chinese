        text = {
            vo = {
                {"vo", file = "man_kid_000840", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「你从小就是个有趣的男子人。确实像我,却也拥有我所没有的东西」"
                }
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
