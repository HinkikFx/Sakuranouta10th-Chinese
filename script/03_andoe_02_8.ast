    block_00106 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000814", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「可是嘛。要练成必杀技，秘密特训是不可少的吧？」"
