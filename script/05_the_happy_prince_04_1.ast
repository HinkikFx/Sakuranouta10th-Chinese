    },
    block_00025 = {
        {"fg", ch = "香奈", size = "z2", mode = 3, path = ":fg/kan/z2/", file = "kan_z2a0200", face = "a0018", head = "kan_z2a", lv = 5, id = 9},
        {"text"},
        text = {
