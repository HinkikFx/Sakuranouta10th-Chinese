        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0200", face = "a0010", head = "kan_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000431", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「这我知道。你的手臂已经废了这件事，还有要再现草薙健一郎的",
                    {"rt2"},
                    "笔触是不可能的这件事，我都清楚」"
                }
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那结论不就很明显了吗」"
                }
            }
