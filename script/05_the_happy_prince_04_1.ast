        linkback = "block_00040",
        linknext = "block_00042"
    },
    block_00042 = {
        {"fgact", ch = "香奈", act = "いいえ", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000449", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「不。有才能的话，轻轻松松就能到达那个地方。正因为得来容易，",
