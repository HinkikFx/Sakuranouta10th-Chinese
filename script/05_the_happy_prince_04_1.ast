        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以说，昨天你也亲眼看到了。我没有画出那种画的能力」"
