    },
    block_00043 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000450", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「因为，感觉不到那有什么价值」"
