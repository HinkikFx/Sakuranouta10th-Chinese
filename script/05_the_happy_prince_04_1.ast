        linkback = "block_00090",
        linknext = "block_00092"
    },
    block_00092 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「说什么呢。只要是搞创作的人，多少都会这么想。嘛，敢这么堂",
