        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊啊，我小时候也是拿着这种笔，没完没了地只画○。基本上世",
                    {"rt2"},
