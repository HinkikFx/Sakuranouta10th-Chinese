        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「画出像圆规一样标准的圆，拿着这支笔，被布置的第一个课题就",
