        linkback = "block_00039",
        linknext = "block_00041"
    },
    block_00041 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那不是完全反过来了吗？一般不都是因为没有才能才放弃的吗？」"
