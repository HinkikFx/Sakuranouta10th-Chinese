        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「想什么？」"
                }
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0200", face = "a0009", head = "kan_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000430", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「『樱七相图』究竟是谁的作品」"
                }
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以说，昨天你不是亲眼看到了吗。我没有画出那幅画的能力」"
                }
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0200", face = "a0010", head = "kan_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000431", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「这我明白。你的手臂已经废了，草薙健一郎的笔触也不可能再现，",
                    {"rt2"},
                    "这些我都明白」"
                }
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那结论不是已经有了吗」"
                }
            }
        },
        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"fg", ch = "香奈", size = "z1", mode = 3, path = ":fg/kan/z1/", file = "kan_z1a0200", face = "a0009", head = "kan_z1a", lv = 4, id = 9},
        {"fgact", ch = "香奈", act = "うなづく", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000432", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「是的，结论已经有了」"
                }
            }
        },
        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那就让开……我要迟到了。你不是也得去上学吗？」"
                }
            }
        },
        linkback = "block_00009",
        linknext = "block_00011"
    },
    block_00011 = {
        {"msgoff"},
        {"se", file = "se9004", id = 1},
        {"fg", ch = "香奈", time = 500, sync = 1, mode = -1, lv = 4, id = 9},
        {"fg", ch = "香奈", size = "z2", time = 500, sync = 1, mode = 3, resize = 1, path = ":fg/kan/z2/", file = "kan_z2a0200", face = "a0008", head = "kan_z2a", lv = 5, id = 9},
        {"se", stop = 1, time = 500, id = 1},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000433", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「我的结论是……『樱七相图』，是草薙直哉的作品」"
                }
            }
        },
        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「为什么啊。你不是知道我画不出来吗」"
                }
            }
        },
        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"fgact", ch = "香奈", act = "うなづく", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000434", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「我知道。可是，即便知道这一点，我依然觉得，那是草薙直哉的",
                    {"rt2"},
                    "作品」"
                }
            }
        },
        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「荒唐……」"
                }
            }
        },
        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"fg", ch = "香奈", size = "z2", mode = 3, path = ":fg/kan/z2/", file = "kan_z2a0200", face = "a0005", head = "kan_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000435", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「草薙君，你对自己画出的作品，就不负任何责任吗？」"
                }
            }
        },
        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「对作品……负责？」"
                }
            }
        },
        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"fgact", ch = "香奈", act = "うなづく", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000436", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「是的，那幅作品毫无疑问是草薙直哉的作品。可你却在掩饰这一",
                    {"rt2"},
                    "点」"
                }
            }
        },
        linkback = "block_00016",
        linknext = "block_00018"
    },
    block_00018 = {
        {"fg", ch = "香奈", size = "z2", mode = 3, path = ":fg/kan/z2/", file = "kan_z2a0200", face = "a0018", head = "kan_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000437", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「如果是能满足于虚假答案的人，那倒也无所谓」"
