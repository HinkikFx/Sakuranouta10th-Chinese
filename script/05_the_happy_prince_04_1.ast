        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000449", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「不，有才能的话，轻轻松松就能到达那个位置。因为做起来太容",
