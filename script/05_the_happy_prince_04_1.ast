        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"fgact", ch = "香奈", act = "うなづく", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_knd_000434", ch = "knd"}
            },
            ja = {
                {
                    name = {"香奈"},
                    "「我知道。但是，即便知道这一点，我依然觉得那是草薙直哉的作",
                    {"rt2"},
                    "品」"
                }
            }
        },
        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「真是无聊透了……」"
