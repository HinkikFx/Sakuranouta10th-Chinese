        linkback = "block_00215",
        linknext = "block_00217"
    },
    block_00217 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是那样吗……我搞不太懂。总之,你们自己去好好玩吧」"
