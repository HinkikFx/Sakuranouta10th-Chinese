    block_00170 = {
        {"text"},
        text = {
            ja = {
                {"更进一步说,明石还在留意一周天气预报。"}
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            ja = {
                {"也就是说,地点和行动的日期,范围都缩小了。"}
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不过说起来,你的趣味也够恶劣的。你之所以知道我在调查教会,",
                    {"rt2"},
                    "是因为你自己就知道那座教会有什么名堂吧」"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1b0100", face = "b0015", head = "mak_z1b", lv = 4, id = 4},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001248", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「答对了一半」"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1b0100", face = "b0011", head = "mak_z1b", lv = 4, id = 4},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1b0100", face = "b0001", head = "mak_z1b", lv = 4, id = 4}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_001249", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「那座教会里有什么,我并不知道。只是,我一直在监视明石学长的",
                    {"rt2"},
                    "行动。因为明石学长也像你一样,在教会那边来来往往。跟踪他的时",
                    {"rt2"},
                    "候,碰巧看到了你的身影。仅此而已」"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此,是在跟踪明石啊。嘛,算是正攻法吧」"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0005", head = "mak_z1a", lv = 4, id = 4},
        {"text"},
        delay = {
