                {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0027", head = "mak_z1a", lv = 4, id = 4}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_001250", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「不过靠那种正攻法,那个人可不会露出马脚。跟踪多半也被他发现",
                    {"rt2"},
                    "了……」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「他直觉很敏锐啊,那家伙……该说是像动物一样,还是怎么说……」"
                }
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0026", head = "mak_z1a", lv = 4, id = 4},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0001", head = "mak_z1a", lv = 4, id = 4}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_001251", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「很早以前,明石学长就在调查那座教会了。刚才提到的气球的事,",
                    {"rt2"},
                    "还记得吧?」"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,用充气娃娃气球飞上天那件事?」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0110", face = "a0015", head = "mak_z1a", lv = 4, id = 4},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0110", face = "a0005", head = "mak_z1a", lv = 4, id = 4}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_001252", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「充气娃娃什么的只是幌子。正是那位学长的作风,用来掩饰“本来",
                    {"rt2"},
                    "目的”的“噱头”。真正的目的,是用气球飞上天空」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「怎么,他真想像气球大叔一样,靠气球横渡太平洋吗?」"
