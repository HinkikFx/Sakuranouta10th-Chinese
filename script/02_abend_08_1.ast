        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不，那些东西是画材这一点连确证都没有。更何况那家伙要做的",
                    {"rt2"},
                    "事情本身就完全搞不懂……」"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1d0100", face = "d0005", head = "mak_z1d", lv = 4, id = 4},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001247", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「但",
                    {"txruby", text = "・・・"},
                    "在哪里",
                    {"txruby"},
                    "进行这一点，你应该知道吧？」"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是啊」"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            ja = {
                {"而且，明石还在意周天气预报。"}
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            ja = {
                {"也就是说，地点和行动日期都能缩小范围了。"}
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不过你的趣味也够差的。你知道我在调查教堂的事，不就是因为",
                    {"rt2"},
                    "你自己也知道那个教堂里有什么吧」"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1b0100", face = "b0015", head = "mak_z1b", lv = 4, id = 4},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001248", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「勉强算对」"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1b0100", face = "b0011", head = "mak_z1b", lv = 4, id = 4},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1b0100", face = "b0001", head = "mak_z1b", lv = 4, id = 4}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_001249", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我不知道那个教堂里有什么。只是，我一直在监视明石前辈的行",
                    {"rt2"},
                    "动。明石前辈和你一样经常出入教堂。跟踪的时候恰好看到了你。",
                    {"rt2"},
                    "就是这样」"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此，是在跟踪明石吗，嗯，算是正面手段吧」"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0005", head = "mak_z1a", lv = 4, id = 4},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0027", head = "mak_z1a", lv = 4, id = 4}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_001250", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「那种正面手段，那个人才不会露出什么破绽呢。跟踪大概也被发",
                    {"rt2"},
                    "现了吧……」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那家伙直觉很敏锐啊……与其说是动物性的不如说是……」"
                }
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0026", head = "mak_z1a", lv = 4, id = 4},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0001", head = "mak_z1a", lv = 4, id = 4}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_001251", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「很早以前，明石前辈就在调查那个教堂了。刚才提到的气球的事",
                    {"rt2"},
                    "你还记得吧？」"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊，用充气娃娃气球飞上天那件事吗？」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0110", face = "a0015", head = "mak_z1a", lv = 4, id = 4},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0110", face = "a0005", head = "mak_z1a", lv = 4, id = 4}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_001252", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「充气娃娃什么的不过是摆设。那正是前辈为了掩盖\"真正目的\"而",
                    {"rt2"},
                    "惯用的\"",
                    {"txruby", text = "けれんみ"},
                    "外连味",
                    {"txruby"},
                    "\"，真正的目的是用气球飞上天空」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么，真的像气球大叔一样想用气球横渡太平洋吗？」"
