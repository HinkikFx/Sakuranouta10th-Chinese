        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「话虽如此,这也不能证明那家伙是为了从上方观察教会,才往充气",
