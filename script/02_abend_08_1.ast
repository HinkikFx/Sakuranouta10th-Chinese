        text = {
            vo = {
                {"vo", file = "fem_mkd_001269", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「你真是完全没有看人的眼光呢。那孩子其实很为社团着想的。大",
                    {"rt2"},
                    "家在一起才是弓张美术部——这一点她理解得很透彻」"
                }
            }
