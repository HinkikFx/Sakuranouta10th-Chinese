        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但是，这也不能证明那家伙是为了从上面看教堂才往充气娃娃里",
