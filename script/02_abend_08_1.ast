        linknext = "block_00214"
    },
    block_00214 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1d0100", face = "d0003", head = "mak_z1d", lv = 4, id = 4},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001268", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「不过,优美也希望大家一起去。美术部全员。包括你和圭,当然还",
                    {"rt2"},
                    "有明石学长,连托马斯也算上,她希望全员一起去合宿」"
                }
            }
        },
        linkback = "block_00213",
        linknext = "block_00215"
    },
    block_00215 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「大家一起?不,那真的不可能吧。她不是特别讨厌托马斯吗」"
                }
            }
        },
        linkback = "block_00214",
        linknext = "block_00216"
    },
    block_00216 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1d0100", face = "d0018", head = "mak_z1d", lv = 4, id = 4},
        {"text"},
        delay = {
