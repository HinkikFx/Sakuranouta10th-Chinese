    block_00167 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,连那些是画材的确证都没有。说到底,那家伙想干什么,我完全",
                    {"rt2"},
                    "摸不着头脑……」"
                }
