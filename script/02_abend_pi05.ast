    block_00044 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0900", face = "a0001", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001372", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「那玩意儿啊,不费什么事。鹭鸶这东西,都是银河的沙子凝聚起来,",
                    {"rt2"},
                    "朦朦胧胧生成的,所以总是不停地要回到河里去,」"
                }
            }
        },
        linkback = "block_00043",
        linknext = "block_00045"
    },
    block_00045 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0900", face = "a0026", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001373", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「在河滩上等着,趁鹭鸶们把脚这么伸着落下来、还没沾到地面的那",
                    {"rt2"},
                    "一瞬间,啪地一把按住。这么一来,鹭鸶就凝固了,安心地死掉了。」"
                }
            }
        },
        linkback = "block_00044",
        linknext = "block_00046"
    },
    block_00046 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0900", face = "a0001", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001374", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「剩下的嘛,不用说您也明白。做成压叶就行了。」"
                }
            }
        },
        linkback = "block_00045",
        linknext = "block_00047"
    },
    block_00047 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0900", face = "a0027", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001375", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「把鹭鸶做成压叶吗。是做标本吗。」"
                }
            }
        },
        linkback = "block_00046",
        linknext = "block_00048"
    },
    block_00048 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0900", face = "a0001", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001376", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「不是标本。大家不都是拿来吃的吗。」"
                }
            }
        },
        linkback = "block_00047",
        linknext = "block_00049"
    },
    block_00049 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0900", face = "a0002", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001377", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「『真奇怪呀。』柯贝内拉歪起了头。」"
                }
            }
        },
        linkback = "block_00048",
        linknext = "block_00050"
    },
    block_00050 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0900", face = "a0028", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001378", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「『没什么奇怪不奇怪的。您瞧。』那男子人站起身,从行李架上取",
                    {"rt2"},
                    "下包袱,麻利地骨碌骨碌解开了。」"
                }
            }
        },
        linkback = "block_00049",
        linknext = "block_00051"
    },
    block_00051 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0900", face = "a0029", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001379", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「来,请看吧。这是刚刚才捕来的。」"
                }
            }
        },
        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0900", face = "a0003", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001380", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「『真的是鹭鸶啊。』两人不由得叫出了声。」"
                }
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0900", face = "a0002", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001381", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「雪白的、像方才北边那十字架一样闪着光的鹭鸶的身体,约有十来",
                    {"rt2"},
                    "只,微微压得扁平,蜷着黑色的脚,如浮雕一般排列在那里。」"
                }
            }
        },
        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0910", face = "a0002", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001382", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「『眼睛闭着呢。』柯贝内拉用手指轻轻碰了碰鹭鸶那新月形的、",
                    {"rt2"},
                    "闭合的白色眼睛。头顶上那长枪似的白色羽毛也好端端地留着。」"
                }
            }
        },
        linkback = "block_00053",
        linknext = "block_00055"
    },
    block_00055 = {
        {"text"},
        text = {
            ja = {
                {
                    "指尖捏着的小小白鹭砂糖点心,微微地闪闪发光,那新月形的闭合白",
                    {"rt2"},
                    "眼,和头顶长枪似的白毛,都被一一重现了出来。"
                }
            }
        },
        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"text"},
        text = {
            ja = {
                {
                    "放入口中,它便如融雪般在舌尖倏然消散。那是与平日吃惯的砂糖截",
                    {"rt2"},
                    "然不同的、清澈透明的甜。"
                }
            }
        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1d0900", face = "d0002", head = "mak_z1d", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001383", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我想着,放进咖啡里应该也很好喝」"
                }
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1d0900", face = "d0004", head = "mak_z1d", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001384", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「就像给咖啡配上曲奇或巧克力那样,这阵子我打算拿它当附赠的小",
                    {"rt2"},
                    "点心」"
                }
            }
        },
        linkback = "block_00057",
        linknext = "block_00059"
    },
    block_00059 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1d0900", face = "d0001", head = "mak_z1d", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001385", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「这稀少糖也是,店长他呀,喜欢黑,也喜欢白,所以总像这样寄来各种",
                    {"rt2"},
                    "各样白色的东西」"
                }
            }
        },
        linkback = "block_00058",
        linknext = "block_00060"
    },
    block_00060 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1d0900", face = "d0002", head = "mak_z1d", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001386", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「于是,我自然而然地,用白色釉药的机会也越来越多了」"
                }
            }
        },
        linkback = "block_00059",
        linknext = "block_00061"
    },
    block_00061 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1d0900", face = "d0011", head = "mak_z1d", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001387", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「就算被人称作『兔子白』,那也是从店长寄来的沙子和石头里诞生",
                    {"rt2"},
                    "的釉药,我所做的,不过是微不足道的一点罢了」"
                }
            }
        },
        linkback = "block_00060",
        linknext = "block_00062"
    },
    block_00062 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「可是,实际动手做的是你。要是没有你,店长寄来的东西,也终究只",
                    {"rt2"},
                    "是些沙子和石头而已」"
                }
            }
        },
        linkback = "block_00061",
        linknext = "block_00063"
    },
    block_00063 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1b0900", face = "b0008", head = "mak_z1b", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001388", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「是呢。这一点我承认」"
                }
            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1b0900", face = "b0001", head = "mak_z1b", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001389", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「……再也弄不到手了。用再也不会寄来的稀少糖做的砂糖点心,真",
                    {"rt2"},
                    "真正正的一期一会呢」"
                }
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1b0900", face = "b0002", head = "mak_z1b", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001390", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「像这样再也弄不到的石头和沙子还有很多……那样的话,做孤品倒",
                    {"rt2"},
                    "是无妨,但作为我的商品可就不妙了」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「石头和沙子……釉药的原材料吗」"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0910", face = "a0001", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001391", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「在那些再也弄不到的原材料里,有一种沙子尤其让我难以忘怀」"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0910", face = "a0027", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001392", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「鹭鸶从桔梗色的天空中如雪片般飘落的、银河的河滩……店长他,",
                    {"rt2"},
                    "曾经去过一次和那一模一样的地方哦」"
                }
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0910", face = "a0005", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001393", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「落在银河沙滩上的鹭鸶们,一触即融的白色鸟儿们,还有夜里泛着",
                    {"rt2"},
                    "淡淡白光的河滩之沙……」"
                }
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0910", face = "a0008", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001394", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「因为实物都寄来了,我不会说那种地方不存在……可是,再也弄不到",
                    {"rt2"},
                    "了,连那是个什么样的地方都无从知晓」"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0910", face = "a0011", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001395", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「他本人也试着去了好几次,却再也到不了。连自己写下的提示都派",
                    {"rt2"},
                    "不上用场,那可真是没辙了」"
                }
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊——……他说过自己是路痴来着」"
                }
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0900", face = "a0015", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001396", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「草薙你也是,不过店长也够呛哦。他连去自己就读的学园都常常迷",
                    {"rt2"},
                    "路呢」"
                }
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「亏他还能四处流浪而安然无恙……」"
                }
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0900", face = "a0002", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001397", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「奔着目标农园去,结果买回来的却是完全不同地方的咖啡,这对他",
                    {"rt2"},
                    "是家常便饭。而且光在日本还不满足,满世界地乱转……」"
                }
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那他还真亏能回到奇美拉来」"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0900", face = "a0016", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001398", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「据说都是在没打算回来的时候,不知不觉就到家了」"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0900", face = "a0012", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001399", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「啊,对了。我还做了糖,要吃吗?」"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, resize = 1, path = ":fg/mak/z2/", file = "mak_z2d0900", face = "d0002", head = "mak_z2d", lv = 5, id = 9},
        {"fgact", ch = "真琴", act = "うなづく", lv = 5, id = 9},
        {"se", file = "se9010", id = 1},
        {"text"},
        text = {
            ja = {
                {
                    "鸟谷拿出装在小篮里的糖给我看。透明糖纸包着的,是浅黄色的、纽",
                    {"rt2"},
                    "扣似的糖块。"
                }
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「琥珀糖啊」"
                }
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z2/", file = "mak_z2d0900", face = "d0003", head = "mak_z2d", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001400", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「对。这个也是连模具都自己做的哦」"
                }
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
    block_00082 = {
        {"mwact", act = "びっくり"},
        {"text"},
        text = {
            ja = {
