        linkback = "block_00025",
        linknext = "block_00027"
    },
    block_00027 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_yod_000083", ch = "yod"}
            },
            ja = {
                {
                    name = {"义贞"},
