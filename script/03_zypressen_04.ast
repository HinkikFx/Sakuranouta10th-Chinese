        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0002", head = "nao_z2a", lv = 5, id = 9},
        {"fgact", ch = "直哉", act = "いいえ", time = 300, size = 5, lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这问题拿来问画画的人,可就蠢到家了。因为答案本身,我已经画",
                    {"rt2"},
                    "成了画」"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001863", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我看过那幅画」"
                }
            }
