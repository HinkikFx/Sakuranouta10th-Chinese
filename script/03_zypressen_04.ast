    },
    block_00186 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001869", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「可是,那个台风夜。把里奈的丝柏之画瞬间变成樱花之画,是在『",
                    {"rt2"},
                    "樱日狂想』发表之后」"
                }
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0010", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「……」"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
