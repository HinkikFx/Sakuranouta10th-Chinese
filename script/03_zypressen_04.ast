        linknext = "block_00241"
    },
    block_00241 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001900", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那段时间，口口声声说涂鸦到处画了一堆半成品，不就是因为痛",
                    {"rt2"},
                    "切地认识到自己的手已经不行了吗？」"
                }
            }
        },
        linkback = "block_00240",
        linknext = "block_00242"
    },
    block_00242 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001901", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「画了又画，却怎么也不行。所以连完成都做不到，只是徒劳地到",
                    {"rt2"},
                    "处涂画」"
                }
            }
        },
        linkback = "block_00241",
        linknext = "block_00243"
    },
    block_00243 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001902", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「虽然是这副模样，但因为讨厌前辈你，我对前辈的作品做了相当",
