    block_00161 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0010", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
