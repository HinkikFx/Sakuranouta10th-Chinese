                    "「结果禀那家伙,气得不行……」"
                }
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0009", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「其实我哼的时候,也没弄懂什么深意……」"
                }
            }
        },
        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0001", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「可是,禀为什么会那么生气呢」"
                }
            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0008", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「而我,又为什么会在那种时候,念出那首诗呢」"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0010", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就这样,后来我把那首诗翻来覆去地想了好多遍」"
                }
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0019", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「中原中也在痛失爱子的时候,为什么会写下那么古怪的一首诗呢—",
                    {"rt2"},
                    "—诸如此类」"
                }
            }
        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001860", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「古怪吗？」"
                }
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0002", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那当然。开头倒是起得庄重」"
                }
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0010", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那么诸位,莫要太喜,莫要太悲,合着节拍,来握手吧」"
                }
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0001", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「也就是说,我等所欠缺的,乃是实直云云,如此领会」"
                }
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0010", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「来,那么诸位,来,一起——合着节拍,来握手吧」"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0018", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「——就是以这样收尾的一首诗哦」"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001861", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「即便如此,学长还是画了一幅以那首诗为念的画」"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0017", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「何止是有所意识,我一直在想它」"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0008", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「为什么这首诗,会这样打动我的心……」"
                }
            }
