        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001865", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「学长是在母亲之死那样绝望的境况里,选择了奉献之心……。选择",
                    {"rt2"},
                    "了灭私吗？」"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0016", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「灭私？　我？　现在的我看着像吗？」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001866", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
