                {
                    name = {"优美"},
                    "「是,看着就像。『樱花们的足迹』不也是吗。就算完成那种东西,",
                    {"rt2"},
                    "你也捞不到任何好处」"
                }
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0002", head = "nao_z2a", lv = 5, id = 9},
        {"fgact", ch = "直哉", act = "いいえ", time = 300, size = 5, lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,那件事对我来说可是天上掉馅饼。托它的福我成了名人。真正",
                    {"rt2"},
                    "称得上奉献,灭私的,是明石」"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001880", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「是吗？　那件作品完成之后,看起来最痛苦的,分明是学长吧？」"
                }
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0017", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我？　说什么傻话……」"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001881", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「作品为何而生,为何而作……」"
                }
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001882", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我们为了什么而创作……只要不迷失这一点,就没有问题……。哪怕",
                    {"rt2"},
                    "铭刻在那里的,并不是自己的名字……」"
                }
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001883", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「明石学长对你这么说过,对吧」"
                }
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0014", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你怎么会知道这些」"
                }
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001884", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「因为我窃听了」"
                }
            }
        },
        linkback = "block_00212",
        linknext = "block_00214"
    },
    block_00214 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0007", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「窃听？」"
                }
            }
        },
        linkback = "block_00213",
        linknext = "block_00215"
    },
    block_00215 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001885", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「是的,因为我当时既不信任你,也不信任明石学长,就在明石学长的",
                    {"rt2"},
                    "大衣里装了窃听器」"
                }
            }
        },
        linkback = "block_00214",
        linknext = "block_00216"
    },
    block_00216 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0017", head = "nao_z2a", lv = 5, id = 9},
        {"fgact", ch = "直哉", act = "おじぎ", time = 500, size = 5, lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那个蠢货……」"
                }
            }
        },
        linkback = "block_00215",
        linknext = "block_00217"
    },
    block_00217 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001886", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我当时想着,你们要是说了对里奈不利的话,我就杀了你们」"
                }
            }
        },
        linkback = "block_00216",
        linknext = "block_00218"
    },
    block_00218 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001887", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「可是,从你们嘴里听到的,却尽是奉献精神……」"
                }
            }
        },
        linkback = "block_00217",
        linknext = "block_00219"
    },
    block_00219 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0011", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「奉献奉献,都说了我又不是在做什么义工」"
                }
            }
        },
        linkback = "block_00218",
        linknext = "block_00220"
    },
    block_00220 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001888", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「在我看来就是义工」"
                }
            }
        },
        linkback = "block_00219",
        linknext = "block_00221"
    },
    block_00221 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0005", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「话说回来,你自己不也帮忙了吗」"
                }
            }
        },
        linkback = "block_00220",
        linknext = "block_00222"
    },
    block_00222 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001889", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那是因为里奈帮了忙」"
                }
            }
        },
        linkback = "block_00221",
        linknext = "block_00223"
    },
    block_00223 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001890", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「而且,把里奈和禀学姐卷进危险里的你们,说实话,我恨着呢」"
                }
            }
        },
        linkback = "block_00222",
        linknext = "block_00224"
    },
    block_00224 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0017", head = "nao_z2a", lv = 5, id = 9},
        {"fgact", ch = "直哉", act = "おじぎ", time = 500, size = 5, lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我可真是没少被你恨啊」"
                }
            }
        },
        linkback = "block_00223",
        linknext = "block_00225"
    },
    block_00225 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001891", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「是的,我恨你」"
                }
            }
        },
        linkback = "block_00224",
        linknext = "block_00226"
    },
    block_00226 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001892", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「而我最恨的那份所谓奉献之心,就是把丝柏变成樱花的那幅画」"
                }
            }
        },
        linkback = "block_00225",
        linknext = "block_00227"
    },
    block_00227 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0016", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那丝柏？」"
                }
            }
        },
        linkback = "block_00226",
        linknext = "block_00228"
    },
    block_00228 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001893", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「里奈画的那幅丝柏壁画。你把它变成了樱花盛开的画」"
                }
            }
        },
        linkback = "block_00227",
        linknext = "block_00229"
    },
    block_00229 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0014", head = "nao_z2a", lv = 5, id = 9},
        {"fgact", ch = "直哉", act = "いいえ", time = 300, size = 5, lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,那是因为我画得开心啊」"
                }
            }
        },
        linkback = "block_00228",
        linknext = "block_00230"
    },
    block_00230 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001894", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「丝柏公园的画。和里奈的合作。学长,你说你乐在其中,那是骗人",
                    {"rt2"},
                    "的吧」"
                }
            }
        },
        linkback = "block_00229",
        linknext = "block_00231"
    },
    block_00231 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0007", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「哈？」"
                }
            }
        },
        linkback = "block_00230",
        linknext = "block_00232"
    },
    block_00232 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0011", head = "nao_z2a", lv = 5, id = 9},
        {"fgact", ch = "直哉", act = "いいえ", time = 300, size = 7, lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不是不是,怎么就成骗人了？　那时候我确实说过“很开心”吧？」"
                }
            }
        },
        linkback = "block_00231",
        linknext = "block_00233"
    },
    block_00233 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001895", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「是,你说了。说得特别刻意」"
                }
            }
        },
        linkback = "block_00232",
        linknext = "block_00234"
    },
    block_00234 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0017", head = "nao_z2a", lv = 5, id = 9},
        {"fgact", ch = "直哉", act = "おじぎ", time = 500, size = 5, lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「刻意……这话可真让我意外啊？」"
                }
            }
        },
        linkback = "block_00233",
        linknext = "block_00235"
    },
    block_00235 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001896", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「是吗？　可是画那幅画,你其实相当痛苦吧？」"
                }
            }
        },
        linkback = "block_00234",
        linknext = "block_00236"
    },
    block_00236 = {
        {"fg", ch = "直哉", size = "z2", mode = 3, path = ":fg/nao/z2/", file = "nao_z2a0100", face = "a0001", head = "nao_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「为什么这么想？」"
                }
            }
        },
        linkback = "block_00235",
        linknext = "block_00237"
    },
    block_00237 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001897", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「学长在『樱日狂想』之后,是在某个时间点上,惯用手出了问题吧」"
                }
            }
        },
        linkback = "block_00236",
        linknext = "block_00238"
    },
    block_00238 = {
        {"fg", ch = "直哉", size = "z1", mode = 3, resize = 1, path = ":fg/nao/z1/", file = "nao_z1a0100", face = "a0008", head = "nao_z1a", lv = 4, id = 9},
        {"fgact", ch = "直哉", act = "びっくり", lv = 4, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「！？」"
                }
            }
        },
        linkback = "block_00237",
        linknext = "block_00239"
    },
    block_00239 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001898", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那之后,我把『樱日狂想』看了一遍又一遍,所以看得出来」"
                }
            }
        },
        linkback = "block_00238",
        linknext = "block_00240"
    },
    block_00240 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001899", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「学长不是封笔,而是惯用手出了毛病。原因我不清楚。我只知道,",
                    {"rt2"},
                    "从那以后,学长再也画不出同样的画了」"
                }
            }
        },
        linkback = "block_00239",
        linknext = "block_00241"
    },
    block_00241 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001900", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那段时间,你嘴上说什么涂鸦艺术,到处乱画些半途而废的画,不就",
                    {"rt2"},
                    "是因为切身体会到自己这只手已经不行了吗？」"
                }
            }
        },
        linkback = "block_00240",
        linknext = "block_00242"
    },
    block_00242 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001901", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「画了又画,却怎么也无济于事。所以才一幅都完成不了,只是徒劳",
                    {"rt2"},
                    "地四处涂抹,不是吗？」"
                }
            }
        },
        linkback = "block_00241",
        linknext = "block_00243"
    },
    block_00243 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001902", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「别看我这样,正因为最讨厌学长,我把学长的作品查了个遍。还曾",
                    {"rt2"},
                    "四处寻访过你当年画下的那些涂鸦」"
                }
            }
        },
        linkback = "block_00242",
        linknext = "block_00244"
    },
    block_00244 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001903", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我找到的,全都是未完成的」"
                }
            }
        },
        linkback = "block_00243",
        linknext = "block_00245"
    },
    block_00245 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001904", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「而且那些画,分明都带着『樱日狂想』的影子,却又完全不是一回",
                    {"rt2"},
                    "事」"
                }
            }
        },
        linkback = "block_00244",
        linknext = "block_00246"
    },
    block_00246 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001905", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「明明想着自己过去的画,画出来的却是截然不同的东西——那种焦",
                    {"rt2"},
                    "躁,隔着画面都传到了我这里」"
                }
            }
        },
        linkback = "block_00245",
        linknext = "block_00247"
    },
    block_00247 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001906", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「为什么会这样呢？」"
                }
            }
        },
        linkback = "block_00246",
        linknext = "block_00248"
    },
    block_00248 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001907", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「答案没有几个。那个时期,草薙学长已经画不出与『樱日狂想』相",
                    {"rt2"},
                    "同的画了」"
                }
            }
        },
        linkback = "block_00247",
        linknext = "block_00249"
    },
    block_00249 = {
        {"fg", ch = "直哉", size = "z1", mode = 3, path = ":fg/nao/z1/", file = "nao_z1a0100", face = "a0017", head = "nao_z1a", lv = 4, id = 9},
        {"fgact", ch = "直哉", act = "おじぎ", time = 500, size = 7, lv = 4, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「差到连不画画的家伙都看得出来,是吗……」"
                }
            }
        },
        linkback = "block_00248",
        linknext = "block_00250"
    },
    block_00250 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001908", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「即便如此,那次合作,与里奈合作之时,你的笔法却直逼全盛期」"
                }
            }
        },
        linkback = "block_00249",
        linknext = "block_00251"
    },
    block_00251 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001909", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「反过来我倒觉得,若是完成『樱日狂想』时的草薙直哉,要压倒里",
                    {"rt2"},
                    "奈的画,一个晚上就绰绰有余」"
                }
            }
        },
        linkback = "block_00250",
        linknext = "block_00252"
    },
    block_00252 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001910", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「草薙直哉这份才能,本该就是那样压倒性的存在」"
                }
