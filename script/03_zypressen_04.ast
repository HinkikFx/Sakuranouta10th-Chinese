        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001862", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那草薙学长得到的答案是什么？」"
                }
