    },
    block_00279 = {
        {"fg", ch = "直哉", size = "z1", mode = 3, path = ":fg/nao/z1/", file = "nao_z1a0100", face = "a0010", head = "nao_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「画的画可真郁闷啊。真讨厌啊。想改成更明亮的画啊……。当时",
