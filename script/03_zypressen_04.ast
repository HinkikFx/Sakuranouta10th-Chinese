        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001872", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「是吗？　在我看来,那更像是为了找回手感,拼命把各种地方当成",
