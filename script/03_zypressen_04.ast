    block_00239 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001898", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那之后我反反复复看了很多遍『樱日狂想』，所以看得出来」"
