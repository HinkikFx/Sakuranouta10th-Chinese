    },
    block_00010 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_uzn_000004", ch = "uzn"}
            },
            ja = {
                {
                    name = {"宇纲"},
                    "「嗯。只是有些许不安」"
                }
            }
        },
        linkback = "block_00009",
        linknext = "block_00011"
    },
    block_00011 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_yod_000076", ch = "yod"}
            },
            ja = {
                {
                    name = {"义贞"},
                    "「不安？　为何事不安呢」"
                }
            }
        },
        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_uzn_000005", ch = "uzn"}
            },
            ja = {
                {
                    name = {"宇纲"},
                    "「自那场仪式以来,兄长对方相氏,似乎入迷得过了头啊」"
                }
            }
        },
        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_yod_000077", ch = "yod"}
            },
            ja = {
                {
                    name = {"义贞"},
                    "「确实,那之后他多次将其召入城中呢」"
                }
            }
        },
        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_uzn_000006", ch = "uzn"}
            },
            ja = {
                {
                    name = {"宇纲"},
                    "「嗯。听说他还想再让他们行一次傩仪」"
                }
            }
        },
        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_yod_000078", ch = "yod"}
            },
            ja = {
                {
                    name = {"义贞"},
                    "「还要再办吗？　若父亲大人能因此心安,倒也未尝不可……」"
                }
            }
        },
        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_uzn_000007", ch = "uzn"}
            },
            ja = {
                {
                    name = {"宇纲"},
                    "「话虽如此……可对方毕竟是方相氏啊」"
                }
            }
        },
        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_yod_000079", ch = "yod"}
            },
            ja = {
                {
                    name = {"义贞"},
                    "「能让叔父大人如此不安的那一族,究竟是什么来历？」"
                }
            }
        },
        linkback = "block_00016",
        linknext = "block_00018"
    },
    block_00018 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_uzn_000008", ch = "uzn"}
            },
            ja = {
                {
                    name = {"宇纲"},
                    "「听闻方相氏乃是典药寮咒禁博士的后裔」"
                }
            }
        },
        linkback = "block_00017",
        linknext = "block_00019"
    },
    block_00019 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_yod_000080", ch = "yod"}
            },
            ja = {
                {
                    name = {"义贞"},
                    "「那又是什么？」"
                }
            }
        },
        linkback = "block_00018",
        linknext = "block_00020"
    },
    block_00020 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_uzn_000009", ch = "uzn"}
            },
            ja = {
                {
                    name = {"宇纲"},
                    "「义贞殿不知晓也在情理之中……典药寮是早已废绝的机构,隶属宫",
                    {"rt2"},
                    "内省,司掌医疗调药」"
                }
            }
        },
        linkback = "block_00019",
        linknext = "block_00021"
    },
    block_00021 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_uzn_000010", ch = "uzn"}
            },
            ja = {
                {
                    name = {"宇纲"},
                    "「典药寮由医师,针师,按摩师以及咒禁师构成。而这咒禁师一族的",
                    {"rt2"},
                    "后裔,据说便是方相氏」"
                }
            }
        },
        linkback = "block_00020",
        linknext = "block_00022"
    },
    block_00022 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_yod_000081", ch = "yod"}
            },
            ja = {
                {
                    name = {"义贞"},
                    "「医术,针术……还有按摩……,是医疗方面的机构吗？　那种地方竟",
                    {"rt2"},
                    "也设有祈祷师啊」"
                }
            }
        },
        linkback = "block_00021",
        linknext = "block_00023"
    },
    block_00023 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_uzn_000011", ch = "uzn"}
            },
            ja = {
                {
                    name = {"宇纲"},
                    "「因为人的身体,同样遵循五行之理啊」"
                }
            }
        },
        linkback = "block_00022",
        linknext = "block_00024"
    },
    block_00024 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_yod_000082", ch = "yod"}
            },
            ja = {
                {
                    name = {"义贞"},
                    "「也就是说,方相氏早已被逐出了那个地位？」"
                }
            }
        },
        linkback = "block_00023",
        linknext = "block_00025"
    },
    block_00025 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_uzn_000012", ch = "uzn"}
            },
            ja = {
                {
                    name = {"宇纲"},
                    "「正是。据说咒禁博士之位,后来因阴阳道太史局的抬头而遭废止」"
                }
            }
        },
        linkback = "block_00024",
        linknext = "block_00026"
    },
    block_00026 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_uzn_000013", ch = "uzn"}
            },
            ja = {
                {
                    name = {"宇纲"},
                    "「咒禁道与阴阳道本是同类咒术……一方受到登用,另一方便会没落」"
                }
            }
