    },
    block_00135 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001429", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「一脸‘什么时候开始的?’的表情呢。很早以前就知道了哦。应该说,",
                    {"rt2"},
                    "查明部费被挪用的那个时候就已经知道了。因为我把所有的交货单",
                    {"rt2"},
                    "都查过了……」"
                }
            }
        },
        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000489", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「从一开始就知道了吗……。老夫简直像个小丑」"
                }
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"fg", mode = -2},
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0005", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001430", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「看来,花了不少钱呢。所以才落到连部费都要挪用的地步」"
                }
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"fg", ch = "真琴", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0006", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001431", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「什么存起来了、什么打了柏青哥,全是谎话。为了完成这座教堂的",
                    {"rt2"},
                    "改造,你需要钱。可尽管如此,你却什么都不肯商量。满口谎言……」"
                }
            }
        },
        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「呼……」"
                }
            }
