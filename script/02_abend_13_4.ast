    block_00135 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_001429", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「从什么时候开始的？——你脸上写着这个问题呢。很早以前就发现",
                    {"rt2"},
                    "了。从发现你挪用社费的时候就知道了。因为我查了所有的送货单",
