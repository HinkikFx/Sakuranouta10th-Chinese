        linknext = "block_00332"
    },
    block_00332 = {
        {"text"},
        text = {
            ja = {
                {"一直在这里打扫的神父一定对这番景象再熟悉不过了。"}
            }
        },
        linkback = "block_00331",
        linknext = "block_00333"
    },
    block_00333 = {
        {"text"},
        text = {
            ja = {
                {"那些脚印如同樱花花瓣一般散落着。"}
            }
        },
        linkback = "block_00332",
        linknext = "block_00334"
    },
    block_00334 = {
        {"text"},
        text = {
            ja = {
                {"留下脚印的人消失了……"}
