                {"vo", file = "man_wtd_000224", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「没错。两者之中,请挑一个你喜欢的!」"
                }
            }
        },
        linkback = "block_00093",
        linknext = "block_00095"
    },
    block_00095 = {
        {"bg", file = "ev_com_a28_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000039", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「不,既然已经招供了,明石也同罪」"
                }
            }
        },
        linkback = "block_00094",
        linknext = "block_00096"
    },
    block_00096 = {
        {"mwact", act = "うんうん", size = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000225", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「呜哇——。饶了我吧——」"
                }
            }
        },
        linkback = "block_00095",
        linknext = "block_00097"
    },
    block_00097 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000040", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「怎么可能饶你。你以为这是第几次了。去年秋天抱着个奇怪的人",
                    {"rt2"},
                    "偶飞上天闹得满城风雨,前不久还把走廊的地板弄成镜子,好让女生",
                    {"rt2"},
                    "的内裤被看光……」"
                }
            }
        },
        linkback = "block_00096",
        linknext = "block_00098"
    },
    block_00098 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000226", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「才不是什么奇怪的人偶!　那是爱之枕!」"
                }
            }
        },
        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"bg", file = "ev_com_a28_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000017", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「LovePillow?　是爱的枕头的意思吗?」"
                }
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_000778", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「嘛,就是充气娃娃吧……」"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000227", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「爱之枕·平木镜○酱才不是什么充气娃娃!她是吾最爱的妻子之一」"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"bg", file = "ev_com_a28_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000041", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「你到底有几个最爱啊……而且其中之一还是充气娃娃……」"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_000779", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「在那之前,给充气娃娃起名字这件事本身就……」"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000018", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「这不是挺好的吗,爱惜物品是件好事哦」"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_000780", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「说起来,那次飞行不是失败骨折了吗。坠落的那一瞬间,我还以为",
                    {"rt2"},
                    "学长要死了呢」"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000228", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「嘛,搞艺术就需要这种觉悟嘛——。老夫可是赌上性命在进行艺术",
                    {"rt2"},
                    "活动的呀——」"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"bg", file = "ev_com_a28_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000042", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「比起你的伤,你坠落到附近的住宅区砸坏人家屋顶这件事才是大问",
                    {"rt2"},
                    "题!」"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000229", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「那,那倒是……不过我可是好好赔偿了的……」"
                }
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000230", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「还有,还有啊!　我不是把地板弄成了镜子!　而是把它研磨得如镜",
                    {"rt2"},
                    "子一般!」"
                }
            }
        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000043", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「那不是一回事吗!」"
                }
            }
        },
        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_000781", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「话说回来,那台业务用的研磨机你到底是从哪儿弄来的啊。有一天",
                    {"rt2"},
                    "走廊突然被磨得像镜子一样,连我都吓了一大跳」"
                }
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000231", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「因为艺术需要它!　需要的东西就必须弄到手!　所以老夫不过是",
                    {"rt2"},
                    "弄来了一台业务用研磨机罢了」"
                }
            }
        },
        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"bg", file = "ev_com_a28_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000044", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「做出能偷窥女生内裤的地板,这算哪门子艺术啊……」"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_000782", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「嘛,实际上,现代艺术里确实有过那样的作品呢。整个地板全是镜",
                    {"rt2"},
                    "子的那种……」"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000045", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「啊,是吗。光听这个,现代艺术就不像什么正经玩意儿呢」"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"mwact", act = "びっくり"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000232", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「但艺术就是艺术!　哪怕它看起来是反社会的!　不!　艺术有时正",
                    {"rt2"},
                    "可以成为反社会之物!　哪怕被大众投以白眼,艺术家也必须抱着与",
                    {"rt2"},
                    "美殉情的觉悟去做!」"
                }
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"bg", file = "ev_com_a28_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000046", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「那么,就请你先为了艺术去接受退学处分吧」"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"mwact", act = "うんうん", size = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000233", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「所以说为什么啊!　这里不是应该原谅我的地方吗!　人家可是为",
                    {"rt2"},
                    "了艺术才做的啊——」"
                }
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"bg", file = "ev_com_a28_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000047", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「什么为什么,没得商量!　你不就是抱着这点觉悟,才去搞那什么艺",
                    {"rt2"},
                    "术活动的吗!　罚就是罚!　罪就是罪!　你的艺术价值我不懂,但违规",
                    {"rt2"},
                    "就是违规!　罪要拿来偿还」"
                }
            }
        },
        linkback = "block_00118",
        linknext = "block_00120"
    },
    block_00120 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000234", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「呜呼哀哉呀——。念了三年多的书,到头来竟是退学……」"
                }
            }
        },
        linkback = "block_00119",
        linknext = "block_00121"
    },
    block_00121 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000048", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「那是我要说的台词!　你到现在都没被退学才叫不可思议!」"
                }
            }
        },
        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"bgm", stop = 1, time = 100},
        {"bgm", file = "bgm031"},
        {"bg", file = "ev_com_a28_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000019", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「哎呀?」"
                }
            }
        },
        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"bg", file = "ev_com_a28_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000020", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「不行呢,小沙智同学」"
                }
            }
        },
        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000049", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「是?」"
                }
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000021", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「这份问询记录……。没有写明是从几年几班的哪位同学那里取得",
                    {"rt2"},
                    "的哦」"
                }
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"bg", file = "ev_com_a28_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000050", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「诶?　没写吗?」"
                }
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000022", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「是的,没有写」"
                }
            }
        },
        linkback = "block_00126",
        linknext = "block_00128"
    },
    block_00128 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000051", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「诶,可是」"
                }
            }
        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000023", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「这样的话,与其说是问询记录,不如说只是普通的备忘录。完全看",
                    {"rt2"},
                    "不出是谁说了什么」"
                }
            }
        },
        linkback = "block_00128",
        linknext = "block_00130"
    },
    block_00130 = {
        {"bg", file = "ev_com_a28_09", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000052", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「可、可是!　还有视频网站上的留言啊」"
                }
            }
        },
        linkback = "block_00129",
        linknext = "block_00131"
    },
    block_00131 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000024", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「关于那个,你有证据证明视频网站上的留言是美术部部员写的吗?」"
                }
            }
        },
        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000053", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「那、那倒是没有,可是,会在网上发美术部宣传的,除了美术部部员",
                    {"rt2"},
                    "不作他想吧」"
                }
            }
        },
        linkback = "block_00131",
        linknext = "block_00133"
    },
    block_00133 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000025", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「是吗?　假如真是宣传,他们会把记录留在那里吗?这可是败露了就",
                    {"rt2"},
                    "要退学的大骚动。很难想象当事人会特意留下记录呢」"
                }
            }
        },
        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000054", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「可、可是,留言里写的事情确实发生了,这是事实!」"
                }
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000026", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「是吗?　这些留言里可没有写喷射灭火器把室内弄得一片雪白之",
                    {"rt2"},
                    "类的事哦」"
                }
            }
        },
        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000055", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「那、那大概是为了营造突发性效果的活动环节……」"
                }
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000027", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「是那样吗?　在我看来,是发生了某种意外,才演变成了那副局面。",
                    {"rt2"},
                    "恐怕是发生了与鸟谷部长和明石前部长的意愿无关的什么事,才会闹",
                    {"rt2"},
                    "成那样」"
                }
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"bg", file = "ev_com_a28_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000056", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「那、那只是假设吧。什么看起来像是发生了某种意外」"
                }
            }
        },
        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000028", ch = "kmd"}
