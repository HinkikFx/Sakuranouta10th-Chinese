        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000041", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「怎么就不可信了」"
