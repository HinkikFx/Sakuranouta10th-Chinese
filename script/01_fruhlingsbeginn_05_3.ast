        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000001", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧", "学生会长"},
                    "「那么，关于本次事件，就在今年度弓张学友会的部费会议之前处",
                    {"rt2"},
                    "理掉吧」"
                }
            }
        },
        linknext = "block_00001"
    },
    block_00001 = {
        {"bg", file = "ev_com_a28_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000003", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智", "副会长"},
                    "「不，这件事不归学生会管辖！应该立即向老师报告，采取适当的",
                    {"rt2"},
                    "处分」"
                }
            }
        },
        linkback = "block_00000",
        linknext = "block_00002"
    },
    block_00002 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000002", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧", "学生会长"},
                    "「可是这件事是交到学生会来的呀」"
                }
            }
