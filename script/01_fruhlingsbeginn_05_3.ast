        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000208", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「纵使无人传唤,我亦在此!　故而世界存在!　因为我就是世界」"
                }
            }
