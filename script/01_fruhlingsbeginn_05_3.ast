        {"bg", file = "ev_com_a28_01", time = 1500, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"bgm", file = "bgm031"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000001", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧", "学生会长"},
                    "「那么,本案就在今年度弓张学友会的部费会议之前处理完毕吧」"
                }
            }
        },
        linknext = "block_00001"
    },
    block_00001 = {
        {"bg", file = "ev_com_a28_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000003", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智", "副会长"},
                    "「不行,这不在学生会的管辖范围之内!　我认为应当立刻报告老师,",
                    {"rt2"},
                    "采取相应的处置措施」"
                }
            }
        },
        linkback = "block_00000",
        linknext = "block_00002"
    },
    block_00002 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000002", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧", "学生会长"},
                    "「可这毕竟是提交到学生会的案件」"
                }
            }
        },
        linkback = "block_00001",
        linknext = "block_00003"
    },
    block_00003 = {
        {"bg", file = "ev_com_a28_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000004", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智", "副会长"},
                    "「配合学友会的部费会议,各部部长马上就要陆续到场了。根本没有",
                    {"rt2"},
                    "时间来审议本案。应该立刻报告老师才对」"
                }
            }
        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"bg", file = "ev_com_a28_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000003", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧", "学生会长"},
                    "「说到报告老师,若田老师不是也知情吗」"
                }
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000040", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「那当然。毕竟接到明石联络的人就是我嘛」"
                }
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"bg", file = "ev_com_a28_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000005", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智", "副会长"},
                    "「若田老师信不过!」"
                }
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000041", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「为什么会这样啊」"
                }
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000006", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智", "副会长"},
                    "「老师您基本上只考虑自保!　自己担任顾问的社团出了问题,您不",
                    {"rt2"},
                    "就想把事情压在自己这一层了事吗?」"
                }
            }
        },
        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000042", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「嘛,虽然没法否认,但也不用说得这么斩钉截铁吧……」"
                }
            }
        },
        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_000764", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「而且严格说来,若田老师并不是顾问,只是暂且以代理的形式充当",
                    {"rt2"},
                    "着类似顾问的角色……」"
                }
            }
        },
        linkback = "block_00009",
        linknext = "block_00011"
    },
    block_00011 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000007", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智", "副会长"},
                    "「正因如此,正因为是非正式聘用的教师,一旦受托代管的社团出了",
                    {"rt2"},
                    "岔子,若田老师就很可能把事情大事化小!　因为他自己的立场会轻",
                    {"rt2"},
                    "易变得岌岌可危!」"
                }
            }
        },
        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
