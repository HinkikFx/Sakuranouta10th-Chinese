        linkback = "block_00001",
        linknext = "block_00003"
    },
    block_00003 = {
        {"bg", file = "ev_com_a28_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000004", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智", "副会长"},
                    "「学友会的部费会议就要开了，各部部长陆续到场。根本没有时间",
                    {"rt2"},
                    "讨论这个案子。应该立刻向老师报告」"
                }
            }
        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"bg", file = "ev_com_a28_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a28/", set = "ev_com_a28"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000003", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧", "学生会长"},
                    "「说向老师报告，若田老师也知道吧」"
                }
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000040", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
