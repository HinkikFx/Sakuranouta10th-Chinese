        linknext = "block_00049"
    },
    block_00049 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000023", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「那么……你为什么会在这里?」"
