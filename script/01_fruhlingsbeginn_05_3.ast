    },
    block_00009 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wkd_000042", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「嗯，虽然我不好否认，但也不用说得那么绝对……」"
