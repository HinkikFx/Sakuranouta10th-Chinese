    },
    block_00051 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000024", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「谁都没有传唤你啊」"
