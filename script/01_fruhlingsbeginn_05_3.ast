    block_00045 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000205", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「哦,这不是小沙智吗。有没有好好努力辅佐会长啊?」"
                }
            }
        },
        linkback = "block_00044",
        linknext = "block_00046"
    },
    block_00046 = {
        {"text"},
        text = {
