        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000006", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智", "副会长"},
                    "「老师您基本上只考虑自保！自己担任顾问的社团出了问题，不就",
