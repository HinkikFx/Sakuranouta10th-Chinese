    },
    block_00088 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000406", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「不是捐给学校的……草薙健一郎是把这座教堂捐赠给了神父……」"
