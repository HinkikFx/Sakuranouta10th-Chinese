        linknext = "block_00051"
    },
    block_00051 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「就算是你，也不可能对一台不熟悉的研磨机直接在正式场地教堂",
                    {"rt2"},
                    "上使用吧？所以用学校的走廊来练习研磨机的操作，大概就是这样",
