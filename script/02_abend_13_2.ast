        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「相比之下，我是最近才发觉的。前阵子偶然去了樱之原的画材店，",
