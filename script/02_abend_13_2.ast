    },
    block_00089 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但遗憾的是，法律上这栋建筑的所有者是这所学园。健一郎没有",
                    {"rt2"},
                    "权利把这件作品捐赠给神父……」"
