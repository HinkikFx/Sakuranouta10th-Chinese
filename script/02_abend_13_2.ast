        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「鸟谷大概从你收集次品室内鞋那会儿就觉得可疑了吧?毕竟那家",
                    {"rt2"},
                    "伙比我更留意你的一举一动……」"
                }
            }
        },
        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「相比之下,我是最近才发现的。前些天,我碰巧去了樱之原的画材",
                    {"rt2"},
                    "店。那时听店里的大叔说起,你曾有一段时期在到处找有机溶剂」"
                }
            }
        },
        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"fg", ch = "明石", mode = 3, path = ":fg/aka/z1/", file = "aka_z1b0000", face = "b0003", head = "aka_z1b", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000374", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「有机溶剂啊……那次是有诸多不自然之处,是个败笔哪。一着急就",
                    {"rt2"},
                    "干了留下把柄的事。按理说本不该想去买那种东西的……」"
                }
            }
        },
        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「对画油画的人来说,有机溶剂算是个不远不近的存在。要溶解橡胶",
                    {"rt2"},
                    "时会想到丙酮什么的,倒也不是不能理解」"
                }
            }
        },
        linkback = "block_00016",
        linknext = "block_00018"
    },
    block_00018 = {
        {"fg", ch = "明石", mode = 3, path = ":fg/aka/z1/", file = "aka_z1b0000", face = "b0001", head = "aka_z1b", lv = 4, id = 9},
        {"fgact", ch = "明石", act = "おじぎ", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_wtd_000375", ch = "wtd"}
            },
            ja = {
                {
                    name = {"明石"},
                    "「正是。画油画时会拿丙酮当剥离剂用。油画教程里对丙酮的说明,",
                    {"rt2"},
                    "都写着它能溶解橡胶和塑料……」"
                }
            }
        },
        linkback = "block_00017",
        linknext = "block_00019"
    },
    block_00019 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是啊。可实际上你没用它」"
