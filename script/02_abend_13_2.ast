        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,这不是我一个人的功劳。要是没有鸟谷,根本查不出个所以然。",
