        linkback = "block_00019",
        linknext = "block_00021"
    },
    block_00021 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那是自然。要是剥离油画程度的东西就能把橡胶溶得黏糊糊的,那",
