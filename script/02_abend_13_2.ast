        },
        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「对画油画的人来说，有机溶剂是个半生不熟的存在嘛。想到溶解",
