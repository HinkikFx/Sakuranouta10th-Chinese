        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嘛,毕竟是会招来退学处分的计划。要是鸟谷的话,说不定真会阻",
