                {"vo", file = "fem_rna_001624", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「被狼吃掉的少女,以\"ＵＦＴ　桑弗拉尔Ｓ\"为主食。少女以毒为主",
                    {"rt2"},
                    "食,从而在体内积蓄毒素」"
                }
            }
        },
        linkback = "block_00302",
        linknext = "block_00304"
    },
    block_00304 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001625", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
