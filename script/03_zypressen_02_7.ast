            ja = {
                {
                    name = {"里奈"},
                    "「别把人说得像人间椅子一样……」"
                }
            }
        },
        linkback = "block_00219",
        linknext = "block_00221"
    },
    block_00221 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001784", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「啊—,这真的会堕落的—。太幸福了—」"
                }
            }
        },
        linkback = "block_00220",
        linknext = "block_00222"
    },
    block_00222 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001592", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「这样就幸福了？」"
                }
            }
        },
        linkback = "block_00221",
        linknext = "block_00223"
    },
    block_00223 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001785", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「嗯,我是天下第一的幸福之人哦」"
                }
            }
        },
        linkback = "block_00222",
        linknext = "block_00224"
    },
    block_00224 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001593", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是嘛,嘛,那真是不错……」"
                }
            }
        },
        linkback = "block_00223",
        linknext = "block_00225"
    },
    block_00225 = {
        {"text"},
        text = {
            ja = {
                {"里奈偶尔会让我这样撒娇,却也总带着几分悲伤的神情。"}
            }
        },
        linkback = "block_00224",
        linknext = "block_00226"
    },
    block_00226 = {
        {"text"},
        text = {
            ja = {
                {"所以每逢这种时候,我都是一半欢喜,一半悲伤。"}
            }
        },
        linkback = "block_00225",
        linknext = "block_00227"
    },
    block_00227 = {
        {"text"},
        text = {
            ja = {
                {"没法像平时那样发自内心地闹腾。"}
            }
        },
        linkback = "block_00226",
        linknext = "block_00228"
    },
    block_00228 = {
        {"text"},
        text = {
            ja = {
                {
                    "可我连露出那种表情的里奈也喜欢,如果里奈只是个没心没肺的美少",
                    {"rt2"},
                    "女,我大概不会喜欢她到这个地步。"
                }
            }
        },
        linkback = "block_00227",
        linknext = "block_00229"
    },
    block_00229 = {
        {"text"},
        text = {
            ja = {
                {"啊啊,胸好软啊。"}
            }
        },
        linkback = "block_00228",
        linknext = "block_00230"
    },
    block_00230 = {
        {"text"},
        text = {
            ja = {
                {"还有,里奈的脸好可爱。"}
            }
        },
        linkback = "block_00229",
        linknext = "block_00231"
    },
    block_00231 = {
        {"text"},
        text = {
            ja = {
                {"悲伤的神情。"}
            }
        },
        linkback = "block_00230",
        linknext = "block_00232"
    },
    block_00232 = {
        {"text"},
        text = {
            ja = {
                {"那是为了我而露出的表情。"}
            }
        },
        linkback = "block_00231",
        linknext = "block_00233"
    },
    block_00233 = {
        {"text"},
        text = {
            ja = {
                {"这么一想,连那也变得惹人怜爱。"}
            }
        },
        linkback = "block_00232",
        linknext = "block_00234"
    },
    block_00234 = {
        {"text"},
        text = {
            ja = {
                {"明明让她悲伤,大概也在让她痛苦,我真是个彻头彻尾的蛆虫。"}
            }
        },
        linkback = "block_00233",
        linknext = "block_00235"
    },
    block_00235 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001594", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「你是不是在偷偷摸索乳头的位置？」"
                }
            }
        },
        linkback = "block_00234",
        linknext = "block_00236"
    },
    block_00236 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001786", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「没有。才没有呢。我没用手指吧？」"
                }
            }
        },
        linkback = "block_00235",
        linknext = "block_00237"
    },
    block_00237 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001595", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不,你在用嘴唇」"
