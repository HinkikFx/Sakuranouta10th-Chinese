    },
    block_00279 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001612", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「女孩子柔软的地方,可不只是胸」"
                }
            }
        },
        linkback = "block_00278",
        linknext = "block_00280"
    },
    block_00280 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001812", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「诶？　难、难道说？　是皮下脂肪？」"
                }
            }
        },
        linkback = "block_00279",
        linknext = "block_00281"
    },
    block_00281 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001613", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不是不是,是香气之类的啦」"
                }
            }
        },
        linkback = "block_00280",
        linknext = "block_00282"
    },
    block_00282 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001813", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「香气？　我什么都没喷哦？」"
                }
            }
        },
        linkback = "block_00281",
        linknext = "block_00283"
    },
    block_00283 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001614", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「优美不是扎着双马尾,头发很长嘛。所以护发素的香气特别明显哦。",
                    {"rt2"},
                    "大概比编麻花辫的我还要香呢」"
                }
            }
        },
        linkback = "block_00282",
        linknext = "block_00284"
    },
    block_00284 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001814", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「是吗？」"
                }
            }
        },
        linkback = "block_00283",
        linknext = "block_00285"
    },
    block_00285 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001615", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是啊。优美自己没注意到吗？」"
                }
            }
        },
        linkback = "block_00284",
        linknext = "block_00286"
    },
    block_00286 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001815", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「嗯,完全没注意到」"
                }
            }
        },
        linkback = "block_00285",
        linknext = "block_00287"
    },
    block_00287 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001616", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「而且,优美的头发特别漂亮哦。大概是比谁都漂亮的头发……」"
                }
            }
        },
        linkback = "block_00286",
        linknext = "block_00288"
    },
    block_00288 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001816", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「是吗？　我可什么都没打理过……」"
                }
            }
        },
        linkback = "block_00287",
        linknext = "block_00289"
    },
    block_00289 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001617", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「说不定正是因为没怎么打理呢？　染色啦折腾来折腾去的,头发是",
                    {"rt2"},
                    "会受损的呀」"
                }
            }
        },
        linkback = "block_00288",
        linknext = "block_00290"
    },
    block_00290 = {
