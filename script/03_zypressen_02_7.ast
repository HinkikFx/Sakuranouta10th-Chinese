    },
    block_00223 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001785", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「嗯，我是天下第一的幸福人」"
                }
