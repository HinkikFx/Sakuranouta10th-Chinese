        linkback = "block_00604",
        linknext = "block_00606"
    },
    block_00606 = {
        {"text"},
        text = {
            ja = {
                {"大概,并不是出于什么不想让雫独自蒙羞――之类的理由。"}
            }
        },
        linkback = "block_00605",
        linknext = "block_00607"
    },
    block_00607 = {
        {"text"},
        text = {
            ja = {
                {
                    "只是单纯地,忍无可忍开始了自慰。仅仅是对雫的模样再也忍耐不住",
                    {"rt2"},
                    "而已。"
                }
            }
        },
        linkback = "block_00606",
        linknext = "block_00608"
    },
    block_00608 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_001618", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「……啊……嗯,嗯嗯……直,直哉也……在,在陪我做?对,对不起,让你陪",
                    {"rt2"},
                    "我做这种事……嗯,啊嗯」"
                }
            }
        },
        linkback = "block_00607",
        linknext = "block_00609"
    },
    block_00609 = {
        {"text"},
        text = {
            ja = {
                {"不,并不是在陪她,我也只是忍不住自己开始了而已……。"}
            }
        },
        linkback = "block_00608",
        linknext = "block_00610"
    },
    block_00610 = {
        {"text"},
        text = {
            ja = {
                {"雫一只手大大掰开小穴,另一只手摸索着自己的那个部位。"}
            }
