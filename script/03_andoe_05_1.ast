    block_00411 = {
        {"text"},
        text = {
            ja = {
                {"怎么回事。"}
            }
        },
        linkback = "block_00410",
        linknext = "block_00412"
    },
    block_00412 = {
        {"text"},
        text = {
            ja = {
                {"为什么会这么兴奋呢？"}
            }
        },
        linkback = "block_00411",
        linknext = "block_00413"
    },
    block_00413 = {
        {"text"},
        text = {
            ja = {
                {
                    "我最喜欢的雫，在这种地方，在可能被人看到的情况下，做这种事",
                    {"rt2"},
                    "情——说实话不可能高兴的。"
                }
            }
        },
        linkback = "block_00412",
        linknext = "block_00414"
    },
    block_00414 = {
        {"text"},
        text = {
            ja = {
                {"被谁看到什么的绝对不能发生。"}
            }
        },
        linkback = "block_00413",
        linknext = "block_00415"
    },
    block_00415 = {
        {"text"},
        text = {
            ja = {
                {"但是……这是紧张感的关系吗？"}
            }
        },
        linkback = "block_00414",
        linknext = "block_00416"
    },
    block_00416 = {
        {"text"},
        text = {
            ja = {
                {"是因为紧张感而产生的心跳吗？"}
            }
        },
        linkback = "block_00415",
        linknext = "block_00417"
    },
    block_00417 = {
        {"text"},
        text = {
            ja = {
                {"我的心脏跳得非常厉害。"}
            }
        },
        linkback = "block_00416",
        linknext = "block_00418"
    },
    block_00418 = {
        {"text"},
        text = {
            ja = {
                {
                    "而且最重要的是，看着因紧张和羞耻而满脸通红的雫，我心中涌起",
                    {"rt2"},
                    "了一种无法自制的感觉。"
                }
            }
        },
        linkback = "block_00417",
        linknext = "block_00419"
    },
    block_00419 = {
        {"text"},
        text = {
            ja = {
                {"『吊桥效应』。"}
            }
        },
        linkback = "block_00418",
        linknext = "block_00420"
    },
    block_00420 = {
        {"text"},
        text = {
            ja = {
                {
                    "情侣一起过吊桥时的恐惧感。那份心跳被误认为恋爱的心动，从而",
                    {"rt2"},
                    "坠入爱河——就是那个理论。"
                }
            }
        },
        linkback = "block_00419",
        linknext = "block_00421"
    },
    block_00421 = {
        {"text"},
        text = {
            ja = {
                {"也许跟那个有几分相似……"}
            }
        },
        linkback = "block_00420",
        linknext = "block_00422"
    },
    block_00422 = {
        {"text"},
        text = {
            ja = {
                {"不，如果只是恐惧的话，不会兴奋到这种程度。"}
            }
        },
        linkback = "block_00421",
        linknext = "block_00423"
    },
    block_00423 = {
        {"text"},
        text = {
            ja = {
                {
                    "现在眼前的雫，脸红到那种程度在忍耐羞耻。看到那样的她，我感",
                    {"rt2"},
                    "到了非同寻常的兴奋。"
                }
            }
        },
        linkback = "block_00422",
        linknext = "block_00424"
    },
    block_00424 = {
        {"text"},
        text = {
            ja = {
                {"说实话，我不懂什么露出Play之类的狂热爱好。"}
            }
        },
        linkback = "block_00423",
        linknext = "block_00425"
    },
    block_00425 = {
        {"text"},
        text = {
            ja = {
                {"把最爱的人暴露在别人的目光下什么的不可想象。"}
            }
        },
        linkback = "block_00424",
        linknext = "block_00426"
    },
    block_00426 = {
        {"text"},
        text = {
            ja = {
                {"但，就在那个临界点……"}
            }
        },
        linkback = "block_00425",
        linknext = "block_00427"
    },
    block_00427 = {
        {"text"},
        text = {
            ja = {
                {
                    "在会不会被看到的不安之中，沉浸于羞耻之中的最爱之人的身姿——",
                    {"rt2"},
                    "不为之心动的人恐怕不存在吧？"
                }
            }
        },
        linkback = "block_00426",
        linknext = "block_00428"
    },
    block_00428 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_001556", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「我、我要加油了！」"
