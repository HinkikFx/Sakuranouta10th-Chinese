    block_00401 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,啊啊……」"
                }
            }
        },
        linkback = "block_00400",
        linknext = "block_00402"
    },
    block_00402 = {
        {"text"},
        text = {
            ja = {
                {
                    "雫把双腿张到了极限。虽算不上M字,却足以与之匹敌,不,是摆出了",
                    {"rt2"},
                    "更加卑猥的姿势。"
                }
            }
        },
        linkback = "block_00401",
        linknext = "block_00403"
    },
    block_00403 = {
        {"text"},
        text = {
            ja = {
                {"现在虽然还有裙子遮着……可雫此刻并没有穿内裤。"}
            }
        },
        linkback = "block_00402",
        linknext = "block_00404"
    },
    block_00404 = {
        {"text"},
        text = {
            ja = {
                {"也就是说,只要那一层布被掀开……。"}
            }
        },
        linkback = "block_00403",
        linknext = "block_00405"
    },
    block_00405 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_001553", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「被,被盯得好紧……」"
                }
            }
        },
        linkback = "block_00404",
        linknext = "block_00406"
    },
    block_00406 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊,啊啊……,话,话说雫便服的这条裙子,两侧倒是挺长……偏偏只有",
                    {"rt2"},
                    "前面是迷你裙啊……」"
                }
            }
        },
        linkback = "block_00405",
        linknext = "block_00407"
    },
    block_00407 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_001554", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「是,是的……而且布料偏薄……虽然不至于透光……但到了这种时候,",
                    {"rt2"},
                    "就会对它的重量感到不安」"
                }
            }
        },
        linkback = "block_00406",
        linknext = "block_00408"
    },
    block_00408 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「重量不重量的……反正接下来就要掀开了吧?」"
                }
            }
        },
        linkback = "block_00407",
        linknext = "block_00409"
    },
    block_00409 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_001555", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「是,是这样没错……」"
                }
            }
        },
        linkback = "block_00408",
        linknext = "block_00410"
    },
    block_00410 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「咕咚……」"
                }
            }
        },
        linkback = "block_00409",
        linknext = "block_00411"
    },
    block_00411 = {
        {"text"},
        text = {
            ja = {
                {"怎么回事。"}
            }
        },
        linkback = "block_00410",
        linknext = "block_00412"
    },
    block_00412 = {
        {"text"},
        text = {
            ja = {
                {"为什么会这么兴奋?"}
            }
        },
        linkback = "block_00411",
        linknext = "block_00413"
    },
    block_00413 = {
        {"text"},
        text = {
            ja = {
                {
                    "我最爱的雫,在这种地方,在可能被人看到的状况下做那种事,老实说,",
                    {"rt2"},
                    "我不可能高兴。"
                }
            }
        },
        linkback = "block_00412",
        linknext = "block_00414"
    },
    block_00414 = {
        {"text"},
        text = {
            ja = {
                {"被别人看到什么的,更是绝对不容发生。"}
            }
        },
        linkback = "block_00413",
        linknext = "block_00415"
    },
    block_00415 = {
        {"text"},
        text = {
            ja = {
                {"可是……这是紧张感吗?"}
            }
        },
        linkback = "block_00414",
        linknext = "block_00416"
    },
    block_00416 = {
        {"text"},
        text = {
            ja = {
                {"是因紧张而生的心跳加速吗?"}
            }
        },
        linkback = "block_00415",
        linknext = "block_00417"
    },
    block_00417 = {
        {"text"},
        text = {
            ja = {
                {"我的心脏,正咚咚狂跳。"}
            }
        },
        linkback = "block_00416",
        linknext = "block_00418"
    },
    block_00418 = {
        {"text"},
        text = {
            ja = {
                {
                    "而最重要的是,看着因紧张和羞耻而满脸通红的雫,心里就涌起一股",
                    {"rt2"},
                    "难以自持的冲动。"
                }
            }
        },
        linkback = "block_00417",
        linknext = "block_00419"
    },
    block_00419 = {
        {"text"},
        text = {
            ja = {
                {"「吊桥效应」。"}
            }
        },
        linkback = "block_00418",
        linknext = "block_00420"
    },
    block_00420 = {
        {"text"},
        text = {
            ja = {
                {
                    "情侣众人走过吊桥时的恐惧。那份心跳被错当成恋爱的心动,从而坠",
                    {"rt2"},
                    "入爱河——就是那个理论。"
                }
            }
        },
        linkback = "block_00419",
        linknext = "block_00421"
    },
    block_00421 = {
        {"text"},
        text = {
            ja = {
                {"说不定,眼下的感觉与之相近……。"}
            }
        },
        linkback = "block_00420",
        linknext = "block_00422"
    },
    block_00422 = {
        {"text"},
        text = {
            ja = {
                {"不,如果单纯只是恐惧,不至于兴奋到这种地步。"}
            }
        },
        linkback = "block_00421",
        linknext = "block_00423"
    },
    block_00423 = {
        {"text"},
        text = {
            ja = {
                {
                    "此刻就在眼前的雫,红着一张脸,忍耐着那样的羞耻。那副模样,让我",
                    {"rt2"},
                    "感到非同寻常的兴奋。"
                }
            }
        },
        linkback = "block_00422",
        linknext = "block_00424"
    },
    block_00424 = {
        {"text"},
        text = {
            ja = {
                {"老实说,我搞不懂什么狂热的露出play。"}
            }
        },
        linkback = "block_00423",
        linknext = "block_00425"
    },
    block_00425 = {
        {"text"},
        text = {
            ja = {
                {"把最爱的人暴露在别人的视线里,更是无法想象。"}
            }
        },
        linkback = "block_00424",
        linknext = "block_00426"
    },
    block_00426 = {
        {"text"},
        text = {
            ja = {
                {"可是,就在那千钧一发的边缘……。"}
            }
        },
        linkback = "block_00425",
        linknext = "block_00427"
    },
    block_00427 = {
        {"text"},
        text = {
            ja = {
                {
                    "在会不会被看到的不安之中,被羞耻染红的心爱之人——对这副模样",
                    {"rt2"},
                    "毫不心动的人,恐怕根本不存在吧?"
                }
            }
        },
        linkback = "block_00426",
        linknext = "block_00428"
    },
    block_00428 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_001556", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「我,我会加油的」"
                }
            }
        },
        linkback = "block_00427",
        linknext = "block_00429"
    },
    block_00429 = {
        {"text"},
        text = {
            ja = {
                {
                    "如果雫表现出嫌恶,我大概还能生出抗拒……可她这副拼命努力的健",
                    {"rt2"},
                    "气模样,又一次……拨动了我的心弦。"
                }
            }
        },
        linkback = "block_00428",
        linknext = "block_00430"
    },
    block_00430 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_001557", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「那,我要开始了?没,没有人来吧?」"
                }
            }
        },
        linkback = "block_00429",
        linknext = "block_00431"
    },
    block_00431 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯,目前谁都没有……,之后要是有人来,我一定会说的」"
                }
            }
