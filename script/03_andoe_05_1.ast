        linkback = "block_00427",
        linknext = "block_00429"
    },
    block_00429 = {
        {"text"},
        text = {
            ja = {
                {
                    "如果雫表现出讨厌的样子，或许我还能产生排斥……但是她那努力",
                    {"rt2"},
                    "加油的健气模样又戳中了我的心弦。"
                }
