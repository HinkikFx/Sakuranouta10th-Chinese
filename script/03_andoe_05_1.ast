    block_00402 = {
        {"text"},
        text = {
            ja = {
                {
                    "雫正使劲地张着腿。虽然不是M字，但堪比甚至比那更加淫靡的姿",
                    {"rt2"},
                    "势。"
                }
            }
        },
        linkback = "block_00401",
        linknext = "block_00403"
    },
    block_00403 = {
        {"text"},
        text = {
            ja = {
                {"现在还被裙子遮着，但是……雫现在没穿内裤。"}
            }
        },
        linkback = "block_00402",
        linknext = "block_00404"
    },
    block_00404 = {
        {"text"},
        text = {
            ja = {
                {"也就是说，只要那层布被掀开……"}
            }
        },
        linkback = "block_00403",
        linknext = "block_00405"
    },
    block_00405 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_001553", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「好、好认真地在盯着看呢……」"
                }
            }
        },
        linkback = "block_00404",
        linknext = "block_00406"
    },
    block_00406 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊、嗯嗯……怎、怎么说呢，雫你便服裙子的两侧挺长的……但前",
                    {"rt2"},
                    "面是迷你裙呢……」"
                }
            }
        },
        linkback = "block_00405",
        linknext = "block_00407"
    },
    block_00407 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_001554", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「是、是的……而且布料比较薄……虽然不会透但是……在这种时候重",
                    {"rt2"},
                    "量上有些让人不安」"
                }
