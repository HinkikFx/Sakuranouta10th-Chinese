        linkback = "block_00490",
        linknext = "block_00492"
    },
    block_00492 = {
        {"text"},
        text = {
            ja = {
                {"日光之下。那个雫正掰开小穴,坐在长椅上。"}
            }
        },
        linkback = "block_00491",
        linknext = "block_00493"
    },
    block_00493 = {
        {"text"},
        text = {
            ja = {
                {"从没这么清清楚楚地看过雫的这个部位。"}
            }
        },
        linkback = "block_00492",
        linknext = "block_00494"
    },
    block_00494 = {
        {"text"},
        text = {
            ja = {
                {"她惹人怜爱的脸庞,还有纤细的身体。以及照亮这一切的自然光。"}
            }
        },
        linkback = "block_00493",
        linknext = "block_00495"
    },
    block_00495 = {
        {"text"},
        text = {
            ja = {
                {"到此为止,她的身影和杂志写真上看到的并无二致。"}
            }
        },
        linkback = "block_00494",
        linknext = "block_00496"
    },
    block_00496 = {
        {"text"},
        text = {
            ja = {
                {
                    "然而,那位点缀着写真页面的美丽的她,此刻却以近乎不自然的角度",
                    {"rt2"},
                    "张开双腿,还用自己的手掰开着局部。"
                }
            }
        },
        linkback = "block_00495",
        linknext = "block_00497"
    },
    block_00497 = {
        {"text"},
        text = {
            ja = {
                {"难以置信的景象就在眼前。"}
