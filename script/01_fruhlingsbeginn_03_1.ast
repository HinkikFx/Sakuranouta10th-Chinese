        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「弓张是草薙健一郎的母校，而且这里的美术部也颇有名气。虽说",
                    {"rt2"},
                    "放弃了画画，但还是很在意」"
                }
            }
        },
        linkback = "block_00148",
        linknext = "block_00150"
    },
    block_00150 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以入学伊始就跑来窥探美术部了。那天也是大清早」"
                }
            }
        },
        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"fg", mode = -2},
        {"bg", file = "ev_com_a24_01", path = ":ev/ev_com_a24/", set = "ev_com_a24"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那时候你还是短发来着……身体看起来也比现在要小……」"
                }
            }
        },
        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嘛，其实不可能变化那么大，应该是气质的关系吧……」"
                }
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            ja = {
                {"不过……有一个地方确实大幅成长了……。这一点还是不要提了。"}
            }
        },
        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为你在那么仔细地擦地板，我还以为这个社团像体育系一样上",
                    {"rt2"},
                    "下级关系很严呢」"
                }
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但是仔细一看，那个女孩好像做得很开心」"
