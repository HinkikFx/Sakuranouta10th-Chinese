        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我就想啊，一定是个对这个社团很有感情的前辈吧……结果再仔",
                    {"rt2"},
                    "细一看，居然还没入部的新生……」"
