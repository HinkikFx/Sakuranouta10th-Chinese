        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_000522", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
