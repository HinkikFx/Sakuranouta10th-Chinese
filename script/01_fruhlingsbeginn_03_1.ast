        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你还开开心心地拿抹布蹭蹭蹭地擦地。那样四肢着地趴着擦,膝盖",
