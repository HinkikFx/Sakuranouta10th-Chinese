        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我还擅自想象,这一定是位性格特别好的姑娘吧……。毕竟每天早",
