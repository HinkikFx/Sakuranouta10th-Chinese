        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为那个时候不是还没到交入部申请的时间嘛。你戴着一年级的",
                    {"rt2"},
                    "名牌……那肯定还没入部啊……」"
