        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000368", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「就是那样，所以我觉得是原本就有的门路」"
