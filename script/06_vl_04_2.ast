        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000347", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「啊，对了。你还记得吗？直哉老师？」"
                }
