    },
    block_00144 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是的」"
                }
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000359", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「从刚才起，你就一边自言自语，一边死死盯着那座教会和弓张综",
                    {"rt2"},
                    "合医院看呢」"
                }
