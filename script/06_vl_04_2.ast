    },
    block_00126 = {
        {"cgdel", id = -1},
        {"bg", file = "ev_com_j01_02", path = ":ev/ev_com_j01/", set = "ev_com_j01"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「有个问题想请教一下，这所学园的出资人并不只是一个人吧？」"
                }
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000351", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「是的，并非单一出资人。是从各方有钱人那里筹措的运营资金。",
                    {"rt2"},
                    "常任理事三人，理事长一人」"
                }
            }
        },
        linkback = "block_00126",
        linknext = "block_00128"
    },
    block_00128 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「其中有弓张综合医院吗？」"
                }
            }
        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000352", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「哎呀，你倒是敏锐呢」"
                }
            }
        },
        linkback = "block_00128",
        linknext = "block_00130"
    },
    block_00130 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「听到了一些……而且，那家医院和弓张学园是相邻的」"
                }
            }
        },
        linkback = "block_00129",
        linknext = "block_00131"
    },
    block_00131 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000353", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「原来如此，不过你问的问题倒是挺奇怪的。四个出资人里面，为",
                    {"rt2"},
                    "什么偏偏只问那家？」"
                }
            }
        },
        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不，没有什么特别的意思……只是想知道医院方面对这次的事怎",
                    {"rt2"},
                    "么看」"
                }
            }
        },
        linkback = "block_00131",
        linknext = "block_00133"
    },
    block_00133 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000354", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「谁知道呢。那方面我也不太清楚，不过大概会认可吧。弓张综合",
                    {"rt2"},
                    "医院的井上先生」"
                }
            }
        },
        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000355", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「从旧楼那边可以看到那幅壁画呢。虽然现在已经不行了，不过直",
                    {"rt2"},
                    "哉你在校的时候，旧楼好像挺受欢迎的」"
                }
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
