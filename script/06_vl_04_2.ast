        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「记得什么？」"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000348", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「不，也不是什么大事。『樱达的足迹』这件作品，在你们完成的",
                    {"rt2"},
                    "时候，作为壁画其实是不完整的」"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「应该是吧」"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000349", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「当时用的涂料中的橡胶成分遇热容易融化，所以几天后就安排了",
                    {"rt2"},
                    "施工人员来固化涂料」"
                }
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是的，一直用蓝色挡板围着也是为了防热，以及是施工作业的证",
                    {"rt2"},
                    "据」"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000350", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「就是那样。那种作品必须完成涂料固化工序，才能真正作为壁画",
                    {"rt2"},
                    "使用」"
                }
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「……」"
                }
            }
