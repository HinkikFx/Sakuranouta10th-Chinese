        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「会到那种程度吗？」"
                }
            }
        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000370", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「有钱人这种生物啊，最看重的就是面子」"
