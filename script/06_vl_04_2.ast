        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000364", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「你们的那次事件让医院生意兴隆也是原因之一吧……」"
                }
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000365", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「只不过，这件事先通到了村山理事那里，而不是医院的井上理事」"
                }
            }
