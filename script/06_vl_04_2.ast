        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那是为什么？」"
                }
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000366", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「那大概是巧合吧。可能是原本就有什么关系门路。否则不会动作",
                    {"rt2"},
                    "那么利索」"
                }
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「井上理事是弓张综合医院的对吧。那村山理事呢？」"
                }
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000367", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「综合建设业，也就是大型建筑公司」"
                }
            }
