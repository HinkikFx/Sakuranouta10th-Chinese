        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我明白了」"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000369", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「医院的井上理事虽然也对当代艺术很感兴趣，但自己被排除在外",
                    {"rt2"},
                    "推进了事情，心里不太痛快也说不定」"
