    block_00125 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此……」"
                }
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"cgdel", id = -1},
        {"bg", file = "ev_com_j01_02", path = ":ev/ev_com_j01/", set = "ev_com_j01"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我想问一下，这所学园的所有者，并不止一个人吧？」"
                }
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000351", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「是啊，并非单一所有者。资金是从各路富豪那里筹措来的。常任",
                    {"rt2"},
                    "理事有三位，理事长一位」"
                }
            }
        },
        linkback = "block_00126",
        linknext = "block_00128"
    },
    block_00128 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那里面，有弓张综合医院吗？」"
                }
            }
        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000352", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「哎呀，亏你能猜到呢」"
                }
            }
        },
        linkback = "block_00128",
        linknext = "block_00130"
    },
    block_00130 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「稍微听人提起过……再说，那家医院和弓张学园本来就相邻」"
                }
            }
        },
        linkback = "block_00129",
        linknext = "block_00131"
    },
    block_00131 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000353", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「原来如此。话说回来，你问的还真是奇怪呢。为什么四位出资方",
                    {"rt2"},
                    "里，偏偏只问那一家的事？」"
                }
            }
        },
        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不，也没什么深意……只是想知道，医院方面对这次的事会怎么",
                    {"rt2"},
                    "想？　仅此而已」"
                }
            }
        },
        linkback = "block_00131",
        linknext = "block_00133"
    },
    block_00133 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000354", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「谁知道呢。那边的情况我也不太清楚，不过嘛，多半会认可的吧。",
                    {"rt2"},
                    "弓张综合医院的井上先生」"
                }
            }
        },
        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000355", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「从旧楼那边，那幅壁画看得可清楚了。虽然现在早已冷清，但直",
                    {"rt2"},
                    "哉君你还在校的那会儿，旧楼似乎很有人气呢」"
                }
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
