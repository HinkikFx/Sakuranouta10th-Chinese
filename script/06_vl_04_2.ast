        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000363", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「尤其是那里的院长，对现代艺术可是相当狂热呢」"
