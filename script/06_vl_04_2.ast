        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「生前的草薙健一郎喜欢艺术上的风波，也乐见那种意外事件。关",
                    {"rt2"},
                    "于这次的事件，且不论其艺术上的尖锐性如何，与草薙健一郎的意",
                    {"rt2"},
                    "志并不矛盾」"
                }
