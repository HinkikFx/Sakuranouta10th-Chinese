    },
    block_00152 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000364", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「拜你们当年那起事件所赐，医院倒是生意兴隆……」"
                }
