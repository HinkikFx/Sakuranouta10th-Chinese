        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000365", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「只是，这次的事没有先知会医院的井上理事，反而先通到了村山",
