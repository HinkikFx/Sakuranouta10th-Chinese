    },
    block_00145 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000359", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「你刚才一直自言自语，同时盯着教堂和弓张综合医院看呢」"
                }
