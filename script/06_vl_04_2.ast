        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那是为什么？」"
                }
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000366", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「那总不至于是偶然吧。多半，是原本就有某种门路在吧。不然的",
                    {"rt2"},
                    "话，手脚未免太麻利了」"
                }
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「井上理事是弓张综合医院的人。那村山理事呢？」"
                }
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000367", ch = "htd"}
            },
            ja = {
                {
