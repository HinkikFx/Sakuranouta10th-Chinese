        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000348", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「不，也不是什么大事。『樱花们的足迹』那件作品，在你们完成",
                    {"rt2"},
                    "它的时候，作为壁画其实尚未完工」"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「想必是吧」"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000349", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「用作涂料的橡胶遇热很快就会熔化，所以几天之后，校方安排了",
                    {"rt2"},
                    "施工方，做了涂料定色的作业」"
                }
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是的，它之所以一直被蓝色苫布围着，既是为了隔热，也是正在",
                    {"rt2"},
                    "施工的证据吧」"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000350", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「就是这么回事。那样的作品，要一直做到涂料定色的工序，才终",
                    {"rt2"},
                    "于能作为一面墙运作起来」"
                }
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「……」"
