        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「生前的草薙健一郎，就喜好艺术上的纷争，也乐见那类突发事件。",
                    {"rt2"},
                    "至于本次事件，姑且不论其是否具有艺术上的先锐性，至少不会与",
                    {"rt2"},
                    "草薙健一郎氏的意志相悖」"
                }
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「神圣之物，正因为遭到亵渎，正因为被贬入世俗，才得以成其为",
                    {"rt2"},
                    "神圣之物。这样的言论在草薙健一郎的话语中屡见不鲜……」"
                }
