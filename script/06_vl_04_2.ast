        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「谁知道呢，是您的错觉吧？」"
                }
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000360", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「是吗？　那么，为什么会没头没脑地，问起我们学校的所有者之",
                    {"rt2"},
                    "一是弓张综合医院这件事呢？」"
                }
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「谁知道，怎么说呢」"
                }
            }
        },
        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000361", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「呼，嘴真硬呢。不过你的判断没有错」"
                }
            }
        },
        linkback = "block_00148",
        linknext = "block_00150"
    },
    block_00150 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000362", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「医院方面，会想要深度插手这次的事件吧」"
