        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            ja = {
                {
                    "正因如此，她说出「又不是小孩子了，说这种话太不好意思了」这",
                    {"rt2"},
                    "句话时，在我听来并非字面意思，更像是在告诫自己。"
