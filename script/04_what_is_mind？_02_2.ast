        text = {
            vo = {
                {"vo", file = "man_wkd_000089", ch = "wkd"}
            },
            ja = {
                {
                    name = {"若田"},
                    "「啊啊，那个超级学霸啊。到底是什么脑子才能考出那种成绩啊。",
                    {"rt2"},
