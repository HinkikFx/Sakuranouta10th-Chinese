    block_00381 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_000379", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「摆一个和这幅画相同的姿势」"
