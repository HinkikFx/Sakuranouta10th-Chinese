    block_00384 = {
        {"bg", time = 500, sync = 0, file = "black", path = ":bg/"},
        {"text"},
        text = {
            ja = {
                {"印象派，其起点被认为以一位天才为发端。"}
            }
        },
        linkback = "block_00383",
        linknext = "block_00385"
    },
    block_00385 = {
        {"text"},
        text = {
            ja = {
                {"位居西方近代绘画史开篇的画家。其名——爱德华·马奈。"}
            }
        },
        linkback = "block_00384",
        linknext = "block_00386"
    },
    block_00386 = {
        {"text"},
        text = {
            ja = {
                {
                    "通过有意识地削弱西方绘画根基中的立体感和透视法，宣告了近代",
                    {"rt2"},
                    "绘画时代的到来。"
                }
            }
        },
        linkback = "block_00385",
        linknext = "block_00387"
    },
    block_00387 = {
        {"text"},
        text = {
            ja = {
                {"让他声名大噪的是《草地上的午餐》。"}
            }
        },
        linkback = "block_00386",
        linknext = "block_00388"
    },
    block_00388 = {
        {"text"},
        text = {
            ja = {
                {
                    "在那之前，裸女像这一母题只有在神话或传说题材中才被允许出现。",
                    {"rt2"},
                    "马奈打破了这个规则，将其作为现实的女性来描绘。"
                }
            }
        },
        linkback = "block_00387",
        linknext = "block_00389"
    },
    block_00389 = {
        {"text"},
        text = {
            ja = {
                {"他画了一个在白天的公园里全裸的女性。"}
            }
        },
        linkback = "block_00388",
        linknext = "block_00390"
    },
    block_00390 = {
        {"text"},
        text = {
            ja = {
                {"这自然引发了轰动。"}
            }
        },
        linkback = "block_00389",
        linknext = "block_00391"
    },
    block_00391 = {
        {"text"},
        text = {
            ja = {
                {"但此后这位天才在沙龙展出了一幅更为大胆的作品。"}
            }
        },
        linkback = "block_00390",
        linknext = "block_00392"
    },
    block_00392 = {
        {"text"},
        text = {
            ja = {
                {"其名，《奥林匹亚》"}
            }
        },
        linkback = "block_00391",
        linknext = "block_00393"
    },
    block_00393 = {
        {"text"},
        text = {
            ja = {
                {"西方绘画史上的转折之作。"}
            }
