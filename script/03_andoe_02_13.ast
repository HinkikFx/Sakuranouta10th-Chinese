        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「于是,被称为表现了死亡的美丽之死《横卧之樱》,与这个题材恰",
                    {"rt2"},
                    "好契合」"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「刚才说明的九相图诸相也只是代表性的一种,其形式多种多样。有",
                    {"rt2"},
                    "时甚至连幅数都不是九」"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
