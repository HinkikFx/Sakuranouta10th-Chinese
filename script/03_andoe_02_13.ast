        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"fg", ch = "明石", size = "z1", mode = 3, path = ":fg/aka/z1/", file = "aka_z1a0000", face = "a0008", head = "aka_z1a", x = -345, lv = 4, id = 5},
        {"fgact", ch = "明石", act = "びっくり", lv = 4, id = 5},
        {"text"},
