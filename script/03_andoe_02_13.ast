        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「九相图——描绘被遗弃在野外的遗体逐渐朽烂的过程，分为九个阶",
                    {"rt2"},
                    "段的佛教绘画」"
                }
            }
        },
        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「顾名思义，九相图描绘的是九个变迁阶段的死亡」"
                }
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「第一幅画的是死后不久，遗体以美丽的姿态被描绘」"
                }
            }
        },
        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「在这个系列中，第一幅就是『横卧之樱』」"
                }
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「第二幅所描绘的死亡，叫做",
                    {"txruby", text = "ちょうそう"},
                    "胀相",
                    {"txruby"},
                    "。遗体会被描绘成丑陋地肿胀膨",
                    {"rt2"},
                    "起的样子」"
                }
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「大概是在表现因腐败产生的气体导致内部膨胀的状态」"
                }
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「下一个死亡形态叫做",
                    {"txruby", text = "えそう"},
                    "壊相",
                    {"txruby"},
                    "。腐朽加剧，皮肤溃烂、裂开，露出血",
                    {"rt2"},
                    "肉」"
                }
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「再下一个死亡形态叫做",
                    {"txruby", text = "けちずそう"},
                    "血涂相",
                    {"txruby"},
                    "。遗体的腐朽进一步加深，肌肉撕",
                    {"rt2"},
                    "裂，脂肪溃烂，血液和体液浸湿了大地」"
                }
