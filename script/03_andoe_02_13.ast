        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「谁知道呢。或许是在表现世间无常吧……。总之,这九相图画的是",
                    {"rt2"},
                    "美丽的女性。是一套让美丽之物逐渐变得惨不忍睹的概念之作」"
                }
