            },
            ja = {
                {
                    name = {"明石"},
                    "「遗骸?遗骸的连作?」"
                }
            }
        },
        linkback = "block_00148",
        linknext = "block_00150"
    },
    block_00150 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「没错。描绘人死后逐渐腐败之相的九相图」"
                }
            }
        },
        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「九相图,是将弃于野外的尸体逐渐朽坏的过程分作九个阶段描绘的",
                    {"rt2"},
                    "佛教绘画」"
                }
            }
        },
        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「正如其名,九相图描绘九种变迁之死」"
                }
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「第一幅是死后不久,遗骸被描绘得很美」"
                }
            }
        },
        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那第一幅的死,在这套连作里就是《横卧之樱》」"
                }
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「第二幅所绘之死,称为胀相。画的是遗骸丑陋膨胀的模样」"
                }
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「大概是在表现腐败产生的气体令体内膨胀的样子吧」"
                }
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「接下来的死相,称为坏相。腐败加剧,皮肤溃烂、绽裂,露出血肉」"
                }
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「再下来的死相,称为血涂相。遗骸的腐败进一步加深,肌肉绽裂,脂",
                    {"rt2"},
                    "肪溃烂,血与体液浸湿大地」"
                }
            }
        },
        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「接下来是脓烂相,尸骸整体溶解」"
                }
            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「接下来是青瘀相。遗骸变色。发青发黑」"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
