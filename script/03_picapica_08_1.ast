        linkback = "block_00040",
        linknext = "block_00042"
    },
    block_00042 = {
        {"text"},
        text = {
            ja = {
                {
                    "不。也没什么为什么吧。原来如此啊……店主过去留下的祸根，看",
                    {"rt2"},
                    "来是相当地根深蒂固。"
