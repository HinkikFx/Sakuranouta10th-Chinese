                {"vo", file = "fem_rik_000013", ch = "rik"}
            },
            ja = {
                {
                    name = {"丽华"},
                    "「就让我来告诉你这个什么都不知道的家伙吧，喜鹊花瓶……那个，",
                    {"rt2"},
                    "本该是要让给我的东西。明明和静流已经谈好了，那家伙却舍不得",
                    {"rt2"},
                    "了，把它藏了起来」"
