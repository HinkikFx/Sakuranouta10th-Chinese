            },
            ja = {
                {
                    name = {"里奈"},
                    "「不好的预感吗？」"
                }
            }
        },
        linkback = "block_00096",
        linknext = "block_00098"
    },
    block_00098 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嘛,如果只是这幅画,应该不至于发生那种事,可万一,有和千年樱相",
                    {"rt2"},
                    "同的想念与之共鸣的话……」"
                }
            }
        },
        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"fg", ch = "里奈", size = "z1", mode = 3, path = ":fg/rna/z1/", file = "rna_z1a0100", face = "a0008", head = "rna_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
