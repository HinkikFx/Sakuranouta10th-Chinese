            ja = {
                {
                    name = {"里奈"},
                    "「人与人的相遇……不,或许更甚于此吧。与作品的相遇,传递的东西",
                    {"rt2"},
                    "超越了语言」"
                }
            }
        },
        linkback = "block_00314",
        linknext = "block_00316"
    },
    block_00316 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2a0100", face = "a0010", head = "rna_z2a", lv = 5, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001821", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「樱日狂想吗……原来如此呢。比起第一次看到那幅画的时候,现在",
                    {"rt2"},
                    "的我,更能明白它的意义」"
                }
            }
        },
        linkback = "block_00315",
        linknext = "block_00317"
    },
    block_00317 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2a0100", face = "a0009", head = "rna_z2a", lv = 5, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001822", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「所以,恐怕不只是我,敏锐的女孩子,都会对学长有所警惕哦……」"
                }
            }
        },
        linkback = "block_00316",
        linknext = "block_00318"
    },
    block_00318 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么？　那是？　我被警惕了吗？」"
                }
            }
        },
        linkback = "block_00317",
        linknext = "block_00319"
    },
    block_00319 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2a0100", face = "a0001", head = "rna_z2a", lv = 5, id = 6},
        {"fgact", ch = "里奈", act = "うなづく", lv = 5, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001823", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那当然要警惕啦」"
                }
            }
        },
        linkback = "block_00318",
        linknext = "block_00320"
    },
    block_00320 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是那个吗？　川内野说的什么变态之类的？」"
                }
            }
        },
        linkback = "block_00319",
        linknext = "block_00321"
    },
    block_00321 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2a0100", face = "a0015", head = "rna_z2a", lv = 5, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001824", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「变态吗。原来如此,要这么说的话,学长比变态更恶劣」"
                }
            }
        },
        linkback = "block_00320",
        linknext = "block_00322"
    },
    block_00322 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「比变态更恶劣……」"
                }
            }
        },
        linkback = "block_00321",
        linknext = "block_00323"
    },
    block_00323 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2a0100", face = "a0001", head = "rna_z2a", lv = 5, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001825", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「你知道这样一种说法吗？」"
                }
            }
        },
        linkback = "block_00322",
        linknext = "block_00324"
    },
    block_00324 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2a0100", face = "a0002", head = "rna_z2a", lv = 5, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001826", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「明明和强奸一样恶劣,却被世间所容许的,恶的故事？」"
                }
            }
        },
        linkback = "block_00323",
        linknext = "block_00325"
    },
    block_00325 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,不知道……有那种东西吗？」"
                }
            }
        },
        linkback = "block_00324",
        linknext = "block_00326"
    },
    block_00326 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2a0100", face = "a0008", head = "rna_z2a", lv = 5, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001827", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「强奸,是强行夺走别人的身体吧,这是非常、非——常恶劣的事对吧」"
                }
            }
        },
        linkback = "block_00325",
        linknext = "block_00327"
    },
    block_00327 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那当然,听说刑期和杀人差不多」"
                }
            }
        },
        linkback = "block_00326",
        linknext = "block_00328"
    },
    block_00328 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2a0100", face = "a0010", head = "rna_z2a", lv = 5, id = 6},
        {"fgact", ch = "里奈", act = "うなづく", lv = 5, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001828", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是的,强奸是重罪。可是,",
                    {"txruby", text = "・・"},
                    "那个",
                    {"txruby"},
                    "却被世人堂而皇之地容许着」"
                }
            }
        },
        linkback = "block_00327",
        linknext = "block_00329"
    },
    block_00329 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那个是指什么？」"
                }
            }
        },
        linkback = "block_00328",
        linknext = "block_00330"
    },
    block_00330 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2a0100", face = "a0009", head = "rna_z2a", lv = 5, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001829", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「如果强行夺走身体是极恶劣的事,那么夺走人心,难道不也是恶劣",
                    {"rt2"},
                    "的事吗？」"
                }
            }
        },
        linkback = "block_00329",
        linknext = "block_00331"
    },
    block_00331 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,那,应该算不上坏事吧？」"
                }
            }
        },
        linkback = "block_00330",
        linknext = "block_00332"
    },
    block_00332 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2a0100", face = "a0008", head = "rna_z2a", lv = 5, id = 6},
        {"fgact", ch = "里奈", act = "いいえ", lv = 5, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001830", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不,才不是那样哦。被强行夺走心的人,说不定,和被强行夺走身体",
                    {"rt2"},
                    "的人一样痛苦……」"
                }
            }
        },
        linkback = "block_00331",
        linknext = "block_00333"
    },
    block_00333 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2a0100", face = "a0010", head = "rna_z2a", lv = 5, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001831", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「更何况,若是身心都被夺走,而那又是一份无法实现的感情的话……」"
                }
            }
        },
        linkback = "block_00332",
        linknext = "block_00334"
    },
    block_00334 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2a0100", face = "a0009", head = "rna_z2a", lv = 5, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001832", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「所以,我认为最该警惕的不是变态,而是爱」"
                }
