                {"vo", file = "fem_rna_001767", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「学长每次谈起千年樱传承的时候,都把传承说得像是真实存在的东",
                    {"rt2"},
                    "西一样呢」"
                }
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「千年樱是真的？　别开玩笑了。那种神神叨叨的东西,我最讨厌了」"
                }
