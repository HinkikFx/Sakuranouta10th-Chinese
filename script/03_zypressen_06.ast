        linkback = "block_00235",
        linknext = "block_00237"
    },
    block_00237 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以,你才生川内野的气吧。担心她做了那种事,会不会被卷进什",
                    {"rt2"},
                    "么麻烦里」"
                }
            }
