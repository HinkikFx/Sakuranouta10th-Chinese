        linkback = "block_00232",
        linknext = "block_00234"
    },
    block_00234 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我也说不好,但今早又出了那种事,不多加小心恐怕不妙……」"
