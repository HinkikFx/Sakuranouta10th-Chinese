        linknext = "block_00222"
    },
    block_00222 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「冰川,你怎么会来？」"
                }
            }
        },
        linkback = "block_00221",
        linknext = "block_00223"
    },
    block_00223 = {
        {"fg", ch = "里奈", size = "z1", mode = 3, path = ":fg/rna/z1/", file = "rna_z1d0100", face = "d0008", head = "rna_z1d", lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001774", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「现在,正好是体育课……」"
                }
            }
        },
        linkback = "block_00222",
        linknext = "block_00224"
    },
    block_00224 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「体育课……可是……你穿着制服……。啊,对了……你是见习啊」"
                }
            }
        },
        linkback = "block_00223",
        linknext = "block_00225"
    },
    block_00225 = {
        {"fg", ch = "里奈", size = "z1", mode = 3, path = ":fg/rna/z1/", file = "rna_z1d0100", face = "d0010", head = "rna_z1d", lv = 4, id = 6},
        {"fgact", ch = "里奈", act = "うなづく", lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001775", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是的,然后,看到学长在校门口被奇怪的人纠缠……」"
                }
            }
        },
        linkback = "block_00224",
        linknext = "block_00226"
    },
    block_00226 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊啊,说真的,帮大忙了……」"
                }
            }
        },
        linkback = "block_00225",
        linknext = "block_00227"
    },
    block_00227 = {
        {"fg", ch = "里奈", size = "z1", mode = 3, path = ":fg/rna/z1/", file = "rna_z1d0100", face = "d0009", head = "rna_z1d", lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001776", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那是谁啊？　学长的嗓门都变得很凶了……」"
                }
            }
        },
        linkback = "block_00226",
        linknext = "block_00228"
    },
    block_00228 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「好像自称长山香奈……。我记不太清了,不过似乎是我以前的同学」"
                }
            }
        },
        linkback = "block_00227",
        linknext = "block_00229"
    },
    block_00229 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「她好像在四处打探我的私事……」"
                }
            }
