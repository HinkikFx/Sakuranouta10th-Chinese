    },
    block_00091 = {
        {"fg", ch = "里奈", size = "z1", mode = 3, path = ":fg/rna/z1/", file = "rna_z1a0100", face = "a0004", head = "rna_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001765", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「有那种最后点上眼睛,画就活过来的故事对吧」"
                }
            }
        },
        linkback = "block_00090",
        linknext = "block_00092"
    },
    block_00092 = {
        {"fg", ch = "里奈", size = "z1", mode = 3, path = ":fg/rna/z1/", file = "rna_z1a0100", face = "a0001", head = "rna_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「画龙点睛」"
                }
            }
        },
        linkback = "block_00091",
        linknext = "block_00093"
    },
    block_00093 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「南北朝时代,南朝梁国有位画家“张僧繇”,传说他因为给自己画的龙",
                    {"rt2"},
                    "点上眼睛龙就会飞走,所以一直不肯点睛」"
                }
            }
        },
        linkback = "block_00092",
        linknext = "block_00094"
    },
    block_00094 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「周围的人不依不饶,点睛点睛地吵个不停,他无奈点了睛,结果龙真",
                    {"rt2"},
                    "的破顶而出,飞天而去。就是这么个故事」"
                }
            }
        },
        linkback = "block_00093",
        linknext = "block_00095"
    },
    block_00095 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「在我看来,这株樱花,和那是同一类的东西」"
                }
            }
        },
        linkback = "block_00094",
        linknext = "block_00096"
    },
    block_00096 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以,总有点不好的预感」"
                }
            }
        },
        linkback = "block_00095",
        linknext = "block_00097"
    },
    block_00097 = {
        {"fg", ch = "里奈", size = "z1", mode = 3, path = ":fg/rna/z1/", file = "rna_z1a0100", face = "a0009", head = "rna_z1a", x = -345, lv = 4, id = 5},
