    block_00282 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2a0100", face = "a0002", head = "rna_z2a", lv = 5, id = 6},
        {"fgact", ch = "里奈", act = "うなづく", lv = 5, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001802", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是的,今早的学长就跟偶像似的,那真是想搭话都不知道从哪开口,",
                    {"rt2"},
                    "所以优美才为我做了那种事」"
