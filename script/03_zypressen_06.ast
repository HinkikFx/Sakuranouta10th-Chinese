        linkback = "block_00231",
        linknext = "block_00233"
    },
    block_00233 = {
        {"fg", ch = "里奈", size = "z1", mode = 3, path = ":fg/rna/z1/", file = "rna_z1d0100", face = "d0011", head = "rna_z1d", lv = 4, id = 6},
