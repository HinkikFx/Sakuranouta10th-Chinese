        linkback = "block_00230",
        linknext = "block_00232"
    },
    block_00232 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不知为什么,那家伙看穿了那不是我的作品。是因为眼力,还是从",
                    {"rt2"},
                    "哪里弄到了情报,我就不清楚了……」"
