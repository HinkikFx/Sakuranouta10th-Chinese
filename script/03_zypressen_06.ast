        linkback = "block_00228",
        linknext = "block_00230"
    },
    block_00230 = {
        {"fg", ch = "里奈", size = "z1", mode = 3, path = ":fg/rna/z1/", file = "rna_z1d0100", face = "d0008", head = "rna_z1d", lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001777", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「果然是因为那幅壁画慕名而来的粉丝吗？」"
                }
