    },
    block_00324 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2a0100", face = "a0002", head = "rna_z2a", lv = 5, id = 6},
        {"text"},
        text = {
