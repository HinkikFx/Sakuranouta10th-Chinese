                {"vo", file = "fem_rna_001828", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是的，强暴是重罪。但是，",
                    {"txruby", text = "··"},
                    "那个",
                    {"txruby"},
                    "却被理所当然地宽恕了」"
                }
