        linknext = "block_00097"
    },
    block_00097 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2a0100", face = "a0028", head = "mak_z2a", lv = 5, id = 9},
