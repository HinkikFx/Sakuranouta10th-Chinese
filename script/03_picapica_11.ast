    block_00180 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, resize = 1, path = ":fg/mak/z2/", file = "mak_z2a0900", face = "a0001", head = "mak_z2a", lv = 5, id = 16},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003661", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「你的那幅画，如今装饰在市政厅的那幅画――『樱日狂想』。看到",
                    {"rt2"},
                    "那幅画，我停下了脚步。但是，圭却想要继续向前」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003662", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「圭是不折不扣的天才。正因如此……」"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
