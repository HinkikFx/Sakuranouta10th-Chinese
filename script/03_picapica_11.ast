                {"vo", file = "fem_mkd_003643", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「啊……也是呢。也有这方面的原因吧。最初只是为了赚钱，但是",
                    {"rt2"},
                    "做着做着就越来越开心了」"
                }
