        text = {
            vo = {
                {"vo", file = "fem_mkd_003666", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「所以，现在已经不是犹豫的时候了……我想了又想，终于，还是",
                    {"rt2"},
                    "下定了决心」"
