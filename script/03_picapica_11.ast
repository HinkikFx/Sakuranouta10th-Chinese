        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003664", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我不放弃。也不想放弃。所以，我会尽我所能」"
