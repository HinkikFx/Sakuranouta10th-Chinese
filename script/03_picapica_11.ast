        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「最初的动机是什么都无所谓。你的餐具，是充分考虑了被人拿在",
