                {"vo", file = "fem_mkd_003564", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「…………」"
                }
            }
        },
        linkback = "block_00218",
        linknext = "block_00220"
    },
    block_00220 = {
        {"text"},
        text = {
            ja = {
                {
                    "鸟谷低垂着目光，一遍又一遍地抚摸着封面。仿佛沉入了自己的思",
                    {"rt2"},
                    "绪之中。"
                }
            }
        },
        linkback = "block_00219",
        linknext = "block_00221"
    },
    block_00221 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003565", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「在爱之外被成就的东西。如果那是无人期盼的东西、是悲剧的话，",
                    {"rt2"},
                    "当然是大问题……」"
                }
            }
        },
        linkback = "block_00220",
        linknext = "block_00222"
    },
    block_00222 = {
        {"text"},
