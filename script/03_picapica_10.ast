        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「老家吗」"
                }
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"fgact", ch = "真琴", act = "うなづく", lv = 5, id = 16},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003558", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「对。鸟谷家的。腰封上写的那句话让人印象深刻，我记得很清楚」"
                }
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是句什么话？」"
                }
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2a0900", face = "a0028", head = "mak_z2a", x = 0, y = 50, lv = 5, id = 16},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003559", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「『爱无法成就，得以成就的净是爱以外之物。』」"
                }
            }
        },
        linkback = "block_00212",
        linknext = "block_00214"
    },
    block_00214 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「得以成就的净是爱以外之物……吗」"
                }
            }
        },
        linkback = "block_00213",
        linknext = "block_00215"
    },
    block_00215 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2a0900", face = "a0002", head = "mak_z2a", x = 0, y = 50, lv = 5, id = 16},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003560", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「有时候我会觉得特别不可思议。爱这种东西，为什么会被人们奉",
                    {"rt2"},
                    "为无比重要的事物」"
                }
            }
        },
        linkback = "block_00214",
        linknext = "block_00216"
    },
    block_00216 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003561", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「为了守护你而与全世界为敌，这种故事到处都泛滥着，那不就是",
                    {"rt2"},
                    "说，为了爱而与全世界为敌吗？」"
                }
            }
        },
        linkback = "block_00215",
        linknext = "block_00217"
    },
    block_00217 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2a0900", face = "a0026", head = "mak_z2a", x = 0, y = 50, lv = 5, id = 16},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003562", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「爱被当作一种理想、一种无与伦比的美好之物来讲述，爱与爱以",
                    {"rt2"},
                    "外的一切，被放上天平称量」"
                }
            }
        },
        linkback = "block_00216",
        linknext = "block_00218"
    },
    block_00218 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2a0900", face = "a0001", head = "mak_z2a", x = 0, y = 50, lv = 5, id = 16},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003563", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「爱与其余的一切，是等价的吗。天平是平衡的吗？」"
                }
            }
        },
        linkback = "block_00217",
        linknext = "block_00219"
    },
    block_00219 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2a0900", face = "a0027", head = "mak_z2a", x = 0, y = 50, lv = 5, id = 16},
