        linkback = "block_00218",
        linknext = "block_00220"
    },
    block_00220 = {
        {"text"},
        text = {
            ja = {
                {"鸟谷垂着眼帘，一遍遍抚摸封面。仿佛渐渐沉入自己的思绪之中。"}
            }
