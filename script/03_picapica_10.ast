    },
    block_00206 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「自己买的吗？」"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2a0900", face = "a0003", head = "mak_z2a", x = 0, y = 50, lv = 5, id = 16},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003556", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「怎么可能。店长一直把这本书搁在二楼，我就借来读了」"
                }
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            ja = {
                {"鸟谷抚摸着微微晒得泛黄的精装书封面。"}
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2a0900", face = "a0002", head = "mak_z2a", x = 0, y = 50, lv = 5, id = 16},
        {"text"},
        text = {
