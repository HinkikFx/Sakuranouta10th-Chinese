    block_00172 = {
        {"text"},
        text = {
            ja = {
                {"以专业为目标的人，练习时间是常人难以想象的。"}
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            ja = {
                {
                    "让普通人每天把十个小时专门用于某项练习持续数月，这种事不是",
                    {"rt2"},
                    "谁都做得到的。"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            ja = {
                {"但对于真心追求绘画、音乐等道路的人来说，这再普通不过。"}
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            ja = {
                {"三小时的睡眠和几十分钟的进食。其余时间全部用于练习。"}
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            ja = {
                {"如果是某条道路的专家，就必须能承受这种强度。"}
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            ja = {
                {"然而，圭的情况远超这个层次。"}
