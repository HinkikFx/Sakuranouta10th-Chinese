    },
    block_00196 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_syi_000233", ch = "syi"}
            },
            ja = {
                {
                    name = {"中村章一"},
                    "「不对。伯奇会吞噬他人心中的黑暗，所以无法长寿。最终会发疯",
