        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_snp_000004", ch = "snp"}
            },
            ja = {
                {
                    name = {"神父"},
                    "「嗯——，是吗……啊哈哈哈，大概是住院太久头脑有点迟钝了，总",
                    {"rt2"},
                    "觉得在哪里见过……啊哈哈哈」"
