    },
    block_00169 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0005", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000156", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「你因看见了我才信吗。那没有看见就信的有福了」"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「虽然不太懂，是圣经吗？」"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0003", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"fgact", ch = "小牧", act = "おじぎ", lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000157", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「猜对了呢。是的，'约翰福音第二十章第二十九节'，关于基督复活",
                    {"rt2"},
                    "的一段话」"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这倒不难猜，神父会引用的也只有圣经了吧……抱歉，圣经我实",
                    {"rt2"},
                    "在没什么素养，听不太明白」"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0002", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000158", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「说的是一个叫多马的人，非要看到被钉十字架留下的伤痕才肯相",
                    {"rt2"},
                    "信基督复活的故事」"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此，亲眼看到、亲自验证才肯'相信'的人，和凭信仰就相信",
                    {"rt2"},
                    "耶稣复活的人之间的差别吗……」"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0003", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000159", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「理解得真快」"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你看到千年樱的时候……神父就是说了这番话吗？」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0010", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000144", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「没人肯信她。不止如此，大家还说小牧是骗子」"
                }
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0004", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0001", head = "kom_z1a", x = 345, lv = 4, id = 6}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_kmd_000160", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「啊哈哈，我也是我，看到了就坚持说看到了。明明大家都说没有，",
                    {"rt2"},
                    "说没看到不就好了……」"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0006", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000145", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「但小牧还是说看到了。说看到了夏夜绽放的樱花……」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「怎么？　因此被欺负了吗？」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0010", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000161", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「倒没被欺负……」"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0011", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000146", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「被说是骗子……」"
                }
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0002", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000147_n", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「那时候神父大人说的是……」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0003", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000148", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「相信奇迹，不是用眼睛看到，不是用耳朵听到，不是身临其境，",
                    {"rt2"},
                    "也不是确证——只是相信」"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么都信的话就是傻瓜了……」"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0005", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000149", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「你什么意思」"
                }
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0002", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"fgact", ch = "小牧", act = "いいえ", lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000162", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「不，小沙智酱。他说得对」"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0008", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000150", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「小牧」"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0006", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000163", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「所谓相信，不是用眼睛看到，不是用耳朵听到，不是身临其境，",
                    {"rt2"},
                    "也不是去求证……只是相信」"
                }
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0007", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000164", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「但那不是盲目地什么都信。不是漫无目的地、为了不用思考而选",
                    {"rt2"},
                    "择相信。为了逃避思考而去信，那是怠惰」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是说，超越了言语所能表达的、甚至无法诉诸语言的那个彼方，",
                    {"rt2"},
                    "去相信那种东西，就是信仰？」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0003", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000165", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「大致就是那个意思」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不过，神父信的是上帝，并不等于他就信了你的话吧？　那'约翰",
                    {"rt2"},
                    "福音第二十章第二十九节'就有点不太对题了」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0002", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000166", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「是这样吗？」"
                }
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不是吗？」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0010", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000167", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「唔，太深奥的事我不太懂。确实，相信神的奇迹和相信小时候的",
                    {"rt2"},
                    "我说的话是两回事。这一点就连我也明白」"
                }
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0006", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000168", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「但是……但是……即便如此，神父大人还是把这句话送给了我们」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是啊……」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「太深奥的话我也不太明白。不过能说的是，人去相信某样东西，",
                    {"rt2"},
                    "最终不是靠'演绎'、不是靠'归纳'、不是靠'实证'、也不是靠'反证'」"
                }
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「人并非生来就懂得'怀疑'。不知道怀疑的人，不可能懂得'相信'……",
                    {"rt2"},
                    "人正是因为知道了'相信'，才初次能够学会'怀疑'」"
                }
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所谓相信，从来就没有什么确凿的证据吧」"
                }
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0004", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"fgact", ch = "小牧", act = "うんうん", lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000169", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「啊哈哈……草薙先生说的才更难懂」"
                }
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是啊……想要总结得漂亮一点结果完全不行……」"
                }
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「信上帝和信你说的话之间有巨大的鸿沟……但大概是一样的吧。",
                    {"rt2"},
                    "明明不同，却又是同一回事……」"
                }
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0001", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"fgact", ch = "小牧", act = "うなづく", lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000170", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「是的」"
                }
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0015", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000151", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「完全听不懂……」"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0003", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000171", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「没关系哦。草薙先生说的话太难了，我也完全听不懂」"
                }
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我也是」"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0006", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000152", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「你自己都不懂算怎么回事！不懂的事别叨叨个没完！害我不由自",
                    {"rt2"},
                    "主地认真想了半天！」"
                }
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那不挺好的嘛。思考是好事。越是去想、越是去怀疑，就越能理",
                    {"rt2"},
                    "解'相信'这件事」"
                }
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0005", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"fgact", ch = "小沙智", act = "いいえ", size = 5, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000153", ch = "ksd"}
            },
            ja = {
                {
