    block_00165 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「看到的东西未必就是它本来的样子。映入眼中的,也未必就是事实",
                    {"rt2"},
                    "本身」"
                }
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以,没有理由去否定你所看到的事实。那是不是弓张传说中的千",
                    {"rt2"},
                    "年樱我不知道,但你确实见到了一株不可思议的樱花吧」"
                }
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0004", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000155", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「呵呵……你说的话,和神父大人恰好完全相反呢」"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「神父是怎么说的?」"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0005", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000156", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「你因看见了我才信;那没有看见就信的,有福了」"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「听不太懂,是圣经吗?」"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0003", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"fgact", ch = "小牧", act = "おじぎ", lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000157", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「亏你猜得到呢。没错,是“约翰福音第20章第29节”,基督复活时的",
                    {"rt2"},
                    "一节」"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么亏我猜得到,神父会说的话,除了圣经还能有什么……,抱歉,我",
                    {"rt2"},
                    "对圣经毫无素养,完全不明白那是在讲什么」"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0002", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000158", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「说的是有个叫多马的人,坚称若不亲眼看见基督身上钉十字架的印",
                    {"rt2"},
                    "记,就绝不相信基督复活的故事哦」"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「原来如此,是说不亲眼所见、不确认那真相就“不信”的人,与凭着信",
                    {"rt2"},
                    "仰而相信耶稣复活的人,两者之间的差别吗……」"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0003", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000159", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「亏你能明白呢」"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你看见千年樱的时候……神父就是讲了这段话吗?」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0010", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000144", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「因为谁都不肯相信嘛。岂止如此,大家还众口一词地骂小牧是骗子」"
                }
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0004", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0001", head = "kom_z1a", x = 345, lv = 4, id = 6}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_kmd_000160", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「啊哈哈,我也是我,非要一口咬定看见的就是看见了。既然大家都",
                    {"rt2"},
                    "说不对,顺口说一句没看见不就好了嘛……」"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0006", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000145", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「可是,小牧还是说她看见了。说她看见了在夏夜绽放的樱花……」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「怎么?　你因此被欺负了吗?」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0010", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000161", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「倒是没有被欺负……」"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0011", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000146", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「却被人说成是骗子……」"
                }
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0002", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000147_n", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「那时候,神父大人对我们说……」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0003", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000148", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「所谓相信奇迹,不是用眼去看,不是用耳去听,不是身临其境,也不是",
                    {"rt2"},
                    "握有确证,而是单纯地去相信」"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不过要是什么都信,那就是傻瓜了……」"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0005", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000149", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「你说什么呢」"
                }
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0002", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"fgact", ch = "小牧", act = "いいえ", lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000162", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「不,小沙智。他说得对哦」"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0008", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000150", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「小牧」"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0006", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000163", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「所谓相信,不是用眼去看,不是用耳去听,不是身临其境,也不是加以",
                    {"rt2"},
                    "确证……而是单纯地去相信」"
                }
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0007", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000164", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「但那并不是什么都信。不是单纯地、盲目地、为了停止思考而去",
                    {"rt2"},
                    "相信｡为了停止思考而相信,那是怠惰」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「在言语的彼端、在连言说都无法企及的彼端存在的某种东西,去相",
                    {"rt2"},
                    "信那样的东西,才叫信仰,是这种感觉吗?」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0003", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000165", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「差不多就是这种感觉呢」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「可是,神父并不是以信神的那颗心,来相信你的话的吧?　这样的话,",
                    {"rt2"},
                    "“约翰福音第20章第29节”就有点文不对题了」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0002", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000166", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「是这样吗?」"
                }
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「难道不是吗?」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0010", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000167", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「唔,深奥的道理我不懂。相信神的奇迹,和相信还是孩子的我说的",
                    {"rt2"},
                    "话,确实是两回事。这两者毫无疑问是不同的,这点连我也明白」"
                }
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0006", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000168", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「可是……可是……即便如此,神父大人还是把这句话送给了我们」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是啊……」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「太深奥的话我不懂。只能说,人相信一件事,归根结底既不是靠“演",
                    {"rt2"},
                    "绎”,不是靠“归纳”,也不是靠“实证”或“证伪”吧」"
                }
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「人并不是生来就懂得“怀疑”的。不知怀疑为何物的人,自然也不可",
                    {"rt2"},
                    "能懂得“相信”……。人正是通过懂得了“相信”,才第一次懂得了“怀疑”」"
                }
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所谓相信,从来就是没有任何确证的东西吧」"
                }
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0004", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"fgact", ch = "小牧", act = "うんうん", lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000169", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「啊哈哈……草薙同学说的话才更难懂呢」"
                }
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是啊……本想漂亮地总结一下,结果完全不行……」"
                }
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「相信神,和相信你说的话,两者之间隔着巨大的鸿沟……,但恐怕又是",
                    {"rt2"},
                    "一样的。明明不同,却又是同一回事吧……」"
                }
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0001", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"fgact", ch = "小牧", act = "うなづく", lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000170", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「是的」"
                }
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"fg", ch = "小沙智", mode = 3, path = ":fg/kos/z1/", file = "kos_z1a0100", face = "a0015", head = "kos_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_ksd_000151", ch = "ksd"}
            },
            ja = {
                {
                    name = {"小沙智"},
                    "「完全搞不懂……」"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"fg", ch = "小牧", mode = 3, path = ":fg/kom/z1/", file = "kom_z1a0100", face = "a0003", head = "kom_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_kmd_000171", ch = "kmd"}
            },
            ja = {
                {
                    name = {"小牧"},
                    "「没关系的。草薙同学说的话,我也难懂得完全听不明白呀」"
                }
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我也是」"
