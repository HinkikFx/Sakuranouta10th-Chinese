        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我们时时刻刻都看着这样的光景,可看到这些,谁也不会因此认为",
