    },
    block_00394 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001722", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯,然后就看见优美在跑,几个外校生在后面追,我也就跟着追了上",
                    {"rt2"},
                    "去」"
                }
            }
        },
        linkback = "block_00393",
        linknext = "block_00395"
    },
    block_00395 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_002034", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「啊,对哦……。说起来逃跑的时候我好像喊得很大声……不过,就为",
                    {"rt2"},
                    "这么个理由,你就来找我了啊」"
                }
            }
        },
        linkback = "block_00394",
        linknext = "block_00396"
    },
    block_00396 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001723", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「什么叫就为这么个理由。对我来说这非常重要」"
                }
            }
