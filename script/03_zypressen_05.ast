        linkback = "block_00279",
        linknext = "block_00281"
    },
    block_00281 = {
        {"text"},
        text = {
            ja = {
                {
                    "说起来,我妈也总是把「体面……」什么的挂在嘴边烦个不停……。虽",
                    {"rt2"},
                    "然最近不怎么说了……。"
                }
            }
        },
        linkback = "block_00280",
        linknext = "block_00282"
    },
    block_00282 = {
        {"text"},
        text = {
            ja = {
                {"好像是因为我和里奈成了朋友。"}
