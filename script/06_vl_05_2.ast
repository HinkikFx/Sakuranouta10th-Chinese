        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「哪个都行。到底怎么了？」"
                }
            }
        },
        linkback = "block_00114",
        linknext = "block_00116"
    },
    block_00116 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004201", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「那就先说坏消息吧。先打开电视」"
                }
            }
        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「电视？」"
                }
            }
        },
        linkback = "block_00116",
        linknext = "block_00118"
    },
    block_00118 = {
        {"text"},
        text = {
            ja = {
                {
                    "我按她说的打开了电视。画面上播放着弓张学园，还有被蓝色挡板",
                    {"rt2"},
                    "遮盖的教堂画面。"
                }
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「被媒体报道了？」"
                }
            }
        },
        linkback = "block_00118",
        linknext = "block_00120"
    },
    block_00120 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004202", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我说过弓张不是铁板一块的嘛。看来有人向媒体泄露了消息」"
                }
            }
        },
        linkback = "block_00119",
        linknext = "block_00121"
    },
    block_00121 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「看来是这样……」"
                }
            }
        },
        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004203", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我换了好几个频道看了看，这个涂鸦事件好像挺有话题性的。哪",
                    {"rt2"},
                    "里都在播」"
                }
            }
        },
        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「看来是的。其他频道也有好几个在播。这样一来，就等着学校方",
                    {"rt2"},
                    "面的正式声明了」"
                }
            }
        },
        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004204", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「关于那个，弓张方面好像正在朝着尽快公布的方向协调。最快的",
                    {"rt2"},
                    "话，明天」"
                }
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「明天啊……嗯，大概就是那样吧」"
                }
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004205", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「嗯，明天召集记者，公布是布尔巴基作品的样子。说是再拖下去",
                    {"rt2"},
                    "会引起混乱」"
                }
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
