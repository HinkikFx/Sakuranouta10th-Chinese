    },
    block_00118 = {
        {"text"},
        text = {
            ja = {
                {
                    "我依言打开电视。画面上映出弓张学园，播放着盖着蓝色苫布的教",
                    {"rt2"},
                    "堂的影像。"
                }
            }
        },
        linkback = "block_00117",
        linknext = "block_00119"
    },
    block_00119 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「被媒体报道出来了？」"
                }
            }
        },
        linkback = "block_00118",
        linknext = "block_00120"
    },
    block_00120 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004202", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我说过他们内部并非铁板一块，看来是有人向媒体泄了密」"
                }
            }
        },
        linkback = "block_00119",
        linknext = "block_00121"
    },
    block_00121 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「看样子是……」"
                }
            }
        },
        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004203", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我开了好几个台看了看，涂鸦风波好像相当有话题性呢。哪个台",
                    {"rt2"},
                    "都在播」"
                }
            }
        },
        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「看来是啊。别的频道也播了好几条。这样一来，就等学校方面的",
                    {"rt2"},
                    "正式发表了」"
                }
            }
        },
        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004204", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「关于这个，弓张那边好像正在协调，准备尽快公布。最快的话，",
                    {"rt2"},
                    "就在明天」"
                }
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「明天吗……嘛，差不多也该是这样」"
                }
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004205", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「嗯，明天，他们打算召集记者，公布那是布尔巴基的作品。说是",
                    {"rt2"},
                    "再拖下去，会引起混乱」"
                }
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"msgoff"},
