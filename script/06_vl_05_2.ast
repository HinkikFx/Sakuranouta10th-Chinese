        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊啊，本来遗产我全都放弃了，可不知怎么的，就因为那件作品",
                    {"rt2"},
                    "是我主导完成的，这些图案又被退还了回来……」"
                }
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1f0000", face = "f0003", head = "mak_z1f", x = -345, lv = 4, id = 5},
        {"text"},
