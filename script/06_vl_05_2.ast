        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1f0000", face = "f0001", head = "mak_z1f", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
