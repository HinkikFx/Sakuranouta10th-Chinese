        text = {
            vo = {
                {"vo", file = "fem_mkd_004176", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「哦？然后呢？然后呢？这里面藏着什么样的提示？」"
                }
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这捆文件里，混着大量被草薙健一郎废弃的图案。数量足足是被",
