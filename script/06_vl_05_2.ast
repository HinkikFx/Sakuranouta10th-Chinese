        linkback = "block_00128",
        linknext = "block_00130"
    },
    block_00130 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_004207", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「所以说呀，井上理事果然对被村山理事抢先一步的事耿耿于怀。",
                    {"rt2"},
                    "说是想让他在媒体面前哑口无言呢」"
                }
