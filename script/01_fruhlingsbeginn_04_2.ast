            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_000667", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「嗯,比如说,现在才开始画画的人是什么心情呢?不是从小时候,而是",
                    {"rt2"},
                    "从懂事明理的年纪开始画画,是什么样的心情?需要什么样的契机呢。",
                    {"rt2"},
                    "就是这些」"
