                {"vo", file = "fem_mkd_000662", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「就是这家伙对我们美术部产生兴趣的理由」"
                }
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「猥亵目的吧」"
                }
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2d0200", face = "d0015", head = "mak_z2d", lv = 5, id = 9},
        {"fgact", ch = "真琴", act = "うなづく", lv = 5, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2d0200", face = "d0012", head = "mak_z2d", lv = 5, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_000663", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「确实没错。不过,他的说法稍微有点不一样。照这外国人的说法,",
                    {"rt2"},
                    "光是有美丽的模特在,艺术欲就会高涨。他说,想画画的冲动就是这",
                    {"rt2"},
                    "样产生的」"
                }
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不不,画了这么多年画的你应该明白,才没有这么蠢的理由吧」"
                }
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2d0200", face = "d0016", head = "mak_z2d", lv = 5, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2d0200", face = "d0003", head = "mak_z2d", lv = 5, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_000664", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「所以说啊,这一点很微妙。不管是我、是圭还是你,不都是从小画",
                    {"rt2"},
                    "画过来的吗。记事的时候就已经在画画了」"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嘛,是这样没错」"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2d0200", face = "d0011", head = "mak_z2d", lv = 5, id = 9},
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2d0200", face = "d0016", head = "mak_z2d", lv = 5, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_mkd_000665", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「正因如此,一切都太理所当然,反而搞不清楚开始画画的契机到底",
                    {"rt2"},
                    "是什么了。就是那种从没画过画的人突然提笔的动机?这个越想越",
                    {"rt2"},
                    "想不明白」"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「画画的契机吗……」"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            ja = {
                {"被这么一说,我也毫无头绪。"}
