        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"text"},
        text = {
            ja = {
                {"甚至有人在展览会上挥舞着手杖大闹。"}
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            ja = {
                {"不过，那些恶评本身就是马奈的目的所在……"}
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"text"},
        text = {
            ja = {
                {
                    "在《奥林匹亚》之前，画裸体女性这一行为，就等同于描绘",
                    {"txruby", text = "维纳斯"},
                    "女神",
                    {"txruby"},
                    "。"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            ja = {
                {
                    "即使画家本人并没有打算画",
                    {"txruby", text = "维纳斯"},
                    "女神",
                    {"txruby"},
                    "，像那样处理也是当时的常识。"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"text"},
        text = {
            ja = {
                {"画裸体需要一个正当的名义。"}
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"text"},
        text = {
            ja = {
                {"而马奈故意无视了这一点。"}
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"text"},
        text = {
            ja = {
                {"穿旧了的凉鞋。"}
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
    block_00082 = {
        {"text"},
        text = {
            ja = {
                {"金色的手镯。"}
            }
        },
        linkback = "block_00081",
        linknext = "block_00083"
    },
    block_00083 = {
        {"text"},
        text = {
            ja = {
                {"脖子上黑色的丝带项圈。"}
            }
        },
        linkback = "block_00082",
        linknext = "block_00084"
    },
    block_00084 = {
        {"text"},
        text = {
            ja = {
                {
                    "躺在白色床单上的姿态，包括构图在内，都与马奈三百多年前的画",
                    {"rt2"},
                    "家提香的作品《乌尔比诺的维纳斯》极为相似，"
                }
            }
        },
        linkback = "block_00083",
        linknext = "block_00085"
    },
    block_00085 = {
        {"text"},
        text = {
            ja = {
                {
                    "但那生动逼真的细节，却将其与三百年前提香所画的\"维纳斯\"在意",
                    {"rt2"},
                    "义上完全区分开来。"
                }
            }
        },
        linkback = "block_00084",
        linknext = "block_00086"
    },
    block_00086 = {
        {"text"},
        text = {
            ja = {
                {"当时在法国，\"奥林匹亚\"正是\"娼妓\"的通称。"}
            }
        },
        linkback = "block_00085",
        linknext = "block_00087"
    },
    block_00087 = {
        {"text"},
        text = {
            ja = {
                {"站在娼妓身后的黑人女仆手中所持之物。"}
            }
        },
        linkback = "block_00086",
        linknext = "block_00088"
    },
    block_00088 = {
        {"text"},
        text = {
            ja = {
                {"娼妓脚边站着的黑猫。"}
            }
        },
        linkback = "block_00087",
        linknext = "block_00089"
    },
    block_00089 = {
        {"text"},
        text = {
            ja = {
                {"一切都经过了精密的计算。"}
            }
        },
        linkback = "block_00088",
        linknext = "block_00090"
    },
    block_00090 = {
        {"text"},
        text = {
            ja = {
                {"知道了缘由之后，在展览会上挥舞手杖大闹的人也就能理解了。"}
            }
        },
        linkback = "block_00089",
        linknext = "block_00091"
    },
    block_00091 = {
        {"text"},
        text = {
            ja = {
                {"因为据说去过妓院的人，就一定熟悉这种独特的氛围。"}
            }
        },
        linkback = "block_00090",
        linknext = "block_00092"
    },
    block_00092 = {
        {"text"},
        text = {
            ja = {
                {"身后女仆手中之物是\"花束\"。自然是客人送的礼物。"}
            }
        },
        linkback = "block_00091",
        linknext = "block_00093"
    },
    block_00093 = {
        {"text"},
        text = {
            ja = {
                {
                    "脚边画着的猫睁大了眼睛，四肢僵直、弓起背脊，一副紧张的样子。",
                    {"rt2"},
                    "看起来甚至像是在威吓来访者。"
                }
            }
        },
        linkback = "block_00092",
        linknext = "block_00094"
    },
    block_00094 = {
        {"text"},
        text = {
            ja = {
                {"那么这个来访者是谁呢。"}
            }
        },
        linkback = "block_00093",
        linknext = "block_00095"
    },
    block_00095 = {
        {"text"},
        text = {
            ja = {
                {"当然，就是来买春的客人。"}
            }
        },
        linkback = "block_00094",
        linknext = "block_00096"
    },
    block_00096 = {
        {"text"},
        text = {
            ja = {
                {"而那个来访者的视角，恰好与观画者的视角重合。"}
            }
        },
        linkback = "block_00095",
        linknext = "block_00097"
    },
    block_00097 = {
        {"text"},
        text = {
            ja = {
                {
                    "正因如此，对于有过那种经历的人来说，这幅画会给人一种独特的",
                    {"rt2"},
                    "感觉。"
                }
            }
        },
        linkback = "block_00096",
        linknext = "block_00098"
    },
    block_00098 = {
        {"text"},
        text = {
            ja = {
                {"一种独特的不适感。"}
            }
        },
        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            ja = {
                {"在画前挥舞手杖的男子人所感受到的，大概就是这样的东西吧……"}
