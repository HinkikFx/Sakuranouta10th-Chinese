        {"bg", file = "ev_uni_c11_01", path = ":ev/ev_uni_c11/", set = "ev_uni_c11"},
        {"text"},
        text = {
            ja = {
                {"法国画家爱德华·马奈的代表作之一。那就是『奥兰匹亚』。"}
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"text"},
        text = {
            ja = {
                {"据说在发表当时,这幅裸妇画引起了轩然大波。"}
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            ja = {
                {"据说报纸上给出的净是「母猩猩」「无赖小丫头」之类的恶评。"}
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"text"},
        text = {
            ja = {
                {"据说甚至有人在展览会上挥舞手杖大闹了一场。"}
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            ja = {
                {"话虽如此,那些恶评本身,正是马奈的意图所在……。"}
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"text"},
        text = {
            ja = {
                {
                    "在『奥兰匹亚』之前。描绘裸体女人这一行为,便等同于描绘",
                    {"txruby", text = "维纳斯"},
                    "女神",
                    {"txruby"},
                    "的",
                    {"rt2"},
                    "行为。"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            ja = {
                {
                    "哪怕画家本人并无描绘",
                    {"txruby", text = "维纳斯"},
                    "女神",
                    {"txruby"},
                    "之意,把画面修饰得像那么回事,才是当",
                    {"rt2"},
                    "时的常识。"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"text"},
        text = {
            ja = {
                {"也就是说,描绘裸妇需要大义名分。"}
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"text"},
        text = {
            ja = {
                {"而马奈偏偏对此视而不见。"}
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"text"},
        text = {
            ja = {
                {"穿旧了的凉鞋。"}
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
    block_00082 = {
        {"text"},
        text = {
            ja = {
                {"金手镯。"}
            }
        },
        linkback = "block_00081",
        linknext = "block_00083"
    },
    block_00083 = {
        {"text"},
        text = {
            ja = {
                {"颈间的黑色缎带项圈。"}
            }
        },
        linkback = "block_00082",
        linknext = "block_00084"
    },
    block_00084 = {
        {"text"},
        text = {
            ja = {
                {
                    "横卧于白色床单上的身姿,连同构图在内,虽与早于马奈300多年的画",
                    {"rt2"},
                    "家提香的作品『乌尔比诺的维纳斯』如出一辙,"
                }
            }
        },
        linkback = "block_00083",
        linknext = "block_00085"
    },
    block_00085 = {
        {"text"},
        text = {
            ja = {
                {
                    "但那生动逼真的细节,却将它与300年前的画家提香的“维纳斯”及其",
                    {"rt2"},
                    "意涵,彻底割裂开来。"
                }
            }
        },
        linkback = "block_00084",
        linknext = "block_00086"
    },
    block_00086 = {
        {"text"},
        text = {
            ja = {
                {"在当时的法国,“奥兰匹亚”正是“娼妓”的代称。"}
            }
        },
        linkback = "block_00085",
        linknext = "block_00087"
    },
    block_00087 = {
        {"text"},
        text = {
            ja = {
                {"立于娼妓身后的黑人女仆手中所持之物。"}
            }
        },
        linkback = "block_00086",
        linknext = "block_00088"
    },
    block_00088 = {
        {"text"},
        text = {
            ja = {
                {"立于娼妓脚边的,黑猫。"}
            }
        },
        linkback = "block_00087",
        linknext = "block_00089"
    },
    block_00089 = {
        {"text"},
        text = {
            ja = {
                {"一切都经过精心计算。"}
            }
        },
        linkback = "block_00088",
        linknext = "block_00090"
    },
    block_00090 = {
        {"text"},
        text = {
            ja = {
                {
                    "知道了缘由,便不难理解为何有人在展览会上看到这幅画后,会挥舞",
                    {"rt2"},
                    "手杖大闹一场。"
                }
            }
        },
        linkback = "block_00089",
        linknext = "block_00091"
    },
    block_00091 = {
        {"text"},
        text = {
            ja = {
                {"据说那是因为,凡是买过娼妓的人,都熟悉这种独特的氛围。"}
            }
        },
        linkback = "block_00090",
        linknext = "block_00092"
    },
    block_00092 = {
        {"text"},
        text = {
            ja = {
                {"身后女仆手中捧着的是“花束”。当然,是客人送的礼物。"}
            }
        },
        linkback = "block_00091",
        linknext = "block_00093"
    },
    block_00093 = {
        {"text"},
        text = {
            ja = {
                {
                    "画在脚边的猫瞪大双眼,四肢紧绷,弓起背脊,一副戒备之态。看上去",
                    {"rt2"},
                    "甚至像是在威吓来访者。"
                }
            }
        },
        linkback = "block_00092",
        linknext = "block_00094"
    },
    block_00094 = {
        {"text"},
        text = {
            ja = {
                {"那位来访者又会是谁呢。"}
            }
        },
        linkback = "block_00093",
        linknext = "block_00095"
    },
    block_00095 = {
        {"text"},
        text = {
            ja = {
                {"当然。是前来买春的客人。"}
            }
        },
        linkback = "block_00094",
        linknext = "block_00096"
    },
    block_00096 = {
        {"text"},
        text = {
            ja = {
                {"而那位来访者的视点,恰恰与观看这幅画的人的视点重合。"}
            }
        },
        linkback = "block_00095",
        linknext = "block_00097"
    },
    block_00097 = {
        {"text"},
        text = {
            ja = {
                {"正因如此,对心中有数的人而言,这幅画会给予一种独特的感受。"}
            }
        },
        linkback = "block_00096",
        linknext = "block_00098"
    },
    block_00098 = {
        {"text"},
        text = {
            ja = {
                {"令人感到一种独特的不快。"}
            }
        },
        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            ja = {
                {"看到这幅画便挥起手杖的男子人,心中所感,大概就是这种东西吧……。"}
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"text"},
        text = {
            ja = {
                {"『奥兰匹亚』对我而言,是再熟悉不过的画作之一。"}
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            ja = {
                {
                    "理由自不必说。因为夏目家的门口,一直挂着一幅『奥兰匹亚』的摹",
                    {"rt2"},
                    "本。"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"text"},
        text = {
            ja = {
                {
                    "那个心灵手巧的男子人画出的画,与其说是摹本,不如说已是赝品的",
                    {"rt2"},
                    "水准。"
                }
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"text"},
        text = {
            ja = {
                {"绘制者是草薙健一郎。"}
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            ja = {
                {"前不久刚刚去世。世界级的艺术家。"}
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            ja = {
                {"那是他成名之前画的作品。"}
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            ja = {
                {
                    "那幅画就算被当作『奥兰匹亚』的习作直接流入市场,大半的人也看",
                    {"rt2"},
                    "不出破绽吧。"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            ja = {
                {
                    "搞不好,连著名美术馆的策展人都识不破,就那么挂进展览会也说不",
                    {"rt2"},
                    "定。"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
