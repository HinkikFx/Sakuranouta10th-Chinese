    },
    block_00161 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001236", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「这家伙的话,这里大概要挑刺,那里大概会认同,我多少能感觉出来。",
                    {"rt2"},
                    "对吧,吹」"
                }
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"bg", file = "ev_com_f06_02", path = ":ev/ev_com_f06/", set = "ev_com_f06"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_sud_000574", ch = "sud"}
            },
            ja = {
                {
                    name = {"吹"},
                    "「是啊。健一郎先生的画虽然问题多多,不过嘛,单论画的话,我们算",
                    {"rt2"},
                    "是心有灵犀吧?」"
