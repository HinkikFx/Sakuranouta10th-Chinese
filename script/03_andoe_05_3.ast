        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            ja = {
                {
                    "明明是各自都不该成立的对话,不知何时,却成了有来有往的真正交",
                    {"rt2"},
                    "谈。"
