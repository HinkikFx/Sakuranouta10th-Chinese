        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_sud_000575", ch = "sud"}
            },
            ja = {
                {
                    name = {"吹"},
                    "「那也是没办法的事。在天才的吹看来,健一郎先生的画还差得远呢」"
