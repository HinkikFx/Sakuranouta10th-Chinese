        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_sud_000576", ch = "sud"}
            },
            ja = {
                {
                    name = {"吹"},
                    "「哼,无聊的挑衅。嘛,等我回到原本的身体时,再让健一郎先生好好",
