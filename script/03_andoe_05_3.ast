    },
    block_00143 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001229", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「吹,只有雫一个人陪着也寂寞吧?尽管放开了跟我搭话就是」"
                }
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_001786", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「健一郎先生也看得见?」"
