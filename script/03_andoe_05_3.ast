    },
    block_00146 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001231", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「只是啊。雫一个人也寂寞,吹一个人不也寂寞吗?我在这边伙伴不",
                    {"rt2"},
                    "少,可你们俩朋友太少了」"
                }
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
