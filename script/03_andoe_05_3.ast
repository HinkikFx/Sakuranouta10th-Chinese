        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_sud_000577", ch = "sud"}
            },
            ja = {
                {
                    name = {"吹"},
                    "「嘛,唯独那幅《横卧之樱》,吹还是稍微认可的。那幅画嘛,大概相",
                    {"rt2"},
                    "当于状态不太好的吹,在觉得『状态不好却画得还行嘛』的时候画出",
                    {"rt2"},
                    "来的画——好到勉强能赢过那种程度」"
                }
            }
