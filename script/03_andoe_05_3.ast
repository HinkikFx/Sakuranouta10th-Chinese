        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            ja = {
                {"我曾问过健一郎先生。"}
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"bg", file = "ev_com_f06_01", path = ":ev/ev_com_f06/", set = "ev_com_f06"},
