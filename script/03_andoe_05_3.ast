        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001230", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「怎么可能,什么也看不见,也听不见啊」"
