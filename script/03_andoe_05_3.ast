            }
        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001237", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「你,刚才,是不是说我的画有问题?」"
