        text = {
            vo = {
                {"vo", file = "man_kid_001225", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那种程度的具现化能力……真能一直安分地待在雫的身体里吗?」"
                }
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_001783", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
