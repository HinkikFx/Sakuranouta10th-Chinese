            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_szd_001789", ch = "szd"}
            },
            ja = {
                {
                    name = {"雫"},
                    "「在画这方面?」"
