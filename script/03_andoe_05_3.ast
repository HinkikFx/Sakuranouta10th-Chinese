    },
    block_00135 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001224", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「雫吞下去的那个东西啊。那可是了不得的东西。就像是能无中生",
                    {"rt2"},
                    "有的,那种东西」"
                }
            }
        },
        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
