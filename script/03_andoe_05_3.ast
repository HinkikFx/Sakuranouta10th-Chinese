        text = {
            vo = {
                {"vo", file = "man_kid_001232", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「那样的话,也让我加入你们这一伙吧」"
                }
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_kid_001233", ch = "kid"}
            },
            ja = {
                {
                    name = {"健一郎"},
                    "「行吗?吹」"
                }
            }
        },
        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
