        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"text"},
        text = {
            ja = {
                {
                    "在外面吃饭时,也不坐双人座,一定要三人座。还让人备好吹的那份",
                    {"rt2"},
                    "饭菜。"
                }
            }
        },
        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            ja = {
                {"健一郎先生不只跟我说话,也向那个看不见的座位搭话。"}
