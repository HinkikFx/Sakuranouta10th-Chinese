        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100306", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「是,我明白的。直君总是这样,为了不让我受伤,对我说温柔的话」"
