    },
    block_00202 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100371", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「啊，这个，乳头的，极限……在，擦着……是吧？但是？就那样？？",
