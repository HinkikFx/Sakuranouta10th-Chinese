    },
    block_00008 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100305", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「我一边对直君说不许想色色的事,自己却是这副德性。我觉得必须",
