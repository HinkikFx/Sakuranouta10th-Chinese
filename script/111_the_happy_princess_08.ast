        linkback = "block_00248",
        linknext = "block_00250"
    },
    block_00250 = {
        {"text"},
        text = {
            ja = {
                {"至今为止微弱的刺激一下子变成了强烈的刺激。"}
            }
        },
        linkback = "block_00249",
        linknext = "block_00251"
    },
    block_00251 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「刚才也说过,硅系润滑液有持久的优点。而且滑度也相当好,所以",
                    {"rt2"},
                    "最后就算装到乳头被连续强烈刺激的程度,也没有问题」"
                }
            }
        },
        linkback = "block_00250",
        linknext = "block_00252"
    },
    block_00252 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100380", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「没,没问题!?　什,咿咿?!　嗯啊!?　嗯啊啊!?　不行,总觉得,这个,好",
                    {"rt2"},
                    "厉害,刺激,太强……了啊,嗯咕呜!?」"
                }
            }
        },
        linkback = "block_00251",
        linknext = "block_00253"
    },
    block_00253 = {
        {"text"},
        text = {
            ja = {
                {"直君再次坐到了我的面前。"}
