                }
            }
        },
        linkback = "block_00225",
        linknext = "block_00227"
    },
    block_00227 = {
        {"text"},
        text = {
            ja = {
                {"屁股的中心部从两腿之间滑了出去。于是阴蒂就直接触到了地板。"}
            }
        },
        linkback = "block_00226",
        linknext = "block_00228"
    },
    block_00228 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「为了不让你摔倒,我就这样按着你的肩膀吧?」"
                }
            }
        },
        linkback = "block_00227",
        linknext = "block_00229"
    },
    block_00229 = {
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100376", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「啊,不,不是,哈咿,呀呜!　喵啊!　哈咿咿,嗯呀啊啊?!」"
                }
            }
        },
        linkback = "block_00228",
        linknext = "block_00230"
    },
    block_00230 = {
        {"text"},
        text = {
            ja = {
                {"直君每按一下肩膀,阴蒂就被压向地板。"}
            }
        },
        linkback = "block_00229",
        linknext = "block_00231"
    },
    block_00231 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「咦?　难道说?　脚麻了?　所以身体才这样一抽一抽地痉挛?　毕",
                    {"rt2"},
                    "竟一直跪坐在地板上」"
                }
            }
        },
        linkback = "block_00230",
        linknext = "block_00232"
    },
    block_00232 = {
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100377", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「不,不是,不是的……嗯呀啊啊?!　是直君,是直君,把我的肩膀往下压",
                    {"rt2"},
                    ",嗯唔,那里,压到了地板,那里,被压住了――嗯呀啊啊?!」"
                }
            }
        },
        linkback = "block_00231",
        linknext = "block_00233"
    },
    block_00233 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊啊,抱歉,抱歉,是那边啊。总觉得,看着你快摔倒了,有点担心」"
                }
            }
        },
        linkback = "block_00232",
        linknext = "block_00234"
    },
    block_00234 = {
        {"text"},
        text = {
            ja = {
                {"话虽如此,直君的手却没有从我肩上放开。"}
            }
        },
        linkback = "block_00233",
        linknext = "block_00235"
    },
    block_00235 = {
        {"text"},
        text = {
            ja = {
                {"这是明知故犯。"}
            }
        },
        linkback = "block_00234",
        linknext = "block_00236"
    },
    block_00236 = {
        {"text"},
        text = {
            ja = {
                {
                    "说起来直君,连说话方式都和平时不一样……是在扮演着角色……。直",
                    {"rt2"},
                    "君他,是故意的,在吊我胃口欺负我……。"
                }
            }
        },
        linkback = "block_00235",
        linknext = "block_00237"
    },
    block_00237 = {
        {"text"},
        text = {
            ja = {
                {"好厉害,竟然能把我的心思,看穿到这种地步……。"}
            }
        },
        linkback = "block_00236",
        linknext = "block_00238"
    },
    block_00238 = {
        {"text"},
        text = {
            ja = {
                {"简直和我的妄想一模一样……不,是比那远远更棒的情境。"}
            }
        },
        linkback = "block_00237",
        linknext = "block_00239"
    },
    block_00239 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「什么嘛,我还以为你从刚才开始腰就一耸一耸的,是因为脚麻了呢」"
                }
            }
        },
        linkback = "block_00238",
        linknext = "block_00240"
    },
    block_00240 = {
        {"text"},
        text = {
            ja = {
                {
                    "要是真那么想,平时的直君早就会让我把腿松开了。他分明察觉到了",
                    {"rt2"},
                    ",我光靠乳头的刺激,下体的瘙痒就已经到达了顶点。"
                }
            }
        },
        linkback = "block_00239",
        linknext = "block_00241"
    },
    block_00241 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不过啊。跪坐着还这么不稳的话,很危险。禀……从现在开始,禁止",
                    {"rt2"},
                    "耸腰……」"
                }
            }
        },
        linkback = "block_00240",
        linknext = "block_00242"
    },
    block_00242 = {
        {"mwact", act = "いいえ", size = 5},
        {"text"},
        text = {
            ja = {
                {"――一阵战栗。"}
            }
        },
        linkback = "block_00241",
        linknext = "block_00243"
    },
    block_00243 = {
        {"text"},
        text = {
            ja = {
                {"直君在耳边用低沉的声音呢喃。"}
            }
        },
        linkback = "block_00242",
        linknext = "block_00244"
    },
    block_00244 = {
        {"text"},
        text = {
            ja = {
                {"那声音从我的耳朵,乘上血流,爱抚着大脑和性器。"}
            }
        },
        linkback = "block_00243",
        linknext = "block_00245"
    },
    block_00245 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100378", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「就,就这样……的话……光,光靠……乳,乳头……啊呜!　要,要去……了…",
                    {"rt2"},
                    "…嗯咕哦哦!?　哦哦?」"
                }
            }
        },
        linkback = "block_00244",
        linknext = "block_00246"
    },
    block_00246 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那我也想看看呢?　差不多可以了吧?」"
                }
            }
        },
        linkback = "block_00245",
        linknext = "block_00247"
    },
    block_00247 = {
        {"text"},
        text = {
            ja = {
                {
                    "说着,直君将乳头罩用力按了上来。罩子像要把胸部吸进去似的,紧",
                    {"rt2"},
                    "紧吸附在我的胸上。"
                }
            }
        },
        linkback = "block_00246",
        linknext = "block_00248"
    },
    block_00248 = {
        {"text"},
        text = {
            ja = {
                {"然后放开了扶着我的手。"}
            }
        },
        linkback = "block_00247",
        linknext = "block_00249"
    },
    block_00249 = {
        {"bg", file = "ev_app_h11_16", sync = 0, face = 1, time = 400, path = ":ev/ev_app_h11/", set = "ev_app_h11"},
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100379", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「?!　?!　!!??　?!嗯呀呀╱﹀╲/╲︿嗯啾呜_/︺╲▁嗯嗯嗯嗯嗯―",
                    {"rt2"},
                    "―︹_/﹀╲/╲︿_/︺╲▁嗯嗯――嗯呀啊啊?!」"
                }
