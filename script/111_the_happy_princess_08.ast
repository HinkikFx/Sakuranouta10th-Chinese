    block_00183 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100362", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「直君……那个,能实际演示一下吗?」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「实际演示?　啊啊,那当然,我会在禀身上好好演示的」"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100363", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「不,不是那个意思,我是想看……用乳头罩做着乳头自慰的直君」"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我的事先放一边,总之是想让禀安心地试用一下乳头罩的意思」"
                }
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            ja = {
                {
                    "不,直君用乳头罩乳头自慰的事才不能随便放一边好吗?人家想看直",
                    {"rt2"},
                    "君的乳头自慰啊!?"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嘛,嘛,总之就当被我骗一次……」"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            ja = {
                {"说着,直君把乳头罩按在我的胸上。"}
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"bg", file = "ev_app_h11_12", sync = 0, face = 1, time = 400, path = ":ev/ev_app_h11/", set = "ev_app_h11"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100364", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「嗯?」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            ja = {
                {"直君把乳头罩装在我的胸上,装得特别浅。"}
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100365", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「那个……大概,这样的话……」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「会啪嗒啪嗒地掉下来对吧?　嘛,那也是没办法的。就是这种将掉",
                    {"rt2"},
                    "未掉的程度才刚刚好哦」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            ja = {
                {"的确,是将掉未掉的极限程度……可是,为什么要这样――。"}
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"se", file = "se9100", loop = 1, id = 1},
        {"bg", file = "ev_app_h11_13", sync = 0, face = 1, time = 400, path = ":ev/ev_app_h11/", set = "ev_app_h11"},
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100366", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「?!　?!!!??　︿嗯啊?!嗯嗯╱﹀╲/╲︿嗯啾呜_/︺╲▁︹_/﹀╲/",
                    {"rt2"},
                    "╲︿_/︺╲▁嗯嗯嗯――嗯呀啊啊?!」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            ja = {
                {"和预想完全不同的快感袭向我。"}
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100367", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「诶?　什么?　诶?　这是什么!?　咿咕!?　什,什么啊!?　这个?　",
                    {"rt2"},
                    "嗯呀啊啊?!」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100368", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「不吱道……不知道啊……嗯呀,嗯啾呜呜呜,这,这种――感觉,人家不吱",
                    {"rt2"},
                    "道啊啊」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100369", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「好厉――害害,直……太厉害了……为什么,哦?　哦哦?　哦哦哦??　",
                    {"rt2"},
                    "嗯哦?　嗯哦?　嗯哦?」"
                }
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            ja = {
                {"这个,好厉害……和自己用的时候……完全,不一样……。"}
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100370", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「为什么?　会这样?　哈咿咿?!　不一样!?　的哦哦??」"
                }
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100371", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「啊,这是在,擦着乳头的、边缘……的极限……吗?　可是?　就只是",
                    {"rt2"},
                    "那样??　嗯呀!?　好厉害?　乳头能有这么?　强烈的感觉吗!??」"
                }
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「当然,不是光靠乳头罩就能那么舒服的哦。事前不是狠狠地吊了胃",
                    {"rt2"},
                    "口,一直只欺负乳晕吗?　靠那个,乳头已经敏感到极限了」"
                }
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100372", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「就算是那样?　嗯喵?　嗯哦?　嗯哦哦!?　嗯喵!?　为,为什么,这",
                    {"rt2"},
                    "个……,乳头,被嗖、嗖地……嗯呀呜呜」"
                }
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「狠狠吊足胃口是很重要的。其次,这东西大家总容易把乳头对准罩",
                    {"rt2"},
                    "子的正中心,但不稍微错开中心的话,褶皱就没法好好刺激乳头哦」"
                }
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            ja = {
                {
                    "的确……被这么一说,这东西是从褶皱的中心开始旋转的,就算把乳头",
                    {"rt2"},
                    "对在那里,刺激也可能比想象中要少。"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            ja = {
                {
                    "因为感觉刺激不够,就会让罩子相当用力地吸住胸部。于是,那旋转",
                    {"rt2"},
                    "就变得毫无抑扬,只是单调地持续刺激乳头而已。"
                }
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            ja = {
                {
                    "可是,直君的设置,是浅浅地装上乳头罩,再从中心稍稍错开,让褶皱的",
                    {"rt2"},
                    "尖端在势头最强的时候扫过乳头。"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            ja = {
                {
                    "那安装方式绝妙无比,每当身体颤抖晃动,旋转的褶皱就会以不同的",
                    {"rt2"},
                    "深度抚过我的乳头。"
                }
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100373", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「这种……好厉害……嗯啾,乳头,居然会,这么舒服……嗯呀啊!　人,人",
                    {"rt2"},
                    "家都不知道……啊……好舒服……嗯呀!!」"
                }
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「还不止这些哦。慢慢就会明白了吧?」"
                }
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            ja = {
                {"还有什么?　这念头还没转完,直君想说的东西就化作快感涌了上来。"}
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"bg", file = "ev_app_h11_14", sync = 0, face = 1, time = 400, path = ":ev/ev_app_h11/", set = "ev_app_h11"},
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100374", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「什喵呀这个?　哈咿,怎么!?　这?　好热!　乳头,尖端,变得好――,",
                    {"rt2"},
                    "烫起来,了啊啊啊,嗯啾――」"
                }
            }
        },
        linkback = "block_00212",
        linknext = "block_00214"
    },
    block_00214 = {
        {"text"},
        text = {
            ja = {
                {
                    "不只是乳头,整个胸部都在发热。一开始还以为是充血才有的感觉,",
                    {"rt2"},
                    "不对。很明显,胸口在发烫。"
                }
            }
        },
        linkback = "block_00213",
        linknext = "block_00215"
    },
    block_00215 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「差不多乳头开始“呼~”地发热了吧。那是配合了温感成分的润滑液",
                    {"rt2"},
                    "哦。成分也和刚才的不同,是硅系的润滑液」"
                }
            }
        },
        linkback = "block_00214",
        linknext = "block_00216"
    },
    block_00216 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「润滑性能的持续时间相当出色,里面还混合了让肌肤发热的成分」"
                }
            }
        },
        linkback = "block_00215",
        linknext = "block_00217"
    },
    block_00217 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这种润滑液的特性,还在于涂过的地方会闪闪发亮。我在乳头罩里",
                    {"rt2"},
                    "放了很多,所以它每转一圈,里面的液体就会洒出来,濡湿禀的身体……」"
                }
            }
        },
        linkback = "block_00216",
        linknext = "block_00218"
    },
    block_00218 = {
        {"text"},
        text = {
            ja = {
                {"的确,我的身体像抹了油一样闪闪发光。"}
            }
        },
        linkback = "block_00217",
        linknext = "block_00219"
    },
    block_00219 = {
        {"text"},
        text = {
            ja = {
                {"闪闪发亮的胸口上,能看到充血得通红、勃起的乳头。"}
            }
        },
        linkback = "block_00218",
        linknext = "block_00220"
    },
    block_00220 = {
        {"text"},
        text = {
            ja = {
                {"这确实,连自己看着都觉得色情……。"}
            }
        },
        linkback = "block_00219",
        linknext = "block_00221"
    },
    block_00221 = {
        {"text"},
        text = {
            ja = {
                {"可是……。"}
            }
        },
        linkback = "block_00220",
        linknext = "block_00222"
    },
    block_00222 = {
        {"text"},
        text = {
            ja = {
                {"可是,果然还是摆脱不了被吊着胃口的感觉。"}
            }
        },
        linkback = "block_00221",
        linknext = "block_00223"
    },
    block_00223 = {
        {"text"},
        text = {
            ja = {
                {"因为――。"}
            }
        },
        linkback = "block_00222",
        linknext = "block_00224"
    },
    block_00224 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「看,脚那样一开一合的,会摔倒的哦?　来,得好好坐着才行」"
                }
            }
        },
        linkback = "block_00223",
        linknext = "block_00225"
    },
    block_00225 = {
        {"text"},
        text = {
            ja = {
                {"说着,直君按住我的肩膀,向下压去。"}
