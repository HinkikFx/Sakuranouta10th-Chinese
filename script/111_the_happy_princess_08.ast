        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「为什么?我啊,知道禀确确实实也会有色色的心情,反而很高兴哦」"
                }
