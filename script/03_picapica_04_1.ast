    },
    block_00282 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2a0100", face = "a0011", head = "mak_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002294", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「那个校长，原来是中村家的人，这所学校的高层，我不能坐视她",
                    {"rt2"},
                    "给草薙家的人添麻烦」"
                }
            }
        },
        linkback = "block_00281",
        linknext = "block_00283"
    },
    block_00283 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「美术部也好什么的，你这操心劲儿真是没谁了」"
                }
            }
        },
        linkback = "block_00282",
        linknext = "block_00284"
    },
    block_00284 = {
        {"text"},
        text = {
            ja = {
                {
                    "那么重要的美术部，前不久她也告诉我是为了两个天才。鸟谷所有",
                    {"rt2"},
                    "的行动，最终都归结于此吗。"
                }
            }
        },
        linkback = "block_00283",
        linknext = "block_00285"
    },
    block_00285 = {
        {"text"},
        text = {
            ja = {
                {"两个天才……"}
            }
        },
        linkback = "block_00284",
        linknext = "block_00286"
    },
    block_00286 = {
        {"text"},
        text = {
            ja = {
                {"那是鸟谷眼中的真相，与世界的事实并不相同。圭毫无疑问是天才。"}
            }
        },
        linkback = "block_00285",
        linknext = "block_00287"
    },
    block_00287 = {
        {"text"},
        text = {
            ja = {
                {
                    "但是在鸟谷心中，我和圭——准确地说是我和圭所创造的画，具有值",
                    {"rt2"},
                    "得她赌上整个学生时代的绝对价值。"
                }
            }
        },
        linkback = "block_00286",
        linknext = "block_00288"
    },
    block_00288 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「比起自己的事更担心我和圭，你到底还想扛多少东西」"
                }
            }
        },
        linkback = "block_00287",
        linknext = "block_00289"
    },
    block_00289 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2a0100", face = "a0001", head = "mak_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002295", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「才没有。我只是在按自己的任性来行动而已」"
                }
            }
        },
        linkback = "block_00288",
        linknext = "block_00290"
    },
    block_00290 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你的任性根本算不上任性，有什么事就跟我说。然后像平时一样",
                    {"rt2"},
                    "随便使唤我就好」"
                }
            }
        },
        linkback = "block_00289",
        linknext = "block_00291"
    },
    block_00291 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2a0110", face = "a0008", head = "mak_z2a", lv = 5, id = 9},
        {"text"},
