                {"fg", ch = "紗希", size = "z1", mode = 3, path = ":fg/sak/z1/", file = "sak_z1b0000", face = "b0009", head = "sak_z1b", lv = 4, id = 9}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_htd_000177", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「就算影响力大不如前,在这片土地上被中村家盯上,日子就没法过",
                    {"rt2"},
                    "了。鸟谷家就像滚下坡道一样,轻而易举地没落了」"
                }
