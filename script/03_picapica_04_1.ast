        linkback = "block_00298",
        linknext = "block_00300"
    },
    block_00300 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不是弱。你偶尔展露的是真实的诚恳。虽然你总是硬撑着过日子，",
