        linkback = "block_00298",
        linknext = "block_00300"
    },
    block_00300 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不是软弱哦。你偶尔露出来的,是不加掩饰的真诚。虽然你总是绷",
                    {"rt2"},
                    "紧了过日子,但我看得出来,你没那么坚强」"
