    },
    block_00295 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2a0110", face = "a0027", head = "mak_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002299", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「……平时的我,有好好地表现得坚强吗？」"
                }
            }
        },
        linkback = "block_00294",
        linknext = "block_00296"
    },
    block_00296 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「平时坚强？　那是什么话？」"
                }
