        linknext = "block_00151"
    },
    block_00151 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「鸟谷把圭从出生到现在的画都拿给我看了。但是,那个家里没有鸟",
                    {"rt2"},
                    "谷的画」"
