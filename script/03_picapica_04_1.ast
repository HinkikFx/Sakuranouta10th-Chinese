        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「鸟谷在某个房间的门前停下了脚步。她说……自己曾经打开过那",
                    {"rt2"},
                    "扇门」"
                }
