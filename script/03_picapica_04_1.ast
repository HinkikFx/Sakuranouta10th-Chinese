        linkback = "block_00299",
        linknext = "block_00301"
    },
    block_00301 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但是，你确实一直在坚强地活着。全力以赴。没有人觉得你是软",
                    {"rt2"},
                    "弱的」"
