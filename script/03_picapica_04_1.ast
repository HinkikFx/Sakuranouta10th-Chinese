        linkback = "block_00299",
        linknext = "block_00301"
    },
    block_00301 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「但是,你一直都在坚强地活着。竭尽全力。没有人觉得你软弱」"
