    block_00456 = {
        {"text"},
        text = {
            ja = {
                {"禀低声呢喃了什么。"}
            }
        },
        linkback = "block_00455",
        linknext = "block_00457"
    },
    block_00457 = {
        {"se", file = "se9010", id = 1},
        {"bg", file = "ev_com_i10_05", path = ":ev/ev_com_i10/", set = "ev_com_i10"},
        {"text"},
        text = {
            ja = {
                {"禀站起身来。"}
            }
        },
        linkback = "block_00456",
        linknext = "block_00458"
    },
    block_00458 = {
        {"text"},
        text = {
            ja = {
                {"我轻声吟起某一天,弗里德曼念过的那首诗。"}
            }
        },
        linkback = "block_00457",
        linknext = "block_00459"
    },
    block_00459 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「I dwell in Possibility―我住在可能性之中」"
                }
            }
        },
        linkback = "block_00458",
        linknext = "block_00460"
    },
    block_00460 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「A fairer House than Prose―一座比散文更美好的房子」"
                }
            }
        },
        linkback = "block_00459",
        linknext = "block_00461"
    },
    block_00461 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「More numerous of Windows―窗子的数目更多」"
                }
            }
        },
        linkback = "block_00460",
        linknext = "block_00462"
    },
    block_00462 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「Superior―for Doors―门也更加优越」"
                }
            }
        },
        linkback = "block_00461",
        linknext = "block_00463"
    },
    block_00463 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「Of Chambers as the Cedars―每一个房间里」"
                }
            }
        },
        linkback = "block_00462",
        linknext = "block_00464"
    },
    block_00464 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「Impregnable of Eye―都是目光无法侵入的西洋杉」"
                }
            }
        },
        linkback = "block_00463",
        linknext = "block_00465"
    },
    block_00465 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「And for an Everlasting RoofThe Gambrels of the Sky―」"
                }
            }
        },
        linkback = "block_00464",
        linknext = "block_00466"
    },
    block_00466 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「永恒的屋顶是天空的斜山墙――」"
                }
            }
        },
        linkback = "block_00465",
        linknext = "block_00467"
    },
    block_00467 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「Of Visitors―the fairest―来访者唯有最美的人们」"
                }
            }
        },
        linkback = "block_00466",
        linknext = "block_00468"
    },
    block_00468 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「For Occupation―This―而我的工作就是」"
                }
            }
        },
        linkback = "block_00467",
        linknext = "block_00469"
    },
    block_00469 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「The spreading wide of narrow HandsTo gather Paradise―」"
                }
            }
        },
        linkback = "block_00468",
        linknext = "block_00470"
    },
    block_00470 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「将这双小小的手全力张开去摘取天堂」"
                }
            }
        },
        linkback = "block_00469",
        linknext = "block_00471"
    },
    block_00471 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004214", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「那也是狄金森呢」"
                }
            }
        },
        linkback = "block_00470",
        linknext = "block_00472"
    },
    block_00472 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯,是那个讨厌的家伙,在夏目的画室里低声念过的诗」"
                }
            }
        },
        linkback = "block_00471",
        linknext = "block_00473"
    },
