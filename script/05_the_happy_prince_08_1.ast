                {"vo", file = "fem_rnd_004046", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「既不是为圭君的死悲伤,也不是为自己母亲的死悲伤,更不是为自",
                    {"rt2"},
                    "己愚蠢的行为悔恨」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004047", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「更谈不上是对大家的赎罪」"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004048", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「我所做的,只是画画而已」"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004049", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「圭君的噩耗传来,大家都沉浸在悲伤中……即便如此,我还是一个劲",
                    {"rt2"},
                    "地画着画」"
                }
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004050", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「只是不停地画」"
                }
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"bg", file = "ev_com_i10_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i10/", set = "ev_com_i10"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004051", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「一直画个不停……」"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「结果就是摩尔公募展获奖。而且还是声誉崇高的最优秀奖普拉蒂",
                    {"rt2"},
                    "努·埃波拉尔。这是草薙健一郎以来的壮举……」"
                }
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"bg", file = "ev_com_i10_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_i10/", set = "ev_com_i10"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004052", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「是呢……,可是……我对那件事,没有太大兴趣」"
