    },
    block_00456 = {
        {"text"},
        text = {
            ja = {
                {"禀低声说了什么。"}
            }
        },
        linkback = "block_00455",
        linknext = "block_00457"
    },
    block_00457 = {
        {"se", file = "se9010", id = 1},
        {"bg", file = "ev_com_i10_05", path = ":ev/ev_com_i10/", set = "ev_com_i10"},
        {"text"},
        text = {
            ja = {
                {"禀站了起来。"}
            }
        },
        linkback = "block_00456",
        linknext = "block_00458"
    },
    block_00458 = {
        {"text"},
        text = {
            ja = {
                {"我低吟起某日弗里德曼说过的那首诗。"}
            }
        },
        linkback = "block_00457",
        linknext = "block_00459"
    },
    block_00459 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「I dwell in Possibility―我栖居于可能性之中」"
                }
            }
        },
        linkback = "block_00458",
        linknext = "block_00460"
    },
    block_00460 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「A fairer House than Prose―比散文更华美的居所」"
                }
            }
        },
        linkback = "block_00459",
        linknext = "block_00461"
    },
    block_00461 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「More numerous of Windows―窗户更加数不胜数」"
                }
            }
        },
        linkback = "block_00460",
        linknext = "block_00462"
    },
    block_00462 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「Superior―for Doors―门扉亦更为优越」"
                }
            }
        },
        linkback = "block_00461",
        linknext = "block_00463"
    },
    block_00463 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「Of Chambers as the Cedars―每个房间中」"
                }
            }
        },
        linkback = "block_00462",
        linknext = "block_00464"
    },
    block_00464 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「Impregnable of Eye―矗立着目光无法穿透的雪松」"
                }
            }
        },
        linkback = "block_00463",
        linknext = "block_00465"
    },
    block_00465 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「And for an Everlasting RoofThe Gambrels of the Sky―」"
                }
            }
        },
        linkback = "block_00464",
        linknext = "block_00466"
    },
    block_00466 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「永恒的屋顶是天空的双坡——」"
                }
            }
        },
        linkback = "block_00465",
        linknext = "block_00467"
    },
    block_00467 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「Of Visitors―the fairest―来访者皆是最美之人」"
                }
            }
        },
        linkback = "block_00466",
        linknext = "block_00468"
    },
    block_00468 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「For Occupation―This―而我的工作是」"
                }
            }
        },
        linkback = "block_00467",
        linknext = "block_00469"
    },
    block_00469 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「The spreading wide of narrow HandsTo gather Paradise―」"
                }
            }
        },
        linkback = "block_00468",
        linknext = "block_00470"
    },
    block_00470 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「将这双窄小的手尽力张开去拥抱天国」"
                }
            }
        },
        linkback = "block_00469",
        linknext = "block_00471"
    },
    block_00471 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_004214", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「也是狄金森的吧」"
                }
            }
        },
        linkback = "block_00470",
        linknext = "block_00472"
    },
    block_00472 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯，那个讨厌的家伙在夏目的画室里不经意间说出的话」"
