        {"fg", ch = "優美", size = "z2", mode = 3, path = ":fg/yum/z2/", file = "yum_z2i0000", face = "i0001", head = "yum_z2i", x = 345, lv = 5, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001398", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「后印象派画家文森特·凡·高，留下了许多以丝柏为题材的作品」"
                }
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2i0000", face = "i0010", head = "rna_z2i", x = -345, lv = 5, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001399", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「他的书信里写着“我总是心系丝柏”。我想那个“总是”，大概一直",
                    {"rt2"},
                    "延续到他最后的那一瞬间……」"
                }
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001296", ch = "yum"}
            },
            ja = {
                {
                    "冰川同学摆出一副对我说话的样子，可那话语，却像是在倾听远方",
                    {"rt2"},
                    "某处、冻结般寂静的声音。"
                }
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"fg", ch = "優美", size = "z2", mode = 3, path = ":fg/yum/z2/", file = "yum_z2i0000", face = "i0008", head = "yum_z2i", x = 345, lv = 5, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001297", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「也就是说，冰川同学一提到丝柏，就会想起凡·高的画」"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2i0000", face = "i0011", head = "rna_z2i", x = -345, lv = 5, id = 5},
        {"fgact", ch = "里奈", act = "うなづく", size = 5, lv = 5, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001400", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯，算是吧……」"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001298", ch = "yum"}
            },
            ja = {
                {"两人的对话就这样结束了。"}
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"bg", file = "black", path = ":bg/"},
        {"ex", time = 1000, func = "wait"},
        {"bg", file = "ev_txt_c08_01", time = 2000, path = ":ev/ev_txt_c08/", set = "ev_txt_c08"},
        {"text"},
        text = {
            ja = {
                {"――转调Ⅱ――"}
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"bg", file = "ev_txt_c13_01", time = 2000, path = ":ev/ev_txt_c13/", set = "ev_txt_c13"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001299", ch = "yum"}
            },
            ja = {
                {"「所以？　打算怎么整他？」男子生跑来找我商量。"}
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001300", ch = "yum"}
            },
            ja = {
                {
                    "我装傻似的说了句「整谁？」。「还用问吗？」其中一个男子生略",
                    {"rt2"},
                    "带反抗地冲我说道。"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001301", ch = "yum"}
            },
            ja = {
                {"我瞪着那家伙。"}
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001302", ch = "yum"}
            },
            ja = {
                {
                    "往常的话，到这一步对方就会退缩，今天却似乎不同。那个男子的",
                    {"rt2"},
                    "反而更加挑衅地瞪了回来。"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001303", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「你算老几？　你这家伙……」"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_okz_000001", ch = "okz"}
            },
            ja = {
                {
                    name = {"丘泽"},
                    "「什么你这家伙，我叫丘泽。差不多也该记住同伴的名字了吧」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001304", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「同伴？　哈？」"
                }
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001305", ch = "yum"}
            },
            ja = {
                {"我从没把这些家伙当成过同伴。当然，他们也不是我的仆从或部下。"}
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001306", ch = "yum"}
            },
            ja = {
                {"野猫就算聚在一起，那也称不上是群体。"}
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001307", ch = "yum"}
            },
            ja = {
                {
                    "野猫没有狗那种规规矩矩的社会习性，有的，只是自己，和包围着",
                    {"rt2"},
                    "自己的环境而已。"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001308", ch = "yum"}
            },
            ja = {
                {
                    "对猫来说，挡在身旁的猫也好，喂食的人也好，拦住自己的铁丝网",
                    {"rt2"},
                    "也好，从天而降的冰冷的雪也好，一切都同等地不过是环境罢了。"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001309", ch = "yum"}
            },
            ja = {
                {
                    "我既不是和这些家伙在一起，也不是和他们混在一处。他们只不过",
                    {"rt2"},
                    "是包围着我的环境中的风景而已。"
                }
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_okz_000002", ch = "okz"}
            },
            ja = {
                {
                    name = {"丘泽"},
                    "「怎么？　要像那时候一样拔刀吗？　那种东西可吓不住我」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001310", ch = "yum"}
            },
            ja = {
                {"我迅速做出把右手插进兜里的假动作。对方自然摆出了架势。"}
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001311", ch = "yum"}
            },
            ja = {
                {"可我却以拧转的右腿为轴，几乎同时用左脚扫开了对方的下盘。"}
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"se", file = "se2766", id = 1},
        {"quake", mode = "mw"},
        {"ex", time = 1000, func = "wait"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001312", ch = "yum"}
            },
            ja = {
                {"刀是虚招。一心提防我右手的对方，轻而易举地摔倒了。"}
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001313", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「恶心。去死吧」"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"mwact", act = "びっくり", size = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_okz_000003", ch = "okz"}
            },
            ja = {
                {
                    name = {"丘泽"},
                    "「川内野！」"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001314", ch = "yum"}
            },
            ja = {
                {"对方想爬起来，我立刻一脚踏住他的胸口。"}
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001315", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「同伴什么的真恶心。想玩这套的话找别人去」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_okz_000004", ch = "okz"}
            },
            ja = {
                {
                    name = {"丘泽"},
                    "「什么意思，我们可不答应。昨天川内野你不也干劲十足吗。怎么，",
                    {"rt2"},
                    "事到如今怂了？」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001316", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「啊？　我可没说不干。只是说你这家伙恶心而已！」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_okz_000005", ch = "okz"}
            },
            ja = {
                {
                    name = {"丘泽"},
                    "「那就是要干喽？　啊？」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001317", ch = "yum"}
            },
            ja = {
                {"我一言不发地离开了那里。"}
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001318", ch = "yum"}
            },
            ja = {
                {"摔倒的男子生好像冲我怒吼着什么，我无视了。"}
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001319", ch = "yum"}
            },
            ja = {
                {"什么啊？　这跟过家家一样的青春戏码是？"}
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001320", ch = "yum"}
            },
            ja = {
                {"所以我才讨厌和男子人混在一起。"}
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001321", ch = "yum"}
            },
            ja = {
                {
                    "我喜欢的是女孩子，但这不代表我就懂男子人的心思。所以有时候，",
                    {"rt2"},
                    "会因为完全无法理解而混乱。"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001322", ch = "yum"}
            },
            ja = {
                {"话虽如此，也没有女孩子们肯接纳我这样的人。"}
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001323", ch = "yum"}
            },
            ja = {
                {"我只是不想和任何人厮混，不想有任何牵扯，想一个人待着。"}
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001324", ch = "yum"}
            },
            ja = {
                {
                    "是从什么时候开始的呢。男子孩子们聚集到我身边，是从什么时候",
                    {"rt2"},
                    "开始的？"
                }
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001325", ch = "yum"}
            },
            ja = {
                {"当然，我并不是自愿待在他们的圈子里。"}
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001326", ch = "yum"}
            },
            ja = {
                {
                    "只是，我这生来便浸入骨髓的粗暴习性，不容许我和女孩子们待在",
                    {"rt2"},
                    "一起。"
                }
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001327", ch = "yum"}
            },
            ja = {
                {"其实，我也想加入女孩子的圈子。"}
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001328", ch = "yum"}
            },
            ja = {
                {"我的头发很短。"}
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001329", ch = "yum"}
            },
            ja = {
                {"但那并不是因为我想变成男子人什么的。"}
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001330", ch = "yum"}
            },
            ja = {
                {"我只是对「我」毫不在意而已。"}
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001331", ch = "yum"}
            },
            ja = {
                {"比起爱「我」，我更爱美丽的同性。"}
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001332", ch = "yum"}
            },
            ja = {
                {"大概，那是自我投影的一种吧。"}
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001333", ch = "yum"}
            },
            ja = {
                {"我想成为冰川同学。"}
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001334", ch = "yum"}
            },
            ja = {
                {"想成为那簇微微摇曳的、羸弱的蓝色火焰。"}
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"excall", file = "03_zypressen_02_4"},
        {"text"},
        linkback = "block_00211"
    },
