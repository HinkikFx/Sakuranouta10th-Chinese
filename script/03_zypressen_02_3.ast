            ja = {
                {
                    name = {"里奈"},
                    "「后印象派画家文森特·凡·高留下了许多以丝柏为题材的作品」"
                }
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2i0000", face = "i0010", head = "rna_z2i", x = -345, lv = 5, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001399", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「'心中始终为丝柏所吸引'，他的信中这样写道。大概那个'始终'一",
                    {"rt2"},
                    "直延续到了他生命的最后一刻……」"
                }
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001296", ch = "yum"}
            },
            ja = {
                {
                    "冰川同学看似在对着我说话，但那些话语仿佛在倾听远方某处冰冻",
                    {"rt2"},
                    "般",
                    {"txruby", text = "しず"},
                    "寂静",
                    {"txruby"},
                    "的声响。"
                }
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"fg", ch = "優美", size = "z2", mode = 3, path = ":fg/yum/z2/", file = "yum_z2i0000", face = "i0008", head = "yum_z2i", x = 345, lv = 5, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001297", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「也就是说，冰川同学你一提到丝柏就会想起凡高的画」"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"fg", ch = "里奈", size = "z2", mode = 3, path = ":fg/rna/z2/", file = "rna_z2i0000", face = "i0011", head = "rna_z2i", x = -345, lv = 5, id = 5},
        {"fgact", ch = "里奈", act = "うなづく", size = 5, lv = 5, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_001400", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯，大概……是那样吧……」"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001298", ch = "yum"}
            },
            ja = {
                {"两人的对话就那样结束了。"}
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"bg", file = "black", path = ":bg/"},
