    },
    block_00171 = {
        {"bg", file = "ev_txt_c13_01", time = 2000, path = ":ev/ev_txt_c13/", set = "ev_txt_c13"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001299", ch = "yum"}
            },
            ja = {
                {"'那具体怎么整她？'男子生来找我商量。"}
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001300", ch = "yum"}
            },
            ja = {
                {
                    "我装傻说了句'整谁？'。'还能是谁？'其中一个男子生带着不满的语",
                    {"rt2"},
                    "气说。"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001301", ch = "yum"}
            },
            ja = {
                {"我瞪了他一眼。"}
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001302", ch = "yum"}
            },
            ja = {
                {
                    "平时到这一步对方就会退缩，但今天不太一样。那个男子生更加挑",
                    {"rt2"},
                    "衅地瞪了回来。"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001303", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「你算老几？」"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_okz_000001", ch = "okz"}
            },
            ja = {
                {
                    name = {"丘泽"},
                    "「别叫'你'了。我叫丘泽。差不多该记住同伴的名字了吧」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001304", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「同伴？　哈？」"
                }
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001305", ch = "yum"}
            },
            ja = {
                {"我从没把这些人当作同伴。当然也不是什么手下或部下。"}
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001306", ch = "yum"}
            },
            ja = {
                {"野猫聚到一起也不能叫做群体。"}
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001307", ch = "yum"}
            },
            ja = {
                {
                    "野猫不像狗那样有井然有序的社会习性，它们拥有的只有自己和围",
                    {"rt2"},
                    "绕自己的环境。"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001308", ch = "yum"}
            },
            ja = {
                {
                    "对猫来说，挡在身旁的猫也好，给自己喂食的人也好，阻碍去路的",
                    {"rt2"},
                    "铁丝网也好，从天而降的冰冷雪花也好，全都只是等价的环境。"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001309", ch = "yum"}
            },
            ja = {
                {
                    "我并不是跟这些人待在一起或厮混在一起。只不过我周围的环境风",
                    {"rt2"},
                    "景里恰好有他们罢了。"
                }
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_okz_000002", ch = "okz"}
            },
            ja = {
                {
                    name = {"丘泽"},
                    "「怎么？　又想拿刀出来吓人？　那玩意儿可吓不住我」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001310", ch = "yum"}
            },
            ja = {
                {"我迅速地把右手伸向口袋。对方果然立刻摆出了防备姿势。"}
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001311", ch = "yum"}
            },
            ja = {
                {"但我以扭转的右手为轴，几乎同时用左脚扫向他的腿。"}
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"se", file = "se2766", id = 1},
        {"quake", mode = "mw"},
        {"ex", time = 1000, func = "wait"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001312", ch = "yum"}
            },
            ja = {
                {"刀子是假动作。对方警惕着右手，轻而易举地摔了下来。"}
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001313", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「恶心死了。去死吧」"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"mwact", act = "びっくり", size = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_okz_000003", ch = "okz"}
            },
            ja = {
                {
                    name = {"丘泽"},
                    "「川内野！」"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001314", ch = "yum"}
            },
            ja = {
                {"他试图爬起来，但我立刻踩住了他的胸口。"}
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001315", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「同伴什么的恶心死了。想干那种事找别人去」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_okz_000004", ch = "okz"}
            },
            ja = {
                {
                    name = {"丘泽"},
                    "「你搞什么啊，我们可不答应。昨天川内野你不也挺来劲的吗。怎",
                    {"rt2"},
                    "么现在怂了？」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001316", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「啊？　谁说不干了。只是说你恶心！」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_okz_000005", ch = "okz"}
            },
            ja = {
                {
                    name = {"丘泽"},
                    "「那你到底干不干啊？　啊？」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001317", ch = "yum"}
            },
            ja = {
                {"我一言不发地离开了那里。"}
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001318", ch = "yum"}
            },
            ja = {
                {"被摔倒的男子生似乎在冲我嚷什么，我无视了。"}
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001319", ch = "yum"}
            },
            ja = {
                {"搞什么啊？这种过家家般的青春剧？"}
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001320", ch = "yum"}
            },
            ja = {
                {"所以我才讨厌跟男子生混在一起。"}
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001321", ch = "yum"}
            },
            ja = {
                {
                    "我喜欢的是女孩子，但这并不意味着我能理解男子人的心思。有时",
                    {"rt2"},
                    "候实在搞不懂到头来会让人心烦意乱。"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001322", ch = "yum"}
            },
            ja = {
                {"另一方面，像我这样的人也没有女生愿意接纳。"}
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001323", ch = "yum"}
            },
            ja = {
                {"我只是单纯地不想跟任何人抱团，不想牵扯在一起，想独处。"}
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001324", ch = "yum"}
            },
            ja = {
                {"从什么时候起身边开始聚集男子生的呢？"}
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001325", ch = "yum"}
            },
            ja = {
                {"当然不是自愿混进他们圈子里的。"}
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001326", ch = "yum"}
            },
            ja = {
                {"只是我骨子里那种粗暴的习性，让我没法跟女孩子们同处。"}
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001327", ch = "yum"}
            },
            ja = {
                {"其实我也想加入女孩子的圈子啊。"}
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001328", ch = "yum"}
            },
            ja = {
                {"我的头发很短。"}
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001329", ch = "yum"}
            },
            ja = {
                {"但那不是因为想变成男子人。"}
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001330", ch = "yum"}
            },
            ja = {
                {"我只是对'自己'毫不在意而已。"}
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001331", ch = "yum"}
            },
            ja = {
                {"比起爱'自己'，我更爱美丽的同性。"}
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001332", ch = "yum"}
            },
            ja = {
                {"大概那是一种自我投射吧。"}
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001333", ch = "yum"}
            },
            ja = {
                {"我想成为冰川同学。"}
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_001334", ch = "yum"}
            },
            ja = {
                {"想变成那朵微微摇曳的柔弱的蓝色火焰。"}
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
