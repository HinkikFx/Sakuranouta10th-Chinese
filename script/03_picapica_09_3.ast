                {"vo", file = "fem_mkd_003387", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「给我老实点,不趁现在一口气搞定的话,等清醒过来,这种事我肯定",
                    {"rt2"},
                    "就做不出来了……啊――」"
