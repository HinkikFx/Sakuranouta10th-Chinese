        linkback = "block_00390",
        linknext = "block_00392"
    },
    block_00392 = {
        {"text"},
        text = {
            ja = {
                {
                    "鸟谷先紧紧闭了一下眼睛，然后用那双大眼睛盯着我。之前吓出冷",
                    {"rt2"},
