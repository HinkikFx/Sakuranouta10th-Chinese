        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            ja = {
                {
                    "鸟谷主动把嘴唇压了上来。软软地与我的唇紧密相贴。难以相信同",
                    {"rt2"},
                    "为嘴唇的柔软触感,在整个唇上蔓延开来。"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            ja = {
                {
                    "我不禁想,这世上竟有如此舒服的东西。比蕨饼更水嫩弹滑,比棉花",
                    {"rt2"},
                    "糖更绵软柔嫩。"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003351", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「嗯……呼……啾……嗯……嗯嗯……啾……」"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            ja = {
                {
                    "轻轻发出声响,一次次重复着仅仅相触的亲吻。每碰一次,唇上的温",
                    {"rt2"},
                    "度就升高一分。"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            ja = {
                {
                    "鸟谷的手离开我的上臂,紧紧抓住我胸口附近的衬衫。那只手果然还",
                    {"rt2"},
                    "在发抖,一看就知道她在紧张。"
                }
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003352", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「嗯……啾,啾……嗯嗯…呼……啾……」"
                }
            }
        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            ja = {
                {
                    "她拼命地一次次贴上嘴唇的模样,与她本人的意愿相反,让人觉得莫",
                    {"rt2"},
                    "名惹人怜爱。可爱得不得了。"
                }
            }
        },
        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            ja = {
                {
                    "还有,我也没法再装从容了。虽然不知道鸟谷怎么看我,但老实说,这",
                    {"rt2"},
                    "相当舒服,我也相当兴奋。"
                }
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
        {"text"},
        text = {
