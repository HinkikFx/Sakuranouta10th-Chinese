        linkback = "block_00111",
        linknext = "block_00113"
    },
    block_00113 = {
        {"text"},
        text = {
            ja = {
                {
                    "在一次次重复着轻啄般的亲吻间,鸟谷的嘴唇让彼此的唾液润得湿漉",
                    {"rt2"},
                    "漉的。嘴唇内侧的粘膜,传来滑溜溜的触感。"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            ja = {
                {
                    "想探向水嫩双唇更深处的冲动,一点点膨胀起来。鸟谷的口中,一定",
                    {"rt2"},
                    "温热得令人融化。"
                }
            }
        },
        linkback = "block_00113",
        linknext = "block_00115"
    },
    block_00115 = {
        {"text"},
        text = {
            ja = {
                {"用舌头分开鸟谷的嘴唇,潜入湿润的口中。"}
