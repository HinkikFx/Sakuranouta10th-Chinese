    block_00383 = {
        {"text"},
        text = {
            ja = {
                {"伸手触碰我面颊的鸟谷，露出了从未见过的温柔目光微笑着。"}
            }
        },
        linkback = "block_00382",
        linknext = "block_00384"
    },
    block_00384 = {
        {"bg", file = "ev_mak_h04_13", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h04/", set = "ev_mak_h04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003461", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「你看我疼就一直在忍着是吧……所以，已经……随你的意来吧……好",
