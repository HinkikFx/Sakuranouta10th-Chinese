    block_00001 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003306", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「就像所有的颜色都被重新涂抹了一样，我的世界改变了」"
