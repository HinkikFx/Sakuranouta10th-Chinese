    block_00388 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003463", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「迟泄的人会咬着牙在我里面这么颤抖吗……你这个笨蛋……逞强被",
