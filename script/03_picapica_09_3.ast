            }
        },
        linkback = "block_00373",
        linknext = "block_00375"
    },
    block_00375 = {
        {"text"},
        text = {
            ja = {
                {
                    "当穴内柔软细密的褶皱开始整个吸附上小鸡鸡时,鸟谷唇间溢出的声",
                    {"rt2"},
                    "音里,也开始掺进甜腻的气息。"
                }
            }
        },
        linkback = "block_00374",
        linknext = "block_00376"
    },
    block_00376 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「稍微,好受一点了吗……?」"
                }
            }
        },
        linkback = "block_00375",
        linknext = "block_00377"
    },
    block_00377 = {
        {"text"},
        text = {
            ja = {
                {
                    "强忍着从几乎要爆炸的小鸡鸡里涌出的射精欲,我尽量用若无其事的",
                    {"rt2"},
                    "语气问道。"
                }
            }
        },
        linkback = "block_00376",
        linknext = "block_00378"
    },
    block_00378 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003458", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「什么叫好受一点,……哈,啊……你说话还真没自信呢……呵呵……呜嗯",
                    {"rt2"},
                    "……已,已经没事了……一点都不痛了,真的……」"
                }
            }
        },
        linkback = "block_00377",
        linknext = "block_00379"
    },
    block_00379 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「说什么傻话,你眉头还皱着呢……?」"
                }
            }
        },
        linkback = "block_00378",
        linknext = "block_00380"
    },
    block_00380 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003459", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「那,那是……肯定是因为舒服啦……」"
                }
            }
        },
        linkback = "block_00379",
        linknext = "block_00381"
    },
    block_00381 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你舒服的时候会皱眉头吗?　别硬撑了……」"
                }
            }
        },
        linkback = "block_00380",
        linknext = "block_00382"
    },
    block_00382 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003460", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「硬撑的人……哈……你不也一样吗……嗯……所,所以呢……」"
                }
            }
        },
        linkback = "block_00381",
        linknext = "block_00383"
    },
    block_00383 = {
        {"text"},
        text = {
            ja = {
                {"鸟谷伸手抚上我的脸颊,用一种我从未见过的温柔眼神微笑着。"}
            }
        },
        linkback = "block_00382",
        linknext = "block_00384"
    },
    block_00384 = {
        {"bg", file = "ev_mak_h04_13", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h04/", set = "ev_mak_h04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003461", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「你是看我一脸痛苦,才一直忍着的吧……所以,已经……可以随你喜",
                    {"rt2"},
                    "欢地动了……没关系,的……」"
                }
            }
        },
        linkback = "block_00383",
        linknext = "block_00385"
    },
    block_00385 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,可是」"
                }
            }
        },
        linkback = "block_00384",
        linknext = "block_00386"
    },
    block_00386 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003462", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「不许说什么可是……再这样下去,你的那个要是闹出走火事故……那",
                    {"rt2"},
                    "得多……让人无地自容啊…?　那种初体验,我也不要哦……?」"
                }
            }
        },
        linkback = "block_00385",
        linknext = "block_00387"
    },
    block_00387 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我可是超级厉害的迟漏。所以不用在意」"
                }
            }
        },
        linkback = "block_00386",
        linknext = "block_00388"
    },
    block_00388 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003463", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「哪有迟漏会咬着牙,还在我的里面跳得这么厉害的……你这笨蛋……",
                    {"rt2"},
                    "你在死撑硬忍,我可是一眼就看穿了……」"
                }
            }
        },
        linkback = "block_00387",
        linknext = "block_00389"
    },
    block_00389 = {
        {"bg", file = "ev_mak_h04_12", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h04/", set = "ev_mak_h04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003464", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「真是的,死脑筋……,就因为你这样,我才会……被逼到走投无路,你懂",
                    {"rt2"},
                    "不懂啊……」"
                }
            }
        },
        linkback = "block_00388",
        linknext = "block_00390"
    },
    block_00390 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「走投无路?　你?」"
                }
            }
        },
        linkback = "block_00389",
        linknext = "block_00391"
    },
    block_00391 = {
        {"bg", file = "ev_mak_h04_11", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h04/", set = "ev_mak_h04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003465", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「对啦……啊啊真是的……呜嗯……听好了?……接下来要说的话……我",
                    {"rt2"},
                    "只说,一次,以后……绝对不会再说第二次,你给我好好听着……!」"
                }
            }
        },
        linkback = "block_00390",
        linknext = "block_00392"
    },
    block_00392 = {
        {"text"},
        text = {
            ja = {
                {
                    "鸟谷紧紧地闭了一次眼,再用那双大眼睛凝视着我。刚才还冒着冷汗",
                    {"rt2"},
                    ",惨白一片的脸颊此刻泛起红潮,睫毛上噙着泪珠。"
                }
            }
        },
        linkback = "block_00391",
        linknext = "block_00393"
    },
    block_00393 = {
        {"bg", file = "ev_mak_h04_12", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h04/", set = "ev_mak_h04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003466", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「舒服什么的我还完全不懂……可你的……每动一下,就好像连我的脑",
                    {"rt2"},
                    "子都要一起被搅乱了啊」"
                }
            }
        },
        linkback = "block_00392",
        linknext = "block_00394"
    },
    block_00394 = {
        {"text"},
        text = {
            ja = {
                {
                    "嘴唇迟疑地开合几次后,泪眼汪汪的鸟谷红着脸瞪着我,从灼热急促",
                    {"rt2"},
                    "的喘息间,一股脑地把话砸了过来。"
                }
            }
        },
        linkback = "block_00393",
        linknext = "block_00395"
    },
    block_00395 = {
        {"bg", file = "ev_mak_h04_14", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h04/", set = "ev_mak_h04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003467", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「要是有个因为舒服之类的理由也就罢了,可是,仅仅是……你的东西,",
                    {"rt2"},
                    "待在我的里面……仅仅是一跳一跳地颤着……」"
                }
            }
        },
        linkback = "block_00394",
        linknext = "block_00396"
    },
    block_00396 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003468", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我的,里,里面,每被搅动一次,就连我的脑子,都跟豆腐一样变得软塌",
                    {"rt2"},
                    "塌的……越来越不知所措了啊……!」"
                }
            }
        },
        linkback = "block_00395",
        linknext = "block_00397"
    },
    block_00397 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003469", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「呜呜……就因为你为我着想,死撑硬忍成那样,所以我才……我才……」"
                }
            }
        },
        linkback = "block_00396",
        linknext = "block_00398"
    },
    block_00398 = {
        {"bg", file = "ev_mak_h04_15", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h04/", set = "ev_mak_h04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003470", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「想让你随心所欲地动起来,为了这个……我才落到不得不说这种话",
                    {"rt2"},
                    "的地步啊……你,你给我反省啊……」"
                }
            }
        },
        linkback = "block_00397",
        linknext = "block_00399"
    },
    block_00399 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003471", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「还有,还有……那个,哈,哈啊……呜嗯……」"
                }
            }
        },
        linkback = "block_00398",
        linknext = "block_00400"
    },
    block_00400 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「鸟谷我明白了。够了够了,是我不好,我动,我这就动。请让我动吧。",
                    {"rt2"},
                    "不如说我早就超想动了,也超想射在里面了!」"
                }
            }
        },
        linkback = "block_00399",
        linknext = "block_00401"
    },
    block_00401 = {
        {"bg", file = "ev_mak_h04_11", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h04/", set = "ev_mak_h04"},
        {"quake", size = 5, mode = "mw"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003472", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「咿呜……!　射,射在里面什么的,别说得那么轻描淡写啊啊……啊,啊",
                    {"rt2"},
                    "啊……笨蛋,都说到这份上了,让我把话说完……!」"
                }
            }
        },
        linkback = "block_00400",
        linknext = "block_00402"
    },
    block_00402 = {
        {"bg", file = "ev_mak_h04_12", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h04/", set = "ev_mak_h04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003473", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「女孩子啊……是有那种就算自己不舒服也无所谓的瞬间的……只要",
                    {"rt2"},
                    "幸福就好了……只要开心,那就足够了啊……」"
                }
            }
        },
        linkback = "block_00401",
        linknext = "block_00403"
    },
    block_00403 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003474", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「心里满满当当的,光是这样……就要满溢出来了,这一点,你的东西不",
                    {"rt2"},
                    "是最清楚吗……!」"
                }
            }
        },
        linkback = "block_00402",
        linknext = "block_00404"
    },
    block_00404 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003475", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「笨蛋直哉,我现在,可是幸福得一塌糊涂啊……和你连在一起,你就在",
                    {"rt2"},
                    "我的里面……被你如此珍视着……」"
                }
            }
        },
        linkback = "block_00403",
        linknext = "block_00405"
    },
    block_00405 = {
        {"bg", file = "ev_mak_h04_11", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h04/", set = "ev_mak_h04"},
        {"text"},
        text = {
