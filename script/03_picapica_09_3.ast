    },
    block_00282 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「鸟谷,你的心意让我高兴得不得了……但是,希望你想一想。如果我",
                    {"rt2"},
                    "进到你里面,那绝对会舒服得要命」"
