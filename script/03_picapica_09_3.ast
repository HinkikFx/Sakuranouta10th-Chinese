    block_00121 = {
        {"text"},
        text = {
            ja = {
                {"鸟谷移开嘴唇,满脸通红地向我抗议。"}
            }
        },
        linkback = "block_00120",
        linknext = "block_00122"
    },
    block_00122 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「哦,哦哦……抱歉,一不小心太投入了」"
                }
            }
        },
        linkback = "block_00121",
        linknext = "block_00123"
    },
    block_00123 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003357", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「不,不是的……笨蛋,别道歉啦……只,只是稍微……真的只是稍微吓了",
                    {"rt2"},
                    "一跳而已……」"
                }
            }
        },
        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003358", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「没,没关系的……我知道你工口污染很严重……接吻的时候,我,我也",
                    {"rt2"},
                    "稍微想过,大概会变成这样……」"
                }
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「区区深吻就被说成工口污染,那之后可怎么办啊……」"
