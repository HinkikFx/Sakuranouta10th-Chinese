        linkback = "block_00407",
        linknext = "block_00409"
    },
    block_00409 = {
        {"bg", file = "ev_mak_h04_11", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h04/", set = "ev_mak_h04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003478", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「因为……你一点都不肯动嘛……,我就想着,稍微撩你一下,你会不会",
                    {"rt2"},
                    "来劲……」"
                }
            }
        },
        linkback = "block_00408",
        linknext = "block_00410"
    },
    block_00410 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那也得看人,还得看时机吧……」"
                }
            }
        },
        linkback = "block_00409",
        linknext = "block_00411"
    },
    block_00411 = {
        {"bg", file = "ev_mak_h04_12", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h04/", set = "ev_mak_h04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003479", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「诶,那,我该不会,失败……了?」"
