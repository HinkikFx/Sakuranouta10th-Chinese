                }
            }
        },
        linkback = "block_00404",
        linknext = "block_00406"
    },
    block_00406 = {
        {"text"},
        text = {
            ja = {
                {"鸟谷又一次紧紧闭上眼睛,然后像是下定决心般喊了出来。"}
            }
        },
        linkback = "block_00405",
        linknext = "block_00407"
    },
    block_00407 = {
        {"bg", file = "ev_mak_h04_14", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h04/", set = "ev_mak_h04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003477", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「所以,随你喜欢地动吧,用我来兴奋吧,舒服起来吧……真是的,笨蛋",
                    {"rt2"},
                    "笨蛋……最喜欢你了!!」"
                }
            }
        },
        linkback = "block_00406",
        linknext = "block_00408"
    },
    block_00408 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「鸟谷……你啊……知道自己刚才,说了多不得了的话吗?」"
                }
            }
