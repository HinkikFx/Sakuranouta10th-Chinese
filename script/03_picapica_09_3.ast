    },
    block_00123 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003357", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「不不不不是……笨蛋，不用道歉……只是……只是稍微吓了一跳而已",
