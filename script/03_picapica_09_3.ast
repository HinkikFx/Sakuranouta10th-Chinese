        linkback = "block_00410",
        linknext = "block_00412"
    },
    block_00412 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不,大获成功。我喜欢,超级喜欢,也喜欢你,更是超欢迎你说色色的",
                    {"rt2"},
