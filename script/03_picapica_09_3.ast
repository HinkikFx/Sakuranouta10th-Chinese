        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            ja = {
                {"那股气势没能维持到最后,她用几乎要消失的声音向我拜托。"}
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            ja = {
                {
                    "平日里那层旁若无人风的镀金,已经剥落得一干二净,乖巧羞怯得无",
                    {"rt2"},
                    "以复加。"
                }
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            ja = {
                {"不过本色的鸟谷也相当可爱,所以完全没有问题。"}
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「明白了。稍等一下」"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            ja = {
                {"我自己解开裤子的纽扣,拉下拉链。"}
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            ja = {
                {
                    "名为亲吻的,既青涩又淫靡的粘膜摩擦,舒服得远超我的想象,就连把",
                    {"rt2"},
                    "硬邦邦僵成一块的小鸡鸡掏出来,都费了一番功夫。"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
