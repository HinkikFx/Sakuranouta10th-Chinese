        linkback = "block_00023",
        linknext = "block_00025"
    },
    block_00025 = {
        {"text"},
        text = {
            ja = {
                {
                    "然而,鸟谷什么都没有说。交握在胸前的双手垂了下去,紧攥的拳头",
                    {"rt2"},
                    "颤抖着。"
                }
            }
        },
        linkback = "block_00024",
        linknext = "block_00026"
    },
    block_00026 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我不会参加摩尔展。但是,鸟谷」"
