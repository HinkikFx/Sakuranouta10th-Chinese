        linkback = "block_00122",
        linknext = "block_00124"
    },
    block_00124 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003358", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「没、没事的……反正你的色气值爆表我也知道……我、我在接吻的",
