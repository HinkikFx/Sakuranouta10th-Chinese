        linkback = "block_00276",
        linknext = "block_00278"
    },
    block_00278 = {
        {"text"},
        text = {
            ja = {
                {"鸟谷的话没有说到最后,取而代之的,是抱住我的纤细手臂,渐渐收紧。"}
