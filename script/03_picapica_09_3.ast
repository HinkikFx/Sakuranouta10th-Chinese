        text = {
            vo = {
                {"vo", file = "fem_mkd_003392", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「不行不行不行不行……!　这门槛再怎么说也太高了……!那个,明明",
                    {"rt2"},
