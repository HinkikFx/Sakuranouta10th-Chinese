        linkback = "block_00283",
        linknext = "block_00285"
    },
    block_00285 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003424", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「可,可是,都说第一次谁都会痛,一定程度的疼痛我早就有觉悟了,我",
                    {"rt2"},
                    "都说了没关系,你就不用在意了,来吧」"
