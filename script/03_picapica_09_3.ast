        linkback = "block_00282",
        linknext = "block_00284"
    },
    block_00284 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯,那恐怕是板上钉钉的舒服。虽说没体验过,但可以说是绝对的。",
                    {"rt2"},
                    "但是啊,鸟谷。你多半只会觉得痛」"
