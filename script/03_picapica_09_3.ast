        linknext = "block_00161"
    },
    block_00161 = {
        {"bg", file = "ev_mak_h05_04", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h05/", set = "ev_mak_h05"},
        {"quake", size = 2},
        {"text"},
        text = {
            ja = {
                {"描过牙齿的内侧,再舔遍上颚粗糙的部位,鸟谷的身体便猛地一弹。"}
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"text"},
        text = {
            ja = {
                {
                    "舌头缠得越深,怀中鸟谷的身体就变得越发滚烫。环在我背后的手掌",
                    {"rt2"},
                    ",正散发着热度。"
                }
            }
        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003379", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「啾……嗯姆……啾噜……嗯咕……咧噜……啧普…啾噜……咕嘟……呼,啊",
                    {"rt2"},
                    "…………啾噜……」"
                }
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"text"},
        text = {
            ja = {
                {
                    "随着舌头的动作而交融的唾液,顺着鸟谷的舌头流淌进去,她喉头咕",
                    {"rt2"},
                    "嘟一响,咽下了那黏稠透明的唾液。"
                }
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"bg", file = "ev_mak_h05_05", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h05/", set = "ev_mak_h05"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003380", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「哈啊呼……唾液……有种不可思议的味道……咧噜……脑袋晕乎乎的",
                    {"rt2"},
                    "……感觉变得好奇怪,咕…………咧噜……啾……啧普……」"
                }
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            ja = {
                {"裹满唾液的鸟谷的舌头,恼人地扭动着,缠上我的舌头。"}
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003381", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「哈……啊啊…咧噜……啾噜……咧噜……咧噜…啧普哩……啾啾噜呜……",
                    {"rt2"},
                    "啾噜……啾,啾噜…嗯呼……」"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            ja = {
                {
                    "鸟谷柔软的舌头如闪烁般灵巧地游动,濡湿的嘴唇发出啾的一声,吸",
                    {"rt2"},
                    "住我的舌头。"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            ja = {
                {
                    "鸟谷的舌头柔软而丰厚,口中滑腻湿润,亲吻间漏出的气息也芬芳好",
                    {"rt2"},
                    "闻。"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            ja = {
                {
                    "原本清爽的鸟谷的唾液,经我潜入口中的舌头一搅拌,渐渐带上了更",
                    {"rt2"},
                    "甘甜黏稠的质感。"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003382", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「哈,哈啊……哈呼……啾噜……啧普……啾噜噜…嗯嗯……呼……啾呜……",
                    {"rt2"},
                    "啾噜…啧普……嗯呼……啊……」"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            ja = {
                {
                    "那撩拨兴奋的舌头蠕动,并非有意的引诱,应该只是忘我地回应着亲",
                    {"rt2"},
                    "吻而已,但仅仅如此就足够令人兴奋了。"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            ja = {
                {"微微睁开的双眼水光潋滟,脸颊如同发烧般泛起红潮。"}
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「鸟谷……」"
                }
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            ja = {
                {
                    "搂抱的手臂一用力,鸟谷的欧派便隔着布料抵上我的胸膛。软得不可",
                    {"rt2"},
                    "思议……这世上竟然存在如此柔软的东西。"
                }
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"text"},
        text = {
            ja = {
                {"想更多地触碰鸟谷。一心想着这个,我的手伸向了鸟谷制服的纽扣。"}
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003383", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「哈……啊……不,不行……稍,稍……微……等等,求你了…………」"
                }
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            ja = {
                {
                    "亲吻的间隙,鸟谷用上气不接下气的语调恳求道。她全身彻底脱了力",
                    {"rt2"},
                    ",细小的声音里全无平日的气势。"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003384", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我,我想……先帮你脱掉……然后,再……轮到我……。先脱的那个……",
                    {"rt2"},
                    "太难为情了……」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那完全没问题。我麻利地脱掉就行了吧?　等我痛快脱完之后,可",
                    {"rt2"},
                    "否容在下恭恭敬敬地为鸟谷小姐宽衣解带?」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"text"},
        text = {
            ja = {
                {
                    "想尽量掩饰急切的心情,却彻底失败了。一边想着,我们俩是真的都",
                    {"rt2"},
                    "没了余裕啊……一边破罐破摔:事到如今没办法了。"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            ja = {
                {
                    "我想触碰鸟谷的身体,想接好多好多吻,想揉她的屁股和欧派,想把她",
                    {"rt2"},
                    "舔个遍。想将藏在这身制服下的鸟谷的身体,毫无保留地尽情品味。"
                }
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"bg", file = "ev_mak_h05_02", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h05/", set = "ev_mak_h05"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003385", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「你说的话,都不成句了……冷静点啦……你一说这种怪话,害得我都",
                    {"rt2"},
                    "莫名冷静下来了啦……」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那真是再好不过?」"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003386", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「就是说啊……。总之呢,你自己脱的话,我就闲得没事干,或者说……",
                    {"rt2"},
                    "冷场了不是?　所以这里你就乖乖地,让我来帮你脱」"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"se", vol = 30, id = 1, file = "se2016"},
