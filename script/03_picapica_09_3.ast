        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003305", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「那简直,就像恋爱一样」"
                }
            }
        },
        linknext = "block_00001"
    },
    block_00001 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003306", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「就像所有色彩都焕然一新似的,我的世界改变了」"
                }
            }
        },
        linkback = "block_00000",
        linknext = "block_00002"
    },
    block_00002 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0027", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003307", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「所以,我和母亲之间,什么都不会发生」"
                }
            }
        },
        linkback = "block_00001",
        linknext = "block_00003"
    },
    block_00003 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003308", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「本该在那个人和我之间发生的,憎恨也好,争执也好,悲伤也好,隔阂",
                    {"rt2"},
                    "也好,痛苦也好,一切的一切――」"
                }
            }
        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0026", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003309", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「全都变成了预先失去的东西」"
                }
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0001", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003310", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「草薙,你的画,就有这样的力量。你的画,拥有足以重绘某个人的世",
                    {"rt2"},
                    "界的力量」"
                }
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0008", head = "mak_z1a", lv = 4, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003311", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「所以,画吧」"
                }
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003312", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「画出你的,只属于你的画,求你了」"
                }
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"fg", ch = "真琴", mode = -1, lv = 4, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    "向我恳求的鸟谷,那双紧紧交握在胸前的手,宛如祈祷的姿势,深深地",
                    {"rt2"},
                    "打动了我。"
                }
            }
        },
        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"text"},
        text = {
            ja = {
                {"鸟谷是认真地在恳求我。"}
            }
        },
        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「鸟谷,我」"
                }
            }
        },
        linkback = "block_00009",
        linknext = "block_00011"
    },
    block_00011 = {
        {"text"},
        text = {
            ja = {
                {"所以我必须回应鸟谷的这份认真。"}
            }
        },
        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            ja = {
                {"不容逃避。哪怕那并非鸟谷所期望的形式。"}
            }
        },
        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, resize = 1, path = ":fg/mak/z2/", file = "mak_z2a0100", face = "a0008", head = "mak_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我不会画的」"
                }
            }
        },
        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2a0100", face = "a0009", head = "mak_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003313", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「…………」"
                }
            }
        },
        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"text"},
        text = {
            ja = {
                {"鸟谷的嘴唇颤抖着。那张脸失去血色,一片苍白。"}
            }
        },
        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2a0100", face = "a0008", head = "mak_z2a", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003314", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「无论如何……都不画吗?」"
                }
            }
        },
        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「啊啊,无论如何都不画」"
                }
            }
        },
        linkback = "block_00016",
        linknext = "block_00018"
    },
    block_00018 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「我不会再画了。不,是画不了了」"
                }
            }
        },
        linkback = "block_00017",
        linknext = "block_00019"
    },
    block_00019 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你也知道吧。我的右手几乎没有知觉。我已经没法像从前那样画",
                    {"rt2"},
                    "画了」"
                }
            }
        },
        linkback = "block_00018",
        linknext = "block_00020"
    },
    block_00020 = {
        {"fg", ch = "真琴", size = "z2", mode = 3, path = ":fg/mak/z2/", file = "mak_z2d0100", face = "d0009", head = "mak_z2d", lv = 5, id = 9},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003315", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「我知道。这些,我都知道。可是――你!」"
                }
            }
        },
        linkback = "block_00019",
        linknext = "block_00021"
    },
    block_00021 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「鸟谷,我不会参加摩尔展」"
