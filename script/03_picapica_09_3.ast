        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"text"},
        text = {
            ja = {
                {
                    "拼命地一次又一次把嘴唇贴上来的样子，明明是出于鸟谷的意志，",
                    {"rt2"},
                    "却莫名显得楚楚可怜。非常可爱。"
                }
            }
        },
        linkback = "block_00109",
        linknext = "block_00111"
    },
    block_00111 = {
        {"text"},
        text = {
            ja = {
                {
                    "而且也没那么多余裕了。不知道鸟谷对我是怎么想的，但说实话这",
                    {"rt2"},
                    "真的舒服得不行，已经挺兴奋的了。"
                }
            }
        },
        linkback = "block_00110",
        linknext = "block_00112"
    },
    block_00112 = {
