    },
    block_00113 = {
        {"text"},
        text = {
            ja = {
                {
                    "反复啄吻的过程中，鸟谷的唇因为彼此的唾液而变得湿润起来。嘴",
                    {"rt2"},
                    "唇内侧的黏膜传来光滑的触感。"
                }
            }
        },
        linkback = "block_00112",
        linknext = "block_00114"
    },
    block_00114 = {
        {"text"},
        text = {
            ja = {
                {
                    "想要探索嘟嘟嘴唇更深处的冲动一点一点地膨胀起来。鸟谷口中一",
                    {"rt2"},
