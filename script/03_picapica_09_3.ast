        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            ja = {
                {
                    "我带着三分之一好奇,三分之一期待,三分之一性骚扰的心情问道。",
                    {"rt2"},
                    "鸟谷以惊人的气势,嗖嗖地把头摇成了拨浪鼓。"
                }
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"bg", file = "ev_mak_h05_08", sync = 0, face = 1, time = 400, path = ":ev/ev_mak_h05/", set = "ev_mak_h05"},
        {"mwact", act = "いいえ", size = 5},
        {"text"},
