    block_00414 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「在这马上就要射精的节骨眼上,你那颗发言炸弹,差点让我当场走",
                    {"rt2"},
                    "火……」"
                }
            }
        },
        linkback = "block_00413",
        linknext = "block_00415"
    },
    block_00415 = {
        {"text"},
        text = {
