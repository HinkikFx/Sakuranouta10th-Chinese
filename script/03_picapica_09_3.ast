        linkback = "block_00392",
        linknext = "block_00394"
    },
    block_00394 = {
        {"text"},
        text = {
            ja = {
                {
                    "在犹豫的唇动之后，含泪的鸟谷涨红着脸瞪着我，从灼热急促的呼",
