        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「总之没事的。放心吧。不管你有多动摇,怎么想都是我这边更危险",
                    {"rt2"},
                    ",我已经蠢蠢欲动到不知该拿自己怎么办的地步了」"
