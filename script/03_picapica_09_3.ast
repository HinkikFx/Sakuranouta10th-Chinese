        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            ja = {
                {
                    "一会儿移开视线,一会儿又转回来,转眼涨红了脸闭上眼睛,又扑棱扑",
