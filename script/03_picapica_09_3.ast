    block_00272 = {
        {"text"},
        text = {
            ja = {
                {
                    "抵在鸟谷身上的小鸡鸡,已经膨胀到了几乎要撑裂的地步。俯视着那",
                    {"rt2"},
                    "根以陡峭角度昂起的小鸡鸡,鸟谷漏出灼热的吐息。"
                }
            }
        },
        linkback = "block_00271",
        linknext = "block_00273"
    },
    block_00273 = {
