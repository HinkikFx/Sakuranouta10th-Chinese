    block_00104 = {
        {"text"},
        text = {
            ja = {
                {
                    "这次是鸟谷主动凑了上来。她柔软的嘴唇紧贴上了我的唇。和同样",
                    {"rt2"},
                    "是嘴唇却截然不同的柔软触感蔓延开来。"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            ja = {
                {
                    "这世上竟然有这么舒服的东西。比蕨饼还水润弹滑，比棉花糖还柔",
                    {"rt2"},
                    "软绵密。"
                }
            }
        },
        linkback = "block_00104",
        linknext = "block_00106"
    },
    block_00106 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003351", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「嗯……哈……啾……嗯……嗯嗯……啾……」"
                }
            }
        },
        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            ja = {
                {
                    "轻轻发出声响，一次又一次地重复着触碰式的亲吻。每次嘴唇碰触，",
                    {"rt2"},
                    "温度都在升高。"
                }
            }
        },
        linkback = "block_00106",
        linknext = "block_00108"
    },
    block_00108 = {
        {"text"},
        text = {
            ja = {
                {
                    "鸟谷的手从我的上臂移开，紧紧攥住了我胸口处的衬衫。那只手还",
                    {"rt2"},
                    "在发抖，紧张得一目了然。"
                }
            }
        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003352", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「嗯……啾、啾……嗯嗯……哈……啾……」"
                }
            }
