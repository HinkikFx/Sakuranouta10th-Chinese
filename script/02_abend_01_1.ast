        linknext = "block_00072"
    },
    block_00072 = {
        {"text"},
        text = {
            ja = {
                {
                    "透过铁丝网，隐约能看到冰川的背影和草帽。而一把撑开的阳伞被",
                    {"rt2"},
                    "挂在了铁丝网上。"
                }
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"text"},
        text = {
            ja = {
                {"我就在那阳伞的阴影之中。"}
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            ja = {
                {"能在阴凉处舒适地午睡而没被直射日光照到……原来是这么回事啊。"}
