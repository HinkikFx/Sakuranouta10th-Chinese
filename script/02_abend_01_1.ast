        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000112", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不过,直到再也做不到的那最后一刻为止,还请您陪里奈演完这样",
