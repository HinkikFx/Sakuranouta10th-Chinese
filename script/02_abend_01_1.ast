        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            ja = {
                {
                    "闯入的中庭。从海上吹来的风恰好穿过建筑之间，形成了一台天然",
                    {"rt2"},
                    "的空调。"
                }
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            ja = {
                {"海风。光是这么说，便觉得颇有风情。"}
