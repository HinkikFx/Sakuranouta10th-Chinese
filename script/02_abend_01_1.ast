            }
        },
        linkback = "block_00062",
        linknext = "block_00064"
    },
    block_00064 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那么?　古怪的你在干什么?大太阳底下还戴着草帽。」"
                }
            }
        },
        linkback = "block_00063",
        linknext = "block_00065"
    },
    block_00065 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000096", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「学长在水边都快晒成干了,所以我决定在旁边观察。」"
                }
            }
        },
        linkback = "block_00064",
        linknext = "block_00066"
    },
    block_00066 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「……意义不明。再说,什么叫水边啊。我可是在中庭睡觉哦?」"
                }
            }
        },
        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000097", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「学长还是一如既往地毫无方位感呢。学长睡觉的地方旁边不就是",
                    {"rt2"},
                    "泳池吗。所以我们现在才这样隔着铁丝网说话呀。」"
                }
            }
        },
        linkback = "block_00066",
        linknext = "block_00068"
    },
    block_00068 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「泳池?啊,这么说来……」"
                }
            }
        },
        linkback = "block_00067",
        linknext = "block_00069"
    },
    block_00069 = {
        {"text"},
        text = {
            ja = {
                {"我本以为自己是在后院午睡,但仔细一想,后院旁边就是泳池。"}
            }
        },
        linkback = "block_00068",
        linknext = "block_00070"
    },
    block_00070 = {
        {"text"},
        text = {
            ja = {
                {
                    "确实,铁丝网的那头能看见泳池……人类这种生物,似乎自带一种功能,",
                    {"rt2"},
                    "会把不感兴趣的东西彻底抹消。"
                }
            }
        },
        linkback = "block_00069",
        linknext = "block_00071"
    },
    block_00071 = {
        {"text"},
        text = {
            ja = {
                {"我忘得一干二净。"}
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"text"},
        text = {
            ja = {
                {
                    "隔着铁丝网,能稍稍看见冰川的背影和草帽。还有一把撑开的阳伞,",
                    {"rt2"},
                    "挂在铁丝网上。"
                }
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"text"},
        text = {
            ja = {
                {"我正处在那把阳伞的影子里。"}
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"text"},
        text = {
            ja = {
                {
                    "之所以能不受阳光直射、在阴凉里舒舒服服地睡午觉,原来是这么回",
                    {"rt2"},
                    "事……"
                }
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「阳伞。你自己不用打吗?」"
                }
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000098", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是的,里奈有草帽嘛。」"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「那你为什么要带阳伞来?」"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000099", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「本来想着说不定会用到,结果好像没什么必要,就放着不管了。」"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「……」"
                }
            }
        },
        linkback = "block_00078",
        linknext = "block_00080"
    },
    block_00080 = {
        {"text"},
        text = {
            ja = {
                {
                    "夏日的阳光下,冰川再怎么娇小,也没有小到一顶草帽就能遮住全身",
                    {"rt2"},
                    "的程度……"
                }
            }
        },
        linkback = "block_00079",
        linknext = "block_00081"
    },
    block_00081 = {
        {"text"},
        text = {
            ja = {
                {"更何况,不用的话,也犯不着撑开了放在那儿吧……"}
            }
        },
        linkback = "block_00080",
        linknext = "block_00082"
    },
    block_00082 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「好热啊。」"
                }
            }
        },
        linkback = "block_00081",
        linknext = "block_00083"
    },
    block_00083 = {
        {"bg", file = "ev_com_a30_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a30/", set = "ev_com_a30"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000100", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是呢。热到在太阳底下睡觉的人会在不知不觉间变成鱼干的程度。",
                    {"rt2"},
                    "」"
                }
            }
        },
        linkback = "block_00082",
        linknext = "block_00084"
    },
    block_00084 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「人哪有那么容易变成鱼干……」"
                }
            }
        },
        linkback = "block_00083",
        linknext = "block_00085"
    },
    block_00085 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000101", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那可不一定哦。中暑是很可怕的。那玩意儿说来就来……」"
                }
            }
        },
        linkback = "block_00084",
        linknext = "block_00086"
    },
    block_00086 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「好像是这么回事……」"
                }
            }
        },
        linkback = "block_00085",
        linknext = "block_00087"
    },
    block_00087 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000102", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「就是这样……。就算本人自以为没事,也可能突然昏过去。必须多",
                    {"rt2"},
                    "加小心。」"
                }
            }
        },
        linkback = "block_00086",
        linknext = "block_00088"
    },
    block_00088 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「挺懂的嘛。」"
                }
            }
        },
        linkback = "block_00087",
        linknext = "block_00089"
    },
    block_00089 = {
        {"bg", file = "ev_com_a30_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a30/", set = "ev_com_a30"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000103", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「里奈身体素质低下,有过好几次经验嘛。」"
                }
            }
        },
        linkback = "block_00088",
        linknext = "block_00090"
    },
    block_00090 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000104", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「尤其是在这种大太阳底下流着口水睡觉的人,特别危险哦……」"
                }
            }
        },
        linkback = "block_00089",
        linknext = "block_00091"
    },
    block_00091 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「没事的……」"
                }
            }
        },
        linkback = "block_00090",
        linknext = "block_00092"
    },
    block_00092 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000105", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「才不是没事。再说了,那么毫无防备的脸,不可以随随便便暴露给",
                    {"rt2"},
                    "别人看。」"
                }
            }
        },
        linkback = "block_00091",
        linknext = "block_00093"
    },
    block_00093 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「有什么关系……」"
                }
            }
        },
        linkback = "block_00092",
        linknext = "block_00094"
    },
    block_00094 = {
        {"bg", file = "ev_com_a30_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a30/", set = "ev_com_a30"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000106", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「这种事情,可轮不到学长来决定哦。」"
                }
            }
        },
        linkback = "block_00093",
        linknext = "block_00095"
    },
    block_00095 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「为什么啊……」"
                }
            }
        },
        linkback = "block_00094",
        linknext = "block_00096"
    },
    block_00096 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000107", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「睡脸,是只属于有资格看到它的人的特权。这样轻易地向公众开放",
                    {"rt2"},
                    ",可叫人为难呢。」"
                }
            }
        },
        linkback = "block_00095",
        linknext = "block_00097"
    },
    block_00097 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「完全听不懂你在说什么……」"
                }
            }
        },
        linkback = "block_00096",
        linknext = "block_00098"
    },
    block_00098 = {
        {"bg", file = "ev_com_a30_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a30/", set = "ev_com_a30"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000108", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「你可曾注视过友人的睡颜?　为了探知友人的真容?　你平日所见",
                    {"rt2"},
                    "的友人之脸,究竟为何物?　而你,可曾为友人的面容而惊愕?」"
                }
            }
        },
        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「又引用些奇怪的东西。话说,你还真知道这种句子啊。」"
                }
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"bg", file = "ev_com_a30_02", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a30/", set = "ev_com_a30"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000109", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「呵呵呵,不愧是草薙学长,挠中中二之心的名句,一下子就能认出原",
                    {"rt2"},
                    "典呢。」"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「别管历史上的伟人叫中二啊……」"
                }
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"bg", file = "ev_com_a30_01", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a30/", set = "ev_com_a30"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000110", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嘛,总而言之,能看到学长的睡脸,是妹妹的特权……」"
