        linkback = "block_00237",
        linknext = "block_00239"
    },
    block_00239 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000170", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「哎呀……我没问题的哦。优美是大小姐可能不知道,就算上不了天",
                    {"rt2"},
                    "堂呢。在三途川塞点钱,就能去极乐世界哦。」"
                }
            }
        },
        linkback = "block_00238",
        linknext = "block_00240"
    },
    block_00240 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000171", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「俗话说,地狱的判决也看钱的脸色嘛。只要有钱,我就能去极乐,完",
                    {"rt2"},
                    "全没问题的哦。」"
                }
            }
        },
        linkback = "block_00239",
        linknext = "block_00241"
    },
    block_00241 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000185", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「是吗?　我在天堂,里奈在极乐吗。」"
                }
            }
