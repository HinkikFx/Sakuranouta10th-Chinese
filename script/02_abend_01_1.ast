                {"vo", file = "fem_rna_000118", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「如你所见,钓鱼——」"
                }
            }
        },
        linkback = "block_00123",
        linknext = "block_00125"
    },
    block_00125 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000140", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「可是这里是泳池哦。」"
                }
            }
        },
        linkback = "block_00124",
        linknext = "block_00126"
    },
    block_00126 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000119", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯。是泳池呢。」"
                }
            }
        },
        linkback = "block_00125",
        linknext = "block_00127"
    },
    block_00127 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000141", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「能钓到什么吗?」"
                }
            }
        },
        linkback = "block_00126",
        linknext = "block_00128"
    },
    block_00128 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000120", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「唔——,我正在调查这一点呢——」"
                }
            }
        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000142", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「开心吗?」"
                }
            }
        },
        linkback = "block_00128",
        linknext = "block_00130"
    },
    block_00130 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000121", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯,朴素地开心——」"
                }
            }
        },
        linkback = "block_00129",
        linknext = "block_00131"
    },
    block_00131 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000143", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「可是,看起来很无聊哦。」"
                }
            }
        },
        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000122", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「什么嘛——。别抬杠呀优美。是『那个』来了吗——」"
                }
            }
        },
        linkback = "block_00131",
        linknext = "block_00133"
    },
    block_00133 = {
        {"text"},
        text = {
            ja = {
                {"川内野的影子微微点头。"}
            }
        },
        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"text"},
        text = {
            ja = {
                {"见状,冰川轻轻摇了摇头。"}
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000123", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「卫生巾不多了,你来这里也没用哦——」"
                }
            }
        },
        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000124", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「所以说快回去吧——。大婶我还要在这儿再蹲一会儿呢。」"
                }
            }
        },
        linkback = "block_00135",
        linknext = "block_00137"
    },
    block_00137 = {
        {"se", file = "se9010", vol = 30, id = 1},
        {"bg", file = "ev_com_a30_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a30/", set = "ev_com_a30"},
        {"text"},
        text = {
            ja = {
                {"川内野乖巧地在冰川身旁坐下。"}
            }
        },
        linkback = "block_00136",
        linknext = "block_00138"
    },
    block_00138 = {
        {"text"},
        text = {
            ja = {
                {"那副理所当然般的举动,让我略感吃惊。"}
            }
        },
        linkback = "block_00137",
        linknext = "block_00139"
    },
    block_00139 = {
        {"text"},
        text = {
            ja = {
                {"川内野,看起来几乎不对任何人敞开心扉……"}
            }
        },
        linkback = "block_00138",
        linknext = "block_00140"
    },
    block_00140 = {
        {"text"},
        text = {
            ja = {
                {"明石自不必说,对圭和我,还有同性的鸟谷……甚至对禀也是……"}
            }
        },
        linkback = "block_00139",
        linknext = "block_00141"
    },
    block_00141 = {
        {"text"},
        text = {
            ja = {
                {"可是……不知为何,川内野唯独对冰川敞开着心扉。"}
            }
        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            ja = {
                {"似乎只有在她面前,才会自然地做自己。"}
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"bg", file = "ev_com_a30_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a30/", set = "ev_com_a30"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000125", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「咋啦——优美酱。麻利点儿啦。要上课了哟……大婶给你糖吃哈——",
                    {"rt2"},
                    "拿了糖就快点儿回家去哈——」"
                }
            }
        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000144", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「不要。我讨厌甜的。还有什么上课不上课的,现在已经是暑假了…",
                    {"rt2"},
                    "…」"
                }
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000126", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「讨厌甜的?　是嘛,甜的明明那么好吃……那要不要吃醋昆布?　好",
                    {"rt2"},
                    "吃哟。带着股醋味儿,老好吃了哟。」"
                }
            }
        },
        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000145", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「里奈,不怎么好笑……你这模仿秀……」"
                }
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"bg", file = "ev_com_a30_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a30/", set = "ev_com_a30"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000127", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不好笑吗……现在可是大流行呢……明明从今年上半年开始会疯了",
                    {"rt2"},
                    "似的流行起来的……」"
                }
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000146", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那是在里奈的宇宙里的事吧……」"
                }
            }
        },
        linkback = "block_00147",
        linknext = "block_00149"
    },
    block_00149 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000128", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「我宇宙等于一切宇宙,所以在我宇宙里流行,就意味着在全宇宙流",
                    {"rt2"},
                    "行,也就是说……啊,解释起来好麻烦……」"
                }
            }
        },
        linkback = "block_00148",
        linknext = "block_00150"
    },
    block_00150 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000147", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「里奈在教室里总是端庄娴静,说话也很有气质……。所以,你只在我",
                    {"rt2"},
                    "面前露出这种随便的态度,我很高兴……」"
                }
            }
        },
        linkback = "block_00149",
        linknext = "block_00151"
    },
    block_00151 = {
        {"text"},
        text = {
            ja = {
                {"冰川在教室里端庄娴静有气质?那个冰川?　当真?"}
            }
        },
        linkback = "block_00150",
        linknext = "block_00152"
    },
    block_00152 = {
        {"text"},
        text = {
            ja = {
                {"那只是川内野滤镜吧?"}
            }
        },
        linkback = "block_00151",
        linknext = "block_00153"
    },
    block_00153 = {
        {"text"},
        text = {
            ja = {
                {"至少,我从没见过那样的冰川……"}
            }
        },
        linkback = "block_00152",
        linknext = "block_00154"
    },
    block_00154 = {
        {"text"},
        text = {
            ja = {
                {"不。"}
            }
        },
        linkback = "block_00153",
        linknext = "block_00155"
    },
    block_00155 = {
        {"text"},
        text = {
            ja = {
                {"啊,这么说来,刚认识那会儿,好像的确有过那种感觉。"}
            }
        },
        linkback = "block_00154",
        linknext = "block_00156"
    },
    block_00156 = {
        {"text"},
        text = {
            ja = {
                {
                    "不过,那与其说是端庄娴静,不如说是另一种东西,该说是阴郁吗……是",
                    {"rt2"},
                    "更加根深蒂固的东西。"
                }
            }
        },
        linkback = "block_00155",
        linknext = "block_00157"
    },
    block_00157 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000148", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「话说回来,我从以前就性格古怪,所以和我在一起时,你大概是在配",
                    {"rt2"},
                    "合我……」"
                }
            }
        },
        linkback = "block_00156",
        linknext = "block_00158"
    },
    block_00158 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000149", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「不过,里奈还是可爱一点,我会更高兴。」"
                }
            }
        },
        linkback = "block_00157",
        linknext = "block_00159"
    },
    block_00159 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000129", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不,我可没有优美说的那么可爱哦。而且,我从没觉得优美古怪。」"
                }
            }
        },
        linkback = "block_00158",
        linknext = "block_00160"
    },
    block_00160 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000150", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我是很奇怪的。我有自觉。但里奈不一样。自然状态的里奈,会被",
                    {"rt2"},
                    "所有人喜爱。」"
                }
            }
        },
        linkback = "block_00159",
        linknext = "block_00161"
    },
    block_00161 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000130", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不不,我的古怪连草薙学长都认证过……我不是在配合优美哦。这",
                    {"rt2"},
                    "边八成才是我的本性。」"
                }
            }
        },
        linkback = "block_00160",
        linknext = "block_00162"
    },
    block_00162 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000151", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「不,那个学长已经越过古怪,是个纯粹的变态了,脑子也不正常,里奈",
                    {"rt2"},
                    "只是在配合他而已。那家伙是神○病。」"
                }
            }
        },
        linkback = "block_00161",
        linknext = "block_00163"
    },
    block_00163 = {
        {"mwact", act = "びっくり", size = 5},
        {"text"},
        text = {
            ja = {
                {"什、什么!　那个臭丫头!"}
            }
        },
        linkback = "block_00162",
        linknext = "block_00164"
    },
    block_00164 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000131", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嘛,确实,学长是有点不正常呢。」"
                }
            }
        },
        linkback = "block_00163",
        linknext = "block_00165"
    },
    block_00165 = {
        {"mwact", act = "びっくり", size = 5},
        {"text"},
        text = {
            ja = {
                {
                    "冰川你这混蛋!　要比我和川内野的神○病程度,四比六也是川内野更",
                    {"rt2"},
                    "胜一筹吧。按常理想想!"
                }
            }
        },
        linkback = "block_00164",
        linknext = "block_00166"
    },
    block_00166 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000132", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不过,学长与其说是古怪,嘛,更像是才华多得溢出来的人。那个人",
                    {"rt2"},
                    "可是天才……」"
                }
            }
        },
        linkback = "block_00165",
        linknext = "block_00167"
    },
    block_00167 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000152", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「只有才华而已……那家伙……」"
                }
            }
        },
        linkback = "block_00166",
        linknext = "block_00168"
    },
    block_00168 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000133", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「有人说过,天才靠的不是才华哦。」"
                }
            }
        },
        linkback = "block_00167",
        linknext = "block_00169"
    },
    block_00169 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000153", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「谁说的?」"
                }
            }
        },
        linkback = "block_00168",
        linknext = "block_00170"
    },
    block_00170 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000134", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「这个嘛,以前听圭学长说过。说是,天才会让人忘掉才华。」"
                }
            }
        },
        linkback = "block_00169",
        linknext = "block_00171"
    },
    block_00171 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000154", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那个学长纯粹是个笨蛋,他的话不可信。」"
                }
            }
        },
        linkback = "block_00170",
        linknext = "block_00172"
    },
    block_00172 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000135", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是吗。我倒觉得特别在理……」"
                }
            }
        },
        linkback = "block_00171",
        linknext = "block_00173"
    },
    block_00173 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000155", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「呣……」"
                }
            }
        },
        linkback = "block_00172",
        linknext = "block_00174"
    },
    block_00174 = {
        {"text"},
        text = {
            ja = {
                {"川内野鼓起了脸颊。"}
            }
        },
        linkback = "block_00173",
        linknext = "block_00175"
    },
    block_00175 = {
        {"text"},
        text = {
            ja = {
                {"和冰川在一起的时候,川内野……也会露出那样的表情啊。"}
            }
        },
        linkback = "block_00174",
        linknext = "block_00176"
    },
    block_00176 = {
        {"bg", file = "ev_com_a30_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a30/", set = "ev_com_a30"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000136", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「哎呀哎呀,话说回来可真热啊——。这可正是盛夏时节呢……」"
                }
            }
        },
        linkback = "block_00175",
        linknext = "block_00177"
    },
    block_00177 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000156", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我觉得是因为里奈待在这种阳光暴晒的地方才热的……」"
                }
            }
        },
        linkback = "block_00176",
        linknext = "block_00178"
    },
    block_00178 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000137", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「一热就浑身发懒……什么都不想做了呀……」"
                }
            }
        },
        linkback = "block_00177",
        linknext = "block_00179"
    },
    block_00179 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000157", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「为什么会有这么麻烦的事呢——」"
                }
            }
        },
        linkback = "block_00178",
        linknext = "block_00180"
    },
    block_00180 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000138", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「你说夏天?　夏天可不麻烦哦,小姑娘。蓝天,白云,一望无际的大海。",
                    {"rt2"},
                    "长长的假期,以及假期!」"
                }
            }
        },
        linkback = "block_00179",
        linknext = "block_00181"
    },
    block_00181 = {
        {"bg", file = "ev_com_a30_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a30/", set = "ev_com_a30"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000139", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「以及从7月下旬一直放到9月1日的假期!」"
                }
            }
        },
        linkback = "block_00180",
        linknext = "block_00182"
    },
    block_00182 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000158", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「你很喜欢暑假呢……」"
                }
            }
        },
        linkback = "block_00181",
        linknext = "block_00183"
    },
    block_00183 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000140", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那当然,喜欢得不得了。」"
                }
            }
        },
        linkback = "block_00182",
        linknext = "block_00184"
    },
    block_00184 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000159", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「夏天我也不觉得麻烦……暑假我也喜欢。」"
                }
            }
        },
        linkback = "block_00183",
        linknext = "block_00185"
    },
    block_00185 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000141", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那小姑娘你,觉得什么麻烦呢?」"
                }
            }
        },
        linkback = "block_00184",
        linknext = "block_00186"
    },
    block_00186 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000160", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「生理期……好麻烦。」"
                }
            }
        },
        linkback = "block_00185",
        linknext = "block_00187"
    },
    block_00187 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000142", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「啊——那个啊——,那个是挺麻烦的——但那是为了留下子孙嘛——」"
                }
            }
        },
        linkback = "block_00186",
        linknext = "block_00188"
    },
    block_00188 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000161", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我不留子孙。」"
                }
            }
        },
        linkback = "block_00187",
        linknext = "block_00189"
    },
    block_00189 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000143", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「神明大人才不管个人的种种情况哦。不放到同一条生产线上制造",
                    {"rt2"},
                    "会很麻烦嘛。就这样,大家才都是同一个规格的哦。」"
                }
            }
        },
        linkback = "block_00188",
        linknext = "block_00190"
    },
    block_00190 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000162", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「我才不管神明的种种情况……净是些奇怪的地方规格相同,重要的",
                    {"rt2"},
                    "事情却大家各不相同……胡来一气。」"
                }
            }
        },
        linkback = "block_00189",
        linknext = "block_00191"
    },
    block_00191 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000163", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「要是真有神明这号家伙存在,我简直想去跟他抱怨一番……」"
                }
            }
        },
        linkback = "block_00190",
        linknext = "block_00192"
    },
    block_00192 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000144", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「你要说什么?」"
                }
            }
        },
        linkback = "block_00191",
        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000164", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「说很多。」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000145", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「那你可得加油了呢。」"
                }
            }
        },
        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000165", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「加油?」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000146", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「是啊是啊,神明大人这位人物呢,规格上就设定成只有上天堂的人",
                    {"rt2"},
                    "才能见到。想抱怨的话,就得努力活成能上天堂的样子才行哦。」"
                }
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000166", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「这样啊……真是个架子很大的人呢。要花上一辈子来预约才能见",
                    {"rt2"},
                    "到……真是个过分的家伙呢,那家伙。」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000147", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「所以说嘛……神明大人才不管个人的种种情况哦。神明大人可不",
                    {"rt2"},
                    "会顾及我们这边方不方便呢。」"
                }
            }
        },
        linkback = "block_00197",
        linknext = "block_00199"
    },
    block_00199 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000167", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那么,要怎样才能上天堂呢?」"
                }
            }
        },
        linkback = "block_00198",
        linknext = "block_00200"
    },
    block_00200 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000148", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「唔——。这方面不是小里奈的专业,不太清楚,念念佛啦,献上活祭啦,",
                    {"rt2"},
                    "发动圣战啦,嘛,方法很多,但最简便的推荐是……」"
                }
            }
        },
        linkback = "block_00199",
        linknext = "block_00201"
    },
    block_00201 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000149", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「把钱交给我,大概。」"
                }
            }
        },
        linkback = "block_00200",
        linknext = "block_00202"
    },
    block_00202 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000168", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「为什么会变成那样?」"
                }
            }
        },
        linkback = "block_00201",
        linknext = "block_00203"
    },
    block_00203 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000150", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「想听?」"
                }
            }
        },
        linkback = "block_00202",
        linknext = "block_00204"
    },
    block_00204 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000169", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「嗯……」"
                }
            }
        },
        linkback = "block_00203",
        linknext = "block_00205"
    },
    block_00205 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000151", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「说来可就话长了……可以吗。」"
                }
            }
        },
        linkback = "block_00204",
        linknext = "block_00206"
    },
    block_00206 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000170", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「嗯。」"
                }
            }
        },
        linkback = "block_00205",
        linknext = "block_00207"
    },
    block_00207 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000152", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「都说了会很长……」"
                }
            }
        },
        linkback = "block_00206",
        linknext = "block_00208"
    },
    block_00208 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000171", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「嗯。」"
                }
            }
        },
        linkback = "block_00207",
        linknext = "block_00209"
    },
    block_00209 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000153", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「解释起来太费劲了,你直接把钱给我吧……」"
                }
            }
        },
        linkback = "block_00208",
        linknext = "block_00210"
    },
    block_00210 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000172", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「不能让我信服就不给钱。」"
                }
            }
        },
        linkback = "block_00209",
        linknext = "block_00211"
    },
    block_00211 = {
        {"bg", file = "ev_com_a30_07", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a30/", set = "ev_com_a30"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000154", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「也就是说信服了就付钱,把总额付给我的意思咯。从前呢。在很久",
                    {"rt2"},
                    "很久以前呢。西方的大陆上,有过神明大人的第三具分身……」"
                }
            }
        },
        linkback = "block_00210",
        linknext = "block_00212"
    },
    block_00212 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000173", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「故事的开头好突兀……」"
                }
            }
        },
        linkback = "block_00211",
        linknext = "block_00213"
    },
    block_00213 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000155", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「行了,闭嘴听着。这位神明的分身呢。为了传授世界的真理,在世",
                    {"rt2"},
                    "界各地到处传教。」"
                }
            }
        },
        linkback = "block_00212",
        linknext = "block_00214"
    },
    block_00214 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000156", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「这样一来,这位神明化身的身边,就聚集了许多弟子……」"
                }
            }
        },
        linkback = "block_00213",
        linknext = "block_00215"
    },
    block_00215 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000174", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「神明的化身什么的,好可疑……」"
                }
            }
        },
        linkback = "block_00214",
        linknext = "block_00216"
    },
    block_00216 = {
        {"bg", file = "ev_com_a30_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a30/", set = "ev_com_a30"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000157", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯,是呢。所以有个弟子就问了。」"
                }
            }
        },
        linkback = "block_00215",
        linknext = "block_00217"
    },
    block_00217 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000158", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「要开启天国之门,我们该行何事才好呢……」"
                }
            }
        },
        linkback = "block_00216",
        linknext = "block_00218"
    },
    block_00218 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000159", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「于是神明的化身便如此说道……你若想要得着它……当遵守诫命。」"
                }
            }
        },
        linkback = "block_00217",
        linknext = "block_00219"
    },
    block_00219 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000175", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「诫命?　什么样的诫命?」"
                }
            }
        },
        linkback = "block_00218",
        linknext = "block_00220"
    },
    block_00220 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000160", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「首先,不可杀人。不可奸淫。不可偷盗。不可作伪证,当孝敬父母…",
                    {"rt2"},
                    "…还要爱邻如己……」"
                }
            }
        },
        linkback = "block_00219",
        linknext = "block_00221"
    },
    block_00221 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000176", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「满满一大堆……」"
                }
            }
        },
        linkback = "block_00220",
        linknext = "block_00222"
    },
    block_00222 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000161", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯,人要开启天国之门,就得用一辈子去遵守这满满一大堆的诫命…",
                    {"rt2"},
                    "…」"
                }
            }
        },
        linkback = "block_00221",
        linknext = "block_00223"
    },
    block_00223 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000177", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「欸……真辛苦啊……天国这地方……」"
                }
            }
        },
        linkback = "block_00222",
        linknext = "block_00224"
    },
    block_00224 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000162", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不过呢,那位弟子非常优秀,这些全都遵守了。」"
                }
            }
        },
        linkback = "block_00223",
        linknext = "block_00225"
    },
    block_00225 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000178", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那,那个人能上天堂吗?」"
                }
            }
        },
        linkback = "block_00224",
        linknext = "block_00226"
    },
    block_00226 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000163", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不。据说还是不行。」"
                }
            }
        },
        linkback = "block_00225",
        linknext = "block_00227"
    },
    block_00227 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000179", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「为什么?」"
                }
            }
        },
        linkback = "block_00226",
        linknext = "block_00228"
    },
    block_00228 = {
        {"bg", file = "ev_com_a30_06", sync = 0, face = 1, time = 400, path = ":ev/ev_com_a30/", set = "ev_com_a30"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000164", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「主如此说道……你若想要开启完全之门,当下到街市,变卖你的一切",
                    {"rt2"},
                    "所有,施舍给穷人。」"
                }
            }
        },
        linkback = "block_00227",
        linknext = "block_00229"
    },
    block_00229 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000165", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「如此,你必有财富积于天上……」"
                }
            }
        },
        linkback = "block_00228",
        linknext = "block_00230"
    },
    block_00230 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000180", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「……」"
                }
            }
        },
        linkback = "block_00229",
        linknext = "block_00231"
    },
    block_00231 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000166", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「富人穿过天国之门,比骆驼穿过针眼还要难……」"
                }
            }
        },
        linkback = "block_00230",
        linknext = "block_00232"
    },
    block_00232 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000167", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「据说那位弟子面露悲伤,离开了神明分身的身边……」"
                }
            }
        },
        linkback = "block_00231",
        linknext = "block_00233"
    },
    block_00233 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_yum_000181", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「那是当然的……」"
                }
            }
        },
        linkback = "block_00232",
        linknext = "block_00234"
    },
    block_00234 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000168", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「不过呢,想上天堂,最快的捷径据说就是掏钱。」"
                }
            }
        },
