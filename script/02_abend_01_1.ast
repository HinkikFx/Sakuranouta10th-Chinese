        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"text"},
        text = {
            ja = {
                {
                    "然而，夏日的阳光实在无情。",
                    {"txruby", text = "本就"},
                    "只",
                    {"txruby"},
