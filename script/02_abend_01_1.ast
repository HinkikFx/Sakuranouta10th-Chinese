    },
    block_00130 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rna_000121", ch = "rna"}
            },
            ja = {
                {
                    name = {"里奈"},
                    "「嗯，还挺闷骚地好玩的」"
                }
