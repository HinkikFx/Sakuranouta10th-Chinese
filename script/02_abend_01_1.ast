        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            ja = {
                {
                    "溜进来的中庭。来自海上的风恰好穿过建筑物之间,成了一台小小的",
