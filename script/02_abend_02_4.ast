            vo = {
                {"vo", file = "man_ked_000910", ch = "ked"}
            },
            ja = {
                {
                    name = {"圭"},
                    "「草薙直哉那个男子人啊。重情重义得像个傻瓜,烂好人也当得像个",
                    {"rt2"},
                    "傻瓜。不为任何人所知,到处插手各种事情,亲手失去一样又一样东",
                    {"rt2"},
                    "西」"
                }
            }
        },
        linkback = "block_00070",
        linknext = "block_00072"
    },
    block_00072 = {
        {"fg", ch = "圭", size = "z1", mode = 3, path = ":fg/kei/z1/", file = "kei_z1a0100", face = "a0016", head = "kei_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_ked_000911", ch = "ked"}
            },
            ja = {
                {
                    name = {"圭"},
                    "「虽然不甘心,但我做不到的事,本来应该由我去做的事,都是那家伙",
                    {"rt2"},
                    "替我做了……」"
                }
            }
        },
        linkback = "block_00071",
        linknext = "block_00073"
    },
    block_00073 = {
        {"fg", ch = "圭", size = "z1", mode = 3, path = ":fg/kei/z1/", file = "kei_z1a0100", face = "a0005", head = "kei_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_ked_000912", ch = "ked"}
            },
            ja = {
                {
                    name = {"圭"},
                    "「可是啊,那种事一旦察觉了就不行,必须当作从来没有过。虽然不",
                    {"rt2"},
                    "甘心,但我能做的只有这样」"
                }
            }
        },
        linkback = "block_00072",
        linknext = "block_00074"
    },
    block_00074 = {
        {"fg", ch = "圭", size = "z1", mode = 3, path = ":fg/kei/z1/", file = "kei_z1a0100", face = "a0002", head = "kei_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_ked_000913", ch = "ked"}
            },
            ja = {
                {
                    name = {"圭"},
                    "「那家伙,真的就像漫画里的英雄一样。不只是画。不只是才能之类",
                    {"rt2"},
                    "的东西」"
                }
            }
        },
        linkback = "block_00073",
        linknext = "block_00075"
    },
    block_00075 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0001", head = "mak_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_000946", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「所以,我明白了」"
                }
            }
        },
        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"fg", ch = "圭", size = "z1", mode = 3, path = ":fg/kei/z1/", file = "kei_z1a0100", face = "a0008", head = "kei_z1a", x = 345, lv = 4, id = 6},
        {"text"},
        text = {
            vo = {
                {"vo", file = "man_ked_000914", ch = "ked"}
            },
            ja = {
                {
                    name = {"圭"},
                    "「……」"
                }
            }
        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0011", head = "mak_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_000947", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「那个时候,大概,草薙不再画画的理由……」"
                }
            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"fg", ch = "真琴", size = "z1", mode = 3, path = ":fg/mak/z1/", file = "mak_z1a0100", face = "a0001", head = "mak_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_000948", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「不过,其实理由本身我想我们早就察觉了。只要是画画的人就能明",
                    {"rt2"},
                    "白吧。那家伙那些不自然的举动」"
                }
            }
        },
        linkback = "block_00077",
        linknext = "block_00079"
    },
    block_00079 = {
