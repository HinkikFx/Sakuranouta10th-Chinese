    },
    block_00133 = {
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "紗希", size = "z2", mode = 3, path = ":fg/sak/z2/", file = "sak_z2a0000", face = "a0004", head = "sak_z2a", x = -345, lv = 5, id = 5}
