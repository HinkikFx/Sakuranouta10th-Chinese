    },
    block_00239 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「你说你认出雾乃小姐是圭的母亲的理由，和我的差不多——该不会，",
                    {"rt2"},
                    "其实还有更多的内情吧？」"
