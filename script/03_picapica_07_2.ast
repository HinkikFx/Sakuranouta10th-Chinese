        linkback = "block_00082",
        linknext = "block_00084"
    },
    block_00084 = {
        {"fg", ch = "紗希", size = "z1", mode = 3, path = ":fg/sak/z1/", file = "sak_z1a0000", face = "a0005", head = "sak_z1a", x = -345, lv = 4, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_krd_000073", ch = "krd"}
            },
            ja = {
                {
                    name = {"雾乃"},
                    "「据本间女士说，她总觉得我的名字好像在哪里听到过。于是一调",
