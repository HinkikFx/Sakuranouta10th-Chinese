        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"text"},
        delay = {
            vl01 = {
                {"fg", ch = "紗希", size = "z2", mode = 3, path = ":fg/sak/z2/", file = "sak_z2a0000", face = "a0008", head = "sak_z2a", x = -345, lv = 5, id = 5}
            }
        },
        text = {
            vo = {
                {"vo", file = "fem_htd_000243", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「我只是代为保管。鸟谷家不过是单纯的保管场所。等圭成年之后，",
                    {"rt2"},
                    "鸟谷家保管的画预定会全部转让给圭」"
                }
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"fg", ch = "紗希", size = "z2", mode = 3, path = ":fg/sak/z2/", file = "sak_z2a0000", face = "a0005", head = "sak_z2a", x = -345, lv = 5, id = 5},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000244", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长"},
                    "「我之所以管理圭的画，是为了不让中村家围绕圭的画，把麻烦事",
                    {"rt2"},
                    "和无理取闹，找到圭本人或者夏目宅那里去」"
                }
            }
        },
        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"fgact", ch = "紗希", act = "うなづく", lv = 5, id = 5},
