    block_00083 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「丽华起初，是打算把雾乃小姐当奴隶使唤。那是从什么时候起，",
                    {"rt2"},
                    "变成了夺取圭的画的图谋？」"
