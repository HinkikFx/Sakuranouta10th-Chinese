        linknext = "block_00193"
    },
    block_00193 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「该说谢谢的人是我啊……」"
                }
            }
        },
        linkback = "block_00192",
        linknext = "block_00194"
    },
    block_00194 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
