        linkback = "block_00193",
        linknext = "block_00195"
    },
    block_00195 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「所以，我才能待在这里」"
                }
            }
        },
        linkback = "block_00194",
        linknext = "block_00196"
    },
    block_00196 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「真要说感谢的话，应该是我才对」"
                }
            }
        },
        linkback = "block_00195",
        linknext = "block_00197"
    },
    block_00197 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001668", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「是吗？是吗……。那你就说出来嘛」"
                }
            }
        },
        linkback = "block_00196",
        linknext = "block_00198"
    },
    block_00198 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_aid_001669", ch = "aid"}
            },
            ja = {
                {
                    name = {"蓝"},
                    "「直哉，对我说声谢谢吧」"
