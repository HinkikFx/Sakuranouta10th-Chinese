        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100457", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「那我就自己自慰了。光靠小豆豆还不够的话，就把自己买的按摩",
                    {"rt2"},
                    "棒什么的插进去？」"
