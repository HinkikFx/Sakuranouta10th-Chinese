        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100456", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「啊，那种东西不需要的。请不用客气。我也想省了前戏赶紧插进",
                    {"rt2"},
                    "来比较开心」"
                }
            }
