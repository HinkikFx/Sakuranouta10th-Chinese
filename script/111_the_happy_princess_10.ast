        linknext = "block_00008"
    },
    block_00008 = {
        {"mwact", act = "うんうん", size = 5},
        {"bg", file = "ev_app_h12_03", sync = 0, face = 1, time = 400, path = ":ev/ev_app_h12/", set = "ev_app_h12"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100455", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「呵呵，男子孩子真辛苦呢。嘛，我的内裤也完全不行了就是了」"
