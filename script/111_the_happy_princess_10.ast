    },
    block_00014 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_rnd_100458", ch = "rnd"}
            },
            ja = {
                {
                    name = {"禀"},
                    "「但是你要是让我自慰的话，自慰前后都会揍你一顿的哦」"
