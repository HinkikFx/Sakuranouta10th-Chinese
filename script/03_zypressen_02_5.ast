                {"vo", file = "fem_yum_001474", ch = "yum"}
            },
            ja = {
                {
                    "我原以为她心中翻涌的情感是「愤怒」或者「悲伤」，无论哪种，",
                    {"rt2"},
                    "都是因为自己的作品被人擅自覆盖。然而，接下来的一句话让我明",
                    {"rt2"},
