        },
        linkback = "block_00027",
        linknext = "block_00029"
    },
    block_00029 = {
        {"text"},
        text = {
            ja = {
                {"除她之外别无他人。"}
            }
        },
        linkback = "block_00028",
        linknext = "block_00030"
    },
    block_00030 = {
        {"text"},
        text = {
            ja = {
                {
                    "因为用室内鞋作画的人是有限的，更重要的是其他人我都亲眼确认",
                    {"rt2"},
                    "过了。"
