        {"bg", file = "ev_uni_c24_01", path = ":ev/ev_uni_c24/", set = "ev_uni_c24"},
        {"bgm", file = "bgm038"},
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「唔——」"
                }
            }
        },
        linknext = "block_00001"
    },
    block_00001 = {
        {"text"},
        text = {
            ja = {
                {"我站在教会前,紧盯着那幅壁画——《樱花们的足迹》。"}
            }
        },
        linkback = "block_00000",
        linknext = "block_00002"
    },
    block_00002 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「果然是这样啊……」"
                }
            }
        },
        linkback = "block_00001",
        linknext = "block_00003"
    },
    block_00003 = {
        {"se", file = "se2497", vol = 50, id = 1},
        {"text"},
        text = {
            ja = {
                {"我再次翻开草薙健一郎设计图的复印件。"}
            }
        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"text"},
        text = {
            ja = {
                {"设计图的原件,并不是失去继承权的我可以留在手里的东西。"}
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            ja = {
                {"那东西也会被妥善处理换成钱,按照健一郎的初衷去使用吧。"}
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            ja = {
                {"这方面,那个可恶的外国佬弗里德曼应该会办得妥妥当当。"}
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            ja = {
                {"比起那些……"}
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「嗯……」"
                }
            }
        },
        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"text"},
        text = {
            ja = {
                {"果然,有一部分花瓣的形状和设计图相差甚远。"}
            }
        },
        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"text"},
        text = {
            ja = {
                {
                    "位置、角度,而且最关键的是,下笔(这种情况该说是下鞋?)的方式不",
                    {"rt2"},
                    "一样。"
                }
            }
        },
        linkback = "block_00009",
        linknext = "block_00011"
    },
    block_00011 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「之所以没让圭参加,是因为那家伙的才能很可能会流露出自我……。",
                    {"rt2"},
                    "以那家伙的才能,搞不好会和草薙健一郎的画风撞在一起」"
                }
            }
        },
        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            ja = {
                {"可是,这一部分的花瓣又算怎么回事?"}
            }
        },
        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「明明比圭还要随心所欲……」"
                }
            }
        },
        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「却没有扼杀草薙健一郎的作品,反而让它活了过来」"
                }
            }
        },
        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"text"},
        text = {
            ja = {
                {
                    "这张设计图,是草薙健一郎出道前画的东西。属于一般所说的前期草",
                    {"rt2"},
                    "薙作品。"
                }
            }
        },
        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"text"},
        text = {
            ja = {
                {"正因如此,这一部分虽然透着违和感,却没有任何人察觉到吧。"}
            }
        },
        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「这带着违和感的部分,是后期草薙健一郎——不,更准确地说,是接近",
                    {"rt2"},
                    "完成《横卧之樱》那个时期的笔势……」"
                }
            }
        },
        linkback = "block_00016",
        linknext = "block_00018"
    },
    block_00018 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「简直就像草薙健一郎复活了一样……」"
                }
            }
        },
        linkback = "block_00017",
        linknext = "block_00019"
    },
    block_00019 = {
        {"text"},
        text = {
            ja = {
                {"不,又不太一样。"}
            }
        },
        linkback = "block_00018",
        linknext = "block_00020"
    },
    block_00020 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「说得极端点,甚至像是凌驾于全盛期的草薙健一郎之上……」"
                }
            }
        },
        linkback = "block_00019",
        linknext = "block_00021"
    },
    block_00021 = {
        {"text"},
        text = {
            ja = {
                {"不,这未免言过其实了。"}
            }
        },
        linkback = "block_00020",
        linknext = "block_00022"
    },
    block_00022 = {
        {"text"},
        text = {
            ja = {
                {"那家伙是何等的天才,我最清楚不过。"}
            }
        },
        linkback = "block_00021",
        linknext = "block_00023"
    },
    block_00023 = {
        {"text"},
        text = {
            ja = {
                {
                    "他是第一个、也是最后一个获得穆亚展最高金奖普拉蒂努·埃波拉尔",
                    {"rt2"},
                    "的日本人。"
                }
            }
        },
        linkback = "block_00022",
        linknext = "block_00024"
    },
    block_00024 = {
        {"text"},
        text = {
            ja = {
                {
                    "尽管被人说贪财、商业艺术家、江湖骗子,他的作品至今仍被世界各",
                    {"rt2"},
                    "地无数人所深爱着。"
                }
            }
        },
        linkback = "block_00023",
        linknext = "block_00025"
    },
    block_00025 = {
        {"text"},
        text = {
            ja = {
                {"轻率地说出“超越那家伙的才能”之类的话,根本是无稽之谈。"}
            }
        },
        linkback = "block_00024",
        linknext = "block_00026"
    },
    block_00026 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是我的眼睛蒙尘了吗?」"
                }
            }
        },
        linkback = "block_00025",
        linknext = "block_00027"
    },
    block_00027 = {
        {"text"},
        text = {
            ja = {
                {"总而言之,做出这一部分的嫌疑人只有一个。"}
            }
        },
        linkback = "block_00026",
        linknext = "block_00028"
    },
    block_00028 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「吹……」"
                }
            }
        },
        linkback = "block_00027",
        linknext = "block_00029"
    },
    block_00029 = {
        {"text"},
        text = {
            ja = {
                {"除了那家伙不作他想。"}
            }
        },
        linkback = "block_00028",
        linknext = "block_00030"
    },
    block_00030 = {
        {"text"},
        text = {
            ja = {
                {
                    "要说为什么,用上履鞋作画的人本来就有限,而且其他人下笔时我都",
                    {"rt2"},
                    "是一边确认一边进行的。"
                }
            }
        },
        linkback = "block_00029",
        linknext = "block_00031"
    },
    block_00031 = {
        {"text"},
        text = {
            ja = {
                {"我没有确认过上履鞋笔触的,只有一个人。"}
            }
        },
        linkback = "block_00030",
        linknext = "block_00032"
    },
    block_00032 = {
