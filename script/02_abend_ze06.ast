    block_00002 = {
        {"text"},
        text = {
            ja = {
                {"并非我所知晓的记忆。"}
            }
        },
        linkback = "block_00001",
        linknext = "block_00003"
    },
    block_00003 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_had_000010", ch = "had"}
            },
            ja = {
                {
                    "「长夜漫漫悠远眠　众人梦觉齐醒转　乘波行舟橹声远　声声入耳",
                    {"rt2"},
                    "皆安然」"
                }
            }
        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"text"},
        text = {
            ja = {
                {
                    "船只在茫茫大海上缓缓地、坚定地前行，劈波斩浪的涛声是如此悦",
                    {"rt2"},
                    "耳，仿佛这长夜将永远持续下去一般，令人不由得从睡梦中醒来。"
                }
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            ja = {
                {"因过于舒适安然而醒来的梦。"}
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            ja = {
                {"想必，也有这样的梦吧……。"}
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"msgoff"},
