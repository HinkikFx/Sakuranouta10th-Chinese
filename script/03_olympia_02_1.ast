            }
        },
        linkback = "block_00076",
        linknext = "block_00078"
    },
    block_00078 = {
        {"text"},
        text = {
            ja = {
                {
                    "（通过触摸可以把握肌肉的运动。也就是说，可以在脑海中将解剖",
                    {"rt2"},
                    "图上描绘的医学人体结构构建成具有运动性的动态对象）"
