        linkback = "block_00065",
        linknext = "block_00067"
    },
    block_00067 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「是啊。知识不能运用到实践里就谈不上有意义。毕竟这是为了画",
