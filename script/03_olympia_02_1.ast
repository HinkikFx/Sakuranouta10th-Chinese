        linkback = "block_00074",
        linknext = "block_00076"
    },
    block_00076 = {
        {"text"},
        text = {
            ja = {
                {
                    "（在人体素描中，骨骼和肌肉的详细名称和种类是不需要去记忆的。",
                    {"rt2"},
                    "那是按摩师或医生的领域）"
                }
