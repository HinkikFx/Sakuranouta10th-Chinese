        },
        linkback = "block_00075",
        linknext = "block_00077"
    },
    block_00077 = {
        {"text"},
        text = {
            ja = {
                {
                    "（但必须理解这些肌肉是如何工作来支撑骨骼、以及通过怎样的伸",
                    {"rt2"},
