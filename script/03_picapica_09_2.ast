            }
        },
        linkback = "block_00053",
        linknext = "block_00055"
    },
    block_00055 = {
        {"text"},
        text = {
            ja = {
                {"我们分离的时间已经太长了。"}
            }
        },
        linkback = "block_00054",
        linknext = "block_00056"
    },
    block_00056 = {
        {"text"},
        text = {
            ja = {
                {
                    "从出生到现在，和母亲交谈的机会屈指可数，我们彼此都已经不知",
                    {"rt2"},
                    "道该怎么做亲子了。"
                }
