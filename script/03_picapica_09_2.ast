        },
        linkback = "block_00115",
        linknext = "block_00117"
    },
    block_00117 = {
        {"se", stop = 1, time = 500, id = 1},
        {"bg", file = "black", path = ":bg/"},
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", file = "bg013a", path = ":bg/", ax = 960, ay = 563, bx = 0, by = -23, sync = 0},
        {"extrans", time = 1000},
        {"text"},
        text = {
            ja = {
                {"第二天。葬礼结束后，我去了市政厅。"}
