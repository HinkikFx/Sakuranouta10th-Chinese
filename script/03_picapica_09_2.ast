                    "鸟谷静流。"
                }
            }
        },
        linkback = "block_00042",
        linknext = "block_00044"
    },
    block_00044 = {
        {"text"},
        text = {
            ja = {
                {
                    "来到鸟谷家之前，我甚至不知道有这个表姐的存在，但因为她经常",
                    {"rt2"},
                    "来玩，我的心渐渐平和了下来。"
                }
            }
        },
        linkback = "block_00043",
        linknext = "block_00045"
    },
    block_00045 = {
        {"text"},
        text = {
            ja = {
                {"以我的境遇来说还算比较健全、开朗地成长起来，多亏了静流。"}
            }
        },
        linkback = "block_00044",
        linknext = "block_00046"
    },
    block_00046 = {
        {"bg", file = "black", path = ":bg/"},
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", file = "bg071a", path = ":bg/", sync = 0},
        {"extrans", time = 1000},
        {"text"},
        text = {
