        },
        linkback = "block_00127",
        linknext = "block_00129"
    },
    block_00129 = {
        {"text"},
        text = {
            ja = {
                {"笑意一点点从我的唇边溢出，不断地溢出，"}
            }
        },
        linkback = "block_00128",
        linknext = "block_00130"
    },
    block_00130 = {
        {"colortone", style = "reset"},
        {"bg", file = "ev_uni_c50_01", time = 2000, path = ":ev/ev_uni_c50/", set = "ev_uni_c50"},
        {"bgm", file = "bgm022"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_003304", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「哈，哈哈……啊哈哈哈哈……啊哈哈哈哈哈！哈哈！啊哈哈哈哈！」"
                }
            }
        },
        linkback = "block_00129",
        linknext = "block_00131"
    },
    block_00131 = {
        {"text"},
        text = {
            ja = {
                {
                    "停不下来。笑声停不下来。不停地笑，笑着，就算流出了眼泪也还",
                    {"rt2"},
                    "在笑。"
                }
            }
        },
        linkback = "block_00130",
        linknext = "block_00132"
    },
    block_00132 = {
        {"text"},
        text = {
            ja = {
                {
                    "路过的人向我投来诧异的目光，可我完全不在乎。我笑着，笑着，",
                    {"rt2"},
                    "然后哭了。"
                }
            }
        },
        linkback = "block_00131",
        linknext = "block_00133"
    },
    block_00133 = {
        {"text"},
        text = {
            ja = {
                {"明明发过誓，再也不哭了。"}
