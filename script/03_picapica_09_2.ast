        },
        linkback = "block_00132",
        linknext = "block_00134"
    },
    block_00134 = {
        {"text"},
        text = {
            ja = {
                {
                    "我那幼小世界里的誓言，在这幅画面前轻易崩塌，唯有樱，漫山遍",
                    {"rt2"},
                    "野的樱，在我眼前铺展开来。"
                }
            }
        },
        linkback = "block_00133",
        linknext = "block_00135"
    },
    block_00135 = {
        {"text"},
        text = {
            ja = {
                {"了不起。太了不起了。世上竟有这样的才能。"}
            }
        },
        linkback = "block_00134",
        linknext = "block_00136"
    },
    block_00136 = {
        {"text"},
        text = {
            ja = {
                {"特地跑来看户籍的自己，显得无比渺小，无比无聊。"}
