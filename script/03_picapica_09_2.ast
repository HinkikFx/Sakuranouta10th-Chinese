astver = 2.0
astname = "ast"
ast = {
    block_00000 = {
        {"savetitle", text = "第Ⅲ章"},
        {"bg", file = "black", path = ":bg/"},
        {"text"},
        text = {
            ja = {
                {"追溯幼时的记忆，浮现出来的总是那道背影。"}
            }
        },
        linknext = "block_00001"
    },
    block_00001 = {
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"colortone", style = "gray"},
        {"bg", file = "white", path = ":bg/", sync = 0},
        {"fg", ch = "紗希", size = "z1", mode = 3, resize = 1, path = ":fg/sak/z1/", file = "sak_z1c0000", face = "c0001", head = "sak_z1c", lv = 4, id = 9, sync = 0},
        {"extrans", time = 1000},
        {"bgm", file = "bgm109"},
        {"text"},
        text = {
            ja = {
                {"无论是我还是圭，都没有被母亲抚养过的记忆。"}
            }
        },
        linkback = "block_00000",
        linknext = "block_00002"
    },
    block_00002 = {
        {"text"},
        text = {
            ja = {
                {"母亲一直是个非常忙碌的人。"}
            }
        },
        linkback = "block_00001",
        linknext = "block_00003"
    },
    block_00003 = {
        {"text"},
        text = {
            ja = {
                {
                    "至于父亲，见面的次数比母亲还要稀少。他沉迷于工作与社交，对",
                    {"rt2"},
                    "养育孩子毫无兴趣。"
                }
            }
        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"text"},
        text = {
            ja = {
                {"我们只能由父亲那边的祖母，以及代行乳母之职的帮佣抚养长大。"}
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            ja = {
                {"圭一出生，就被寄养在了中村家。"}
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            ja = {
                {"不过，我和圭是异母姐弟这件事，从记事起我就知道了。"}
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            ja = {
                {"中村家，是个人来人往的家。"}
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"text"},
        text = {
            ja = {
                {
                    "亲戚、客人、帮佣……那些没心没肺的周围的大人，将圭的立场究",
                    {"rt2"},
                    "竟是怎样一种东西，或间接或直接地，一次又一次摆到我们面前。"
                }
            }
        },
        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"text"},
        text = {
            ja = {
                {"圭被人嫌恶，被人轻蔑，遭人冷待。"}
            }
        },
        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"text"},
        text = {
            ja = {
                {"然而，我也处于相似的境遇之中。"}
            }
        },
        linkback = "block_00009",
        linknext = "block_00011"
    },
    block_00011 = {
        {"text"},
        text = {
            ja = {
                {"我从来不是中村家的长女，而始终被当作母亲的女儿对待。"}
            }
        },
        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            ja = {
                {
                    "母亲对中村家做了什么不好的事——这一点，在幼年时期，我便已隐",
                    {"rt2"},
                    "约有所理解。"
                }
            }
        },
        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"text"},
        text = {
            ja = {
                {
                    "一切都是你母亲的错——这样的话，祖母如同诅咒一般，不知对我说",
                    {"rt2"},
                    "过多少遍。"
                }
            }
        },
        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"text"},
        text = {
            ja = {
                {
                    "你从那个女人肚子里生出来，本身就是罪过——这样的话，姑母又不",
                    {"rt2"},
                    "知对我说过多少遍。"
                }
            }
        },
        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"text"},
        text = {
            ja = {
                {
                    "即便如此，比起几乎见不到面的母亲，我们更无法信任的，是眼前",
                    {"rt2"},
                    "这些口吐咒诅的人。"
                }
            }
        },
        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"text"},
        text = {
            ja = {
                {
                    "比起这些人的话语，那道什么也不说的背影，反而，不知为何，不",
                    {"rt2"},
                    "知为什么，显得无比清廉。"
                }
            }
        },
        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"text"},
        text = {
            ja = {
                {"祖母和姑母骂我们，说我们是不讨人喜欢的孩子。"}
            }
        },
        linkback = "block_00016",
        linknext = "block_00018"
    },
    block_00018 = {
        {"text"},
        text = {
            ja = {
                {"在那个家里，我们始终孤独。"}
            }
        },
        linkback = "block_00017",
        linknext = "block_00019"
    },
    block_00019 = {
        {"bg", file = "black", path = ":bg/"},
        {"text"},
        text = {
            ja = {
                {
                    "……母亲不只是忙碌，还被人有意地隔离在我们之外——知道这件事，",
                    {"rt2"},
                    "已是很久很久以后了。"
                }
            }
        },
        linkback = "block_00018",
        linknext = "block_00020"
    },
    block_00020 = {
        {"bg", file = "ev_uni_c48_01", path = ":ev/ev_uni_c48/", set = "ev_uni_c48"},
        {"text"},
        text = {
            ja = {
                {
                    "那段幼年时光实在称不上幸福，但因为经营着在悠久历史中培养出",
                    {"rt2"},
                    "众多文化人与艺术家的弓张学园，中村家中陈列着大量美术品，它",
                    {"rt2"},
                    "们成了我们的慰藉。"
                }
            }
        },
        linkback = "block_00019",
        linknext = "block_00021"
    },
    block_00021 = {
        {"text"},
        text = {
            ja = {
                {
                    "对年幼的我们来说，中村的宅邸未免太过广阔。我们俩手牵着手四",
                    {"rt2"},
                    "处探险，接触了许许多多的美术品。"
                }
            }
        },
        linkback = "block_00020",
        linknext = "block_00022"
    },
    block_00022 = {
        {"text"},
        text = {
            ja = {
                {"被众多的画包围着，我们也自然而然地开始画起画来。"}
            }
        },
        linkback = "block_00021",
        linknext = "block_00023"
    },
    block_00023 = {
        {"text"},
        text = {
            ja = {
                {
                    "对我们几乎漠不关心的父亲，不知为何，唯独对我们画画一事面露",
                    {"rt2"},
                    "难色。"
                }
            }
        },
        linkback = "block_00022",
        linknext = "block_00024"
    },
    block_00024 = {
        {"text"},
        text = {
            ja = {
                {
                    "当他发现无论怎样反对，我们都不会停止画画之后，便愈发冷淡，",
                    {"rt2"},
                    "也愈发疏远了。"
                }
            }
        },
        linkback = "block_00023",
        linknext = "block_00025"
    },
    block_00025 = {
        {"text"},
        text = {
            ja = {
                {"母亲则恰恰相反，非常支持我们，还设法安排我们去绘画教室上课。"}
            }
        },
        linkback = "block_00024",
        linknext = "block_00026"
    },
    block_00026 = {
        {"text"},
        text = {
            ja = {
                {
                    "在绘画教室里画画的时间，对我们来说，是可以什么都不想、纯粹",
                    {"rt2"},
                    "享受绘画的自由时光。"
                }
            }
        },
        linkback = "block_00025",
        linknext = "block_00027"
    },
    block_00027 = {
        {"text"},
        text = {
            ja = {
                {"我想快点长大成人。"}
            }
        },
        linkback = "block_00026",
        linknext = "block_00028"
    },
    block_00028 = {
        {"text"},
        text = {
            ja = {
                {
                    "长大成人，从这个仿佛沉在淤泥之中的中村家，从种种羁绊里，获",
                    {"rt2"},
                    "得自由——我如此渴望着。"
                }
            }
        },
        linkback = "block_00027",
        linknext = "block_00029"
    },
    block_00029 = {
        {"bg", file = "black", path = ":bg/"},
        {"text"},
        text = {
            ja = {
                {"可是，远在我长大成人之前，我就离开了中村家。"}
            }
        },
        linkback = "block_00028",
        linknext = "block_00030"
    },
    block_00030 = {
        {"text"},
        text = {
            ja = {
                {"母亲和父亲离婚了。"}
            }
        },
        linkback = "block_00029",
        linknext = "block_00031"
    },
    block_00031 = {
        {"text"},
        text = {
            ja = {
                {
                    "母亲取得了我的亲权，圭却要作为养子去往夏目家，而圭和我画的",
                    {"rt2"},
                    "画，则由鸟谷家负责保管。"
                }
            }
        },
        linkback = "block_00030",
        linknext = "block_00032"
    },
    block_00032 = {
        {"text"},
        text = {
            ja = {
                {"――因为是小妾的孩子，圭才要去夏目家哟！"}
            }
        },
        linkback = "block_00031",
        linknext = "block_00033"
    },
    block_00033 = {
        {"text"},
        text = {
            ja = {
                {"――对你母亲来说，圭是不需要的东西哟！"}
            }
        },
        linkback = "block_00032",
        linknext = "block_00034"
    },
    block_00034 = {
        {"text"},
        text = {
            ja = {
                {"――画倒是买下来了，圭却没人肯买呢！"}
            }
        },
        linkback = "block_00033",
        linknext = "block_00035"
    },
    block_00035 = {
        {"text"},
        text = {
            ja = {
                {"……那时丽华的话，深深扎进我软弱的部分，成了拔不出来的尖刺。"}
            }
        },
        linkback = "block_00034",
        linknext = "block_00036"
    },
    block_00036 = {
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", file = "white", path = ":bg/", sync = 0},
        {"fg", ch = "紗希", size = "z1", mode = 3, path = ":fg/sak/z1/", file = "sak_z1c0000", face = "c0001", head = "sak_z1c", lv = 4, id = 9, sync = 0},
        {"extrans", time = 1000},
        {"text"},
        text = {
            ja = {
                {"为什么。妈妈，为什么。"}
            }
        },
        linkback = "block_00035",
        linknext = "block_00037"
    },
    block_00037 = {
        {"text"},
        text = {
            ja = {
                {
                    "那时的我还太过年幼，要用理性去接受只有圭一个人去夏目家这件",
                    {"rt2"},
                    "事，实在太难太难。"
                }
            }
        },
        linkback = "block_00036",
        linknext = "block_00038"
    },
    block_00038 = {
        {"text"},
        text = {
            ja = {
                {"离婚之后，母亲变得更忙了。"}
            }
        },
        linkback = "block_00037",
        linknext = "block_00039"
    },
    block_00039 = {
        {"text"},
        text = {
            ja = {
                {
                    "离婚后繁杂的交涉、校长的工作、与理事们的周旋，令她分身乏术，",
                    {"rt2"},
                    "无论如何也腾不出与我相处的时间。"
                }
            }
        },
        linkback = "block_00038",
        linknext = "block_00040"
    },
    block_00040 = {
        {"bg", file = "black", path = ":bg/"},
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", file = "bg070a", path = ":bg/", ax = 960, ay = 563, bx = 0, by = -23, sync = 0},
        {"extrans", time = 1000},
        {"text"},
        text = {
            ja = {
                {"母亲离婚后，我住进了母亲的娘家，鸟谷家。"}
            }
        },
        linkback = "block_00039",
        linknext = "block_00041"
    },
    block_00041 = {
        {"text"},
        text = {
            ja = {
                {"鸟谷家的祖父母并不嫌弃我，却也谈不上欢迎。"}
            }
        },
        linkback = "block_00040",
        linknext = "block_00042"
    },
    block_00042 = {
        {"text"},
        text = {
            ja = {
                {
                    "与一直相伴的圭也被拆散，在陌生的家里，我独自一人，静静地郁",
                    {"rt2"},
                    "结着。"
                }
            }
        },
        linkback = "block_00041",
        linknext = "block_00043"
    },
    block_00043 = {
        {"text"},
        text = {
            ja = {
                {
                    "安慰了那样的我的，是母亲那边一位年长许多的表姐。表姐的名字，",
                    {"rt2"},
                    "叫鸟谷静流。"
                }
            }
        },
        linkback = "block_00042",
        linknext = "block_00044"
    },
    block_00044 = {
        {"text"},
        text = {
            ja = {
                {
                    "来鸟谷家之前，我连她的存在都不知道。但由于她频繁地来家里玩，",
                    {"rt2"},
                    "我的心一点点柔软了下来。"
                }
            }
        },
        linkback = "block_00043",
        linknext = "block_00045"
    },
    block_00045 = {
        {"text"},
        text = {
            ja = {
                {
                    "以我的境遇而言，我能长成一个还算健全、开朗的人，多亏了静流",
                    {"rt2"},
                    "吧。"
                }
            }
        },
        linkback = "block_00044",
        linknext = "block_00046"
    },
    block_00046 = {
        {"bg", file = "black", path = ":bg/"},
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", file = "bg071a", path = ":bg/", sync = 0},
