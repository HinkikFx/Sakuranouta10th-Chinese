                    "背影朝向了我。"
                }
            }
        },
        linkback = "block_00056",
        linknext = "block_00058"
    },
    block_00058 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000321", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长", "纱希"},
                    "「有什么想说的话吗？」"
