        linkback = "block_00035",
        linknext = "block_00037"
    },
    block_00037 = {
        {"text"},
        text = {
            ja = {
                {
                    "我那时还太幼小，要用理性去接受只有圭要去夏目家这件事，实在",
                    {"rt2"},
                    "太困难了。"
                }
            }
        },
        linkback = "block_00036",
        linknext = "block_00038"
    },
    block_00038 = {
        {"text"},
        text = {
            ja = {
                {"离婚后，母亲变得更加忙碌了。"}
            }
        },
        linkback = "block_00037",
        linknext = "block_00039"
    },
    block_00039 = {
        {"text"},
        text = {
            ja = {
                {
                    "被离婚后的繁杂交涉、校长的工作、与理事们的周旋所追赶，怎么",
