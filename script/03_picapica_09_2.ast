        linkback = "block_00045",
        linknext = "block_00047"
    },
    block_00047 = {
        {"text"},
        text = {
            ja = {
                {"某一天，我在保管库里看着圭的画嘟囔着，静流这样回答了我。"}
            }
        },
        linkback = "block_00046",
        linknext = "block_00048"
    },
    block_00048 = {
        {"text"},
        text = {
            ja = {
                {"『那个人是非常聪明的人，而且是善良的人，所以一定有什么理由』"}
            }
        },
        linkback = "block_00047",
        linknext = "block_00049"
    },
    block_00049 = {
        {"text"},
        text = {
            ja = {
                {"我对静流的温柔心怀感激。"}
            }
        },
        linkback = "block_00048",
        linknext = "block_00050"
    },
    block_00050 = {
        {"text"},
        text = {
            ja = {
                {"但那时候的我，已经无法相信静流所说的母亲的善良和理由了。"}
            }
        },
        linkback = "block_00049",
        linknext = "block_00051"
    },
    block_00051 = {
        {"bg", file = "black", path = ":bg/"},
        {"msgoff"},
        {"bg", file = "bluesky_summer", time = 1000, sync = 1, id = 1, lv = 5, path = ":cg/"},
        {"text"},
        text = {
            ja = {
                {"过了一段时间，静流因为越来越沉迷于咖啡修行，出了国。"}
            }
        },
        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"text"},
        text = {
            ja = {
                {
                    "我是她最好的理解者，也是她最大的支持者。我笑着挥手把她送走",
                    {"rt2"},
                    "了。"
                }
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"cgdel", id = -1},
        {"bg", file = "black", path = ":bg/"},
        {"text"},
        text = {
            ja = {
                {"然后我又变成了一个人。"}
            }
        },
        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", file = "bg070a", path = ":bg/", ax = 960, ay = 563, bx = 0, by = -23, sync = 0},
        {"extrans", time = 1000},
        {"text"},
        text = {
            ja = {
                {
                    "从偶尔在鸟谷家见到的母亲的话语中，我能渐渐了解到情况在逐步",
