            }
        },
        linkback = "block_00045",
        linknext = "block_00047"
    },
    block_00047 = {
        {"text"},
        text = {
            ja = {
                {"某一天，在保管库里望着圭的画喃喃自语的我，听到静流这样回答。"}
            }
        },
        linkback = "block_00046",
        linknext = "block_00048"
    },
    block_00048 = {
        {"text"},
        text = {
            ja = {
                {
                    "『那个人，是非常聪明的人，也是非常温柔的人，所以，一定有什",
                    {"rt2"},
                    "么理由』"
                }
            }
        },
        linkback = "block_00047",
        linknext = "block_00049"
    },
    block_00049 = {
        {"text"},
        text = {
            ja = {
                {"我感激静流的温柔。"}
            }
        },
        linkback = "block_00048",
        linknext = "block_00050"
    },
    block_00050 = {
        {"text"},
        text = {
            ja = {
                {
                    "可是那时的我，对静流口中母亲的温柔也好，理由也罢，都已经无",
                    {"rt2"},
                    "法相信了。"
                }
            }
        },
        linkback = "block_00049",
        linknext = "block_00051"
    },
    block_00051 = {
        {"bg", file = "black", path = ":bg/"},
        {"msgoff"},
        {"bg", file = "bluesky_summer", time = 1000, sync = 1, id = 1, lv = 5, path = ":cg/"},
        {"text"},
        text = {
            ja = {
                {"过了不久，静流为了她那由爱好升级而来的咖啡修行，去了海外。"}
            }
        },
        linkback = "block_00050",
        linknext = "block_00052"
    },
    block_00052 = {
        {"text"},
        text = {
            ja = {
                {
                    "我是她最好的理解者，也是她最坚定的支持者。我笑着挥手，送她",
                    {"rt2"},
                    "出发。"
                }
            }
        },
        linkback = "block_00051",
        linknext = "block_00053"
    },
    block_00053 = {
        {"cgdel", id = -1},
        {"bg", file = "black", path = ":bg/"},
        {"text"},
        text = {
            ja = {
                {"然后，我又一次变成了孤身一人。"}
            }
        },
        linkback = "block_00052",
        linknext = "block_00054"
    },
    block_00054 = {
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", file = "bg070a", path = ":bg/", ax = 960, ay = 563, bx = 0, by = -23, sync = 0},
        {"extrans", time = 1000},
        {"text"},
        text = {
            ja = {
                {
                    "从偶尔在鸟谷家见到的母亲的口吻里，我能明白，情况正在一点点",
