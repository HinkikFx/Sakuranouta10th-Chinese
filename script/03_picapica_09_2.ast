    },
    block_00058 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_htd_000321", ch = "htd"}
            },
            ja = {
                {
                    name = {"校长", "纱希"},
                    "「有什么想说的吗？」"
