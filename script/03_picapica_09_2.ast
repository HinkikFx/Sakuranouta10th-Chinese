        },
        linkback = "block_00039",
        linknext = "block_00041"
    },
    block_00041 = {
        {"text"},
        text = {
            ja = {
                {"鸟谷的祖父母既没有嫌弃我，也没有特别欢迎我。"}
            }
        },
        linkback = "block_00040",
        linknext = "block_00042"
    },
    block_00042 = {
        {"text"},
        text = {
            ja = {
                {
                    "与一直在一起的圭分离，在不熟悉的家中独自一人，我慢慢地变得",
                    {"rt2"},
                    "消沉起来。"
                }
            }
        },
        linkback = "block_00041",
        linknext = "block_00043"
    },
    block_00043 = {
        {"text"},
        text = {
            ja = {
                {
                    "安慰这样的我的，是母亲那边年龄差距颇大的表姐。表姐的名字叫",
