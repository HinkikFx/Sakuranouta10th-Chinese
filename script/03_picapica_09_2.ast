        },
        linkback = "block_00107",
        linknext = "block_00109"
    },
    block_00109 = {
        {"text"},
        text = {
            ja = {
                {"明明可以，这样地珍惜。"}
            }
        },
        linkback = "block_00108",
        linknext = "block_00110"
    },
    block_00110 = {
        {"bg", file = "ev_uni_c49_01", path = ":ev/ev_uni_c49/", set = "ev_uni_c49"},
        {"se", file = "se1199", loop = 1, id = 1},
        {"text"},
        text = {
            ja = {
                {
                    "我从月亮与梯子的画上，只裁下了月亮的部分，和我自己的画一起，",
