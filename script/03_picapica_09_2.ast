        },
        linkback = "block_00038",
        linknext = "block_00040"
    },
    block_00040 = {
        {"bg", file = "black", path = ":bg/"},
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", file = "bg070a", path = ":bg/", ax = 960, ay = 563, bx = 0, by = -23, sync = 0},
        {"extrans", time = 1000},
        {"text"},
        text = {
            ja = {
                {"母亲离婚后，我便开始在母亲的娘家——鸟谷家生活了。"}
