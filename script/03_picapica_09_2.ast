        },
        linkback = "block_00055",
        linknext = "block_00057"
    },
    block_00057 = {
        {"bg", file = "black", path = ":bg/"},
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", file = "white", path = ":bg/", sync = 0},
        {"fg", ch = "紗希", size = "z1", mode = 3, path = ":fg/sak/z1/", file = "sak_z1c0000", face = "c0001", head = "sak_z1c", lv = 4, id = 9, sync = 0},
        {"extrans", time = 1000},
        {"text"},
        text = {
            ja = {
                {
                    "偶尔的两人用餐也寡言少语。即使面对面坐着，也总感觉被她用背",
