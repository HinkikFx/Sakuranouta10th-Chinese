astver = 2.0
astname = "ast"
ast = {
    block_00000 = {
        {"savetitle", text = "第Ⅲ章"},
        {"bg", file = "black", path = ":bg/"},
        {"text"},
        text = {
            ja = {
                {"追溯幼年的记忆，想起来的总是背影。"}
            }
        },
        linknext = "block_00001"
    },
    block_00001 = {
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"colortone", style = "gray"},
        {"bg", file = "white", path = ":bg/", sync = 0},
        {"fg", ch = "紗希", size = "z1", mode = 3, resize = 1, path = ":fg/sak/z1/", file = "sak_z1c0000", face = "c0001", head = "sak_z1c", lv = 4, id = 9, sync = 0},
        {"extrans", time = 1000},
        {"bgm", file = "bgm109"},
        {"text"},
        text = {
            ja = {
                {"我和圭，都没有被母亲养育过的记忆。"}
            }
        },
        linkback = "block_00000",
        linknext = "block_00002"
    },
    block_00002 = {
        {"text"},
        text = {
            ja = {
                {"母亲一直都是非常忙碌的人。"}
            }
        },
        linkback = "block_00001",
        linknext = "block_00003"
    },
    block_00003 = {
        {"text"},
        text = {
            ja = {
                {
                    "和父亲见面的机会比母亲还要稀少。他沉迷于工作和社交，对育儿",
                    {"rt2"},
                    "完全不感兴趣。"
                }
            }
        },
        linkback = "block_00002",
        linknext = "block_00004"
    },
    block_00004 = {
        {"text"},
        text = {
            ja = {
                {"我们被交给了父方的祖母和代替奶妈的女佣来抚养。"}
            }
        },
        linkback = "block_00003",
        linknext = "block_00005"
    },
    block_00005 = {
        {"text"},
        text = {
            ja = {
                {"圭一出生就被送到了中村家。"}
            }
        },
        linkback = "block_00004",
        linknext = "block_00006"
    },
    block_00006 = {
        {"text"},
        text = {
            ja = {
                {
                    "不过，我和圭是同父异母的姐弟这件事，在懂事之前我就已经知道",
                    {"rt2"},
                    "了。"
                }
            }
        },
        linkback = "block_00005",
        linknext = "block_00007"
    },
    block_00007 = {
        {"text"},
        text = {
            ja = {
                {"中村家是个人来人往的家。"}
            }
        },
        linkback = "block_00006",
        linknext = "block_00008"
    },
    block_00008 = {
        {"text"},
        text = {
            ja = {
                {
                    "亲戚、客人、佣人……不怀好意的大人们，一次又一次地，间接或",
                    {"rt2"},
                    "直接地，让我们意识到圭所处的立场。"
                }
            }
        },
        linkback = "block_00007",
        linknext = "block_00009"
    },
    block_00009 = {
        {"text"},
        text = {
            ja = {
                {"圭被疏远、被嘲笑、被冷落。"}
            }
        },
        linkback = "block_00008",
        linknext = "block_00010"
    },
    block_00010 = {
        {"text"},
        text = {
            ja = {
                {"然而，我的处境也好不到哪里去。"}
            }
        },
        linkback = "block_00009",
        linknext = "block_00011"
    },
    block_00011 = {
        {"text"},
        text = {
            ja = {
                {"我不是中村家的长女，而始终被当作母亲的女儿对待。"}
            }
        },
        linkback = "block_00010",
        linknext = "block_00012"
    },
    block_00012 = {
        {"text"},
        text = {
            ja = {
                {
                    "母亲做了什么对中村家不利的事——这一点在幼年时期我就已经隐约",
                    {"rt2"},
                    "理解了。"
                }
            }
        },
        linkback = "block_00011",
        linknext = "block_00013"
    },
    block_00013 = {
        {"text"},
        text = {
            ja = {
                {"一切都是母亲的错——被祖母像念咒似地不知说过多少遍。"}
            }
        },
        linkback = "block_00012",
        linknext = "block_00014"
    },
    block_00014 = {
        {"text"},
        text = {
            ja = {
                {"你是从那个女人肚子里出生的本身就是罪——被婶婶不知说过多少遍。"}
            }
        },
        linkback = "block_00013",
        linknext = "block_00015"
    },
    block_00015 = {
        {"text"},
        text = {
            ja = {
                {
                    "即便如此，比起几乎见不到面的母亲，我们觉得眼前这些口吐恶言",
                    {"rt2"},
                    "的人更不可信。"
                }
            }
        },
        linkback = "block_00014",
        linknext = "block_00016"
    },
    block_00016 = {
        {"text"},
        text = {
            ja = {
                {
                    "比起这些人的话语，什么也不说的那个背影，不知为何，无论如何，",
                    {"rt2"},
                    "都显得纯净得多。"
                }
            }
        },
        linkback = "block_00015",
        linknext = "block_00017"
    },
    block_00017 = {
        {"text"},
        text = {
            ja = {
                {"祖母和婶婶指责我们是没有一点可爱之处的孩子。"}
            }
        },
        linkback = "block_00016",
        linknext = "block_00018"
    },
    block_00018 = {
        {"text"},
        text = {
            ja = {
                {"我们在那个家里始终是孤独的。"}
            }
        },
        linkback = "block_00017",
        linknext = "block_00019"
    },
    block_00019 = {
        {"bg", file = "black", path = ":bg/"},
        {"text"},
        text = {
            ja = {
                {
                    "……得知母亲不只是忙碌，而是被刻意地隔离在我们身边之外，已",
                    {"rt2"},
                    "经是很久以后的事了。"
                }
            }
        },
        linkback = "block_00018",
        linknext = "block_00020"
    },
    block_00020 = {
        {"bg", file = "ev_uni_c48_01", path = ":ev/ev_uni_c48/", set = "ev_uni_c48"},
        {"text"},
        text = {
            ja = {
                {
                    "虽然算不上幸福的幼年，但弓张学园有着悠久的历史，培养了大量",
                    {"rt2"},
                    "的文化名人和艺术家——因为这个缘故，中村家装饰着大量的美术品，",
                    {"rt2"},
                    "这成了我们的慰藉。"
                }
            }
        },
        linkback = "block_00019",
        linknext = "block_00021"
    },
    block_00021 = {
        {"text"},
        text = {
            ja = {
                {
                    "对于幼小的我们来说，偌大的中村宅邸过于广阔，我们手牵着手在",
                    {"rt2"},
                    "里面探险，接触了无数的美术作品。"
                }
            }
        },
        linkback = "block_00020",
        linknext = "block_00022"
    },
    block_00022 = {
        {"text"},
        text = {
            ja = {
                {"被大量的画围绕着，我们自然而然地也开始画画了。"}
            }
        },
        linkback = "block_00021",
        linknext = "block_00023"
    },
    block_00023 = {
        {"text"},
        text = {
            ja = {
                {"对我们几乎漠不关心的父亲，不知为何唯独对我们画画表示了不满。"}
            }
        },
        linkback = "block_00022",
        linknext = "block_00024"
    },
    block_00024 = {
        {"text"},
        text = {
            ja = {
                {
                    "等他发现无论怎么阻止我们也不会放弃画画后，就变得更加冷淡，",
                    {"rt2"},
                    "更加疏远了。"
                }
            }
        },
        linkback = "block_00023",
        linknext = "block_00025"
    },
    block_00025 = {
        {"text"},
        text = {
            ja = {
                {"母亲则正好相反，她很支持我们，安排让我们去上绘画教室。"}
            }
        },
        linkback = "block_00024",
        linknext = "block_00026"
    },
    block_00026 = {
        {"text"},
        text = {
            ja = {
                {
                    "在绘画教室里画画的时间，对我们来说，是能忘却一切、尽情享受",
                    {"rt2"},
                    "绘画的自由时光。"
                }
            }
        },
        linkback = "block_00025",
        linknext = "block_00027"
    },
    block_00027 = {
        {"text"},
        text = {
            ja = {
                {"我想快快长大。"}
            }
        },
        linkback = "block_00026",
        linknext = "block_00028"
    },
    block_00028 = {
        {"text"},
        text = {
            ja = {
                {
                    "长大成人后，从这如同淤泥般的中村家、从这些羁绊中获得自由——",
                    {"rt2"},
                    "我这样期望着。"
                }
            }
        },
        linkback = "block_00027",
        linknext = "block_00029"
    },
    block_00029 = {
        {"bg", file = "black", path = ":bg/"},
        {"text"},
        text = {
            ja = {
                {"可是我在长大成人之前，就更早地离开了中村家。"}
            }
        },
        linkback = "block_00028",
        linknext = "block_00030"
    },
    block_00030 = {
        {"text"},
        text = {
            ja = {
                {"母亲和父亲离了婚。"}
            }
        },
        linkback = "block_00029",
        linknext = "block_00031"
    },
    block_00031 = {
        {"text"},
        text = {
            ja = {
                {
                    "母亲获得了我的抚养权，但圭要作为养子去夏目家，而我和圭画的",
                    {"rt2"},
                    "画则由鸟谷家来管理。"
                }
            }
        },
        linkback = "block_00030",
        linknext = "block_00032"
    },
    block_00032 = {
        {"text"},
        text = {
            ja = {
                {"——因为是小妾的孩子，圭才要去夏目家！"}
            }
        },
        linkback = "block_00031",
        linknext = "block_00033"
    },
    block_00033 = {
        {"text"},
        text = {
            ja = {
                {"——你妈妈根本就不要圭！"}
            }
        },
        linkback = "block_00032",
        linknext = "block_00034"
    },
    block_00034 = {
        {"text"},
        text = {
            ja = {
                {"——画可以花钱买回去，但圭就不配被买回去呢！"}
            }
        },
        linkback = "block_00033",
        linknext = "block_00035"
    },
    block_00035 = {
        {"text"},
        text = {
            ja = {
                {"……那时丽华的话深深刺进了我脆弱的部分，变成了拔不出来的刺。"}
            }
        },
        linkback = "block_00034",
        linknext = "block_00036"
    },
    block_00036 = {
        {"msgoff"},
        {"fg", mode = -2, sync = 0},
        {"bg", file = "white", path = ":bg/", sync = 0},
        {"fg", ch = "紗希", size = "z1", mode = 3, path = ":fg/sak/z1/", file = "sak_z1c0000", face = "c0001", head = "sak_z1c", lv = 4, id = 9, sync = 0},
        {"extrans", time = 1000},
        {"text"},
        text = {
            ja = {
                {"为什么。妈妈你为什么。"}
