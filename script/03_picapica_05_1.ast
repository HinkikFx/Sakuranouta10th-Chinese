        linkback = "block_00094",
        linknext = "block_00096"
    },
    block_00096 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为我被攻击了嘛，总得有个赔偿才行……你不是总挂在嘴边什",
                    {"rt2"},
                    "么欠债还债吗？攻击了就得好好赔偿才对吧」"
                }
            }
        },
        linkback = "block_00095",
        linknext = "block_00097"
    },
    block_00097 = {
        {"bg", file = "ev_com_b04_04", sync = 0, face = 1, time = 400, path = ":ev/ev_com_b04/", set = "ev_com_b04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002501", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「那、那是因为你说了那种话……」"
                }
            }
        },
        linkback = "block_00096",
        linknext = "block_00098"
    },
    block_00098 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「因为对方说了难听的话就上脚，这是不被允许的。如果那番言论",
                    {"rt2"},
                    "不当的话应该通过批判性思维来纠正才对。难道不是吗！」"
                }
            }
        },
        linkback = "block_00097",
        linknext = "block_00099"
    },
    block_00099 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002502", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「那、那个……」"
                }
            }
        },
        linkback = "block_00098",
        linknext = "block_00100"
    },
    block_00100 = {
        {"text"},
        text = {
            ja = {
                {
                    "被我抬着一条腿、内裤一览无余的鸟谷，大概完全无法正常思考了。",
                    {"rt2"},
                    "眼珠转得团团转或是含着泪花，已经彻底大混乱了。"
                }
            }
        },
        linkback = "block_00099",
        linknext = "block_00101"
    },
    block_00101 = {
        {"text"},
        text = {
            ja = {
                {"稍作正常思考的话，我说的话根本就是一派胡言，完全站不住脚。"}
            }
        },
        linkback = "block_00100",
        linknext = "block_00102"
    },
    block_00102 = {
        {"text"},
        text = {
            ja = {
                {"不过她迟早会发现的。在那之前，就让我好好享用一下吧。"}
            }
        },
        linkback = "block_00101",
        linknext = "block_00103"
    },
    block_00103 = {
        {"bg", file = "ev_com_b04_05", sync = 0, face = 1, time = 400, path = ":ev/ev_com_b04/", set = "ev_com_b04"},
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002503", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「也许是那样吧……可、可是普通来说真的很害羞嘛，我知道踢人",
                    {"rt2"},
                    "不对了，所以换个别的方式赔偿可以吗」"
                }
            }
        },
        linkback = "block_00102",
        linknext = "block_00104"
    },
    block_00104 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「不行，我要求你道歉和赔偿（内裤）。除此之外概不受理！」"
                }
            }
        },
        linkback = "block_00103",
        linknext = "block_00105"
    },
    block_00105 = {
        {"text"},
        text = {
            vo = {
                {"vo", file = "fem_mkd_002504", ch = "mkd"}
            },
            ja = {
                {
                    name = {"真琴"},
                    "「怎、怎么会这样……」"
                }
