        linknext = "block_00096"
    },
    block_00096 = {
        {"text"},
        text = {
            ja = {
                {
                    name = {"直哉"},
                    "「毕竟我挨了攻击，总得让你赔偿点什么……你不是总把人情啊亏",
                    {"rt2"},
                    "欠啊挂在嘴边吗？攻击了多少，就得好好赔偿多少吧」"
                }
