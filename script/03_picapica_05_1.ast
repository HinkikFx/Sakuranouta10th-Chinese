        linkback = "block_00105",
        linknext = "block_00107"
    },
    block_00107 = {
        {"text"},
        text = {
            ja = {
                {
                    "本以为鸟谷会对我的诡辩发起猛烈反击，谁知她竟然一副认命的样",
                    {"rt2"},
                    "子，不再抵抗，用手遮住了脸。"
