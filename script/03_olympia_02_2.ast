        linknext = "block_00133"
    },
    block_00133 = {
        {"bg", file = "ev_com_c03_03", sync = 0, face = 1, time = 400, path = ":ev/ev_com_c03/", set = "ev_com_c03"},
        {"text"},
        text = {
