        linkback = "block_00144",
        linknext = "block_00146"
    },
    block_00146 = {
        {"text"},
        text = {
            ja = {
                {
                    "因为我从很久以前就认识她。认识的还是那个与才色兼备相去甚远",
                    {"rt2"},
                    "、连秋千都不会荡的她……。"
                }
            }
        },
        linkback = "block_00145",
        linknext = "block_00147"
    },
    block_00147 = {
        {"text"},
        text = {
            ja = {
                {"而且，明明曾经那么要好，却音信全无的，正是我……。"}
            }
        },
        linkback = "block_00146",
        linknext = "block_00148"
    },
    block_00148 = {
        {"text"},
        text = {
            ja = {
                {"唯独在我面前，她永远只能是那个没有自信的禀……。"}
