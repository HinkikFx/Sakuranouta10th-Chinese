        },
        linkback = "block_00142",
        linknext = "block_00144"
    },
    block_00144 = {
        {"text"},
        text = {
            ja = {
                {
                    "在这种情况下，她根本没必要自我评价这么低……才对――但并非如",
                    {"rt2"},
                    "此。"
                }
            }
        },
        linkback = "block_00143",
        linknext = "block_00145"
    },
    block_00145 = {
        {"text"},
        text = {
            ja = {
                {"即便如此，大概，禀只有在面对我时，自我评价才会那么低吧。"}
