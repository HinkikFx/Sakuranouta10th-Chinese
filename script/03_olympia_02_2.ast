        },
        linkback = "block_00140",
        linknext = "block_00142"
    },
    block_00142 = {
        {"text"},
        text = {
            ja = {
                {"第一学期这家伙的人气简直无人能敌。"}
            }
        },
        linkback = "block_00141",
        linknext = "block_00143"
    },
    block_00143 = {
        {"text"},
        text = {
            ja = {
                {
                    "如今她的人气之所以平息下来，只不过是因为几乎所有家伙告白后",
                    {"rt2"},
                    "都当场被甩了而已。"
                }
