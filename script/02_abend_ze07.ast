        },
        text = {
            vo = {
                {"vo", file = "fem_yum_000478", ch = "yum"}
            },
            ja = {
                {
                    name = {"优美"},
                    "「土地的所有者,是自古以来统治这一带的旧家族中村家。所以听说",
